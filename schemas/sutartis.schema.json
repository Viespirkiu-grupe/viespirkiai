{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vpmSutartis-canonical",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unikalusId", "pavadinimas", "sudarymoData", "galiojimoData",
    "faktineIvykdimoData", "paskelbimoData", "redagavimoData",
    "perkanciosiosOrganizacijosKodas", "perkanciosiosOrganizacijosPavadinimas",
    "sutartiesNumeris", "pirkimoNumeris", "numatomaVerte", "faktineVerte",
    "pirmoTiekejoKodas", "pirmoTiekejoPavadinimas", "papildomiTiekejai",
    "tipas", "kategorija", "bvpzKodas", "papildomiBvpzKodai", "dokumentai", "istrinta", "pakeitimas"
  ],
  "properties": {
    "unikalusId":                            { "type": "integer" },
    "pavadinimas":                           { "type": ["string", "null"] },
    "sudarymoData":                          { "type": ["string", "null"], "format": "date" },
    "galiojimoData":                         { "type": ["string", "null"], "format": "date" },
    "faktineIvykdimoData":                   { "type": ["string", "null"], "format": "date" },
    "paskelbimoData":                        { "type": ["string", "null"], "format": "date-time" },
    "redagavimoData":                        { "type": ["string", "null"], "format": "date-time" },
    "perkanciosiosOrganizacijosKodas":       { "type": ["string", "null"] },
    "perkanciosiosOrganizacijosPavadinimas": { "type": ["string", "null"] },
    "sutartiesNumeris":                      { "type": ["string", "null"] },
    "pirkimoNumeris":                        { "type": ["string", "null"] },
    "numatomaVerte":                         { "type": ["number", "null"] },
    "faktineVerte":                          { "type": ["number", "null"] },
    "pirmoTiekejoKodas":                     { "type": ["string", "null"] },
    "pirmoTiekejoPavadinimas":               { "type": ["string", "null"] },
    "papildomiTiekejai": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kodas", "pavadinimas"],
        "properties": {
          "kodas":       { "type": ["string", "null"] },
          "pavadinimas": { "type": ["string", "null"] }
        }
      }
    },
    "tipas":              { "type": ["string", "null"] },
    "kategorija":         { "type": ["string", "null"] },
    "bvpzKodas":          { "type": ["integer", "null"] },
    "papildomiBvpzKodai": { "type": "array", "items": { "type": "integer" } },
    "dokumentai": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pavadinimas", "fileId"],
        "properties": {
          "pavadinimas": { "type": ["string", "null"] },
          "fileId":      { "type": ["integer", "null"] }
        }
      }
    },
    "istrinta":           { "type": "boolean" },
    "pakeitimas":         { "type": "boolean" }
  }
}


