<!DOCTYPE html>
<html>
	<head>
	<%- include('head.ejs', {
        pageTitle: eksportas.pavadinimas,
        pageDescription: `Galite parsisiųsti šį duomenų eksportą`,
        pageImage: `https://viespirkiai.top/eksportas/${eksportas.id}.png`,
        customHead
    }) %>
	</head>
	<body>
    <%- include('header.ejs') %>
	<main>
		<h1><%- eksportas.pavadinimas %></h1>

        <section class="col-3 mobile-col-2">
            <div>
                <h2><u>Parsisiuntimas</u></h2>
                <h3>Magnet nuoroda</h3>
        				<a href="<%= eksportas.link %>">Parsisiųsti</a><br>
                <h3>Torrent failas</h3>
                <a href="/eksportai/<%= eksportas.id %>.torrent">Parsisiųsti</a>
            </div>

            <div>
                <h2><u>Data</u></h2>
        				<%= new Date(eksportas.data).toLtDate() %><br><br>
                <h2><u>Dydis</u></h2>
                <%= eksportas.dydisMB %> MB <i>(compressed)</i>
            </div>
        </section>
	</main>
    <%- include('footer.ejs') %>
	</body>
</html>
