<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
    pageTitle: 'Voratinklis — Ryšių grafikas',
    pageDescription: 'Interaktyvus viešųjų pirkimų ryšių tinklo grafikas',
    pageImage: '',
    customHead: customHead || ''
  }) %>
  <style>
    body { overflow: hidden; }
    #voratinklis-wrapper {
      position: fixed;
      top: var(--site-header-offset, 56px);
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
    }
    #voratinklis-canvas {
      flex: 1;
      width: 100%;
      position: relative;
    }
    #voratinklis-loading {
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      pointer-events: all;
    }
    .dark #voratinklis-loading {
      background: rgba(15,23,42,0.5);
    }
    .vl-spinner {
      width: 40px;
      height: 40px;
      border: 4px solid #e5e7eb;
      border-top-color: #3b82f6;
      border-radius: 50%;
      animation: vl-spin 0.8s linear infinite;
    }
    @keyframes vl-spin { to { transform: rotate(360deg); } }
    #voratinklis-status {
      position: absolute;
      bottom: 12px;
      left: 12px;
      font-size: 0.8rem;
      color: var(--color-muted, #6b7280);
      pointer-events: none;
    }
    #voratinklis-legend {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(255,255,255,0.92);
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 0.75rem;
      color: #374151;
      line-height: 1.6;
      user-select: none;
    }
    .dark #voratinklis-legend {
      background: rgba(30,41,59,0.92);
      border-color: #374151;
      color: #d1d5db;
    }
    #voratinklis-details {
      position: absolute;
      top: 12px;
      right: 12px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
      padding: 10px 14px;
      max-width: 240px;
      font-size: 0.85rem;
      color: #374151;
      z-index: 20;
      line-height: 1.5;
      overflow-wrap: break-word;
    }
    .dark #voratinklis-details {
      background: #1e293b;
      border-color: #374151;
      color: #d1d5db;
    }
    #voratinklis-details .vd-title {
      font-weight: 600;
      margin-bottom: 4px;
    }
    #voratinklis-details .vd-sub {
      color: #6b7280;
      font-size: 0.8rem;
      margin-bottom: 2px;
    }
    .dark #voratinklis-details .vd-sub {
      color: #9ca3af;
    }
    #voratinklis-details .vd-link {
      display: block;
      margin-top: 6px;
      color: #3b82f6;
      text-decoration: none;
      font-size: 0.8rem;
    }
    #voratinklis-details .vd-link:hover {
      text-decoration: underline;
    }
    .vl-swatch {
      display: inline-block;
      width: 22px;
      height: 3px;
      border-radius: 2px;
      vertical-align: middle;
      margin-right: 4px;
    }
    #voratinklis-legend label {
      display: flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
    }
    #voratinklis-legend input[type=checkbox] {
      cursor: pointer;
      margin: 0;
    }
  </style>
</head>
<body>
  <%- include('../header.ejs', { hideSubtext: false }) %>

  <div id="voratinklis-wrapper">
    <div id="voratinklis-canvas">
      <div id="voratinklis-loading" hidden>
        <div class="vl-spinner"></div>
      </div>
      <div id="voratinklis-details" hidden></div>
    </div>
    <div id="voratinklis-status"></div>
      <div id="voratinklis-legend" hidden>
      <div id="voratinklis-legend-title" style="font-weight:600;text-align:center;margin-bottom:6px;">Filtrai</div>
      <label><input type="checkbox" data-edge-types="Director" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#1d4ed8" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#1d4ed8"/></svg>Direktorius / vadovas</label>
      <label><input type="checkbox" data-edge-types="Shareholder" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#7c3aed" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#7c3aed"/></svg>Akcininkas</label>
      <label><input type="checkbox" data-edge-types="Official"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#0891b2" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#0891b2"/></svg>Pareigūnas / oficialus</label>
      <label><input type="checkbox" data-edge-types="Employment"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#6b7280" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#6b7280"/></svg>Darbuotojas</label>
      <label><input type="checkbox" data-edge-types="Spouse"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#f59e0b" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#f59e0b"/></svg>Sutuoktinis</label>
      <label><input type="checkbox" data-edge-types="Order,Delivery" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#10b981" stroke-width="1"/><polygon points="20,3 26,6 20,9" fill="#10b981"/></svg>Sutartis (maža)</label>
      <label style="padding-left:20px"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#10b981" stroke-width="3"/><polygon points="20,3 26,6 20,9" fill="#10b981"/></svg>Sutartis (vidutinė)</label>
      <label style="padding-left:20px"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#10b981" stroke-width="6"/><polygon points="19,2 26,6 19,10" fill="#10b981"/></svg>Sutartis (didelė)</label>
    </div>
  </div>

  <script src="/dist/voratinklis.js"></script>
  <script>window.VORATINKLIS_CONFIG = { jarKodas: '<%- jarKodas %>' };</script>
  <script src="/dist/voratinklis-app.js"></script>

</body>
</html>
