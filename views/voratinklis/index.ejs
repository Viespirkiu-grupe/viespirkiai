<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
    pageTitle: 'Voratinklis — Ryšių grafikas',
    pageDescription: 'Interaktyvus viešųjų pirkimų ryšių tinklo grafikas',
    pageImage: '',
    customHead: customHead || ''
  }) %>
  <style>
    body { overflow: hidden; }
    #voratinklis-wrapper {
      position: fixed;
      top: var(--site-header-offset, 56px);
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
    }
    #voratinklis-canvas {
      flex: 1;
      width: 100%;
    }
    #voratinklis-status {
      position: absolute;
      bottom: 12px;
      left: 12px;
      font-size: 0.8rem;
      color: var(--color-muted, #6b7280);
      pointer-events: none;
    }
  </style>
</head>
<body>
  <%- include('../header.ejs', { hideSubtext: false }) %>

  <div id="voratinklis-wrapper">
    <div id="voratinklis-canvas"></div>
    <div id="voratinklis-status"></div>
  </div>

  <script src="/dist/voratinklis.js"></script>
  <script>window.VORATINKLIS_CONFIG = { jarKodas: '<%- jarKodas %>' };</script>
  <script src="/dist/voratinklis-app.js"></script>

</body>
</html>
