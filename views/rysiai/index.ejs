<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
    pageTitle: 'Ryšiai — Ryšių grafikas',
    pageDescription: 'Interaktyvus viešųjų pirkimų ryšių tinklo grafikas',
    pageImage: '',
    customHead: customHead || ''
  }) %>
  <style>
    body { overflow: hidden; }
    #rysiai-wrapper {
      position: fixed;
      top: var(--site-header-offset, 56px);
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
    }
    #rysiai-canvas {
      flex: 1;
      width: 100%;
      position: relative;
    }
    #rysiai-loading {
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      pointer-events: all;
    }
    .dark #rysiai-loading {
      background: rgba(15,23,42,0.5);
    }
    #rysiai-status {
      position: absolute;
      bottom: 12px;
      left: 12px;
      font-size: 0.8rem;
      color: var(--gray);
      pointer-events: none;
    }
    #node-details {
      position: absolute;
      top: 12px;
      right: 12px;
      background: var(--white);
      border: var(--border);
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
      min-width: 200px;
      max-width: 240px;
      font-size: 0.85rem;
      color: var(--black);
      z-index: 20;
      overflow-wrap: break-word;
    }
    #rysiai-details {
      padding: 10px 14px;
      line-height: 1.5;
    }
    #rysiai-legend {
      padding: 8px 12px;
      font-size: 0.75rem;
      line-height: 1.6;
      user-select: none;
      border-top: var(--border);
      margin-top: 8px;
    }
    #rysiai-details .vd-title {
      font-weight: 600;
      margin-bottom: 4px;
    }
    #rysiai-details .vd-sub {
      color: var(--gray);
      font-size: 0.8rem;
      margin-bottom: 2px;
    }
    #rysiai-details .vd-link {
      display: block;
      margin-top: 6px;
      color: var(--link);
      text-decoration: none;
      font-size: 0.8rem;
    }
    #rysiai-details .vd-link:hover {
      text-decoration: underline;
    }
    #rysiai-details .vd-btn {
      width: 100%;
      margin-top: 12px;
      border: var(--border);
    }
    #rysiai-legend .vd-btn {
      width: 100%;
      border: var(--border);
    }
    #rysiai-legend-btn:not(:empty) {
      border-top: var(--border);
      padding-top: 8px;
      margin-top: 8px;
    }
    .vl-swatch {
      display: inline-block;
      width: 22px;
      height: 3px;
      border-radius: 2px;
      vertical-align: middle;
      margin-right: 4px;
    }
    #rysiai-legend label {
      display: flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
    }
    #rysiai-legend input[type=checkbox] {
      cursor: pointer;
      margin: 0;
    }
  </style>
</head>
<body>
  <%- include('../header.ejs', { hideSubtext: false }) %>

  <div id="rysiai-wrapper">
    <div id="rysiai-canvas">
      <div id="rysiai-loading" hidden>
        <span class="spinner spinner-lg"></span>
      </div>
      <div id="node-details" hidden>
        <div id="rysiai-details"></div>
        <div id="rysiai-legend" hidden>
          <div id="rysiai-legend-checkboxes">
            <label><input type="checkbox" data-edge-types="Director" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#1d4ed8" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#1d4ed8"/></svg>Direktorius / vadovas</label>
            <label><input type="checkbox" data-edge-types="Shareholder" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#7c3aed" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#7c3aed"/></svg>Akcininkas</label>
            <label><input type="checkbox" data-edge-types="Official"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#0891b2" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#0891b2"/></svg>Pareigūnas / oficialus</label>
            <label><input type="checkbox" data-edge-types="Employment"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#6b7280" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#6b7280"/></svg>Darbuotojas</label>
            <label><input type="checkbox" data-edge-types="Spouse"> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#f59e0b" stroke-width="2"/><polygon points="20,3 26,6 20,9" fill="#f59e0b"/></svg>Sutuoktinis</label>
            <label><input type="checkbox" data-contract-size="small" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#10b981" stroke-width="1"/><polygon points="20,3 26,6 20,9" fill="#10b981"/></svg>Sutartis (maža)</label>
            <label><input type="checkbox" data-contract-size="medium" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#10b981" stroke-width="3"/><polygon points="20,3 26,6 20,9" fill="#10b981"/></svg>Sutartis (vidutinė)</label>
            <label><input type="checkbox" data-contract-size="large" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#10b981" stroke-width="6"/><polygon points="19,2 26,6 19,10" fill="#10b981"/></svg>Sutartis (didelė)</label>
            <label><input type="checkbox" data-edge-types="Procurement" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#8b5cf6" stroke-width="1"/><polygon points="20,3 26,6 20,9" fill="#8b5cf6"/></svg>Pirkimo skelbimas</label>
            <label><input type="checkbox" data-edge-types="Award" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#22c55e" stroke-width="1" stroke-dasharray="5,4"/><polygon points="20,3 26,6 20,9" fill="#22c55e"/></svg>Pirkimo laimėtojas</label>
            <label><input type="checkbox" data-edge-types="Bid" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#ef4444" stroke-width="1" stroke-dasharray="5,4"/><polygon points="20,3 26,6 20,9" fill="#ef4444"/></svg>Pirkimo dalyvis</label>
            <label><input type="checkbox" data-edge-types="ContractLink" checked> <svg width="28" height="12"><line x1="2" y1="6" x2="26" y2="6" stroke="#94a3b8" stroke-width="1" stroke-dasharray="5,4"/><polygon points="20,3 26,6 20,9" fill="#94a3b8"/></svg>Sutartis → pirkimas</label>
          </div>
          <div id="rysiai-legend-btn"></div>
        </div>
      </div>
    </div>
    <div id="rysiai-status"></div>
  </div>

  <script src="/dist/rysiai.js"></script>
  <script>window.RYSIAI_CONFIG = { jarKodas: '<%- jarKodas %>' };</script>
  <script src="/dist/rysiai-app.js"></script>

</body>
</html>
