<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
    pageTitle: "Top adresai pagal įmonių skaičių",
    pageDescription: "",
    pageImage: `https://viespirkiai.org/juridiniai.png`,
    customHead: ""
  }) %>
</head>
<body>
  <%- include('../header.ejs', { hideSubtext: false }) %>
  <main>

    <div class="page-header">
      <h1 class="mb-0">Top adresai pagal įmonių skaičių</h1>
    </div>

    <p class="text-muted mb-5 max-w-content">
      Žemiau pateikiami adresai, kuriuose registruota daugiausiai įmonių.
      Įprastai užsiregistruoti juose galima susimokėjus mokestį — tokie adresai leidžia
      formaliai registruoti įmonę, neskelbiant tikros veiklos vietos.
    </p>

    <div class="flex justify-between items-center mb-4">
      <span class="text-muted text-sm numberOfResults"><%- numberOfResults %></span>
    </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-3);">
      <% adresai.forEach(item => { %>
        <article class="card card-clickable">
          <div class="card-body">
            <h3 class="text-sm fw-bold mb-2 mt-1">
              <a href="/juridiniai?adresas=<%= item.adresas %>">
                <%= item.adresas %>
              </a>
            </h3>
            <p class="text-muted text-sm mb-0"><span class="cell-mono"><%= item.count %></span> įmonės</p>
          </div>
        </article>
      <% }) %>
    </div>

    <%- include('../pagination.ejs', { currentPage, pageCount, queryParams }) %>

  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
