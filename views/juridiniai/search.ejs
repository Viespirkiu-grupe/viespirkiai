<form method="get" role="search" id="searchForm">
  <h1 class="mt-7">Juridinių asmenų paieška</h1>

  <div class="search-bar">
    <label for="search">
      <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
      </svg>

      <span class="sr-only">Paieška</span>
    </label>

    <input type="search" name="search" id="search" class="search-bar__input"
      value="<%= values.search || '' %>"
      placeholder="Tekstinė paieška"
      enterkeyhint="search"
    />

    <button type="submit" class="btn btn-primary">Ieškoti</button>
  </div>
</form>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const form = document.getElementById("searchForm");
  const input = document.getElementById("search");
  const results = document.getElementById("juridiniaiRezultatai");
  let controller;
  let debounceTimer;
  input.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      const query = input.value.trim();
      if (!query) {
        results.innerHTML = "";
        history.replaceState(null, "", window.location.pathname);
        return;
      }
      if (controller) controller.abort();
      controller = new AbortController();
      try {
        const base = form.getAttribute("action") || window.location.pathname;
        const url = new URL(base, window.location.origin);
        url.searchParams.set("search", query);
        url.searchParams.set("tikRezultatai", "true");
        const res = await fetch(url, { signal: controller.signal });
        if (!res.ok) throw new Error("Network error");
        results.innerHTML = await res.text();
        url.searchParams.delete("tikRezultatai");
        history.replaceState(null, "", url);
      } catch (err) {
        if (err.name !== "AbortError") {
          results.innerHTML = "<p>Klaida gaunant duomenis.</p>";
        }
      }
    }, 100);
  });
});
</script>
