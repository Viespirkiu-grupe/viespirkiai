<!DOCTYPE html>
<html lang="lt">
	<head>
	<%- include('../head.ejs', {
        pageTitle: "Juridinių asmenų paieška",
        pageDescription: ``,
        pageImage: `https://viespirkiai.top/juridiniai.png`,
        customHead
    }) %>
	</head>
	<body>
		<%- include('../header.ejs', {hideSubtext: false}) %>
		<main>
			<%- include('search.ejs', {values}) %>
			<section id="juridiniaiRezultatai" class="results">
                <% if(typeof data !== "undefined") { %>
    			    <%- include('results.ejs', {data, currentPage, pageCount, queryParams, galimaEksportuoti}) %>
                <% } else { %>
                    <%- include('../tabs.ejs') %>
                    <script>
                      window.addEventListener('DOMContentLoaded', () => {
                        const search = document.getElementById('search');
                        if (search) search.focus();
                      });
                    </script>
                <% } %>
			</section>
		</main>
		<%- include('../footer.ejs') %>
	</body>
</html>
