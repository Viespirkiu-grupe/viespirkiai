<!DOCTYPE html>
<html lang="lt">
	<head>
	<%- include('../head.ejs', {
        pageTitle: "Juridinių asmenų paieška",
        pageDescription: ``,
        pageImage: `https://viespirkiai.org/juridiniai.png`,
        customHead
    }) %>
  <%- include('../partials/leaflet-head.ejs') %>
	</head>
	<body>
		<%- include('../header.ejs', {hideSubtext: false}) %>
		<main>
			<%- include('search.ejs', {values}) %>
			<section class="results" id="juridiniaiRezultatai">
                <% if(typeof data !== "undefined") { %>
                        <%- include('results.ejs', {data, currentPage, pageCount, queryParams, galimaEksportuoti}) %>
                <% } else { %>
                    <script>
                      window.addEventListener('DOMContentLoaded', () => {
                        const search = document.getElementById('search');
                        if (search) search.focus();
                      });
                    </script>
                    <br>
                    <div id="map" style="height: 60vh; border-radius: 8px;"></div>

                    <script>
                    window.addEventListener('DOMContentLoaded', () => {
                      const start = () => {
                        if (!window.L || !window.L.map) return;

                        const mapEl = document.getElementById('map');

                        const map = L.map('map', {
                          zoomAnimation: true,    // enable zoom animation
                          markerZoomAnimation: true, // optional: animates markers during zoom
                        }).setView([55.1694, 23.8813], 7); // Centered on Lithuania

                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                          attribution: '&copy; OpenStreetMap contributors',
                        }).addTo(map);

                        const juridiniaiTiles = L.tileLayer("/juridiniai/map/tiles/{z}/{x}/{y}.png", {
                            tileSize: 256,
                            opacity: 0.6,
                            maxNativeZoom: 16, // tiles exist only up to this zoom
                            maxZoom: 16         // prevent displaying above zoom 17
                        }).addTo(map);

                        juridiniaiTiles.getContainer().style.filter = 'blur(5px)';

                        // Assume map is your Leaflet map instance
                        map.on('moveend zoomend', async () => {
                            const zoom = map.getZoom();

                            // Only show markers for zoom >= 17
                            if (zoom < 17) {
                                if (window.juridiniaiLayer) {
                                    map.removeLayer(window.juridiniaiLayer);
                                }
                                return;
                            }

                            const bounds = map.getBounds();
                            const url = `/juridiniai/map/viewport?minLat=${bounds.getSouth()}&minLon=${bounds.getWest()}&maxLat=${bounds.getNorth()}&maxLon=${bounds.getEast()}`;
                            const res = await fetch(url);
                            const data = await res.json();

                            if (window.juridiniaiLayer) {
                                map.removeLayer(window.juridiniaiLayer);
                            }

                            // Add all points as small black circles
                            const layerGroup = L.layerGroup();
                            data.locations.forEach(([lat, lon]) => {
                              const circle = L.circleMarker([lat, lon], {
                                  radius: 6,          // bigger for tapping
                                  color: 'black',
                                  fillColor: 'black',
                                  fillOpacity: 1,   // visually smaller
                                  weight: 1,
                                  interactive: true
                              }).addTo(layerGroup);

                                circle.on('click', () => {
                                    // Redirect to juridiniai
                                    const url = `/juridiniai?location=${lat},${lon}&locationRadius=10`;
                                    window.location.href = url;
                                });
                            });

                            window.juridiniaiLayer = layerGroup;
                            map.addLayer(layerGroup);
                        });
                      };

                      if (typeof window.__vpLeafletLoad === 'function') {
                        window.__vpLeafletLoad().then(start).catch(() => {});
                      } else {
                        start();
                      }
                    });
                    </script>

                <% } %>
                <br>
                <div class="d-flex gap-2 justify-center mb-2">
                 			<a href="/juridiniai/topAdresai" class="btn btn-outline btn-sm">↗ Top adresai</a>
                </div>
			</section>
		</main>
		<%- include('../footer.ejs') %>
	</body>
</html>
