<div>
    <section class="preResultOptions">
        <div class="numberOfResults">
            <%- numberOfResults %>
        </div>

        <% if(galimaEksportuoti){ %>
            <div class="exportOptions">
            <a href="/juridiniai?<%- queryParams %>&json=true&limit=max" class="exportLink">↗ JSON</a>&nbsp;
            <a href="/juridiniai?<%- queryParams %>&jsonl=true&limit=max" class="exportLink">↗ JSONL</a>&nbsp;
            <a href="/juridiniai?<%- queryParams %>&csv=true&limit=max" class="exportLink">↗ CSV</a>
            </div>
        <% } %>
    </section>
</div>

<div class="resultsNauji">
    <% data.forEach(item => { %>
        <article class="rezultatas" aria-label="<%= item.formosPavadinimas %>">
            <a href="/asmuo/<%= item.jarKodas %>" class="fullIndentLink"></a>

            <div class="rezultatas-left">
                <dl class="rezultatas-top">
                    <div>
                        <dt class="visually-hidden">Tipas</dt>
                        <dd><%= item.formosPavadinimas %></dd>
                    </div>
                </dl>

                <h3 class="rezultatas-title">
                    <a href="/asmuo/<%= item.jarKodas %>">
                        <span>
                            <% if (!item.pavadinimas || item.pavadinimas.length === 0) { %>
                                <i>Nenurodyta</i>
                            <% } else { %>
                                <%= item.pavadinimas %>
                            <% } %>
                        </span>
                    </a>
                </h3>

                <div class="rezultatas-bottom">
                    <div>
                        <b>Adresas:</b>
                        <span><%- item.adresas %></span>
                    </div>
                    <div>
                        <b>Registruota:</b>
                        <span><%= new Date(item.registravimoData).toLtDate() %></span>
                    </div>
                </div>
            </div>
        </article>
    <% }); %>
</div>

<%- include('../pagination.ejs', {
    currentPage, pageCount, queryParams
}) %>
