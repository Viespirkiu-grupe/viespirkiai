<!DOCTYPE html>
<html>
<head>
	<%- include('../head.ejs', {
          pageTitle: asmuo.jar.pavadinimas,
          pageDescription: `Juridinio asmens informacija`,
          pageImage: `https://viespirkiai.top/asmuo/${asmuo.jar.jarKodas}.png`,
          customHead
    }) %>

    <% if(asmuo.jar.koordinates) { %>
        <script>
        window.addEventListener('DOMContentLoaded', () => {
          // 1. Load Leaflet CSS
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = '/dist/leaflet.css';
          document.head.appendChild(link);

          // 2. Load Leaflet JS dynamically
          const script = document.createElement('script');
          script.src = '/dist/leaflet.js';
          script.defer = true;
          script.onload = () => {
            // 3. Initialize map after JS is ready
            const mapEl = document.getElementById('map');
            const map = L.map('map').setView([mapEl.dataset.y, mapEl.dataset.x], 16);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            L.marker([mapEl.dataset.y, mapEl.dataset.x]).addTo(map);
          };
          document.body.appendChild(script);
        });
        </script>
    <% } %>

    <script defer>
      let apexPromise;

      function loadApexCharts() {
        if (window.ApexCharts) return Promise.resolve(window.ApexCharts);
        if (apexPromise) return apexPromise; // already loading

        apexPromise = new Promise((resolve, reject) => {
          function startLoading() {
            const script = document.createElement('script');
            script.src = '/dist/apexcharts.js';
            script.defer = true;
            script.onload = () => resolve(window.ApexCharts);
            script.onerror = reject;
            document.body.appendChild(script);
          }

          if (document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', startLoading);
          } else {
            startLoading();
          }
        });

        return apexPromise;
      }



      function deepMerge(target, source) {
        for (const key in source) {
          if (
            source[key] &&
            typeof source[key] === 'object' &&
            !Array.isArray(source[key])
          ) {
            if (!target[key]) target[key] = {};
            deepMerge(target[key], source[key]);
          } else {
            target[key] = source[key];
          }
        }
        return target;
      }

      async function renderChart(elementId, labelData, seriesData, customOptions = {}) {
        const options = {
          chart: {
            type: 'line',
            height: 400,
            toolbar: { show: false },
            zoom: {
              enabled: false
            },
            fontFamily: 'Ubuntu',
          },
          series: [{ name: customOptions.seriesName || '', data: seriesData }],
          xaxis: {
                type: 'datetime',
                categories: labelData,
                tickAmount: 6,
                labels: {
                  style: { colors: '#000' },
                  format: 'yyyy-MM'
              },

          },
          tooltip: {
            x: {
              format: 'yyyy-MM'
            },
            enabled: true
          },
          yaxis: { labels: { style: { colors: '#000' }, min: 0 } },
          stroke: { curve: 'smooth', width: 2 },
          markers: { size: 5 },
          colors: ['#000'],
          grid: { borderColor: '#e0e0e0' },
          theme: {
              mode: 'light',
              monochrome: {
                  enabled: false,
                  color: '#000000',
                  shadeTo: 'dark',
                  shadeIntensity: 0.65
              },
          },
        };

        let fullOptions = deepMerge(
          structuredClone(options), // avoid mutating original
          customOptions
        );

        await loadApexCharts();

        const chart = new ApexCharts(document.querySelector('#' + elementId), fullOptions);
        chart.render();
      }
    </script>
    <style>
        .chart {
        background-color: #fff;
        }

        @media (prefers-color-scheme: dark) {
            .chart {
                filter: invert(1) hue-rotate(180deg);
            }

            .apexcharts-tooltip, .apexcharts-tooltip-title{
                background: rgba(255, 255, 255, 0.96) !important;
                color: #000 !important;
            }
        }
    </style>
</head>
<body>
    <%- include('../header.ejs') %>
	<main>
      <div class="grid-asmuo">
        <section style="grid-area: pavadinimas;">
          <h1 style="margin-bottom: 12px;"><%= asmuo.jar.pavadinimas %>
            <sup>(<%= asmuo.jar.duomenuData %>)</sup>
          </h1>
        </section>

        <section style="grid-area: metaduomenys;">
          <% if(asmuo.sodra && asmuo.sodra.ekonominesVeiklosPavadinimas) { %>
            <%= asmuo.sodra.ekonominesVeiklosPavadinimas %> (<pre style="display: inline;"><%= asmuo.sodra.ekonominesVeiklosKodas %></pre>)
            <br><br>
          <% } %>

          <div>
            <a href="/asmuo/<%= asmuo.jar.jarKodas %>.json">↗ JSON</a>&nbsp;

            <% if(asmuo.sodra && asmuo.sodra.kodas) { %>
                <a href="https://atvira.sodra.lt/imones/detaliai/index.html?code=<%= asmuo.sodra.kodas %>">↗ SODRA</a>&nbsp;
            <% } %>
            <a href="https://liteko.teismai.lt/viesasprendimupaieska/paieska.aspx?txt=<%= asmuo.jar.jarKodas %>">↗ Bylos</a>&nbsp;

            <a href="/pirkejas/<%= asmuo.jar.jarKodas %>">↗ Pirkimai</a>&nbsp;
            <a href="/tiekejas/<%= asmuo.jar.jarKodas %>">↗ Pardavimai</a>&nbsp;
          </div>

          <% if(asmuo.sodra && asmuo.sodra.data) { %>
            <p><i>Duomenys <%= asmuo.sodra.data %>, nebent nurodyta kitaip.</i></p>
          <% } %>
        </section>

        <section style="grid-area: zemelapis; height: 100%; min-height: 300px;">
            <% if (asmuo?.jar?.koordinates) { %>
                <div id="map" style="  width: 100%; height: 100%;" data-x="<%= asmuo.jar.koordinates.x %>" data-y="<%= asmuo.jar.koordinates.y %>"></div>
            <% } %>
        </section>

        <section style="grid-area: kodai;">
            <h2><u>Kodai</u></h2>

            <h3>
                Juridinių asmenų registras
                <sup>(<%= asmuo.jar.duomenuData %>)</sup>
            </h3>

    		<pre style="display: inline;"><%= asmuo.jar.jarKodas %></pre>
            (<%= asmuo.jar.formosPavadinimas %>)

            <% if(asmuo.sodra && asmuo.sodra.kodas) { %>
                <h3>Sodra</h3>
                <pre><%= asmuo.sodra.kodas %></pre>
            <% } %>
        </section>

        <section style="grid-area: veikla;">
          <h2><u>Veikla</u>
            <sup>(<%= asmuo.jar.duomenuData %>)</sup>
          </h2>

          <h3>Įregistruota</h3>
            <%= asmuo.jar.registravimoData %>

          <h3>Vieta</h3>
          <% if (asmuo.jar.koordinates) { %>
            <a href="https://www.openstreetmap.org/?mlat=<%= asmuo.jar.koordinates.y %>&mlon=<%= asmuo.jar.koordinates.x %>&zoom=16" target="_blank">
              <%= asmuo.jar.adresas %>
            </a>
          <% } else { %>
            <%= asmuo.jar.adresas %>
          <% } %>
        </section>

        <section style="grid-area: darbuotojai;">
          <h2><u>Darbuotojai</u></h2>

          <% if(asmuo.sodra && asmuo.sodra.draustieji) { %>
            <h3>Darbo sutartys</h3>
              <%= asmuo.sodra.draustieji %> &nbsp;
            <h3>Autorinės ir kitos sutartys</h3>
              <%= asmuo.sodra.draustieji2 || 0 %>
            <h3>Viso</h3>
              <%= asmuo.sodra.draustieji + asmuo.sodra.draustieji2 %>
          <% } else { %>
            <i>Nėra duomenų</i>
          <% } %>
        </section>

        <section style="grid-area: atlyginimai;">
          <h2><u>Vid. atlyginimai</u></h2>

            <% if(asmuo.sodra && asmuo.sodra.vidutinisAtlyginimas) { %>
              <h3>Darbo sutartys</h3>
                <% if(asmuo.sodra.vidutinisAtlyginimas) { %>
                  <%= asmuo.sodra.vidutinisAtlyginimas.toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €/mėn.
                <% } else { %>
                  <i>Nėra duomenų</i>
                <% } %>

              <h3>Autorinės ir kitos sutartys</h3>
                <% if (asmuo.sodra.vidutinisAtlyginimas2) { %>
                  <%= asmuo.sodra.vidutinisAtlyginimas2.toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €/mėn.
                <% } else { %>
                  <i>Nėra duomenų</i>
                <% } %>

              <h3>Bendrai</h3>
              <%= asmuo.sodra.bendrasVidutinisAtlyginimas.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn. %>
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>
        </section>

        <section style="grid-area: mokejimai;">
          <h2><u>Mokėjimai</u></h2>

          <h3>Mokesčiai (VMI)</h3>
            <% if(asmuo.mokesciai && asmuo.mokesciai.suma) { %>
              <%= asmuo.mokesciai.suma.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
              <sup>(<%= asmuo.mokesciai.data %>)</sup>
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>

          <h3>Atlyginimai</h3>
            <% if(asmuo.sodra && asmuo.sodra.atlyginimuIslaidos) { %>
              <%= asmuo.sodra.atlyginimuIslaidos.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn.<br>
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>

          <h3>SODRA įmokos</h3>
            <% if(asmuo.sodra && asmuo.sodra.imokuSuma) { %>
              <%= asmuo.sodra.imokuSuma.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>
        </section>
      </div>
        <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
            <script defer>
                const sodraLabels = [
                <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                    '<%= item.data %>-01'<%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
                <% }) %>
                ];
            </script>
        <% } %>

        <h2><u>Vidutinis darbo užmokestis</u></h2>
        <i>Neatskaičius mokesčių, €/mėn.</i>
        <div class="col-2 mobile-col-1">
            <section style="width: 100%;">
                <h3>Darbo sutartys, valstybės tarnautojai</h3>
                <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
                    <div id="vidAtlyginimoDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const atlyginimai = [
                        <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                          <%= item.vidutinisAtlyginimas || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
                        <% }) %>
                      ];

                      renderChart('vidAtlyginimoDiagrama', sodraLabels, atlyginimai, {seriesName: "EUR"});
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
            <section style="width: 100%;">
                <h3>Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos</h3>
                <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
                    <div id="vidAtlyginimoIIDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const atlyginimaiII = [
                        <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                          <%= item.vidutinisAtlyginimas2 || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
                        <% }) %>
                      ];

                      renderChart('vidAtlyginimoIIDiagrama', sodraLabels, atlyginimaiII, {seriesName: "EUR"});
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
        </div>

        <h2 style="margin-bottom: 0px;"><u>Darbuotojų skaičius</u></h2>
        <div class="col-2 mobile-col-1">
            <section style="width: 100%;">
                <h3>Darbo sutartys, valstybės tarnautojai</h3>
                <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
                    <div id="darbuotojuSkaiciausDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const darbuotojai = [
                        <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                          <%= item.draustieji || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
                        <% }) %>
                      ];

                      renderChart('darbuotojuSkaiciausDiagrama', sodraLabels, darbuotojai);
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
            <section style="width: 100%;">
                <h3>Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos</h3>
                <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
                    <div id="darbuotojuSkaiciausIIDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const darbuotojaiII = [
                        <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                          <%= item.draustieji2 || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
                        <% }) %>
                      ];

                      renderChart('darbuotojuSkaiciausIIDiagrama', sodraLabels, darbuotojaiII);
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
        </div>

        <div class="col-2 mobile-col-1">
            <section style="width: 100%;">
                <h2><u>SODRA įmokos</u></h2>
                <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
                    <div id="sodraImokosDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const sodraImokos = [
                        <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                          <%= item.imokuSuma || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
                        <% }) %>
                      ];

                      renderChart('sodraImokosDiagrama', sodraLabels, sodraImokos, {seriesName: "EUR"})
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
            <section style="width: 100%;">
                <h2><u>VMI įmokos</u></h2>
                <% if(asmuo.mokesciai && asmuo.mokesciai.duomenys && asmuo.mokesciai.duomenys.length > 0) { %>
                    <div id="vmiMokesciuDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const vmiLabels = [
                        <% asmuo.mokesciai.duomenys.forEach((item, i) => { %>
                          '<%= item.data %>-01'<%= i < asmuo.mokesciai.duomenys.length - 1 ? ',' : '' %>
                        <% }) %>
                      ];

                      const vmiData = [
                        <% asmuo.mokesciai.duomenys.forEach((item, i) => { %>
                          <%= item.suma || "null" %><%= i < asmuo.mokesciai.duomenys.length - 1 ? ',' : '' %>
                        <% }) %>
                      ];

                      // Find last label
                      const lastLabel = vmiLabels[vmiLabels.length - 1];
                      const lastDate = new Date(lastLabel);
                      const lastMonth = lastDate.getMonth() + 1; // JS months start at 0

                      // Add annotation only if it's not December
                      let annotations = {};
                      if (lastMonth !== 12) {
                        const startOfYear = new Date(lastDate.getFullYear(), 0, 1);

                        annotations = {
                          xaxis: [
                            {
                              x: startOfYear.getTime(),
                              borderColor: '#777',
                              label: {
                                style: {
                                  color: '#000',
                                },
                                position: 'bottom',
                                text: 'Nebaigti duomenys:'
                              }
                            }
                          ]
                        };
                      }

                      renderChart('vmiMokesciuDiagrama', vmiLabels, vmiData, { annotations, seriesName: "EUR" });
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
        </div>

        <h2><u>Viešųjų pirkimų sutartys</u></h2>
        <div class="col-2 mobile-col-1">
            <section style="width: 100%;">
                <h3>Pirkimai per metus</h3>
                <% if(asmuo.sutartys && asmuo.sutartys.pirkimaiKasMetus	 && asmuo.sutartys.pirkimaiKasMetus.length > 0) { %>
                    <div id="pirkimaiPerMetus" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const pirkimaiKasMetusLabels = [
                        <% asmuo.sutartys.pirkimaiKasMetus.forEach((item, i) => { %>
                          '<%= item.year %>',
                        <% }) %>
                      ];

                      const pirkimaiKasMetus = [
                        <% asmuo.sutartys.pirkimaiKasMetus.forEach((item, i) => { %>
                          <%= item.total || "null" %>,
                        <% }) %>
                      ];

                      renderChart('pirkimaiPerMetus', pirkimaiKasMetusLabels, pirkimaiKasMetus, {
                        seriesName: "EUR",
                        xaxis: {
                              labels: {
                                format: 'yyyy'
                            },

                        },
                        tooltip: {
                          x: {
                            format: 'yyyy'
                          },
                        },
                      });
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
            <section style="width: 100%;">
                <h3>Pardavimai per metus</h3>
                <% if(asmuo.sutartys && asmuo.sutartys.tiekimaiKasMetus && asmuo.sutartys.tiekimaiKasMetus.length > 0) { %>
                    <div id="pardavimaiPerMetus" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                      const pardavimaiKasMetusLabels = [
                        <% asmuo.sutartys.tiekimaiKasMetus.forEach((item, i) => { %>
                          '<%= item.year %>',
                        <% }) %>
                      ];

                      const pardavimaiKasMetus = [
                        <% asmuo.sutartys.tiekimaiKasMetus.forEach((item, i) => { %>
                          <%= item.total || "null" %>,
                        <% }) %>
                      ];

                      renderChart('pardavimaiPerMetus', pardavimaiKasMetusLabels, pardavimaiKasMetus, {
                        seriesName: "EUR",
                        xaxis: {
                              labels: {
                                format: 'yyyy'
                            },

                        },
                        tooltip: {
                          x: {
                            format: 'yyyy'
                          },
                        },
                      });
                    </script>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
        </div>
        <div class="col-2 mobile-col-1" style="gap: 8px;">
            <section style="width: 100%;">
                <h3>TOP 10 tiekėjų</h3>
                <% if(asmuo.sutartys && asmuo.sutartys.topTiekejai && asmuo.sutartys.topTiekejai.length > 0) { %>
                    <table style="width: 100%; min-width: 0px;">
                        <thead>
                            <tr>
                                <th>Vieta</th>
                                <th>Tiekėjas</th>
                                <th>Suma</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let id = 1; %>
                            <% asmuo.sutartys.topTiekejai.forEach(function(tiekejas){ %>
                                <tr>
                                    <td class="center" style="width: 5ch;"><%= id %></td>
                                    <td>
                                        <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            <a href="/?perkanciosiosOrganizacijosKodas=<%= asmuo.jar.jarKodas || "" %>&tiekejoKodas=<%= tiekejas.jarKodas %>">
                                                <%= tiekejas.pavadinimas %>
                                            </a>
                                        </div>
                                    </td>
                                    <td class="center" style="width: 9ch;">
                                        <%= tiekejas.total.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) %>
                                    </td>
                                </tr>
                                <% id++; %>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
            <section style="width: 100%;">
                <h3>TOP 10 pirkėjų</h3>
                <% if(asmuo.sutartys && asmuo.sutartys.topPirkejai && asmuo.sutartys.topPirkejai.length > 0) { %>
                    <table style="width: 100%; min-width: 0px;">
                        <thead>
                            <tr>
                                <th>Vieta</th>
                                <th>Pirkėjas</th>
                                <th>Suma</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let id = 1; %>
                            <% asmuo.sutartys.topPirkejai.forEach(function(pirkejas){ %>
                                <tr>
                                    <td class="center" style="width: 5ch;"><%= id %></td>
                                    <td>
                                        <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            <a href="/?perkanciosiosOrganizacijosKodas=<%= pirkejas.jarKodas %>&tiekejoKodas=<%= asmuo.jar.jarKodas || "" %>">
                                                <%= pirkejas.pavadinimas %>
                                            </a>
                                        </div>
                                    </td>
                                    <td class="center" style="width: 9ch;">
                                        <%= pirkejas.total.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) %>
                                    </td>
                                </tr>
                                <% id++; %>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                <% } %>
            </section>
        </div>

        <% if(asmuo.regitra && asmuo.regitra.length > 0){ %>
            <h2><u>Transporto priemonės</u></h2>
            <div class="tableContainer">
            <table style="width: auto; min-width: 70vw;">
                <thead>
                    <tr>
                        <th>Marke</th>
                        <th>Pavadinimas</th>
                        <th>Kategorija</th>
                        <th>Degalai</th>
                        <th>Galia (kW)</th>
                        <th>Vietos</th>
                        <th>Pirmoji registracija</th>
                        <th>Savininkas</th>
                    </tr>
                </thead>
                <tbody>
                    <% asmuo.regitra.forEach(function(auto){ %>
                        <%
                          let savinikas = "Ne";
                          if(auto.valdymoTeise == "A"){
                              savininkas = "Taip";
                          }
                        %>
                        <tr>
                            <td><%= auto.marke %></td>
                            <td><%= auto.komercinisPavadinimas %></td>
                            <td class="center"><%= auto.kategorijaKlase %></td>
                            <td class="center"><%= auto.degalai || "-" %></td>
                            <td class="center"><%= auto.galia || "-" %></td>
                            <td class="center"><%= (Number(auto.sedimuVietuSkaicius) + Number(auto.stovimuVietuSkaicius)) || "-" %></td>
                            <td class="center"><%= auto.pirmosiosRegistracijosData || "-" %></td>
                            <td class="center"><%= savininkas || "?" %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            </div>
        <% } %>
        <% if(asmuo.teismoNuosprendziai	 && asmuo.teismoNuosprendziai.length > 0){ %>
            <h2><u>Teismo nuosprendžiai</u></h2>
            <i>Šiuo metu importuojami teismo nuosprendžių duomenys, todėl gali būti, kad ne visi nuosprendžiai yra rodomi.</i><br><br>
            <div class="tableContainer">
            <table style="width: auto; min-width: 70vw;">
                <thead>
                    <tr>
                        <th>Bylos numeris</th>
                        <th>Rūšis</th>
                        <th>Data</th>
                        <th>Rolė</th>
                        <th>Teismas</th>
                    </tr>
                </thead>
                <tbody>
                    <% asmuo.teismoNuosprendziai.forEach(function(nuosprendis){ %>
                        <tr>
                            <td>
                                <a href="https://liteko.teismai.lt/viesasprendimupaieska/<%= nuosprendis.fileHref %>" target="_blank">
                                    <%= nuosprendis.bylosNumeris %>
                                </a>
                            </td>
                            <td style="max-width: 30ch;"><%= nuosprendis.bylosRusis %></td>
                            <td class="center"><%= nuosprendis.data.toLtDate() %></td>
                            <% if(nuosprendis.bylojeKaip == "Atsakovas") { %>
                                <td style="max-width: 30ch;">
                                    <u>
                                        <%= nuosprendis.bylojeKaip %>
                                    </u>
                                </td>
                            <% } else { %>
                                <td style="max-width: 30ch;"><%= nuosprendis.bylojeKaip %></td>
                            <% } %>
                            <td style="max-width: 40ch;"><%= nuosprendis.teismas %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            </div>
        <% } %>
	</main>
    <%- include('../footer.ejs') %>
</body>
</html>
