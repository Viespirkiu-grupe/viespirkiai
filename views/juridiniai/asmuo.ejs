<!DOCTYPE html>
<html>
<head>
  <%- include('../head.ejs', {
    pageTitle: asmuo.jar.pavadinimas,
    pageDescription: `Juridinio asmens informacija`,
    pageImage: `https://viespirkiai.org/asmuo/${asmuo.jar.jarKodas}.png`,
    customHead
  }) %>
  <%- include('../js/charts.ejs') %>
  <% if (asmuo.jar.location) { %>
    <script>
    window.addEventListener('DOMContentLoaded', () => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/dist/leaflet.css';
      document.head.appendChild(link);
      const script = document.createElement('script');
      script.src = '/dist/leaflet.js';
      script.defer = true;
      script.onload = () => {
        const mapEl = document.getElementById('asmuo-map');
        const map = L.map('asmuo-map').setView([mapEl.dataset.y, mapEl.dataset.x], 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        L.marker([mapEl.dataset.y, mapEl.dataset.x]).addTo(map);
      };
      document.body.appendChild(script);
    });
    </script>
  <% } %>
</head>
<body>
  <%- include('../header.ejs') %>
  <main>

      <div class="page-header">
        <div>
          <h1 class="mb-0"><%= asmuo.jar.pavadinimas %></h1>
        </div>
        <div class="d-flex flex-wrap gap-2 align-center">
          <a href="/asmuo/<%= asmuo.jar.jarKodas %>.json" class="btn btn-outline btn-sm">↗ JSON</a>
          <% if (asmuo.sodra?.kodas) { %>
            <a href="https://atvira.sodra.lt/imones/detaliai/index.html?code=<%= asmuo.sodra.kodas %>" class="btn btn-outline btn-sm">↗ SODRA</a>
          <% } %>
          <a href="https://liteko.teismai.lt/viesasprendimupaieska/paieska.aspx?txt=<%= asmuo.jar.jarKodas %>" class="btn btn-outline btn-sm">↗ Bylos</a>
          <a href="/pirkejas/<%= asmuo.jar.jarKodas %>" class="btn btn-outline btn-sm">↗ Pirkimai</a>
          <a href="/tiekejas/<%= asmuo.jar.jarKodas %>" class="btn btn-outline btn-sm">↗ Pardavimai</a>
        </div>
      </div>

      <div class="grid-3 mb-5" style="align-items: start;">


          <div>
          <div class="text-muted text-xs">Duomenys gali būti pasenę</div><br>
        <dl class="kv-list">


          <dt>JAR kodas</dt>
          <dd><span class="cell-mono"><%= asmuo.jar.jarKodas %></span> · <%= asmuo.jar.formosPavadinimas %></dd>

          <% if (asmuo.sodra?.kodas) { %>
            <dt>SODRA kodas</dt>
            <dd><span class="cell-mono"><%= asmuo.sodra.kodas %></span></dd>
          <% } %>

          <% if (asmuo.sodra?.ekonominesVeiklosPavadinimas) { %>
            <dt>Veikla</dt>
            <dd><%= asmuo.sodra.ekonominesVeiklosPavadinimas %> (<span class="cell-mono"><%= asmuo.sodra.ekonominesVeiklosKodas %></span>)</dd>
          <% } %>

          <dt>Įregistruota</dt>
          <dd><%= asmuo.jar.registravimoData %></dd>

          <dt>Adresas</dt>
          <dd>
            <% if (asmuo.jar.location) { %>
              <a href="https://www.openstreetmap.org/?mlat=<%= asmuo.jar.location[0] %>&mlon=<%= asmuo.jar.location[1] %>&zoom=16" target="_blank"><%= asmuo.jar.adresas %></a>
            <% } else if (asmuo.jar.adresas) { %>
              <%= asmuo.jar.adresas %>
            <% } else { %>
              <em class="text-muted">Nenurodytas</em>
            <% } %>
          </dd>

          <% if (asmuo.istatinisKapitalas?.reiksme) { %>
            <dt>Įstatinis kapitalas</dt>
            <dd>
              <span class="cell-mono"><%= asmuo.istatinisKapitalas.reiksme.toLocaleString('lt-LT', { style: 'currency', currency: asmuo.istatinisKapitalas.valiuta }) %></span>
              <span class="text-muted text-xs">(<%= asmuo.istatinisKapitalas.data %>)</span>
            </dd>
          <% } %>

          <% if (asmuo.jadis && Object.keys(asmuo.jadis).length > 0) { %>
            <% const jadis = asmuo.jadis; %>
            <dt>Dalyviai</dt>
            <dd>
              <div class="d-flex flex-col gap-1">
                <% if (jadis.lrFiziniai > 0) { %><span><%= Number(jadis.lrFiziniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %> — fiziniai (LT)</span><% } %>
                <% if (jadis.lrJuridiniai > 0) { %><span><%= Number(jadis.lrJuridiniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %> — juridiniai (LT)</span><% } %>
                <% if (jadis.uzsienioFiziniai > 0) { %><span><%= Number(jadis.uzsienioFiziniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %> — fiziniai (užsienis)</span><% } %>
                <% if (jadis.uzsienioJuridiniai > 0) { %><span><%= Number(jadis.uzsienioJuridiniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %> — juridiniai (užsienis)</span><% } %>
              </div>
            </dd>
          <% } %>
        </dl>
          </div>

        <% if (asmuo.jar.location) { %>
          <div id="asmuo-map" class="map-container" style="grid-column: span 2; height: 100%; min-height: 280px;"
            data-x="<%= asmuo.jar.location[1] %>"
            data-y="<%= asmuo.jar.location[0] %>">
          </div>
        <% } %>

      </div>

      <div class="grid-3 mb-6">

        <div class="card">
          <div class="card-body">
            <div class="section-title mb-3">Darbuotojai</div>
            <% if (asmuo.sodra?.draustieji) { %>
              <dl class="kv-list">
                <dt>Darbo sutartys</dt>
                <dd><span class="cell-mono"><%= asmuo.sodra.draustieji %></span></dd>
                <dt>Autorinės ir kitos</dt>
                <dd><span class="cell-mono"><%= asmuo.sodra.draustieji2 || 0 %></span></dd>
                <dt>Viso</dt>
                <dd><span class="cell-mono fw-bold"><%= asmuo.sodra.draustieji + (asmuo.sodra.draustieji2 || 0) %></span></dd>
              </dl>
            <% } else { %>
              <em class="text-muted">Nėra duomenų</em>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="section-title mb-3">Vid. atlyginimai</div>
            <% if (asmuo.sodra?.vidutinisAtlyginimas) { %>
              <dl class="kv-list">
                <dt>Darbo sutartys</dt>
                <dd><span class="cell-mono"><%= asmuo.sodra.vidutinisAtlyginimas.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn.</span></dd>
                <dt>Autorinės ir kitos</dt>
                <dd>
                  <% if (asmuo.sodra.vidutinisAtlyginimas2) { %>
                    <span class="cell-mono"><%= asmuo.sodra.vidutinisAtlyginimas2.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn.</span>
                  <% } else { %>
                    <em class="text-muted">Nėra duomenų</em>
                  <% } %>
                </dd>
                <dt>Bendrai</dt>
                <dd><span class="cell-mono fw-bold"><%= asmuo.sodra.bendrasVidutinisAtlyginimas.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn.</span></dd>
              </dl>
            <% } else { %>
              <em class="text-muted">Nėra duomenų</em>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="section-title mb-3">Mokėjimai</div>
            <dl class="kv-list">
              <dt>Mokesčiai (VMI)</dt>
              <dd>
                <% if (asmuo.mokesciai?.suma) { %>
                  <span class="cell-mono"><%= asmuo.mokesciai.suma.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</span>
                  <span class="text-muted text-xs">(<%= asmuo.mokesciai.data %>)</span>
                <% } else { %>
                  <em class="text-muted">Nėra duomenų</em>
                <% } %>
              </dd>
              <dt>Atlyginimai</dt>
              <dd>
                <% if (asmuo.sodra?.atlyginimuIslaidos) { %>
                  <span class="cell-mono"><%= asmuo.sodra.atlyginimuIslaidos.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn.</span>
                <% } else { %>
                  <em class="text-muted">Nėra duomenų</em>
                <% } %>
              </dd>
              <dt>SODRA įmokos</dt>
              <dd>
                <% if (asmuo.sodra?.imokuSuma) { %>
                  <span class="cell-mono"><%= asmuo.sodra.imokuSuma.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</span>
                <% } else { %>
                  <em class="text-muted">Nėra duomenų</em>
                <% } %>
              </dd>
            </dl>
          </div>
        </div>

      </div>

    <% if (asmuo.sodra?.duomenys?.length > 0) { %>
      <script defer>
        const sodraLabels = [
          <% asmuo.sodra.duomenys.forEach((item, i) => { %>
            '<%= item.data %>-01'<%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
          <% }) %>
        ];
      </script>
    <% } %>

    <%- include("asmuoDalys/vidutinisDarboUzmokestis.ejs") %>
    <%- include("asmuoDalys/darbuotojuSkaicius.ejs") %>
    <%- include("asmuoDalys/imokos.ejs") %>
    <%- include("asmuoDalys/sutartys.ejs") %>

    <div class="grid-2 mb-6">
      <%- include("asmuoDalys/melagiai.ejs") %>
      <%- include("asmuoDalys/nepatikimi.ejs") %>
    </div>

    <%- include("asmuoDalys/finansinesAtaskaitos.ejs") %>

    <div class="grid-2 mb-6">
      <%- include("asmuoDalys/darboSkelbimai.ejs") %>
      <%- include("asmuoDalys/rcPranesimai.ejs") %>
      <%- include("asmuoDalys/domenai.ejs") %>
      <%- include("asmuoDalys/kotis.ejs") %>
      <%- include("asmuoDalys/esInvesticijos.ejs") %>
    </div>

    <%- include("asmuoDalys/regitra.ejs") %>
    <%- include("asmuoDalys/teismoNuosprendziai.ejs") %>
    <%- include("asmuoDalys/pinregDeklaracijos.ejs") %>

  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
