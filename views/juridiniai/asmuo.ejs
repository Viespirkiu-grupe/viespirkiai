<!DOCTYPE html>
<html>
<head>
	<%- include('../head.ejs', {
          pageTitle: asmuo.jar.pavadinimas,
          pageDescription: `Juridinio asmens informacija`,
          pageImage: `https://viespirkiai.top/asmuo/${asmuo.jar.jarKodas}.png`,
          customHead
    }) %>

    <% if(asmuo.jar.koordinates) { %>
        <script>
        window.addEventListener('DOMContentLoaded', () => {
          // 1. Load Leaflet CSS
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = '/dist/leaflet.css';
          document.head.appendChild(link);

          // 2. Load Leaflet JS dynamically
          const script = document.createElement('script');
          script.src = '/dist/leaflet.js';
          script.defer = true;
          script.onload = () => {
            // 3. Initialize map after JS is ready
            const mapEl = document.getElementById('map');
            const map = L.map('map').setView([mapEl.dataset.y, mapEl.dataset.x], 16);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            L.marker([mapEl.dataset.y, mapEl.dataset.x]).addTo(map);
          };
          document.body.appendChild(script);
        });
        </script>
    <% } %>

    <script defer>
      let apexPromise;

      function loadApexCharts() {
        if (window.ApexCharts) return Promise.resolve(window.ApexCharts);
        if (apexPromise) return apexPromise; // already loading

        apexPromise = new Promise((resolve, reject) => {
          function startLoading() {
            const script = document.createElement('script');
            script.src = '/dist/apexcharts.js';
            script.defer = true;
            script.onload = () => resolve(window.ApexCharts);
            script.onerror = reject;
            document.body.appendChild(script);
          }

          if (document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', startLoading);
          } else {
            startLoading();
          }
        });

        return apexPromise;
      }



      function deepMerge(target, source) {
        for (const key in source) {
          if (
            source[key] &&
            typeof source[key] === 'object' &&
            !Array.isArray(source[key])
          ) {
            if (!target[key]) target[key] = {};
            deepMerge(target[key], source[key]);
          } else {
            target[key] = source[key];
          }
        }
        return target;
      }

      async function renderChart(elementId, labelData, seriesData, customOptions = {}, noOptions = false) {
        let options = {
          chart: {
            type: 'line',
            height: 400,
            toolbar: { show: false },
            zoom: {
              enabled: false
            },
            fontFamily: 'Ubuntu',
          },
          xaxis: {
                type: 'datetime',
                categories: labelData,
                tickAmount: 6,
                labels: {
                  style: { colors: '#000' },
                  format: 'yyyy-MM'
              },

          },
          tooltip: {
            x: {
              format: 'yyyy-MM'
            },
            enabled: true
          },
          yaxis: { labels: { style: { colors: '#000' }, min: 0 } },
          stroke: { curve: 'smooth', width: 2 },
          markers: { size: 5 },
          colors: ['#000'],
          grid: { borderColor: '#e0e0e0' },
          theme: {
              mode: 'light',
              monochrome: {
                  enabled: false,
                  color: '#000000',
                  shadeTo: 'dark',
                  shadeIntensity: 0.65
              },
          },
        };

        if(noOptions) {
            options = {};
        }

        if(!options.xaxis) options.xaxis = {};
        options.xaxis.categories = labelData;

        // Check if seriesData is a flat Array
        if(Array.isArray(seriesData) && (seriesData.length === 0 || typeof seriesData[0] !== 'object')) {
            options.series = [{ name: customOptions.seriesName || '', data: seriesData }];
        }else{
            options.series = seriesData;
        }

        let fullOptions = deepMerge(
          structuredClone(options), // avoid mutating original
          customOptions
        );

        await loadApexCharts();

        console.log(elementId, fullOptions)

        const chart = new ApexCharts(document.querySelector('#' + elementId), fullOptions);
        chart.render();
      }
    </script>
    <style>
        .chart {
            background-color: #fff;
        }

        @media (prefers-color-scheme: dark) {
            .chart {
                filter: invert(1) hue-rotate(180deg);
            }

            .apexcharts-tooltip, .apexcharts-tooltip-title{
                background: rgba(255, 255, 255, 0.96) !important;
                color: #000 !important;
            }
        }
    </style>
</head>
<body>
    <%- include('../header.ejs') %>
	<main>
      <div class="grid-asmuo">
        <section style="grid-area: pavadinimas;">
          <h1 style="margin-bottom: 12px;"><%= asmuo.jar.pavadinimas %>
            <sup>(<%= asmuo.jar.duomenuData %>)</sup>
          </h1>
        </section>

        <section style="grid-area: metaduomenys;">
          <% if(asmuo.sodra && asmuo.sodra.ekonominesVeiklosPavadinimas) { %>
            <%= asmuo.sodra.ekonominesVeiklosPavadinimas %> (<pre style="display: inline;"><%= asmuo.sodra.ekonominesVeiklosKodas %></pre>)
            <br><br>
          <% } %>

          <div>
            <a href="/asmuo/<%= asmuo.jar.jarKodas %>.json">↗ JSON</a>&nbsp;

            <% if(asmuo.sodra && asmuo.sodra.kodas) { %>
                <a href="https://atvira.sodra.lt/imones/detaliai/index.html?code=<%= asmuo.sodra.kodas %>">↗ SODRA</a>&nbsp;
            <% } %>
            <a href="https://liteko.teismai.lt/viesasprendimupaieska/paieska.aspx?txt=<%= asmuo.jar.jarKodas %>">↗ Bylos</a>&nbsp;

            <a href="/pirkejas/<%= asmuo.jar.jarKodas %>">↗ Pirkimai</a>&nbsp;
            <a href="/tiekejas/<%= asmuo.jar.jarKodas %>">↗ Pardavimai</a>&nbsp;
          </div>

          <% if(asmuo.sodra && asmuo.sodra.data) { %>
            <p><i>Duomenys <%= asmuo.sodra.data %>, nebent nurodyta kitaip.</i></p>
          <% } %>
        </section>

        <section style="grid-area: zemelapis; height: 100%; min-height: 300px;">
            <% if (asmuo?.jar?.koordinates) { %>
                <div id="map" style="  width: 100%; height: 100%;" data-x="<%= asmuo.jar.koordinates.x %>" data-y="<%= asmuo.jar.koordinates.y %>"></div>
            <% } %>
        </section>

        <section style="grid-area: kodai;">
            <h2><u>Kodai</u></h2>

            <h3>
                Juridinių asmenų registras
                <sup>(<%= asmuo.jar.duomenuData %>)</sup>
            </h3>

    		<pre style="display: inline;"><%= asmuo.jar.jarKodas %></pre>
            (<%= asmuo.jar.formosPavadinimas %>)

            <% if(asmuo.sodra && asmuo.sodra.kodas) { %>
                <h3>Sodra</h3>
                <pre><%= asmuo.sodra.kodas %></pre>
            <% } %>
        </section>

        <section style="grid-area: veikla;">
          <h2><u>Veikla</u>
            <sup>(<%= asmuo.jar.duomenuData %>)</sup>
          </h2>

          <h3>Įregistruota</h3>
            <%= asmuo.jar.registravimoData %>

          <h3>Vieta</h3>
          <% if (asmuo.jar.koordinates) { %>
            <a href="https://www.openstreetmap.org/?mlat=<%= asmuo.jar.koordinates.y %>&mlon=<%= asmuo.jar.koordinates.x %>&zoom=16" target="_blank">
              <%= asmuo.jar.adresas %>
            </a>
          <% } else { %>
            <%= asmuo.jar.adresas %>
          <% } %>
        </section>

        <section style="grid-area: darbuotojai;">
          <h2><u>Darbuotojai</u></h2>

          <% if(asmuo.sodra && asmuo.sodra.draustieji) { %>
            <h3>Darbo sutartys</h3>
              <%= asmuo.sodra.draustieji %> &nbsp;
            <h3>Autorinės ir kitos sutartys</h3>
              <%= asmuo.sodra.draustieji2 || 0 %>
            <h3>Viso</h3>
              <%= asmuo.sodra.draustieji + asmuo.sodra.draustieji2 %>
          <% } else { %>
            <i>Nėra duomenų</i>
          <% } %>
        </section>

        <section style="grid-area: atlyginimai;">
          <h2><u>Vid. atlyginimai</u></h2>

            <% if(asmuo.sodra && asmuo.sodra.vidutinisAtlyginimas) { %>
              <h3>Darbo sutartys</h3>
                <% if(asmuo.sodra.vidutinisAtlyginimas) { %>
                  <%= asmuo.sodra.vidutinisAtlyginimas.toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €/mėn.
                <% } else { %>
                  <i>Nėra duomenų</i>
                <% } %>

              <h3>Autorinės ir kitos sutartys</h3>
                <% if (asmuo.sodra.vidutinisAtlyginimas2) { %>
                  <%= asmuo.sodra.vidutinisAtlyginimas2.toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> €/mėn.
                <% } else { %>
                  <i>Nėra duomenų</i>
                <% } %>

              <h3>Bendrai</h3>
              <%= asmuo.sodra.bendrasVidutinisAtlyginimas.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn. %>
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>
        </section>

        <section style="grid-area: mokejimai;">
          <h2><u>Mokėjimai</u></h2>

          <h3>Mokesčiai (VMI)</h3>
            <% if(asmuo.mokesciai && asmuo.mokesciai.suma) { %>
              <%= asmuo.mokesciai.suma.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
              <sup>(<%= asmuo.mokesciai.data %>)</sup>
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>

          <h3>Atlyginimai</h3>
            <% if(asmuo.sodra && asmuo.sodra.atlyginimuIslaidos) { %>
              <%= asmuo.sodra.atlyginimuIslaidos.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €/mėn.<br>
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>

          <h3>SODRA įmokos</h3>
            <% if(asmuo.sodra && asmuo.sodra.imokuSuma) { %>
              <%= asmuo.sodra.imokuSuma.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
            <% } else { %>
              <i>Nėra duomenų</i>
            <% } %>
        </section>
      </div>


      <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
          <script defer>
              const sodraLabels = [
              <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                  '<%= item.data %>-01'<%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
              <% }) %>
              ];
          </script>
      <% } %>

       <%- include("asmuoDalys/vidutinisDarboUzmokestis.ejs") %>

       <%- include("asmuoDalys/darbuotojuSkaicius.ejs") %>

       <%- include("asmuoDalys/imokos.ejs") %>

       <%- include("asmuoDalys/sutartys.ejs") %>

       <%- include("asmuoDalys/darboGrafikas.ejs") %>

       <%- include("asmuoDalys/istatinisKapitalas.ejs") %>

       <%- include("asmuoDalys/finansinesAtaskaitos.ejs") %>

       <%- include("asmuoDalys/darboSkelbimai.ejs") %>

       <%- include("asmuoDalys/regitra.ejs") %>

       <%- include("asmuoDalys/teismoNuosprendziai.ejs") %>


	</main>
    <%- include('../footer.ejs') %>
</body>
</html>
