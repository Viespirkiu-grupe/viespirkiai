<div class="page-section" id="darbuotojai">
  <h2><a href="#darbuotojai" class="no-style">Darbuotojų skaičius</a></h2>
  <div class="grid-2">

    <div style="display:flex; flex-direction:column; min-height:350px;">
      <h3 class="text-sm fw-bold mb-3">Darbo sutartys, valstybės tarnautojai</h3>
      <% if (asmuo.sodra?.duomenys?.length > 0 && asmuo.sodra.turejoDraustuju) { %>
        <div class="chart-frame">
          <div id="darbuotojuSkaiciausDiagrama" class="chart" style="height:350px;"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#darbuotojuSkaiciausDiagrama'),
            type: 'line-datetime',
            labels: sodraLabels,
            series: [<% asmuo.sodra.duomenys.forEach((item, i) => { %><%= item.draustieji || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %><% }) %>],
            flags: ['yMin0']
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

    <div style="display:flex; flex-direction:column; min-height:350px;">
      <h3 class="text-sm fw-bold mb-3">Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos</h3>
      <% if (asmuo.sodra?.duomenys?.length > 0 && asmuo.sodra.turejoDraustuju2) { %>
        <div class="chart-frame">
          <div id="darbuotojuSkaiciausIIDiagrama" class="chart" style="height:350px;"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#darbuotojuSkaiciausIIDiagrama'),
            type: 'line-datetime',
            labels: sodraLabels,
            series: [<% asmuo.sodra.duomenys.forEach((item, i) => { %><%= item.draustieji2 || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %><% }) %>],
            flags: ['yMin0']
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

  </div>
</div>
