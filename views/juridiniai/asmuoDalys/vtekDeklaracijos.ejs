 <h2 id="pinreg"><u>Privačių interesų deklaracijos</u></h2>
 <% let pinregLimit = Number(queryParams.pinregLimit) || 3; %>
 <% if(queryParams.pinregLimit == "max") {pinregLimit = 10000000} %>
 <% if(asmuo.vtek.rysiaiSuJa.length > pinregLimit || asmuo.vtek.darbovietes.length > pinregLimit || asmuo.vtek.sutuoktinioDarbovietes.length > pinregLimit) { %>
     <i>
         Rodomos tik po paskutinės 3 privačių interesų deklaracijos.
         <a href="?pinregLimit=max#pinreg">
             Rodyti visas (<%= asmuo.vtek.rysiaiSuJa.length + asmuo.vtek.darbovietes.length + asmuo.vtek.sutuoktinioDarbovietes.length %>)
         </a>
     </i>
     <br>
 <% } %>

 <div class="col-3 mobile-col-1">
     <section class="results" style="margin-inline: initial;">
         <h3 style="margin-bottom: 0px;">Ryšiai su juridiniais asmenimis</h3>
         <% let i = 0; %>
         <% asmuo.vtek.rysiaiSuJa.forEach(rysys =>  { %>
            <% i++; if(i > pinregLimit) { return; } %>
             <div class="rezultatas">
                 <div class="rezultatas-top">
                     <span>Nuo <%= rysys.rysioPradzia %></span>
                     <span><%= rysys.kienoRysys && rysys.kienoRysys[0].toUpperCase() + rysys.kienoRysys.slice(1).toLowerCase(); %></span>
                     <span><%= new Date(rysys.pateikimoData).toLtDateTime() %></span>
                 </div>
                 <div class="rezultatas-title">
                     <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= rysys.uuid %>">
                         <%= rysys.asmuo %>
                     </a>
                 </div>
                 <div class="rezultatas-bottom">
                     <%= rysys.rysioPobudzioPavadinimas %>
                 </div>
             </div>
         <% }) %>
     </section>
     <section class="results" style="margin-inline: initial;">
         <h3 style="margin-bottom: 0px;">Darbovietės</h3>
         <% let j = 0; %>
         <% asmuo.vtek.darbovietes.forEach(darboviete =>  { %>
             <% j++; if(j > pinregLimit) { return; } %>
             <div class="rezultatas">
                 <div class="rezultatas-top">
                     <span>Nuo <%= darboviete.rysioPradzia %></span>
                     <span><%= new Date(darboviete.pateikimoData).toLtDateTime() %></span>
                 </div>
                 <div class="rezultatas-title">
                     <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= darboviete.uuid %>">
                         <%=  darboviete.asmuo %>
                     </a>
                 </div>
                 <div class="rezultatas-bottom">
                     <% let pirmas = true; %>
                     <% darboviete.pareigos.forEach(pareigos => { %>
                          <%= pareigos.pareigos && pareigos.pareigos[0].toUpperCase() + pareigos.pareigos.slice(1); %>
                          <% if (!pirmas) { %>, <% } %>
                          <% pirmas = false; %>
                     <% }) %>
                 </div>
             </div>
         <% }) %>
     </section>
     <section class="results" style="margin-inline: initial;">
         <h3 style="margin-bottom: 0px;">Sutuoktinių darbovietės</h3>
         <% let k = 0; %>
         <% asmuo.vtek.sutuoktinioDarbovietes.forEach(darboviete =>  { %>
             <% k++; if(k > pinregLimit) { return; } %>
             <div class="rezultatas">
                 <div class="rezultatas-top">
                     <span>Nuo <%= darboviete.rysioPradzia %></span>
                     <span><%= new Date(darboviete.pateikimoData).toLtDateTime() %></span>
                 </div>
                 <div class="rezultatas-title">
                     <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= darboviete.uuid %>">
                         <%=  darboviete.asmuo %> –
                         <%=  darboviete.sutuoktinis %>
                     </a>
                 </div>
                 <div class="rezultatas-bottom">
                     <% let pirmas = true; %>
                     <% darboviete.pareigos.forEach(pareigos => { %>
                          <%= pareigos.pareigos && pareigos.pareigos[0].toUpperCase() + pareigos.pareigos.slice(1); %>
                          <% if (!pirmas) { %>, <% } %>
                          <% pirmas = false; %>
                     <% }) %>
                 </div>
             </div>
         <% }) %>
     </section>
 </div>
