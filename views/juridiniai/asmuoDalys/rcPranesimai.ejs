<% if (asmuo.rcPranesimai?.rows > 0) { %>
<div class="page-section mb-6" id="rcPranesimai">
  <h2><a href="#rcPranesimai" class="no-style">Registrų centro pranešimai</a></h2>

  <% if (asmuo.rcPranesimai.rows > asmuo.rcPranesimai.limit) { %>
    <p class="text-muted text-sm mb-4">
      Rodomi tik <%= Number(asmuo.rcPranesimai.limit).linksniuoti(["naujausias pranešimas", "naujausi pranešimai", "naujausių pranešimų"]) %>.
      <a href="?rcPranesimaiLimit=max#rcPranesimai">Rodyti visus (<%= asmuo.rcPranesimai.rows %>)</a>
    </p>
  <% } %>

  <div class="result-list">
    <% asmuo.rcPranesimai.pranesimai.forEach(pranesimas => { %>
      <article class="result-card">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div>
              <dt class="sr-only">Paskelbta</dt>
              <dd>Paskelbta <%= pranesimas.leidinioData %></dd>
            </div>
            <div>
              <dt class="sr-only">Leidinys</dt>
              <dd><a href="<%= pranesimas.leidinioLink %>" style="position:relative;z-index:1;"><%= pranesimas.leidinioNumeris %></a></dd>
            </div>
          </dl>

          <h3 class="result-card-title"><%= pranesimas.subtitle || pranesimas.title %></h3>

          <% if (pranesimas.text) { %>
            <p class="text-sm text-muted mt-2" style="display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;">
              <%= pranesimas.text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;") %>
            </p>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<% } %>
