<% if (asmuo.mvpAprasai?.rows?.length > 0) { %>
<div class="page-section mt-6" id="mvp-aprasai">
  <h2><a href="#mvp-aprasai" class="no-style">MVP tvarkos aprašai</a></h2>

  <% if (queryParams.mvpAprasaiLimit == "max") { queryParams.mvpAprasaiLimit = 10000000; } %>
  <% const mvpAprasaiLimit = queryParams.mvpAprasaiLimit || 1; %>

  <% if (asmuo.mvpAprasai.count > mvpAprasaiLimit) { %>
    <p class="text-muted text-sm mb-4">
      Rodomas tik paskutinis aprašas.
      <a href="?mvpAprasaiLimit=max#mvp-aprasai">Rodyti visus (<%= asmuo.mvpAprasai.count %>)</a>
    </p>
  <% } %>

  <div class="subsection">
    <% asmuo.mvpAprasai.rows.slice(0, mvpAprasaiLimit).forEach(aprasas => { %>
      <div class="card mb-3">
        <div class="card-body">

          <div class="font-bold mb-1"><%= aprasas.aprasymas %></div>

          <div class="text-muted text-sm mb-3">
            <% if (aprasas.paskelbimoData) { %>Paskelbta: <strong><%= aprasas.paskelbimoData %></strong><% } %>
            <% if (aprasas.vptGavimoData) { %> &middot; VPT gavimo data: <%= aprasas.vptGavimoData %><% } %>
            <% if (aprasas.galiojaIki) { %> &middot; Galioja iki: <%= aprasas.galiojaIki %><% } %>
          </div>

          <% if (aprasas.rinkmenos?.length > 0) { %>
            <ul class="file-list">
              <% aprasas.rinkmenos.forEach(rinkmena => { %>
                <li class="file-item">
                  <% if (rinkmena.url) { %>
                    <a href="<%= rinkmena.url %>" class="file-link">
                  <% } else { %>
                    <a href="<%= rinkmena.originalUrl %>" class="file-link" target="_blank" rel="noopener">
                  <% } %>
                    <span class="file-ext"><%= rinkmena.extension || '?' %></span>
                    <span class="file-name"><%= rinkmena.pavadinimas %></span>
                    <% if (!rinkmena.url) { %>
                      <span class="text-muted text-xs">↗</span>
                    <% } %>
                  </a>
                </li>
              <% }) %>
            </ul>
          <% } %>

        </div>
      </div>
    <% }) %>
  </div>

</div>
<% } %>
