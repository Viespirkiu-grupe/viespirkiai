<% if (asmuo.domenai?.count > 0) { %>
<div class="page-section mb-10" id="domenai">
  <h2><a href="#domenai" class="no-style">.lt domenai</a></h2>
  <p class="text-muted text-sm mb-4">Pagal savininko pavadinimo panašumą.</p>

  <% if (asmuo.domenai.count > asmuo.domenai.rows.length) { %>
    <p class="text-muted text-sm mb-4">
      Rodomi tik <%= Number(asmuo.domenai.limit).linksniuoti(["domenas", "domenai", "domenų"]) %>.
      <a href="?domenaiLimit=max#domenai">Rodyti visus (<%= asmuo.domenai.count %>)</a>
    </p>
  <% } %>

  <div class="result-list">
    <% asmuo.domenai.rows.forEach(domenas => { %>
      <article class="result-card card-clickable">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div>
              <dt class="sr-only">Registruota</dt>
              <dd><%= String(domenas.created).split(" ")[0] %> – <%= String(domenas.expired).split(" ")[0] %></dd>
            </div>
            <div>
              <dt class="sr-only">Duomenų data</dt>
              <dd>Duomenys <%= String(domenas.domregData).split(" ")[0] %></dd>
            </div>
          </dl>

          <h3 class="result-card-title">
            <a href="https://www.domreg.lt/paslaugos/whois/?search=<%= domenas.domain %>"><%= domenas.domain %></a>
          </h3>

          <div class="result-card-footer">
            <span><strong>Savininkas:</strong> <%= domenas.savininkas %></span>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<% } %>
