<div class="page-section mb-6" id="sutartys">
    <h2><a href="#sutartys" class="no-style">Viešųjų pirkimų sutartys</a></h2>
    <div class="grid-2 mb-6">

      <div class="flex flex-col min-h-[350px]">
        <h3 class="text-sm fw-bold mb-3">Numatytos pirkimų vertės pagal metus</h3>
        <% if (asmuo.sutartys?.pirkimaiKasMetus?.length > 0) { %>
          <div class="chart-frame">
            <div id="pirkimaiPerMetus" class="chart h-[350px]"></div>
          </div>
          <script defer>
            displayChart({
              element: document.querySelector('#pirkimaiPerMetus'),
              type: 'line-datetime',
              labels: [<% asmuo.sutartys.pirkimaiKasMetus.forEach((item, i) => { %>'<%= item.year %>'<%= i < asmuo.sutartys.pirkimaiKasMetus.length - 1 ? ',' : '' %><% }) %>],
              series: [<% asmuo.sutartys.pirkimaiKasMetus.forEach((item, i) => { %><%= item.total || "null" %><%= i < asmuo.sutartys.pirkimaiKasMetus.length - 1 ? ',' : '' %><% }) %>],
              flags: ['yEUR', 'yMin0', 'xYear']
            });
          </script>
        <% } else { %>
          <div class="chart-empty">Nėra duomenų</div>
        <% } %>
      </div>

      <div class="flex flex-col min-h-[350px]">
        <h3 class="text-sm fw-bold mb-3">Numatytos pardavimų vertės pagal metus</h3>
        <% if (asmuo.sutartys?.tiekimaiKasMetus?.length > 0) { %>
          <div class="chart-frame">
            <div id="pardavimaiPerMetus" class="chart h-[350px]"></div>
          </div>
          <script defer>
            var pardavimaiKasMetusLabels = [<% asmuo.sutartys.tiekimaiKasMetus.forEach((item, i) => { %>'<%= item.year %>'<%= i < asmuo.sutartys.tiekimaiKasMetus.length - 1 ? ',' : '' %><% }) %>];
            var pardavimaiKasMetus = [<% asmuo.sutartys.tiekimaiKasMetus.forEach((item, i) => { %><%= item.total || "null" %><%= i < asmuo.sutartys.tiekimaiKasMetus.length - 1 ? ',' : '' %><% }) %>];
            displayChart({
              element: document.querySelector('#pardavimaiPerMetus'),
              type: 'line-datetime',
              labels: pardavimaiKasMetusLabels,
              series: pardavimaiKasMetus,
              flags: ['yEUR', 'yMin0', 'xYear']
            });
          </script>
        <% } else { %>
          <div class="chart-empty">Nėra duomenų</div>
        <% } %>
      </div>

    </div>
    <div class="grid-2">

      <div style="display:flex; flex-direction:column;">
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-sm fw-bold mb-0">TOP 10 tiekėjų</h3>
          <div class="flex gap-2">
            <a href="/asmuo/<%= asmuo.jar.jarKodas %>/sutartys/topTiekejai.csv" class="btn btn-outline btn-sm" aria-label="Atsisiųsti TOP 10 tiekėjų CSV">↗ CSV</a>
            <a href="/asmuo/<%= asmuo.jar.jarKodas %>/sutartys/topTiekejai.jsonl" class="btn btn-outline btn-sm" aria-label="Atsisiųsti TOP 10 tiekėjų JSONL">↗ JSONL</a>
          </div>
        </div>
        <% if (asmuo.sutartys?.topTiekejai?.length > 0) { %>
          <div class="table-wrapper flex-1">
            <table class="table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Tiekėjas</th>
                  <th class="cell-right">Suma</th>
                  <th class="cell-right">Sut.</th>
                </tr>
              </thead>
              <tbody>
                <% asmuo.sutartys.topTiekejai.forEach((tiekejas, i) => { %>
                  <tr>
                    <td class="cell-mono text-muted"><%= i + 1 %></td>
                    <td class="cell-truncate">
                      <a href="/?perkanciosiosOrganizacijosKodas=<%= asmuo.jar.jarKodas %>&tiekejoKodas=<%= tiekejas.jarKodas %>" aria-label="Peržiūrėti tiekėjo <%= tiekejas.pavadinimas %> sutartis"><%= tiekejas.pavadinimas %></a>
                    </td>
                    <td class="cell-mono cell-right"><%= tiekejas.total.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) %></td>
                    <td class="cell-mono cell-right"><%= tiekejas.count.toLocaleString('lt-LT') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="chart-empty flex-1">Nėra duomenų</div>
        <% } %>
      </div>

      <div style="display:flex; flex-direction:column;">
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-sm fw-bold mb-0">TOP 10 pirkėjų</h3>
          <div class="flex gap-2">
            <a href="/asmuo/<%= asmuo.jar.jarKodas %>/sutartys/topPirkejai.csv" class="btn btn-outline btn-sm" aria-label="Atsisiųsti TOP 10 pirkėjų CSV">↗ CSV</a>
            <a href="/asmuo/<%= asmuo.jar.jarKodas %>/sutartys/topPirkejai.jsonl" class="btn btn-outline btn-sm" aria-label="Atsisiųsti TOP 10 pirkėjų JSONL">↗ JSONL</a>
          </div>
        </div>
        <% if (asmuo.sutartys?.topPirkejai?.length > 0) { %>
          <div class="table-wrapper" style="flex:1;">
            <table class="table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Pirkėjas</th>
                  <th class="cell-right">Suma</th>
                  <th class="cell-right">Sut.</th>
                </tr>
              </thead>
              <tbody>
                <% asmuo.sutartys.topPirkejai.forEach((pirkejas, i) => { %>
                  <tr>
                    <td class="cell-mono text-muted"><%= i + 1 %></td>
                    <td class="cell-truncate">
                      <a href="/?perkanciosiosOrganizacijosKodas=<%= pirkejas.jarKodas %>&tiekejoKodas=<%= asmuo.jar.jarKodas %>" aria-label="Peržiūrėti pirkėjo <%= pirkejas.pavadinimas %> sutartis"><%= pirkejas.pavadinimas %></a>
                    </td>
                    <td class="cell-mono cell-right"><%= pirkejas.total.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) %></td>
                    <td class="cell-mono cell-right"><%= pirkejas.count.toLocaleString('lt-LT') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="chart-empty" style="flex:1;">Nėra duomenų</div>
        <% } %>
      </div>

    </div>
</div>
