<% if (asmuo.nepatikimi?.length > 0) { %>
<div class="page-section" id="nepatikimi">
  <h2><a href="#nepatikimi" class="no-style">Nepatikimų tiekėjų sąrašas</a></h2>

  <div class="result-list">
    <% asmuo.nepatikimi.forEach(nepatikimas => { %>
      <article class="result-card">
        <div class="result-card-body">

          <dl class="result-card-meta">
            <div>
              <dt class="sr-only">Įvesta</dt>
              <dd>Įvesta <%= nepatikimas.duomenuIvedimoData %></dd>
            </div>
            <div>
              <dt class="sr-only">Galioja</dt>
              <dd><%= nepatikimas.dataNuoKuriosSkaiciuojama || "nežinoma" %> – <%= nepatikimas.itrauktaIki || "nežinoma" %></dd>
            </div>
            <div>
              <dt class="sr-only">Paskutinį kartą matyta</dt>
              <dd>Matyta <%= nepatikimas.paskutiniKartaMatytaSarase %></dd>
            </div>
          </dl>

          <h3 class="result-card-title">
            <% if (nepatikimas.pagrindimas?.itraukimoPriezastis) { %>
              <%= nepatikimas.pagrindimas.itraukimoPriezastis[0].toUpperCase() + nepatikimas.pagrindimas.itraukimoPriezastis.slice(1) %>
            <% } else { %>
              <em class="text-muted">Įtraukimo priežastis nenurodyta</em>
            <% } %>
          </h3>

          <div class="result-card-footer">
            <span><strong>Pirkėjas:</strong> <%= nepatikimas.pirkimoVykdytojoPavadinimas || "nenurodytas" %></span>
            <span><strong>Pirkimo nr.:</strong> <%= nepatikimas.pirkimoNumeris || "nenurodytas" %></span>
            <% if (nepatikimas.teismoSprendimoLink?.length > 5) { %>
              <span><a href="<%= nepatikimas.teismoSprendimoLink %>" target="_blank" rel="noopener noreferrer">↗ Teismo sprendimas</a></span>
            <% } %>
            <% if (nepatikimas.pagrindimas?.tiekejoPaaiskinimoDokumentoNuoroda?.length > 3) { %>
              <span><a href="<%= nepatikimas.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda %>" target="_blank" rel="noopener noreferrer">↗ Tiekėjo paaiškinimo dokumentas (<%= nepatikimas.pagrindimas.paaiskinimoPateikimoData || "data nenurodyta" %>)</a></span>
            <% } %>
          </div>

          <% if (nepatikimas.pagrindimas?.tiekejoPaaiskinimas?.length > 3) { %>
            <blockquote class="mt-3">
              <%= nepatikimas.pagrindimas.tiekejoPaaiskinimas %>
            </blockquote>
            <% if (nepatikimas.pagrindimas.paaiskinimoPateikimoData) { %>
              <p class="text-muted text-xs mt-1" style="text-align:right;">Pateiktas: <%= nepatikimas.pagrindimas.paaiskinimoPateikimoData %></p>
            <% } %>
          <% } %>

        </div>
      </article>
    <% }) %>
  </div>
</div>
<% } %>
