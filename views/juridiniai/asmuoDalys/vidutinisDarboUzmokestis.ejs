<div class="page-section mb-6" id="uzmokestis">
  <h2><a href="#uzmokestis" class="no-style">Vidutinis darbo užmokestis</a></h2>
  <p class="text-muted text-sm mb-5">Neatskaičius mokesčių, €/mėn.</p>

  <div class="grid-2">
    <div class="flex flex-col min-h-[350px]">
      <h3 class="text-sm fw-bold mb-3">Darbo sutartys, valstybės tarnautojai</h3>
      <% if (asmuo.sodra?.duomenys?.length > 0 && asmuo.sodra.turejoAtlyginimu) { %>
        <div class="chart-frame">
          <div id="vidAtlyginimoDiagrama" class="chart" style="height:300px;"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#vidAtlyginimoDiagrama'),
            type: 'line-datetime',
            labels: sodraLabels,
            series: [<% asmuo.sodra.duomenys.forEach((item, i) => { %><%= item.vidutinisAtlyginimas || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %><% }) %>],
            flags: ['yEURMen', 'yMin0']
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

    <div class="flex flex-col min-h-[350px]">
      <h3 class="text-sm fw-bold mb-3">Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos</h3>
      <% if (asmuo.sodra?.duomenys?.length > 0 && asmuo.sodra.turejoAtlyginimu2) { %>
        <div class="chart-frame">
          <div id="vidAtlyginimoIIDiagrama" class="chart" style="height:300px;"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#vidAtlyginimoIIDiagrama'),
            type: 'line-datetime',
            labels: sodraLabels,
            series: [<% asmuo.sodra.duomenys.forEach((item, i) => { %><%= item.vidutinisAtlyginimas2 || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %><% }) %>],
            flags: ['yEURMen', 'yMin0']
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

  </div>
</div>
