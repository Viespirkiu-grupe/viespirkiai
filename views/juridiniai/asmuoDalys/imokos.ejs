 <div class="col-2 mobile-col-1" id="imokos">
     <section style="width: 100%;">
         <h2><u><a href="#sodraImokos" id="sodraImokos" class="hashHref">SODRA įmokos</a></u></h2>
         <% if(asmuo.sodra && asmuo.sodra.duomenys && asmuo.sodra.duomenys.length > 0) { %>
             <div id="sodraImokosDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

             <script defer>
                const sodraImokos = [
                  <% asmuo.sodra.duomenys.forEach((item, i) => { %>
                    <%= item.imokuSuma || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %>
                  <% }) %>
                ];

                displayChart({
                  element: document.querySelector('#sodraImokosDiagrama'),
                  type: 'line-datetime',
                  labels: sodraLabels,
                  series: sodraImokos,
                  flags: ['yEUR', 'yMin0']
                })

             </script>
         <% } else { %>
             <i class="diagrama-nera-duomenu">Nėra duomenų</i>
         <% } %>
     </section>
     <section style="width: 100%;">
         <h2><u><a href="#vmiImokos" id="vmiImokos" class="hashHref">VMI įmokos</a></u></h2>
         <% if(asmuo.vmi && asmuo.vmi.duomenys && asmuo.vmi.duomenys.length > 0) { %>
             <div id="vmiMokesciuDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

             <script defer>
               const vmiLabels = [
                 <% asmuo.vmi.duomenys.forEach((item, i) => { %>
                   '<%= item.data %>-01'<%= i < asmuo.vmi.duomenys.length - 1 ? ',' : '' %>
                 <% }) %>
               ];

               const vmiData = [
                 <% asmuo.vmi.duomenys.forEach((item, i) => { %>
                   <%= item.suma || "null" %><%= i < asmuo.vmi.duomenys.length - 1 ? ',' : '' %>
                 <% }) %>
               ];

               // Find last label
               const lastLabel = vmiLabels[vmiLabels.length - 1];
               const lastDate = new Date(lastLabel);
               const lastMonth = lastDate.getMonth() + 1; // JS months start at 0

               // Add annotation only if it's not December
               let annotations = {};
               if (lastMonth !== 12) {
                 const startOfYear = new Date(lastDate.getFullYear(), 0, 1);

                 annotations = {
                   xaxis: [
                     {
                       x: startOfYear.getTime(),
                       borderColor: '#777',
                       label: {
                         style: {
                           color: '#000',
                         },
                         position: 'bottom',
                         text: 'Nebaigti duomenys:'
                       }
                     }
                   ]
                 };
               }

               displayChart({
                 element: document.querySelector('#vmiMokesciuDiagrama'),
                 type: 'line-datetime',
                 labels: vmiLabels,
                 series: vmiData,
                 flags: ['yEUR', 'yMin0'],
                 customOptions: { annotations }
               })
             </script>
         <% } else { %>
             <i class="diagrama-nera-duomenu">Nėra duomenų</i>
         <% } %>
     </section>
 </div>
