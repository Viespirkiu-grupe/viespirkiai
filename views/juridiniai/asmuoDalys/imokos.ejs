<div class="page-section mb-10" id="imokos">
  <div class="grid-2">

    <div class="flex flex-col min-h-[350px]">
      <h2 class="mb-4"><a href="#sodraImokos" id="sodraImokos" class="no-style">SODRA įmokos</a></h2>
      <% if (asmuo.sodra?.duomenys?.length > 0) { %>
        <div class="chart-frame">
          <div id="sodraImokosDiagrama" class="chart h-[350px]"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#sodraImokosDiagrama'),
            type: 'line-datetime',
            labels: sodraLabels,
            series: [<% asmuo.sodra.duomenys.forEach((item, i) => { %><%= item.imokuSuma || "null" %><%= i < asmuo.sodra.duomenys.length - 1 ? ',' : '' %><% }) %>],
            flags: ['yEUR', 'yMin0']
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

    <div class="flex flex-col min-h-[350px]">
      <h2 class="mb-4"><a href="#vmiImokos" id="vmiImokos" class="no-style">VMI įmokos</a></h2>
      <% if (asmuo.vmi?.duomenys?.length > 0) { %>
        <div class="chart-frame">
          <div id="vmiMokesciuDiagrama" class="chart h-[350px]"></div>
        </div>
        <script defer>
          const vmiLabels = [<% asmuo.vmi.duomenys.forEach((item, i) => { %>'<%= item.data %>-01'<%= i < asmuo.vmi.duomenys.length - 1 ? ',' : '' %><% }) %>];
          const vmiData   = [<% asmuo.vmi.duomenys.forEach((item, i) => { %><%= item.suma || "null" %><%= i < asmuo.vmi.duomenys.length - 1 ? ',' : '' %><% }) %>];
          const lastDate  = new Date(vmiLabels[vmiLabels.length - 1]);
          const annotations = lastDate.getMonth() + 1 !== 12 ? {
            xaxis: [{ x: new Date(lastDate.getFullYear(), 0, 1).getTime(), borderColor: '#777', label: { style: { color: '#000' }, position: 'bottom', text: 'Nebaigti duomenys:' } }]
          } : {};
          displayChart({
            element: document.querySelector('#vmiMokesciuDiagrama'),
            type: 'line-datetime',
            labels: vmiLabels,
            series: vmiData,
            flags: ['yEUR', 'yMin0'],
            customOptions: { annotations }
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

  </div>
</div>
