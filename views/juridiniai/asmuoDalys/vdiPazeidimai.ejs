<% if (asmuo.vdiPazeidimai?.count > 0) { %>
<div class="page-section mb-6" id="vdiPazeidimai">
  <h2><a href="#vdiPazeidimai" class="no-style">Darbo teisės pažeidimai</a></h2>
  <% if (asmuo.vdiPazeidimai.count > asmuo.vdiPazeidimai.rows.length) { %>
    <p class="text-muted text-sm mb-4">
      Rodomi tik <%= Number(asmuo.vdiPazeidimai.limit).linksniuoti(["pažeidimas", "pažeidimai", "pažeidimų"]) %>.
      <a href="?vdiPazeidimaiLimit=max#vdiPazeidimai">Rodyti visus (<%= asmuo.vdiPazeidimai.count %>)</a>
    </p>
  <% } %>
  <%
    const pazeidimaiAggregated = Object.values(
      asmuo.vdiPazeidimai.rows.reduce((acc, p) => {
        const key = p.straipsnis + (p.dalis ? `-${p.dalis}` : "");
        if (acc[key]) {
          acc[key].kiekis++;
        } else {
          acc[key] = { ...p, kiekis: 1 };
        }
        return acc;
      }, {})
    );
  %>
  <div class="result-list">
    <% pazeidimaiAggregated.forEach(pazeidimas => { %>
      <article class="result-card">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div>
              <dt class="sr-only">Teisės aktas</dt>
              <dd><%= pazeidimas.teisesAktas %></dd>
            </div>
            <div>
              <dt class="sr-only">Straipsnis</dt>
              <dd><%= pazeidimas.straipsnis %> str.<% if (pazeidimas.dalis) { %> <%= pazeidimas.dalis %> d.<% } %></dd>
            </div>
            <% if (pazeidimas.pirmaKarta) { %>
            <div>
              <dd>Pirmą kartą</dd>
            </div>
            <% } %>
          </dl>

          <h3 class="result-card-title">
            <% if (pazeidimas.kiekis > 1) { %>
              <span class="font-bold mr-1"><%= pazeidimas.kiekis %>&times;</span>
            <% } %>
            <%= pazeidimas.pavadinimas %>
          </h3>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<% } %>
