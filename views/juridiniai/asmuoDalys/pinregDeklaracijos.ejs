<div class="page-section" id="pinreg">
  <h2><a href="#pinreg" class="no-style">Privačių interesų deklaracijos</a></h2>
  <%
    const rysiaiTruncated = asmuo.pinreg.counts.rysiaiSuJa > asmuo.pinreg.rysiaiSuJa.length;
    const darbovietesTruncated = asmuo.pinreg.counts.darbovietes > asmuo.pinreg.darbovietes.length;
    const sutuoktinioTruncated = asmuo.pinreg.counts.sutuoktiniuDarbovietes > asmuo.pinreg.sutuoktinioDarbovietes.length;
    const anyTruncated = rysiaiTruncated || darbovietesTruncated || sutuoktinioTruncated;
  %>
  <% if (anyTruncated) { %>
    <p class="text-muted text-sm mb-4">
      Rodomos tik po <%= asmuo.pinreg.limit %> deklaracijos.
      <a href="?pinregLimit=max#pinreg">Rodyti visas (<%= asmuo.pinreg.total %>)</a>
    </p>
  <% } %>

  <div class="grid-3">

    <div>
      <h3 class="text-sm fw-bold mb-3">Ryšiai su juridiniais asmenimis</h3>
      <% if (asmuo.pinreg.rysiaiSuJa.length > 0) { %>
        <div class="result-list">
          <% asmuo.pinreg.rysiaiSuJa.forEach(rysys => { %>
            <article class="result-card card-clickable">
              <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= rysys.uuid %>" class="card-overlay-link"><%= rysys.asmuo %></a>
              <div class="result-card-body">
                <dl class="result-card-meta">
                  <div><dt class="sr-only">Nuo</dt><dd>Nuo <%= rysys.rysioPradzia %></dd></div>
                  <div><dt class="sr-only">Kas</dt><dd><%= rysys.kienoRysys && rysys.kienoRysys[0].toUpperCase() + rysys.kienoRysys.slice(1).toLowerCase() %></dd></div>
                  <div><dt class="sr-only">Pateikta</dt><dd><%= new Date(rysys.pateikimoData).toLtDateTime() %></dd></div>
                </dl>
                <h3 class="result-card-title"><%= rysys.asmuo %></h3>
                <div class="result-card-footer"><span><%= rysys.rysioPobudzioPavadinimas %></span></div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-muted text-sm">Nėra duomenų</p>
      <% } %>
    </div>

    <div>
      <h3 class="text-sm fw-bold mb-3">Darbovietės</h3>
      <% if (asmuo.pinreg.darbovietes.length > 0) { %>
        <div class="result-list">
          <% asmuo.pinreg.darbovietes.forEach(darboviete => { %>
            <article class="result-card card-clickable">
              <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= darboviete.uuid %>" class="card-overlay-link"><%= darboviete.asmuo %></a>
              <div class="result-card-body">
                <dl class="result-card-meta">
                  <div><dt class="sr-only">Nuo</dt><dd>Nuo <%= darboviete.rysioPradzia %></dd></div>
                  <div><dt class="sr-only">Pateikta</dt><dd><%= new Date(darboviete.pateikimoData).toLtDateTime() %></dd></div>
                </dl>
                <h3 class="result-card-title"><%= darboviete.asmuo %></h3>
                <div class="result-card-footer"><span><%= darboviete.pareigos %></span></div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-muted text-sm">Nėra duomenų</p>
      <% } %>
    </div>

    <div>
      <h3 class="text-sm fw-bold mb-3">Sutuoktinių darbovietės</h3>
      <% if (asmuo.pinreg.sutuoktinioDarbovietes.length > 0) { %>
        <div class="result-list">
          <% asmuo.pinreg.sutuoktinioDarbovietes.forEach(darboviete => { %>
            <article class="result-card card-clickable">
              <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= darboviete.uuid %>" class="card-overlay-link"><%= darboviete.asmuo %></a>
              <div class="result-card-body">
                <dl class="result-card-meta">
                  <div><dt class="sr-only">Nuo</dt><dd>Nuo <%= darboviete.rysioPradzia %></dd></div>
                  <div><dt class="sr-only">Pateikta</dt><dd><%= new Date(darboviete.pateikimoData).toLtDateTime() %></dd></div>
                </dl>
                <h3 class="result-card-title"><%= darboviete.asmuo %> – <%= darboviete.sutuoktinis %></h3>
                <div class="result-card-footer"><span><%= darboviete.pareigos %></span></div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-muted text-sm">Nėra duomenų</p>
      <% } %>
    </div>

  </div>
</div>
