 <h2 id="pinreg"><a href="#pinreg" class="hashHref"><u>Privačių interesų deklaracijos</u></a></h2>
 <%
 // Determine if each category is truncated
 const rysiaiTruncated = asmuo.pinreg.counts.rysiaiSuJa > asmuo.pinreg.rysiaiSuJa.length;
 const darbovietesTruncated = asmuo.pinreg.counts.darbovietes > asmuo.pinreg.darbovietes.length;
 const sutuoktinioTruncated = asmuo.pinreg.counts.sutuoktiniuDarbovietes > asmuo.pinreg.sutuoktinioDarbovietes.length;

 // Show the global "limited" message only if any category is truncated
 const anyTruncated = rysiaiTruncated || darbovietesTruncated || sutuoktinioTruncated;
 %>

 <% if (anyTruncated) { %>
     <i>
         Rodomos tik po <%= asmuo.pinreg.limit %> deklaracijos.
         <a href="?pinregLimit=max#pinreg">
             Rodyti visas (<%= asmuo.pinreg.total %>)
         </a>
     </i>
     <br>
 <% } %>

 <div class="col-3 mobile-col-1">
     <section class="results" style="margin-inline: initial; margin-block: 0;">
         <h3 style="margin-bottom: 0px;">Ryšiai su juridiniais asmenimis</h3>
         <% asmuo.pinreg.rysiaiSuJa.forEach(rysys =>  { %>
             <div class="rezultatas">
                 <div class="rezultatas-top">
                     <span>Nuo <%= rysys.rysioPradzia %></span>
                     <span><%= rysys.kienoRysys && rysys.kienoRysys[0].toUpperCase() + rysys.kienoRysys.slice(1).toLowerCase(); %></span>
                     <span><%= new Date(rysys.pateikimoData).toLtDateTime() %></span>
                 </div>
                 <div class="rezultatas-title">
                     <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= rysys.uuid %>">
                         <%= rysys.asmuo %>
                     </a>
                 </div>
                 <div class="rezultatas-bottom">
                     <%= rysys.rysioPobudzioPavadinimas %>
                 </div>
             </div>
         <% }) %>
     </section>
     <section class="results" style="margin-inline: initial; margin-block: 0;">
         <h3 style="margin-bottom: 0px;">Darbovietės</h3>
         <% asmuo.pinreg.darbovietes.forEach(darboviete =>  { %>
             <div class="rezultatas">
                 <div class="rezultatas-top">
                     <span>Nuo <%= darboviete.rysioPradzia %></span>
                     <span><%= new Date(darboviete.pateikimoData).toLtDateTime() %></span>
                 </div>
                 <div class="rezultatas-title">
                     <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= darboviete.uuid %>">
                         <%=  darboviete.asmuo %>
                     </a>
                 </div>
                 <div class="rezultatas-bottom">
                     <%= darboviete.pareigos %>
                 </div>
             </div>
         <% }) %>
     </section>
     <section class="results" style="margin-inline: initial; margin-block: 0;">
         <h3 style="margin-bottom: 0px;">Sutuoktinių darbovietės</h3>
         <% asmuo.pinreg.sutuoktinioDarbovietes.forEach(darboviete =>  { %>
             <div class="rezultatas">
                 <div class="rezultatas-top">
                     <span>Nuo <%= darboviete.rysioPradzia %></span>
                     <span><%= new Date(darboviete.pateikimoData).toLtDateTime() %></span>
                 </div>
                 <div class="rezultatas-title">
                     <a href="https://pinreg.vtek.lt/app/pid-perziura/<%= darboviete.uuid %>">
                         <%=  darboviete.asmuo %> –
                         <%=  darboviete.sutuoktinis %>
                     </a>
                 </div>
                 <div class="rezultatas-bottom">
                     <% let pirmas = true; %>
                     <%= darboviete.pareigos %>
                 </div>
             </div>
         <% }) %>
     </section>
 </div>
