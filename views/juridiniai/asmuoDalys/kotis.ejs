<% if (asmuo.kotis?.count > 0) { %>
<div class="page-section" id="kotis">
  <h2><a href="#kotis" class="no-style">Valstybės pagalba (KOTIS)</a></h2>

  <% if (asmuo.kotis.count > asmuo.kotis.rows.length) { %>
    <p class="text-muted text-sm mb-4">
      Rodomi tik <%= Number(asmuo.kotis.limit).linksniuoti(["įrašas", "įrašai", "įrašų"]) %>.
      <a href="?kotisLimit=max#kotis">Rodyti visus (<%= asmuo.kotis.count %>)</a>
    </p>
  <% } %>

  <div class="result-list">
    <% asmuo.kotis.rows.forEach(item => { %>
      <article class="result-card card-clickable">
        <a href="https://kotis.kt.gov.lt/paraiskos/view_item/id.<%= item.id %>" class="card-overlay-link"><%= item.teikejas %></a>
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div>
              <dt class="sr-only">Teikėjas</dt>
              <dd><%= item.teikejas %></dd>
            </div>
            <div>
              <dt class="sr-only">Data</dt>
              <dd><%= String(item.suteikimoData).split(" ")[0] %></dd>
            </div>
          </dl>

          <h3 class="result-card-title">
            <span class="cell-mono"><%= new Intl.NumberFormat('lt-LT', { style: 'currency', currency: 'EUR' }).format(item.suma) %></span>
          </h3>

          <div class="result-card-footer">
            <span><%= item.pagalbosForma %></span>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<% } %>
