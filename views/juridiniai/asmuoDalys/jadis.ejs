<% if(asmuo.jadis) { %>
    <% let jadis = asmuo.jadis; %>
    <div id="jadis">
        <h2><a href="#jadis" class="hashHref"><u>Juridinio asmens dalyviai</u></a></h2>
        <% if(jadis.lrFiziniai && jadis.lrFiziniai > 0) { %>
            <h3>Fiziniai asmenys (Lietuva)</h3>
            <div>
                <%= Number(jadis.lrFiziniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %>
            </div>
        <% } %>

        <% if(jadis.lrJuridiniai && jadis.lrJuridiniai > 0) { %>
            <h3>Juridiniai asmenys (Lietuva)</h3>
            <div>
                <%= Number(jadis.lrJuridiniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %>
            </div>
        <% } %>

        <% if(jadis.uzsienioFiziniai && jadis.uzsienioFiziniai > 0) { %>
            <h3>Fiziniai asmenys (užsienis)</h3>
            <div>
                <%= Number(jadis.uzsienioFiziniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %>
            </div>
        <% } %>

        <% if(jadis.uzsienioJuridiniai && jadis.uzsienioJuridiniai > 0) { %>
            <h3>Juridiniai asmenys (užsienis)</h3>
            <div>
                <%= Number(jadis.uzsienioJuridiniai).linksniuoti(["asmuo", "asmenys", "asmenų"]) %>
            </div>
        <% } %>

    </div>
<% } %>
