<% if (asmuo.finansai?.ataskaitos?.length > 0) { %>
<div class="page-section" id="finansai">
  <h2><a href="#finansai" class="no-style">Finansinės ataskaitos</a></h2>

  <div class="grid-2 mb-6">

    <div>
      <h3 class="text-sm fw-bold mb-3">Pardavimo pajamos</h3>
      <% if (asmuo.finansai.lentele?.metai?.length > 0 && asmuo.finansai.lentele.duomenys["Pardavimo pajamos"]) { %>
        <div class="chart-frame">
          <div id="pardavimoPajamosChart" class="chart" style="height:300px;"></div>
        </div>
        <script defer>
          if (typeof pardavimaiKasMetusLabels === 'undefined') var pardavimaiKasMetusLabels = [];
          if (typeof pardavimaiKasMetus === 'undefined') var pardavimaiKasMetus = [];

          const pardavimoPajamosMap = {
            <% asmuo.finansai.lentele.metai.forEach((metai, i) => { %>
              '<%= metai %>': <%= asmuo.finansai.lentele.duomenys["Pardavimo pajamos"][i] ?? "null" %>,
            <% }) %>
          };
          const mergedLabels = Array.from(new Set([...Object.keys(pardavimoPajamosMap), ...pardavimaiKasMetusLabels])).map(Number).sort((a,b)=>a-b).map(String);
          displayChart({
            element: document.querySelector('#pardavimoPajamosChart'),
            labels: mergedLabels,
            series: [
              { name: "Pardavimo pajamos", data: mergedLabels.map(l => pardavimoPajamosMap[l] ?? null) },
              { name: "Viešųjų pirkimų pardavimai", data: mergedLabels.map(l => { const i = pardavimaiKasMetusLabels.indexOf(l); return i !== -1 ? pardavimaiKasMetus[i] : null; }) }
            ],
            flags: ['yEUR', 'yMin0'],
            customOptions: { colors: ['#000000', '#999999'] }
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

    <div>
      <h3 class="text-sm fw-bold mb-3">Grynasis pelnas (nuostoliai)</h3>
      <% if (asmuo.finansai.lentele?.metai?.length > 0) { %>
        <div class="chart-frame">
          <div id="grynasisPelnas" class="chart" style="height:300px;"></div>
        </div>
        <script defer>
          const grynasisPelnasLabels = [<% asmuo.finansai.lentele.metai.forEach((item, i) => { %>'<%= item %>'<%= i < asmuo.finansai.lentele.metai.length - 1 ? ',' : '' %><% }) %>];
          const pelnoDuomenys = <%- JSON.stringify(asmuo.finansai.lentele.duomenys["Grynasis pelnas (nuostoliai)"] ?? asmuo.finansai.lentele.duomenys["Ataskaitinių metų pelnas (nuostoliai)"] ?? []) %>;
          const grynasisPelnasVertes = pelnoDuomenys.map(v => v ?? null);
          const hasNegative = grynasisPelnasVertes.some(v => v !== null && v < 0);
          displayChart({
            element: document.querySelector('#grynasisPelnas'),
            labels: grynasisPelnasLabels,
            series: grynasisPelnasVertes,
            flags: ['yEUR', 'yMinAuto'],
            customOptions: { annotations: hasNegative ? { yaxis: [{ y: 0, y2: -100000000, borderColor: 'red', borderWidth: 2, label: { borderColor: 'red', style: { color: '#fff', background: 'red' }, text: 'Nuostoliai' } }] } : {} }
          });
        </script>
      <% } else { %>
        <div class="chart-empty">Nėra duomenų</div>
      <% } %>
    </div>

  </div>

  <div class="table-wrapper mb-5">
    <table class="table">
      <thead>
        <tr>
          <th>Eilutė</th>
          <% asmuo.finansai.lentele.metai.forEach(year => { %>
            <th class="cell-right"><%= year %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% for (const lineName in asmuo.finansai.lentele.duomenys) { %>
          <tr>
            <td><%= lineName %></td>
            <% asmuo.finansai.lentele.duomenys[lineName].forEach(value => { %>
              <td class="cell-mono cell-right">
                <% if (value === undefined || value === null) { %>
                  <span class="text-muted">—</span>
                <% } else if (lineName === "Pelningumas") { %>
                  <%= value.toFixed(2) %>%
                <% } else { %>
                  <%= value.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) %>
                <% } %>
              </td>
            <% }) %>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (queryParams.finansaiLimit == "max") { queryParams.finansaiLimit = 10000000; } %>
  <% const finansaiLimit = queryParams.finansaiLimit || 1; %>

  <% if (asmuo.finansai.ataskaitos.length > finansaiLimit) { %>
    <p class="text-muted text-sm mb-4">
      Rodoma tik paskutinė finansinė ataskaita.
      <a href="?finansaiLimit=max#finansai">Rodyti visas (<%= asmuo.finansai.ataskaitos.length %>)</a>
    </p>
  <% } %>

  <% let count = 0; %>
  <% asmuo.finansai.ataskaitos.forEach(laikotarpis => { %>
    <% if (count >= finansaiLimit) return; %>
    <% count++; %>

    <div class="subsection">
      <h3>
        <%= laikotarpis.templateName %>
        <span class="text-muted text-xs fw-normal">(<%= laikotarpis.templateId %>, <%= laikotarpis.duomenuData %>)</span>
      </h3>
      <p class="text-muted text-sm mb-4"><%= laikotarpis.laikotarpisNuo %> – <%= laikotarpis.laikotarpisIki %></p>

      <div class="grid-2">
        <% laikotarpis.standards.forEach(standard => { %>
          <div class="card">
            <div class="card-body">
              <div class="section-title mb-3"><%= standard.standardName %> <span class="text-muted fw-normal">(<%= standard.standardId %>)</span></div>
              <dl class="kv-list">
                <% standard.lines.forEach(line => { %>
                  <dt><%= line.lineName %> <span class="text-muted text-xs">(<%= line.lineTypeId %>)</span></dt>
                  <dd><span class="cell-mono"><%= new Intl.NumberFormat('lt-LT', { style: 'currency', currency: 'EUR' }).format(line.reiksme) %></span></dd>
                <% }) %>
              </dl>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

  <% }) %>

</div>
<% } %>
