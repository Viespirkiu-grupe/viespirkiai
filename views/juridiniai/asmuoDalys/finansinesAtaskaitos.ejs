 <% if(asmuo.finansai && asmuo.finansai.ataskaitos && asmuo.finansai.ataskaitos.length > 0){ %>
     <div id="finansai">
         <h2><a href="#finansai" class="hashHref"><u>Finansinės ataskaitos</u></a></h2>

         <div class="col-2 mobile-col-1" id="sutartys">
             <section style="width: 100%;">
                 <h3><a href="#pardavimoPajamos" id="pardavimoPajamos" class="hashHref">Pardavimo pajamos</a></h3>
                 <% if(asmuo.finansai.lentele && asmuo.finansai.lentele.metai.length > 0 && asmuo.finansai.lentele.duomenys["Pardavimo pajamos"]) { %>
                     <div id="pardavimoPajamos" class="chart" style="width: 100%; height: 400px;"></div>

                     <script defer>
                     // Create a map directly from EJS
                     const pardavimoPajamosMap = {
                       <% asmuo.finansai.lentele.metai.forEach((metai, i) => { %>
                         '<%= metai %>': <%= asmuo.finansai.lentele.duomenys["Pardavimo pajamos"][i] ?? "null" %>,
                       <% }) %>
                     };

                     // Then align with merged labels
                     const mergedLabels = Array.from(new Set([...Object.keys(pardavimoPajamosMap), ...pardavimaiKasMetusLabels]))
                                               .map(Number)
                                               .sort((a,b)=>a-b)
                                               .map(String);

                     const finalPardavimoPajamosVertes = mergedLabels.map(label => pardavimoPajamosMap[label] ?? null);
                     const finalViesujuPirkimuPardavimaiKasMetus = mergedLabels.map(label => {
                       const index = pardavimaiKasMetusLabels.indexOf(label);
                       return index !== -1 ? pardavimaiKasMetus[index] : null;
                     });


                     displayChart({
                       element: document.querySelector('#pardavimoPajamos'),
                       labels: mergedLabels,
                       series: [
                          {name: "Pardavimo pajamos", data: finalPardavimoPajamosVertes},
                          {name: "Viešjų pirkimų pardavimai", data: finalViesujuPirkimuPardavimaiKasMetus}
                       ],
                       flags: ['yEUR', 'yMin0'],
                       customOptions: {
                         colors: ['#000000', '#999999']
                       }
                     })
                     </script>
                 <% } else { %>
                     <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                 <% } %>
             </section>
                 <section style="width: 100%;">
                     <h3><a href="#pelnas" id="pelnas" class="hashHref">Grynasis pelnas (nuostoliai)</a></h3>
                     <% if(asmuo.finansai.lentele && asmuo.finansai.lentele.metai.length > 0) { %>
                         <div id="grynasisPelnas" class="chart" style="width: 100%; height: 400px;"></div>

                         <script defer>
                           const grynasisPelnasLabels = [
                             <% asmuo.finansai.lentele.metai.forEach((item) => { %>
                               '<%= item %>',
                             <% }) %>
                           ];

                           const grynasisPelnasVertes = [
                             <%
                               const pelnoDuomenys = asmuo.finansai.lentele.duomenys["Grynasis pelnas (nuostoliai)"]
                                                     ?? asmuo.finansai.lentele.duomenys["Ataskaitinių metų pelnas (nuostoliai)"]
                                                     ?? [];
                               pelnoDuomenys.forEach((item, idx) => {
                             %>
                               <%= item != null ? item : "null" %><%= idx < pelnoDuomenys.length - 1 ? ',' : '' %>
                             <% }) %>
                           ];

                           let finansinesAtaskaitosHasValuesUnderZero = false;
                            for(let i = 0; i < grynasisPelnasVertes.length; i++){
                              if(grynasisPelnasVertes[i] !== null && grynasisPelnasVertes[i] < 0){
                                finansinesAtaskaitosHasValuesUnderZero = true;
                                break;
                              }
                            }

                            let finansinesAtaskaitosAnnotations = {};
                            if(finansinesAtaskaitosHasValuesUnderZero){
                              finansinesAtaskaitosAnnotations = {
                                yaxis: [
                                    {
                                      y: 0,
                                      y2: -100000000,
                                      borderColor: 'red',
                                      borderWidth: 2,
                                      label: {
                                        borderColor: 'red',
                                        style: {
                                          color: '#fff',
                                          background: 'red',
                                        },
                                        text: 'Nuostoliai'
                                    }
                                  }
                                ]
                              }
                            }
                            displayChart({
                              element: document.querySelector('#grynasisPelnas'),
                              labels: grynasisPelnasLabels,
                              series: grynasisPelnasVertes,
                              flags: ['yEUR', 'yMinAuto'],
                              customOptions: { annotations: finansinesAtaskaitosAnnotations }
                            })
                         </script>
                     <% } else { %>
                         <i class="diagrama-nera-duomenu">Nėra duomenų</i>
                     <% } %>
                 </section>
         </div>

         <table style="width: auto;">
             <thead>
                 <tr>
                     <th>Eilutė</th>
                     <% asmuo.finansai.lentele.metai.forEach(function(year) { %>
                         <th><%= year %></th>
                     <% }); %>
                 </tr>
             </thead>
             <tbody>
                 <% for (let lineName in asmuo.finansai.lentele.duomenys) { %>
                     <tr>
                         <td><%= lineName %></td>
                         <% asmuo.finansai.lentele.duomenys[lineName].forEach(function(value) { %>
                            <% if(lineName == "Pelningumas"){ %>
                                 <td class="center"><span style="display: inline-block; padding: 4px;"><%= (value !== undefined && value !== null) ? (value).toFixed(2) + '%' : '–' %></span></td>
                            <% } else { %>
                                <td class="center"><span style="display: inline-block; padding: 4px;"><%= (value !== undefined && value !== null) ? value.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) : '–' %></span></td>
                            <% } %>
                         <% }); %>
                     </tr>
                 <% } %>
             </tbody>
         </table>

         <% if(queryParams.finansaiLimit == "max") {queryParams.finansaiLimit = 10000000} %>
         <% let finansaiLimit = queryParams.finansaiLimit || 1; %>
         <% if(asmuo.finansai.ataskaitos.length > finansaiLimit) { %>
             <i>
                 Rodoma tik paskutinė finansinė ataskaita.
                 <a href="?finansaiLimit=max#finansai">
                     Rodyti visas (<%= asmuo.finansai.ataskaitos.length %>)
                 </a>
             </i>
             <br>
         <% } %>

         <section>
             <% let count = 0; %>

             <% asmuo.finansai.ataskaitos.forEach(laikotarpis => { %>
                 <% if(count >= finansaiLimit) return; %>
                 <% count++; %>

                 <h3><%= laikotarpis.templateName %> <sup>(<%= laikotarpis.templateId %>, <%= laikotarpis.duomenuData %>)</sup></h3>
                 <i><%= laikotarpis.laikotarpisNuo %> – <%= laikotarpis.laikotarpisIki %> </i>
                 <section class="col-2 mobile-col-1">
                     <% laikotarpis.standards.forEach(standard => { %>
                         <section>
                             <h4><%= standard.standardName %> <sup>(<%= standard.standardId %>)</sup></h4>
                             <% standard.lines.forEach(line => { %>
                                 <div>
                                 <h5><%= line.lineName %> <sup>(<%= line.lineTypeId %>)</sup></h5>
                                 <%= new Intl.NumberFormat('lt-LT', { style: 'currency', currency: 'EUR' }).format(line.reiksme) %>
                                 </div>
                             <% }); %>
                         </section>
                     <% }); %>
                 </section>
                 <br>
             <% }) %>
         </section>
     </div>
 <% } %>
