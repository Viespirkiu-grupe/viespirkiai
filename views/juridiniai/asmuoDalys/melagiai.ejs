<% if (asmuo.melagingi?.length > 0) { %>
<div class="page-section mb-6" id="melagiai">
  <h2><a href="#melagiai" class="no-style">Melagingą informaciją pateikusių tiekėjų sąrašas</a></h2>

  <div class="result-list">
    <% asmuo.melagingi.forEach(melagis => { %>
      <article class="result-card">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div>
              <dt class="sr-only">Įvesta</dt>
              <dd>Įvesta <%= melagis.duomenuIvedimoData %></dd>
            </div>
            <div>
              <dt class="sr-only">Galioja</dt>
              <dd><%= melagis.dataNuoKuriosSkaiciuojamasTerminas || "nežinoma" %> – <%= melagis.itrauktasIki || "nežinoma" %></dd>
            </div>
            <div>
              <dt class="sr-only">Paskutinį kartą matyta</dt>
              <dd>Matyta <%= melagis.paskutiniKartaMatytaSarase %></dd>
            </div>
          </dl>

          <h3 class="result-card-title">
            <% if (melagis.pagrindimas?.irasymoPagrindas) { %>
              <%= melagis.pagrindimas.irasymoPagrindas %>
            <% } else { %>
              <em class="text-muted">Įtraukimo pagrindas nenurodytas</em>
            <% } %>
          </h3>

          <div class="result-card-footer">
            <span><strong>Pirkėjas:</strong> <%= melagis.pirkimoVykdytojoPavadinimas || "nenurodytas" %></span>
            <span><strong>Pirkimo nr.:</strong> <%= melagis.pirkimoNumeris || "nenurodytas" %></span>
            <% if (melagis.pagrindimas?.tiekejoPaaiskinimoDokumentoNuoroda?.length > 3) { %>
              <span><a href="<%= melagis.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda %>" target="_blank" rel="noopener noreferrer">↗ Tiekėjo paaiškinimo dokumentas (<%= melagis.pagrindimas.paaiskinimoPateikimoData || "data nenurodyta" %>)</a></span>
            <% } %>
          </div>

          <% if (melagis.pagrindimas?.tiekejoPaaiskinimas?.length > 3) { %>
            <blockquote class="mt-3">
              <%= melagis.pagrindimas.tiekejoPaaiskinimas %>
            </blockquote>
            <% if (melagis.pagrindimas.paaiskinimoPateikimoData) { %>
              <p class="text-muted text-xs mt-1" style="text-align:right;">Pateiktas: <%= melagis.pagrindimas.paaiskinimoPateikimoData %></p>
            <% } %>
          <% } %>

        </div>
      </article>
    <% }) %>
  </div>
</div>
<% } %>
