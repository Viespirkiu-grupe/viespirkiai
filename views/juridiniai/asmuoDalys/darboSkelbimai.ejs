<% if (asmuo.darboSkelbimai?.rows > 0) { %>
<div class="page-section mb-10" id="darboSkelbimai">
  <h2><a href="#darboSkelbimai" class="no-style">Darbo skelbimai</a></h2>

  <% if (asmuo.darboSkelbimai.rows > asmuo.darboSkelbimai.limit) { %>
    <p class="text-muted text-sm mb-4">
      Rodomi tik <%= Number(asmuo.darboSkelbimai.limit).linksniuoti(["naujausias skelbimas", "naujausi skelbimai", "naujausių skelbimų"]) %>.
      <a href="?darboSkelbimaiLimit=max#darboSkelbimai">Rodyti visus (<%= asmuo.darboSkelbimai.rows %>)</a>
    </p>
  <% } %>

  <div class="result-list">
    <% asmuo.darboSkelbimai.skelbimai.forEach(skelbimas => { %>
      <article class="result-card">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div>
              <dt class="sr-only">Paskelbta</dt>
              <dd>Paskelbta <%= skelbimas.ikelimo_data %></dd>
            </div>
            <div>
              <dt class="sr-only">Galioja</dt>
              <dd><%= skelbimas.galioja_nuo || "nežinoma" %> – <%= skelbimas.galioja_iki || "nežinoma" %></dd>
            </div>
          </dl>

          <h3 class="result-card-title">
            <%= skelbimas.profesijos_pareigybes_pav || "Profesijos pareigybės pavadinimas nenurodytas" %>
          </h3>

          <% const aprasymas = skelbimas.darbo_aprasymas_lt || "Darbo aprašymas nenurodytas"; %>
          <p class="text-sm text-muted mt-2 line-clamp-4">
            <%= aprasymas %>
          </p>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<% } %>
