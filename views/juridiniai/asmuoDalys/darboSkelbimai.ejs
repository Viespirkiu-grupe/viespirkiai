<% if(asmuo.darboSkelbimai && asmuo.darboSkelbimai.rows > 0){ %>
    <div id="darboSkelbimai">
        <h2><a href="#darboSkelbimai" class="hashHref"><u>Darbo skelbimai</u></a></h2>
        <% if(asmuo.darboSkelbimai.rows > asmuo.darboSkelbimai.limit) { %>
            <i>
                Rodomi tik <%= Number(asmuo.darboSkelbimai.limit).linksniuoti(["naujausias skelbimas", "naujausi skelbimai", "naujausių skelbimų"]) %>.
                <a href="?darboSkelbimaiLimit=max#darboSkelbimai">
                    Rodyti visus (<%= asmuo.darboSkelbimai.rows %>)
                </a>
            </i>
        <% } %>

        <div class="results" style="margin-inline: 0px;">
            <% let count = 0; %>
            <% asmuo.darboSkelbimai.skelbimai.forEach(function(skelbimas){ %>
                <div class="rezultatas">
                    <div class="rezultatas-top">
                        <span>
                            Paskelbta:
                            <%= skelbimas.ikelimo_data %>
                        </span>
                        <span>
                            Galioja:
                            <%= skelbimas.galioja_nuo || "nežinoma" %> –
                            <%= skelbimas.galioja_iki || "nežinoma" %>
                        </span>
                    </div>
                    <div class="rezultatas-title">
                        <%= skelbimas.profesijos_pareigybes_pav || "Profesijos pareigybės pavadinimas nenurodytas" %>
                    </div>
                    <div class="rezultatas-bottom" style="text-align: justify;">
                        <%= skelbimas.darbo_aprasymas_lt	|| "Darbo aprašymas nenurodytas" %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
<% } %>
