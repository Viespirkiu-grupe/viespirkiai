<div class="mt-6 max-w-lg center mx-auto">
  <div class="d-flex justify-between align-center mb-4">
    <span class="text-muted text-sm"><em class="numberOfResults"><%- numberOfResults %></em></span>
  </div>

  <% if (data.length === 0) { %>
    <div class="empty-state">
      <p class="text-muted">Rezultatų nerasta.</p>
    </div>
  <% } else { %>

    <div class="result-list">
      <% data.forEach(item => { %>
        <% const href = item.failoId ? `/failas/${item.failoId}` : `https://eviesiejipirkimai.lt/${item.link}`; %>
        <article class="result-card card-clickable" aria-label="<%= item.jarPavadinimas %>">
          <a href="<%= href %>" class="card-overlay-link"><%= item.aprasymas %></a>

          <div class="result-card-body">
            <dl class="result-card-meta">
              <div>
                <dt class="visually-hidden">Data</dt>
                <dd>
                  <% if (item.data) { %>
                    <time datetime="<%= item.data %>"><%= item.data %></time>
                  <% } else { %>—<% } %>
                </dd>
              </div>
              <div>
                <dt class="visually-hidden">Išvada</dt>
                <dd><%= item.isvada || '—' %></dd>
              </div>
            </dl>

            <h3 class="result-card-title">
              <% if (item.aprasymas && item.aprasymas.length > 0) { %>
                <%= item.aprasymas %>
              <% } else { %>
                <em>Nenurodyta</em>
              <% } %>
            </h3>

            <div class="result-card-footer">
              <span><strong>Perkančioji organizacija:</strong>
                <% if (item.jarKodas && item.jarPavadinimas) { %>
                  <a href="/asmuo/<%= item.jarKodas %>" style="position:relative;z-index:1;"><%= item.jarPavadinimas %></a>
                <% } else { %>
                  <em>Nenurodyta</em>
                <% } %>
              </span>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

    <%- include('../pagination.ejs', { currentPage, pageCount, queryParams }) %>

  <% } %>
</div>
