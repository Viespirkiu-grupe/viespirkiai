<%
function f(id)    { return (group.fields.find(x => x.fieldId === id)?.values || []).join(', ') }
function fArr(id) { return group.fields.find(x => x.fieldId === id)?.values || [] }
function fType(t) { return group.fields.find(x => x.type === t) }
function fUrl(id) { return group.fields.find(x => x.fieldId === id) }
function isNull(v) {
  if (!v) return true
  const l = v.toLowerCase()
  return l === 'ne' || l.includes('nėra') || l.includes('nerezervuotas')
}

const title       = group.label || f('BT-21-Lot')
const internalId  = f('BT-22-Lot')
const contractType= f('BT-23-Lot')
const description = f('BT-24-Lot')
const quantity    = f('BT-25-Lot')
const cpv         = f('BT-262-Lot')
const otherObjects= f('BT-531-Lot')
const value       = fType('amount')
const durationStart = f('BT-536-Lot')
const durationEnd   = f('BT-537-Lot')
const infoDeadlineD = f('BT-13(d)-Lot')
const infoDeadlineT = f('BT-13(t)-Lot')
const subDeadlineD  = f('BT-1311(d)-Lot')
const subDeadlineT  = f('BT-1311(t)-Lot')
const submissionType= f('BT-17-Lot')
const submitUrl     = fUrl('BT-18-Lot')
const langs         = fArr('BT-97-Lot')
const gpa           = f('BT-115-Lot')
const sme           = f('BT-726-Lot')
const framework     = f('BT-765-Lot')
const dps           = f('BT-766-Lot')
const eAuction      = f('BT-767-Lot')
const eCatalog      = f('BT-764-Lot')
const reservedPartic= f('BT-71-Lot')
const reservedExec  = f('BT-736-Lot')
const legalForm     = f('BT-76-Lot')
const guaranteeReq  = f('BT-751-Lot')
const guaranteeDesc = f('BT-75-Lot')
const nda           = f('BT-801-Lot')

const cpvDash  = cpv ? cpv.indexOf(' \u2013 ') : -1
const cpvCode  = cpv ? (cpvDash >= 0 ? cpv.slice(0, cpvDash) : cpv) : null
const cpvLabel = cpv ? (cpvDash >= 0 ? cpv.slice(cpvDash + 3) : null) : null

const procedureFields = [
  framework && !isNull(framework) && ['Preliminarioji sutartis', framework],
  dps       && !isNull(dps)       && ['Dinaminė pirkimo sistema', dps],
  eAuction  && !isNull(eAuction)  && ['El. aukcionas', eAuction],
  eCatalog  && !isNull(eCatalog)  && ['El. katalogas', eCatalog],
].filter(Boolean)
const participationFields = [
  reservedPartic && !isNull(reservedPartic) && ['Rezervuotas dalyvavimas', reservedPartic],
  reservedExec   && !isNull(reservedExec)   && ['Rezervuotas vykdymas', reservedExec],
  legalForm      && !isNull(legalForm)      && ['Teisinė forma', legalForm],
  guaranteeReq   && !isNull(guaranteeReq)   && ['Garantija', guaranteeDesc || guaranteeReq],
  nda            && !isNull(nda)            && ['Konfidencialumas', f('BT-802-Lot') || 'Taip'],
].filter(Boolean)

// Separate subgroups by semantic role
const allSubs = group.subGroups || []
const placePerf = allSubs.filter(sg => sg.nodeId === 'ND-LotPlacePerformance' || sg.nodeId === 'ND-PartPlacePerformance')
const docSgs    = allSubs.filter(sg => sg.nodeId === 'ND-LotProcurementDocument' || sg.nodeId === 'ND-PartProcurementDocument')
const restList  = allSubs.filter(sg =>
  sg.nodeId !== 'ND-LotPlacePerformance' && sg.nodeId !== 'ND-PartPlacePerformance' &&
  sg.nodeId !== 'ND-LotProcurementDocument' && sg.nodeId !== 'ND-PartProcurementDocument'
)

// Group rest by nodeId with preferred sort order
const SG_ORDER = [
  'ND-LotAwardCriterion', 'ND-LotsGroupAwardCriterion',
  'ND-SelectionCriteria',
  'ND-SubcontractingObligation',
  'ND-StrategicProcurementType', 'ND-StrategicProcurementInformationLotResult',
  'ND-Funding', 'ND-ContractEUFunds',
  'ND-LotPreviousPlanning', 'ND-PartPreviousPlanning',
  'ND-QualityTarget', 'ND-Prize', 'ND-Asset',
  'ND-OtherContractExecutionConditions', 'ND-IPIAppliedMeasure',
  'ND-ReceivedSubmissions', 'ND-ReviewRequestsStatistics',
  'ND-EEDProcurementDetailsLot', 'ND-EEDProcurementDetailsLotResult',
]
const cellMerge = [
  ['ND-StrategicProcurementType', 'ND-StrategicProcurementInformationLotResult', 'ND-LotPreviousPlanning', 'ND-PartPreviousPlanning'],
]
const nodeToCell = new Map()
cellMerge.forEach(g => g.forEach(id => nodeToCell.set(id, g[0])))

const restByTypeMap = new Map()
const restByType = []
for (const sg of restList) {
  if (!restByTypeMap.has(sg.nodeId)) {
    const g = { nodeId: sg.nodeId, instances: [] }
    restByTypeMap.set(sg.nodeId, g); restByType.push(g)
  }
  restByTypeMap.get(sg.nodeId).instances.push(sg)
}
const cellMap = new Map()
const cellOrder = []
restByType.forEach(sgType => {
  const key = nodeToCell.get(sgType.nodeId) || sgType.nodeId
  if (!cellMap.has(key)) { cellMap.set(key, []); cellOrder.push(key) }
  cellMap.get(key).push(sgType)
})
cellOrder.sort((a, b) => {
  const ai = SG_ORDER.indexOf(a), bi = SG_ORDER.indexOf(b)
  return (ai < 0 ? 99 : ai) - (bi < 0 ? 99 : bi)
})

const hasTimeline   = !!(subDeadlineD || infoDeadlineD || durationStart || durationEnd)
const hasPlacePerf  = placePerf.length > 0
const hasSubmission = !!(submissionType || submitUrl || langs.length || (gpa && !isNull(gpa)) || (sme && !isNull(sme)))
const hasRightCol   = hasPlacePerf || hasTimeline

const noGrid = new Set([
  'ND-LotAwardCriterion', 'ND-LotsGroupAwardCriterion',
  'ND-SelectionCriteria',
  'ND-EEDProcurementDetailsLot', 'ND-EEDProcurementDetailsLotResult',
])
const sep = 'margin-top:var(--space-4);padding-top:var(--space-4);border-top:var(--border)'
%>
<div class="card">
  <div class="card-header">
    <h3><%= title %><% if (internalId && totalGroups > 1) { %> <span class="text-muted text-sm">(<%= internalId %>)</span><% } %></h3>
    <% if (value) { %><span class="amount"><%= value.values[0] %></span><% } %>
  </div>
  <div class="card-body">

    <%# Zone 1 – What (left) + Where/When (right) %>
    <% if (hasRightCol) { %><div class="grid-2"><% } %>
      <div>
        <% if (contractType || otherObjects) { %><p class="text-xs text-muted" style="margin-bottom:var(--space-2)"><%= [contractType, otherObjects].filter(Boolean).join(' · ') %></p><% } %>
        <% if (description) { %><p class="text-sm" style="margin-bottom:var(--space-3)"><%= description %></p><% } %>
        <% if (cpv || quantity) { %><dl class="kv-list" style="margin-bottom:0"><% if (quantity) { %><dt>Kiekis</dt><dd><%= quantity %></dd><% } %><% if (cpv) { %><dt>BVPŽ</dt><dd class="fw-medium"><%= cpvLabel || cpvCode %><% if (cpvLabel) { %> <span class="text-muted fw-normal text-xs"><%= cpvCode %></span><% } %></dd><% } %></dl><% } %>
      </div>
      <% if (hasRightCol) { %>
      <div style="display:flex;flex-direction:column;gap:var(--space-3)">
        <% if (hasPlacePerf) { %>
        <div>
          <p class="section-title">Vykdymo vieta</p>
          <% placePerf.forEach((sg, i) => { %>
            <% if (i > 0) { %><hr style="border:none;border-top:1px solid var(--light-gray);margin:var(--space-2) 0"><% } %>
            <%- include('subgroup', { sg }) %>
          <% }) %>
        </div>
        <% } %>
        <% if (hasTimeline) { %>
        <div>
          <p class="section-title">Terminai ir trukmė</p>
          <%
          const tlNow2 = Date.now()
          function isPast(d) { return d && new Date(d + 'T00:00:00') < tlNow2 }
          const lotTlItems = [
            infoDeadlineD && { label: 'Informacijos pateikimo terminas', date: infoDeadlineD, time: infoDeadlineT },
            subDeadlineD  && { label: 'Pasiūlymų terminas',              date: subDeadlineD,  time: subDeadlineT },
            (durationStart || durationEnd) && { label: 'Trukmė', date: durationEnd || durationStart, text: [formatDate(durationStart), formatDate(durationEnd)].filter(Boolean).join(' \u2013 ') },
          ].filter(Boolean)
          %>
          <ul class="timeline">
            <% lotTlItems.forEach((item, i) => { const past = isPast(item.date); const nextPast = lotTlItems[i+1] && isPast(lotTlItems[i+1].date) %>
            <li class="timeline-item<%= nextPast ? ' line-active' : '' %>">
              <span class="timeline-dot<%= past ? ' active' : '' %>"></span>
              <div class="timeline-body">
                <div class="timeline-date"><%= item.text || formatDate(item.date) %><% if (item.time) { %> <span class="fw-normal text-xs text-muted"><%= item.time.replace(/\+.*$/,'') %></span><% } %></div>
                <span><%= item.label %></span>
              </div>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
      </div>
      <% } %>
    <% if (hasRightCol) { %></div><% } %>

    <%# Zone 2 – Procedure + Participation conditions %>
    <% if (procedureFields.length || participationFields.length) { %>
    <div style="<%= sep %>">
      <div class="<%= (procedureFields.length && participationFields.length) ? 'grid-2' : '' %>">
        <% if (procedureFields.length) { %>
        <div>
          <p class="section-title">Procedūra</p>
          <dl class="kv-list">
            <% procedureFields.forEach(([label, val]) => { %><dt><%= label %></dt><dd><%= val %></dd><% }) %>
          </dl>
        </div>
        <% } %>
        <% if (participationFields.length) { %>
        <div>
          <p class="section-title">Dalyvavimo sąlygos</p>
          <dl class="kv-list">
            <% participationFields.forEach(([label, val]) => { %><dt><%= label %></dt><dd><%= val %></dd><% }) %>
          </dl>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <%# Zone 3 – Award criteria, selection criteria, and other conditions %>
    <% if (cellOrder.length) { %>
    <div style="<%= sep %>">
      <div class="<%= cellOrder.length > 1 ? 'grid-' + Math.min(cellOrder.length, 3) : '' %>">
      <% cellOrder.forEach(cellKey => { %>
        <div>
        <% cellMap.get(cellKey).forEach(sgType => { %>
          <p class="section-title"><%= SUBGROUP_TITLES[sgType.nodeId] || sgType.nodeId %></p>
          <% const useGrid = !noGrid.has(sgType.nodeId) && sgType.instances.length > 1 %>
          <% const useDivider = ['ND-SelectionCriteria','ND-LotAwardCriterion','ND-LotsGroupAwardCriterion'].includes(sgType.nodeId) %>
          <% if (useGrid) { %><div class="grid-<%= Math.min(sgType.instances.length, 3) %>"><% } %>
          <% sgType.instances.forEach((sg, i) => { %>
            <% if (useDivider && i > 0) { %><hr style="border:none;border-top:1px solid var(--light-gray);margin:var(--space-2) 0"><% } %>
            <%- include('subgroup', { sg }) %>
          <% }) %>
          <% if (useGrid) { %></div><% } %>
        <% }) %>
        </div>
      <% }) %>
      </div>
    </div>
    <% } %>

    <%# Zone 4 – How to submit + Reference documents %>
    <% if (hasSubmission || docSgs.length) { %>
    <div style="<%= sep %>">
      <div class="<%= (hasSubmission && docSgs.length) ? 'grid-2' : '' %>">
        <% if (hasSubmission) { %>
        <div>
          <p class="section-title">Pateikimas</p>
          <dl class="kv-list">
            <% if (submissionType) { %><dt>El. pateikimas</dt><dd><strong><%= submissionType %></strong></dd><% } %>
            <% if (submitUrl) { submitUrl.values.forEach(v => { %><dt>Adresas</dt><dd><a href="<%- v %>" target="_blank" rel="noopener"><%= shortUrl(v) %></a></dd><% }) } %>
            <% if (langs.length) { %><dt>Kalbos</dt><dd><%= langs.join(', ') %></dd><% } %>
            <% if (gpa && !isNull(gpa)) { %><dt>GPA</dt><dd>Taip</dd><% } %>
            <% if (sme && !isNull(sme)) { %><dt>MVĮ</dt><dd><%= sme %></dd><% } %>
          </dl>
        </div>
        <% } %>
        <% if (docSgs.length) { %>
        <div>
          <p class="section-title">Pirkimo dokumentas</p>
          <% docSgs.forEach((sg, i) => { %>
            <% if (i > 0) { %><hr style="border:none;border-top:1px solid var(--light-gray);margin:var(--space-2) 0"><% } %>
            <%- include('subgroup', { sg }) %>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

  </div>
</div>
