<% if (section.nodeId === 'ND-ProcedureProcurementScope' || section.nodeId === 'ND-ProcurementProject') { %>
  <%- include('section-scope', { section }) %>
<% } else if (section.nodeId === 'ND-ProcedureTenderingProcess' || section.nodeId === 'ND-TenderingProcess') { %>
  <%- include('section-procedure', { section }) %>
<% } else if (section.nodeId === 'ND-ProcedureTerms' || section.nodeId === 'ND-TenderingTerms') { %>
  <%- include('section-terms', { section }) %>
<% } else if (section.nodeId === 'ND-RootExtension' || section.nodeId === 'ND-ContractingParty' || section.nodeId === 'ND-Organization' || section.nodeId === 'ND-ReviewBody' || section.nodeId === 'ND-MediationBody' || section.nodeId === 'ND-ReviewOrganization') { %>
  <%- include('section-orgs', { section }) %>
<% } else if (section.nodeId === 'ND-Root' || section.nodeId === 'ND-GazetteReference') { %>
  <%- include('section-meta', { section }) %>
<% } else { %>
  <%
  const sectionId = section.nodeId.replace(/[^a-zA-Z0-9-]/g, '-').toLowerCase()
  function byParent(fields) {
    const result = [], seen = new Map()
    for (const f of fields) {
      const canonical = PARENT_NODE_ALIASES[f.parentNodeId] || f.parentNodeId || '__root__'
      if (!seen.has(canonical)) { const g = { label: PARENT_NODE_TITLES[canonical] || null, pid: canonical, fields: [] }; seen.set(canonical, g); result.push(g) }
      seen.get(canonical).fields.push(f)
    }
    return result
  }
  function splitMax5(groups) {
    const out = []
    for (const fg of groups) {
      if (fg.fields.length <= 5) { out.push(fg); continue }
      for (let i = 0; i < fg.fields.length; i += 5)
        out.push({ label: i === 0 ? fg.label : null, pid: fg.pid, fields: fg.fields.slice(i, i + 5) })
    }
    return out
  }
  const fieldCols = splitMax5(byParent(section.fields))
  %>
  <section id="<%= sectionId %>">
    <h2><%= section.title %></h2>
    <% if (section.fields.length > 0) { %>
      <div class="grid-auto">
        <% fieldCols.forEach(fg => { %>
          <div>
            <% if (fg.label) { %><h3><%= fg.label %></h3><% } %>
            <% if (fg.pid === 'ND-ProcedurePlacePerformance' || fg.pid === 'ND-LotPlacePerformance' || fg.pid === 'ND-PartPlacePerformance') { %>
              <%- include('address-fields', { addrFields: fg.fields }) %>
            <% } else { %>
              <%- include('kv-list', { fields: fg.fields }) %>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
    <% const isLotSection = section.nodeId === 'ND-Lot' || section.nodeId === 'ND-Part' %>
    <% const isLotsGroupSection = section.nodeId === 'ND-LotsGroup' %>
    <div class="flex flex-col gap-4">
      <% section.groups.forEach((group, idx) => { %>
        <% if (isLotSection) { %>
          <%- include('lot-group', { group, idx, totalGroups: section.groups.length }) %>
        <% } else if (isLotsGroupSection) { %>
          <%- include('lotsgroup-group', { group, idx, totalGroups: section.groups.length }) %>
        <% } else { %>
          <%- include('group', { group, idx }) %>
        <% } %>
      <% }) %>
    </div>
  </section>
<% } %>
