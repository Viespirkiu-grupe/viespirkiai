<%
function f(id) { return (group.fields.find(x => x.fieldId === id)?.values || []).join(', ') }
function fUrl(id) { return group.fields.find(x => x.fieldId === id) }
const name        = group.label || f('BT-500-Organization-Company')
const regNum      = f('BT-501-Organization-Company')
const street1     = f('BT-510(a)-Organization-Company')
const street2     = f('BT-510(b)-Organization-Company')
const zip         = f('BT-512-Organization-Company')
const city        = f('BT-513-Organization-Company')
const country     = f('BT-514-Organization-Company')
const nuts        = f('BT-507-Organization-Company')
const email       = fUrl('BT-506-Organization-Company')
const phone       = f('BT-503-Organization-Company')
const website     = fUrl('BT-505-Organization-Company')
const profile     = fUrl('BT-508-Procedure-Buyer')
const contactName = f('BT-502-Organization-TouchPoint') || f('BT-500-Organization-TouchPoint')
const contactEmail= fUrl('BT-506-Organization-TouchPoint')
const contactPhone= f('BT-503-Organization-TouchPoint')
const buyerActivity  = f('BT-10-Procedure-Buyer')
const buyerLegalType = f('BT-11-Procedure-Buyer')
const utilityActivity= f('BT-610-Procedure-Buyer')
const hasKv = buyerLegalType || buyerActivity || utilityActivity
const hasContact = phone || email || street1 || zip || city || contactName || contactEmail
%>
<div class="card" style="height:100%;display:flex;flex-direction:column">
  <% if (name || roleLabel) { %>
  <div class="card-header">
    <% if (name) { %><h3><% if (regNum) { %><a href="/asmuo/<%= regNum %>" class="no-style"><%= name %></a><% } else { %><%= name %><% } %></h3><% } %>
    <% if (roleLabel) { %><span class="badge badge-default"><%= roleLabel %></span><% } %>
  </div>
  <% } %>
  <div class="card-body" style="flex:1;display:flex;flex-direction:column;gap:var(--space-2);padding-top:var(--space-5)">

    <div class="d-flex flex-col gap-1">
      <% if (regNum) { %><p class="text-sm text-muted" style="margin:0"><%= regNum %></p><% } %>

      <% if (hasKv) { %>
      <dl class="kv-list" style="margin:0">
        <% if (buyerLegalType) { %><dt>Teisinė forma</dt><dd><%= buyerLegalType %></dd><% } %>
        <% if (buyerActivity) { %><dt>Veiklos sritis</dt><dd><%= buyerActivity %></dd><% } %>
        <% if (utilityActivity) { %><dt>Sektoriaus veikla</dt><dd><%= utilityActivity %></dd><% } %>
      </dl>
      <% } %>
    </div>

    <% if (hasContact) { %>
    <div class="d-flex flex-col gap-1">
      <% if (contactName) { %><p class="text-sm fw-medium" style="margin:0"><%= contactName %></p><% } %>
      <% if (phone) { %><p class="text-sm" style="margin:0"><a href="tel:<%= phone %>"><%= phone %></a></p><% } %>
      <% if (contactPhone && contactPhone !== phone) { %><p class="text-sm" style="margin:0"><a href="tel:<%= contactPhone %>"><%= contactPhone %></a></p><% } %>
      <% if (email) { email.values.forEach(v => { %><p class="text-sm" style="margin:0"><a href="mailto:<%= v %>"><%= v %></a></p><% }) } %>
      <% if (contactEmail) { contactEmail.values.forEach(v => { %><p class="text-sm" style="margin:0"><a href="mailto:<%= v %>"><%= v %></a></p><% }) } %>
      <% if (street1 || street2) { %><p class="text-sm text-muted" style="margin:0"><%= [street1, street2].filter(Boolean).join(', ') %></p><% } %>
      <% if (zip || city || country) { %><p class="text-sm text-muted" style="margin:0"><%= [[zip, city].filter(Boolean).join(' '), country].filter(Boolean).join(' · ') %></p><% } %>
      <% if (nuts) { %><p class="text-xs text-muted" style="margin:0">NUTS: <%= nuts %></p><% } %>
      <% if (website) { website.values.forEach(v => { %><p class="text-sm" style="margin:0"><a href="<%- v %>" target="_blank" rel="noopener"><%= v %></a></p><% }) } %>
    </div>
    <% } %>

  </div>
  <% if (profile) { %>
  <div class="card-footer">
    <% profile.values.forEach(v => { %><a href="<%- v %>" class="text-sm" target="_blank" rel="noopener">Pirkėjo profilis →</a><% }) %>
  </div>
  <% } %>
</div>
