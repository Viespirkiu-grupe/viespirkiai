<%
const groupLabel = group.label || String(idx + 1)
const isLabeled = !!group.label

function byParent(fields) {
  const result = [], seen = new Map()
  for (const f of fields) {
    const canonical = PARENT_NODE_ALIASES[f.parentNodeId] || f.parentNodeId || '__root__'
    if (!seen.has(canonical)) { const g = { label: PARENT_NODE_TITLES[canonical] || null, pid: canonical, fields: [] }; seen.set(canonical, g); result.push(g) }
    seen.get(canonical).fields.push(f)
  }
  return result
}

function splitMax5(groups) {
  const out = []
  for (const fg of groups) {
    if (fg.fields.length <= 5) { out.push(fg); continue }
    for (let i = 0; i < fg.fields.length; i += 5)
      out.push({ label: i === 0 ? fg.label : null, pid: fg.pid, fields: fg.fields.slice(i, i + 5) })
  }
  return out
}

const fieldCols = splitMax5(byParent(group.fields))

// Group subgroups by nodeId so same-type instances sit side by side
const sgByType = []
const sgTypeMap = new Map()
for (const sg of (group.subGroups || [])) {
  if (!sgTypeMap.has(sg.nodeId)) { const g = { nodeId: sg.nodeId, instances: [] }; sgTypeMap.set(sg.nodeId, g); sgByType.push(g) }
  sgTypeMap.get(sg.nodeId).instances.push(sg)
}
%>
<div>
  <% if (isLabeled) { %>
    <h3><%= groupLabel %></h3>
  <% } else { %>
    <p class="section-title"><%= groupLabel %></p>
  <% } %>

  <% if (group.fields.length > 0) { %>
    <div class="grid-auto">
      <% fieldCols.forEach(fg => { %>
        <div>
          <% if (fg.label) { %><h4><%= fg.label %></h4><% } %>
          <%- include('kv-list', { fields: fg.fields }) %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% sgByType.forEach(sgType => { %>
    <h4><%= SUBGROUP_TITLES[sgType.nodeId] || sgType.nodeId %></h4>
    <div class="grid-<%= Math.min(sgType.instances.length, 3) %>">
      <% sgType.instances.forEach(sg => { %>
        <%- include('subgroup', { sg }) %>
      <% }) %>
    </div>
  <% }) %>
</div>
