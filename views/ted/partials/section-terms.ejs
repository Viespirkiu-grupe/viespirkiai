<%
function f(id) { return (section.fields.find(x => x.fieldId === id)?.values || []).join(', ') }
const exclusion     = f('BT-67(a)-Procedure')
const exclusionDesc = f('BT-67(b)-Procedure')
const exclusionSrc  = f('BT-806-Procedure')
const maxSubmit     = f('BT-31-Procedure')
const maxAwarded    = f('BT-33-Procedure')
const crossBorder   = f('BT-09(a)-Procedure')
const crossBorderDesc=f('BT-09(b)-Procedure')
const hasContent = exclusion || exclusionDesc || maxSubmit || maxAwarded || crossBorder || crossBorderDesc
%>
<% if (hasContent) { %>
<section id="dalyvavimo-salygos">
  <h2>Dalyvavimo sąlygos</h2>
  <div class="grid-3">
    <% if (exclusion || exclusionDesc) { %>
      <div>
        <p class="section-title">Pašalinimo pagrindai</p>
        <% if (exclusion) { %><p><%= exclusion %></p><% } %>
        <% if (exclusionDesc) { %><p class="text-sm text-muted"><%= exclusionDesc %></p><% } %>
        <% if (exclusionSrc) { %><p class="text-sm text-muted">Šaltinis: <%= exclusionSrc %></p><% } %>
      </div>
    <% } %>
    <% if (maxSubmit || maxAwarded) { %>
      <div>
        <p class="section-title">Dalių paskirstymas</p>
        <% if (maxSubmit) { %><p class="section-title text-sm">Maks. pasiūlymų dalių</p><p><strong><%= maxSubmit %></strong></p><% } %>
        <% if (maxAwarded) { %><p class="section-title text-sm">Maks. skiriamų dalių</p><p><strong><%= maxAwarded %></strong></p><% } %>
      </div>
    <% } %>
    <% if (crossBorder || crossBorderDesc) { %>
      <div>
        <p class="section-title">Tarpvalstybinė teisė</p>
        <% if (crossBorderDesc) { %><p><%= crossBorderDesc %></p><% } else { %><p><%= crossBorder %></p><% } %>
      </div>
    <% } %>
  </div>
</section>
<% } %>
