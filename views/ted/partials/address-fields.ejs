<%
// Works for any suffix: -Lot, -Procedure, -Part, etc.
function fa(fields, btNum) {
  const f = fields.find(x => x.fieldId.startsWith('BT-' + btNum + '-') || x.fieldId.startsWith('BT-' + btNum + '('))
  return (f?.values || []).join(', ')
}
function faArr(fields, btNum) {
  const f = fields.find(x => x.fieldId.startsWith('BT-' + btNum + '-') || x.fieldId.startsWith('BT-' + btNum + '('))
  return f?.values || []
}
const street1  = fa(addrFields, '5101(a)')
const street2  = fa(addrFields, '5101(b)')
const zip      = fa(addrFields, '5121')
const city     = fa(addrFields, '5131')
const country  = fa(addrFields, '5141')
const nuts     = fa(addrFields, '5071')
const restrict = fa(addrFields, '727')
const addInfo  = fa(addrFields, '728')
%>
<% if (street1 || street2) { %><p style="margin-bottom:var(--space-1)"><%= [street1, street2].filter(Boolean).join(', ') %></p><% } %>
<% if (zip || city || country) { %><p style="margin-bottom:var(--space-1)"><%= [[zip, city].filter(Boolean).join(' '), country].filter(Boolean).join(' · ') %></p><% } %>
<% if (nuts) { %><p class="text-sm text-muted" style="margin-bottom:var(--space-1)">NUTS: <%= nuts %></p><% } %>
<% if (restrict) { %><p class="text-sm" style="margin-bottom:var(--space-1)"><%= escapeHtml(restrict) %></p><% } %>
<% if (addInfo) { %><p class="text-sm text-muted" style="margin-bottom:0"><%= escapeHtml(addInfo) %></p><% } %>
