<%
function f(id) { return (section.fields.find(x => x.fieldId === id)?.values || []).join(', ') }
const procType    = f('BT-105-Procedure')
const accelerated = f('BT-106-Procedure')
const accelDesc   = f('BT-1351-Procedure')
const lotsConstr  = f('BT-763-Procedure')
const features    = f('BT-88-Procedure')
const cols = [
  features    && { label: 'Procedūros ypatumai',      text: features },
  accelerated === 'Taip' && { label: 'Pagreitinta procedūra', text: accelDesc || 'Taip' },
  lotsConstr  && { label: 'Dalių apribojimai',         text: lotsConstr },
].filter(Boolean)
%>
<section id="procedura">
  <h2>Procedūra</h2>
  <% if (procType) { %><h3><%= procType %></h3><% } %>
  <% if (cols.length) { %>
    <div class="grid-3">
      <% cols.forEach(col => { %>
        <div>
          <p class="section-title"><%= col.label %></p>
          <p class="text-sm"><%= col.text %></p>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
