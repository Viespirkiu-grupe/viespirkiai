<!DOCTYPE html>
<html>
	<head>
 <%- include('../head.ejs', {
            pageTitle: "PINREG duomenų atnaujinimas",
            pageDescription: `Puslapis skirtas atnaujinti Privačių interesų registro duomenis.`,
            pageImage: `https://viespirkiai.org/pinreg/scrape.png`,
            customHead
        }) %>
	</head>
	<body>
		<%- include('../header.ejs') %>
		<main>
			<h1 style="text-align: center;">Privačių interesų registro duomenų atnaujinimas</h1>
			<div class="col-2-strict mobile-col-1-strict">
    			<section style="max-width: 100%;">
    			    <h2 id="scrape"><u>Duomenų gavimas</u></h2>
    				<ol style="line-height: 1.8;">
        				<li>Nukopijuokite žemiau esantį kodą</li>
                        <li>Atidarykite <a href="https://pinreg.vtek.lt/app/deklaraciju-paieska" target="_blank">Privačių interesų registro</a> svetainę</li>
                        <li>Paspauskite klaviatūroje F12, kad atidarytumėte naršyklės kūrėjo įrankius</li>
                        <li>Pasirinkite "Console" (Konsolė) skiltį</li>
                        <li>Įklijuokite nukopijuotą kodą į konsolę ir paspauskite Enter</li>
                        <li>Pereikite per paskutinius kelis puslapius deklaracijų <br> <i> Pačių deklaracijų atsidaryti būtina nėra, neeikite toliau už 10.000 įrašų.</i></li>
                        <li>Paspauskite mygtuką <kbr>Kopijuoti UUID sąrašą</kbr> ir sekite instrukcijas skilyje duomenų pateikimas</li>
    				</ol>
                    <h3>Kodas</h3>
                    <div style="position:relative; display:inline-block; width:100%;" class="code-container">
                      <pre><code class="hljs language-javascript"><%- highlightCode(include('scrapeKodas.js')) %></code></pre>
                      <a href="#" id="copy-link" style="position:absolute; top:5px; right:5px; padding: 16px; display: block;">Kopijuoti</a>
                    </div>

                    <script>
                      const copyLink = document.getElementById('copy-link');
                      const codeEl = copyLink.previousElementSibling.querySelector('code');

                      copyLink.addEventListener('click', (e) => {
                        e.preventDefault();
                        navigator.clipboard.writeText(codeEl.textContent)
                          .then(() => {
                            const original = copyLink.textContent;
                            copyLink.textContent = 'Kopijuota!';
                            setTimeout(() => copyLink.textContent = original, 1500);
                          })
                          .catch(err => console.error('Copy failed', err));
                      });
                    </script>
    			</section>
    			<section>
    			    <h2 id="submit"><u>Duomenų pateikimas</u></h2>
                    <form method="post" action="">
                        <label for="uuid-input">Įklijuokite deklaracijų UUID žemiau:</label>
                        <textarea id="uuid-input" name="uuids" style="width:100%; height:200px; margin-top:10px;" placeholder="Įklijuokite UUID čia..."></textarea>
                        <button type="submit" style="margin-top:10px; padding:10px 20px;">Pateikti</button>
                        <div>
                            <% if(typeof uuidSubmitMessage !== 'undefined') { %>
                                <p><%= uuidSubmitMessage %></p>
                            <% } %>
                        </div>
                    </form>
    			</section>
			</div>

		</main>
		<%- include('../footer.ejs', {neoficialus: false}) %>
	</body>
</html>
