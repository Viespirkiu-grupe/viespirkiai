<!DOCTYPE html>
<html>
	<head>
    	<%- include('../head.ejs', {
            pageTitle: frontmatter.title || "Viešlaiškis",
            pageDescription: `Aprašymas`,
            pageImage: `https://viespirkiai.org/index.png`,
            customHead
        }) %>
        <style>
        @media (min-width: 800px) {
            main.vieslaiskis {
                max-width: 800px;
                margin: auto;
            }
        }
        p{
            text-align: justify;
            line-height: 2;
        }
        .vieslaiskis table{
            max-width: 100%;
            min-width: initial;
            width: auto;
        }
        .vieslaiskis tr, .vieslaiskis td{
            padding-block: 0px;
            padding-inline: 8px;
            line-height: 2;
        }
        .float-right{
            float: right;
            margin-left: 15px;
        }
        .float-right table{
            margin-block: 8px;
        }
        .float-left{
            float: left;
            margin-left: 15px;
        }
        .float-left table{
            margin-block: 8px;
        }
        @media(max-width: 786px){
            .float-mobile-none{
                float: none !important;
                margin: auto !important;
            }
        }
        .justify{
            text-align: justify;
        }
        h1 , h2, h3, h4, h5, h6{
            float: clear;
        }
        .center table{
            margin: auto;
        }
        ul li{
            margin-bottom: 10px;
            line-height: 2;
        }
        .table-no-heading thead th{
            background-color: var(--white);
        }
        </style>
	</head>
	<body>
		<%- include('../header.ejs') %>
		<main class="vieslaiskis">
		    <%- vieslaiskisContent %>
		</main>
		<%- include('../footer.ejs', {
		  neoficialus: false
		}) %>
	</body>
</html>
