<div class="inputContainer sortToggleContainer">
  <div style="display: flex; align-items: center; justify-content: flex-start; gap: 0.5rem;">
    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
      <button
        type="button"
        id="<%= name %>_btn"
        aria-label="<%= label %>"
        class="sortToggleButton">
        <svg class="sortIcon" width="24" height="24" viewBox="0 0 24 24">
          <path d="M3 18h6v-2H3v2zm0-5h12v-2H3v2zm0-5h18V6H3v2z" fill="#fff"/>
        </svg>
      </button>

      <%= label %>
      <input
        type="hidden"
        name="<%= name %>"
        id="<%= name %>_hidden"
        value="<%= values["sortDir"] || "" %>">
    </label>
  </div>
</div>
<script>
(function() {
  const btn = document.getElementById("<%= name %>_btn");
  const hiddenInput = document.getElementById("<%= name %>_hidden");
  const icon = btn.querySelector('.sortIcon');

  // Initialize sortDir from hidden input
  let sortDir = hiddenInput.value || "";

  // Update icon based on sortDir
  function updateIcon() {
    switch(sortDir) {
      case "asc":
        icon.style.transform = "scaleY(-1)"; // arrow up
        break;
      case "desc":
        icon.style.transform = "scaleY(1)"; // arrow down
        break;
      default:
        icon.style.transform = "none"; // neutral
        break;
    }
  }

  updateIcon(); // set on load

  btn.addEventListener('click', () => {
    // toggle asc/desc
    if(sortDir === "asc") {
      sortDir = "desc";
    } else {
      sortDir = "asc";
    }
    hiddenInput.value = sortDir;
    updateIcon();
  });
})();
</script>



<style>
.sortToggleButton {
  width: 42px;
  height: 42px;
  border-radius: 4px;
  border: none;
  background-color: #000; /* black background like your screenshot */
  display: flex;
  align-items: center;
  justify-content: center; /* icon centered */
  cursor: pointer;
  padding: 0;
}

.sortToggleButton .sortIcon {
  width: 24px;
  height: 24px;
  fill: #fff; /* white icon */
  transition: transform 0.2s ease-in-out;
}
</style>
