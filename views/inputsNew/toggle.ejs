<div class="inputContainer toggleInputContainer">
    <div style="display: flex; align-items: center; justify-content: flex-start;">
        <label for="<%= name %>" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
            <input
                type="checkbox"
                name="<%= name %>"
                id="<%= name %>"
                value="true"
                class="toggleInput"
                <% if (values[name]) { %> checked <% } %>
            />
            <span class="toggleSlider"></span>
            <%= label %>
        </label>
    </div>
</div>
