<div class="inputContainer textInputContainer">
    <label for="<%= name %>" class="inputLabel textInputLabel"><%= label %></label>
    <input
        type="text"
        name="<%= name %>"
        id="<%= name %>"
        value="<%= values[name] || "" %>"
        placeholder="<%= placeholder || '' %>"
        class="textInput"
    />
</div>
