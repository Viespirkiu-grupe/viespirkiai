<div class="inputContainer numberInputContainer">
    <label for="<%= name %>" class="inputLabel numberInputLabel"><%= label %></label>
    <input
        type="text"
        name="<%= name %>"
        id="<%= name %>"
        value="<%= values[name] || "" %>"
        placeholder="<%= placeholder || '' %>"
        class="numberInput"
        pattern="^-?[0-9]+([.,][0-9]+)?$"
    />
</div>
