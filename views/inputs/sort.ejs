<% const _sortDirLabel = values['sortDir'] === 'asc' ? 'Rikiavimo kryptis: nuo mažiausio' : 'Rikiavimo kryptis: nuo didžiausio'; %>
<button type="button" id="<%= name %>_btn" class="btn btn-form sort-toggle-btn border-l-0 rounded-l-none rounded-r-md" aria-label="<%= _sortDirLabel %>" title="<%= _sortDirLabel %>">
  <svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M3 18h6v-2H3v2zm0-5h12v-2H3v2zm0-5h18V6H3v2z" fill="currentColor"/>
  </svg>
</button>
<input type="hidden" name="<%= name %>" id="<%= name %>_hidden" value="<%= values['sortDir'] || '' %>">
<script>
(function() {
  const btn = document.getElementById("<%= name %>_btn");
  const input = document.getElementById("<%= name %>_hidden");
  const icon = btn.querySelector('.sort-icon');
  let dir = input.value || "";
  function update() {
    icon.style.transform = dir === "asc" ? "scaleY(-1)" : "scaleY(1)";
    const label = dir === "asc" ? "Rikiavimo kryptis: nuo mažiausio" : "Rikiavimo kryptis: nuo didžiausio";
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
  }
  update();
  btn.addEventListener('click', () => {
    dir = dir === "asc" ? "desc" : "asc";
    input.value = dir;
    update();
  });
})();
</script>
