<style>
/* Top nav */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border);
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
}

.navbar-nav {
    list-style: none;
    margin: 0;
    padding: 0;
}

.navbar-brand {
    font-weight: 700;
      font-size: var(--text-lg);
      color: var(--black);
      text-decoration: none;
      justify-self: start;
}

.navbar-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
}

.navbar-nav a {
    color: var(--gray);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    transition: color var(--transition), background-color var(--transition);
}

.navbar-nav a:hover,
.navbar-nav a.active {
    color: var(--black);
    background: var(--lighter-gray);
}

.navbar-actions {
    display: flex;
    align-items: center;
    justify-self: end;
}

/* Tabs */
.tabs-container {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    padding-inline: var(--space-4);
    margin-block: var(--space-6);
}
.tabs-container::-webkit-scrollbar { display: none; }

.tabs {
    display: flex;
    gap: var(--space-7);
    min-width: max-content;
    border-bottom: var(--border);
}

.tabs a {
    flex-shrink: 0;
    text-decoration: none;
    padding-bottom: var(--space-4);
    color: var(--gray);
    position: relative;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: color var(--transition);
}

.tabs a:hover, .tabs a.active { color: var(--black); }

.tabs a.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--black);
    border-radius: 2px 2px 0 0;
}

/* Pill tabs */
.tabs-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-4);
}

.tabs-pills a {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--gray);
    text-decoration: none;
    background: var(--lighter-gray);
    transition: background-color var(--transition), color var(--transition);
}

.tabs-pills a:hover { background: var(--light-gray); color: var(--black); }
.tabs-pills a.active { background: var(--black); color: var(--white); }

/* Breadcrumb */
.breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--gray);
}

.breadcrumb li + li::before {
    content: "/";
    color: var(--light-gray);
    margin-right: var(--space-1);
}

.breadcrumb a { color: var(--gray); }
.breadcrumb li:last-child { color: var(--black); font-weight: 500; }

/* Pagination */
.pagination {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0;
}

.pagination a, .pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding-inline: var(--space-2);
    border: var(--border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--black);
    background: var(--white);
    transition: background-color var(--transition);
}

.pagination a:hover   { background: var(--lighter-gray); }
.pagination .active a { background: var(--black); color: var(--white); border-color: var(--black); }
.pagination .disabled span { color: var(--gray); pointer-events: none; }

.navbar-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 36px;
  height: 36px;
  padding: var(--space-2);
  background: none;
  border: none;
  cursor: pointer;
  border-radius: var(--radius-md);
  transition: background var(--transition);
}
.navbar-hamburger:hover { background: var(--lighter-gray); }
.navbar-hamburger span {
  display: block;
  width: 100%;
  height: 2px;
  background: var(--black);
  border-radius: 2px;
  transition: transform var(--transition), opacity var(--transition);
  transform-origin: center;
}
.navbar-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.navbar-hamburger.open span:nth-child(2) { opacity: 0; }
.navbar-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.navbar-mobile {
  display: none;
  background: var(--white);
  border-bottom: var(--border);
  overflow: hidden;
  max-height: 0;
  transition: max-height var(--transition-slow);
}
.navbar-mobile.open {
  max-height: 100dvh;
  height: 100dvh;
}
body.nav-open {
  overflow: hidden;
}
html:has(body.nav-open) {
  overflow: hidden;
  background: var(--white);
}
.navbar-mobile-nav {
  list-style: none;
  margin: 0;
  padding: var(--space-3) var(--space-4);
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.navbar-mobile-nav a {
  display: block;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  color: var(--gray);
  text-decoration: none;
  font-size: var(--text-sm);
  transition: background var(--transition), color var(--transition);
}
.navbar-mobile-nav a:hover,
.navbar-mobile-nav a.active {
  background: var(--lighter-gray);
  color: var(--black);
}
.navbar-mobile-divider {
  height: 1px;
  background: var(--light-gray);
  margin: var(--space-2) 0;
}

@media (max-width: 1200px) {
  .navbar-main      { display: none; }
  .navbar-hamburger { display: flex; margin-left: auto; }
  .navbar-actions .navbar-nav { display: none; }
  .navbar-mobile    {
    display: block;
    position: sticky;
    top: 49px; /* height of navbar */
    z-index: var(--z-sticky);
  }
}

header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-sticky);
  /* Safari fix */
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
}

body {
  padding-top: 80px; /* navbar height */
}

@media (max-width: 1200px) {
  header {
    transition: transform var(--transition-slow);
  }
  header.nav-hidden {
    transform: translateY(-100%);
  }
}

.navbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border);
    background: var(--white);
}

.navbar-brand { justify-self: start; }
.navbar-main  { justify-self: center; }
.navbar-actions { justify-self: end; }

@media (max-width: 1200px) {
  .navbar {
    grid-template-columns: 1fr auto;
  }
}

.navbar-scheme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  padding: var(--space-2);
  margin-inline: var(--space-2);
  background: none;
  border: none;
  cursor: pointer;
  border-radius: var(--radius-md);
  color: var(--black);
  transition: background var(--transition);
}
.navbar-scheme-toggle:hover { background: var(--lighter-gray); }

@media (max-width: 1200px) {
  .navbar-scheme-toggle {
    margin-left: 0;
    margin-right: var(--space-2);
  }
}

.navbar-mobile {
  margin-top: -1px;
  padding-top: 1px;
}

.navbar-mobile::before {
  content: "";
  position: absolute;
  top: -500px;
  left: 0;
  right: 0;
  height: 500px;
  background: var(--white);
}
</style>
