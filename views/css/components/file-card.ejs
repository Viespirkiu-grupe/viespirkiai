<style>
/* ── File Card (mock layout) ───────────────────────────────────────────────
  Overlay-link clickability (no JS, no nested anchors):
  - `.card-overlay-link` should be the click target for the whole card.
  - Action links must stay above it and remain clickable.
  - Non-interactive visuals (icon/title/meta) must NOT block clicks (pointer-events:none).

  Variants:
  - `.file-card-title-2l` : clamp title to 2 lines (useful for long notice titles)
  - `.file-card-hide-meta`: hide meta row entirely (so title can take space)
 */

.file-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;

  width: 100%;
  max-width: 360px;
  height: 72px;
  padding-right: 8px;

  border-radius: var(--radius-xl);
  background: var(--white);
  border: 1px solid var(--light-gray);
  box-shadow: var(--shadow-md);
  overflow: hidden;

  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.file-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md), 0 10px 28px rgba(0, 0, 0, 0.14);
}

/* Make the overlay link actually receive clicks across the whole card */
.file-card > .card-overlay-link {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: block;
  text-indent: -9999px;
}

/* Non-interactive visuals should not steal clicks from the overlay */
.file-card-icon,
.file-card-body {
  pointer-events: none;
}

/* Right actions must be clickable (above overlay) */
.file-card-actions-col {
  position: relative;
  z-index: 2;
  pointer-events: auto;

  margin-left: auto;
  padding-right: 12px;

  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;

  text-align: right;
  white-space: nowrap;
}

/* optional size helpers */
.file-card-sm { max-width: 360px; height: 72px; }
.file-card-lg { max-width: 360px; height: 72px; }

/* muted variant */
.file-card-muted { background: var(--white); }

/* Left icon: SVG filling 96x72 anchored to left */
.file-card-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 96px;
  height: 72px;
}

/* Text block: sits after the icon via left margin */
.file-card-body {
  margin-left: 100px;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.file-card-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--black);
  line-height: 1.25;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-card-meta {
  font-size: 11px;
  color: var(--gray);
  line-height: 1.25;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Variants ───────────────────────────────────────────────────────────── */

/* Title on 2 lines (clamped) */
.file-card-title-2l .file-card-title {
  white-space: normal;
  text-overflow: clip;

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;

  overflow: hidden;
  line-height: 1.35;
  max-height: calc(1.25em * 2);
}

/* Optional: hide meta entirely (e.g., for skelbimai) */
.file-card-hide-meta .file-card-meta {
  display: none;
}

.file-card-action {
  font-size: 11px;
  font-weight: 600;
  color: var(--dark-gray);
  text-decoration: none;
}

.file-card-action:hover { text-decoration: underline; }

/* Dark mode: only tweak text colors to stay readable */
@media (prefers-color-scheme: dark) {
  .file-card-title { color: var(--black); }
  .file-card-meta { color: var(--gray); }
  .file-card-action { color: var(--dark-gray); }
}
</style>
