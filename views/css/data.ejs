<style>
/* Stat card — for KPI tiles */
.stat-card {
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
}

.stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: var(--space-2);
}

.stat-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--black);
    line-height: 1.1;
}

.stat-delta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    margin-top: var(--space-1);
}

.stat-delta.up   { color: var(--color-success); }
.stat-delta.down { color: var(--color-danger); }

/* Key-value pairs */
.kv-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
}

.kv-list dt { color: var(--gray); font-weight: 400; }
.kv-list dd { color: var(--black); font-weight: 500; }

/* Amount display */
.amount {
    font-weight: 700;
    color: var(--black);
    font-variant-numeric: tabular-nums;
    text-decoration: underline;
}

.amount-sm { font-size: var(--text-base); }
.amount-lg { font-size: var(--text-2xl); }
.amount-label { font-size: var(--text-xs); color: var(--gray); }

/* Timeline */
.timeline { list-style: none; padding: 0; margin: 0; }

.timeline-item {
    display: flex;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    position: relative;
}

.timeline-item::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 20px;
    bottom: 0;
    width: 1px;
    background: var(--light-gray);
}

.timeline-item.line-active::before { background: var(--black); }

.timeline-item:last-child::before { display: none; }

.timeline-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--light-gray);
    flex-shrink: 0;
    margin-top: 3px;
    z-index: 1;
}

.timeline-dot.active { border-color: var(--black); background: var(--black); }

.timeline-body { flex: 1; min-width: 0; }
.timeline-date { font-size: var(--text-xs); color: var(--gray); }

@media (max-width: 600px) {
  .kv-list {
    grid-template-columns: 1fr;
  }

  .kv-list dd {
    text-align: left;
    margin-bottom: var(--space-2);
  }
}
</style>
