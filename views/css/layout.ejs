<style>
.container {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
}

.container-sm { max-width: var(--content-width); }
.container-fluid { max-width: 100%; }

@media (min-width: 1000px) {
    .container-inset { margin-inline: var(--sidebar-pct); }
}

header         { margin-bottom: var(--space-5); }

footer {
    width: 100%;
    min-height: 64px;
    margin-block: var(--space-6);
    border-top: var(--border);
    padding-top: var(--space-5);
}

footer .footer-inner {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
}

footer a {
    color: var(--gray);
    font-size: var(--text-sm);
    text-decoration: none;
}
footer a:hover { text-decoration: underline; }

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: var(--border);
}

.page-header h1 { margin-bottom: 0; }

.section { margin-block: var(--space-7); }
.section-sm { margin-block: var(--space-5); }

/* Sticky sidebar layout */
.sidebar-layout {
    display: flex;
    height: 100vh;
    overflow: hidden;
}

.sidebar {
    width: 240px;
    flex-shrink: 0;
    height: 100vh;
    overflow-y: auto;
    background: var(--white);
    border-right: var(--border);
    padding: var(--space-5) var(--space-4);
}


.sidebar-title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray);
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
}

.sidebar-title:first-of-type { margin-top: 0; }

.sidebar nav a {
    display: block;
    padding: 4px var(--space-2);
    font-size: var(--text-sm);
    color: var(--gray);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background-color var(--transition);
}

.sidebar nav a:hover,
.sidebar nav a.active {
    color: var(--black);
    background: var(--lighter-gray);
}

.sidebar-main {
    flex: 1;
    min-width: 0;
    height: 100vh;
    overflow-y: auto;
    padding: var(--space-7);
}

.sidebar-main-inner {
    max-width: 900px;
    margin-inline: auto;
}

.sidebar-layout > .sidebar-main {
    padding-inline: var(--space-7); /* override the global main { padding-inline } */
}

main:not(.sidebar-main):not([class*="px-"]) { padding-inline: var(--space-7); }

@media (max-width: 1200px){
    main:not(.sidebar-main):not([class*="px-"]) {
        padding-inline: var(--space-5);
    }
}

@media (max-width: 768px) {
    .sidebar { display: none; }
    .sidebar-main { padding: var(--space-5) var(--space-4); }
}


@media (max-width: 1200px) {
    footer {
        margin-block: var(--space-5);
        padding-top: var(--space-4);
    }
    footer .footer-inner {
        gap: var(--space-3);
    }
}

@media (max-width: 480px) {
    footer .footer-inner {
        flex-direction: column;
        align-items: center;
        gap: var(--space-2);
    }
}

footer{
    padding-inline: var(--space-4);
    padding-top: var(--space-5);
}

</style>
