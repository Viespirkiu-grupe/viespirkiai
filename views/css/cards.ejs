<style>
.card {
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--transition);
}

.card-hover:hover { box-shadow: var(--shadow-md); }

.card-header {
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border);
    background: var(--shade-2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
}

.card-header h3, .card-header h4 { margin: 0; }

.card-body { padding: var(--space-4); }
.card-body-sm { padding: var(--space-3); }
.card-body-lg { padding: var(--space-5); }

.card-footer {
    padding: var(--space-3) var(--space-4);
    border-top: var(--border);
    background: var(--shade-2);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
}

/* Clickable card via overlay link */
.card-clickable { position: relative; }
.card-clickable:hover { box-shadow: inset 0 0 0 2px var(--black); }

.card-overlay-link {
    position: absolute;
    inset: 0;
    z-index: 0;
    text-indent: -9999px;
}

.card-clickable a:not(.card-overlay-link),
.card-clickable button,
.card-clickable span {
    position: relative;
    z-index: 1;
}

/* Result card (search result style) */
.result-card {
    display: flex;
    align-items: flex-start;
    padding: var(--space-5);
    border-bottom: var(--border);
    transition: box-shadow var(--transition);
    position: relative;
}

.result-card:last-child { border-bottom: none; }
.result-card:hover { box-shadow: inset 0 0 0 1px var(--black); }

.result-card-body { flex: 1 1 auto; min-width: 0; }

.result-card-sidebar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    margin-left: var(--space-4);
    padding-left: var(--space-3);
    padding-block: var(--space-2);
    border-left: var(--border);
    min-width: 120px;
}

.result-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--gray);
    margin-bottom: var(--space-1);
}

.result-card-title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
}

.result-card-title a {
    color: var(--black);
    text-decoration: none;
}
.result-card-title a:hover { text-decoration: underline; }

.result-card-excerpt { color: var(--gray); font-size: var(--text-sm); }

.result-list {
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.result-card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--dark-gray);
    margin-top: var(--space-3);
}

@media (max-width: 600px) {
    .result-list { border: none; border-radius: 0; }
    .result-card { padding-inline: 0; }
    .result-card:hover { box-shadow: none; }
}

.result-card:first-child { border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
.result-card:last-child  { border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
.result-card:only-child  { border-radius: var(--radius-lg); }
</style>
