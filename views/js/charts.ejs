<script defer>
  let apexPromise;
  const renderedCharts = [];

  function loadApexCharts() {
    if (window.ApexCharts) return Promise.resolve(window.ApexCharts);
    if (apexPromise) return apexPromise;
    apexPromise = new Promise((resolve, reject) => {
      function startLoading() {
        const script = document.createElement('script');
        script.src = '/dist/apexcharts.js';
        script.defer = true;
        script.onload = () => resolve(window.ApexCharts);
        script.onerror = reject;
        document.body.appendChild(script);
      }
      document.readyState === 'loading'
        ? window.addEventListener('DOMContentLoaded', startLoading)
        : startLoading();
    });
    return apexPromise;
  }

  function deepMerge(target, source) {
    for (const key in source) {
      if (source[key] && typeof source[key] === 'object' && !Array.isArray(source[key])) {
        if (!target[key]) target[key] = {};
        deepMerge(target[key], source[key]);
      } else {
        target[key] = source[key];
      }
    }
    return target;
  }

  function getIsDark() {
    return document.documentElement.classList.contains('dark');
  }

  function getThemeTokens(isDark) {
    return {
      foreground:    isDark ? '#f5f4f4' : '#0c0a09', // stone-50  / stone-950
      labelColor:    isDark ? '#a8a29e' : '#292524', // stone-400 / stone-800
      gridColor:     isDark ? '#292524' : '#e7e5e4', // stone-800 / stone-200
      tooltipBg:     isDark ? '#1c1917' : '#fafaf9', // stone-900 / stone-50
      tooltipText:   isDark ? '#f5f4f4' : '#0c0a09', // stone-50  / stone-950
      tooltipBorder: isDark ? '#292524' : '#d6d3d1', // stone-800 / stone-300
    };
  }

  // Example color pallete, colorful
  // const CATEGORICAL_COLORS = {
  //     light: [
  //         '#2563eb', // blue-600
  //         '#d97706', // amber-600
  //         '#dc2626', // red-600
  //         '#0d9488', // teal-600
  //         '#16a34a', // green-600
  //         '#ca8a04', // yellow-600
  //         '#9333ea', // purple-600
  //     ],
  //     dark: [
  //         '#93c5fd', // blue-300
  //         '#fcd34d', // amber-300
  //         '#fca5a5', // red-300
  //         '#5eead4', // teal-300
  //         '#86efac', // green-300
  //         '#fde68a', // yellow-200
  //         '#d8b4fe', // purple-300
  //     ],
  // };

  // Grayscale pallete
  // Adjust the number of shades as needed
  const CATEGORICAL_COLORS = {
    light: [
        '#0c0a09', // stone-950
        // '#292524', // stone-800
        // '#57534e', // stone-600
        '#79716b', // stone-500
        // '#a8a29e', // stone-400
        // '#d6d3d1', // stone-300
        '#e7e5e4', // stone-200
    ],
    dark: [
        '#f5f4f4', // stone-50
        // '#d6d3d1', // stone-300
        // '#a8a29e', // stone-400
        '#79716b', // stone-500
        // '#57534e', // stone-600
        // '#44403c', // stone-700
        '#292524', // stone-800
    ],
  };

  function getCategoricalColors(isDark) {
      return isDark ? CATEGORICAL_COLORS.dark : CATEGORICAL_COLORS.light;
  }

  function getShadesOfGray(isDark) {
    return isDark
      ? ['#f5f4f4', '#d6d3d1', '#a8a29e', '#79716b', '#57534e', '#44403c', '#292524']
      : ['#0c0a09', '#1c1917', '#292524', '#44403c', '#57534e', '#79716b', '#a8a29e'];
  }

  const eurFormatter = v => typeof v === 'number'
    ? v.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' })
    : 'Nėra duomenų';

  function buildGlobalDefaults(isDark) {
    const t = getThemeTokens(isDark);
    return {
      chart: {
        toolbar: { show: false },
        zoom: { enabled: false },
        fontFamily: 'Ubuntu, system-ui, sans-serif',
        background: 'transparent',
        height: 350,
        foreColor: t.labelColor,
      },
      tooltip: {
        enabled: true,
        theme: isDark ? 'dark' : 'light',
        style: { fontFamily: 'Ubuntu, system-ui, sans-serif' },
      },
      xaxis: { labels: { style: { colors: t.labelColor } } },
      yaxis: { labels: { style: { colors: t.labelColor } } },
      stroke: { curve: 'smooth', width: 2 },
      markers: { size: 4 },
      colors: getCategoricalColors(isDark),
      grid: { borderColor: t.gridColor },
      theme: { mode: isDark ? 'dark' : 'light' },
      legend: { labels: { colors: t.labelColor } },
    };
  }

  const typeChartDefaults = {
    'line-datetime': {
      chart: { type: 'line' },
      xaxis: { type: 'datetime', tickAmount: 6, labels: { format: 'yyyy-MM' } },
      tooltip: { x: { format: 'yyyy-MM' } },
    },
    'pie': {
      chart: { type: 'pie' },
      legend: { position: 'bottom' },
      dataLabels: { enabled: true },
      colors: CATEGORICAL_COLORS,
    },
    'scatter': { chart: { type: 'scatter' } },
    'treemap': { chart: { type: 'treemap' } },
  };

  const chartFlagDefaults = {
    'yEUR':              { yaxis: { labels: { formatter: eurFormatter } } },
    'yEURMen':           { yaxis: { labels: { formatter: v => typeof v === 'number' ? eurFormatter(v) + ' / mėn.' : 'Nėra duomenų' } } },
    'yMin0':             { yaxis: { min: 0 } },
    'yMinAuto':          { yaxis: { min: undefined } },
    'xYear':             { xaxis: { labels: { format: 'yyyy' } }, tooltip: { x: { format: 'yyyy' } } },
    'xAxisYearMonth':    { xaxis: { type: 'datetime', tickAmount: 6, labels: { format: 'yyyy-MM' } }, tooltip: { x: { format: 'yyyy-MM' } } },
    'xAxisDay':          { xaxis: { type: 'datetime', tickAmount: 6, labels: { format: 'yyyy-MM-dd' } }, tooltip: { x: { format: 'yyyy-MM-dd' } } },
    'xAxisHourMinute':   { xaxis: { type: 'datetime', tickAmount: 6, labels: { format: 'HH:mm' } }, tooltip: { x: { format: 'HH:mm' } } },
    'yAxisLog':          { yaxis: { logarithmic: true } },
    'yAxisNoLabel':      { yaxis: { labels: { show: false } } },
    'noLine':            { stroke: { width: 0 } },
    'colors':            { colors: CATEGORICAL_COLORS },
    'numbersWithSpaces': { yaxis: { labels: { formatter: v => typeof v === 'number' ? v.toLocaleString('lt-LT') : 'Nėra duomenų' } } },
  };

  function buildOptions(data, isDark) {
    let options = structuredClone(buildGlobalDefaults(isDark));

    if (data.type && typeChartDefaults[data.type]) {
      options = deepMerge(options, structuredClone(typeChartDefaults[data.type]));
    }

    for (const flag of (data.flags || [])) {
      if (flag === '50shadesOfGray') {
        options = deepMerge(options, { colors: getShadesOfGray(isDark) });
      } else if (flag in chartFlagDefaults) {
        options = deepMerge(options, chartFlagDefaults[flag]);
      }
    }

    if (data.type !== 'pie') {
      options.xaxis = options.xaxis || {};
      options.xaxis.categories = data.labels;
      if (Array.isArray(data.series) && (data.series.length === 0 || !data.series[0]?.data)) {
        options.series = [{ name: data.customOptions?.seriesName || '', data: data.series }];
      } else {
        options.series = data.series;
      }
    } else {
      options.labels = data.labels;
      options.series = data.series;
    }

    if (data.customOptions) {
      options = deepMerge(options, data.customOptions);
    }

    return options;
  }

  async function displayChart(data) {
    if (!data?.element || !data?.labels || !data?.series) {
      console.error('displayChart: missing required fields', data);
      return;
    }
    await loadApexCharts();
    const chart = new ApexCharts(data.element, buildOptions(data, getIsDark()));
    chart.render();
    renderedCharts.push({ chart, data });
  }

  function updateAllCharts() {
    const isDark = getIsDark();
    const t = getThemeTokens(isDark);
    for (const { chart, data } of renderedCharts) {
      const flags = data.flags || [];
      const colors = flags.includes('50shadesOfGray')
        ? getShadesOfGray(isDark)
        : getCategoricalColors(isDark);
      chart.updateOptions({
        chart: { foreColor: t.labelColor },
        tooltip: { theme: isDark ? 'dark' : 'light' },
        xaxis: { labels: { style: { colors: t.labelColor } } },
        yaxis: { labels: { style: { colors: t.labelColor } } },
        grid: { borderColor: t.gridColor },
        theme: { mode: isDark ? 'dark' : 'light' },
        legend: { labels: { colors: t.labelColor } },
        colors,
      }, false, true);
    }
  }

  new MutationObserver(updateAllCharts)
    .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!document.documentElement.classList.contains('dark')) updateAllCharts();
  });
</script>
<style>
  .chart { background-color: transparent; }

  .dark .apexcharts-tooltip,
  .dark .apexcharts-tooltip-title {
    background: #1c1917 !important; /* stone-900 */
    color: #f5f4f4 !important;      /* stone-50  */
    border-color: #292524 !important; /* stone-800 */
  }
</style>