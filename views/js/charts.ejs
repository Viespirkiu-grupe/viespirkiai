<script defer>
  let apexPromise;

  function loadApexCharts() {
    if (window.ApexCharts) return Promise.resolve(window.ApexCharts);
    if (apexPromise) return apexPromise; // already loading

    apexPromise = new Promise((resolve, reject) => {
      function startLoading() {
        const script = document.createElement('script');
        script.src = '/dist/apexcharts.js';
        script.defer = true;
        script.onload = () => resolve(window.ApexCharts);
        script.onerror = reject;
        document.body.appendChild(script);
      }

      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', startLoading);
      } else {
        startLoading();
      }
    });

    return apexPromise;
  }

  function deepMerge(target, source) {
    for (const key in source) {
      if (
        source[key] &&
        typeof source[key] === 'object' &&
        !Array.isArray(source[key])
      ) {
        if (!target[key]) target[key] = {};
        deepMerge(target[key], source[key]);
      } else {
        target[key] = source[key];
      }
    }
    return target;
  }

  const globalChartDefaults = {
    chart: {
      height: 400,
      toolbar: { show: false },
      zoom: {
        enabled: false
      },
      fontFamily: 'Ubuntu',
    },
    tooltip: {
      enabled: true
    },
    xaxis: {
      labels: {
        style: { colors: '#000' },
      },
    },
    yaxis: { labels: { style: { colors: '#000' }} },
    stroke: { curve: 'smooth', width: 2 },
    markers: { size: 5 },
    colors: ['#000'],
    grid: { borderColor: '#e0e0e0' },
    theme: {
        mode: 'light',
        monochrome: {
            enabled: false,
            color: '#000000',
            shadeTo: 'dark',
            shadeIntensity: 0.65
        },
    },
  }

  const typeChartDefaults = {
    'line-datetime': {
      chart: { type: 'line' },
      xaxis: {
            type: 'datetime',
            tickAmount: 6,
            labels: {
              format: 'yyyy-MM'
          },
      },
      tooltip: {
        x: {
          format: 'yyyy-MM'
        }
      },
    }
  }

  const chartFlagDefaults = {
    'yEUR': {
      yaxis: {
        min: 0,
        labels: {
            formatter: function (value) {
              if(typeof value == "number"){
                return value.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' });
              }else{
                return "Nėra duomenų";
              }
            }
         },
      },
      'yEURMen': {
        yaxis: {
          min: 0,
          labels: {
              formatter: function (value) {
                if(typeof value == "number"){
                  return value.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) + ' / men.';
                }else{
                  return "Nėra duomenų";
                }
              }
          },
        }
      },
    },
    'yMin0': {
        yaxis: { min: 0 }
      },
      'xYear': {
        xaxis: {
          labels: {
            format: 'yyyy'
          }
        },
        tooltip: {
          x: {
            format: 'yyyy'
          }
        }
      },
      'yMinAuto': {
        yaxis: {
          min: undefined
        }
      },
  }

  async function displayChart(data) {
    // let data = {
    //   element: document.querySelector('...'),
    //   type: 'line-datetime',
    //   labels: [...],
    //   series: [...],
    //   customOptions: { ... }, // Passed to ApexCharts
    //   noDefaults: false, // If true, no default options are applied
    //   flags: ['yEUR'], // Any flags to modify behavior
    // }

    if (!data || !data.element || !data.labels || !data.series) {
      console.error('Invalid data for displayChart:', data);
      return;
    }

    let customOptions = data?.customOptions || {};
    let noDefaults = data?.noDefaults || false;
    let flags = data?.flags || [];

    let mergedOptions = noDefaults ? {} : structuredClone(globalChartDefaults);

    if(data.series){
      // Check if series is a flat Array
      if(Array.isArray(data.series) && (data.series.length === 0 || !data.series[0]?.data)) {
          mergedOptions.series = [{ name: customOptions.seriesName || '', data: data.series }];
      }else{
          mergedOptions.series = data.series;
      }
    }

    if (!noDefaults && data.type && typeChartDefaults[data.type]) {
      mergedOptions = deepMerge(mergedOptions, typeChartDefaults[data.type]);
    }

    for (let flag of flags) {
      if (flag in chartFlagDefaults) {
        mergedOptions = deepMerge(mergedOptions, chartFlagDefaults[flag]);
      }
    }

    if(data.labels){
      mergedOptions.xaxis = mergedOptions.xaxis || {};
      mergedOptions.xaxis.categories = data.labels;
    }

    if(data.customOptions){
      mergedOptions = deepMerge(mergedOptions, customOptions);
    }

    await loadApexCharts();
    const chart = new ApexCharts(data.element, mergedOptions);
    chart.render();
  }
</script>
<style>
    .chart {
        background-color: #fff;
    }

    @media (prefers-color-scheme: dark) {
        .chart {
            filter: invert(1) hue-rotate(180deg);
        }

        .apexcharts-tooltip, .apexcharts-tooltip-title{
            background: rgba(255, 255, 255, 0.96) !important;
            color: #000 !important;
        }
    }
</style>
