<div>
  <% if (values.search == "" && usedHiddenFields == false) { %>
    <h2 class="mb-5">Naujausi sutarčių skelbimai</h2>
  <% } %>

  <div class="d-flex justify-between align-center mb-4">
    <span class="text-muted text-sm"><%- numberOfResults %></span>
    <% if (galimaEksportuoti) { %>
      <div class="d-flex gap-3">
        <a href="/?<%- queryParams %>&jsonl=true&limit=max" class="btn btn-ghost btn-sm">↗ JSONL</a>
        <a href="/?<%- queryParams %>&csv=true&limit=max" class="btn btn-ghost btn-sm">↗ CSV</a>
      </div>
    <% } %>
  </div>

  <% if (data.length === 0) { %>
    <div class="empty-state">
      <p class="text-muted">Rezultatų nerasta.</p>
    </div>
  <% } else { %>

    <div class="result-list">
      <% data.forEach(item => { %>
        <article class="result-card card-clickable" aria-label="<%= item.tipoPavadinimas %>">
          <a href="/sutartis/<%= item.sutartiesUnikalusId %>" class="card-overlay-link"><%= item.pavadinimas %></a>

          <div class="result-card-body">
            <dl class="result-card-meta">
              <div>
                <dt class="sr-only">Tipas</dt>
                <dd><%= item.tipas %></dd>
              </div>
              <div>
                <dt class="sr-only">Kategorija</dt>
                <dd><%= item.kategorija %></dd>
              </div>
              <div>
                <dt class="sr-only">Sutarties galiojimas</dt>
                <dd>
                  <abbr aria-hidden="true" title="Sutarties galiojimas">Sut.</abbr>
                  <% if (item.sudarymoData && item.galiojimoData) { %>
                    <% let d1 = new Date(item.sudarymoData).toISOString().slice(0,10); %>
                    <% let d2 = new Date(item.galiojimoData).toISOString().slice(0,10); %>
                    <time datetime="<%= d1 %>"><%= d1 %></time><% if (d1 != d2) { %> – <time datetime="<%= d2 %>"><%= d2 %></time><% } %>
                  <% } else { %>—<% } %>
                </dd>
              </div>
              <div>
                <dt class="sr-only">Redagavimo data</dt>
                <dd>
                  <abbr aria-hidden="true" title="Redagavimo data">Red.</abbr>
                  <% if (item.paskutinioRedagavimoData) { %>
                    <time datetime="<%= item.paskutinioRedagavimoData %>"><%= item.paskutinioRedagavimoData %></time>
                  <% } else { %>—<% } %>
                </dd>
              </div>
              <% if (item.dokumentuKiekis > 0) { %>
                <div>
                  <dt class="sr-only">Dokumentai</dt>
                  <dd><%= item.dokumentuKiekis %> <abbr aria-hidden="true" title="Dokumentai">dok.</abbr></dd>
                </div>
              <% } %>
            </dl>

            <h3 class="result-card-title">
              <% const verte = item.faktineIvykdimoVerte || item.verte; %>
              <span class="cell-mono<%= Number(verte) > 10000 ? ' fw-bold' : '' %>">
                <%= Number(verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
              </span>
              &nbsp;<% if (item.pavadinimas.length < 1) { %><em>Nenurodyta</em><% } else { %><%= item.pavadinimas %><% } %>
            </h3>

            <div class="result-card-footer">
              <span><strong>Pirkėjas:</strong> <a href="/asmuo/<%= item.perkanciosiosOrganizacijosKodas %>" style="position:relative;z-index:1;"><%= item.perkanciojiOrganizacija %></a></span>
              <% if (!item.papildomiTiekejai || item.papildomiTiekejai.length == 0) { %>
                <span><strong>Tiekėjas:</strong> <a href="/asmuo/<%= item.tiekejoKodas %>" style="position:relative;z-index:1;"><%= item.tiekejas || "Nenurodytas" %></a></span>
              <% } else { %>
                <span class="d-flex align-start gap-2">
                  <strong>Tiekėjai:</strong>
                  <span class="d-flex flex-col gap-2">
                    <a href="/asmuo/<%= item.tiekejoKodas %>" style="position:relative;z-index:1;"><%= item.tiekejas || "Nenurodytas" %></a>
                    <% for (let i = 0; i < item.papildomiTiekejai.length; i++) { %>
                      <a href="/asmuo/<%= item.papildomiTiekejaiKodai[i] %>" style="position:relative;z-index:1;"><%= item.papildomiTiekejai[i] || "Nenurodytas" %></a>
                    <% } %>
                  </span>
                </span>
              <% } %>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

    <%- include('pagination.ejs', { currentPage, pageCount, queryParams }) %>

  <% } %>
</div>
