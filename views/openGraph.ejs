<!DOCTYPE html>
<html>
    <head>
        <%- include('css'); %>
        <style>
            body{
                display: block;
                background:
                    repeating-conic-gradient(#ccc 0 25%, #0000 0 50%)
                      50% / 20px 20px;
            }
            .openGraph-card{
                height: 630px;
                width: 1200px;
                background-color: white;
                display: flex;
                flex-direction: column;
                padding: 48px;
                box-sizing: border-box;
                justify-content: space-between;
                color: black;
            }
            .bottom{
                display: flex;
                justify-content: space-between;
            }
            .tipas, .pavadinimas{
                margin-bottom: 18px;
            }
            .tipas{
                font-size: 32px;
            }
            .pavadinimas{
                font-size: 64px;
                font-weight: bold;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .aprasymas{
                font-size: 36px;
                line-height: 1.3;
            }
            .bottom{
                font-size: 32px;
            }
            .viespirkiai svg{
                margin-top: 0px !important;
                width: 10ch !important;
            }
            .viespirkiai{
                display: flex;
                align-content: center;
            }
        </style>
    </head>
    <body>
        <div class="openGraph-card">
            <div class="top">
                <div class="tipas">
                    <%= tipas %>
                </div>
                <div class="pavadinimas truncate-3">
                    <%- pavadinimas %>
                </div>
                <div class="aprasymas">
                    <%- aprasymas %>
                </div>
            </div>
            <div class="bottom">
                <div class="id">
                    <%= id %>
                </div>
                <div class="viespirkiai">
                    <%- include('viespirkiaiLogo.ejs') %>
                </div>
            </div>
        </div>
    </body>
</html>
