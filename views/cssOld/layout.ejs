<style>
    body, html{
       	margin: 0;
    	padding: 0;
    	overflow-x: hidden;
    }

    body{
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    header {
        text-align: center;
    }

    header .aside {
        display: flex;
        justify-content: right;
        flex-wrap: wrap;
        gap: 4px;
    	padding: 8px 8px;
    	margin-top: 8px;
    }

    header .aside a{
        margin-left: 8px;
    }


    main{
        flex-grow: 2;
    }

    footer {
    	margin-block: 32px;
    	min-height: 64px;
    	width: 100%;
    }

    footer div{
    	display: flex;
    	justify-content: center;
    	align-items: center;
     flex-wrap: wrap;
    }

    footer a{
    	display: inline-block;
    	margin: 0 8px;
    }

    .flex{
        display: flex;
    }

    @media (max-width: 600px) {
        .mobile-block{
            display: block;
        }
    }

    .flex-grow-1{
        flex-grow: 1;
    }

    .justify{
        text-align: justify;
    }

    .col-auto{
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .col-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }

    .col-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .col-2-flex {
      column-count: 2;
      column-gap: 1rem; /* space between columns */
    }

    .col-2-flex > * {
      break-inside: avoid; /* prevent item splitting */
      margin-bottom: 1rem;
    }

    .col-2-strict {
        --gap: 24px;
        display: grid;
        grid-template-columns: calc(50% - var(--gap)) calc(50% - var(--gap));
        gap: var(--gap);
    }


    .wide-3 {
      grid-column: span 3;
    }

    .desktop-hide {
        display: none;
    }

    .center{
        text-align: center;
    }

    @media (max-width: 768px) {
        .mobile-col-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
        }

        .mobile-col-1 {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
        }

        .mobile-col-1-strict {
            --gap: 8px;
            display: grid;
            grid-template-columns: calc(100% - 0.5 * var(--gap));
            gap: var(--gap);
        }

        .mobile-wide-2 {
          grid-column: span 2;
        }

        .mobile-hide {
            display: none;
        }

        .desktop-hide {
            display: unset;
        }
    }
</style>
