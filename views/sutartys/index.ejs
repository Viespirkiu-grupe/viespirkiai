<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
      pageTitle: "Sutarčių paieška",
      pageDescription: `Pilietinė viešųjų pirkimų analizės iniciatyva. Prieinamai patiekiamos viešųjų pirkimų sutartys bei kita susijusi informacija.`,
      pageImage: `https://viespirkiai.org/index.png`,
      customHead
  }) %>
  <% if (typeof analize != 'undefined' && analize) { %>
    <%- include('../js/charts.ejs') %>
  <% } %>
</head>
<body>
  <%- include('../header.ejs') %>
  <main>

    <%- include('search.ejs', { values, usedHiddenFields, numberOfResults }) %>

    <% if (typeof analize != 'undefined' && analize) { %>
      <%- include('analize.ejs') %>
    <% } %>

    <div class="mt-6 max-w-lg center mx-auto">
      <%- include('results.ejs') %>
    </div>

    <script>
      const span = document.querySelector('.rezultatai-nezinomas-total');
      if (span && !span.classList.contains('spin')) {
        span.classList.add('spin');
        const url = new URL(window.location.href);
        url.searchParams.set('rezultatuSkaiciausPatikslinimas', 'true');
        console.log(url)
        fetch(url)
          .then(res => res.json())
          .then(data => {
            if (data.total !== undefined) {
              span.className = '';
              document.querySelector('.numberOfResults').innerHTML = data.numberOfResults;
              document.querySelector('ul.pagination').innerHTML = data.pagination;
            } else {
              span.classList.remove('spin');
            }
          })
          .catch(() => span.classList.remove('spin'));
      }
    </script>

  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
