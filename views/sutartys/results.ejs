<div>
  <div class="flex justify-between items-center mb-4">
    <span class="text-muted text-sm"><em class="numberOfResults"><%- numberOfResults %></em></span>
    <% if (galimaEksportuoti) { %>
      <div class="flex gap-3">
        <a href="/?<%- queryParams %>&jsonl=true&limit=max" class="btn btn-outline btn-sm">↗ JSONL</a>
        <a href="/?<%- queryParams %>&csv=true&limit=max" class="btn btn-outline btn-sm">↗ CSV</a>
      </div>
    <% } %>
  </div>

  <% if (data.length === 0) { %>
    <div class="empty-state">
      <p class="text-muted">Rezultatų nerasta.</p>
    </div>
  <% } else { %>

    <div class="result-list">
      <% data.forEach(item => { %>
        <article class="result-card card-clickable">
          <div class="result-card-body">
            <dl class="result-card-meta">
              <div>
                <dt class="sr-only">Tipas</dt>
                <dd><%= item.tipas %></dd>
              </div>

              <div>
                <dt class="sr-only">Kategorija</dt>
                <dd><%= item.kategorija %></dd>
              </div>

              <div>
                <dt class="sr-only">Sutarties galiojimas</dt>
                <dd>
                  <abbr aria-hidden="true" title="Sutarties galiojimas" class="relative z-1">Sut.</abbr>
                  <% if (item.sudarymoData && item.galiojimoData) { %>
                    <% const d1 = String(item.sudarymoData).slice(0, 10); %>
                    <% const d2 = String(item.galiojimoData).slice(0, 10); %>
                    <time datetime="<%= d1 %>"><%= d1 %></time><% if (d1 !== d2) { %> – <time datetime="<%= d2 %>"><%= d2 %></time><% } %>
                  <% } else { %>—<% } %>
                </dd>
              </div>

              <% if (item.dokumentuKiekis > 0) { %>
                <div>
                  <dt class="sr-only">Dokumentai</dt>
                  <dd><%= item.dokumentuKiekis %> <abbr aria-hidden="true" title="Dokumentai" class="relative z-1">dok.</abbr></dd>
                </div>
              <% } %>
            </dl>

            <div class="flex align-baseline gap-3">
              <h3 class="result-card-title">
                <a href="/sutartis/<%= item.sutartiesUnikalusId %>">
                  <span class="amount<%= Number(item.faktineIvykdimoVerte || item.verte) > 10000 ? ' fw-bold' : '' %>">
                    <%= Number(item.faktineIvykdimoVerte || item.verte).toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>&nbsp;€
                  </span>
                    <% if (item.pavadinimas.length < 1) { %><em>Nenurodyta</em><% } else { %><%= item.pavadinimas %><% } %>
                </a>
              </h3>
            </div>

            <div class="result-card-footer">
              <span>
                <strong>Pirkėjas:</strong>
                <a href="/asmuo/<%= item.perkanciosiosOrganizacijosKodas %>" class="relative z-1">
                  <%= item.perkanciojiOrganizacija?.slice(0, 80) %><%= item.perkanciojiOrganizacija?.length > 80 ? '…' : '' %>
                </a>
              </span>

              <% if (item.tiekejai.length === 1) { %>
                <span>
                  <strong>Tiekėjas:</strong>
                  <a href="/asmuo/<%= item.tiekejaiKodai[0] %>" class="relative z-1">
                    <%= (item.tiekejai[0] || 'Nenurodytas').slice(0, 80) %><%= (item.tiekejai[0] || '').length > 80 ? '…' : '' %>
                  </a>
                </span>

              <% } else { %>

                <span class="flex align-start gap-2">
                  <strong>Tiekėjai:</strong>
                  <span class="flex flex-col gap-1">
                    <% for (let i = 0; i < item.tiekejai.length; i++) { %>
                      <a href="/asmuo/<%= item.tiekejaiKodai[i] %>" class="relative z-1">
                        <%= (item.tiekejai[i] || 'Nenurodytas').slice(0, 80) %><%= (item.tiekejai[i] || '').length > 80 ? '…' : '' %>
                      </a>
                    <% } %>
                  </span>
                </span>
              <% } %>
            </div>

            <div class="text-muted text-sm mt-4">
              <% if (item.paskutinioRedagavimoData) { %>
                <time datetime="<%= item.paskutinioRedagavimoData %>"><%= item.paskutinioRedagavimoData %></time>
              <% } else { %>—<% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <%- include('pagination.ejs', { currentPage, pageCount, queryParams }) %>

  <% } %>
</div>
