<div>
    <section class="preResultOptions">
        <div class="numberOfResults">
            <i>
            <%- numberOfResults %>
            </i>
        </div>

        <% if(galimaEksportuoti){ %>
            <div class="export-options">
                <a href="/?<%- queryParams %>&jsonl=true&limit=max" class="exportLink">↗ JSONL</a>&nbsp;
                <a href="/?<%- queryParams %>&csv=true&limit=max" class="exportLink">↗ CSV</a>
            </div>
        <% } %>
    </div>

<div class="resultsNauji">
    <% data.forEach(item => { %>
        <article class="rezultatas" aria-label="<%= item.tipoPavadinimas %>">
            <a href="/sutartis/<%= item.sutartiesUnikalusId %>" class="fullIndentLink"></a>
            <div class="rezultatas-left">
                <dl class="rezultatas-top">
                <div>
                    <dt class="visually-hidden">Tipas</dt>
                    <dd><%= item.tipas %></dd>
                </div>
                <div class="vertical-line-spacer"></div>
                <div>
                    <dt class="visually-hidden">Kategorija</dt>
                    <dd><%= item.kategorija %></dd>
                </div>
                <div class="vertical-line-spacer"></div>
                <div>
                    <dt class="visually-hidden">Sutarties galiojimas</dt>
                    <dd>
                    <abbr aria-hidden="true" title="Sutarties galiojimas">Sut.</abbr>
                    <% if(item.sudarymoData && item.galiojimoData) {  %>
                        <% let sudarymoData = new Date(item.sudarymoData).toISOString().slice(0,10); %>
                        <% let galiojimoData = new Date(item.galiojimoData).toISOString().slice(0,10); %>

                        <% if(sudarymoData == galiojimoData) { %>
                        <time datetime="<%= sudarymoData %>"><%= sudarymoData %></time>
                        <% } else { %>
                        <time datetime="<%= sudarymoData %>"><%= sudarymoData %></time> –
                        <time datetime="<%= galiojimoData %>"><%= galiojimoData %></time>
                        <% } %>
                    <% } else { %>
                        -
                    <% } %>
                    </dd>
                </div>

                <div>
                    <dt class="visually-hidden">Dokumentai</dt>
                    <dd>
                    <% if (item.dokumentuKiekis === 0) { %>
                        <span class="visually-hidden">Nėra</span>
                    <% } else { %>
                        <div class="vertical-line-spacer"></div>
                        <%= item.dokumentuKiekis %> <abbr aria-hidden="true" title="Dokumentai">dok.</abbr>
                    <% } %>
                    </dd>
                </div>
                </dl>
                <div style=""> <!-- display: flex; justify-content: space-between; align-items: flex-start; -->
                    <div class="rezultatas-right">
                        <div class="suma">
                            <%
                                const verte = item.faktineIvykdimoVerte || item.verte;
                                if(Number(verte) > 10000) {
                            %>
                                <u><%= Number(verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>&nbsp;€</u>
                            <% } else { %>
                                <%= Number(verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>&nbsp;€
                            <% } %>
                        </div>
                    </div>
                    <h3 class="rezultatas-title">
                        <a href="/sutartis/<%= item.sutartiesUnikalusId %>">
                            <span>
                                <% if(item.pavadinimas.length < 1) { %>
                                    <i>Nenurodyta</i>
                                <% } else { %>
                                    <%= item.pavadinimas %>
                                <% } %>
                            </span>
                        </a>
                    </h3>
                </div>
                <div class="rezultatas-bottom">
                    <div>
                        <b> Pirkėjas: </b>
                        <a href="/asmuo/<%= item.perkanciosiosOrganizacijosKodas %>"><%= item.perkanciojiOrganizacija %></a>
                    </div>
    				<% if(!item.papildomiTiekejai || item.papildomiTiekejai.length == 0) { %>
                        <div>
                            <b> Tiekėjas: </b>
                            <a href="/asmuo/<%= item.tiekejoKodas %>"><%= item.tiekejas || "Nenurodytas" %></a>
                        </div>
                    <% } else { %>
                        <div style="display:flex; align-items:flex-start;">
                            <b style="margin-right: 10px;">Tiekėjai:</b>
                            <div style="display:flex; flex-direction:column; gap: 8px;">
                                <a href="/asmuo/<%= item.tiekejoKodas %>" style="padding-block: 0;"><%= item.tiekejas || "Nenurodytas" %></a>

                                <% for (let i = 0; i < item.papildomiTiekejai.length; i++) { %>
                                    <a href="/asmuo/<%= item.papildomiTiekejaiKodai[i] %>" style="padding-block: 0;"><%= item.papildomiTiekejai[i] || "Nenurodytas" %></a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                    <div class="subtext">
                        <% if (item.paskutinioRedagavimoData) { %>
                            <time datetime="<%= item.paskutinioRedagavimoData %>"><%= item.paskutinioRedagavimoData %></time>
                        <% } else { %>
                            -
                        <% } %>
                    </div>
                </div>
            </div>
        </article>
    <% }); %>
</div>

<% if(data.length === 0) { %>
    <div class="no-results">
        <p>Rezultatų nerasta.</p>
    </div>
<% } else { %>
    <%- include('pagination.ejs', {
        currentPage, pageCount, queryParams
    }) %>
<% } %>
