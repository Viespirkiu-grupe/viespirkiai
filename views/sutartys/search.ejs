<form method="get" role="search" id="searchForm">
    <h1>Duomenų paieška</h1>
    <%- include('../tabs.ejs') %>

    <div class="center">
        <div class="searchField">
            <svg class="searchIcon" width="24" height="24" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
            </svg>
            <input type="search" name="search" id="search"
                value="<%= values.search || '' %>"
                placeholder="Tekstinė paieška"
                enterkeyhint="search"
                aria-label="Paieška"
            />
            <div class="vertical-line-spacer"></div>
            <label id="searchNustatymaiToggleButton" for="searchNustatymaiToggle" class="searchIcon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M11.9999 3C11.4476 3 10.9999 3.44772 10.9999 4V6.17072C9.83476 6.58259 9 7.6938 9 8.99998C9 10.3062 9.83476 11.4174 10.9999 11.8292L10.9999 20C10.9999 20.5523 11.4476 21 11.9999 21C12.5522 21 12.9999 20.5523 12.9999 20V11.8293C14.1651 11.4175 15 10.3062 15 8.99998C15 7.69373 14.1651 6.58246 12.9999 6.17066V4C12.9999 3.44772 12.5522 3 11.9999 3ZM12 7.99998C11.4477 7.99998 11 8.4477 11 8.99998C11 9.55227 11.4477 9.99998 12 9.99998C12.5523 9.99998 13 9.55227 13 8.99998C13 8.4477 12.5523 7.99998 12 7.99998Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M17.9999 20C17.9999 20.5523 18.4476 21 18.9999 21C19.5522 21 19.9999 20.5523 19.9999 20V17.8293C21.1651 17.4175 22 16.3062 22 15C22 13.6937 21.1651 12.5825 19.9999 12.1707V4C19.9999 3.44772 19.5522 3 18.9999 3C18.4476 3 17.9999 3.44772 17.9999 4V12.1707C16.8348 12.5826 16 13.6938 16 15C16 16.3062 16.8348 17.4174 17.9999 17.8292V20ZM19 14C18.4477 14 18 14.4477 18 15C18 15.5523 18.4477 16 19 16C19.5523 16 20 15.5523 20 15C20 14.4477 19.5523 14 19 14Z" fill="currentColor"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M3.9999 20C3.9999 20.5523 4.44762 21 4.9999 21C5.55219 21 5.9999 20.5523 5.9999 20V17.8293C7.16515 17.4175 8 16.3062 8 15C8 13.6937 7.16515 12.5825 5.9999 12.1707L5.9999 4C5.9999 3.44772 5.55219 3 4.9999 3C4.44762 3 3.9999 3.44772 3.9999 4L3.9999 12.1707C2.83476 12.5826 2 13.6938 2 15C2 16.3062 2.83476 17.4174 3.9999 17.8292L3.9999 20ZM5 14C4.44772 14 4 14.4477 4 15C4 15.5523 4.44772 16 5 16C5.55229 16 6 15.5523 6 15C6 14.4477 5.55229 14 5 14Z" fill="currentColor"/>
            </svg></label>
            <button type="submit" value="Ieškoti" class="main">Ieškoti</button>
        </div>
    </div>

    <input
        type="checkbox"
        id="searchNustatymaiToggle"
        hidden
        <% if (usedHiddenFields) { %>checked<% } %>
    >

        <div id="searchNustatymai" class="nustatymai">
            <div class="nustatymai-top">
                <div>
                    <div class="nustatymai-category">Dalyviai</div>
                    <%- include('../inputsNew/text', { label: 'Pirkėjo kodas', name: 'perkanciosiosOrganizacijosKodas', placeholder: 'Nenurodyta', values }) %>
                    <%- include('../inputsNew/text', { label: 'Tiekėjo kodas', name: 'tiekejoKodas', placeholder: 'Nenurodyta', values }) %>
                </div>
                <div>
                    <div class="nustatymai-category">Laikotarpis</div>
                    <%- include('../inputsNew/date', { label: 'Sudaryta nuo', name: 'sudarymoDataNuo', values }) %>
                    <%- include('../inputsNew/date', { label: 'Sudaryta iki', name: 'sudarymoDataIki', values }) %>
                </div>
                <div>
                    <div class="nustatymai-category">Vertė</div>
                    <%- include('../inputsNew/number', { label: 'Vertė nuo', name: 'verteNuo', placeholder: '0 €', values }) %>
                    <%- include('../inputsNew/number', { label: 'Vertė iki', name: 'verteIki', placeholder: '∞ €', values }) %>
                </div>
                <div>
                    <div class="nustatymai-category">Klasifikacija</div>
                    <divs>
                        <div class="inputContainer selectInputContainer">
                        <label for="bvpzPrefiksas" class="inputLabel selectInputLabel" style="display: flex; justify-content: space-between;">
                            <div>
                                BVPŽ prefiksas<sup>1</sup>
                            </div>
                            <div>
                                <a href="/bvpz" style="padding-block: 0px; font-size: 13px;">Žr. BVPŽ</a>
                            </div>
                        </label>
                        <select
                            name="bvpzPrefiksas"
                            id="bvpzPrefiksas"
                            value="<%= values["bvpzPrefiksas"] || "" %>"
                        >
                            <% let rastasPasirinkimas = false; %>
                            <% if(values["bvpzPrefiksas"] == "" || values["bvpzPrefiksas"] == "kitas") { %>
                                <% rastasPasirinkimas = true; %>
                                <option value="" selected>Visi / nurodytas žemiau</option>
                            <% } else { %>
                                <option value="">Visi / nurodytas žemiau</option>
                            <% } %>

                            <% if(values["bvpzPrefiksas"] == "48 72") { %>
                                <% rastasPasirinkimas = true; %>
                                <option value="48 72" selected>Informacinės technologijos</option>
                            <% } else { %>
                                <option value="48 72">Informacinės technologijos</option>
                            <% } %>

                            <% if(values["bvpzPrefiksas"] == "3360 3361 3362 3363 3364 3365 3366 3367 33690 33691") { %>
                                <% rastasPasirinkimas = true; %>
                                <option value="3360 3361 3362 3363 3364 3365 3366 3367 33690 33691" selected>Vaistai</option>
                            <% } else { %>
                                <option value="3360 3361 3362 3363 3364 3365 3366 3367 33690 33691">Vaistai</option>
                            <% } %>
                        </select>
                    </div>

                        <div style="display: flex; align-items: center; gap: 12px; margin-inline: 8px; margin-block: 22px;">
                            <hr style="flex: 1; border: none; border-bottom: 1px solid var(--light-gray); margin: 0;">
                            <i>arba</i>
                            <hr style="flex: 1; border: none; border-bottom: 1px solid var(--light-gray); margin: 0;">
                        </div>



                        <input type="text"
                            name="bvpzPrefiksasKitas"
                            id="bvpzPrefiksasKitas"
                            value="<%= values["bvpzPrefiksasKitas"] || "" %>"
                            placeholder="Nenurodyta"
                        />
                </div>
            </div>
            <div class="nustatymai-bottom">
                <hr class="nustatymai-divider" />

                <div class="nustatymai-row">
                    <div class="nustatymai-inputs">
                        <%- include('../inputsNew/number', { label: 'Unikalus ID', name: 'sutartiesUnikalusID', placeholder: 'Nenurodyta', values }) %>
                        <%- include('../inputsNew/text', { label: 'Sut. numeris', name: 'sutartiesNumeris', placeholder: 'Nenurodyta', values }) %>
                        <%- include('../inputsNew/text', { label: 'Pirkimo numeris', name: 'pirkimoNumeris', placeholder: 'Nenurodyta', values }) %>
                    </div>

                    <div class="nustatymai-toggles">
                        <%- include('../inputsNew/toggle', { name: 'tikSuDokumentais', label: "Tik su dokumentais", values }) %>
                        <%- include('../inputsNew/toggle', { name: 'ignoruotiSp', label: "Nerodyti pakeitimų (SP)", values }) %>
                    </div>
                </div>

                <div class="nustatymai-subtext">
                    <p class="subtext"><sup>1</sup> Veikia tik ne tekstinėse paieškose</p>
                </div>
            </div>
        </div>



    <script>
        document.getElementById('search').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault(); // prevent newline
            this.form.submit(); // submit manually
        }
        });
    </script>
</form>
