<!DOCTYPE html>
<html>
<head>
  <%- include('../head.ejs', {
      pageTitle: Number(sutartis.faktineIvykdimoVerte || sutartis.verte)
                  .toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                  + " € " + sutartis.pavadinimas,
      pageDescription: `Sutartis nr. ${sutartis.sutartiesNumeris}
Sudaryta: ${new String(sutartis.sudarymoData).slice(0,10)}
Galioja iki: ${new String(sutartis.galiojimoData).slice(0,10)}`,
      pageImage: `https://viespirkiai.org/sutartis/${sutartis.sutartiesUnikalusID}.png`,
      pageAuthor: sutartis.perkanciojiOrganizacija,
      customHead
  }) %>
</head>
<body>
  <%- include('../header.ejs') %>
  <main>

    <div class="page-header">
      <div>
        <p class="subtext"><%= sutartis.tipoPavadinimas %></p>

        <h1>
          <% if (sutartis.pavadinimas.length < 1) { %>
            <em>Nenurodyta</em>
          <% } else { %>
            <%= sutartis.pavadinimas %>
          <% } %>
          už <span class="amount"><%= Number(sutartis.faktineIvykdimoVerte || sutartis.verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>&nbsp;€</span>
        </h1>
      </div>

      <div class="flex gap-3 align-center">
        <a href="/sutartis/<%= sutartis.sutartiesUnikalusID %>.json" class="btn btn-outline btn-sm">↗ JSON</a>
        <a href="https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=<%= sutartis.sutartiesUnikalusID %>" class="btn btn-outline btn-sm">↗ CVP IS</a>
        <a href="mailto:pranesti@viespirkiai.org?subject=Dėl sutarties%20nr.%20<%= sutartis.sutartiesUnikalusID %>&body=Čia paaiškinkite, kodėl norėjote informuoti apie sutartį%0D%0A%0D%0Ahttps://viespirkiai.org/pirkimas/<%= sutartis.sutartiesUnikalusID %>" class="btn btn-outline btn-sm">↗ Pranešti</a>
      </div>
    </div>


    <!-- Pirkėjas / Tiekėjas -->
    <div class="mb-6">

    <div class="grid-3">
      <section>
        <h2>Pirkėjas</h2>
        <h3><a href="/asmuo/<%= sutartis.perkanciosiosOrganizacijosKodas %>"><%= sutartis.perkanciojiOrganizacija %></a></h3>
        <span class="text-muted"><%= sutartis.perkanciosiosOrganizacijosKodas %></span>
      </section>

      <section>
        <% if (!sutartis.papildomiTiekejai || sutartis.papildomiTiekejai.length == 0) { %>
          <h2>Tiekėjas</h2>
          <% if (sutartis.tiekejasPatikslinimas && sutartis.tiekejasPatikslinimas != sutartis.tiekejas) { %>
            <p class="text-muted text-sm mb-1"><%= sutartis.tiekejasPatikslinimas %></p>
          <% } %>
          <h3><a href="/asmuo/<%= sutartis.tiekejoKodas %>"><%= sutartis.tiekejas %></a></h3>
          <% if (sutartis.tiekejasSalis) { %>
            <p class="text-muted text-sm"><%= sutartis.tiekejasSalis %></p>
          <% } %>
          <span class="text-muted"><%= sutartis.tiekejoKodas %></span>
        <% } else { %>
          <h2>Tiekėjai</h2>
          <div class="mb-3">
            <h3><a href="/asmuo/<%= sutartis.tiekejoKodas %>"><%= sutartis.tiekejas %></a></h3>
            <span class="text-muted"><%= sutartis.tiekejoKodas %></span>
          </div>
          <% for (let i = 0; i < sutartis.papildomiTiekejai.length; i++) { %>
            <div class="mt-3">
              <h3><a href="/asmuo/<%= sutartis.papildomiTiekejaiKodai[i] %>"><%= sutartis.papildomiTiekejai[i] %></a></h3>
              <span class="text-muted"><%= sutartis.papildomiTiekejaiKodai[i] %></span>
            </div>
          <% } %>
        <% } %>
      </section>
    </div>

      <div class="mt-4">
        <a href="/?tiekejoKodas=<%= sutartis.tiekejoKodas %>&perkanciosiosOrganizacijosKodas=<%= sutartis.perkanciosiosOrganizacijosKodas %>" class="btn btn-outline btn-sm">↗ Tarpusavio sutartys</a>
      </div>

    </div>


    <!-- Sutartis / Pranešimas / Klasifikacija / Dokumentai -->
    <div class="grid-3 mb-7">

      <section>
        <h2>Sutartis</h2>
        <span class="text-muted mb-4 block"><%= sutartis.sutartiesNumeris %></span>

        <h3 class="mb-2">Vertė</h3>
        <dl class="kv-list mb-4">
          <dt>Numatyta</dt>
          <dd class="cell-mono"><%= sutartis.verte.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</dd>
          <dt>Faktinė</dt>
          <dd class="cell-mono"><%= sutartis.faktineIvykdimoVerte ? sutartis.faktineIvykdimoVerte.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + " €" : "Nenurodyta" %></dd>
        </dl>

        <h3 class="mb-2">Terminai</h3>
        <dl class="kv-list">
          <dt>Sudaryta</dt>
          <dd><%= new String(sutartis.sudarymoData).slice(0,10) %></dd>
          <dt>Galioja iki</dt>
          <dd><%= new String(sutartis.galiojimoData).slice(0,10) %></dd>
          <dt>Faktinė įvykdymo data</dt>
          <dd><%= sutartis.faktineIvykdimoData || "Nenurodyta" %></dd>
        </dl>
      </section>

      <section>
        <h2>Pranešimas</h2>
        <div class="flex align-center gap-2 mb-4">
          <span class="text-muted"><%= sutartis.sutartiesUnikalusID %></span>
          <a href="https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=<%= sutartis.sutartiesUnikalusID %>" class="text-sm">↗ CVP IS</a>
        </div>

        <dl class="kv-list mb-4">
          <dt>Paskelbta</dt>
          <dd><%= sutartis.paskelbimoData %></dd>
          <dt>Redaguota</dt>
          <dd><%= sutartis.paskutinioRedagavimoData %></dd>
          <dt>Pirkimo numeris</dt>
          <dd>
            <% if (sutartis.cvpisPirkimas) { %>
              <% if (sutartis.cvpisPirkimas.type == 'Pmc') { %>
                <a href="/viesiejiPirkimai/<%= sutartis.cvpisPirkimas.pirkimoId %>"><%= sutartis.pirkimoNumeris %></a>
              <% } else if (sutartis.cvpisPirkimas.type == 'CfTWS') { %>
                <a href="/viesiejiPirkimai/<%= sutartis.cvpisPirkimas.pirkimoId %>"><%= sutartis.pirkimoNumeris %></a>
              <% } else if (sutartis.cvpisPirkimas.type == 'CfTDPSWS') { %>
                <a href="/viesiejiPirkimai/<%= sutartis.cvpisPirkimas.pirkimoId %>"><%= sutartis.pirkimoNumeris %></a>
              <% } %>
            <% } else if (sutartis.cvppPirkimas) { %>
              <a href="<%= sutartis.cvppPirkimas.link %>"><%= sutartis.pirkimoNumeris %></a>
            <% } else { %>
              <%= sutartis.pirkimoNumeris || "Nenurodytas" %>
            <% } %>
          </dd>
        </dl>

        <% if (sutartis.cvpisPirkimas) { %>
            <section>
                <br>
                <h2>Viešasis pirkimas</h2>
                <div class="flex align-center gap-2 mb-4">
                <a href="/viesiejiPirkimai/<%= sutartis.cvpisPirkimas.pirkimoId %>">
                    <span><%= sutartis.cvpisPirkimas.pavadinimas %></span>
                </a>
                </div>
                <dl class="kv-list">
                <% if (sutartis.cvpisPirkimas.pasiulymuPateikimoTerminas) { %>
                  <dt>Pasiūlymų pateikimo terminas</dt>
                  <dd><%= new String(sutartis.cvpisPirkimas.pasiulymuPateikimoTerminas).slice(0,10) %></dd>
                <% } %>
                <% if (sutartis.cvpisPirkimas.numatomaVerteEUR && Number(sutartis.cvpisPirkimas.numatomaVerteEUR) > 0) { %>
                  <dt>Numatoma vertė</dt>
                  <dd class="cell-mono"><%= Number(sutartis.cvpisPirkimas.numatomaVerteEUR).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</dd>
                <% } %>
                </dl>
                <% if (sutartis.cvpisPirkimas.informacija) { %>
                <p class="text-muted text-sm"><%= sutartis.cvpisPirkimas.informacija %></p>
                <% } %>
            </section>
        <% } %>
      </section>

      <section>
        <h2>Klasifikacija</h2>
        <dl class="kv-list mb-4">
          <dt>Kategorija</dt>
          <dd><%= sutartis.kategorija %></dd>
          <dt>Tipas</dt>
          <dd><%= sutartis.tipas %> <span class="text-muted">(<em><%= sutartis.tipoPavadinimas %></em>)</span></dd>
        </dl>

        <h3 class="mb-2">BVPŽ</h3>
        <div class="mb-2">
          <div class="fw-medium"><%= sutartis.bvpzPavadinimas %></div>
          <span class="text-muted"><%= sutartis.bvpzKodas %></span>
        </div>
        <% if (sutartis.papildomiBvpzKodai && sutartis.papildomiBvpzKodai.length > 0) { %>
          <% for (let i = 0; i < sutartis.papildomiBvpzKodai.length; i++) { %>
            <div class="mb-2">
              <div class="fw-medium"><%= sutartis.papildomiBvpzPavadinimai[i] %></div>
              <span class="text-muted"><%= sutartis.papildomiBvpzKodai[i] %></span>
            </div>
          <% } %>
        <% } %>
        <a href="/bvpz" class="text-sm">↗ BVPŽ kodai</a>
      </section>

      <section class="span-full">
        <h2>Dokumentai</h2>
        <% if (sutartis.dokumentai && sutartis.dokumentai.length > 0) { %>
          <div class="flex flex-col gap-2">
            <% sutartis.dokumentai.forEach(doc => { %>
              <%
                const title = doc.pavadinimas || "—";
                const ext = (doc.extension || (title.includes('.') ? title.split('.').pop() : '') || '').toLowerCase();
                const meta = ext ? `${ext.toUpperCase()}` : '';
                let href = '';
                let actions = [];
              %>

              <% if (doc.id && doc.parsiustas && doc.nuskaitytas) { %>
                <% href = `/failas/${doc.id}`; %>
                <%
                  actions = [
                    { href: `https://failai.viespirkiai.org/${doc.id}`, text: '↗ Failas', target: '_blank', rel: 'noopener noreferrer' },
                    { href: doc.url, text: '↗ CVP IS', target: '_blank', rel: 'noopener noreferrer' },
                  ];
                %>

              <% } else if (doc.parsiustas && doc.nuskaitytas) { %>
                <% href = `/failas/${doc.dok_id}/${doc.file_id}`; %>
                <%
                  actions = [
                    { href: `https://failai.viespirkiai.org/${doc.dok_id}/${doc.file_id}`, text: '↗ Failas', target: '_blank', rel: 'noopener noreferrer' },
                    { href: doc.url, text: '↗ CVP IS', target: '_blank', rel: 'noopener noreferrer' },
                  ];
                %>

              <% } else { %>
                <% href = doc.proxyUrl; %>
                <%
                  actions = [
                    { href: doc.proxyUrl, text: '↗ Failas', target: '_blank', rel: 'noopener noreferrer' },
                    { href: doc.url, text: '↗ CVP IS', target: '_blank', rel: 'noopener noreferrer' },
                  ];
                %>
              <% } %>

              <div style="min-width:0;">
                <%- include('../partials/file-card.ejs', { title, href, meta, ext, iconLabel: true, actions }) %>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted">Pateiktų dokumentų nėra.</p>
        <% } %>
      </section>

    </div>


    <!-- ES projektai / SABIS / Panašios sutartys -->
    <div class="grid-2">

        <% if (sutartis.cpvaProjektuSutartys && sutartis.cpvaProjektuSutartys.length > 0) { %>
          <section>
            <h2>Europos sąjungos projektai</h2>
            <% if (sutartis.cpvaProjektuSutartys.length > 3 && !req.query.cpvaAll) { %>
                <p class="text-muted mt-4">
                  Yra daug (<strong><%= sutartis.cpvaProjektuSutartys.length %></strong>) CPVA projektų su šiuo pirkimo numeriu — tikėtina, kad ryšys netiesioginis (DPS / CPO katalogas).
                </p>
              <div class="mt-2">
                <a href="?cpvaAll=true" class="btn btn-sm btn-secondary">Rodyti</a>
              </div>
            <% } else { %>
              <div class="result-list mt-4">
                <% sutartis.cpvaProjektuSutartys.forEach(projektoSutartis => { %>
                  <article class="result-card">
                    <div class="result-card-body">
                      <div class="result-card-meta">
                        <span><%= projektoSutartis.projektoNr || "" %></span>
                        <% if (projektoSutartis?.projektas) { %>
                          <span><%= projektoSutartis?.projektas?.projektoVeikluPradziosData || "" %> — <%= projektoSutartis?.projektas?.projektoVeikluPabaigosData || "" %></span>
                        <% } %>
                      </div>
                      <h3 class="result-card-title">
                        <a href="https://2021.esinvesticijos.lt/projektu-sritis/projektu-sarasas?query=<%= projektoSutartis.projektoNr %>">
                          <%= projektoSutartis?.projektas?.projektoPavadinimas || projektoSutartis.pirkimoObjektas || "" %>
                        </a>
                      </h3>
                    </div>
                    <% if (projektoSutartis.projektas) { %>
                      <div class="result-card-sidebar">
                        <% if (projektoSutartis.projektas.projektoVykdytojas) { %>
                          <span class="text-sm"><a href="/asmuo/<%= projektoSutartis.projektas.projektoVykdytojoKodas %>"><%= projektoSutartis.projektas.projektoVykdytojas %></a></span>
                        <% } %>
                        <% if (projektoSutartis.projektas.isViso) { %>
                          <span class="amount amount-sm"><%= Number(projektoSutartis.projektas.isViso).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</span>
                        <% } %>
                      </div>
                    <% } %>
                  </article>
                <% }); %>
              </div>
            <% } %>
          </section>
        <% } %>


      <section>
        <h2>SABIS sutartys <sup>BETA</sup></h2>
        <% if (sutartis.sabisSutartys && sutartis.sabisSutartys.length > 0) { %>
          <div class="result-list mt-4">
            <% sutartis.sabisSutartys.forEach(item => { %>
              <article class="result-card">
                <div class="result-card-body">
                  <div class="result-card-meta">
                    <span><%= item.tipas %></span>
                    <span><%= item.sutartiesNumeris %></span>
                    <span>
                      <% if (item.sutartiesPasirasymoData && item.sutartiesGaliojimoData) { %>
                        <% let d1 = new String(item.sutartiesPasirasymoData).slice(0,10); %>
                        <% let d2 = new String(item.sutartiesGaliojimoData).slice(0,10); %>
                        Sut. <%= d1 %><%= d1 != d2 ? ' — ' + d2 : '' %>
                      <% } else { %>—<% } %>
                    </span>
                  </div>
                  <h3 class="result-card-title">
                    <% const sabisVerte = item.suma; %>
                    <span class="amount-sm <%= Number(sabisVerte) > 10000 ? 'fw-bold' : '' %>">
                      <%= Number(sabisVerte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
                    </span>
                    &nbsp;<%= item.pavadinimas.length < 1 ? '<em>Nenurodyta</em>' : item.pavadinimas %>
                  </h3>
                  <div class="flex flex-wrap gap-2 mt-2">
                    <% item.salys.forEach(salis => { %>
                      <span class="text-sm"><strong><%= salis.tipas %></strong> <%= salis.validusJarKodas || salis.validusAsmensKodas || salis.kitasKodas || salis.pavadinimas %></span>
                    <% }); %>
                  </div>
                  <% if (item.saskaitos && item.saskaitos.length > 0) { %>
                    <div class="mt-3">
                      <p class="section-title mb-2">Sąskaitos</p>
                      <% item.saskaitos.forEach(saskaita => { %>
                        <div class="kv-list mb-2">
                          <dt><%= saskaita.sfTipas %> Nr. <%= saskaita.sfNumeris %></dt>
                          <dd>
                            <% if (saskaita.valiuta == "Euras" || saskaita.valiuta == "EUR") { saskaita.valiuta = "€" } %>
                            <span class="cell-mono"><%= Number(saskaita.bendraSfSuma).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> <%= saskaita.valiuta %></span>
                            <span class="text-muted text-sm">(su <%= saskaita.pvm %> PVM)</span><br>
                            <span class="subtext"><%= saskaita.sfBusena %> (<%= saskaita.sfBusenoData %>)</span>
                          </dd>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted mt-4"><em>Panašių sutarčių nerasta.</em></p>
        <% } %>
      </section>


      <section>
        <h2>Panašios sutartys</h2>
        <% if (sutartis.panasiosSutartys && sutartis.panasiosSutartys.length > 0) { %>
          <div class="result-list mt-4">
            <% sutartis.panasiosSutartys.forEach(item => { %>
              <article class="result-card card-clickable">
                <a href="/sutartis/<%= item.sutartiesUnikalusId %>" class="card-overlay-link"><%= item.pavadinimas %></a>
                <div class="result-card-body">
                  <div class="result-card-meta">
                    <span><%= item.tipas %></span>
                    <span><%= item.kategorija %></span>
                    <span>
                      <% if (item.sudarymoData && item.galiojimoData) { %>
                        <% let d1 = new String(item.sudarymoData).slice(0,10); %>
                        <% let d2 = new String(item.galiojimoData).slice(0,10); %>
                        Sut. <%= d1 %><%= d1 != d2 ? ' — ' + d2 : '' %>
                      <% } else { %>—<% } %>
                    </span>
                    <% if (item.dokumentuKiekis > 0) { %>
                      <span><%= item.dokumentuKiekis %> dok.</span>
                    <% } %>
                  </div>
                  <h3 class="result-card-title">
                    <% const verte = item.faktineIvykdimoVerte || item.verte; %>
                    <span class="cell-mono <%= Number(verte) > 10000 ? 'fw-bold' : '' %>">
                      <%= Number(verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
                    </span>
                    &nbsp;<%= item.pavadinimas.length < 1 ? '<em>Nenurodyta</em>' : item.pavadinimas %>
                  </h3>
                  <div class="flex gap-3 mt-2 text-sm">
                    <span><strong>Pirkėjas:</strong> <a href="/asmuo/<%= item.perkanciosiosOrganizacijosKodas %>" style="position:relative;z-index:1;"><%= item.perkanciojiOrganizacija %></a></span>
                    <span><strong>Tiekėjas:</strong> <a href="/asmuo/<%= item.tiekejoKodas %>" style="position:relative;z-index:1;"><%= item.tiekejas || "Nenurodytas" %></a></span>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted mt-4"><em>Panašių sutarčių nerasta.</em></p>
        <% } %>
      </section>

    </div>

  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
