<style>
/* ── Cards ── */

.bvpzList details {
    --indent-by: 36px;
    background: var(--shade-1);
    box-shadow: 2px 2px 6px var(--shade-7);
    padding: 10px 0;
    margin: 1px 0;
}

@media (prefers-color-scheme: dark) {
    .bvpzList details { box-shadow: none; }
}

.bvpzList details.no-children {
    padding-left: 52px;
    padding-bottom: 0;
}

.bvpzList details[open]:not(.no-children) {
    padding-bottom: 0;
}


/* ── Summary ── */

.bvpzList summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    font-weight: 500;
    padding: 8px;
}

.bvpzList summary::-webkit-details-marker { display: none; }

.bvpzList details[open] > summary,
.bvpzList details.no-children > summary {
    padding-bottom: 16px;
}

.bvpzList label {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
}


/* ── Toggle icon ── */

.bvpzList .toggle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-inline: 16px;
    font-weight: bold;
    transition: transform 0.2s;
}

.bvpzList details[open] > summary > .toggle-icon {
    transform: rotate(90deg);
}


/* ── Checkbox ── */

.bvpzList input[type="checkbox"] {
    appearance: none;
    position: relative;
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
    margin-right: 8px;
    border: 2px solid var(--black);
    border-radius: 2px;
    background-color: var(--white);
    cursor: pointer;
    transition: background-color 0.2s ease-in-out;
}

.bvpzList input[type="checkbox"]:checked {
    background-color: var(--black);
}

.bvpzList input[type="checkbox"]:checked::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 6px;
    width: 3px;
    height: 7px;
    border: solid var(--white);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}


/* ── Depth shading ── */

.bvpzList details details                                           { background: var(--shade-2); }
.bvpzList details details details                                   { background: var(--shade-3); }
.bvpzList details details details details                           { background: var(--shade-4); }
.bvpzList details details details details details                   { background: var(--shade-5); }
.bvpzList details details details details details details           { background: var(--shade-6); }
.bvpzList details details details details details details details   { background: var(--shade-7); }


/* ── Depth indentation ── */

.bvpzList details details summary                                                           { padding-left: calc(var(--indent-by) * 1); }
.bvpzList details details details summary                                                   { padding-left: calc(var(--indent-by) * 2); }
.bvpzList details details details details summary                                           { padding-left: calc(var(--indent-by) * 3); }
.bvpzList details details details details details summary                                   { padding-left: calc(var(--indent-by) * 4); }
.bvpzList details details details details details details summary                           { padding-left: calc(var(--indent-by) * 5); }
.bvpzList details details details details details details details summary                   { padding-left: calc(var(--indent-by) * 6); }
.bvpzList details details details details details details details details summary           { padding-left: calc(var(--indent-by) * 7); }


/* ── Output bar ── */

.bvpzList #output {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 72px;
    padding: 12px;
    box-sizing: border-box;
    background: var(--white);
    border-top: 1px solid var(--black);
}

.bvpzList #output .left {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.bvpzList #pasirinkti-kodai {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.bvpzList #output .right {
    flex-shrink: 0;
    display: flex;
    gap: 8px;
}


/* ── Loading spinner ── */

.bvpzList #tree.loading {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: min(400px, 60vh);
    background: none;
}

.bvpzList #tree.loading .spinner {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    animation: spin 1s linear infinite;
}

.bvpzList #tree.loading .spinner svg {
    display: block;
    width: 100%;
    height: 100%;
}
</style>
