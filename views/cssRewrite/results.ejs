}

@media (max-width: 600px) {
    .results .resultsNauji {
        border: none;
    }

    .results .resultsNauji .rezultatas {
        padding-inline: 0;
    }

    .results .resultsNauji .rezultatas:hover,
    .results .resultsNauji .rezultatas:focus,
    .results .resultsNauji .rezultatas:active {
        box-shadow: none;
    }
}


/* ── Result item ── */

.rezultatas {
    position: relative;
    padding-bottom: 24px;
}

.rezultatas-top {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 4px;
    font-size: 14px;
    color: var(--gray);
}

.rezultatas-top a { color: var(--gray); }

.rezultatas-top span {
    display: inline-block;
    padding-right: 8px;
    padding-block: 2px;
}

.rezultatas-title {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 0;
    margin-bottom: 6px;
    font-size: 24px;
    font-weight: bold;
}

.rezultatas-title a {
    color: var(--black);
    text-decoration: none;
}

.rezultatas-title a:hover { text-decoration: underline; }

.rezultatas-bottom {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 4px;
    color: var(--dark-gray);
}

.rezultatas-bottom a {
    color: var(--gray);
    text-decoration: none;
}

.rezultatas-bottom a:hover { text-decoration: underline; }

.resultsNauji .rezultatas-left {
    flex: 1 1 auto;
    min-width: 0;
}

.resultsNauji .rezultatas-right {
    float: right;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    margin-top: 12px;
    margin-left: 12px;
    padding: 8px 8px 8px 12px;
    border-left: 1px solid var(--light-gray);
}

.resultsNauji .rezultatas-right .suma {
