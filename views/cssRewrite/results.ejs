section.preResultOptions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    max-width: 1200px;
    margin-inline: auto;
}

@media (max-width: 768px) {
    section.preResultOptions {
        flex-direction: column;
        align-items: flex-start;
    }
}

.main-center {
    max-width: 1200px;
}

@media (min-width: 1000px) {
    .results,
    .main-center {
        margin-inline: 7%;
    }
}


/* ── Results container ── */

.results {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-inline: 8px;
    margin-top: 24px;
}

.results h1 {
    margin-bottom: 0;
    text-decoration: underline;
}

.results-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}

@media (max-width: 768px) {
    .results-header {
        flex-direction: column;
        align-items: flex-start;
    }
}

.results-header .export-options a {
    display: inline-block;
    margin-left: 4px;
}

.no-results {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    height: 20vh;
}


/* ── resultsNauji card list ── */

.resultsNauji {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    border: 1px solid var(--light-gray);
    border-radius: 8px;
}

.resultsNauji .rezultatas:first-child { border-radius: 8px 8px 0 0; }
.resultsNauji .rezultatas:last-child  { border-radius: 0 0 8px 8px; }

.resultsNauji .rezultatas {
    display: flex;
    align-items: flex-start;
    padding: 28px;
    transition: box-shadow 0.2s ease-in-out;
}

.resultsNauji .rezultatas:hover {
