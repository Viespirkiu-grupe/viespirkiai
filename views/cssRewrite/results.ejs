    font-family: monospace;
}

.resultsNauji .rezultatas-right .sumosTipas {
    font-size: smaller;
    color: var(--gray);
}

.resultsNauji .subtext {
    font-size: 14px;
    color: var(--gray);
}

.excerpt { color: var(--gray); }

.vertical-line-spacer {
    width: 1px;
    background-color: var(--light-gray);
}


/* ── Full-area overlay link ── */

.fullIndentLink {
    position: absolute;
    inset: 0;
    z-index: 0;
    text-indent: -9999px;
}

.rezultatas a:not(.fullIndentLink),
.rezultatas span,
.rezultatas u,
.rezultatas abbr {
    position: relative;
    z-index: 1;
}


/* ── Spinner ── */

.rezultatai-nezinomas-total {
    display: inline-flex;
    justify-content: center;
    min-width: 16px;
}

.rezultatai-nezinomas-total.spin {
    animation: spin 0.5s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}
