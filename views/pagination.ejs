<%
const totalPages = Number(pageCount);
const current = Number(currentPage);
const maxVisible = 6;
const half = Math.floor(maxVisible / 2);
let start = Math.max(1, current - half);
let end = Math.min(totalPages, current + half);

if (current <= half) {
    end = Math.min(totalPages, maxVisible);
}
if (current + half > totalPages) {
    start = Math.max(1, totalPages - maxVisible + 1);
}

function pageLink(page) {
    return `?page=${page}`;
}
%>

<nav aria-label="Puslapiavimas" class="mt-8">
  <ul class="pagination">
    <% if (current > 1) { %>
      <li>
        <a href="<%= pageLink(current - 1) + queryParams %>" aria-label="Ankstesnis puslapis">
          <span aria-hidden="true">←</span>
        </a>
      </li>
    <% } else { %>
      <li class="disabled">
        <span aria-hidden="true">←</span>
      </li>
    <% } %>

    <% for (let i = start; i <= end; i++) { %>
      <li <%- i === current ? 'class="active"' : '' %>>
        <a
          href="<%= pageLink(i) + queryParams %>"
          aria-label="Puslapis <%= i %>"
          <%- i === current ? 'aria-current="page"' : '' %>
        >
          <%= i %>
        </a>
      </li>
    <% } %>

    <% if (current < totalPages) { %>
      <li>
        <a href="<%= pageLink(current + 1) + queryParams %>" aria-label="Kitas puslapis">
          <span aria-hidden="true">→</span>
        </a>
      </li>
    <% } else { %>
      <li class="disabled">
        <span aria-hidden="true">→</span>
      </li>
    <% } %>
  </ul>
</nav>