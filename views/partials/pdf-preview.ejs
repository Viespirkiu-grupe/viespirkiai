<%
/**
 * PDF preview iframe partial (pdf.js viewer)
 *
 * Purpose:
 * - Centralize the PDF preview iframe usage (currently hardcoded in failas.ejs)
 *
 * Expected locals:
 * - failasId: string|number  (required)
 *
 * Optional locals:
 * - search: string          (default: "")
 * - height: string          (default: "70vh")  // any CSS height value
 * - rounded: boolean        (default: true)
 * - border: string          (default: "none")  // e.g. "none" or "var(--border)"
 * - className: string       (default: "")
 *
 * Notes:
 * - Matches existing behavior in `views/failai/failas.ejs`:
 *   /dist/pdfjs/web/viewer.html?file=/failas/:id/preview#search=...
 */
const __failasId = (typeof failasId !== 'undefined' && failasId !== null) ? String(failasId) : '';
const __search = (typeof search !== 'undefined' && search) ? String(search) : '';
const __height = (typeof height !== 'undefined' && height) ? String(height) : '70vh';
const __rounded = (typeof rounded !== 'undefined') ? !!rounded : true;
const __border = (typeof border !== 'undefined' && border !== null) ? String(border) : 'none';
const __className = (typeof className !== 'undefined' && className) ? String(className) : '';

if (!__failasId) {
%>
  <div class="text-muted text-sm"><em>Nepavyko atvaizduoti PDF peržiūros (trūksta <code>failasId</code>).</em></div>
<%
} else {
  const __fileUrl = `/failas/${__failasId}/preview`;
  const __viewerSrc =
    `/dist/pdfjs/web/viewer.html?file=${encodeURIComponent(__fileUrl)}` +
    `#search=${encodeURIComponent(__search)}`;

  const __style =
    `border:${__border};` +
    ` width:100%;` +
    ` height:${__height};` +
    ` display:block;` +
    (__rounded ? ` border-radius:var(--radius-md);` : ``);
%>
  <iframe
    class="<%= __className %>"
    src="<%= __viewerSrc %>"
    style="<%= __style %>"
  ></iframe>
<%
}
%>
