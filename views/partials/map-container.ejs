<%
/**
 * Generic map container partial (Leaflet-friendly).
 *
 * Purpose:
 * - Provide a consistent, reusable container element for maps across pages.
 * - Keep sizing/styling decisions in one place (without forcing any JS init).
 *
 * Expected locals:
 * - id: string (required)        // DOM id for the map container
 *
 * Optional locals:
 * - className: string            // defaults to "map-container"
 * - height: string               // defaults to "220px" (any CSS height value: px, vh, etc.)
 * - style: string                // extra inline styles appended to the computed height
 * - attrs: object                // extra HTML attributes (key/value). Use for data-* attrs, aria, etc.
 *
 * Example:
 *   <%- include('../partials/map-container.ejs', {
 *     id: 'asmuo-map',
 *     height: '280px',
 *     style: 'border-radius:var(--radius-md);',
 *     attrs: { 'data-x': 25.2, 'data-y': 54.7 }
 *   }) %>
 */

const __id = (typeof id !== 'undefined' && id) ? String(id) : '';
const __className = (typeof className !== 'undefined' && className) ? String(className) : 'map-container';
const __height = (typeof height !== 'undefined' && height) ? String(height) : '220px';
const __styleExtra = (typeof style !== 'undefined' && style) ? String(style) : '';
const __attrs = (typeof attrs !== 'undefined' && attrs && typeof attrs === 'object') ? attrs : null;

function __escapeAttr(v) {
  return String(v)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function __renderAttrs(obj) {
  if (!obj) return '';
  let out = '';
  for (const k in obj) {
    if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;
    if (obj[k] === false || obj[k] === null || typeof obj[k] === 'undefined') continue;
    const key = String(k);
    const val = obj[k] === true ? key : obj[k];
    out += ` ${__escapeAttr(key)}="${__escapeAttr(val)}"`;
  }
  return out;
}

const __inlineStyle =
  `height:${__escapeAttr(__height)};` +
  (__styleExtra ? ` ${__styleExtra}` : '');

%>

<% if (!__id) { %>
  <div class="text-muted text-sm"><em>Nepavyko atvaizduoti žemėlapio (trūksta <code>id</code>).</em></div>
<% } else { %>
  <div
    id="<%= __id %>"
    class="<%= __className %>"
    style="<%= __inlineStyle %>"<%- __renderAttrs(__attrs) %>
  ></div>
<% } %>
