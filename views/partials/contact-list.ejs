<%
  // Reusable contact list partial with collapsible overflow.
  // Expected locals:
  // - items: Array<{ value: string, pages?: number[] }>
  // - title: string (required)
  // - type: 'email' | 'phone' (for href generation)
  // - maxItems?: number (optional; default: 3)
  // - emptyText?: string (optional; default: "Nerasta")

  const __title = typeof title !== 'undefined' ? title : 'Kontaktai';
  const __emptyText = typeof emptyText !== 'undefined' ? emptyText : 'Nerasta';
  const __type = typeof type !== 'undefined' ? type : 'email';
  const __list = Array.isArray(items) ? items : [];
  const __maxItems = typeof maxItems !== 'undefined' ? maxItems : 3;

  const __visibleItems = __list.slice(0, __maxItems);
  const __hiddenCount = Math.max(0, __list.length - __maxItems);
  const __hasHidden = __hiddenCount > 0;

  // Generate href based on type
  const getHref = (item) => {
    if (__type === 'email') return `mailto:${item.value}`;
    if (__type === 'phone') return `tel:${item.value}`;
    if (__type === 'link') return item.fullValue || item.value;
    return '#';
  };

  // Determine if value should be displayed as monospace
  const isMono = (__type === 'iban');

  // Determine if link should open in new tab
  const isExternal = (__type === 'link');
%>

<dt><%= __title %></dt>
<dd class="contact-list contact-list--<%= __type %>">
  <% if (__list.length > 0) { %>
    <div class="flex flex-col gap-1">
      <% __visibleItems.forEach(item => { %>
        <% if (!item || !item.value) return; %>
        <div class="flex gap-1 items-center contact-item">
          <% if (isMono) { %>
            <span class="cell-mono"><%= item.value %></span>
          <% } else if (isExternal) { %>
            <a href="<%= getHref(item) %>" target="_blank" class="cell-truncate"><%= item.value %></a>
          <% } else { %>
            <a href="<%= getHref(item) %>"><%= item.value %></a>
          <% } %>
          <% if (Array.isArray(item.pages) && item.pages.length > 0) { %>
            <sup class="text-muted text-xs contact-pages" style="flex-shrink:0;"><%= item.pages.slice(0, 3).join(', ') %><%= item.pages.length > 3 ? '...' : '' %> psl.</sup>
          <% } %>
        </div>
      <% }) %>
    </div>
    <% if (__hasHidden) { %>
      <details class="contact-list-details" style="margin-top:var(--space-2);">
        <summary class="contact-list-summary">
          <span class="text-muted text-xs fw-bold">+ <%= __hiddenCount %> daugiau</span>
        </summary>
        <div class="contact-list-expanded flex flex-col gap-1" style="margin-top:var(--space-2);">
          <% __list.slice(__maxItems).forEach(item => { %>
            <% if (!item || !item.value) return; %>
            <div class="flex gap-1 items-center contact-item">
              <% if (isMono) { %>
                <span class="cell-mono"><%= item.value %></span>
              <% } else if (isExternal) { %>
                <a href="<%= getHref(item) %>" target="_blank" class="cell-truncate"><%= item.value %></a>
              <% } else { %>
                <a href="<%= getHref(item) %>"><%= item.value %></a>
              <% } %>
              <% if (Array.isArray(item.pages) && item.pages.length > 0) { %>
                <sup class="text-muted text-xs contact-pages" style="flex-shrink:0;"><%= item.pages.slice(0, 3).join(', ') %><%= item.pages.length > 3 ? '...' : '' %> psl.</sup>
              <% } %>
            </div>
          <% }) %>
        </div>
      </details>
    <% } %>
  <% } else { %>
    <em class="text-muted"><%= __emptyText %></em>
  <% } %>
</dd>

