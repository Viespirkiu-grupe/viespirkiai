<%
/**
 * Full email message viewer partial (for .eml / .msg)
 *
 * Expected locals:
 * - metaduomenys: {
 *     subject?: string,
 *     from?: { name?: string, email?: string },
 *     to?: { name?: string, email?: string } | Array<{ name?: string, email?: string }>,
 *     date?: string|number|Date,
 *     messageDeliveryTime?: string|number|Date,
 *     html?: string,
 *     text?: string,
 *     body?: string,
 *     attachments?: Array<{ name: string }>
 *   }
 * - failasId: string|number (used for attachment download URLs)
 *
 * Optional locals:
 * - containerClass?: string
 * - iframeHeight?: number (default 400)
 *
 * Notes:
 * - Relies on Date.prototype.toLtDateTime() existing in your project (as used elsewhere).
 * - Escapes iframe srcdoc quotes to avoid breaking attributes.
 */
const __containerClass = (typeof containerClass !== 'undefined' && containerClass) ? containerClass : '';
const __iframeHeight = (typeof iframeHeight !== 'undefined' && iframeHeight) ? iframeHeight : 400;

const __meta = (typeof metaduomenys !== 'undefined' && metaduomenys) ? metaduomenys : {};
const __subject = __meta.subject || '—';

const __fromName = __meta?.from?.name || '—';
const __fromEmail = __meta?.from?.email || '—';

const __toList = Array.isArray(__meta.to) ? __meta.to : (__meta.to ? [__meta.to] : []);
const __dateRaw = __meta.date || __meta.messageDeliveryTime;

let __dateText = '—';
try {
  if (__dateRaw) __dateText = (new Date(__dateRaw).toLtDateTime()) || '—';
} catch (e) {}

const __html = __meta.html;
const __text = (__meta.text || __meta.body || '');

const __attachments = Array.isArray(__meta.attachments) ? __meta.attachments : [];
const __failasId = (typeof failasId !== 'undefined' && failasId !== null) ? String(failasId) : '';
%>

<div class="email-message bg-lighter-gray border-border rounded-md p-4 <%= __containerClass %>">
  <h2 class="mb-2 mt-0"><%= __subject %></h2>

  <dl class="kv-list mb-4">
    <dt>Nuo</dt>
    <dd>
      <%= __fromName %>
      &lt;<a href="mailto:<%= __fromEmail %>"><%= __fromEmail %></a>&gt;
    </dd>

    <dt>Kam</dt>
    <dd>
      <% if (__toList.length > 0) { %>
        <% __toList.forEach(to => { %>
          <div>
            <%= (to && to.name) ? to.name : '—' %>
            &lt;<a href="mailto:<%= (to && to.email) ? to.email : '—' %>"><%= (to && to.email) ? to.email : '—' %></a>&gt;
          </div>
        <% }) %>
      <% } else { %>
        —
      <% } %>
    </dd>

    <dt>Data</dt>
    <dd><%= __dateText %></dd>
  </dl>

  <% if (__html) { %>
    <iframe
      srcdoc="<%= String(__html).replace(/"/g, '&quot;') %>"
      style="height:<%= __iframeHeight %>px;"
      class="w-full border-border rounded-sm"
    ></iframe>
  <% } else { %>
    <pre class="whitespace-pre-wrap wrap-break-word font-mono text-sm border-t pt-3"><%- String(__text).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/\r?\n/g,"<br>") %></pre>
  <% } %>

  <% if (__attachments.length > 0) { %>
    <h3 class="mt-4 mb-2">Priedai</h3>
    <div class="flex flex-col gap-1">
      <% __attachments.forEach(att => { %>
        <% if (!att || !att.name) return; %>
        <a href="https://failai.viespirkiai.org/<%= __failasId %>/<%= att.name %>" target="_blank"><%= att.name %></a>
      <% }) %>
    </div>
  <% } %>
</div>
