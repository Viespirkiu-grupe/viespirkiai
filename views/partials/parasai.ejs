<%
  // Signature list partial (enhanced for legacy + XAdES structure)
  // Supports:
  // - old: { signerCertificateCommonName, signingTime }
  // - new: { signer: { name, unit, position }, signerCN, signingTime, level, signingPurpose, isValid }

  const titleValue = typeof title !== 'undefined' ? title : 'Parašai';
  const emptyTextValue = typeof emptyText !== 'undefined' ? emptyText : 'Nerasta';
  const disclaimerValue =
    typeof disclaimerText !== 'undefined'
      ? disclaimerText
      : 'Viešpirkiai netikrina skaitmeninių parašų galiojimo.';
  const max = typeof maxItems !== 'undefined' ? maxItems : 3;

  const list = Array.isArray(signatures) ? signatures : [];

  const formatName = (sig) => {
    return (
      sig?.signer?.name ||
      sig?.signerCertificateCommonName ||
      sig?.signerCN ||
      'Nežinomas pasirašytojas'
    );
  };

  const formatUnit = (sig) => sig?.signer?.unit || null;
  const formatPosition = (sig) => sig?.signer?.position || null;

  const formatTime = (t) => {
    if (!t) return null;
    try {
      return new Date(t).toLocaleString('lt-LT', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch {
      return t;
    }
  };

  const visible = list.slice(0, max);
  const hiddenCount = Math.max(0, list.length - max);
%>

<dt><%= titleValue %></dt>
<dd class="signature-list">

<% if (list.length) { %>

  <p class="text-muted text-xs mb-2"><em><%= disclaimerValue %></em></p>

  <div class="flex flex-col gap-2">

    <% visible.forEach(sig => { %>
      <% if (!sig) return; %>

      <div class="signature-item">
        <div class="flex flex-col">

          <div class="flex flex-wrap gap-2 items-baseline">
            <span class="fw-bold"><%= formatName(sig) %></span>

            <% const time = formatTime(sig.signingTime); %>
            <% if (time) { %>
              <span class="text-muted text-xs"><%= time %></span>
            <% } %>
          </div>

          <% const unit = formatUnit(sig); %>
          <% const position = formatPosition(sig); %>

          <% if (unit || position) { %>
            <div class="text-muted text-xs">
              <% if (position) { %><%= position %><% } %>
              <% if (position && unit) { %> · <% } %>
              <% if (unit) { %><%= unit %><% } %>
            </div>
          <% } %>

          <% if (sig.level || sig.signingPurpose || sig.isValid !== undefined) { %>
            <div class="text-muted text-xs">
              <% if (sig.level) { %>Level: <%= sig.level %><% } %>
              <% if (sig.signingPurpose) { %> · <%= sig.signingPurpose %><% } %>
              <% if (sig.isValid === true) { %> · validus<% } %>
              <% if (sig.isValid === false) { %> · negalioja<% } %>
            </div>
          <% } %>

        </div>
      </div>

    <% }) %>

  </div>

  <% if (hiddenCount > 0) { %>
    <details class="signature-list-details mt-2">
      <summary class="signature-list-summary">
        <span class="text-muted text-xs fw-bold">+ <%= hiddenCount %> daugiau</span>
      </summary>

      <div class="flex flex-col gap-2 mt-2">
        <% list.slice(max).forEach(sig => { %>
          <% if (!sig) return; %>

          <div class="signature-item">

            <div class="flex flex-col">
              <div class="flex flex-wrap gap-2 items-baseline">
                <span class="fw-bold"><%= formatName(sig) %></span>

                <% const time = formatTime(sig.signingTime); %>
                <% if (time) { %>
                  <span class="text-muted text-xs"><%= time %></span>
                <% } %>
              </div>

              <% const unit = formatUnit(sig); %>
              <% const position = formatPosition(sig); %>

              <% if (unit || position) { %>
                <div class="text-muted text-xs">
                  <% if (position) { %><%= position %><% } %>
                  <% if (position && unit) { %> · <% } %>
                  <% if (unit) { %><%= unit %><% } %>
                </div>
              <% } %>

              <% if (sig.level || sig.signingPurpose || sig.isValid !== undefined) { %>
                <div class="text-muted text-xs">
                  <% if (sig.level) { %>Level: <%= sig.level %><% } %>
                  <% if (sig.signingPurpose) { %> · <%= sig.signingPurpose %><% } %>
                  <% if (sig.isValid === true) { %> · validus<% } %>
                  <% if (sig.isValid === false) { %> · negalioja<% } %>
                </div>
              <% } %>

            </div>

          </div>

        <% }) %>
      </div>
    </details>
  <% } %>

<% } else { %>

  <em class="text-muted"><%= emptyTextValue %></em>

<% } %>

</dd>