<%
/**
 * Generic Leaflet loader partial (to be included in <head>).
 *
 * What it does:
 * - Ensures `/dist/leaflet.css` and `/dist/leaflet.js` are loaded once per page
 * - Exposes a stable promise API: `window.__vpLeafletLoad()` returning a Promise
 *   that resolves when Leaflet is ready (`window.L && window.L.map`).
 *
 * Usage:
 *   // include: ../partials/leaflet-head.ejs
 *   // then in a script:
 *   // window.__vpLeafletLoad().then(() => { ... L.map(...) ... })
 *
 * Notes:
 * - Safe to include multiple times (deduped via dataset markers + singleton state).
 * - Does not initialize any maps by itself.
 */
%>

<script defer>
(function () {
  window.__vpLeaflet = window.__vpLeaflet || {
    loading: null,
    loaded: false,
  };

  const state = window.__vpLeaflet;

  function ensureCssOnce() {
    if (document.querySelector('link[data-vp-leaflet-css="1"]')) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/dist/leaflet.css';
    link.dataset.vpLeafletCss = '1';
    document.head.appendChild(link);
  }

  function waitForLeafletGlobal(resolve) {
    const check = () => {
      if (window.L && window.L.map) {
        state.loaded = true;
        resolve();
      } else {
        setTimeout(check, 25);
      }
    };
    check();
  }

  function appendScriptWhenBodyReady(scriptEl) {
    const mount = () => {
      const target = document.body || document.head || document.documentElement;
      if (!target) return false;
      target.appendChild(scriptEl);
      return true;
    };

    if (mount()) return;

    // Body might not exist yet (script running from <head>).
    // Wait until DOM is ready enough to have a mount point.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => { mount(); }, { once: true });
    } else {
      // As a fallback, retry soon (covers edge cases where body is still null briefly).
      setTimeout(() => { mount(); }, 0);
    }
  }

  function ensureJsOnce() {
    if (state.loaded) {
      state.loading = state.loading || Promise.resolve();
      return state.loading;
    }
    if (state.loading) return state.loading;

    state.loading = new Promise((resolve, reject) => {
      // If script tag already exists (added by another include), wait for global.
      if (document.querySelector('script[data-vp-leaflet-js="1"]')) {
        return waitForLeafletGlobal(resolve);
      }

      const script = document.createElement('script');
      script.src = '/dist/leaflet.js';
      script.defer = true;
      script.dataset.vpLeafletJs = '1';
      script.onload = () => {
        state.loaded = true;
        resolve();
      };
      script.onerror = reject;

      appendScriptWhenBodyReady(script);
    });

    return state.loading;
  }

  // Public API: returns a Promise that resolves when Leaflet is ready.
  window.__vpLeafletLoad = window.__vpLeafletLoad || function () {
    ensureCssOnce();
    return ensureJsOnce();
  };

  // Eagerly start loading Leaflet as soon as this script runs.
  try {
    window.__vpLeafletLoad();
  } catch (e) {}
})();
</script>
