<%
/**
 * Point-map initializer partial (include in <head>).
 *
 * This file no longer owns Leaflet loading. It delegates loading to:
 *   views/partials/leaflet-head.ejs
 *
 * It will:
 * - Include the generic loader (safe to include multiple times).
 * - When DOM is ready and Leaflet is loaded, initialize ONE map:
 *     - reads coords from data-* attributes on the element
 *     - adds OSM tiles + (optional) marker
 * - Prevents double-init per mapId (handles bfcache / repeat renders).
 *
 * Expected locals:
 * - mapId: string (required)               // element id
 *
 * Optional locals:
 * - latAttr: string (default: 'lat')       // data-* attribute name for latitude (without "data-")
 * - lonAttr: string (default: 'lon')       // data-* attribute name for longitude (without "data-")
 * - zoom: number (default: 14)
 * - marker: boolean (default: true)
 * - tileUrl: string (default: OSM standard)
 * - attributionHtml: string (default: OSM attribution)
 *
 * Markup example:
 *   <div id="failas-map" class="map-container" data-lat="54.7" data-lon="25.2"></div>
 */
const __mapId = (typeof mapId !== 'undefined' && mapId) ? String(mapId) : '';
const __latAttr = (typeof latAttr !== 'undefined' && latAttr) ? String(latAttr) : 'lat';
const __lonAttr = (typeof lonAttr !== 'undefined' && lonAttr) ? String(lonAttr) : 'lon';
const __zoom = (typeof zoom !== 'undefined' && zoom !== null && zoom !== '') ? Number(zoom) : 14;
const __marker = (typeof marker !== 'undefined') ? !!marker : true;

const __tileUrl = (typeof tileUrl !== 'undefined' && tileUrl)
  ? String(tileUrl)
  : 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';

const __attributionHtml = (typeof attributionHtml !== 'undefined' && attributionHtml)
  ? String(attributionHtml)
  : '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';

function __json(s) { return JSON.stringify(String(s)); }
%>

<% if (__mapId) { %>
  <%- include('../partials/leaflet-head.ejs') %>

  <script defer>
  (function () {
    const mapId = <%- __json(__mapId) %>;
    const latKey = <%- __json(__latAttr) %>;
    const lonKey = <%- __json(__lonAttr) %>;
    const zoom = <%= Number.isFinite(__zoom) ? __zoom : 14 %>;
    const markerEnabled = <%= __marker ? 'true' : 'false' %>;
    const tileUrl = <%- __json(__tileUrl) %>;
    const attributionHtml = <%- JSON.stringify(__attributionHtml) %>;

    function init() {
      const el = document.getElementById(mapId);
      if (!el) return;

      // Prevent re-init (bfcache / partial rendered twice)
      if (el.dataset && el.dataset.leafletInited === '1') return;
      if (el.dataset) el.dataset.leafletInited = '1';

      const lat = Number(el.dataset[latKey]);
      const lon = Number(el.dataset[lonKey]);
      if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;

      const map = L.map(mapId, { zoomAnimation: true, markerZoomAnimation: true })
        .setView([lat, lon], Number(zoom) || 14);

      L.tileLayer(tileUrl, { attribution: attributionHtml }).addTo(map);

      if (markerEnabled) {
        L.marker([lat, lon]).addTo(map);
      }
    }

    function start() {
      if (typeof window.__vpLeafletLoad === 'function') {
        window.__vpLeafletLoad().then(() => {
          if (window.L && window.L.map) init();
        }).catch(() => {});
      } else {
        // Fallback (if generic loader wasn't included for some reason)
        if (window.L && window.L.map) init();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
  </script>
<% } %>
