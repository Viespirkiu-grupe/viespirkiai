<!DOCTYPE html>
<html>
<head>
  <%- include('../head.ejs', {
      pageTitle: "Ar veikia eviesiejipirkimai.lt?",
      pageDescription: ` `,
      pageImage: `https://viespirkiai.org/status/eviesiejipirkimai.lt.png`,
      customHead
  }) %>
  <%- include('../js/charts.ejs') %>
</head>
<body>
  <%- include('../header.ejs') %>
  <main>

    <div class="page-header justify-center mb-7">
      <div class="text-center">
        <h1 class="mb-3">Ar veikia eviesiejipirkimai.lt?</h1>
        <% if (status.paskutinisGedimas.per5min) { %>
          <h2 class="text-danger text-3xl mb-2">Tikriausiai NE</h2>
          <p class="text-muted"><em>Per paskutines 5min fiksavome sutrikimų</em></p>
        <% } else { %>
          <h2 class="text-success text-3xl mb-2">Tikriausiai TAIP</h2>
          <p class="text-muted"><em>Per paskutines 5min sutrikimų nefiksavome</em></p>
        <% } %>
      </div>
    </div>


    <section class="page-section">
      <h2>Istoriniai duomenys</h2>
      <h3 class="mt-4 mb-2">Skaičiavimo metodologija</h3>
      <p class="text-muted text-sm">
        Sistemos veikimas yra tikrinamas bent kas 2 minutes.
        Jeigu pateikiama klaida (šiuo atveju užrašas „Vyksta sistemos atnaujinimo darbai"), tada tai yra fiksuojama duomenų bazėje.
        Kai tarp fiksavimų yra mažiau nei 5 minutės, jie yra apjungiami ir skaičiuojama trukmė (gali būti apjungti ir keli jeigu kartojasi).
        Laikoma, kad gedimas prasidėjo gavus pirmąjį klaidos pranešimą ir pasibaigė iškart po paskutinio (sistemos naudai).
      </p>
    </section>


    <% if (status.apjungti && status.apjungti.length > 0) { %>
      <div class="grid-2">
        <% status.apjungti.forEach((diena) => { %>
          <article class="result-card">
            <div class="result-card-body">

              <div class="result-card-meta">
                <span><%= diena.day %></span>
                <span><%= Number(diena.merged_incidents).linksniuoti(["gedimas", "gedimai", "gedimų", "gedimo"]) %></span>
                <span><%= Number(diena.unmerged_events).linksniuoti(["fiksavimas", "fiksavimai", "fiksavimų", "fiksavimo"]) %></span>
              </div>

              <h3 class="result-card-title">
                Neveikė bent
                <%= diena.total_duration.hours ? diena.total_duration.hours + "h " : "" %>
                <%= diena.total_duration.minutes ? diena.total_duration.minutes + "min " : "" %>
                <%= diena.total_duration.seconds ? diena.total_duration.seconds + "s " : "" %>
                <%= diena.total_duration.hours || diena.total_duration.minutes || diena.total_duration.seconds ? "" : "0s" %>
              </h3>

              <div id="Gedimai<%= diena.day.replaceAll('-', '') %>Diagrama" class="chart mt-3" style="width:100%; height:200px;"></div>

              <script defer>
                let Intervals<%= diena.day.replaceAll("-", "") %> = <%- JSON.stringify(diena.intervals) %>;
                let Annotations<%= diena.day.replaceAll("-", "") %> = Intervals<%= diena.day.replaceAll("-", "") %>.map(interval => {
                  const start = new Date(interval.start_time);
                  const end = new Date(interval.end_time);
                  return {
                    x: Date.UTC(start.getFullYear(), start.getMonth(), start.getDate(), start.getHours(), start.getMinutes(), start.getSeconds()),
                    x2: Date.UTC(end.getFullYear(), end.getMonth(), end.getDate(), end.getHours(), end.getMinutes(), end.getSeconds()),
                    fillColor: '#FF4560',
                    borderColor: '#777',
                  };
                });

                function todayLT() {
                  const now = new Date();
                  const parts = new Intl.DateTimeFormat('en-CA', {
                    timeZone: 'Europe/Vilnius',
                    year: 'numeric', month: '2-digit', day: '2-digit'
                  }).formatToParts(now);
                  let year, month, day;
                  for (const part of parts) {
                    if (part.type === 'year') year = part.value;
                    if (part.type === 'month') month = part.value;
                    if (part.type === 'day') day = part.value;
                  }
                  return `${year}-${month}-${day}`;
                }

                if (todayLT() === "<%= diena.day %>") {
                  Annotations<%= diena.day.replaceAll("-", "") %>.push({
                    x: Date.UTC(new Date().getFullYear(), new Date().getMonth(), new Date().getDate(), new Date().getHours(), new Date().getMinutes(), new Date().getSeconds()),
                    label: { text: 'Dabar', style: { color: '#000' } },
                    borderColor: '#777',
                  });
                }

                displayChart({
                  element: document.querySelector('#Gedimai<%= diena.day.replaceAll("-", "") %>Diagrama'),
                  type: 'line-datetime',
                  labels: <%- JSON.stringify(diena.timestamps.map(t => new Date(t + 'Z').getTime())) %>,
                  series: <%- JSON.stringify(diena.timestamps.map(() => 1)) %>,
                  flags: ["xAxisHourMinute", "yAxisNoLabel", "noLine"],
                  customOptions: {
                    tooltip: { y: { title: { formatter: () => "Fiksuotas sutrikimas" } } },
                    chart: { height: 200 },
                    annotations: { xaxis: Annotations<%= diena.day.replaceAll("-", "") %> },
                    colors: ['#FF4560'],
                    yaxis: { min: 0, max: 2, tickAmount: 1, labels: { formatter: () => "" } },
                    xaxis: {
                      min: Date.UTC(<%= diena.day.substring(0,4) %>, <%= parseInt(diena.day.substring(5,7)) - 1 %>, <%= diena.day.substring(8,10) %>, 0, 0, 0),
                      max: Date.UTC(<%= diena.day.substring(0,4) %>, <%= parseInt(diena.day.substring(5,7)) - 1 %>, <%= diena.day.substring(8,10) %>, 23, 59, 59),
                    }
                  }
                });
              </script>

            </div>
          </article>
        <% }); %>
      </div>
    <% } %>

  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
