<div class="docs-sidebar-card">
  <p class="docs-sidebar-title">Design Documentation</p>

  <nav class="docs-sidebar-nav" aria-label="Design documentation navigation">
    <% dizainasSections.forEach((section) => { %>
      <% const sectionActive = selectedSection && selectedSection.slug === section.slug; %>
      <section class="docs-sidebar-group">
        <a
          href="/dizainas/<%= section.slug %>/<%= section.pages[0].slug %>"
          class="docs-sidebar-group-link <%= sectionActive ? 'is-active' : '' %>"
        >
          <%= section.label %>
        </a>

        <ul class="docs-sidebar-list">
          <% section.pages.forEach((page) => { %>
            <% const pageActive = sectionActive && selectedPage && selectedPage.slug === page.slug; %>
            <li>
              <a
                href="/dizainas/<%= section.slug %>/<%= page.slug %>"
                class="docs-sidebar-item <%= pageActive ? 'is-active' : '' %>"
              >
                <%= page.label %>
              </a>
            </li>
          <% }) %>
        </ul>
      </section>
    <% }) %>
  </nav>
</div>
