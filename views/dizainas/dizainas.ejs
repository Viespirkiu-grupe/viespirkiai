  <main class="sidebar-main">
    <div class="sidebar-main-inner">

    <div class="mb-7">
      <h1 class="mb-2">Viešpirkiai UI</h1>
      <p class="lead">A lightweight, Bootstrap-style design system built for public procurement analysis applications.</p>
    </div>


    <!-- TOKENS -->
    <section class="section" id="tokens">
      <h2>Tokens</h2>
      <p class="text-muted text-sm mb-5">All design decisions are expressed as CSS custom properties on <code>:root</code>. Dark mode overrides are included automatically.</p>

      <div class="subsection">
        <h3>Colors</h3>
        <div class="swatch-grid">
          <div class="swatch"><div class="swatch-color" style="background:#0f0f0f"></div><div class="swatch-info"><div class="swatch-name">--black</div><div class="swatch-value">#0f0f0f</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#444"></div><div class="swatch-info"><div class="swatch-name">--dark-gray</div><div class="swatch-value">#444444</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#777"></div><div class="swatch-info"><div class="swatch-name">--gray</div><div class="swatch-value">#777777</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#d4d4d4"></div><div class="swatch-info"><div class="swatch-name">--light-gray</div><div class="swatch-value">#d4d4d4</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#f0f0f0"></div><div class="swatch-info"><div class="swatch-name">--lighter-gray</div><div class="swatch-value">#f0f0f0</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#fff; outline: 1px solid #eee"></div><div class="swatch-info"><div class="swatch-name">--white</div><div class="swatch-value">#ffffff</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#1a6fc4"></div><div class="swatch-info"><div class="swatch-name">--link</div><div class="swatch-value">#1a6fc4</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#1a7f4b"></div><div class="swatch-info"><div class="swatch-name">--color-success</div><div class="swatch-value">#1a7f4b</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#9a6500"></div><div class="swatch-info"><div class="swatch-name">--color-warning</div><div class="swatch-value">#9a6500</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#c0392b"></div><div class="swatch-info"><div class="swatch-name">--color-danger</div><div class="swatch-value">#c0392b</div></div></div>
          <div class="swatch"><div class="swatch-color" style="background:#1a6fc4"></div><div class="swatch-info"><div class="swatch-name">--color-info</div><div class="swatch-value">#1a6fc4</div></div></div>
        </div>
      </div>

      <div class="subsection">
        <h3>Spacing</h3>
        <div class="spacing-scale">
          <div class="spacing-scale-item"><span class="space-label">space-1</span><span class="space-value">4px</span><div class="space-box space-box-1"></div></div>
          <div class="spacing-scale-item"><span class="space-label">space-2</span><span class="space-value">8px</span><div class="space-box space-box-2"></div></div>
          <div class="spacing-scale-item"><span class="space-label">space-3</span><span class="space-value">12px</span><div class="space-box space-box-3"></div></div>
          <div class="spacing-scale-item"><span class="space-label">space-4</span><span class="space-value">16px</span><div class="space-box space-box-4"></div></div>
          <div class="spacing-scale-item"><span class="space-label">space-5</span><span class="space-value">24px</span><div class="space-box space-box-5"></div></div>
          <div class="spacing-scale-item"><span class="space-label">space-6</span><span class="space-value">32px</span><div class="space-box space-box-6"></div></div>
          <div class="spacing-scale-item"><span class="space-label">space-7</span><span class="space-value">48px</span><div class="space-box space-box-7"></div></div>
          <div class="spacing-scale-item"><span class="space-label">space-8</span><span class="space-value">64px</span><div class="space-box space-box-8"></div></div>
        </div>
      </div>
    </section>


    <!-- TYPOGRAPHY -->
    <section class="section" id="typography">
      <h2>Typography</h2>
      <p class="text-muted text-sm mb-5">Ubuntu for UI text, default monospace for numbers and code.</p>

      <div class="preview preview-col">
        <h1 class="m-0">Heading 1 — 38px / 700</h1>
        <h2 class="m-0">Heading 2 — 30px / 700</h2>
        <h3 class="m-0">Heading 3 — 24px / 700</h3>
        <h4 class="m-0">Heading 4 — 20px / 700</h4>
        <h5 class="m-0">Heading 5 — 17px / 700</h5>
        <p class="lead m-0">Lead paragraph — larger intro text at 17px</p>
        <p class="m-0">Body text — 15px / 400. Used for all standard reading content. Line height 1.55.</p>
        <p class="text-muted m-0">Muted text — secondary information</p>
        <p class="subtext m-0">Subtext — italic small captions</p>
        <p class="section-title m-0">Section title label</p>
        <p class="m-0"><a href="#">Link text</a> · <a href="#" class="no-style">no-style link</a></p>
        <p class="m-0"><code>inline code</code> · <kbd>Ctrl+K</kbd> · <mark>highlighted</mark></p>
        <blockquote class="m-0">Blockquote — sourced excerpt or quoted text from a procurement document.</blockquote>
      </div>
      <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('snippets/typography.html')) %></code></pre>
    </section>


    <!-- LAYOUT -->
    <section class="section" id="layout">
      <h2>Layout & Grid</h2>
      <p class="text-muted text-sm mb-5">12-column flex grid with responsive breakpoints at 992px (md) and 768px (sm).</p>

      <div class="subsection">
        <h3>12-Column Row</h3>
        <div class="preview preview-col gap-2">
          <div class="row text-xs">
            <div class="col-6 bg-light p-2 rounded">col-6</div>
            <div class="col-6 bg-light p-2 rounded">col-6</div>
          </div>
          <div class="row text-xs">
            <div class="col-4 bg-light p-2 rounded">col-4</div>
            <div class="col-4 bg-light p-2 rounded">col-4</div>
            <div class="col-4 bg-light p-2 rounded">col-4</div>
          </div>
          <div class="row text-xs">
            <div class="col-3 bg-light p-2 rounded">col-3</div>
            <div class="col-6 bg-light p-2 rounded">col-6</div>
            <div class="col-3 bg-light p-2 rounded">col-3</div>
          </div>
        </div>
        <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('snippets/layout-row.html')) %></code></pre>
      </div>

      <div class="subsection">
        <h3>CSS Grid Shorthand</h3>
        <div class="preview preview-col">
          <div class="grid-4 text-xs">
            <div class="bg-light p-2 rounded">grid-4</div>
            <div class="bg-light p-2 rounded">grid-4</div>
            <div class="bg-light p-2 rounded">grid-4</div>
            <div class="bg-light p-2 rounded">grid-4</div>
          </div>
        </div>
        <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('snippets/layout-grid.html')) %></code></pre>
      </div>
    </section>


