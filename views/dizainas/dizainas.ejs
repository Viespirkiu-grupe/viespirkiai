    <!-- ALERTS -->
    <section class="section" id="alerts">
      <h2>Alerts & Toasts</h2>

      <div class="preview preview-col">
        <div class="alert alert-success"><span class="alert-icon">✓</span><div class="alert-body"><div class="alert-title">Išsaugota sėkmingai</div>Sutarties duomenys atnaujinti.</div></div>
