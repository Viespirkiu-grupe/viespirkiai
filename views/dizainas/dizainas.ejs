<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
	<%- include('../head.ejs', {
		pageTitle: 'Design - Documentation',
		pageDescription: 'Design documentation for components, data, and visualizations.',
		pageImage: 'https://viespirkiai.org/dizainas.png',
		customHead
	}) %>
	<%- include('../js/charts.ejs') %>
</head>
<body>
	<%- include('../header.ejs', {hideSubtext: true}) %>

	<main class="dizainas-docs-layout">
		<div class="dizainas-docs-grid">
			<aside class="dizainas-docs-sidebar self-start">
				<%- include('partials/sidebar.ejs') %>
			</aside>

			<section class="min-w-0 dizainas-docs-stack">
				<header class="docs-page-header">
					<p class="docs-kicker">
						<span>Design Documentation</span>
					</p>
					<h1 class="docs-title">Overview and Navigation</h1>
					<p class="docs-summary">
						Complete component documentation with a hierarchical structure from foundations to visualizations.
					</p>
				</header>

				<%- include('parts/index-intro.ejs') %>

				<nav class="docs-pager" aria-label="Page navigation">
					<div class="docs-pager-spacer"></div>

					<% if (nextPage) { %>
						<a href="<%= nextPage.url %>" class="docs-pager-link next">
							<span class="docs-pager-kicker">Next</span>
							<span class="docs-pager-title"><%= nextPage.label %></span>
						</a>
					<% } else { %>
						<div class="docs-pager-spacer"></div>
					<% } %>
				</nav>
			</section>
		</div>
	</main>
</body>
</html>
