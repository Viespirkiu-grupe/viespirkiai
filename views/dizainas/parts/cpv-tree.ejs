<!-- CPV TREE -->
<section class="section" id="cpv-tree">
  <h2>CPV Tree</h2>
  <p class="text-muted text-sm mb-7">
    Expandable CPV (Common Procurement Vocabulary) tree component based on <code>&lt;details&gt;</code>/<code>&lt;summary&gt;</code>.
    Supports leaf records (without children) and uses <code>.cpv-toggle</code> as the expand indicator.
  </p>

  <div class="subsection">
    <h3>Example</h3>

    <div class="preview preview-col max-w-180">
      <div class="cpv-tree">
        <details open>
          <summary>
            <span class="cpv-toggle">▶</span>
            <label>
              <input type="checkbox" class="form-check-input" data-cpv="03">
              <span class="cpv-code">03<span class="cpv-code-dim">000000</span></span>&nbsp;Agricultural, farming, fishing, forestry and related products
            </label>
          </summary>

          <details open>
            <summary>
              <span class="cpv-toggle">▶</span>
              <label>
                <input type="checkbox" class="form-check-input" data-cpv="031">
                <span class="cpv-code">031<span class="cpv-code-dim">00000</span></span>&nbsp;Agricultural and horticultural products
              </label>
            </summary>

            <details open>
              <summary>
                <span class="cpv-toggle">▶</span>
                <label>
                  <input type="checkbox" class="form-check-input" data-cpv="03111">
                  <span class="cpv-code">03111<span class="cpv-code-dim">000</span></span>&nbsp;Seeds
                </label>
              </summary>

              <details class="no-children">
                <summary>
                  <label>
                    <input type="checkbox" class="form-check-input" data-cpv="031111">
                    <span class="cpv-code">031111<span class="cpv-code-dim">00</span></span>&nbsp;Soybeans
                  </label>
                </summary>
              </details>

              <details class="no-children">
                <summary>
                  <label>
                    <input type="checkbox" class="form-check-input" data-cpv="031112">
                    <span class="cpv-code">031112<span class="cpv-code-dim">00</span></span>&nbsp;Peanuts
                  </label>
                </summary>
              </details>

              <details class="no-children">
                <summary>
                  <label>
                    <input type="checkbox" class="form-check-input" data-cpv="031113">
                    <span class="cpv-code">031113<span class="cpv-code-dim">00</span></span>&nbsp;Sunflower seeds
                  </label>
                </summary>
              </details>
            </details>
          </details>

          <details>
            <summary>
              <span class="cpv-toggle">▶</span>
              <label>
                <input type="checkbox" class="form-check-input" data-cpv="032">
                <span class="cpv-code">032<span class="cpv-code-dim">00000</span></span>&nbsp;Cereals, potatoes, vegetables, fruit and nuts
              </label>
            </summary>

            <details class="no-children">
              <summary>
                <label>
                  <input type="checkbox" class="form-check-input" data-cpv="032121">
                  <span class="cpv-code">032121<span class="cpv-code-dim">00</span></span>&nbsp;Potatoes
                </label>
              </summary>
            </details>

            <details class="no-children">
              <summary>
                <label>
                  <input type="checkbox" class="form-check-input" data-cpv="032222">
                  <span class="cpv-code">032222<span class="cpv-code-dim">00</span></span>&nbsp;Citrus fruit
                </label>
              </summary>
            </details>
          </details>
        </details>

        <div class="cpv-tree loading hidden">
          <span class="spinner"></span>
          <span class="text-muted text-sm ml-2">Loading...</span>
        </div>
      </div>
    </div>

    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(`
<div class="cpv-tree">
  <details open>
    <summary>
      <span class="cpv-toggle">▶</span>
      <label>
        <input type="checkbox" class="form-check-input" data-cpv="03">
        <span class="cpv-code">03<span class="cpv-code-dim">000000</span></span>&nbsp;Agricultural, farming, fishing, forestry and related products
      </label>
    </summary>

    <details class="no-children">
      <summary>
        <label>
          <input type="checkbox" class="form-check-input" data-cpv="031111">
          <span class="cpv-code">031111<span class="cpv-code-dim">00</span></span>&nbsp;Soybeans
        </label>
      </summary>
    </details>
  </details>
</div>
`) %></code></pre>
  </div>
</section>
