<!-- CPV TREE -->
<section class="section" id="cpv-tree">
  <h2>CPV Tree</h2>
  <p class="text-muted text-sm mb-5">
    Išskleidžiamas CPV (Common Procurement Vocabulary) medžio komponentas su <code>&lt;details&gt;</code>/<code>&lt;summary&gt;</code>.
    Palaiko „leaf“ įrašus (be vaikų) ir išskleidimo indikatorių per <code>.cpv-toggle</code>.
  </p>

  <div class="subsection">
    <h3>Pavyzdys</h3>

    <div class="preview preview-col" style="max-width: 720px;">
      <div class="cpv-tree">
        <details open>
          <summary>
            <span class="cpv-toggle">▶</span>
            <label>
              <input type="checkbox" class="form-check-input" data-cpv="03">
              <span class="cpv-code">03<span class="cpv-code-dim">000000</span></span>&nbsp;Žemės ūkio, ūkininkavimo, žvejybos, miškininkystės ir susiję produktai
            </label>
          </summary>

          <details open>
            <summary>
              <span class="cpv-toggle">▶</span>
              <label>
                <input type="checkbox" class="form-check-input" data-cpv="031">
                <span class="cpv-code">031<span class="cpv-code-dim">00000</span></span>&nbsp;Žemės ūkio ir sodininkystės produktai
              </label>
            </summary>

            <details open>
              <summary>
                <span class="cpv-toggle">▶</span>
                <label>
                  <input type="checkbox" class="form-check-input" data-cpv="03111">
                  <span class="cpv-code">03111<span class="cpv-code-dim">000</span></span>&nbsp;Sėklos
                </label>
              </summary>

              <details class="no-children">
                <summary>
                  <label>
                    <input type="checkbox" class="form-check-input" data-cpv="031111">
                    <span class="cpv-code">031111<span class="cpv-code-dim">00</span></span>&nbsp;Sojos pupelės
                  </label>
                </summary>
              </details>

              <details class="no-children">
                <summary>
                  <label>
                    <input type="checkbox" class="form-check-input" data-cpv="031112">
                    <span class="cpv-code">031112<span class="cpv-code-dim">00</span></span>&nbsp;Žemės riešutai
                  </label>
                </summary>
              </details>

              <details class="no-children">
                <summary>
                  <label>
                    <input type="checkbox" class="form-check-input" data-cpv="031113">
                    <span class="cpv-code">031113<span class="cpv-code-dim">00</span></span>&nbsp;Saulėgrąžų sėklos
                  </label>
                </summary>
              </details>
            </details>
          </details>

          <details>
            <summary>
              <span class="cpv-toggle">▶</span>
              <label>
                <input type="checkbox" class="form-check-input" data-cpv="032">
                <span class="cpv-code">032<span class="cpv-code-dim">00000</span></span>&nbsp;Javai, bulvės, daržovės, vaisiai ir riešutai
              </label>
            </summary>

            <details class="no-children">
              <summary>
                <label>
                  <input type="checkbox" class="form-check-input" data-cpv="032121">
                  <span class="cpv-code">032121<span class="cpv-code-dim">00</span></span>&nbsp;Bulvės
                </label>
              </summary>
            </details>

            <details class="no-children">
              <summary>
                <label>
                  <input type="checkbox" class="form-check-input" data-cpv="032222">
                  <span class="cpv-code">032222<span class="cpv-code-dim">00</span></span>&nbsp;Citrusų vaisiai
                </label>
              </summary>
            </details>
          </details>
        </details>

        <div class="cpv-tree loading" style="display:none;">
          <span class="spinner"></span>
          <span class="text-muted text-sm ms-2">Kraunama...</span>
        </div>
      </div>
    </div>

    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(`
<div class="cpv-tree">
  <details open>
    <summary>
      <span class="cpv-toggle">▶</span>
      <label>
        <input type="checkbox" class="form-check-input" data-cpv="03">
        <span class="cpv-code">03<span class="cpv-code-dim">000000</span></span>&nbsp;Žemės ūkio, ūkininkavimo, žvejybos, miškininkystės ir susiję produktai
      </label>
    </summary>

    <details class="no-children">
      <summary>
        <label>
          <input type="checkbox" class="form-check-input" data-cpv="031111">
          <span class="cpv-code">031111<span class="cpv-code-dim">00</span></span>&nbsp;Sojos pupelės
        </label>
      </summary>
    </details>
  </details>
</div>
`) %></code></pre>
  </div>
</section>
