<!-- DATA DISPLAY -->
<section class="section" id="data">
  <h2>Data Display</h2>
  <p class="text-muted text-sm mb-5">KPI stat cards, key-value pairs, amounts, and timeline — common patterns for procurement dashboards.</p>

  <div class="subsection">
    <h3>Stat Cards</h3>
    <div class="preview">
      <div class="stat-card flex-grow-1" style="min-width:160px;">
        <div class="stat-label">Aktyvios sutartys</div>
        <div class="stat-value">1,284</div>
        <div class="stat-delta up">↑ 12% šį mėnesį</div>
      </div>
      <div class="stat-card flex-grow-1" style="min-width:160px;">
        <div class="stat-label">Bendra vertė</div>
        <div class="stat-value">€ 48.2M</div>
        <div class="stat-delta down">↓ 3.4%</div>
      </div>
      <div class="stat-card flex-grow-1" style="min-width:160px;">
        <div class="stat-label">Tiekėjai</div>
        <div class="stat-value">342</div>
        <div class="stat-delta up">↑ 8 nauji</div>
      </div>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/stat-card.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Key-Value List</h3>
    <div class="preview">
      <dl class="kv-list w-100 w-full" style="max-width:400px;">
        <dt>Pirkėjas</dt><dd>VĮ Registrų centras</dd>
        <dt>CPV kodas</dt><dd>72000000-5</dd>
        <dt>Sutarties data</dt><dd>2024-03-01</dd>
        <dt>Vertė be PVM</dt><dd class="cell-mono">€ 124,500.00</dd>
        <dt>Statusas</dt><dd><span class="badge badge-success">Aktyvi</span></dd>
      </dl>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/kv-list.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Timeline</h3>
    <div class="preview">
      <ul class="timeline w-100 w-full" style="max-width:360px;">
        <li class="timeline-item">
          <span class="timeline-dot active"></span>
          <div class="timeline-body"><div class="timeline-date">2024-03-01</div><strong>Sutartis pasirašyta</strong><p class="text-muted text-sm mt-1 mb-0">Visos šalys patvirtino sąlygas</p></div>
        </li>
        <li class="timeline-item">
          <span class="timeline-dot"></span>
          <div class="timeline-body"><div class="timeline-date">2024-01-15</div><strong>Konkurso rezultatai</strong></div>
        </li>
        <li class="timeline-item">
          <span class="timeline-dot"></span>
          <div class="timeline-body"><div class="timeline-date">2023-12-01</div><strong>Skelbimas paskelbtas</strong></div>
        </li>
      </ul>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/timeline.html')) %></code></pre>
  </div>
</section>
