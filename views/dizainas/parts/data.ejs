<!-- DATA DISPLAY -->
<section class="section" id="data">
  <h2>Data Display</h2>
  <p class="text-muted text-sm mb-5">KPI stat cards, key-value pairs, amounts, and timeline — common patterns for procurement dashboards.</p>

  <div class="subsection">
    <h3>Stat Cards</h3>
    <div class="preview">
      <div class="stat-card grow min-w-[160px]">
        <div class="stat-label">Active contracts</div>
        <div class="stat-value">1,284</div>
        <div class="stat-delta up">↑ 12% this month</div>
      </div>
      <div class="stat-card grow min-w-[160px]">
        <div class="stat-label">Total value</div>
        <div class="stat-value">€ 48.2M</div>
        <div class="stat-delta down">↓ 3.4%</div>
      </div>
      <div class="stat-card grow min-w-[160px]">
        <div class="stat-label">Suppliers</div>
        <div class="stat-value">342</div>
        <div class="stat-delta up">↑ 8 new</div>
      </div>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/stat-card.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Key-Value List</h3>
    <div class="preview">
      <dl class="kv-list w-full max-w-[400px]">
        <dt>Buyer</dt><dd>State Enterprise Centre of Registers</dd>
        <dt>CPV code</dt><dd>72000000-5</dd>
        <dt>Contract date</dt><dd>2024-03-01</dd>
        <dt>Value excl. VAT</dt><dd class="cell-mono">€ 124,500.00</dd>
        <dt>Status</dt><dd><span class="badge badge-success">Active</span></dd>
      </dl>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/kv-list.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Timeline</h3>
    <div class="preview">
      <ul class="timeline w-full max-w-[360px]">
        <li class="timeline-item">
          <span class="timeline-dot active"></span>
          <div class="timeline-body"><div class="timeline-date">2024-03-01</div><strong>Contract signed</strong><p class="text-muted text-sm mt-1 mb-0">All parties approved the terms</p></div>
        </li>
        <li class="timeline-item">
          <span class="timeline-dot"></span>
          <div class="timeline-body"><div class="timeline-date">2024-01-15</div><strong>Tender results published</strong></div>
        </li>
        <li class="timeline-item">
          <span class="timeline-dot"></span>
          <div class="timeline-body"><div class="timeline-date">2023-12-01</div><strong>Notice published</strong></div>
        </li>
      </ul>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/timeline.html')) %></code></pre>
  </div>
</section>
