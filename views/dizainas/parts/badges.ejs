<!-- BADGES -->
<section class="section" id="badges">
  <h2>Badges & Tags</h2>

  <div class="subsection">
    <h3>Badges</h3>
    <div class="preview align-center flex-wrap">
      <span class="badge badge-default">Default</span>
      <span class="badge badge-primary">Primary</span>
      <span class="badge badge-success">Aktyvi</span>
      <span class="badge badge-warning">Laukiama</span>
      <span class="badge badge-danger">Atmesta</span>
      <span class="badge badge-info">Nauja</span>
      <span class="badge badge-muted">Archyvas</span>
      <span class="badge badge-success badge-lg">Large</span>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/badges.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Tags & Status</h3>
    <div class="preview align-center flex-wrap">
      <span class="tag">Statybos<button class="tag-remove">×</button></span>
      <span class="tag">IT paslaugos<button class="tag-remove">×</button></span>
      <span class="d-flex align-center gap-2"><span class="status-dot success"></span> Aktyvi</span>
      <span class="d-flex align-center gap-2"><span class="status-dot warning"></span> Laukiama</span>
      <span class="d-flex align-center gap-2"><span class="status-dot danger"></span> Atmesta</span>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/tags.html')) %></code></pre>
  </div>
</section>
