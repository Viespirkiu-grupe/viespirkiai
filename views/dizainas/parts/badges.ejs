<!-- BADGES -->
<section class="section" id="badges">
  <h2>Badges & Tags</h2>

  <div class="subsection">
    <h3>Badges</h3>
    <div class="preview items-center flex-wrap">
      <span class="badge badge-default">Default</span>
      <span class="badge badge-primary">Primary</span>
      <span class="badge badge-success">Active</span>
      <span class="badge badge-warning">Pending</span>
      <span class="badge badge-danger">Rejected</span>
      <span class="badge badge-info">New</span>
      <span class="badge badge-muted">Archive</span>
      <span class="badge badge-success badge-lg">Large</span>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/badges.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Tags & Status</h3>
    <div class="preview items-center flex-wrap">
      <span class="tag">Construction<button class="tag-remove">×</button></span>
      <span class="tag">IT services<button class="tag-remove">×</button></span>
      <span class="flex items-center gap-2"><span class="status-dot success"></span> Active</span>
      <span class="flex items-center gap-2"><span class="status-dot warning"></span> Pending</span>
      <span class="flex items-center gap-2"><span class="status-dot danger"></span> Rejected</span>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/tags.html')) %></code></pre>
  </div>
</section>
