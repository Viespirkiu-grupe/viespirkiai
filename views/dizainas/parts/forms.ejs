<!-- FORMS -->
<section class="section" id="forms">
  <h2>Forms</h2>
  <p class="text-muted text-sm mb-5">Input controls, labels, validation states, search bar, and toggle switch.</p>

  <div class="subsection">
    <h3>Basic Inputs</h3>
    <div class="preview preview-col" style="max-width:480px;">
      <div class="form-group">
        <label class="form-label required">Procurement title</label>
        <input type="text" class="form-control" placeholder="Enter title">
        <span class="form-hint">Official contract title</span>
      </div>
      <div class="form-group">
        <label class="form-label">Amount</label>
        <div class="input-group">
          <span class="input-group-text">€</span>
          <input type="number" class="form-control" placeholder="0.00">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Status</label>
        <select class="form-control">
          <option>All</option>
          <option>Active</option>
          <option>Completed</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Notes</label>
        <textarea class="form-control" rows="3" placeholder="Additional information..."></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Validation error</label>
        <input type="text" class="form-control is-invalid" value="Invalid value">
        <span class="form-error">This field is required</span>
      </div>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/forms-inputs.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Checkboxes, Radios & Toggle</h3>
    <div class="preview">
      <div class="flex flex-col gap-2">
        <label class="form-check"><input type="checkbox" class="form-check-input" checked> Published negotiation</label>
        <label class="form-check"><input type="checkbox" class="form-check-input"> Unpublished negotiation</label>
        <label class="form-check"><input type="radio" class="form-check-input" name="r" checked> Legal entity</label>
        <label class="form-check"><input type="radio" class="form-check-input" name="r"> Natural person</label>
        <label class="form-switch"><input type="checkbox"><span class="switch-track"></span> Show only active</label>
      </div>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/forms-checks.html')) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Search Bar</h3>
    <div class="preview">
      <div class="search-bar w-full" style="max-width:500px;">
        <span class="search-icon" style="font-size: var(--text-lg); line-height: 1;">⌕</span>
        <input type="search" placeholder="Search procurements, companies...">
        <div class="vr"></div>
        <button class="btn btn-primary btn-sm">Search</button>
      </div>
    </div>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(include('../snippets/forms-search.html')) %></code></pre>
  </div>
</section>
