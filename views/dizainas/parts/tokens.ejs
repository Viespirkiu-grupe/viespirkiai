<!-- TOKENS -->
<section class="section" id="tokens">
  <h2>Tokens</h2>
  <p class="text-muted text-sm mb-5">
    All design decisions are expressed as CSS custom properties on <code>:root</code>. Dark mode overrides are included automatically.
  </p>

  <div class="subsection">
      <h3>Colors</h3>
      <div class="swatch-grid">
          <div class="swatch"><div class="swatch-color bg-black"></div><div class="swatch-info"><div class="swatch-name">--black</div></div></div>
          <div class="swatch"><div class="swatch-color bg-dark-gray"></div><div class="swatch-info"><div class="swatch-name">--dark-gray</div></div></div>
          <div class="swatch"><div class="swatch-color bg-gray"></div><div class="swatch-info"><div class="swatch-name">--gray</div></div></div>
          <div class="swatch"><div class="swatch-color bg-light-gray"></div><div class="swatch-info"><div class="swatch-name">--light-gray</div></div></div>
          <div class="swatch"><div class="swatch-color bg-lighter-gray"></div><div class="swatch-info"><div class="swatch-name">--lighter-gray</div></div></div>
          <div class="swatch"><div class="swatch-color bg-white outline-1 outline-light-gray"></div><div class="swatch-info"><div class="swatch-name">--white</div></div></div>
          <div class="swatch"><div class="swatch-color bg-link"></div><div class="swatch-info"><div class="swatch-name">--link</div></div></div>
          <div class="swatch"><div class="swatch-color bg-success"></div><div class="swatch-info"><div class="swatch-name">--color-success</div></div></div>
          <div class="swatch"><div class="swatch-color bg-warning"></div><div class="swatch-info"><div class="swatch-name">--color-warning</div></div></div>
          <div class="swatch"><div class="swatch-color bg-danger"></div><div class="swatch-info"><div class="swatch-name">--color-danger</div></div></div>
          <div class="swatch"><div class="swatch-color bg-info"></div><div class="swatch-info"><div class="swatch-name">--color-info</div></div></div>
      </div>
  </div>

  <div class="subsection">
    <h3>Spacing</h3>
    <div class="spacing-scale">
      <div class="spacing-scale-item"><span class="space-label">space-1</span><span class="space-value">4px</span><div class="space-box space-box-1"></div></div>
      <div class="spacing-scale-item"><span class="space-label">space-2</span><span class="space-value">8px</span><div class="space-box space-box-2"></div></div>
      <div class="spacing-scale-item"><span class="space-label">space-3</span><span class="space-value">12px</span><div class="space-box space-box-3"></div></div>
      <div class="spacing-scale-item"><span class="space-label">space-4</span><span class="space-value">16px</span><div class="space-box space-box-4"></div></div>
      <div class="spacing-scale-item"><span class="space-label">space-5</span><span class="space-value">24px</span><div class="space-box space-box-5"></div></div>
      <div class="spacing-scale-item"><span class="space-label">space-6</span><span class="space-value">32px</span><div class="space-box space-box-6"></div></div>
      <div class="spacing-scale-item"><span class="space-label">space-7</span><span class="space-value">48px</span><div class="space-box space-box-7"></div></div>
      <div class="spacing-scale-item"><span class="space-label">space-8</span><span class="space-value">64px</span><div class="space-box space-box-8"></div></div>
    </div>
  </div>
</section>
