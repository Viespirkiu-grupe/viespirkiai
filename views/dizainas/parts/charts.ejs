<!-- CHARTS -->
<section class="section" id="charts">
  <h2>Charts</h2>
  <p class="text-muted text-sm mb-7">
    Chart components use <code>ApexCharts</code> through the <code>displayChart()</code> helper (see <code>views/js/charts.ejs</code>).
    Below are a few core chart types wrapped in <code>.chart-frame</code>.
  </p>

  <div class="subsection">
    <h3>Pie</h3>
    <div class="preview preview-col">
      <div class="chart-frame">
        <div id="designPieChart" class="chart h-[350px]"></div>
      </div>
    </div>
    <script defer>
      if (typeof displayChart === 'function') {
        displayChart({
          element: document.querySelector('#designPieChart'),
          type: 'pie',
          labels: ['Active', 'Pending', 'Rejected', 'Archive'],
          series: [42, 18, 7, 12],
          flags: ['colors'],
        });
      } else {
        const el = document.querySelector('#designPieChart');
        if (el) el.outerHTML = '<div class="chart-empty">Missing <code>displayChart()</code> (load <code>views/js/charts.ejs</code> on this page)</div>';
      }
    </script>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(`
<div class="chart-frame">
  <div id="pie" class="chart h-[350px]"></div>
</div>
<script defer>
  displayChart({
    element: document.querySelector('#pie'),
    type: 'pie',
    labels: ['Active', 'Pending', 'Rejected', 'Archive'],
    series: [42, 18, 7, 12],
    flags: ['colors'],
  });
</script>
`) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Line (datetime)</h3>
    <div class="preview preview-col">
      <div class="chart-frame">
        <div id="designLineChart" class="chart h-[350px]"></div>
      </div>
    </div>
    <script defer>
      if (typeof displayChart === 'function') {
        const now = new Date('2024-01-01T00:00:00.000Z').getTime();
        const day = 24 * 60 * 60 * 1000;
        const labels = Array.from({ length: 10 }, (_, i) => new Date(now + i * day).toISOString());
        const series = [12, 18, 22, 19, 27, 35, 31, 38, 44, 41];

        displayChart({
          element: document.querySelector('#designLineChart'),
          type: 'line-datetime',
          labels,
          series,
          flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
        });
      } else {
        const el = document.querySelector('#designLineChart');
        if (el) el.outerHTML = '<div class="chart-empty">Missing <code>displayChart()</code> (load <code>views/js/charts.ejs</code> on this page)</div>';
      }
    </script>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(`
<div class="chart-frame">
  <div id="line" class="chart h-[350px]"></div>
</div>
<script defer>
  const labels = [
    '2024-01-01T00:00:00.000Z',
    '2024-01-02T00:00:00.000Z',
    '2024-01-03T00:00:00.000Z'
  ];
  const series = [12, 18, 22];

  displayChart({
    element: document.querySelector('#line'),
    type: 'line-datetime',
    labels,
    series,
    flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
  });
</script>
`) %></code></pre>
  </div>

  <div class="subsection">
    <h3>Treemap</h3>
    <div class="preview preview-col">
      <div class="chart-frame">
        <div id="designTreemapChart" class="chart h-[350px]"></div>
      </div>
    </div>
    <script defer>
      if (typeof displayChart === 'function') {
        const labels = ['OCR-1', 'OCR-2', 'OCR-3', 'OCR-4'];
        const files  = [420, 180, 95, 60];

        displayChart({
          element: document.querySelector('#designTreemapChart'),
          type: 'treemap',
          labels,
          series: [{
            data: labels.map((label, i) => ({ x: label, y: files[i] }))
          }],
          flags: ['colors'],
        });
      } else {
        const el = document.querySelector('#designTreemapChart');
        if (el) el.outerHTML = '<div class="chart-empty">Missing <code>displayChart()</code> (load <code>views/js/charts.ejs</code> on this page)</div>';
      }
    </script>
    <pre class="code-block"><code class="hljs language-html"><%- highlightCode(`
<div class="chart-frame">
  <div id="treemap" class="chart h-[350px]"></div>
</div>
<script defer>
  const labels = ['OCR-1', 'OCR-2', 'OCR-3', 'OCR-4'];
  const files  = [420, 180, 95, 60];

  displayChart({
    element: document.querySelector('#treemap'),
    type: 'treemap',
    labels,
    series: [{ data: labels.map((label, i) => ({ x: label, y: files[i] })) }],
    flags: ['colors'],
  });
</script>
`) %></code></pre>
  </div>
</section>
