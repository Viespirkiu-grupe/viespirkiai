<!DOCTYPE html>
<html>
	<head>
    	<%- include('head.ejs', {
          pageTitle: Number(purchase.faktineIvykdimoVerte || purchase.verte)
                      .toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                      + " € " + purchase.pavadinimas,
          pageDescription: `Sutartis nr. ${purchase.sutartiesNumeris}
Sudaryta: ${new Date(purchase.sudarymoData).toISOString().slice(0,10)}
Galioja iki: ${new Date(purchase.galiojimoData).toISOString().slice(0,10)}`,
          pageImage: `https://viespirkiai.top/pirkimas/${purchase.sutartiesUnikalusID}.png`,
          pageAuthor: purchase.perkanciojiOrganizacija,
          customHead
        }) %>
	</head>
	<body>
        <%- include('header.ejs') %>

		<main>
		    <div class="subtext">
				<%= purchase.tipoPavadinimas %>
			</div>
			<h1 style="margin-top: 12px;">
                <% if (purchase.pavadinimas.length < 1) { %>
                    <i>Nenurodyta</i>
                <% } else { %>
                    <%= purchase.pavadinimas %>
                <% } %>
                už <u> <%= Number( purchase.faktineIvykdimoVerte || purchase.verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> € </u>
			</h1>

			<div>
    			<a href="/pirkimas/<%= purchase.sutartiesUnikalusID %>.json">↗ JSON</a>
                &nbsp;
                <a href="https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=<%= purchase.sutartiesUnikalusID %>">↗ CVP IS</a>
                &nbsp;
                <a href="mailto:pranesti@viespirkiai.top?subject=Dėl sutarties%20nr.%20<%= purchase.sutartiesUnikalusID %>&body=Čia paaiškinkite, kodėl norėjote informuoti apie sutartį%0D%0A%0D%0Ahttps://viespirkiai.top/pirkimas/<%= purchase.sutartiesUnikalusID %>">
                    ↗ Pranešti
                </a>
			</div>

            <section class="col-3 mobile-col-2">
                <div>
                    <h2><u>Pirkėjas</u></h2>
   					<h3><a href="/asmuo/<%= purchase.perkanciosiosOrganizacijosKodas %>"><%= purchase.perkanciojiOrganizacija %></a></h3>
   					<pre><%= purchase.perkanciosiosOrganizacijosKodas %></pre>
				</div>

				<% if(!purchase.papildomiTiekejai || purchase.papildomiTiekejai.length == 0) { %>
                    <div>
    					<h2><u>Tiekėjas</u></h2>
    					<h3><a href="/asmuo/<%= purchase.tiekejoKodas %>"> <%= purchase.tiekejas %> </a> </h3>
    					<pre><%= purchase.tiekejoKodas %></pre>
    				</div>
				<% } else { %>
                    <div>
                        <h2><u>Tiekėjai</u></h2>
                        <div>
                            <h3><a href="/asmuo/<%= purchase.tiekejoKodas %>"> <%= purchase.tiekejas %> </a> </h3>
                           	<pre><%= purchase.tiekejoKodas %></pre>
                        </div>
                        <% for (let i = 0; i < purchase.papildomiTiekejai.length; i++) { %>
                            <div style="margin-top: 12px;">
                                <h3><a href="/asmuo/<%= purchase.papildomiTiekejaiKodai[i] %>"> <%= purchase.papildomiTiekejai[i] %> </a> </h3>
                               	<pre><%= purchase.papildomiTiekejaiKodai[i] %></pre>
                            </div>
                        <% } %>
                    </div>
                <% } %>

                <div class="mobile-hide"></div>
            </section>

            <a href="/?tiekejoKodas=<%= purchase.tiekejoKodas %>&perkanciosiosOrganizacijosKodas=<%= purchase.perkanciosiosOrganizacijosKodas %>">↗ Tarpusavio sutartys</a>

            <br>

            <section class="col-3 mobile-col-2">
                <div>
                    <h2><u>Sutartis</u></h2>

                    <div style="min-height: 24px; display: block;">
                        <pre><%= purchase.sutartiesNumeris %></pre>
                    </div>

                    <div>
                        <h3 style="margin-bottom: 4px;">Vertė:</h3>
                        <div class="col-2">
                            <section>
                                <h4>Numatyta</h4>
                                <%= purchase.verte.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
                            </section>
                            <section>
                                <h4>Faktinė</h4>
                                <%= purchase.faktineIvykdimoVerte ? purchase.faktineIvykdimoVerte.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + " €" : "Nenurodyta" %>
                            </section>
                        </div>
                    </div>

                    <div>
                        <h3 style="margin-bottom: 4px;">Terminai:</h3>
                        <div class="col-2" style="row-gap: 8px;">
                            <section>
                                <h4>Sudaryta</h4>
                                <%= new Date(purchase.sudarymoData).toISOString().slice(0,10) %>
                            </section>
                            <section>
                                <h4>Galioja iki</h4>
                                <%= new Date(purchase.galiojimoData).toISOString().slice(0,10) %>
                            </section>
                            <section>
                                <h4>Faktinė įvykdymo data</h4>
                                <%= purchase.faktineIvykdimoData || "Nenurodyta" %>
                            </section>
                        </div>
                    </div>
                </div>

                <div>
                    <h2><u>Pranešimas</u></h2>

                    <div style="min-height: 24px; display: block;">
                        <pre style="display: inline-block; margin-block: 4px;"><%= purchase.sutartiesUnikalusID %></pre>
                        (<a href="https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=<%= purchase.sutartiesUnikalusID %>">
                            ↗ CVP IS
                        </a>)
                    </div>

                    <div>
                        <h3>Paskelbta:</h3>
                        <%= purchase.paskelbimoData %>
                    </div>

                    <div>
                        <h3>Redaguota:</h3>
                        <%= purchase.paskutinioRedagavimoData %>
                    </div>

                    <div>
                        <h3>Pirkimo numeris:</h3>
                        <%= purchase.pirkimoNumeris || "Nenurodytas" %>
                    </div>
                </div>

                <div class="mobile-wide-2">
                    <h2><u>Klasifikacija</u></h2>

                    <div>
                        <h3>Kategorija:</h3>
                        <%= purchase.kategorija %>
                    </div>


                    <div>
                        <h3>Tipas:</h3>
                        <%= purchase.tipas %> (<i><%= purchase.tipoPavadinimas %></i>)
                    </div>


                    <div>
                        <% if(!purchase.papildomiBvpzKodai || purchase.papildomiBvpzKodai.length == 0) { %>
                            <h3>BVPŽ:</h3>
                            <h4><%= purchase.bvpzPavadinimas %></h4>
                            <pre><%= purchase.bvpzKodas %></pre>
                        <% } else { %>
                            <h3>BVPŽ:</h3>
                            <div>
                                <h4><%= purchase.bvpzPavadinimas %></h4>
                                <pre><%= purchase.bvpzKodas %></pre>
                            </div>
                            <% for (let i = 0; i < purchase.papildomiBvpzKodai.length; i++) { %>
                                <div style="margin-top: 12px;">
                                    <h4><%= purchase.papildomiBvpzPavadinimai[i] %></h4>
                                    <pre><%= purchase.papildomiBvpzKodai[i] %></pre>
                                </div>
                            <% } %>
                        <% } %>
                        <a href="/bvpz">↗ BVPŽ kodai</a>
                    </div>
                </div>

                <div class="wide-3 mobile-wide-2">
                    <br>
                    <h2><u>Dokumentai</u></h2>

                    <% if (purchase.dokumentai && purchase.dokumentai.length > 0) { %>
                        <ul class="file-list">
                            <% purchase.dokumentai.forEach(doc => { %>
                                <li>
                                    <% if(doc.parsiustas & doc.nuskaitytas) { %>
                                        <a href="/failas/<%= doc.dok_id %>/<%= doc.file_id %>"><%= doc.pavadinimas %></a>
                                        (<a href="<%= doc.proxyUrl %>">↗ Failas</a>, <a href="<%= doc.url %>">↗ CVP IS</a>)
                                    <% } else { %>
                                        <a href="<%= doc.proxyUrl %>" target="_blank"><%= doc.pavadinimas %></a>
                                        (<a href="<%= doc.url %>">↗ CVP IS</a>)
                                    <% } %>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <p>Pateiktų dokumentų nėra.</p>
                    <% } %>
                </div>
            </section>
            <section>
                <div>
                    <h2><u>Panašios sutartys</u></h2><br>
                    <% if(purchase.panasiosSutartys && purchase.panasiosSutartys.length > 0) { %>
                        <% purchase.panasiosSutartys.forEach(item => { %>
                            <div class="rezultatas">
                                <div class="rezultatas-top">
                                    <span><%= item.tipas %></span>
                                    <span><%= item.kategorija %></span>
                                    <span>
                                        <% if(item.sudarymoData && item.galiojimoData) {  %>
                                            <% let sudarymoData = new Date(item.sudarymoData).toISOString().slice(0,10); %>
                                            <% let galiojimoData = new Date(item.galiojimoData).toISOString().slice(0,10); %>

                                            <% if(sudarymoData == galiojimoData) { %>
                                                Sut. <%= sudarymoData %>
                                            <% } else { %>
                                                Sut. <%= sudarymoData %> - <%= galiojimoData %>
                                            <% } %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </span>
                                    <span>
                                        <% if (item.paskutinioRedagavimoData) { %>
                                            Red. <%= item.paskutinioRedagavimoData %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </span>
                                    <span>
                                        <% if (item.dokumentuKiekis === 0) { %>

                                        <% } else { %>
                                            <%= item.dokumentuKiekis %> dok.
                                        <% } %>
                                    </span>

                                </div>
                                <div class="rezultatas-title">
                                    <a href="/pirkimas/<%= item.sutartiesUnikalusId %>">
                                        <span>
                                            <%
                                                const verte = item.faktineIvykdimoVerte || item.verte;
                                                if(Number(verte) > 10000) {
                                            %>
                                                <u><%= Number(verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</u>
                                            <% } else { %>
                                                <%= Number(verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
                                            <% } %>
                                        </span>&nbsp;
                                        <span>
                                            <% if(item.pavadinimas.length < 1) { %>
                                                <i>Nenurodyta</i>
                                            <% } else { %>
                                                <%= item.pavadinimas %>
                                            <% } %>
                                        </span>
                                    </a>
                                </div>
                                <div class="rezultatas-bottom">
                                    <span>
                                        <b> Pirkėjas: </b>
                                        <a href="/asmuo/<%= item.perkanciosiosOrganizacijosKodas %>"><%= item.perkanciojiOrganizacija %></a>
                                    </span>
                                    <span>
                                        <b> Tiekėjas: </b>
                                        <a href="/asmuo/<%= item.tiekejoKodas %>"><%= item.tiekejas || "Nenurodytas" %></a>
                                    </span>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <i>Panašių sutarčių nerasta.</i>
                    <% } %>
                </div>
            </section>
		</main>

        <%- include('footer.ejs') %>
	</body>
</html>
