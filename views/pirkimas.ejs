<!DOCTYPE html>
<html>
<head>
  <%- include('head.ejs', {
      pageTitle: Number(purchase.faktineIvykdimoVerte || purchase.verte)
                  .toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                  + " € " + purchase.pavadinimas,
      pageDescription: `Sutartis nr. ${purchase.sutartiesNumeris}
Sudaryta: ${new String(purchase.sudarymoData).slice(0,10)}
Galioja iki: ${new String(purchase.galiojimoData).slice(0,10)}`,
      pageImage: `https://viespirkiai.org/sutartis/${purchase.sutartiesUnikalusID}.png`,
      pageAuthor: purchase.perkanciojiOrganizacija,
      customHead
  }) %>
</head>
<body>
  <%- include('header.ejs') %>
  <main>

    <div class="page-header">
      <div>
        <p class="subtext mb-1"><%= purchase.tipoPavadinimas %></p>
        <h1 class="mb-0">
          <% if (purchase.pavadinimas.length < 1) { %>
            <em>Nenurodyta</em>
          <% } else { %>
            <%= purchase.pavadinimas %>
          <% } %>
          už <span class="amount"><%= Number(purchase.faktineIvykdimoVerte || purchase.verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>&nbsp;€</span>
        </h1>
      </div>
      <div class="d-flex gap-3 align-center">
        <a href="/sutartis/<%= purchase.sutartiesUnikalusID %>.json" class="btn btn-outline btn-sm">↗ JSON</a>
        <a href="https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=<%= purchase.sutartiesUnikalusID %>" class="btn btn-outline btn-sm">↗ CVP IS</a>
        <a href="mailto:pranesti@viespirkiai.org?subject=Dėl sutarties%20nr.%20<%= purchase.sutartiesUnikalusID %>&body=Čia paaiškinkite, kodėl norėjote informuoti apie sutartį%0D%0A%0D%0Ahttps://viespirkiai.org/pirkimas/<%= purchase.sutartiesUnikalusID %>" class="btn btn-outline btn-sm">↗ Pranešti</a>
      </div>
    </div>


    <!-- Pirkėjas / Tiekėjas -->
    <div class="mb-6">

    <div class="grid-3">
      <section>
        <h2>Pirkėjas</h2>
        <h3><a href="/asmuo/<%= purchase.perkanciosiosOrganizacijosKodas %>"><%= purchase.perkanciojiOrganizacija %></a></h3>
        <span class="text-muted"><%= purchase.perkanciosiosOrganizacijosKodas %></span>
      </section>

      <section>
        <% if (!purchase.papildomiTiekejai || purchase.papildomiTiekejai.length == 0) { %>
          <h2>Tiekėjas</h2>
          <% if (purchase.tiekejasPatikslinimas && purchase.tiekejasPatikslinimas != purchase.tiekejas) { %>
            <p class="text-muted text-sm mb-1"><%= purchase.tiekejasPatikslinimas %></p>
          <% } %>
          <h3><a href="/asmuo/<%= purchase.tiekejoKodas %>"><%= purchase.tiekejas %></a></h3>
          <% if (purchase.tiekejasSalis) { %>
            <p class="text-muted text-sm"><%= purchase.tiekejasSalis %></p>
          <% } %>
          <span class="text-muted"><%= purchase.tiekejoKodas %></span>
        <% } else { %>
          <h2>Tiekėjai</h2>
          <div class="mb-3">
            <h3><a href="/asmuo/<%= purchase.tiekejoKodas %>"><%= purchase.tiekejas %></a></h3>
            <span class="text-muted"><%= purchase.tiekejoKodas %></span>
          </div>
          <% for (let i = 0; i < purchase.papildomiTiekejai.length; i++) { %>
            <div class="mt-3">
              <h3><a href="/asmuo/<%= purchase.papildomiTiekejaiKodai[i] %>"><%= purchase.papildomiTiekejai[i] %></a></h3>
              <span class="text-muted"><%= purchase.papildomiTiekejaiKodai[i] %></span>
            </div>
          <% } %>
        <% } %>
      </section>
    </div>

      <div class="mt-4">
        <a href="/?tiekejoKodas=<%= purchase.tiekejoKodas %>&perkanciosiosOrganizacijosKodas=<%= purchase.perkanciosiosOrganizacijosKodas %>" class="btn btn-outline btn-sm">↗ Tarpusavio sutartys</a>
      </div>

    </div>


    <!-- Sutartis / Pranešimas / Klasifikacija / Dokumentai -->
    <div class="grid-3 mb-7">

      <section>
        <h2>Sutartis</h2>
        <span class="text-muted mb-4 d-block"><%= purchase.sutartiesNumeris %></span>

        <h3 class="mb-2">Vertė</h3>
        <dl class="kv-list mb-4">
          <dt>Numatyta</dt>
          <dd class="cell-mono"><%= purchase.verte.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</dd>
          <dt>Faktinė</dt>
          <dd class="cell-mono"><%= purchase.faktineIvykdimoVerte ? purchase.faktineIvykdimoVerte.toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + " €" : "Nenurodyta" %></dd>
        </dl>

        <h3 class="mb-2">Terminai</h3>
        <dl class="kv-list">
          <dt>Sudaryta</dt>
          <dd><%= new String(purchase.sudarymoData).slice(0,10) %></dd>
          <dt>Galioja iki</dt>
          <dd><%= new String(purchase.galiojimoData).slice(0,10) %></dd>
          <dt>Faktinė įvykdymo data</dt>
          <dd><%= purchase.faktineIvykdimoData || "Nenurodyta" %></dd>
        </dl>
      </section>

      <section>
        <h2>Pranešimas</h2>
        <div class="d-flex align-center gap-2 mb-4">
          <span class="text-muted"><%= purchase.sutartiesUnikalusID %></span>
          <a href="https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=<%= purchase.sutartiesUnikalusID %>" class="text-sm">↗ CVP IS</a>
        </div>

        <dl class="kv-list mb-4">
          <dt>Paskelbta</dt>
          <dd><%= purchase.paskelbimoData %></dd>
          <dt>Redaguota</dt>
          <dd><%= purchase.paskutinioRedagavimoData %></dd>
          <dt>Pirkimo numeris</dt>
          <dd>
            <% if (purchase.cvpisPirkimas) { %>
              <% if (purchase.cvpisPirkimas.type == 'Pmc') { %>
                <a href="https://viesiejipirkimai.lt/epps/pmc/viewPmc.do?resourceId=<%= purchase.cvpisPirkimas.pirkimoId %>"><%= purchase.pirkimoNumeris %></a>
              <% } else if (purchase.cvpisPirkimas.type == 'CfTWS') { %>
                <a href="https://viesiejipirkimai.lt/epps/cft/prepareViewCfTWS.do?resourceId=<%= purchase.cvpisPirkimas.pirkimoId %>"><%= purchase.pirkimoNumeris %></a>
              <% } else if (purchase.cvpisPirkimas.type == 'CfTDPSWS') { %>
                <a href="https://viesiejipirkimai.lt/epps/cft/prepareViewCfTDPSWS.do?resourceId=<%= purchase.cvpisPirkimas.pirkimoId %>"><%= purchase.pirkimoNumeris %></a>
              <% } %>
            <% } else if (purchase.cvppPirkimas) { %>
              <a href="<%= purchase.cvppPirkimas.link %>"><%= purchase.pirkimoNumeris %></a>
            <% } else { %>
              <%= purchase.pirkimoNumeris || "Nenurodytas" %>
            <% } %>
          </dd>
        </dl>
      </section>

      <section>
        <h2>Klasifikacija</h2>
        <dl class="kv-list mb-4">
          <dt>Kategorija</dt>
          <dd><%= purchase.kategorija %></dd>
          <dt>Tipas</dt>
          <dd><%= purchase.tipas %> <span class="text-muted">(<em><%= purchase.tipoPavadinimas %></em>)</span></dd>
        </dl>

        <h3 class="mb-2">BVPŽ</h3>
        <div class="mb-2">
          <div class="fw-medium"><%= purchase.bvpzPavadinimas %></div>
          <span class="text-muted"><%= purchase.bvpzKodas %></span>
        </div>
        <% if (purchase.papildomiBvpzKodai && purchase.papildomiBvpzKodai.length > 0) { %>
          <% for (let i = 0; i < purchase.papildomiBvpzKodai.length; i++) { %>
            <div class="mb-2">
              <div class="fw-medium"><%= purchase.papildomiBvpzPavadinimai[i] %></div>
              <span class="text-muted"><%= purchase.papildomiBvpzKodai[i] %></span>
            </div>
          <% } %>
        <% } %>
        <a href="/bvpz" class="text-sm">↗ BVPŽ kodai</a>
      </section>

      <section class="span-full">
        <h2>Dokumentai</h2>
        <% if (purchase.dokumentai && purchase.dokumentai.length > 0) { %>
          <ul class="file-list">
            <% purchase.dokumentai.forEach(doc => { %>
              <li>
                <% if (doc.id && doc.parsiustas && doc.nuskaitytas) { %>
                  <a href="/failas/<%= doc.id %>"><%= doc.pavadinimas %></a>
                  <span class="text-muted text-sm ms-2">(<a href="<%= doc.proxyUrl %>">↗ Failas</a>, <a href="<%= doc.url %>">↗ CVP IS</a>)</span>
                <% } else if (doc.parsiustas && doc.nuskaitytas) { %>
                  <a href="/failas/<%= doc.dok_id %>/<%= doc.file_id %>"><%= doc.pavadinimas %></a>
                  <span class="text-muted text-sm ms-2">(<a href="<%= doc.proxyUrl %>">↗ Failas</a>, <a href="<%= doc.url %>">↗ CVP IS</a>)</span>
                <% } else { %>
                  <a href="<%= doc.proxyUrl %>" target="_blank"><%= doc.pavadinimas %></a>
                  <span class="text-muted text-sm ms-2">(<a href="<%= doc.url %>">↗ CVP IS</a>)</span>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="text-muted">Pateiktų dokumentų nėra.</p>
        <% } %>
      </section>

    </div>


    <!-- ES projektai / SABIS / Panašios sutartys -->
    <div class="grid-2">

      <% if (purchase.cpvaProjektuSutartys && purchase.cpvaProjektuSutartys.length > 0) { %>
      <section>
        <h2>Europos sąjungos projektai <sup>BETA</sup></h2>
        <div class="result-list mt-4">
          <% purchase.cpvaProjektuSutartys.forEach(projektoSutartis => { %>
            <article class="result-card">
              <div class="result-card-body">
                <div class="result-card-meta">
                  <span><%= projektoSutartis.projektoNr || "" %></span>
                  <% if (projektoSutartis?.projektas) { %>
                    <span><%= projektoSutartis?.projektas?.projektoVeikluPradziosData || "" %> — <%= projektoSutartis?.projektas?.projektoVeikluPabaigosData || "" %></span>
                  <% } %>
                </div>
                <h3 class="result-card-title">
                  <a href="https://2021.esinvesticijos.lt/projektu-sritis/projektu-sarasas?query=<%= projektoSutartis.projektoNr %>">
                    <%= projektoSutartis?.projektas?.projektoPavadinimas || projektoSutartis.pirkimoObjektas || "" %>
                  </a>
                </h3>
              </div>
              <% if (projektoSutartis.projektas) { %>
                <div class="result-card-sidebar">
                  <% if (projektoSutartis.projektas.projektoVykdytojas) { %>
                    <span class="text-sm"><a href="/asmuo/<%= projektoSutartis.projektas.projektoVykdytojoKodas %>"><%= projektoSutartis.projektas.projektoVykdytojas %></a></span>
                  <% } %>
                  <% if (projektoSutartis.projektas.isViso) { %>
                    <span class="amount amount-sm"><%= Number(projektoSutartis.projektas.isViso).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €</span>
                  <% } %>
                </div>
              <% } %>
            </article>
          <% }); %>
        </div>
      </section>
      <% } %>


      <section>
        <h2>SABIS sutartys <sup>BETA</sup></h2>
        <% if (purchase.sabisSutartys && purchase.sabisSutartys.length > 0) { %>
          <div class="result-list mt-4">
            <% purchase.sabisSutartys.forEach(item => { %>
              <article class="result-card">
                <div class="result-card-body">
                  <div class="result-card-meta">
                    <span><%= item.tipas %></span>
                    <span><%= item.sutartiesNumeris %></span>
                    <span>
                      <% if (item.sutartiesPasirasymoData && item.sutartiesGaliojimoData) { %>
                        <% let d1 = new String(item.sutartiesPasirasymoData).slice(0,10); %>
                        <% let d2 = new String(item.sutartiesGaliojimoData).slice(0,10); %>
                        Sut. <%= d1 %><%= d1 != d2 ? ' — ' + d2 : '' %>
                      <% } else { %>—<% } %>
                    </span>
                  </div>
                  <h3 class="result-card-title">
                    <% const sabisVerte = item.suma; %>
                    <span class="amount-sm <%= Number(sabisVerte) > 10000 ? 'fw-bold' : '' %>">
                      <%= Number(sabisVerte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
                    </span>
                    &nbsp;<%= item.pavadinimas.length < 1 ? '<em>Nenurodyta</em>' : item.pavadinimas %>
                  </h3>
                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <% item.salys.forEach(salis => { %>
                      <span class="text-sm"><strong><%= salis.tipas %></strong> <%= salis.validusJarKodas || salis.validusAsmensKodas || salis.kitasKodas || salis.pavadinimas %></span>
                    <% }); %>
                  </div>
                  <% if (item.saskaitos && item.saskaitos.length > 0) { %>
                    <div class="mt-3">
                      <p class="section-title mb-2">Sąskaitos</p>
                      <% item.saskaitos.forEach(saskaita => { %>
                        <div class="kv-list mb-2">
                          <dt><%= saskaita.sfTipas %> Nr. <%= saskaita.sfNumeris %></dt>
                          <dd>
                            <% if (saskaita.valiuta == "Euras" || saskaita.valiuta == "EUR") { saskaita.valiuta = "€" } %>
                            <span class="cell-mono"><%= Number(saskaita.bendraSfSuma).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> <%= saskaita.valiuta %></span>
                            <span class="text-muted text-sm">(su <%= saskaita.pvm %> PVM)</span><br>
                            <span class="subtext"><%= saskaita.sfBusena %> (<%= saskaita.sfBusenoData %>)</span>
                          </dd>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted mt-4"><em>Panašių sutarčių nerasta.</em></p>
        <% } %>
      </section>


      <section>
        <h2>Panašios sutartys</h2>
        <% if (purchase.panasiosSutartys && purchase.panasiosSutartys.length > 0) { %>
          <div class="result-list mt-4">
            <% purchase.panasiosSutartys.forEach(item => { %>
              <article class="result-card card-clickable">
                <a href="/sutartis/<%= item.sutartiesUnikalusId %>" class="card-overlay-link"><%= item.pavadinimas %></a>
                <div class="result-card-body">
                  <div class="result-card-meta">
                    <span><%= item.tipas %></span>
                    <span><%= item.kategorija %></span>
                    <span>
                      <% if (item.sudarymoData && item.galiojimoData) { %>
                        <% let d1 = new String(item.sudarymoData).slice(0,10); %>
                        <% let d2 = new String(item.galiojimoData).slice(0,10); %>
                        Sut. <%= d1 %><%= d1 != d2 ? ' — ' + d2 : '' %>
                      <% } else { %>—<% } %>
                    </span>
                    <% if (item.dokumentuKiekis > 0) { %>
                      <span><%= item.dokumentuKiekis %> dok.</span>
                    <% } %>
                  </div>
                  <h3 class="result-card-title">
                    <% const verte = item.faktineIvykdimoVerte || item.verte; %>
                    <span class="cell-mono <%= Number(verte) > 10000 ? 'fw-bold' : '' %>">
                      <%= Number(verte).toLocaleString('lt-LT', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> €
                    </span>
                    &nbsp;<%= item.pavadinimas.length < 1 ? '<em>Nenurodyta</em>' : item.pavadinimas %>
                  </h3>
                  <div class="d-flex gap-3 mt-2 text-sm">
                    <span><strong>Pirkėjas:</strong> <a href="/asmuo/<%= item.perkanciosiosOrganizacijosKodas %>" style="position:relative;z-index:1;"><%= item.perkanciojiOrganizacija %></a></span>
                    <span><strong>Tiekėjas:</strong> <a href="/asmuo/<%= item.tiekejoKodas %>" style="position:relative;z-index:1;"><%= item.tiekejas || "Nenurodytas" %></a></span>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted mt-4"><em>Panašių sutarčių nerasta.</em></p>
        <% } %>
      </section>

    </div>

  </main>
  <%- include('footer.ejs') %>
</body>
</html>
