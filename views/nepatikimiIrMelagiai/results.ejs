<div class="mt-6 max-w-lg center mx-auto">
  <div class="d-flex justify-between align-center mb-4">
    <span class="text-muted text-sm"><em class="numberOfResults"><%- numberOfResults %></em></span>
  </div>

  <% if (data.length === 0) { %>
    <div class="empty-state">
      <p class="text-muted">Rezultatų nerasta.</p>
    </div>
  <% } else { %>

    <div class="result-list">
      <% data.forEach(item => { %>
        <%
          let asmuoLink = "/asmuo/" + item.tiekejoJarKodas;
          if (item.saltinis === "Nepatikimas") asmuoLink += "#nepatikimi";
          else if (item.saltinis === "Melagingas") asmuoLink += "#melagiai";
        %>
        <article class="result-card card-clickable" aria-label="<%= item.tiekejoPavadinimas %>">
          <a href="<%= asmuoLink %>" class="card-overlay-link"><%= item.tiekejoPavadinimas %></a>

          <div class="result-card-body">
            <dl class="result-card-meta">
              <div>
                <dt class="visually-hidden">Šaltinis</dt>
                <dd><%= item.saltinis %></dd>
              </div>
              <div>
                <dt class="visually-hidden">Galiojimas</dt>
                <dd><%= item.dataNuoKuriosSkaiciuojama || "nežinoma" %> – <%= item.itrauktasIki || "nežinoma" %></dd>
              </div>
              <div>
                <dt class="visually-hidden">Įvesta</dt>
                <dd>Įvesta <%= item.duomenuIvedimoData || "nežinoma" %></dd>
              </div>
              <div>
                <dt class="visually-hidden">Paskutinį kartą matyta</dt>
                <dd>Matyta <%= item.paskutiniKartaMatytaSarase %></dd>
              </div>
            </dl>

            <h3 class="result-card-title"><%= item.tiekejoPavadinimas %></h3>

            <% if (item.irasymoPagrindas && item.irasymoPagrindas.length > 3) { %>
              <p class="text-sm mt-2" style="text-align:justify;"><%= item.irasymoPagrindas %></p>
            <% } else if (item.itraukimoPriezastis && item.itraukimoPriezastis.length > 3) { %>
              <p class="text-sm mt-2" style="text-align:justify;"><%= item.itraukimoPriezastis.charAt(0).toUpperCase() + item.itraukimoPriezastis.slice(1) %></p>
            <% } %>

            <% if (item.pagrindimas?.tiekejoPaaiskinimas?.length > 3) { %>
              <blockquote class="mt-3"><%= item.pagrindimas.tiekejoPaaiskinimas %></blockquote>
              <% if (item.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda?.length > 3) { %>
                <a href="<%= item.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda %>" target="_blank" rel="noopener noreferrer" class="text-sm" style="position:relative;z-index:1;">↗ Peržiūrėti dokumentą (<%= item.pagrindimas.paaiskinimoPateikimoData || "Data nenurodyta" %>)</a>
              <% } %>
            <% } %>

            <div class="result-card-footer">
              <span><strong>Pirkėjas:</strong> <%= item.pirkimoVykdytojoPavadinimas || "nenurodytas" %></span>
              <span><strong>Pirkimo nr.:</strong> <%= item.pirkimoNumeris || "nenurodytas" %></span>
              <% if (item.teismoSprendimoLink?.length > 5) { %>
                <span><a href="<%= item.teismoSprendimoLink %>" target="_blank" rel="noopener noreferrer" style="position:relative;z-index:1;">↗ Teismo sprendimas</a></span>
              <% } %>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

    <%- include('../pagination.ejs', { currentPage, pageCount, queryParams }) %>

  <% } %>
</div>
