<div class="mt-10 max-w-lg center mx-auto">
  <div class="flex justify-between items-center mb-4">
    <span class="text-muted text-sm numberOfResults"><%- numberOfResults %></span>
  </div>

  <% if (data.length === 0) { %>
    <div class="empty-state">
      <p class="text-muted">Rezultatų nerasta.</p>
    </div>
  <% } else { %>

    <div class="result-list">
      <% data.forEach(item => { %>
        <%
          let asmuoLink = "/asmuo/" + item.tiekejoJarKodas;
          if (item.saltinis === "Nepatikimas") asmuoLink += "#nepatikimi";
          else if (item.saltinis === "Melagingas") asmuoLink += "#melagiai";
        %>
        <article class="result-card card-clickable">
          <div class="result-card-body">
            <dl class="result-card-meta">
              <div>
                <dt class="sr-only">Šaltinis</dt>
                <dd><%= item.saltinis %></dd>
              </div>

              <div>
                <dt class="sr-only">Galiojimas</dt>
                <dd><%= item.dataNuoKuriosSkaiciuojama || "nežinoma" %> – <%= item.itrauktasIki || "nežinoma" %></dd>
              </div>

              <div>
                <dt class="sr-only">Pirmą kartą įvesta</dt>
                <dd>Įvesta: <%= item.duomenuIvedimoData || "nežinoma" %></dd>
              </div>

              <div>
                <dt class="sr-only">Paskutinį kartą matyta</dt>
                <dd>Matyta: <%= item.paskutiniKartaMatytaSarase %></dd>
              </div>
            </dl>

            <h3 class="result-card-title">
              <a href="<%= asmuoLink %>"><%= item.tiekejoPavadinimas %></a>
            </h3>

            <% if (item.irasymoPagrindas && item.irasymoPagrindas.length > 3) { %>
              <p class="text-sm mt-2 text-justify"><%= item.irasymoPagrindas %></p>
            <% } else if (item.itraukimoPriezastis && item.itraukimoPriezastis.length > 3) { %>
              <p class="text-sm mt-2 text-justify"><%= item.itraukimoPriezastis.charAt(0).toUpperCase() + item.itraukimoPriezastis.slice(1) %></p>
            <% } %>

            <% if (item.pagrindimas?.tiekejoPaaiskinimas?.length > 3) { %>
              <blockquote class="mt-3"><%= item.pagrindimas.tiekejoPaaiskinimas %></blockquote>
              <% if (item.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda?.length > 3) { %>
                <a href="<%= item.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda %>" target="_blank" rel="noopener noreferrer" class="text-sm relative z-1">↗ Peržiūrėti dokumentą (<%= item.pagrindimas.paaiskinimoPateikimoData || "Data nenurodyta" %>)</a>
              <% } %>
            <% } %>

            <div class="result-card-footer">
              <span><strong>Pirkėjas:</strong> <%= item.pirkimoVykdytojoPavadinimas || "nenurodytas" %></span>
              <span><strong>Pirkimo nr.:</strong> <%= item.pirkimoNumeris || "nenurodytas" %></span>
              <% if (item.teismoSprendimoLink?.length > 5) { %>
                <span><a href="<%= item.teismoSprendimoLink %>" target="_blank" rel="noopener noreferrer" class="relative z-1">↗ Teismo sprendimas</a></span>
              <% } %>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

    <%- include('../pagination.ejs', { currentPage, pageCount, queryParams }) %>

  <% } %>
</div>
