<div class="page-section">
  <h3 class="text-sm font-bold mb-3">Parsiuntimas</h3>
  <div class="grid-2">

    <div class="card">
      <div class="card-body">
        <div class="section-title mb-3">Visi failai</div>
        <dl class="kv-list">
          <dt>Kiekis</dt>
          <dd><span class="cell-mono" data-stat="failai.kiekiai.visi"><%= statistika.failai.kiekiai.visi %></span></dd>
          <dt>Dydis *</dt>
          <dd><span class="cell-mono" data-stat="failai.dydziai.visi"><%= statistika.failai.dydziai.visi %></span></dd>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <div class="section-title mb-3">Parsiųsti failai</div>
        <dl class="kv-list">
          <dt>Kiekis</dt>
          <dd><span class="cell-mono" data-stat="failai.kiekiai.parsiusti"><%= statistika.failai.kiekiai.parsiusti %></span></dd>
          <dt>Dydis</dt>
          <dd><span class="cell-mono" data-stat="failai.dydziai.parsiusti"><%= statistika.failai.dydziai.parsiusti %></span></dd>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <div class="section-title mb-3">Neparsiųsti (klaida)</div>
        <dl class="kv-list">
          <dt>Kiekis</dt>
          <dd><span class="cell-mono" data-stat="failai.kiekiai.klaida"><%= statistika.failai.kiekiai.klaida %></span></dd>
          <dt>Dydis *</dt>
          <dd><span class="cell-mono" data-stat="failai.dydziai.klaida"><%= statistika.failai.dydziai.klaida %></span></dd>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <div class="section-title mb-3">Neparsiųsti</div>
        <dl class="kv-list">
          <dt>Kiekis</dt>
          <dd><span class="cell-mono" data-stat="failai.kiekiai.neparsiusti"><%= statistika.failai.kiekiai.neparsiusti %></span></dd>
          <dt>Dydis *</dt>
          <dd><span class="cell-mono" data-stat="failai.dydziai.neparsiusti"><%= statistika.failai.dydziai.neparsiusti %></span></dd>
        </dl>
      </div>
    </div>

  </div>
</div>
