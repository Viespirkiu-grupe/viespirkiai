<div>
    <h3>OCR</h3>
    <p>Failų teksto nuskaitymas iš nuotraukų</p>
    <div class="col-auto mobile-col-1">
        <div>
            <div>
                <h4>Pagal nuskaitytoją</h4>
                <div class="tableContainer">
                    <table style="width: auto; max-width: 100%; min-width: auto;">
                        <thead>
                            <tr>
                                <th>Pavadinimas</th>
                                <th>Failai</th>
                                <th>Rezervacijos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% statistika.topOcrNuskaitytojai.forEach(nuskaitytojas => { %>
                                    <tr>
                                        <td><%= nuskaitytojas.viesasPavadinimas %></td>
                                        <td class="center no-wrap"><%= Number(nuskaitytojas.nuskaitytiDokumentai).toLocaleString('lt-LT') %></td>
                                        <td class="center no-wrap"><%= Number(nuskaitytojas.rezervuota).toLocaleString('lt-LT') %></td>
                                    </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div>
            <h4>Pagal būseną</h4>
            <div class="tableContainer">
                <table style="width: auto; max-width: 100%; min-width: auto;">
                    <thead>
                        <tr>
                            <th>Būsena</th>
                            <th>Failų skaičius</th>
                            <th>Dalis</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% statistika.ocrState.forEach(state => { %>
                                <tr>
                                    <td><%= state.state %></td>
                                    <td class="center no-wrap"><%= Number(state.count).toLocaleString('lt-LT') %></td>
                                    <td class="center no-wrap"><%= Number(state.percent).toLocaleString('lt-LT') %> %</td>
                                </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            </div>

    </div>
</div>
