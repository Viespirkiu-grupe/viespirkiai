<!DOCTYPE html>
<html>
	<head>
    	<%- include('../head.ejs', {
            pageTitle: "Statistika",
            pageDescription: ` `,
            pageImage: `https://viespirkiai.top/statistika.png`,
            customHead
        }) %>
      <!--<meta http-equiv="refresh" content="1">-->
	</head>
	<body>
        <%- include('../header.ejs') %>
        <main>
            <h1>Statistika</h1>
            <button id="liveUpdate" style="font-size: inherit; background-color: var(--lighter-gray)">Tiesioginis atnaujinimas (įjungti, kas 0.25s)</button><br><br>
            <%- include('./main.ejs') %>
        </main>
        <%- include('../footer.ejs') %>
        <script>
            let latestRequest = 0;
            let intervalId = null;
            const button = document.getElementById('liveUpdate');

            button.addEventListener('click', () => {
            if (intervalId) {
                // Stop updating
                clearInterval(intervalId);
                intervalId = null;
                button.textContent = "Tiesioginis atnaujinimas (įjungti)";
            } else {
                // Start updating
                intervalId = setInterval(() => {
                const requestId = ++latestRequest;
                fetch('/statistika?innerOnly=true')
                    .then(response => response.text())
                    .then(data => {
                    if (requestId === latestRequest) {
                        document.querySelector('.replacableContent').outerHTML = data;
                    }
                    });
                }, 250);
                button.textContent = "Tiesioginis atnaujinimas (išjungti)";
            }
            });
        </script>
    </body>
</html>
