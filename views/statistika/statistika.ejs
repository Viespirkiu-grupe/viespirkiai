<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
    pageTitle: "Statistika",
    pageDescription: `Viešpirkių sistemos veikimo statistika`,
    pageImage: `https://viespirkiai.org/statistika.png`,
    customHead
  }) %>
</head>
<body>
  <%- include('../header.ejs') %>
  <main>

    <div class="page-header">
      <h1 class="mb-0">Statistika</h1>
      <button id="liveUpdate" class="btn btn-outline btn-sm">▶ Tiesioginis atnaujinimas</button>
    </div>

    <%- include('./main.ejs') %>

  </main>
  <%- include('../footer.ejs') %>

  <script>
    let evtSource = null;
    const button = document.getElementById("liveUpdate");

    const setText = (key, value) => {
      const el = document.querySelector(`[data-stat="${key}"]`);
      if (el) el.textContent = value;
    };

    const renderRows = (rows, renderRow) => rows.map(renderRow).join("");

    const escapeHtml = value =>
      String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

    const updatePage = payload => {
      if (payload.atnaujinta !== undefined) {
        setText("atnaujinta", payload.atnaujinta);
      }

      const failaiKiekiai = payload.failai?.kiekiai;
      if (failaiKiekiai?.visi !== undefined) setText("failai.kiekiai.visi", failaiKiekiai.visi);
      if (failaiKiekiai?.parsiusti !== undefined) setText("failai.kiekiai.parsiusti", failaiKiekiai.parsiusti);
      if (failaiKiekiai?.klaida !== undefined) setText("failai.kiekiai.klaida", failaiKiekiai.klaida);
      if (failaiKiekiai?.neparsiusti !== undefined) setText("failai.kiekiai.neparsiusti", failaiKiekiai.neparsiusti);

      const failaiDydziai = payload.failai?.dydziai;
      if (failaiDydziai?.visi !== undefined) setText("failai.dydziai.visi", failaiDydziai.visi);
      if (failaiDydziai?.parsiusti !== undefined) setText("failai.dydziai.parsiusti", failaiDydziai.parsiusti);
      if (failaiDydziai?.klaida !== undefined) setText("failai.dydziai.klaida", failaiDydziai.klaida);
      if (failaiDydziai?.neparsiusti !== undefined) setText("failai.dydziai.neparsiusti", failaiDydziai.neparsiusti);

      const zodziai = payload.nuskaitymas?.zodziai;
      if (zodziai?.total !== undefined) setText("nuskaitymas.zodziai.total", zodziai.total);
      if (zodziai?.vidurkis !== undefined) setText("nuskaitymas.zodziai.vidurkis", zodziai.vidurkis);
      if (zodziai?.vidurkisNeNulis !== undefined) setText("nuskaitymas.zodziai.vidurkisNeNulis", zodziai.vidurkisNeNulis);
      if (zodziai?.failuSuZodziaisDalis !== undefined) setText("nuskaitymas.zodziai.failuSuZodziaisDalis", zodziai.failuSuZodziaisDalis);

      const database = payload.database;
      if (database?.uptime !== undefined) setText("database.uptime", database.uptime);
      if (database?.xact_commit !== undefined) setText("database.xact_commit", database.xact_commit);
      if (database?.tup_inserted !== undefined) setText("database.tup_inserted", database.tup_inserted);
      if (database?.tup_updated !== undefined) setText("database.tup_updated", database.tup_updated);
      if (database?.tup_deleted !== undefined) setText("database.tup_deleted", database.tup_deleted);
      if (database?.tup_fetched !== undefined) setText("database.tup_fetched", database.tup_fetched);

      const pagalVersijaBody = document.getElementById("pagalVersijaBody");
      if (pagalVersijaBody && payload.nuskaitymas?.pagalVersija) {
        pagalVersijaBody.innerHTML = renderRows(payload.nuskaitymas.pagalVersija, versija => `
          <tr>
            <td>${escapeHtml(versija.status)}</td>
            <td class="cell-mono cell-right cell-nowrap">${escapeHtml(versija.kiekis)}</td>
            <td class="cell-mono cell-right cell-nowrap">${escapeHtml(versija.procentai)}</td>
          </tr>
        `);
      }

      const topNuskaitytojaiBody = document.getElementById("topNuskaitytojaiBody");
      if (topNuskaitytojaiBody && payload.topDokNuskaitytojai) {
        topNuskaitytojaiBody.innerHTML = renderRows(payload.topDokNuskaitytojai, item => `
          <tr>
            <td>${escapeHtml(item.viesasPavadinimas)}</td>
            <td class="cell-mono cell-right cell-nowrap">${escapeHtml(item.nuskaitytidokumentai)}</td>
          </tr>
        `);
      }

      const lentelesBody = document.getElementById("lentelesBody");
      if (lentelesBody && payload.lenteles) {
        lentelesBody.innerHTML = renderRows(payload.lenteles, lentele => `
          <tr class="${lentele.isTotal ? "font-bold" : ""}">
            <td>${escapeHtml(lentele.tableName)}</td>
            <td class="cell-mono cell-right cell-nowrap">${escapeHtml(lentele.dataSize)}</td>
            <td class="cell-mono cell-right cell-nowrap">${escapeHtml(lentele.indexSize)}</td>
            <td class="cell-mono cell-right cell-nowrap">${escapeHtml(lentele.totalSize)}</td>
            <td class="cell-mono cell-right cell-nowrap">${escapeHtml(lentele.approxRowCount)}</td>
          </tr>
        `);
      }
    };

    const stopSSE = () => {
      if (!evtSource) return;
      evtSource.close();
      evtSource = null;
      button.textContent = "▶ Tiesioginis atnaujinimas";
      button.classList.remove("btn-primary");
      button.classList.add("btn-outline");
    };

    const startSSE = () => {
      if (evtSource) {
        evtSource.close();
        evtSource = null;
      }

      evtSource = new EventSource("/statistika/sse");
      button.textContent = "⏸ Tiesioginis atnaujinimas";
      button.classList.remove("btn-outline");
      button.classList.add("btn-primary");

      evtSource.onmessage = e => {
        updatePage(JSON.parse(e.data));
      };

      evtSource.onerror = () => {
        if (evtSource) {
          evtSource.close();
          evtSource = null;
        }
        setTimeout(() => {
          if (button.classList.contains("btn-primary")) startSSE();
        }, 500);
      };
    };

    button.addEventListener("click", () => evtSource ? stopSSE() : startSSE());
  </script>
</body>
</html>
