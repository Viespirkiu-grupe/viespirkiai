<!DOCTYPE html>
<html>
	<head>
    	<%- include('../head.ejs', {
            pageTitle: "Statistika",
            pageDescription: ` `,
            pageImage: `https://viespirkiai.org/statistika.png`,
            customHead
        }) %>
      <%- include('../js/idiomorph.ejs') %>
	</head>
	<body>
        <%- include('../header.ejs') %>
        <main>
            <h1>Statistika</h1>
            <button id="liveUpdate" style="font-size: inherit; background-color: var(--lighter-gray)">Tiesioginis atnaujinimas (įjungti)</button><br><br>
            <%- include('./main.ejs') %>
        </main>
        <%- include('../footer.ejs') %>
        <script>
            let evtSource = null;
            const button = document.getElementById("liveUpdate");

            button.addEventListener("click", () => {
                if (evtSource) {
                    // Stop SSE updates
                    evtSource.close();
                    evtSource = null;
                    button.textContent = "Tiesioginis atnaujinimas (įjungti)";
                    return;
                }

                // Start SSE live updates
                evtSource = new EventSource("/statistika/sse");

                evtSource.onmessage = (e) => {
                    const html = JSON.parse(e.data);
                    Idiomorph.morph(document.querySelector(".replacableContent"), html);
                };

                evtSource.onerror = () => {
                    console.warn("SSE connection lost, attempting reconnect...");
                };

                button.textContent = "Tiesioginis atnaujinimas (išjungti)";
            });
        </script>

    </body>
</html>
