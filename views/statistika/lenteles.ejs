<div class="page-section">
  <h2 class="mb-1"><a href="#duomenuBaze" id="duomenuBaze" class="no-style">Duomenų bazė</a></h2>
  <p class="text-muted text-sm mb-4">Nuo paskutinio įjungimo (<span data-stat="database.uptime"><%= statistika.database.uptime_seconds.convertUnit('s') %></span>)</p>

  <div class="grid-2 mb-5" style="align-items:start;">

    <div>
      <h3 class="text-sm fw-bold mb-3">Apkrova</h3>
      <dl class="kv-list">
        <dt>Atliktos užklausos</dt>
        <dd><span class="cell-mono" data-stat="database.xact_commit"><%= Number(statistika.database.xact_commit).toLocaleString('lt-LT') %></span></dd>
        <dt>Įterptos eilutės</dt>
        <dd><span class="cell-mono" data-stat="database.tup_inserted"><%= Number(statistika.database.tup_inserted).toLocaleString('lt-LT') %></span></dd>
        <dt>Atnaujintos eilutės</dt>
        <dd><span class="cell-mono" data-stat="database.tup_updated"><%= Number(statistika.database.tup_updated).toLocaleString('lt-LT') %></span></dd>
        <dt>Ištrintos eilutės</dt>
        <dd><span class="cell-mono" data-stat="database.tup_deleted"><%= Number(statistika.database.tup_deleted).toLocaleString('lt-LT') %></span></dd>
        <dt>Skaitytos eilutės</dt>
        <dd><span class="cell-mono" data-stat="database.tup_fetched"><%= Number(statistika.database.tup_fetched).toLocaleString('lt-LT') %></span></dd>
      </dl>
    </div>

  </div>

  <h3 class="text-sm fw-bold mb-3">Lentelės</h3>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>Pavadinimas</th>
          <th class="cell-right">Duomenų dydis</th>
          <th class="cell-right">Indekso dydis</th>
          <th class="cell-right">Visas dydis</th>
          <th class="cell-right">Eilutės *</th>
        </tr>
      </thead>
      <tbody id="lentelesBody">
        <% statistika.lenteles.forEach(lentele => { %>
          <tr class="<%= lentele.tableName === 'Iš viso' ? 'fw-bold' : '' %>">
            <td><%= lentele.tableName %></td>
            <td class="cell-mono cell-right cell-nowrap"><%= Number(lentele.dataSize).convertUnit("B") %></td>
            <td class="cell-mono cell-right cell-nowrap"><%= Number(lentele.indexSize).convertUnit("B") %></td>
            <td class="cell-mono cell-right cell-nowrap"><%= Number(lentele.totalSize).convertUnit("B") %></td>
            <td class="cell-mono cell-right cell-nowrap"><%= Number(lentele.approxRowCount).toLocaleString('lt-LT') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
