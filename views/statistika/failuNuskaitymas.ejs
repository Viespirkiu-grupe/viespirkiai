<div>
    <div>
        <h3>Turinio nuskaitymas</h3>
        <p>Failų teksto, metaduomenų nuskaitymas</p>
    </div>
    <div class="col-2 mobile-col-1">
        <div>
            <h4>Pagal būsena</h4>
            <div class="tableContainer">
                <table style="width: auto; max-width: 100%; min-width: auto;">
                    <thead>
                        <tr>
                            <th>Nuskaitymas</th>
                            <th>Failai</th>
                            <th>Dalis</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% statistika.nuskaitymas.pagalVersija.forEach(versija => { %>
                                <tr>
                                    <td><%= versija.status %></td>
                                    <td class="center no-wrap"><%= Number(versija.kiekis).toLocaleString('lt-LT') %></td>
                                    <td class="center no-wrap"><%= Number(versija.procentai).toLocaleString('lt-LT') %> %</td>
                                </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        </div>
        <div>
            <h4>Pagal nuskaitytoją</h4>
            <div class="tableContainer">
                <table style="width: auto; max-width: 100%; min-width: auto;">
                    <thead>
                        <tr>
                            <th>Nuskaitytojas</th>
                            <th>Failų skaičius</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% statistika.topDokNuskaitytojai.forEach(nuskaitytojas => { %>
                                <tr>
                                    <td><%= nuskaitytojas.viesasPavadinimas %></td>
                                    <td class="center no-wrap"><%= Number(nuskaitytojas.nuskaitytidokumentai).toLocaleString('lt-LT') %></td>
                                </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
