<div id="failaiStatistika">
    <h2><u>Failų statistika</u></h2>
    <i>Statistika atnaujinta: <%= new Date(statistika.atnaujinta).toLtDateTime() %> </i><br><br>
    <div>
	<a href="/failai/topExtension">↗ Dažniausi plėtiniai</a>&nbsp;
	<a href="/failai/ocr">↗ OCR būsena</a>&nbsp;
	<a href="/failai/map">↗ Failų žemėlapis</a>&nbsp;
    </div>

    <div class="failaiStatistika">
        <div class="stat-row">
            <div class="stat-number">
                <%= Number(statistika.nuskaitymas.zodziai.total).displayWithSpaces() %>
            </div>
            <div class="stat-text">
                <%= Number(statistika.nuskaitymas.zodziai.total).linksniuotiOnly(["žodis", "žodžiai", "žodžių", "žodžio"]) %> teksto
            </div>
        </div>

        <div class="stat-row">
            <div class="stat-number">
                <%= Number(Number(statistika.failai.dydziai.visi * (statistika.nuskaitymas.zodziai.failaiSuZodziais / statistika.failai.kiekiai.visi)).toFixed(2)).convertUnit({from: "B", to: "GB"}) %>
            </div>
            <div class="stat-text">
                duomenų
            </div>
        </div>

        <div class="stat-row">
            <div class="stat-number">
                <%= Number(statistika.nuskaitymas.zodziai.failaiSuZodziais).displayWithSpaces() %>
            </div>
            <div class="stat-text">
                <%= Number(statistika.nuskaitymas.zodziai.failaiSuZodziais).linksniuotiOnly(["failas", "failai", "failų", "failo"]) %>
            </div>
        </div>
    </div>


    <div class="col-3 mobile-col-1">
        <section></section>
        <section style="text-align: center; font-size: 14px; color: #666; margin-bottom: 48px;">
                Teksto paieška vykdoma ieškant faile visų paminėtų žodžių. <br> Jeigu svarbu, kad žodžiai būtų iš eilės – apsupkite paieškos užklausą kabutėmis. <br><br>
        </section>
        <section></section>
    </div>
</div>
