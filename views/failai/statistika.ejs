<div id="failaiStatistika" class="mt-6">

  <p class="text-muted text-sm" style="text-align:center;">
    Statistika atnaujinta: <span data-stat="atnaujinta"><%= new Date(statistika.atnaujinta).toLtDateTime() %></span>
  </p>

  <div class="failai-statistika">
    <div class="stat-row">
      <div class="stat-number" data-stat="totalWordsNumber"><%= Number(statistika.nuskaitymas.zodziai.total).displayWithSpaces() %></div>
      <div class="stat-text" data-stat="totalWordsLabel"><%= Number(statistika.nuskaitymas.zodziai.total).linksniuotiOnly(["žodis", "žodžiai", "žodžių", "žodžio"]) %> teksto</div>
    </div>
    <div class="stat-row">
      <div class="stat-number" data-stat="dataSize"><%= Number(Number(statistika.failai.dydziai.visi * (statistika.nuskaitymas.zodziai.failaiSuZodziais / statistika.failai.kiekiai.visi)).toFixed(2)).convertUnit({from: "B", to: "GB"}) %></div>
      <div class="stat-text">duomenų</div>
    </div>
    <div class="stat-row">
      <div class="stat-number" data-stat="filesWithWordsNumber"><%= Number(statistika.nuskaitymas.zodziai.failaiSuZodziais).displayWithSpaces() %></div>
      <div class="stat-text" data-stat="filesWithWordsLabel"><%= Number(statistika.nuskaitymas.zodziai.failaiSuZodziais).linksniuotiOnly(["failas", "failai", "failų", "failo"]) %></div>
    </div>
  </div>

  <p class="text-muted text-sm mb-6" style="text-align:center; max-width:480px; margin-inline:auto;">
    Taip, statistikos duomenys ir jų pokyčiai – tikri.
  </p>

  <div class="d-flex gap-2 justify-center mb-6 flex-wrap">
    <a href="/failai/topExtension" class="btn btn-outline btn-sm">↗ Dažniausi plėtiniai</a>
    <a href="/failai/ocr" class="btn btn-outline btn-sm">↗ OCR būsena</a>
    <a href="/failai/map" class="btn btn-outline btn-sm">↗ Failų žemėlapis</a>
    <a href="/failai/neparsiunciami" class="btn btn-outline btn-sm">↗ Neparsiunčiami failai</a>
    <a href="/failai/galerija" class="btn btn-outline btn-sm">↗ Nuotraukų galerija</a>
  </div>

</div>
