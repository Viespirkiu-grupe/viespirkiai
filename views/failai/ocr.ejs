<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
    pageTitle: "OCR būsena",
    pageDescription: "",
    pageImage: `https://viespirkiai.org/failai.png`,
    customHead: ""
  }) %>
  <%- include('../js/charts.ejs') %>
</head>
<body>
  <%- include('../header.ejs', {hideSubtext: false}) %>
  <main>

    <div class="page-header">
      <h1 class="mb-0">OCR būsena</h1>
    </div>

    <% if (ocrPerMinute) { %>
    <section class="mb-16">
      <h2 class="mb-3">
        <a href="#perMinute" id="perMinute" class="no-style">Sparta (<%= ocrPerMinute.date %>)</a>
      </h2>
      <div class="grid auto-fill-180 gap-3">
        <div class="card">
          <div class="card-body">
            <div class="section-title mb-2">Dokumentai</div>
            <div class="flex items-baseline gap-1">
              <span class="cell-mono text-[1.6rem] font-semibold"><%= Number(ocrPerMinute.results).toLocaleString('lt-LT') %></span>
              <span class="text-xs text-muted font-medium">/min.</span>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="section-title mb-2">Puslapiai</div>
            <div class="flex items-baseline gap-1">
              <span class="cell-mono text-[1.6rem] font-semibold"><%= Number(ocrPerMinute.pages).toLocaleString('lt-LT') %></span>
              <span class="text-xs text-muted font-medium">/min.</span>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="section-title mb-2">Žodžiai</div>
            <div class="flex items-baseline gap-1">
              <span class="cell-mono text-[1.6rem] font-semibold"><%= Number(ocrPerMinute.words).toLocaleString('lt-LT') %></span>
              <span class="text-xs text-muted font-medium">/min.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <section class="mb-16">
      <div class="grid-2 items-start">
        <div>
          <h2 class="mb-4"><a href="#nuskaitytojai" id="nuskaitytojai" class="no-style">OCR nuskaitytojai</a></h2>
          <div class="grid auto-fill-180 gap-3 pt-1">
            <% ocrNuskaitytojai.forEach(nuskaitytojas => { %>
              <div class="card">
                <div class="card-body">
                  <div class="section-title mb-2">
                    <a href="/failai/ocr/<%= nuskaitytojas.id %>"><%= nuskaitytojas.viesasPavadinimas %></a>
                  </div>
                  <dl class="kv-list">
                    <dt>Dokumentai</dt>
                    <dd><span class="cell-mono"><%= Number(nuskaitytojas.results).toLocaleString('lt-LT') %></span></dd>
                    <dt>Puslapiai</dt>
                    <dd><span class="cell-mono"><%= Number(nuskaitytojas.pages).toLocaleString('lt-LT') %></span></dd>
                    <dt>Žodžiai</dt>
                    <dd><span class="cell-mono"><%= Number(nuskaitytojas.words).toLocaleString('lt-LT') %></span></dd>
                    <dt>Rezervacijos</dt>
                    <dd><span class="cell-mono"><%= Number(nuskaitytojas.rezervacijos).toLocaleString('lt-LT') %></span></dd>
                  </dl>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <div>
          <h2 class="mb-3"><a href="#busena" id="busena" class="no-style">Failai pagal būseną</a></h2>
          <div class="flex flex-col min-h-87.5">
            <div class="chart-frame">
              <div id="ocrStatsDiagrama" class="chart h-87.5"></div>
            </div>
          </div>
          <script defer>
            displayChart({
              element: document.querySelector('#ocrStatsDiagrama'),
              type: 'pie',
              labels: <%- JSON.stringify(ocrStats.map(s => s.text)) %>,
              series: <%- JSON.stringify(ocrStats.map(s => s.count)) %>,
              flags: ['colors'],
            });
          </script>
          <div class="table-wrapper mt-4">
            <table class="table">
              <thead>
                <tr>
                  <th class="cell-center">ID</th>
                  <th>OCR būsena</th>
                  <th class="cell-right">Failų skaičius</th>
                </tr>
              </thead>
              <tbody>
                <% ocrStats.forEach(status => { %>
                  <tr>
                    <td class="cell-mono cell-center"><%= status.id || "-" %></td>
                    <td><%= status.text %></td>
                    <td class="cell-mono cell-right"><%= status.count.toLocaleString('lt-LT') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="mb-3"><a href="#pagalNuskaitytoją" id="pagalNuskaitytoją" class="no-style">Failų dalis pagal nuskaitytoją</a></h2>
      <div class="flex flex-col min-h-87.5">
        <div class="chart-frame">
          <div id="ocrNuskaitytojaiDiagrama" class="chart h-87.5"></div>
        </div>
      </div>
      <script defer>
        const ocrNuskaitytojaiLabels = <%- JSON.stringify(ocrNuskaitytojai.map(o => o.viesasPavadinimas)) %>;
        const ocrNuskaitytojaiFiles  = <%- JSON.stringify(ocrNuskaitytojai.map(o => o.nuskaitytiDokumentai)) %>;
        displayChart({
          element: document.querySelector('#ocrNuskaitytojaiDiagrama'),
          type: 'treemap',
          labels: ocrNuskaitytojaiLabels,
          series: [{ data: ocrNuskaitytojaiLabels.map((label, i) => ({ x: label, y: ocrNuskaitytojaiFiles[i] })) }],
          flags: ["colors"]
        });
      </script>
    </section>

    <script>
      const ocrStatsDay     = <%- JSON.stringify(ocrStatsDay) %>;
      const ocrLabels       = ocrStatsDay.map(item => item.date);
      const ocrResults      = ocrStatsDay.map(item => item.results);
      const ocrResultsPages = ocrStatsDay.map(item => item.pages);
      const ocrResultsWords = ocrStatsDay.map(item => item.words);
    </script>

    <section class="grid-2">
      <div class="page-section flex flex-col min-h-87.5">
        <h2 class="mb-3"><a href="#rezultatai" id="rezultatai" class="no-style">Rezultatų skaičius</a></h2>
        <div class="chart-frame">
          <div id="ocrStatsDayDiagrama" class="chart h-87.5"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#ocrStatsDayDiagrama'),
            type: 'line-datetime',
            labels: ocrLabels,
            series: ocrResults,
            flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
          });
        </script>
      </div>

      <div class="page-section flex flex-col min-h-87.5">
        <h2 class="mb-3"><a href="#puslapiai" id="puslapiai" class="no-style">Puslapių skaičius</a></h2>
        <div class="chart-frame">
          <div id="ocrStatsDayPagesDiagrama" class="chart h-87.5"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#ocrStatsDayPagesDiagrama'),
            type: 'line-datetime',
            labels: ocrLabels,
            series: ocrResultsPages,
            flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
          });
        </script>
      </div>

      <div class="page-section flex flex-col min-h-87.5">
        <h2 class="mb-3"><a href="#zodziai" id="zodziai" class="no-style">Žodžių skaičius</a></h2>
        <div class="chart-frame">
          <div id="ocrStatsDayWordsDiagrama" class="chart h-87.5"></div>
        </div>
        <script defer>
          displayChart({
            element: document.querySelector('#ocrStatsDayWordsDiagrama'),
            type: 'line-datetime',
            labels: ocrLabels,
            series: ocrResultsWords,
            flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
          });
        </script>
      </div>
    </section>

  </main>
  <%- include('../footer.ejs') %>
</body>
</html>