<!DOCTYPE html>
<html lang="lt">
<head>
    <%- include('../head.ejs', {
        pageTitle: "OCR būsena",
        pageDescription: "",
        pageImage: `https://viespirkiai.org/failai.png`,
        customHead: ""
    }) %>
   	<%- include('../js/charts.ejs') %>
</head>
<body>
    <%- include('../header.ejs', {hideSubtext: false}) %>

    <main>
        <h1 class="center">OCR būsena</h1>
        <%- include('../tabs.ejs') %>


            <div class="col-2 mobile-col-1">
                <section>
                    <div>
                        <h2>OCR nuskaitytojai</h2><br>
                        <div class="col-2 mobile-col-1">
                            <% ocrNuskaitytojai.forEach(nuskaitytojas => { %>
                                <article class="rezultatas" aria-label="<%= nuskaitytojas.viesasPavadinimas %>">
                                    <div class="rezultatas-left">
                                        <h3 class="rezultatas-title" style="font-size: 1.4em;">
                                            <span><%= nuskaitytojas.viesasPavadinimas %></span>
                                        </h3>
                                        <div class="rezultatas-bottom">
                                            <div>
                                                <span><%= Number(nuskaitytojas.nuskaitytiDokumentai).linksniuoti(["failas", "failai", "failų", "failo"]) %></span> /
                                                <span><%= Number(nuskaitytojas.rezervacijos).linksniuoti(["rezervacija", "rezervacijos", "rezervacijų", "rezervacijos"]) %></span>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    </div>
                </section>
                <section>
                    <h2>Failai pagal būseną</h2>
                    <div class="flex mobile-block">
                    <div>
                        <table style="width: auto; min-width: 0;">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>OCR būsena</th>
                                    <th>Failų skaičius</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% ocrStats.forEach(function(status) { %>
                                    <tr>
                                        <td class="center"><%= status.id %></td>
                                        <td><%= status.tipas %></td>
                                        <td><%= status.count.toLocaleString('lt-LT') %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <div class="flex-grow-1">
                        <div id="ocrStatsDiagrama" class="chart" style="width: 100%; height: 400px;"></div>
                        <script defer>
                        let ocrStatsLabels = <%- JSON.stringify(ocrStats.map(status => status.tipas)) %>;
                        let ocrStatsCounts = <%- JSON.stringify(ocrStats.map(status => status.count)) %>;

                        displayChart({
                            element: document.querySelector('#ocrStatsDiagrama'),
                            type: 'pie',
                            labels: ocrStatsLabels,
                            series: ocrStatsCounts,
                            flags: ['colors'],
                            customOptions: {
                              yaxis: {
                                  min: 0,
                                  labels: {
                                      formatter: function (value) {
                                      if(typeof value == "number"){
                                          return value.toLocaleString('lt-LT');
                                      }else{
                                          return "Nėra duomenų";
                                      }
                                      }
                                  },
                              }
                            }
                        })
                        </script>
                    </div>
                    </div>
                    <h2>Failų dalis pagal nuskaitytoją</h2>
                    <div id="ocrNuskaitytojaiDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                    let ocrNuskaitytojaiLabels = <%- JSON.stringify(ocrNuskaitytojai.map(o => o.viesasPavadinimas)) %>
                    let ocrNuskaitytojaiFiles = <%- JSON.stringify(ocrNuskaitytojai.map(o => o.nuskaitytiDokumentai)) %>

                      // Merge into one [], {x: label, y: fileCount}
                    let ocrNuskaitytojaiData = ocrNuskaitytojaiLabels.map((label, index) => {
                        return { x: label, y: ocrNuskaitytojaiFiles[index] };
                    });

                    displayChart({
                        element: document.querySelector('#ocrNuskaitytojaiDiagrama'),
                        type: 'treemap',
                        labels: ocrNuskaitytojaiLabels,
                        series: [
                          {
                            data: ocrNuskaitytojaiData
                          }
                        ],
                        customOptions: {
                          yaxis: {
                              min: 0,
                              labels: {
                                  formatter: function (value) {
                                  if(typeof value == "number"){
                                      return value.toLocaleString('lt-LT');
                                  }else{
                                      return "Nėra duomenų";
                                  }
                                  }
                              },
                          }
                        }
                    })
                    </script>
                </section>
                <section>
                    <h2>Rezultatų skaičius</h2>
                    <div id="ocrStatsDayDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                    let ocrStatsDay = <%- JSON.stringify(ocrStatsDay) %>;
                    let ocrLabels = ocrStatsDay.map(item => item.date);
                    let ocrResults = ocrStatsDay.map(item => item.results);

                    displayChart({
                        element: document.querySelector('#ocrStatsDayDiagrama'),
                        type: 'line-datetime',
                        labels: ocrLabels,
                        series: ocrResults,
                        flags: ['yMin0', 'xAxisDay'],
                        customOptions: {
                        yaxis: {
                            min: 0,
                            labels: {
                                formatter: function (value) {
                                if(typeof value == "number"){
                                    return value.toLocaleString('lt-LT');
                                }else{
                                    return "Nėra duomenų";
                                }
                                }
                            },
                        }
                        }
                    })
                    </script>
                </section>
                <section>
                    <h2>Puslapių skaičius</h2>
                    <div id="ocrStatsDayPagesDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                    let ocrResultsPages = ocrStatsDay.map(item => item.pages);

                    displayChart({
                        element: document.querySelector('#ocrStatsDayPagesDiagrama'),
                        type: 'line-datetime',
                        labels: ocrLabels,
                        series: ocrResultsPages,
                        flags: ['yMin0', 'xAxisDay'],
                        customOptions: {
                        yaxis: {
                            min: 0,
                            labels: {
                                formatter: function (value) {
                                if(typeof value == "number"){
                                    return value.toLocaleString('lt-LT');
                                }else{
                                    return "Nėra duomenų";
                                }
                                }
                            },
                        }
                        }
                    })
                    </script>
                </section>
                <section>
                    <h2>Žodžių skaičius</h2>
                    <div id="ocrStatsDayWordsDiagrama" class="chart" style="width: 100%; height: 400px;"></div>

                    <script defer>
                    let ocrResultsWords = ocrStatsDay.map(item => item.words);

                    displayChart({
                        element: document.querySelector('#ocrStatsDayWordsDiagrama'),
                        type: 'line-datetime',
                        labels: ocrLabels,
                        series: ocrResultsWords,
                        flags: ['yMin0', 'xAxisDay'],
                        customOptions: {
                        yaxis: {
                            min: 0,
                            labels: {
                                formatter: function (value) {
                                if(typeof value == "number"){
                                    return value.toLocaleString('lt-LT');
                                }else{
                                    return "Nėra duomenų";
                                }
                                }
                            },
                        }
                        }
                    })
                    </script>
                </section>
                <section>

                </section>
            </div>
    </main>

    <%- include('../footer.ejs') %>
</body>
</html>
