<!DOCTYPE html>
<html lang="lt">
	<head>
    	<%- include('../head.ejs', {
            pageTitle: "Failų paieška",
            pageDescription: ``,
            pageImage: `https://viespirkiai.org/failai.png`,
            customHead
        }) %>
        <%- include('../js/idiomorph.ejs') %>
       	<%- include('../js/charts.ejs') %>
        <style>
        .failaiStatistika {
            display: flex;
            flex-direction: column;
            gap: 48px;
            margin-block: 24px;
            align-items: center;
            width: 100%;
        }

        .failaiStatistika .stat-row {
            display: flex;
            flex-direction: column;
        }

        .failaiStatistika .stat-number {
            font-size: 5em;
            font-weight: bold;
        }

        @media (max-width: 600px) {
            .failaiStatistika .stat-number {
                font-size: 3em;
            }
        }

        .failaiStatistika .stat-text {
            font-size: 1.4em;
        }


        .failaiStatistika .stat-row:nth-child(1) {
            transform: translateX(0vw);
        }

        .failaiStatistika .stat-row:nth-child(2) {
            transform: translateX(15vw);
        }

        .failaiStatistika .stat-row:nth-child(3) {
            transform: translateX(-10vw);
        }


        </style>
	</head>
	<body>
		<%- include('../header.ejs', {hideSubtext: false}) %>
		<main>
			<%- include('search.ejs', {values}) %>
			<section id="failaiRezultatai" class="results">
                <% if(typeof data !== "undefined") { %>
    			    <%- include('results.ejs', {data, currentPage, pageCount, queryParams, galimaEksportuoti, search}) %>
                <% } else { %>
                    <%- include('statistika.ejs') %>
                    <script>
                        window.addEventListener('DOMContentLoaded', () => {
                          const search = document.getElementById('search');
                          if (search) search.focus();
                        });

                        let evtSource;

                        const connect = () => {
                            evtSource = new EventSource("/failai/statistika/sse");

                            evtSource.onmessage = (e) => {
                                const html = JSON.parse(e.data);
                                const target = document.getElementById("failaiStatistika");
                                if (target) {
                                    Idiomorph.morph(target, html);
                                }
                            };

                            evtSource.onerror = () => {
                                evtSource.close();
                                setTimeout(connect, 2000);
                            };
                        };

                        connect();
                    </script>
                <% } %>
			</section>
		</main>
		<%- include('../footer.ejs') %>
	</body>
</html>
