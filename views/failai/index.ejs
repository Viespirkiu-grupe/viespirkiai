<!DOCTYPE html>
<html lang="lt">
	<head>
    	<%- include('../head.ejs', {
            pageTitle: "Failų paieška",
            pageDescription: ``,
            pageImage: `https://viespirkiai.org/failai.png`,
            customHead
        }) %>
        <%- include('../js/idiomorph.ejs') %>
	</head>
	<body>
		<%- include('../header.ejs', {hideSubtext: false}) %>
		<main>
			<%- include('search.ejs', {values}) %>
			<section id="failaiRezultatai" class="results">
                <% if(typeof data !== "undefined") { %>
    			    <%- include('results.ejs', {data, currentPage, pageCount, queryParams, galimaEksportuoti, search}) %>
                <% } else { %>
                    <script>
                      window.addEventListener('DOMContentLoaded', () => {
                        const search = document.getElementById('search');
                        if (search) search.focus();
                      });
                    </script>
             		<%- include('statistika.ejs') %>
                    <script>
                        let evtSource;

                        const connect = () => {
                            evtSource = new EventSource("/failai/statistika/sse");

                            evtSource.onmessage = (e) => {
                                const html = JSON.parse(e.data);
                                const target = document.getElementById("failaiStatistika");
                                if (target) {
                                    Idiomorph.morph(target, html);
                                }
                            };

                            evtSource.onerror = () => {
                                evtSource.close();
                                setTimeout(connect, 2000);
                            };
                        };

                        connect();
                    </script>
                <% } %>
			</section>
		</main>
		<%- include('../footer.ejs') %>
	</body>
</html>
