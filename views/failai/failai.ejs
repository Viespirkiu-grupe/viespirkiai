<!DOCTYPE html>
<html>
	<head>
    	<%- include('../head.ejs', {
            pageTitle: "Failų parsisiuntimo statistika",
            pageDescription: ` `,
            pageImage: `https://viespirkiai.top/failas.png`,
            customHead
        }) %>
	</head>
	<body>
		<%- include('../header.ejs') %>
		<main>
			<h1>Failų parsiuntimo statistika</h1>

            <p>Šioje skiltyje galite rasti informaciją apie failų parsiuntimo būseną. Numatomi skaičiai pažymėti su *.</p>

            <i>Duomenys atnaujinti: <%= statistika.atnaujinta.toLtDateTime() %> </i>

            <div class="failu-statistika">
                <section style="grid-area: visi;">
                    <h2><u>Visi failai</u></h2>
                    <h3>Kiekis</h3>
                    <p><%= statistika.kiekiai.visi %></p>
                    <h3>Dydis*</h3>
                    <p><%= statistika.dydziai.visi %></p>
                </section>

                <section style="grid-area: parsiusti;">
                    <h2><u>Parsiųsti failai</u></h2>
                    <h3>Kiekis</h3>
                    <p><%= statistika.kiekiai.parsiusti %></p>
                    <h3>Dydis</h3>
                    <p><%= statistika.dydziai.parsiusti %></p>
                </section>

                <section style="grid-area: klaida;">
                    <h2><u>Neparsiųsti (klaida) failai</u></h2>
                    <h3>Kiekis</h3>
                    <p><%= statistika.kiekiai.klaida %></p>
                    <h3>Dydis*</h3>
                    <p><%= statistika.dydziai.klaida %></p>
                </section>

                <section style="grid-area: neparsiusti;">
                    <h2><u>Neparsiųsti failai</u></h2>
                    <h3>Kiekis</h3>
                    <p><%= statistika.kiekiai.neparsiusti %></p>
                    <h3>Dydis*</h3>
                    <p><%= statistika.dydziai.neparsiusti %></p>
                </section>

                <section style="grid-area: diagrama;">
                    <div id="failuPieChart" style="width: 100%; height: auto; min-height: 400px;"></div>

                    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js" defer></script>
                    <script defer>
                      function getCssColor(selector) {
                        const el = document.querySelector(selector);
                        if (!el) return '#000'; // fallback
                        return getComputedStyle(el).color || '#000';
                      }

                      window.addEventListener('load', () => {
                          // Load the Visualization API and the corechart package.
                          google.charts.load('current', { packages: ['corechart'] });

                          // Set a callback to run when the Google Visualization API is loaded.
                          google.charts.setOnLoadCallback(drawChart);

                          function drawChart() {
                          // Create the data table.
                          const data = google.visualization.arrayToDataTable([
                              ['Status', 'Kiekis'],
                              ['Parsiųsti', <%= statistika.kiekiai.parsiusti %>],
                              ['Neparsiųsti', <%= statistika.kiekiai.neparsiusti %>],
                              ['Klaida', <%= statistika.kiekiai.klaida %>]
                          ]);

                          // Set chart options
                          const textColor = getCssColor('body');  // or your container selector
                          const options = {
                              pieHole: 0.4,
                              legend: {
                                  position: 'bottom',
                                  textStyle: { color: textColor }, // light gray text for dark background
                              },
                              chartArea: { left: 20, top: 20, width: '90%', height: '80%' },
                              sliceVisibilityThreshold: 0,
                              backgroundColor: 'transparent',
                              colors: ['#28a745', '#ffc107', '#dc3545']  // green, yellow, red
                          };

                          // Instantiate and draw our chart, passing in some options.
                          const chart = new google.visualization.PieChart(document.getElementById('failuPieChart'));
                          chart.draw(data, options);
                          }
                      });
                    </script>
                </section>
            </div>
		</main>
		<%- include('../footer.ejs') %>
	</body>
</html>
