<!DOCTYPE html>
<html lang="lt" class="<%= colorScheme === 'dark' ? 'dark' : '' %>">
<head>
  <%- include('../head.ejs', {
    pageTitle: "Dažniausi failų plėtiniai",
    pageDescription: "",
    pageImage: `https://viespirkiai.org/failai.png`,
    customHead: ""
  }) %>
</head>
<body>
  <%- include('../header.ejs', {hideSubtext: false}) %>
  <main>
      <div class="page-header">
        <h1 class="mb-0">Dažniausi failų plėtiniai</h1>

        <div class="flex justify-between items-center mb-4">
          <span class="text-muted text-sm numberOfResults"><%- numberOfResults %></span>
        </div>
      </div>

    <div class="grid gap-3 [grid-template-columns:repeat(auto-fill,minmax(200px,1fr))]">
      <% extension.forEach(item => { %>
        <article class="card card-clickable">
          <div class="card-body">
              <h3 class="text-xl fw-bold cell-mono mb-3 mt-1">
                <a href="/failai?extension=<%= item.extension %>">
                  <%= item.extension %><% if (!item.extension) { %>&#8203;<% } %>
                </a>
              </h3>

              <p class="text-muted text-sm mb-0"><%= Number(item.count).linksniuoti(["failas", "failai", "failų", "failo"]) %></p>
          </div>
        </article>
      <% }) %>
    </div>

    <%- include('../pagination.ejs', { currentPage, pageCount, queryParams }) %>
  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
