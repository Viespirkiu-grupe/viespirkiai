<!DOCTYPE html>
<html lang="lt">
<head>
  <%- include('../head.ejs', {
    pageTitle: "Dažniausi failų plėtiniai",
    pageDescription: "",
    pageImage: `https://viespirkiai.org/failai.png`,
    customHead: ""
  }) %>
</head>
<body>
  <%- include('../header.ejs', {hideSubtext: false}) %>
  <main>
      <div class="page-header">
        <h1 class="mb-0">Dažniausi failų plėtiniai</h1>

        <div class="flex justify-between items-center mb-4">
          <span class="text-muted text-sm numberOfResults"><%- numberOfResults %></span>
        </div>
      </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--space-3);">
      <% extension.forEach(item => { %>
        <article class="card card-clickable">
          <a href="/failai?extension=<%= item.extension %>" class="card-overlay-link"><%= item.extension %></a>
          <div class="card-body">
              <h3 class="text-xl fw-bold cell-mono mb-3 mt-1"><%= item.extension %><% if (!item.extension) { %>&#8203;<% } %></h3>
              <p class="text-muted text-sm mb-0"><%= Number(item.count).linksniuoti(["failas", "failai", "failų", "failo"]) %></p>
          </div>
        </article>
      <% }) %>
    </div>

    <%- include('../pagination.ejs', { currentPage, pageCount, queryParams }) %>
  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
