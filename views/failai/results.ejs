<div>
    <section class="preResultOptions">
      <div class="numberOfResults">
        <%- numberOfResults %>
      </div>
    </section>
    <% data.forEach(item => { %>
        <div class="rezultatas">
            <div class="rezultatas-top">
                <span><%= item.extension.toUpperCase() %></span>
                <span><%= item.dydis.convertUnit("B") %></span>
                <% if(item.metaduomenys.pageCount){ %>
                    <span><%= Number(item.metaduomenys.pageCount).toLocaleString("lt-LT") || "-" %> p.</span>
                <% } %>
                <span><%= Number(item.zodziuSkaicius).toLocaleString("lt-LT") || "-" %> ž.</span>
            </div>
            <div class="rezultatas-title">
                <a href="/failas/<%= item.dokId %>/<%= item.fileId %>?search=<%= encodeURIComponent(search) %>">
                    <span>
                        <%= item.metaduomenys.Title || item.pavadinimas %>
                    </span>
                </a>
            </div>
            <div class="rezultatas-bottom">
                <div style="text-align: justify;" class="excerpt">
                    <%- item.excerpt %>
                </div>
                <div>
                    <a href="/pirkimas/<%= item.dokId %>">↗ Sutartis</a>
                </div>
            </div>
        </div>
    <% }); %>
</div>

<script>
			const span = document.querySelector('.rezultatai-nezinomas-total');

             if (span && !span.classList.contains('spin')) {
                 span.classList.add('spin');

                 const url = new URL(window.location.href);
                 url.searchParams.set('rezultatuSkaiciausPatikslinimas', 'true');

                 // Get data-duration from pre in .numberOfResults
                 const trukme = document.querySelector('.numberOfResults pre')?.getAttribute('data-duration');
                 console.log(document.querySelector('.numberOfResults pre'))
                 if (trukme) {
                     url.searchParams.set('trukme', trukme);
                 }

                 fetch(url)
                     .then(res => res.json())
                     .then(data => {
                         if (data.zinomasRezultatuSkaicius) {
                             span.className = ''; // remove all classes
                             document.querySelector(".numberOfResults").innerHTML = data.numberOfResults;
                         } else {
                             span.classList.remove('spin'); // stop spinning if still unknown
                         }
                     })
                     .catch(() => span.classList.remove('spin')); // stop spinning on error
             }
			</script>

<%- include('../pagination.ejs', {
    currentPage, pageCount, queryParams
}) %>
