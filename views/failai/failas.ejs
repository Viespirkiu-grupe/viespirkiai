<!DOCTYPE html>
<html lang="lt">
	<head>
	<%- include('../head.ejs', {
        pageTitle: "Failas",
        pageDescription: ``,
        pageImage: `https://viespirkiai.org/failai.png`,
        customHead
    }) %>
	</head>
	<body>
		<%- include('../header.ejs', {hideSubtext: false}) %>
		<main>
            <% if(failas.metaduomenys && failas.metaduomenys.Title) { %>
			    <i><%= failas.pavadinimas %></i>
				<h1>
				    <%= failas.metaduomenys.Title %>
				</h1>
			<% } else { %>
    			<h1>
    			    <%= failas.pavadinimas %>
    			</h1>
			<% } %>
		    <div class="col-2-strict mobile-col-1" style="gap: 16px;">
				<section>
    				<div>
         			    <a href="/failas/<%= failas.id %>.json">↗ JSON</a>
    				</div>
                    <div>
                       <h2 style="margin-bottom: 0px;"><u>Failas</u></h2>
                       <div class="col-2-strict">
                           <div>
                               <h3>Formatas</h3>
                               <%= failas.extension %>
                           </div>
                           <div>
                               <h3>Dydis</h3>
                                <% if(failas.dydis || failas.dydis == 0) { %>
                                    <%= failas.dydis.convertUnit("B") %>
                                <% } else { %>
                                   -
                                <% } %>
                           </div>
                           <div>
                               <h3>MD5</h3>
                               <span style="overflow-wrap: anywhere; font-family: monospace;"><%= failas.md5 || "-" %></span>
                           </div>
                           <div>
                               <h3>Šaltinis</h3>
                               <% var originalusLinkas = null; %>
                               <% var originalusLinkasPavadinimas = null; %>
                               <% if(failas.saltinis == "sutartys" || !failas.saltinis){ %>
                                   <a href="/sutartis/<%= failas.dokId %>">Sutartis <%= failas.dokId %></a>
                                   <% originalusLinkas = `https://eviesiejipirkimai.lt/download.php?dok_id=${failas.dokId}&file_id=${failas.fileId}`; %>
                                   <% originalusLinkasPavadinimas = "CVP IS"; %>
                               <% } else if(failas.saltinis == "neskelbiamosDerybos") { %>
                                    <a href="/neskelbiamos">Neskelbiamos derybos</a>
                                    <% originalusLinkas = `https://eviesiejipirkimai.lt/${failas.saltinioId}`; %>
                                    <% originalusLinkasPavadinimas = "CVP IS"; %>
                                <% } else if(failas.saltinis == "archive") { %>
                                    <a href="/failas/<%= failas.parent %>">Archyvo <%= failas.parent %> viduje</a>
                                    <% originalusLinkas = `/failas/${failas.parent}`; %>
                                    <% originalusLinkasPavadinimas = "Archyvas"; %>
                                <% } else if(failas.saltinis == "cvpIs") { %>
                                    <% let pirkimoId = failas.saltinioId.split('/')[0]; %>
                                    <% let documentId = failas.saltinioId.split('/')[1]; %>
                                    <% let versionId = failas.saltinioId.split('/')[2]; %>
                                    <a href="https://viesiejipirkimai.lt/epps/cft/listContractDocuments.do?resourceId=<%= pirkimoId %>">Viešasis pirkimas <%= pirkimoId %></a>
                                    <% originalusLinkas = `https://viesiejipirkimai.lt/epps/cft/downloadDocumentVersion.do?versionId=${versionId}&documentId=${documentId}`; %>
                                    <% originalusLinkasPavadinimas = "CVP IS"; %>
                                <% } %>
                           </div>
                       </div>
                    </div>
                    <% if(failas.metaduomenys) { %>
                    <div>
                       <h2 style="margin-bottom: 0px;"><u>Dokumentas</u></h2>
                       <div class="col-2">
                           <div>
                               <h3>Puslapių skaičius</h3>
                               <%= failas.metaduomenys.pageCount || "-" %>
                           </div>
                           <div>
                               <h3>Žodžių skaičius</h3>
                               <%= failas.metaduomenys.wordCount || "-" %>
                           </div>
                           <div>
                               <h3>Programa</h3>
                               <%= failas.metaduomenys.Producer || "-" %>
                           </div>
                           <div>
                               <h3>Autorius</h3>
                               <%= failas.metaduomenys.Author || "-" %>
                           </div>
                       </div>
                    </div>
                    <div>
                       <h2 style="margin-bottom: 0px;"><u>Turinys</u></h2>
                       <div style="width: 100%; max-width: 90vw;">
                           <div>
                               <h3>Interneto puslapiai</h3>
                               <% if(failas.metaduomenys.domains){ %>
                                    <% failas.metaduomenys.domains
                                        .forEach(domain => { %>
                                        <div>
                                            <a href="https://<%= domain %>" target="_blank" title="<%= domain %>"
                                                style="flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <%= domain %>
                                            </a>
                                        </div>
                                    <% }) %>
                                <% } %>
                               <% if(!failas.metaduomenys.domains || failas.metaduomenys.domains.length == 0) { %>
                                   <div>
                                       <i>Interneto puslapių dokumente nerasta</i>
                                   </div>
                               <% } %>
                           </div>
                           <div>
                               <h3>Nuorodos</h3>
                               <% if(failas.metaduomenys.links){ %>
                                <% failas.metaduomenys.links
                                    .filter(link => !link.uri.startsWith('mailto:'))
                                    .forEach(link => { %>
                                    <div style="display: flex; flex-wrap: nowrap; overflow: hidden; white-space: nowrap; align-items: center;">
                                        <a href="<%= link.uri %>" target="_blank" title="<%= link.uri %>"
                                            style="flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <%= link.uri %>
                                        </a>
                                        <sup style="flex-shrink: 0; margin-left: 4px;">
                                            <%= link.pages.join(', ') %> psl.
                                        </sup>
                                    </div>
                                <% }) %>
                                 <% } %>
                               <% if(!failas.metaduomenys.links || failas.metaduomenys.links.length == 0) { %>
                                   <div>
                                       <i>Nuorodų dokumente nerasta</i>
                                   </div>
                               <% } %>
                           </div>
                           <div>
                               <h3>El. pašto adresai</h3>
                               <% if(failas.metaduomenys.emails){ %>
                               <% failas.metaduomenys.emails.forEach(email => { %>
                                      <div>
                                          <a href="mailto:<%= email.email %>"><%= email.email %></a>
                                          <sup>
                                              <%= email.pages.join(', ') %> psl.
                                          </sup>
                                      </div>
                                <% }) %>
                                 <% } %>
                               <% if(!failas.metaduomenys.emails || failas.metaduomenys.emails.length == 0) { %>
                                   <div>
                                       <i>El. p. adresų dokumente nerasta</i>
                                   </div>
                               <% } %>
                           </div>
                           <div>
                               <h3>Telefono numeriai</h3>
                               <% if(failas.metaduomenys.telefonai){ %>
                                <% failas.metaduomenys.telefonai
                                    .forEach(telefonas => { %>
                                    <div style="display: flex; flex-wrap: nowrap; overflow: hidden; white-space: nowrap; align-items: center;">
                                        <a href="tel:<%= telefonas.numeris %>" target="_blank" title="<%= telefonas.numeris %>"
                                            style="flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <%= telefonas.numeris %>
                                        </a>
                                        <sup style="flex-shrink: 0; margin-left: 4px;">
                                            <%= telefonas.pages.join(', ') %> psl.
                                        </sup>
                                    </div>
                                <% }) %>
                               <% } %>
                               <% if(!failas.metaduomenys.telefonai || failas.metaduomenys.telefonai.length == 0) { %>
                                   <div>
                                       <i>Telefono numerių dokumente nerasta</i>
                                   </div>
                               <% } %>
                           </div>
                           <div>
                               <% if(failas.metaduomenys.ibanNumeriai && failas.metaduomenys.ibanNumeriai.length > 0 && failas.metaduomenys.ibanNumeriai[0].pages){ %>
                                <h3>IBAN numeriai</h3>
                                <% failas.metaduomenys.ibanNumeriai
                                    .forEach(iban => { %>
                                    <div style="display: flex; flex-wrap: nowrap; overflow: hidden; white-space: nowrap; align-items: center;">
                                        <a href="iban:<%= iban.numeris %>" target="_blank" title="<%= iban.numeris %>"
                                            style="flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <%= iban.numeris %>
                                        </a>
                                        <sup style="flex-shrink: 0; margin-left: 4px;">
                                            <%= iban.pages.join(', ') %> psl.
                                        </sup>
                                    </div>
                                <% }) %>
                                 <% } %>
                               <% if(!failas.metaduomenys.ibanNumeriai || failas.metaduomenys.ibanNumeriai.length == 0) { %>
                                   <div>
                                       <i>IBAN numerių dokumente nerasta</i>
                                   </div>
                               <% } %>
                           </div>
                           <div>
                               <h3>Parašai</h3>
                               <i>Viešpirkiai netikrina skaitmeninių parašų galiojimo.</i>
                                <% if(failas.metaduomenys.signatures){ %>
                                    <% failas.metaduomenys.signatures
                                        .forEach(signature => { %>
                                        <div>
                                                <h4><%= signature.signerCertificateCommonName %></h4>
                                                <%= signature.signingTime %>
                                        </div>
                                    <% }) %>
                                <% } %>
                               <% if(!failas.metaduomenys.signatures || failas.metaduomenys.signatures.length == 0) { %>
                                   <div>
                                       <i>Parašų dokumente nerasta</i>
                                   </div>
                               <% } %>
                           </div>
                       </div>
                    </div>
                    <% } else { %>
                        <div style="text-align: center; margin-block: 64px;">
                            <i>Dokumento metaduomenų nėra</i>
                        </div>
                    <% } %>
                    <br>
				</section>
				<section>
				    <% failas.extension = failas.extension.toLowerCase(); %>
					<% const libreFormats = ["doc", "docx", "odt", "rtf", "xls", "xlsx", "xlsb", "ods", "ppt", "pptx", "ppsx", "odp", "odg", "pub", "pages", "xlt", "dot", "docm", "dotx"]; %>
				    <% if(failas.extension === "pdf" || failas.extension === "prn" || libreFormats.includes(failas.extension)) { %>
                    <% let pdfSearch = query.search || ''; %>
  				    <div>
                          <a href="/dist/pdfjs/web/viewer.html?file=<%= encodeURIComponent(`/failas/${failas.id}/preview`) %>#search=<%= encodeURIComponent(pdfSearch) %>">↗ Padidinti</a>
                          &nbsp;
                          <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                          &nbsp;
                          <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                              <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                              &nbsp;
                          <% } %>
                      </div>
                      <div>
                    <% if(libreFormats.includes(failas.extension)) { %>
                        <br><i>Dokumentas buvo konvertuotas į PDF formatą naudojant LibreOffice, todėl gali būti atvaizduojamas iškraipytas.</i>
                    <% } %>
                          <iframe
                      src="/dist/pdfjs/web/viewer.html?file=<%= encodeURIComponent(`/failas/${failas.id}/preview`) %>#search=<%= encodeURIComponent(pdfSearch) %>"
                      width="100%"
                      height="800"
                      style="border: none; height: 70vh; margin-block: 16px; width: 100% !important; max-width: 100% !important; box-sizing: border-box; display: block; overflow-x: hidden !important;"
                      ></iframe>
                      </div>
                    <% } else if (failas.nuskaitytas > 0 && (failas.extension == "zip" || failas.extension == "7z" || failas.extension == "rar" || failas.extension == "adoc")){ %>
                        <div>
                            <div>
                                <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                                &nbsp;
                                <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                    <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                    &nbsp;
                                <% } %>
                            </div>
                            <div style="margin-block: 16px;">
                                <i>Archyvo peržiūra <sup>BETA</sup></i>
                            </div>
                            <% function renderFiles(files) { %>
                              <% files.forEach(file => { %>
                                <% if (file.isDirectory) { %>
                                  <details open style="padding-block: 4px;">
                                    <summary><%= file.name %></summary>
                                    <div style="padding-left: 20px;">
                                      <% if (file.children && file.children.length) { %>
                                        <%- renderFiles(file.children) %>
                                      <% } %>
                                    </div>
                                  </details>
                                <% } else { %>
                                  <div style="padding-block: 4px;">
                                      <% if(file.id) { %>
                                          <a href="/failas/<%= file.id %>">
                                              <%= file.name %>
                                          </a>
                                      <% } else { %>
                                        <a href="https://failai.viespirkiai.org/<%= failas.id %>/<%= file.path %>" target="_blank">
                                            <%= file.name %>
                                        </a>
                                      <% } %>
                                      (<%= file.extension %>, <%= (file.size / 1024).toFixed(1) %> KB)
                                  </div>
                                <% } %>
                              <% }) %>
                            <% } %>

                            <% if (failas.metaduomenys && failas.metaduomenys.filesTree) { %>
                              <%- renderFiles(failas.metaduomenys.filesTree) %>
                            <% } %>


                        </div>

                    <% } else if(failas.extension == "mp4") { %>
                        <div>
                            <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                            &nbsp;
                            <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                &nbsp;
                            <% } %>
                        </div>
                        <div style="margin-top: 16px;">
                            <video width="100%" height="auto" controls style="max-height: 70vh; margin-top: 16px;">
                                <source src="https://failai.viespirkiai.org/<%= failas.id %>" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    <% } else if(["jpg", "jpeg", "png", "bmp", "gif", "tif", "tiff", "jfif", "heic", "webp"].includes(String(failas.extension).toLowerCase())) { %>
                            <div>
                                <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                                &nbsp;
                                <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                    <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                    &nbsp;
                                <% } %>
                            </div>
                            <div style="margin-top: 16px;">
                                <% let convertString = "";
                                if(["heic"].includes(String(failas.extension).toLowerCase())){
                                  convertString = `?convertTo=jpeg`
                                }
                                %>
                                <img src="https://failai.viespirkiai.org/<%= failas.id %><%= convertString %>" alt="" style="max-width: 100%; margin-top: 16px;">
                            </div>
                    <% } else if(failas.extension == "url") { %>
                        <div>
                            <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                            &nbsp;
                            <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                &nbsp;
                            <% } %>
                        </div>
                        <div style="margin-top: 16px;">
                            <h3>Nuoroda</h3>
                            <% if (failas.metaduomenys?.links?.[0]?.uri) { %>
                              <a href="<%= encodeURI(failas.metaduomenys.links[0].uri) %>">
                                <%= failas.metaduomenys.links[0].uri %>
                              </a>
                            <% } else { %>
                              <i>Nenurodyta</i>
                            <% } %>
                        </div>
                    <% } else if(failas.extension == "txt") { %>
                        <div>
                            <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                            &nbsp;
                            <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                &nbsp;
                            <% } %>
                        </div>
                        <div style="margin-top: 16px; max-width: 90vw; overflow-x: auto; background-color: var(--lighter-gray); padding: 16px; border-radius: 8px;">
                            <%
                           if(failas.tekstas){
                                failas.tekstas = failas.tekstas.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
                           }
                           // Try to parse file tekstas as an array, add hr between pages
                           try {
                               let pages = JSON.parse(failas.tekstas);
                               if(Array.isArray(pages)){
                                   failas.tekstas = pages.map((pageText, index) => {
                                       return pageText;
                                   }).join('');
                               }
                           } catch(e) {
                               // Not an array, do nothing
                           }
                            %>
                            <pre style="white-space: pre-wrap; word-wrap: break-word;"><%= failas.tekstas || "" %></pre>
                        </div>
                    <% } else if(failas.extension == "html" || failas.extension == "htm" || failas.extension == "svg") { %>
                        <div>
                            <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                            &nbsp;
                            <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                &nbsp;
                            <% } %>
                        </div>
                        <div style="margin-top: 16px; max-width: 90vw; overflow-x: auto; background-color: var(--lighter-gray); padding: 16px; border-radius: 8px;">
                            <iframe
                              src="https://failai.viespirkiai.org/<%= failas.id %>"
                              width="100%"
                              height="600"
                              style="border: none; margin-top: 16px;"
                            ></iframe>
                        </div>
                    <% } else if((failas.extension == "eml" || failas.extension == "msg") && failas.metaduomenys) { %>
                        <div>
                            <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                            &nbsp;
                            <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                &nbsp;
                            <% } %>
                        </div>
                        <div style="margin-top: 16px; max-width: 90vw; overflow-x: auto; background-color: var(--lighter-gray); padding: 16px; border-radius: 8px;">
                            <div>
                                <h2 style="margin-block: 0;"><u><%= failas.metaduomenys.subject || "-" %></u></h2><br>

                                <b>Nuo:</b> <%= failas.metaduomenys?.from?.name || "-" %> &lt;<a href="mailto:<%= failas.metaduomenys?.from?.email || "-" %>"><%= failas.metaduomenys.from.email || "-" %></a>&gt;<br>
                                <% if(!Array.isArray(failas.metaduomenys.to)) { %>
                                    <b>Kam:</b> <%= failas.metaduomenys.to.name || "-" %> &lt;<a href="mailto:<%= failas.metaduomenys.to.email || "-" %>"><%= failas.metaduomenys.to.email || "-" %></a>&gt;<br>
                                <% } else { %>
                                    <% failas.metaduomenys.to.forEach(to => { %>
                                        <b>Kam:</b> <%= to.name || "-" %> &lt;<a href="mailto:<%= to.email || "-" %>"><%= to.email || "-" %></a>&gt;<br>
                                    <% }) %>
                                <% } %>

                                <b>Data:</b> <%= new Date(failas.metaduomenys.date || failas.metaduomenys.messageDeliveryTime).toLtDateTime() || "-" %><br>

                                <% if(failas.metaduomenys.html){ %>
                                    <div style="margin-top: 16px; padding: 8px; border-radius: 4px;">
                                        <iframe
                                            srcdoc="<%= String(failas.metaduomenys.html).replace(/"/g, '&quot;') %>"
                                            width="100%"
                                            height="400"
                                            style="border: none;"
                                        ></iframe>
                                    </div>
                                <% } else { %>
                                    <div style="font-family: monospace; white-space: pre-wrap; word-wrap: break-word; margin-top: 16px; border-top: 1px solid var(--gray); padding-top: 16px;">
                                        <%- (failas.metaduomenys.text || failas.metaduomenys.body || "")
                                            .replace(/</g, "&lt;")
                                            .replace(/>/g, "&gt;")
                                            .replace(/\r?\n/g, "<br>") %>
                                    </div>
                                <% } %>

                                <% if(failas.metaduomenys.attachments) { %>
                                    <h2>Priedai</h2>
                                    <% failas.metaduomenys.attachments.forEach(attachment => { %>
                                        <div style="margin-top: 8px;">
                                            <a href="https://failai.viespirkiai.org/<%= failas.id %>/<%= attachment.name %>" target="_blank">
                                                <%= attachment.name %>
                                            </a>
                                        </div>
                                    <% }) %>

                                <% } %>
                            </div>
                        </div>
                    <% } else { %>
                        <div>
                            <a href="https://failai.viespirkiai.org/<%= failas.id %>">↗ Failas</a>
                            &nbsp;
                            <% if(originalusLinkas && originalusLinkasPavadinimas) { %>
                                <a href="<%= originalusLinkas %>">↗ <%= originalusLinkasPavadinimas %></a>
                                &nbsp;
                            <% } %>
                        </div>
                        <div style="margin-top: 16px;">
                            <i>Peržiūra nepalaikoma šio formato failams. Spustelėkite nuorodą „Failas“, jei norite jį atsisiųsti.</i>
                        </div>
                    <% } %>
				</section>
			</div>
		</main>
		<%- include('../footer.ejs') %>
	</body>
</html>
