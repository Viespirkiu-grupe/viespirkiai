<!DOCTYPE html>
<html lang="lt">
<head>
  <%- include('../head.ejs', {
    pageTitle: "Failas",
    pageDescription: ``,
    pageImage: `https://viespirkiai.org/failai.png`,
    customHead
  }) %>
  <style>
    .failas-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-5);
      align-items: start;
    }
    @media (max-width: 900px) {
      .failas-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 900px) {
      .failas-grid iframe {
        height: 50vh;
      }
    }

    @media (max-width: 900px) {
      .failas-grid {
        grid-template-columns: 1fr;
      }
      .failas-grid > div:last-child {
        order: -1;
      }
      .failas-grid iframe {
        height: 50vh;
      }
    }
  </style>
  <% if (failas.location) { %>
    <%- include('../partials/map-point-head.ejs', { mapId: 'failas-map', latAttr: 'lat', lonAttr: 'lon', zoom: 14 }) %>
  <% } %>
</head>
<body>
  <%- include('../header.ejs', {hideSubtext: false}) %>
  <main>
    <%
      failas.extension = (failas.extension || "").toLowerCase();
      const libreFormats = ["doc","docx","odt","rtf","xls","xlsx","xlsb","ods","ppt","pptx","ppsx","odp","odg","pub","pages","xlt","dot","docm","dotx"];
      const imageFormats = ["jpg","jpeg","png","bmp","gif","tif","tiff","jfif","heic","webp"];
      const archiveFormats = ["zip","7z","rar","adoc"];
      let originalusLinkas = null;
      let originalusLinkasPavadinimas = null;
      if (failas.saltinis == "sutartys" || !failas.saltinis) {
        originalusLinkas = `https://eviesiejipirkimai.lt/download.php?dok_id=${failas.dokId}&file_id=${failas.fileId}`;
        originalusLinkasPavadinimas = "CVP IS";
      } else if (failas.saltinis == "neskelbiamosDerybos") {
        originalusLinkas = `https://eviesiejipirkimai.lt/${failas.saltinioId}`;
        originalusLinkasPavadinimas = "CVP IS";
      } else if (failas.saltinis == "archive") {
        originalusLinkas = `/failas/${failas.parent}`;
        originalusLinkasPavadinimas = "Archyvas";
      } else if (failas.saltinis == "mvpAprasai") {
        originalusLinkas = `https://mw.eviesiejipirkimai.lt/vpm/SVPTS/svpts_paieska.asp?&Itemid=112`;
        originalusLinkasPavadinimas = "VPM IS";
      } else if (failas.saltinis == "cvpIs") {
        let pirkimoId = failas.saltinioId.split('/')[0];
        let documentId = failas.saltinioId.split('/')[1];
        let versionId = failas.saltinioId.split('/')[2];
        originalusLinkas = `https://viesiejipirkimai.lt/epps/cft/downloadDocumentVersion.do?versionId=${versionId}&documentId=${documentId}`;
        originalusLinkasPavadinimas = "CVP IS";
      } else if (failas.saltinis == "cvpp"){
        originalusLinkas = `https://cvpp.eviesiejipirkimai.lt`;
        originalusLinkasPavadinimas = "CVPP";
      }
    %>

    <!-- Page header -->
    <div class="page-header">
      <div>
        <% if (failas.metaduomenys?.Title) { %>
          <p class="text-muted text-sm mb-1"><%= failas.pavadinimas %></p>
          <h1 class="mb-0"><%= failas.metaduomenys.Title %></h1>
        <% } else { %>
          <h1 class="mb-0"><%= failas.pavadinimas %></h1>
        <% } %>
      </div>
      <div class="d-flex flex-wrap gap-2 align-center">
        <a href="/failas/<%= failas.id %>.json" class="btn btn-outline btn-sm">↗ JSON</a>
        <a href="https://failai.viespirkiai.org/<%= failas.id %>" class="btn btn-outline btn-sm">↗ Failas</a>
        <% if (failas.extension === "pdf" || libreFormats.includes(failas.extension)) { %>
          <a href="/dist/pdfjs/web/viewer.html?file=<%= encodeURIComponent(`/failas/${failas.id}/preview`) %>#search=<%= encodeURIComponent(query.search || '') %>" class="btn btn-outline btn-sm">↗ Padidinti</a>
        <% } %>
        <% if (originalusLinkas && originalusLinkasPavadinimas) { %>
          <a href="<%= originalusLinkas %>" class="btn btn-outline btn-sm">↗ <%= originalusLinkasPavadinimas %></a>
        <% } %>
      </div>
    </div>

    <div class="failas-grid mb-6">
      <!-- Left: metadata -->
      <div style="display:flex; flex-direction:column; gap:var(--space-4);">

        <div>
          <h2 class="mb-3 no-style">Failas</h2>
          <dl class="kv-list">
            <dt>Formatas</dt>
            <dd><span class="cell-mono"><%= failas.extension || "—" %></span></dd>
            <dt>Dydis</dt>
            <dd>
              <% if (failas.dydis || failas.dydis == 0) { %>
                <span class="cell-mono"><%= failas.dydis.convertUnit("B") %></span>
              <% } else { %>—<% } %>
            </dd>
            <dt>MD5</dt>
            <dd><span class="cell-mono" style="overflow-wrap:anywhere;"><%= failas.md5 || "—" %></span></dd>
            <dt>Šaltinis</dt>
            <dd>
              <% if (failas.saltinis == "sutartys" || !failas.saltinis) { %>
                <a href="/sutartis/<%= failas.dokId %>">Sutartis <%= failas.dokId %></a>
              <% } else if (failas.saltinis == "neskelbiamosDerybos") { %>
                <a href="/neskelbiamos">Neskelbiamos derybos</a>
              <% } else if (failas.saltinis == "archive") { %>
                <a href="/failas/<%= failas.parent %>">Archyvas <%= failas.parent %></a>
              <% } else if (failas.saltinis == "mvpAprasai") { %>
                <a href="https://mw.eviesiejipirkimai.lt/vpm/SVPTS/svpts_paieska.asp?&Itemid=112">MVP tvarkos aprašai</a>
              <% } else if (failas.saltinis == "cvpIs") { %>
                <% let pirkimoId = failas.saltinioId.split('/')[0]; %>
                <a href="https://viesiejipirkimai.lt/epps/cft/listContractDocuments.do?resourceId=<%= pirkimoId %>">Viešasis pirkimas <%= pirkimoId %></a>
              <% } else if (failas.saltinis == "cvpp") { %>
                <a href="https://cvpp.eviesiejipirkimai.lt">CVPP viešasis pirkimas</a>
              <% } %>
            </dd>
          </dl>
        </div>

        <% if (failas.location) { %>
          <div>
            <h2 class="mb-3 no-style">Vieta</h2>
            <%- include('../partials/map-point.ejs', {
              id: 'failas-map',
              lat: failas.location.lat,
              lon: failas.location.lon,
              zoom: 14,
              height: '220px',
              className: 'map-container',
              style: 'border-radius:var(--radius-md);',
              showLink: true,
              linkText: 'auto',
              linkZoom: 14,
              initScript: false
            }) %>
          </div>
        <% } %>

        <% if (failas.metaduomenys) { %>
          <div>
            <h2 class="mb-3 no-style">Dokumentas</h2>
            <dl class="kv-list">
              <dt>Puslapių skaičius</dt>
              <dd><span class="cell-mono"><%= failas.metaduomenys.pageCount || "—" %></span></dd>
              <dt>Žodžių skaičius</dt>
              <dd><span class="cell-mono"><%= failas.metaduomenys.wordCount || "—" %></span></dd>
              <dt>Programa</dt>
              <dd><%= failas.metaduomenys.Producer || "—" %></dd>
              <dt>Autorius</dt>
              <dd><%= failas.metaduomenys.Author || "—" %></dd>
            </dl>
          </div>

          <div>
            <h2 class="mb-3 no-style">Turinys</h2>
            <dl class="kv-list">

              <%- include('../partials/domenai.ejs', { domains: failas.metaduomenys.domains }) %>

              <%- include('../partials/nuorodos.ejs', { links: (failas.metaduomenys.links || []).filter(l => !l.uri.startsWith('mailto:')) }) %>

              <%- include('../partials/emails.ejs', { emails: failas.metaduomenys.emails }) %>

              <%- include('../partials/telefonai.ejs', { telefonai: failas.metaduomenys.telefonai }) %>

              <% if (failas.metaduomenys.ibanNumeriai?.length > 0 && failas.metaduomenys.ibanNumeriai[0].pages) { %>
                <%- include('../partials/ibanNumeriai.ejs', { ibanNumeriai: failas.metaduomenys.ibanNumeriai }) %>
              <% } %>

              <%- include('../partials/parasai.ejs', { signatures: failas.metaduomenys.signatures }) %>

            </dl>
          </div>
        <% } else { %>
          <p class="text-muted text-sm" style="text-align:center; margin-block:var(--space-6);">
            <em>Dokumento metaduomenų nėra</em>
          </p>
        <% } %>

      </div>

      <!-- Right: preview -->
      <div>
        <% if (failas.extension === "pdf" || failas.extension === "prn" || libreFormats.includes(failas.extension)) { %>
          <% if (libreFormats.includes(failas.extension)) { %>
            <p class="text-muted text-xs mb-3"><em>Dokumentas konvertuotas į PDF naudojant LibreOffice, gali būti atvaizduojamas iškraipytas.</em></p>
          <% } %>
          <%- include('../partials/pdf-preview.ejs', {
            failasId: failas.id,
            search: (query && query.search) ? query.search : '',
            height: '70vh',
            border: 'none',
            rounded: true
          }) %>

        <% } else if (failas.nuskaitytas > 0 && archiveFormats.includes(failas.extension)) { %>
          <p class="text-muted text-sm mb-3"><em>Archyvo peržiūra</em></p>

          <%- include('../partials/archive-tree.ejs', {
            filesTree: failas.metaduomenys?.filesTree,
            failasId: failas.id,
            openByDefault: true
          }) %>

        <% } else if (failas.extension === "mp4") { %>
          <video controls style="width:100%; max-height:70vh; border-radius:var(--radius-md); display:block;">
            <source src="https://failai.viespirkiai.org/<%= failas.id %>" type="video/mp4">
          </video>

        <% } else if (imageFormats.includes(failas.extension)) { %>
          <%
            let convertString = "";
            if (failas.extension === "heic") convertString = "?convertTo=jpeg";
          %>
          <img src="https://failai.viespirkiai.org/<%= failas.id %><%= convertString %>" alt="" style="max-width:100%; border-radius:var(--radius-md);">

        <% } else if (failas.extension === "url") { %>
          <dl class="kv-list">
            <dt>Nuoroda</dt>
            <dd>
              <% if (failas.metaduomenys?.links?.[0]?.uri) { %>
                <a href="<%= encodeURI(failas.metaduomenys.links[0].uri) %>"><%= failas.metaduomenys.links[0].uri %></a>
              <% } else { %>
                <em class="text-muted">Nenurodyta</em>
              <% } %>
            </dd>
          </dl>

        <% } else if (failas.extension === "txt") { %>
          <%
            if (failas.tekstas) {
              failas.tekstas = failas.tekstas.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
              try {
                let pages = JSON.parse(failas.tekstas);
                if (Array.isArray(pages)) failas.tekstas = pages.join('');
              } catch(e) {}
            }
          %>
          <div style="background:var(--lightest-gray); border:var(--border); border-radius:var(--radius-md); padding:var(--space-4); overflow-x:auto;">
            <pre style="white-space:pre-wrap; word-wrap:break-word; font-family:var(--font-mono); font-size:var(--text-sm); margin:0;"><%= failas.tekstas || "" %></pre>
          </div>

        <% } else if (failas.extension === "fax" && failas.md5 === 'e083b15bc91cd24583955d3493347f7a') { %>
            <%- include('./specialCases/fax.ejs') %>
        <% } else if (["html","htm","svg"].includes(failas.extension)) { %>
          <iframe
            src="https://failai.viespirkiai.org/<%= failas.id %>"
            style="width:100%; height:600px; border:var(--border); border-radius:var(--radius-md);"
          ></iframe>

        <% } else if ((failas.extension === "eml" || failas.extension === "msg") && failas.metaduomenys) { %>
          <%- include('../partials/email-message.ejs', { metaduomenys: failas.metaduomenys, failasId: failas.id }) %>

        <% } else { %>
          <p class="text-muted text-sm"><em>Peržiūra nepalaikoma šio formato failams. Spustelėkite „Failas", jei norite jį atsisiųsti.</em></p>
        <% } %>
      </div>

    </div>
  </main>
  <%- include('../footer.ejs') %>
</body>
</html>
