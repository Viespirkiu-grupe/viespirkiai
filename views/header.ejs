<%
  function isActive(path) {
    if (typeof req === 'undefined') return '';
    return req.path === path || (path !== '/' && req.path.startsWith(path)) ? 'active' : '';
  }

  const rawInfoBanner = CONFIG?.infoBanner;
  let infoBanner = null;

  if (typeof rawInfoBanner === 'string' && rawInfoBanner.trim()) {
    infoBanner = {
      type: 'text',
      content: rawInfoBanner.trim(),
      important: false,
    };
  } else if (rawInfoBanner && typeof rawInfoBanner === 'object') {
    const type = rawInfoBanner.type === 'html' ? 'html' : 'text';
    const content =
      typeof rawInfoBanner.content === 'string'
        ? rawInfoBanner.content.trim()
        : '';

    if (content) {
      infoBanner = {
        type,
        content,
        important: rawInfoBanner.important === true,
      };
    }
  }
%>
<header>
  <% if (infoBanner) { %>
    <section
      class="navbar-info-banner <%= infoBanner.important ? 'navbar-info-banner-important' : '' %>"
      role="status"
      aria-live="polite"
      data-important="<%= infoBanner.important ? 'true' : 'false' %>"
    >
      <% if (infoBanner.type === 'html') { %>
        <div class="navbar-info-banner-content"><%- infoBanner.content %></div>
      <% } else { %>
        <div class="navbar-info-banner-marquee" data-marquee="idle">
          <div class="navbar-info-banner-track">
            <span class="navbar-info-banner-text" data-copy="primary"><%= infoBanner.content %></span>
            <span class="navbar-info-banner-text" aria-hidden="true"><%= infoBanner.content %></span>
          </div>
        </div>
      <% } %>
    </section>
  <% } %>

  <nav class="navbar">
    <a href="/" class="navbar-brand no-style flex">
      <span class="sr-only">Viešpirkiai</span>
      <% if (CONFIG.dev == true) { %>
        <div class="rotate-180"><%- include('viespirkiaiLogoLaisvasZodis.svg') %></div>
      <% } else { %>
        <%- include('viespirkiaiLogoLaisvasZodis.svg') %>
      <% } %>
    </a>

    <ul class="navbar-nav navbar-main mr-2">
      <li><a href="/"                 class="<%= isActive('/') %>"                 <%= isActive('/') === 'active'                 ? 'aria-current="page"' : '' %>>Sutartys</a></li>
      <li><a href="/viesiejiPirkimai" class="<%= isActive('/viesiejiPirkimai') %>" <%= isActive('/viesiejiPirkimai') === 'active'  ? 'aria-current="page"' : '' %>>Viešieji pirkimai</a></li>
      <li><a href="/failai"           class="<%= isActive('/failai') %>"           <%= isActive('/failai') === 'active'           ? 'aria-current="page"' : '' %>>Failai</a></li>
      <li><a href="/juridiniai"       class="<%= isActive('/juridiniai') %>"       <%= isActive('/juridiniai') === 'active'       ? 'aria-current="page"' : '' %>>Juridiniai</a></li>
      <li><a href="/neskelbiamos"     class="<%= isActive('/neskelbiamos') %>"     <%= isActive('/neskelbiamos') === 'active'     ? 'aria-current="page"' : '' %>>Neskelbiamos</a></li>
      <li><a href="/nepatikimi"       class="<%= isActive('/nepatikimi') %>"       <%= isActive('/nepatikimi') === 'active'       ? 'aria-current="page"' : '' %>>Nepatikimi ir melagiai</a></li>
    </ul>

    <div class="navbar-actions">
      <ul class="navbar-nav">
        <li><a href="/apie"         class="<%= isActive('/apie') %>"         <%= isActive('/apie') === 'active'         ? 'aria-current="page"' : '' %>>Apie</a></li>
        <li><a href="/kontaktai"    class="<%= isActive('/kontaktai') %>"    <%= isActive('/kontaktai') === 'active'    ? 'aria-current="page"' : '' %>>Kontaktai</a></li>
        <li><a href="/duomenys"     class="<%= isActive('/duomenys') %>"     <%= isActive('/duomenys') === 'active'     ? 'aria-current="page"' : '' %>>Duomenys</a></li>
        <li><a href="/vieslaiskiai" class="<%= isActive('/vieslaiskiai') %>" <%= isActive('/vieslaiskiai') === 'active' ? 'aria-current="page"' : '' %>>Viešlaiškiai</a></li>
      </ul>

      <button class="navbar-scheme-toggle" id="schemeToggle" aria-label="Perjungti temą" onclick="
        const isDark = document.documentElement.classList.contains('dark');
        const next = isDark ? 'light' : 'dark';
        document.documentElement.classList.toggle('dark', next === 'dark');
        document.cookie = 'colorScheme=' + next + ';path=/;max-age=31536000';
        updateSchemeIcon(next);
      ">
        <svg id="schemeIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <% if (colorScheme === 'dark') { %>
            <!-- sun -->
            <circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
          <% } else { %>
            <!-- moon -->
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          <% } %>
        </svg>
      </button>

      <script>
        function updateSchemeIcon(scheme) {
          const svg = document.getElementById('schemeIcon');
          const sun  = `<circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>`;
          const moon = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>`;
          svg.innerHTML = scheme === 'dark' ? sun : moon;
        }

        function syncScheme() {
          const cookie = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith('colorScheme='));
          const scheme = cookie ? cookie.split('=')[1] : 'auto';
          const isDark = scheme === 'dark' || (scheme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', isDark);
          updateSchemeIcon(isDark ? 'dark' : 'light');
        }

        syncScheme();
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) syncScheme();
        });
      </script>

      <button class="navbar-hamburger" id="navHamburger" aria-label="Atidaryti meniu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="navbar-mobile" id="navMobile" aria-hidden="true">
    <ul class="navbar-mobile-nav">
      <li><a href="/"                 class="<%= isActive('/') %>"                 <%= isActive('/') === 'active'                 ? 'aria-current="page"' : '' %>>Sutartys</a></li>
      <li><a href="/viesiejiPirkimai" class="<%= isActive('/viesiejiPirkimai') %>" <%= isActive('/viesiejiPirkimai') === 'active'  ? 'aria-current="page"' : '' %>>Viešieji pirkimai</a></li>
      <li><a href="/failai"           class="<%= isActive('/failai') %>"           <%= isActive('/failai') === 'active'           ? 'aria-current="page"' : '' %>>Failai</a></li>
      <li><a href="/juridiniai"       class="<%= isActive('/juridiniai') %>"       <%= isActive('/juridiniai') === 'active'       ? 'aria-current="page"' : '' %>>Juridiniai asmenys</a></li>
      <li><a href="/neskelbiamos"     class="<%= isActive('/neskelbiamos') %>"     <%= isActive('/neskelbiamos') === 'active'     ? 'aria-current="page"' : '' %>>Neskelbiamos derybos</a></li>
      <li><a href="/nepatikimi"       class="<%= isActive('/nepatikimi') %>"       <%= isActive('/nepatikimi') === 'active'       ? 'aria-current="page"' : '' %>>Nepatikimi ir melagiai</a></li>
      <li class="navbar-mobile-divider"></li>
      <li><a href="/apie"             class="<%= isActive('/apie') %>"             <%= isActive('/apie') === 'active'             ? 'aria-current="page"' : '' %>>Apie</a></li>
      <li><a href="/kontaktai"        class="<%= isActive('/kontaktai') %>"        <%= isActive('/kontaktai') === 'active'        ? 'aria-current="page"' : '' %>>Kontaktai</a></li>
      <li><a href="/duomenys"         class="<%= isActive('/duomenys') %>"         <%= isActive('/duomenys') === 'active'         ? 'aria-current="page"' : '' %>>Duomenys</a></li>
      <li><a href="/vieslaiskiai"     class="<%= isActive('/vieslaiskiai') %>"     <%= isActive('/vieslaiskiai') === 'active'     ? 'aria-current="page"' : '' %>>Viešlaiškiai</a></li>
    </ul>
  </div>
</header>

<script>
  const hamburger = document.getElementById('navHamburger');
  const mobileNav = document.getElementById('navMobile');
  const header = document.querySelector('header');
  const navbar = document.querySelector('.navbar');
  const infoBanner = document.querySelector('.navbar-info-banner');
  const infoBannerMarquee = document.querySelector('.navbar-info-banner-marquee');
  const infoBannerTrack = document.querySelector('.navbar-info-banner-track');
  const infoBannerTextPrimary = document.querySelector('.navbar-info-banner-text[data-copy="primary"]');

  function syncInfoBannerMarquee() {
    if (!infoBannerMarquee || !infoBannerTrack || !infoBannerTextPrimary) return;

    infoBannerMarquee.dataset.marquee = 'idle';
    infoBannerTrack.style.removeProperty('--banner-step');
    infoBannerTrack.style.removeProperty('--banner-gap');
    infoBannerTrack.style.removeProperty('--banner-duration');

    const containerWidth = infoBannerMarquee.clientWidth;
    const textWidth = infoBannerTextPrimary.scrollWidth;

    if (!containerWidth || !textWidth) return;

    const horizontalPadding = 32;
    const availableWidth = Math.max(containerWidth - horizontalPadding, 0);

    if (textWidth <= availableWidth) {
      infoBannerMarquee.dataset.marquee = 'idle';
      return;
    }

    const minGap = 128;
    const offscreenBuffer = 24;
    const gap = Math.max(minGap, containerWidth - textWidth + offscreenBuffer);
    const step = textWidth + gap;
    const pxPerSecond = 52;
    const duration = Math.max(10, step / pxPerSecond);

    infoBannerTrack.style.setProperty('--banner-gap', `${gap}px`);
    infoBannerTrack.style.setProperty('--banner-step', `${step}px`);
    infoBannerTrack.style.setProperty('--banner-duration', `${duration.toFixed(2)}s`);
    infoBannerMarquee.dataset.marquee = 'running';
  }

  function syncHeaderOffset() {
    if (!navbar) return;

    const bannerHeight = infoBanner ? infoBanner.offsetHeight : 0;
    const navHeight = navbar.offsetHeight;
    const total = bannerHeight + navHeight;

    document.documentElement.style.setProperty('--site-header-offset', `${total}px`);
  }

  syncHeaderOffset();
  syncInfoBannerMarquee();
  window.addEventListener('resize', syncHeaderOffset, { passive: true });
  window.addEventListener('resize', syncInfoBannerMarquee, { passive: true });

  if (document.fonts?.ready) {
    document.fonts.ready
      .then(() => {
        syncHeaderOffset();
        syncInfoBannerMarquee();
      })
      .catch(() => {});
  }

  hamburger.addEventListener('click', () => {
    const open = mobileNav.classList.toggle('open');
    hamburger.classList.toggle('open', open);
    hamburger.setAttribute('aria-expanded', open);
    mobileNav.setAttribute('aria-hidden', !open);
    document.body.classList.toggle('nav-open', open);
  });

  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > lastY && y > 60) header.classList.add('nav-hidden');
    else header.classList.remove('nav-hidden');
    lastY = y;
  }, { passive: true });

  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      syncHeaderOffset();
      syncInfoBannerMarquee();
    }
  });
</script>
