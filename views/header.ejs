<header>
	<nav class="aside" aria-label="Puslapio nuorodos">
        <a href="/apie"><span aria-hidden="true">↗</span>  Apie</a>
	    <a href="/kontaktai"><span aria-hidden="true">↗</span>  Kontaktai</a>
		<a href="/duomenys"><span aria-hidden="true">↗</span>  Duomenys</a>
		<a href="/vieslaiskiai"><span aria-hidden="true">↗</span>  Viešlaiškiai</a>
	</nav>

	<h1 class="viespirkiai">
		<a href="/" class="noStyle">
		    <span class="visually-hidden">Viešpirkiai</span>
			<% if(CONFIG.dev == true) { %>
                <div style="transform: rotate(180deg) translateY(-20px);">
                    <%- include('viespirkiaiLogoLaisvasZodis.svg') %>
                </div>
			<% } else { %>
			    <%- include('viespirkiaiLogoLaisvasZodis.svg') %>
			<% } %>
		</a>
	</h1>

	<% if(typeof hideSubtext == "undefined" || hideSubtext == false) { %>
	    <span role="doc-subtitle">
			<% if(CONFIG.dev == true) { %>
                Darbinė sistemos versija
			<% } else { %>
                Pilietinė viešųjų pirkimų analizės inciatyva
			<% } %>
		</span>
	<% } %>
</header>
