---
// Global setup for ApexCharts. Renders an inline <script> defining `window.displayChart`
// which is called by per-page chart consumers (e.g. components/asmuo/*.astro).
// Drop this once at the top of any page that uses charts.
---

<script is:inline>
  let apexPromise;
  const renderedCharts = [];
  function loadApexCharts() {
    if (window.ApexCharts) return Promise.resolve(window.ApexCharts);
    if (apexPromise) return apexPromise;
    apexPromise = new Promise((resolve, reject) => {
      function startLoading() {
        const s = document.createElement('script');
        s.src = '/dist/apexcharts.js';
        s.defer = true;
        s.onload = () => resolve(window.ApexCharts);
        s.onerror = reject;
        document.body.appendChild(s);
      }
      document.readyState === 'loading'
        ? window.addEventListener('DOMContentLoaded', startLoading)
        : startLoading();
    });
    return apexPromise;
  }

  function deepMerge(t, s) {
    for (const k in s) {
      if (s[k] && typeof s[k] === 'object' && !Array.isArray(s[k])) {
        if (!t[k]) t[k] = {};
        deepMerge(t[k], s[k]);
      } else {
        t[k] = s[k];
      }
    }
    return t;
  }

  const getIsDark = () => document.documentElement.classList.contains('dark');
  const getThemeTokens = (d) => ({
    foreground: d ? '#f5f4f4' : '#0c0a09',
    labelColor: d ? '#a8a29e' : '#292524',
    gridColor: d ? '#292524' : '#e7e5e4',
    tooltipBg: d ? '#1c1917' : '#fafaf9',
    tooltipText: d ? '#f5f4f4' : '#0c0a09',
    tooltipBorder: d ? '#292524' : '#d6d3d1',
  });
  const CATEGORICAL_COLORS = {
    light: ['#0c0a09', '#79716b', '#e7e5e4'],
    dark: ['#f5f4f4', '#79716b', '#292524'],
  };
  const getCategoricalColors = (d) => d ? CATEGORICAL_COLORS.dark : CATEGORICAL_COLORS.light;
  const getShadesOfGray = (d) => d
    ? ['#f5f4f4', '#d6d3d1', '#a8a29e', '#79716b', '#57534e', '#44403c', '#292524']
    : ['#0c0a09', '#1c1917', '#292524', '#44403c', '#57534e', '#79716b', '#a8a29e'];

  const eurFormatter = v => typeof v === 'number'
    ? v.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' })
    : 'Nėra duomenų';

  function buildGlobalDefaults(d) {
    const t = getThemeTokens(d);
    return {
      chart: { toolbar: { show: false }, zoom: { enabled: false }, fontFamily: 'Ubuntu, system-ui, sans-serif', background: 'transparent', height: 350, foreColor: t.labelColor },
      tooltip: { enabled: true, theme: d ? 'dark' : 'light', style: { fontFamily: 'Ubuntu, system-ui, sans-serif' } },
      xaxis: { labels: { style: { colors: t.labelColor } } },
      yaxis: { labels: { style: { colors: t.labelColor } } },
      stroke: { curve: 'smooth', width: 2 },
      markers: { size: 4 },
      colors: getCategoricalColors(d),
      grid: { borderColor: t.gridColor },
      theme: { mode: d ? 'dark' : 'light' },
      legend: { labels: { colors: t.labelColor } },
    };
  }

  const typeChartDefaults = {
    'line-datetime': { chart: { type: 'line' }, xaxis: { type: 'datetime', tickAmount: 6, labels: { format: 'yyyy-MM' } }, tooltip: { x: { format: 'yyyy-MM' } } },
    'pie': { chart: { type: 'pie' }, legend: { position: 'bottom' }, dataLabels: { enabled: true } },
    'scatter': { chart: { type: 'scatter' } },
    'treemap': { chart: { type: 'treemap' } },
  };

  const chartFlagDefaults = {
    'yEUR': { yaxis: { labels: { formatter: eurFormatter } } },
    'yEURMen': { yaxis: { labels: { formatter: v => typeof v === 'number' ? eurFormatter(v) + ' / mėn.' : 'Nėra duomenų' } } },
    'yMin0': { yaxis: { min: 0 } },
    'yMinAuto': { yaxis: { min: undefined } },
    'xYear': { xaxis: { labels: { format: 'yyyy' } }, tooltip: { x: { format: 'yyyy' } } },
    'xAxisYearMonth': { xaxis: { type: 'datetime', tickAmount: 6, labels: { format: 'yyyy-MM' } }, tooltip: { x: { format: 'yyyy-MM' } } },
    'xAxisDay': { xaxis: { type: 'datetime', tickAmount: 6, labels: { format: 'yyyy-MM-dd' } }, tooltip: { x: { format: 'yyyy-MM-dd' } } },
    'numbersWithSpaces': { yaxis: { labels: { formatter: v => typeof v === 'number' ? v.toLocaleString('lt-LT') : 'Nėra duomenų' } } },
  };

  function buildOptions(data, isDark) {
    let o = structuredClone(buildGlobalDefaults(isDark));
    if (data.type && typeChartDefaults[data.type]) o = deepMerge(o, structuredClone(typeChartDefaults[data.type]));
    for (const f of (data.flags || [])) {
      if (f === '50shadesOfGray') o = deepMerge(o, { colors: getShadesOfGray(isDark) });
      else if (f in chartFlagDefaults) o = deepMerge(o, chartFlagDefaults[f]);
    }
    if (data.type !== 'pie') {
      o.xaxis = o.xaxis || {};
      o.xaxis.categories = data.labels;
      if (Array.isArray(data.series) && (data.series.length === 0 || !data.series[0]?.data)) {
        o.series = [{ name: data.customOptions?.seriesName || '', data: data.series }];
      } else {
        o.series = data.series;
      }
    } else {
      o.labels = data.labels;
      o.series = data.series;
    }
    if (data.customOptions) o = deepMerge(o, data.customOptions);
    return o;
  }

  window.displayChart = async function displayChart(data) {
    if (!data?.element || !data?.labels || !data?.series) return;
    await loadApexCharts();
    const chart = new ApexCharts(data.element, buildOptions(data, getIsDark()));
    chart.render();
    renderedCharts.push({ chart, data });
  };

  function updateAllCharts() {
    const d = getIsDark();
    const t = getThemeTokens(d);
    for (const { chart, data } of renderedCharts) {
      const flags = data.flags || [];
      const colors = flags.includes('50shadesOfGray') ? getShadesOfGray(d) : getCategoricalColors(d);
      chart.updateOptions({
        chart: { foreColor: t.labelColor },
        tooltip: { theme: d ? 'dark' : 'light' },
        xaxis: { labels: { style: { colors: t.labelColor } } },
        yaxis: { labels: { style: { colors: t.labelColor } } },
        grid: { borderColor: t.gridColor },
        theme: { mode: d ? 'dark' : 'light' },
        legend: { labels: { colors: t.labelColor } },
        colors,
      }, false, true);
    }
  }

  new MutationObserver(updateAllCharts).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!document.documentElement.classList.contains('dark')) updateAllCharts();
  });
</script>

<style is:global>
  .chart { background-color: transparent; }
  .dark .apexcharts-tooltip,
  .dark .apexcharts-tooltip-title {
    background: #1c1917 !important;
    color: #f5f4f4 !important;
    border-color: #292524 !important;
  }
</style>
