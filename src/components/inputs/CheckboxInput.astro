---
interface Props { label: string; name: string; values: Record<string, any>; }
const { label, name, values } = Astro.props;
---
<div class="form-check">
  <input type="checkbox" class="form-check-input" name={name} id={name} value="true" checked={!!values[name]}>
  <label class="form-check-label" for={name}>{label}</label>
</div>
