---
import Table from '@design-system/components/Table.astro';
import TableWrapper from '@design-system/components/TableWrapper.astro';
import type { Atn1Santrauka } from '../../lib/atn1.js';

const { atn1 } = Astro.props as { atn1: Atn1Santrauka };
const dalyviai = atn1.dalyviai ?? [];
const eile = atn1.pasiulymuEile ?? [];
const val = (v: any) => (v == null || v === '' ? '—' : v);
const asmuoLink = (kodas: any, fizinisAsmuo: any, pavadinimas: any) =>
  kodas && fizinisAsmuo !== true ? { href: `/asmuo/${kodas}`, text: val(pavadinimas) } : null;
const keliosDalys = eile.some((e) => e.daliesNumeris != null && Number(e.daliesNumeris) > 1);
---

<section class="dalyviai-section">
  <div class="flex justify-between items-center mb-4">
    <h2 class="mb-0">Dalyviai</h2>
    <a href={`/failas/${atn1.failasId}`} class="btn btn-outline btn-sm" aria-label="Atidaryti pilną ATN-1 ataskaitą">
      <span aria-hidden="true">↗</span> Pilna ATN-1 ataskaita
    </a>
  </div>

  {dalyviai.length > 0 ? (
    <TableWrapper>
      <Table size="sm">
        <thead><tr><th>Dalyvis</th><th>Šalis</th></tr></thead>
        <tbody>
          {dalyviai.map((d) => {
            const l = asmuoLink(d.kodas, d.fizinisAsmuo, d.pavadinimas);
            return (
              <tr>
                <td>{l ? <a href={l.href}>{l.text}</a> : val(d.pavadinimas)}</td>
                <td>{val(d.salis)}</td>
              </tr>
            );
          })}
        </tbody>
      </Table>
    </TableWrapper>
  ) : (
    <p class="text-muted text-sm">Dalyvių sąrašas nepateiktas.</p>
  )}

  {eile.length > 0 && (
    <>
      <h3 class="mt-6 mb-3">Pasiūlymų eilė</h3>
      <TableWrapper>
        <Table size="sm">
          <thead>
            <tr>
              {keliosDalys && <th class="dalyviai-col-num">Dalis</th>}
              <th class="dalyviai-col-num">Eilė</th>
              <th>Dalyvis</th>
              <th class="cell-right">Kaina</th>
            </tr>
          </thead>
          <tbody>
            {eile.map((e) => {
              const l = asmuoLink(e.dalyvioKodas, false, e.dalyvioPavadinimas);
              return (
                <tr>
                  {keliosDalys && <td class="cell-mono">{val(e.daliesNumeris)}</td>}
                  <td class="cell-mono">{val(e.eileNumeris)}</td>
                  <td>{l ? <a href={l.href}>{l.text}</a> : val(e.dalyvioPavadinimas)}</td>
                  <td class="cell-mono cell-right">{e.kaina ? `${e.kaina}${e.kainosIsraiska ? ` ${e.kainosIsraiska}` : ''}` : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </Table>
      </TableWrapper>
    </>
  )}
</section>

<style>
  .dalyviai-col-num { width: 4rem; }
</style>
