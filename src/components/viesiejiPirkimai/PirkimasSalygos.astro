---
import KeyValueList from '@design-system/components/KeyValueList.astro';

interface Props {
  pirkimas: any;
}
const { pirkimas } = Astro.props;
const t = pirkimas.turinys || {};

const has = t.eAukcionuSukurimas || t.pirkimasSkaidomasIDaliuDPSIKategorijas || t.leidziamaPateiktisAlternatyviusPasiulymus || t.pasiulymoGaliojimoTerminasDienomisArbaMenesiais || t.sutartiesTrukmeMenesiaisArbaMetaisIsskyrusPratesimus || t.sutartiesTipas;
const items = [
  t.sutartiesTipas && { label: 'Sutarties tipas', value: t.sutartiesTipas },
  t.sutartiesTrukmeMenesiaisArbaMetaisIsskyrusPratesimus && { label: 'Sutarties trukmė', value: t.sutartiesTrukmeMenesiaisArbaMetaisIsskyrusPratesimus },
  t.pasiulymoGaliojimoTerminasDienomisArbaMenesiais && { label: 'Pasiūlymo galiojimas', value: t.pasiulymoGaliojimoTerminasDienomisArbaMenesiais },
  t.eAukcionuSukurimas && { label: 'El. aukcionas', value: t.eAukcionuSukurimas },
  t.leidziamaPateiktisAlternatyviusPasiulymus && { label: 'Alternatyvūs pasiūlymai', value: t.leidziamaPateiktisAlternatyviusPasiulymus },
  t.pirkimasSkaidomasIDaliuDPSIKategorijas && { label: 'Skaidoma į dalis', value: t.pirkimasSkaidomasIDaliuDPSIKategorijas },
].filter(Boolean);
---

{has && (
  <section>
    <h2>Sąlygos</h2>
    <KeyValueList items={items} />
  </section>
)}
