---
// Viešųjų pirkimų BVPŽ „Daugiau" dialogas — plonas apvalkalas virš bendro
// BvpzFacetTreeModal su /viesiejiPirkimai specifine konfigūracija. Greiti
// pasirinkimai bendri (žr. BvpzFacetTreeModal DEFAULT_PRESETS).
import BvpzFacetTreeModal from '../content/BvpzFacetTreeModal.astro';
---

<BvpzFacetTreeModal
  modalId="vpBvpzModal"
  instanceId="vpBvpzTree"
  param="bvpzPrefiksai"
  redirectBase="/viesiejiPirkimai/"
  facetEndpoint="/api/viesiejiPirkimaiFacet"
  facetTriggerSelector='.vp-facets [data-facet-modal="bvpzKodai"]'
/>
