---
import FileCardList from '@design-system/components/FileCardList.astro';

interface Props {
  skelbimai: any[];
}
const { skelbimai } = Astro.props;

const items = (skelbimai ?? []).map((skelbimas: any) => {
  const pavadinimas = (skelbimas.tipas || 'Skelbimas').trim();
  const isNacionalinis = pavadinimas.toLowerCase().startsWith('nacionalinis');
  const ext = isNacionalinis ? 'tedLt' : 'tedEu';
  return {
    title: pavadinimas,
    href: skelbimas.downloadHref || '#',
    meta: ext,
    ext,
    actions: [],
    titleTwoLines: true,
    hideMeta: true,
  };
});
---

<FileCardList title="Skelbimai" items={items} />
