---
import FileCard from '@design-system/components/FileCard.astro';

interface Props {
  skelbimai: any[];
}
const { skelbimai } = Astro.props;
---

{skelbimai && skelbimai.length > 0 && (
  <section class="mb-7">
    <h2>Skelbimai</h2>
    <div class="flex flex-col gap-2 mt-4">
      {skelbimai.map((skelbimas: any) => {
        const pavadinimas = (skelbimas.tipas || 'Skelbimas').trim();
        const isNacionalinis = pavadinimas.toLowerCase().startsWith('nacionalinis');
        const ext = isNacionalinis ? 'tedLt' : 'tedEu';
        return (
          <div class="min-w-0">
            <FileCard
              title={pavadinimas}
              href={skelbimas.downloadHref || '#'}
              meta={ext}
              ext={ext}
              actions={[]}
              titleTwoLines={true}
              hideMeta={true}
            />
          </div>
        );
      })}
    </div>
  </section>
)}
