---
import KeyValueList from '@design-system/components/KeyValueList.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';

interface Props {
  pirkimas: any;
}
const { pirkimas } = Astro.props;
const t = pirkimas.turinys || {};

const numatoma = pirkimas.numatomaBendraPirkimoVerte || pirkimas.numatomaVerteEUR;
const bendra = t.bendraSutarciuVerte;
const dpsMax = t.suteiktaVertemaksimaliDPSVerte;
const hasMoney = (value: unknown) => {
  const number = Number(value);
  return value != null && value !== '' && !Number.isNaN(number) && number > 0;
};
const hasAny = hasMoney(numatoma) || hasMoney(bendra) || hasMoney(dpsMax);
---

{hasAny && (
  <section>
    <h2>Vertė</h2>
    <KeyValueList>
      {hasMoney(numatoma) && <><dt>Numatoma</dt><dd><MoneyValue value={numatoma} /></dd></>}
      {hasMoney(bendra) && <><dt>Bendra sutarčių</dt><dd><MoneyValue value={bendra} /></dd></>}
      {hasMoney(dpsMax) && <><dt>Maksimali DPS</dt><dd><MoneyValue value={dpsMax} /></dd></>}
    </KeyValueList>
  </section>
)}
