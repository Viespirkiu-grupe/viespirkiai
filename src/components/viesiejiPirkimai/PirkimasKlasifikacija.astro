---
import KeyValueList from '@design-system/components/KeyValueList.astro';

interface Props {
  pirkimas: any;
}
const { pirkimas } = Astro.props;
const t = pirkimas.turinys || {};
const items = [
  pirkimas.statusas && { label: 'Statusas', value: pirkimas.statusas },
  pirkimas.pirkimoObjektoTipas && { label: 'Objekto tipas', value: pirkimas.pirkimoObjektoTipas },
  t.direktyva && { label: 'Direktyva', value: t.direktyva },
  t.nutsKodai && { label: 'NUTS kodas', value: t.nutsKodai },
  pirkimas.esFinansavimas != null && { label: 'ES finansavimas', value: pirkimas.esFinansavimas ? 'Taip' : 'Ne' },
  t.pasiulymuVertinimoKriterijai && { label: 'Vertinimo kriterijai', value: t.pasiulymuVertinimoKriterijai },
  t.virsArbaZemiauTarptautinioPirkimoVertesRibos && { label: 'Tarpt. vertės riba', value: t.virsArbaZemiauTarptautinioPirkimoVertesRibos },
].filter(Boolean);
---

<section>
  <h2>Klasifikacija</h2>
  <KeyValueList className="mb-4" items={items} />
  {pirkimas.bvpzKodai && pirkimas.bvpzKodai.length > 0 && (
    <>
      <h3 class="mb-2">BVPŽ kodai</h3>
      {pirkimas.bvpzKodai.map((kodas: string, i: number) => (
        <div class="mb-2">
          {t.bvpzKodaiPavadinimai?.[i] && <div class="font-medium">{t.bvpzKodaiPavadinimai[i]}</div>}
          <span class="text-muted">{kodas}</span>
        </div>
      ))}
      <a href="/bvpz" class="text-sm">↗ BVPŽ kodai</a>
    </>
  )}
</section>
