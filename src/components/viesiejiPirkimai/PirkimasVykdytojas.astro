---
import DetailsSection from '@design-system/components/DetailsSection.astro';
import EntityLink from '@design-system/components/EntityLink.astro';
import ExternalSourceLink from '@design-system/components/ExternalSourceLink.astro';

interface Props {
  pirkimas: any;
}
const { pirkimas } = Astro.props;
const t = pirkimas.turinys || {};
---

<DetailsSection title="Pirkimo vykdytojas">
  <h3>
    <EntityLink kodas={pirkimas.jarKodas} label={pirkimas.vykdytojoPavadinimas || pirkimas.pirkimoVykdytojas} link={!!pirkimas.jarKodas} />
  </h3>
  {pirkimas.jarKodas && <span class="text-muted">{pirkimas.jarKodas}</span>}
  {t.kontaktinisAsmuo && <p class="text-muted text-sm mt-2">{t.kontaktinisAsmuo}</p>}
  {t.pirkimuSuvestinesNuoroda && (
    <p class="text-sm mt-2">
      <ExternalSourceLink href={`https://viesiejipirkimai.lt/epps/app/viewPublication.do?selectedId=${t.pirkimuSuvestinesNuoroda}`} label="Pirkimų suvestinė" source="cvpis" />
    </p>
  )}
</DetailsSection>
