---
import DateValue from '@design-system/components/DateValue.astro';
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultCardFooter from '@design-system/components/ResultCardFooter.astro';
import ResultCardMeta from '@design-system/components/ResultCardMeta.astro';

interface Props {
  item: any;
}
const { item } = Astro.props;
const metaItems = [
  item.statusas && {
    label: 'Statusas',
    value: item.statusas,
    valueClassName: item.statusas === 'Vykdomas' ? 'badge-active' : '',
  },
  item.pirkimoBudas && { label: 'Pirkimo būdas', value: item.pirkimoBudas },
].filter(Boolean);
const footerItems = [
  item.pirkimoVykdytojas && {
    label: 'Vykdytojas',
    value: `${item.pirkimoVykdytojas.slice(0, 80)}${item.pirkimoVykdytojas.length > 80 ? '…' : ''}`,
  },
  item.pasiulymuPateikimoTerminas && {
    label: 'Pasiūlymų terminas',
    value: String(item.pasiulymuPateikimoTerminas).slice(0, 16).replace('T', ' '),
  },
  item.numatomaBendraPirkimoVerte && {
    label: 'Numatoma vertė',
    value: `${Number(item.numatomaBendraPirkimoVerte).toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}\u00A0€`,
  },
  item.informacija && item.informacija !== item.pavadinimas && { value: item.informacija },
].filter(Boolean);
---

<ResultCardShell clickable={true}>
  <ResultCardMeta slot="meta" items={metaItems}>
    {item.paskelbimoData && (
      <div>
        <dt class="sr-only">Paskelbimo data</dt>
        <dd>
          <abbr aria-hidden="true" title="Paskelbimo data" class="relative z-1">Paskelb.</abbr>
          <DateValue value={item.paskelbimoData} />
        </dd>
      </div>
    )}
  </ResultCardMeta>

  <div slot="title" class="flex align-baseline gap-3">
    <h3 class="result-card-title">
      {(!item.pavadinimas || item.pavadinimas.length < 1) ? (
        <em>Nenurodyta</em>
      ) : (
        <a href={`/viesiejiPirkimai/${item.pirkimoId}`}>{item.pavadinimas}</a>
      )}
    </h3>
  </div>

  <ResultCardFooter slot="footer" items={footerItems} />
</ResultCardShell>
