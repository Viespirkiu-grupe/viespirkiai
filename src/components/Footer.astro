---
import SiteFooterShell from '@design-system/components/SiteFooterShell.astro';
import FooterColumn from '@design-system/components/FooterColumn.astro';
import buildInfo from '../lib/buildInfo.ts';
import { showFooterDisclaimer } from '../lib/footerDisclaimer.ts';
import logoSvg from '../assets/branding/viespirkiaiLogo.svg?raw';

const rodytiIspejima = showFooterDisclaimer(Astro.url.pathname);
---
<SiteFooterShell>
  <Fragment slot="brand">
    <p class="footer-brand-tagline">Pilietinė iniciatyva</p>
    <a href="/" class="footer-brand-mark" aria-label="Viešpirkiai – pradžia">
      <Fragment set:html={logoSvg} />
    </a>
  </Fragment>

  <FooterColumn title="Duomenys">
    <a href="/duomenys#duomenu-saltiniai">Duomenų šaltiniai</a>
    <a href="/mcp">MCP</a>
    <a href="/analitika">Analitika</a>
    <a href="/kodas" class="footer-link-external">Kodas</a>
  </FooterColumn>

  <FooterColumn title="Projektas">
    <a href="/kontaktai">Kontaktai</a>
    <a href="/privatumas">Privatumo politika</a>
    <a href="https://www.facebook.com/profile.php?id=100003117510876" rel="me" class="footer-link-external">Facebook</a>
    <a href="https://river.group.lt/@viespirkiai" rel="me" class="footer-link-external">Mastodon</a>
  </FooterColumn>

  <FooterColumn title="Nustatymai">
    <button type="button" id="fontToggle">Pakeisti šriftą</button>
    <button type="button" id="rodytiReklamas" hidden>Rodyti reklamas</button>
    <button type="button" id="rodytiDiSantraukas" hidden>Rodyti AI santraukas</button>
  </FooterColumn>

  {rodytiIspejima && (
    <p slot="disclaimer" class="footer-disclaimer">
      <em>
        Rekomenduojame tikrinti pateiktą informaciją. Ji buvo automatiškai surinkta remiantis tik viešais šaltiniais, gali būti pasenusi, klaidinga.
        <br>Jeigu yra priežastis, kodėl tokia ji turėtų būti neskelbiama, šalinama ar pataisyta – prašome susisiekti.
        Daugiau informacijos rasite <a href="/kontaktai#informacijosTikslumas" class="text-inherit">kontaktų puslapyje</a>.
      </em>
    </p>
  )}

  {buildInfo && (
    <div slot="meta" class="footer-meta">
      <span>Versija</span>
      <a
        href={buildInfo.commitUrl}
        class="footer-commit footer-link-external"
        rel="noopener"
        title={`Commit ${buildInfo.commit}`}
      >{buildInfo.shortCommit}</a>
    </div>
  )}
</SiteFooterShell>

<script>
  document.getElementById('fontToggle')?.addEventListener('click', () => {
    const meta = document.querySelector<HTMLElement>('meta[data-font]');
    if (!meta) return;
    const next = meta.dataset.font === 'comic' ? 'ubuntu' : 'comic';
    meta.dataset.font = next;
    document.cookie = `font=${next};path=/;max-age=31536000`;
  });

  // „Rodyti reklamas" – matoma tik jei anksčiau paspausta „Niekada neberodyti".
  // Ištrina slapuką ir perkrauna, kad SSR vėl rodytų reklamas.
  const rodytiReklamas = document.getElementById('rodytiReklamas');
  if (rodytiReklamas && /(?:^|;\s*)reklamosPaslepta=1(?:;|$)/.test(document.cookie)) {
    rodytiReklamas.hidden = false;
    rodytiReklamas.addEventListener('click', () => {
      document.cookie = 'reklamosPaslepta=;path=/;max-age=0;samesite=lax';
      location.reload();
    });
  }

  // „Rodyti AI santraukas" – matoma tik jei anksčiau paspausta „Neberodyti".
  const rodytiDiSantraukas = document.getElementById('rodytiDiSantraukas');
  if (rodytiDiSantraukas && /(?:^|;\s*)showAi=false(?:;|$)/.test(document.cookie)) {
    rodytiDiSantraukas.hidden = false;
    rodytiDiSantraukas.addEventListener('click', () => {
      document.cookie = 'showAi=;path=/;max-age=0;samesite=lax';
      location.reload();
    });
  }
</script>
