---
// /teisesAktai rezultatų sritis: įrankių juosta (kiekis + rikiavimas), berėmis
// kortelių sąrašas (arba tuščia būsena) ir puslapiavimas.
import EmptyState from '@design-system/components/EmptyState.astro';
import FlatResultList from '@design-system/components/content/FlatResultList.astro';
import TaResultCard from './TaResultCard.astro';
import type { TeisesAktasHit, TeisesAktaiSort } from '../../lib/searchTeisesAktai.ts';

interface Props {
  hits: TeisesAktasHit[];
  resultsMetaHtml: string;
  sort: TeisesAktaiSort;
  sortOptions: readonly { value: string; label: string }[];
  q: string;
  page: number;
  totalPages: number;
  pageNums: number[];
  buildPageUrl: (page: number) => string;
}

const { hits, resultsMetaHtml, sort, sortOptions, q, page, totalPages, pageNums, buildPageUrl } = Astro.props;
---

{hits.length > 0 && (
  <div class="ta-results-toolbar">
    <p class="ta-results-meta text-xs text-muted" set:html={resultsMetaHtml} />
    <label class="ta-sort">
      <span class="sr-only">Rikiuoti pagal</span>
      <select id="taSort" aria-label="Rikiuoti pagal">
        {sortOptions.map((option) => (
          <option value={option.value} selected={sort === option.value}>{option.label}</option>
        ))}
      </select>
    </label>
  </div>
)}

{hits.length === 0 ? (
  <EmptyState message={q ? `Jokių rezultatų pagal „${q}".` : 'Jokių rezultatų.'} />
) : (
  <FlatResultList className="ta-result-list">
    {hits.map((hit) => <TaResultCard hit={hit} />)}
  </FlatResultList>
)}

{pageNums.length > 0 && (
  <nav class="ta-pagination" aria-label="Puslapiai">
    {page > 1 ? (
      <a href={buildPageUrl(page - 1)} class="ta-page-btn ta-page-nav" aria-label="Ankstesnis puslapis">‹</a>
    ) : (
      <span class="ta-page-btn ta-page-nav is-disabled" aria-disabled="true">‹</span>
    )}
    {pageNums.map((pn) => (
      pn === page ? (
        <span class="ta-page-btn is-current" aria-current="page">{pn}</span>
      ) : (
        <a href={buildPageUrl(pn)} class="ta-page-btn">{pn}</a>
      )
    ))}
    {page < totalPages ? (
      <a href={buildPageUrl(page + 1)} class="ta-page-btn ta-page-nav" aria-label="Kitas puslapis">›</a>
    ) : (
      <span class="ta-page-btn ta-page-nav is-disabled" aria-disabled="true">›</span>
    )}
  </nav>
)}

<style is:global>
  .ta-results-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 24px;
  }
  .ta-results-meta { margin: 0; }
  .ta-sort { flex-shrink: 0; }
  .ta-sort select {
    min-width: 190px;
    padding: 7px 10px;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--black);
    font: inherit;
    font-size: var(--text-sm);
  }
  .ta-sort select:focus-visible { outline: var(--border-focus); }

  /* Kilmės eilutė virš antraštės: kas priėmė ir (jei ne originalas) kuri redakcija. */
  .ta-provenance {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--gray);
    overflow: hidden;
    white-space: nowrap;
  }
  .ta-institution {
    color: var(--dark-gray);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .ta-provenance-sep { flex-shrink: 0; }
  .ta-variantas, .ta-no-preview { flex-shrink: 0; }

  .ta-snippet {
    margin-top: 12px;
    line-height: 1.6;
    max-width: 60ch;
  }
  .ta-snippet strong,
  .ta-snippet mark {
    background: none;
    color: var(--black);
    font-weight: 600;
  }

  /* EUROVOC terminai — tylios etiketės, ne veiksmas (jos nespaudžiamos, nes
     visa kortelė yra nuoroda). Filtruoti pagal terminą galima šoninėje juostoje. */
  .ta-eurovoc {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .ta-eurovoc li {
    font-size: var(--text-xs);
    color: var(--dark-gray);
    background: var(--lighter-gray);
    border-radius: var(--radius-pill);
    padding: 2px 8px;
  }

  .ta-result-list .ta-meta {
    margin-top: 16px;
    gap: 6px 18px;
    font-size: var(--text-xs);
    color: var(--gray);
  }
  .ta-result-list .ta-meta div {
    display: inline-flex;
    gap: 4px;
    min-width: 0;
  }
  .ta-result-list .ta-meta dt:not(.sr-only) {
    color: var(--dark-gray);
    font-weight: 500;
  }
  .ta-result-list .ta-meta dd { overflow-wrap: anywhere; }

  .ta-pagination {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    margin: 48px 0 64px;
  }
  .ta-page-nav:first-child { margin-right: 8px; }
  .ta-page-nav:last-child  { margin-left:  8px; }
  .ta-page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--dark-gray);
    transition: background var(--transition), color var(--transition);
  }
  .ta-page-btn:is(a):hover {
    background: var(--lighter-gray);
    color: var(--black);
  }
  .ta-page-btn.is-current {
    background: var(--black);
    color: var(--white);
    font-weight: 500;
  }
  .ta-page-btn.ta-page-nav {
    font-size: var(--text-lg);
    min-width: 24px;
  }
  .ta-page-btn.is-disabled {
    color: var(--gray);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .ta-results-toolbar {
      flex-wrap: wrap;
      gap: 8px 16px;
    }
    .ta-sort select { min-width: 160px; }
  }
</style>

<script>
  import { params, navigate, showLoading } from '../../scripts/teisesAktaiNav.ts';

  document.getElementById('taSort')?.addEventListener('change', (event) => {
    const value = (event.currentTarget as HTMLSelectElement).value;
    if (value === 'relevance') params.delete('sort');
    else params.set('sort', value);
    params.delete('page');
    navigate(true);
  });

  document.querySelectorAll<HTMLAnchorElement>('.ta-pagination a[href]')
    .forEach((a) => a.addEventListener('click', showLoading));
</script>
