---
// /teisesAktai filtrų šoninė juosta. Facetų eilutes piešia DokFacetSection —
// tas pats komponentas kaip /dokumentai (jo `.dok-filter-*` stiliai globalūs),
// kad abu puslapiai atrodytų ir elgtųsi vienodai. Čia — tik juostos karkasas ir
// facetų katalogas.
//
// Ilgi facetai („Daugiau") atsidaro viso ekrano modale (TaFacetModal), o ne
// išsiskleidžia vietoje: rūšių, institucijų ir EUROVOC terminų yra šimtai —
// juostoje jie tiesiog nesutelpa.
import DokFacetSection from '../dokumentai/DokFacetSection.astro';
import HistogramRangeFilter from '@design-system/components/filters/HistogramRangeFilter.astro';
import type { TaFacet } from '../../lib/teisesAktaiUrl.ts';
import type { DataHistogram } from '../../lib/searchTeisesAktai.ts';
import { statusasLabel, eurovocLabel, variantasLabel, turinysLabel } from '../../lib/teisesAktaiLabels.ts';

interface Props {
  activeFilterCount: number;
  hasFilters: boolean;
  clearUrl: string;
  rusis: TaFacet;
  statusas: TaFacet;
  variantas: TaFacet;
  prieme: TaFacet;
  eurovoc: TaFacet;
  turinys: TaFacet;
  dataHist: DataHistogram;
  nuo: string | null;
  iki: string | null;
  istaigosNr: string | null;
  regNr: string | null;
}

const p = Astro.props;

const top = [
  { label: 'Akto rūšis', param: 'rusis', facet: p.rusis, allLabel: 'Visos',
    modal: { field: 'aktoRusis', title: 'Akto rūšis' } },
  { label: 'Būsena', param: 'statusas', facet: p.statusas, allLabel: 'Visos',
    formatLabel: statusasLabel },
  { label: 'Redakcija', param: 'variantas', facet: p.variantas, allLabel: 'Visos',
    formatLabel: variantasLabel },
];

const mid = [
  // Institucijų pavadinimai ilgi („Lietuvos Respublikos … ministerija") — modale
  // jiems duodam mažiau, bet platesnių stulpelių.
  { label: 'Priėmė', param: 'prieme', facet: p.prieme, allLabel: 'Visos institucijos',
    modal: { field: 'prieme', title: 'Priėmusi institucija', wide: true } },
  { label: 'EUROVOC', param: 'eurovoc', facet: p.eurovoc, allLabel: 'Visi terminai',
    formatLabel: eurovocLabel, modal: { field: 'eurovoc', title: 'EUROVOC terminai' } },
];

const other = [
  { label: 'Turinys', param: 'turinys', facet: p.turinys, allLabel: 'Visi', formatLabel: turinysLabel },
];

// Numeriai facetų neturi (per didelė reikšmių aibė) — tai tikslaus įvedimo
// laukai „Kituose filtruose".
const numberFields = [
  { label: 'Įstaigos suteiktas numeris', param: 'istaigosNr', value: p.istaigosNr,
    placeholder: 'pvz. 49' },
  { label: 'Registracijos numeris', param: 'regNr', value: p.regNr,
    placeholder: 'pvz. 2021-00375' },
];

const otherCount = p.turinys.filter.length
  + (p.istaigosNr ? 1 : 0) + (p.regNr ? 1 : 0);
---

<aside class="dok-sidebar" id="taSidebar" aria-label="Filtrai">
  <div class="dok-sidebar-head">
    <button type="button" class="dok-sidebar-title" id="taFiltersToggle" aria-expanded="false" aria-controls="taFiltersBody">
      <span class="sr-only">Filtrai</span>{p.activeFilterCount > 0 && <span class="dok-filters-count">{p.activeFilterCount}</span>}
      <span class="dok-filters-chevron" aria-hidden="true"></span>
    </button>
    {p.hasFilters && <a href={p.clearUrl} class="dok-sidebar-clear">Panaikinti</a>}
  </div>

  <div class="dok-filters-body" id="taFiltersBody">
    {top.map((x) => <DokFacetSection {...x} />)}

    <HistogramRangeFilter
      mode="date"
      legend="Priėmimo data"
      nameFrom="nuo"
      nameTo="iki"
      redirectBase="/teisesAktai"
      hist={p.dataHist}
      valueFrom={p.nuo ?? undefined}
      valueTo={p.iki ?? undefined}
      ariaFrom="Priimta nuo"
      ariaTo="Priimta iki"
    />

    {mid.map((x) => <DokFacetSection {...x} />)}

    <details class="dok-other-filters" open={otherCount > 0}>
      <summary>
        Kiti filtrai
        {otherCount > 0 && <span class="dok-other-filters-count">{otherCount}</span>}
      </summary>
      {other.map((x) => <DokFacetSection {...x} />)}

      {numberFields.map((f) => (
        <section class="dok-filter-section">
          <span class="dok-filter-section-label">{f.label}</span>
          <form class="dok-input-form" data-ta-text-filter={f.param} autocomplete="off">
            <input
              type="text"
              class="dok-input"
              name={f.param}
              value={f.value ?? ''}
              placeholder={f.placeholder}
              aria-label={f.label}
            />
            <button type="submit" class="dok-input-btn" aria-label="Taikyti">→</button>
          </form>
        </section>
      ))}
    </details>

    <p class="dok-facet-note">Rodomi apytiksliai skaičiai.</p>
  </div>
</aside>

<style is:global>
  /* Juostos karkasas — tokios pačios metrikos kaip /dokumentai, kad abu
     puslapiai turėtų tą pačią kairę liniją po logotipu. */
  .dok-sidebar {
    grid-area: sidebar;
    padding: 24px 20px 24px 0;
  }
  .dok-filters-body > .dok-filter-section:first-child { padding-top: 0; }

  .dok-sidebar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    min-height: 0;
  }
  .dok-sidebar-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--dark-gray);
    cursor: default;
  }
  .dok-filters-count {
    display: none;  /* tik mobilioje, kur filtrai suskleisti */
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--radius-pill);
    background: var(--black);
    color: var(--white);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0;
  }
  .dok-filters-chevron { display: none; }
  .dok-filters-chevron::before { content: "▾"; font-size: 11px; }
  .dok-sidebar-clear { font-size: var(--text-xs); color: var(--dark-gray); }
  .dok-sidebar-clear:hover { color: var(--black); }

  .dok-facet-note {
    margin: 20px 0 0;
    font-size: var(--text-xs);
    color: var(--gray);
  }

  /* Datos slankiklis stoja į tą pačią facetų eilę — tik atitraukiam viršų,
     kaip ir kitose sekcijose. */
  .dok-filters-body .hrf { padding-top: 20px; }

  .dok-other-filters {
    margin-top: 20px;
    border-top: 1px solid var(--light-gray);
  }
  .dok-other-filters summary {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 12px;
    color: var(--dark-gray);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    cursor: pointer;
    list-style: none;
  }
  .dok-other-filters summary::-webkit-details-marker { display: none; }
  .dok-other-filters summary::before {
    content: "▸";
    font-size: 11px;
    transition: transform var(--transition);
  }
  .dok-other-filters[open] summary::before { transform: rotate(90deg); }
  .dok-other-filters-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--radius-pill);
    background: var(--black);
    color: var(--white);
    font-size: 10px;
    letter-spacing: 0;
  }

  @media (max-width: 900px) {
    .dok-sidebar {
      padding: 0;
      margin-top: 4px;
      border-right: none;
      border-bottom: var(--border);
    }
    .dok-sidebar-head {
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: none;
      align-items: center;
    }
    .dok-sidebar-title { cursor: pointer; padding: 12px 0; }
    .dok-filters-chevron { display: inline-flex; transition: transform var(--transition); }
    .dok-filters-count { display: inline-flex; }
    .dok-sidebar.is-open .dok-filters-chevron { transform: rotate(180deg); }
    .dok-filters-body {
      box-sizing: border-box;
      height: 0;
      overflow: hidden;
      transition: height 0.4s ease;
    }
    .dok-sidebar.is-open .dok-filters-body { height: auto; padding-bottom: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dok-filters-body { transition: none; }
  }
</style>

<script>
  import '../../scripts/teisesAktaiFilters.ts';
  import { initHistogramRangeFilters } from '@design-system/components/filters/histogramRangeFilter.ts';
  import { initStickyRail } from '../../lib/stickyRail';
  initHistogramRangeFilters();
  initStickyRail('.dok-sidebar');
</script>
