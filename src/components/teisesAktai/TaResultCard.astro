---
// Vienas /teisesAktai paieškos rezultatas. Grynas markup'as — sąrašo stiliai
// gyvena TaResults.astro. Visi laukai ateina iš Quickwit indekso (stored), o
// ištrauka — iš e-TAR sidecar'o.
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultCardMeta from '@design-system/components/ResultCardMeta.astro';
import type { TeisesAktasHit } from '../../lib/searchTeisesAktai.ts';
import { variantasLabel, statusasLabel, eurovocLabel, beTeksto, beTekstoZinute } from '../../lib/teisesAktaiLabels.ts';

interface Props {
  hit: TeisesAktasHit;
}

const { hit } = Astro.props;

const title = hit.pavadinimas || hit.registracijosNr || `Dokumentas #${hit.documentId}`;
// Vedam į savo akto puslapį, ne tiesiai į e-TAR: ten surinkta viskas (metaduomenys,
// ryšiai, priedai, redakcijos), o nuoroda į e-TAR yra puslapio viršuje.
const targetUrl = hit.legalActId
  ? `/teisesAktas/${encodeURIComponent(hit.legalActId)}${
      hit.redakcijosTokenas ? `?v=${encodeURIComponent(hit.redakcijosTokenas)}` : ''}`
  : (hit.url || '#');
const variantas = variantasLabel(hit.variantas);
// Originalo variantas yra numatytasis — žymim tik suvestines, kad kortelėje
// neliktų triukšmo ties kiekvienu įrašu.
const showVariantas = hit.variantas !== 'original';

// Galiojimo laikotarpis viena eilute: „2024-04-01 → 2025-01-01" / „nuo 2024-04-01".
const galiojimas = hit.isigaliojoNuo && hit.galiojaIki
  ? `${hit.isigaliojoNuo} – ${hit.galiojaIki}`
  : hit.isigaliojoNuo
    ? `nuo ${hit.isigaliojoNuo}`
    : hit.galiojaIki
      ? `iki ${hit.galiojaIki}`
      : '';

const footerMetaItems: any[] = [
  hit.aktoRusis && { label: 'Rūšis', value: hit.aktoRusis },
  hit.statusas && { label: 'Būsena', value: statusasLabel(hit.statusas) },
  hit.priemimoData && { label: 'Priimta', value: hit.priemimoData, hiddenLabel: false },
  galiojimas && { label: 'Galioja', value: galiojimas, title: 'Galiojimo laikotarpis', hiddenLabel: false },
  hit.registracijosNr && { label: 'Registracijos Nr.', value: hit.registracijosNr },
  hit.istaigosNr && { label: 'Įstaigos Nr.', value: hit.istaigosNr },
  hit.redakcijuSkaicius > 0 && { label: 'Redakcijos', value: `${hit.redakcijuSkaicius} red.`, title: 'Suvestinių redakcijų skaičius' },
  hit.prieduSkaicius > 0 && { label: 'Priedai', value: `${hit.prieduSkaicius} pr.`, title: 'Priedų skaičius' },
].filter(Boolean);

// EUROVOC — trumpas sąrašas po meta eilute; ilgą uodegą nukerpam. Etiketės
// tvarkomos taip pat kaip šoninėje juostoje (be srities numerio, iš didžiosios).
const eurovoc = hit.eurovoc.slice(0, 6).map(eurovocLabel);
---

<ResultCardShell clickable={true} className="ta-card">
  <div slot="meta" class="ta-provenance">
    {hit.prieme && <span class="ta-institution">{hit.prieme}</span>}
    {showVariantas && (
      <>
        <span class="ta-provenance-sep" aria-hidden="true">›</span>
        <span class="ta-variantas">{variantas}</span>
      </>
    )}
    {beTeksto(hit.turinioBusena) && (
      <>
        <span class="ta-provenance-sep" aria-hidden="true">›</span>
        <span class="ta-no-preview" title={beTekstoZinute(hit.turinioBusena)}>be teksto</span>
      </>
    )}
  </div>

  <h3 slot="title" class="result-card-title">
    <a href={targetUrl}>{title}</a>
  </h3>

  {hit.snippet && (
    <p class="ta-snippet text-sm text-muted mt-2" set:html={hit.snippet} />
  )}

  {eurovoc.length > 0 && (
    <ul class="ta-eurovoc" aria-label="EUROVOC terminai">
      {eurovoc.map((term) => <li>{term}</li>)}
    </ul>
  )}

  <ResultCardMeta slot="footer" className="ta-meta" items={footerMetaItems} />
</ResultCardShell>
