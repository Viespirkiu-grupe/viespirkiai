---
// Redakcijų palyginimo vaizdas: du sąrašai vienas prieš kitą, po jais –
// skirtumai. Duomenis paduoda maršrutas, nes tik jis gali nukreipti.
//
// Rinkimasis yra dvi paprastos nuorodos: kairysis sąrašas veda į
// /palyginimas/:a, dešinysis – į /palyginimas/:a/:b. Jokio JS, kiekvienas
// žingsnis turi savo adresą, „atgal" veikia kaip tikimasi.
import Layout from '../../layouts/Layout.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import Alert from '@design-system/components/Alert.astro';
import { teisesAktoKelias } from '../../lib/teisesAktasPageData.ts';
import { laikotarpis, palyginimoKelias, type PalyginimoDuomenys } from '../../lib/redakcijuPalyginimas.ts';
import { getColorScheme, getFont } from '../../lib/failai.js';
import config from '../../lib/config.ts';

interface Props {
  id: string;
  data: PalyginimoDuomenys;
}
const { id, data } = Astro.props;
const { pavadinimas, redakcijos, a, b, klaida, suvestine, pakeitimai } = data;

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const naujausiaSuTekstu = redakcijos.find(r => r.turiTeksta) ?? null;

/**
 * Kairė: bet kuri redakcija su tekstu, išskyrus pačią naujausią — už ją
 * naujesnės nėra, tad palyginimo pora nesusidėtų.
 */
function kaireGalima(r: typeof redakcijos[number]): boolean {
  return r.turiTeksta && r.editionToken !== naujausiaSuTekstu?.editionToken;
}

/** Dešinė: tik naujesnės už pasirinktą kairėje. */
function desineGalima(r: typeof redakcijos[number]): boolean {
  return Boolean(a) && r.turiTeksta && r.nuo > a!.nuo;
}

/** Pasirinkus kitą kairės pusę, per sena dešinė nebetinka – ją numetam. */
const kaireHref = (r: typeof redakcijos[number]) =>
  palyginimoKelias(id, r.editionToken, b && b.nuo > r.nuo ? b.editionToken : null);
const desineHref = (r: typeof redakcijos[number]) =>
  palyginimoKelias(id, a?.editionToken, r.editionToken);

const ZENKLAS: Record<string, string> = {
  pakeista: 'Pakeista',
  'pridėta': 'Pridėta',
  'pašalinta': 'Pašalinta',
};

// Be „kairėje"/„dešinėje": telefone rodomas tik vienas sąrašas, pusių nėra.
// Kurią pusę renkiesi, sako pats sąrašo pavadinimas.
const pastaba = !a
  ? 'Pasirinkite senesnę redakciją.'
  : !b ? 'Dabar pasirinkite naujesnę redakciją.' : null;
---

<Layout
  pageTitle={`Redakcijų palyginimas – ${pavadinimas}`}
  pageDescription={`Kas pasikeitė tarp dviejų akto „${pavadinimas}“ suvestinių redakcijų.`}
  colorScheme={colorScheme}
  font={font}
  customHead={config.customHead}
>
  <main>
    <PageHeader>
      <span slot="subtext">Redakcijų palyginimas</span>
      {/* Atgal į aktą veda pats pavadinimas – atskiro mygtuko tam nereikia. */}
      <a href={teisesAktoKelias(id)} class="pal-act">{pavadinimas}</a>
    </PageHeader>

    {!klaida && pastaba && <p class="pal-hint">{pastaba}</p>}

    {b ? (
      /* Kai palyginimas jau rodomas, rinkimosi sąrašai tik trukdo – lieka
         juostelė su tuo, kas lyginama, ir kelias atgal į rinkimąsi. */
      <div class="pal-chosen">
        <a class="pal-chosen-side" href={teisesAktoKelias(id, a!.editionToken)}>
          <span class="pal-chosen-zyme">A</span>{laikotarpis(a!)}
        </a>
        <span class="pal-chosen-arrow">→</span>
        <a class="pal-chosen-side" href={teisesAktoKelias(id, b.editionToken)}>
          <span class="pal-chosen-zyme">B</span>{laikotarpis(b)}
        </a>
        <a class="pal-chosen-change" href={palyginimoKelias(id, a!.editionToken)}>Keisti pasirinkimą</a>
      </div>
    ) : (
      <div class="pal-pick" data-zingsnis={a ? 'b' : 'a'}>
        <div class="pal-track">
          {[
            { pusė: 'a' as const, antraste: 'Senesnė redakcija', pasirinkta: a, galima: kaireGalima, href: kaireHref },
            { pusė: 'b' as const, antraste: 'Naujesnė redakcija', pasirinkta: b, galima: desineGalima, href: desineHref },
          ].map((k) => (
            <section class:list={['pal-col', `is-${k.pusė}`]}>
              <h2 class="pal-col-title">
                {k.pusė === 'b' && a && (
                  <a class="pal-back" href={palyginimoKelias(id)} aria-label="Rinktis senesnę iš naujo">←</a>
                )}
                {k.antraste}
                {k.pasirinkta && <span class="pal-col-value">{laikotarpis(k.pasirinkta)}</span>}
              </h2>
              <ul class="pal-options">
                {redakcijos.map((r) => {
                  const aktyvi = k.pasirinkta?.editionToken === r.editionToken;
                  const galima = k.galima(r);
                  return (
                    <li>
                      {galima ? (
                        <a
                          href={k.href(r)}
                          class:list={['pal-option', aktyvi && 'is-selected']}
                          aria-current={aktyvi ? 'true' : undefined}
                        >
                          <span class="pal-option-when">{laikotarpis(r)}</span>
                        </a>
                      ) : (
                        <span
                          class:list={['pal-option', 'is-off', aktyvi && 'is-selected']}
                          title={!r.turiTeksta ? 'Šios redakcijos tekstas neprieinamas' : undefined}
                        >
                          <span class="pal-option-when">{laikotarpis(r)}</span>
                          {!r.turiTeksta && <span class="pal-option-note">teksto nėra</span>}
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </div>
    )}

    {klaida && <Alert variant="warning">{klaida}</Alert>}

    {!klaida && suvestine && (
      <>
        <div class="pal-summary">
          <span class="pal-counts">
            <span class="pal-chip is-mod">{suvestine.pakeista} pakeista</span>
            <span class="pal-chip is-add">{suvestine['pridėta']} pridėta</span>
            <span class="pal-chip is-del">{suvestine['pašalinta']} pašalinta</span>
          </span>
        </div>

        {pakeitimai.length === 0 ? (
          <Alert variant="info">Tekstų skirtumų tarp šių redakcijų nerasta.</Alert>
        ) : (
          <div class="pal-list">
            {pakeitimai.map((p) => (
              <article class:list={['pal-item', `is-${p.pokytis}`]}>
                <header class="pal-item-head">
                  <h3 class="pal-item-title">{p.pavadinimas}</h3>
                  <span class:list={['pal-badge', `is-${p.pokytis}`]}>{ZENKLAS[p.pokytis]}</span>
                </header>
                {p.pakopos.length > 0 && <p class="pal-path">{p.pakopos.join(' › ')}</p>}
                <div class="pal-body">
                  {p.eilutes.map((e) => (
                    e.tipas === 'pakeista' ? (
                      <p class="pal-line">
                        {e.segmentai!.map((s) => (
                          s.tipas === 'pridėta' ? <ins>{s.tekstas}</ins>
                          : s.tipas === 'pašalinta' ? <del>{s.tekstas}</del>
                          : <span>{s.tekstas}</span>
                        ))}
                      </p>
                    ) : e.tipas === 'pridėta' ? (
                      <p class="pal-line"><ins>{e.tekstas}</ins></p>
                    ) : (
                      <p class="pal-line"><del>{e.tekstas}</del></p>
                    )
                  ))}
                </div>
              </article>
            ))}
          </div>
        )}
      </>
    )}
  </main>
</Layout>

<style>
  /* Šviesioje temoje `--color-success`/`--color-danger` yra tamsūs (700-oji
     pakopa) ir gerai skaitosi ant šviesaus fono. Tamsioje temoje fonas virsta
     950-ąja pakopa, o pats tekstas lieka tamsus — kontrasto beveik nelieka.
     Todėl tamsioje temoje spalvą pašviesinam iki teksto spalvos link. */
  main {
    --pal-add: var(--color-success);
    --pal-del: var(--color-danger);
  }
  :global(.dark) main {
    --pal-add: color-mix(in oklab, var(--color-success) 45%, var(--black));
    --pal-del: color-mix(in oklab, var(--color-danger) 45%, var(--black));
  }

  .pal-act {
    color: inherit;
    text-decoration: none;
  }
  .pal-act:hover { text-decoration: underline; }

  /* ── rinkimasis: du vienodi sąrašai vienas prieš kitą */
  .pal-pick {
    margin-bottom: 20px;
  }
  .pal-track {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }

  .pal-col {
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    overflow: hidden;
  }
  /* Antraštė lieka matoma slenkant – sąrašas ilgas, o be jos nebeaišku, kurią
     pusę renkiesi. */
  .pal-col-title {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    padding: 8px 12px;
    border-bottom: var(--border);
    background: var(--color-muted-bg);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .pal-col-value {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    color: var(--dark-gray);
  }
  .pal-back {
    text-decoration: none;
    font-size: var(--text-base);
    line-height: 1;
  }

  /* Sąrašas savo scroll'o neturi: einam iki puslapio apačios, o slenka pats
     puslapis. Dviejų slenkamų dėžučių lange skaityti neįmanoma. */
  .pal-options {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pal-option {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 7px 12px;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--black);
    text-decoration: none;
  }
  .pal-options li + li .pal-option { border-top: 1px solid var(--light-gray); }
  a.pal-option:hover { background: var(--color-muted-bg); }
  .pal-option.is-selected {
    background: var(--color-muted-bg);
    font-weight: 600;
  }
  .pal-option.is-selected::before {
    content: '●';
    color: var(--pal-add);
  }
  /* Neįmanoma pora (ne naujesnė redakcija arba teksto neturim) lieka matoma,
     bet nespaudžiama — kad matytųsi visa akto istorija. */
  .pal-option.is-off {
    color: var(--gray);
    cursor: not-allowed;
  }
  .pal-option-note {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--gray);
  }

  /* Telefone abu sąrašai vienas šalia kito netelpa: rodom po vieną ir,
     pasirinkus senesnę, perstumiam į naujesnę. */
  @media (max-width: 700px) {
    .pal-pick { overflow: hidden; }
    /* Takelis dvigubo pločio, kiekvienas skydelis – pusė jo, t. y. lygiai
       ekrano plotis. */
    .pal-track {
      grid-template-columns: repeat(2, 50%);
      gap: 0;
      width: 200%;
    }
    .pal-pick[data-zingsnis='b'] .pal-track {
      transform: translateX(-50%);
      animation: pal-slide 260ms ease;
    }
    .pal-col { border-radius: var(--radius-md); }
  }
  @keyframes pal-slide {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pal-pick[data-zingsnis='b'] .pal-track { animation: none; }
  }

  /* ── pasirinkta pora, kai jau rodomi skirtumai */
  .pal-chosen {
    display: inline-flex;
    flex-wrap: wrap;
    width: max-content;
    max-width: 100%;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 16px;
    padding: 8px 12px;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    font-size: var(--text-sm);
  }
  .pal-chosen-side {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-variant-numeric: tabular-nums;
    color: var(--black);
    text-decoration: none;
  }
  .pal-chosen-side:hover { text-decoration: underline; }
  .pal-chosen-zyme {
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    background: var(--lighter-gray);
    color: var(--dark-gray);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .pal-chosen-arrow { color: var(--gray); }
  .pal-chosen-change {
    margin-left: 8px;
    padding-left: 12px;
    border-left: var(--border);
    font-size: var(--text-sm);
  }

  .pal-hint {
    margin: 0 0 12px;
    font-size: var(--text-sm);
    color: var(--dark-gray);
  }

  /* ── skirtumai */
  .pal-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: 12px;
  }
  .pal-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pal-chip {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 600;
    background: var(--lighter-gray);
    color: var(--dark-gray);
  }
  .pal-chip.is-add { background: var(--color-success-bg); color: var(--pal-add); }
  .pal-chip.is-del { background: var(--color-danger-bg); color: var(--pal-del); }
  .pal-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pal-item {
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    padding: 12px 16px;
  }
  /* Kraštinė kairėje – kad slenkant matytųsi, ar dalis nauja, dingusi, ar tik
     pataisyta, dar neskaitant paties teksto. */
  .pal-item.is-pridėta { border-left: 3px solid var(--pal-add); }
  .pal-item.is-pašalinta { border-left: 3px solid var(--pal-del); }

  .pal-item-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .pal-item-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }
  .pal-badge {
    flex-shrink: 0;
    margin-left: auto;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 600;
    background: var(--lighter-gray);
    color: var(--dark-gray);
  }
  .pal-badge.is-pridėta { background: var(--color-success-bg); color: var(--pal-add); }
  .pal-badge.is-pašalinta { background: var(--color-danger-bg); color: var(--pal-del); }

  .pal-path {
    margin: 2px 0 8px;
    font-size: var(--text-xs);
    color: var(--gray);
  }

  .pal-body { font-size: var(--text-sm); }
  .pal-line {
    margin: 0 0 8px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .pal-line:last-child { margin-bottom: 0; }

  /* Įterpimai ir išbraukimai – spalva PLIUS forma (pabraukimas, perbraukimas),
     kad skirtumas matytųsi ir nespalvotai spausdinant, ir daltonikui. */
  ins {
    background: var(--color-success-bg);
    color: var(--pal-add);
    text-decoration: underline;
  }
  del {
    background: var(--color-danger-bg);
    color: var(--pal-del);
  }
</style>
