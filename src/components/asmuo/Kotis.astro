---
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import TruncationNotice from '@design-system/components/TruncationNotice.astro';

const { asmuo } = Astro.props;
if (!(asmuo.kotis?.count > 0)) return;
const { count, rows } = asmuo.kotis;
---

<div class="page-section mb-10" id="kotis">
  <h2><a href="#kotis" class="no-style">Valstybės pagalba (KOTIS)</a></h2>
  <TruncationNotice count={count} shown={rows.length} anchor="kotis" paramName="kotisLimit" label="įrašai" />
  <div class="result-list">
    {rows.map((item: any) => (
      <ResultCardShell clickable={true}>
        <dl slot="meta" class="result-card-meta">
          <div><dt class="sr-only">Teikėjas</dt><dd>{item.teikejas}</dd></div>
          <div><dt class="sr-only">Data</dt><dd>{String(item.suteikimoData).split(' ')[0]}</dd></div>
        </dl>
        <h3 slot="title" class="result-card-title">
          <a href={`https://kotis.kt.gov.lt/paraiskos/view_item/id.${item.id}`}>
            <span class="cell-mono">{new Intl.NumberFormat('lt-LT', { style: 'currency', currency: 'EUR' }).format(item.suma)}</span>
          </a>
        </h3>
        <div slot="footer" class="result-card-footer"><span>{item.pagalbosForma}</span></div>
      </ResultCardShell>
    ))}
  </div>
</div>
