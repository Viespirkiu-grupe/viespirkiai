---
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultSection from '@design-system/components/ResultSection.astro';

const { asmuo } = Astro.props;
if (!(asmuo.rcPranesimai?.rows > 0)) return;
const { rows, pranesimai } = asmuo.rcPranesimai;
---

<ResultSection
  id="rcPranesimai"
  title="Registrų centro pranešimai"
  count={rows}
  shown={pranesimai.length}
  paramName="rcPranesimaiLimit"
  forms={['naujausias pranešimas', 'naujausi pranešimai', 'naujausių pranešimų', 'naujausio pranešimo']}
>
  {pranesimai.map((p: any) => (
    <ResultCardShell>
      <dl slot="meta" class="result-card-meta">
        <div><dt class="sr-only">Paskelbta</dt><dd>Paskelbta {p.leidinioData}</dd></div>
        <div><dt class="sr-only">Leidinys</dt><dd><a href={p.leidinioLink} class="relative z-1">{p.leidinioNumeris}</a></dd></div>
      </dl>
      <h3 slot="title" class="result-card-title">{p.subtitle || p.title}</h3>
      {p.text && <p class="text-sm text-muted mt-2 line-clamp-4">{p.text}</p>}
    </ResultCardShell>
  ))}
</ResultSection>
