---
const { asmuo } = Astro.props;
if (!(asmuo.rcPranesimai?.rows > 0)) return;
const { rows, limit, pranesimai } = asmuo.rcPranesimai;
---

<div class="page-section mb-10" id="rcPranesimai">
  <h2><a href="#rcPranesimai" class="no-style">Registrų centro pranešimai</a></h2>
  {rows > limit && (
    <p class="text-muted text-sm mb-4">
      Rodomi tik {limit} naujausi pranešimai.
      <a href="?rcPranesimaiLimit=max#rcPranesimai">Rodyti visus ({rows})</a>
    </p>
  )}
  <div class="result-list">
    {pranesimai.map((p: any) => (
      <article class="result-card">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div><dt class="sr-only">Paskelbta</dt><dd>Paskelbta {p.leidinioData}</dd></div>
            <div><dt class="sr-only">Leidinys</dt><dd><a href={p.leidinioLink} class="relative z-1">{p.leidinioNumeris}</a></dd></div>
          </dl>
          <h3 class="result-card-title">{p.subtitle || p.title}</h3>
          {p.text && <p class="text-sm text-muted mt-2 line-clamp-4">{p.text}</p>}
        </div>
      </article>
    ))}
  </div>
</div>
