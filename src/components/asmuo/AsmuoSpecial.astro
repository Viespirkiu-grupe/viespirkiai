---
import ActionButtonRow from '@design-system/components/ActionButtonRow.astro';
import Layout from '../../layouts/Layout.astro';
import config from '../../lib/config.ts';

interface Props {
  jarKodas: string;
  pavadinimas: string;
  aprasymas: string;
  colorScheme?: string;
  font?: string;
}

const { jarKodas, pavadinimas, aprasymas, colorScheme = 'auto', font = 'ubuntu' } = Astro.props;
const actions = [
  { href: `/pirkejas/${jarKodas}`, label: '↗ Pirkimai' },
  { href: `/tiekejas/${jarKodas}`, label: '↗ Pardavimai' },
];
---

<Layout
  pageTitle="CVP IS netikras asmuo"
  colorScheme={colorScheme}
  font={font}
  customHead={config.customHead}
>
  <main>
    <div class="page-header">
      <h1 class="mb-0">{pavadinimas} <code>{jarKodas}</code></h1>
    </div>
    <ActionButtonRow items={actions} className="mb-4" />
    <p class="text-muted">{aprasymas}</p>
  </main>
</Layout>
