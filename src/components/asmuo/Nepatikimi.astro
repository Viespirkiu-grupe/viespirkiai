---
const { asmuo } = Astro.props;
const list = asmuo.nepatikimi ?? [];
if (list.length === 0) return;
---

<div class="page-section" id="nepatikimi">
  <h2><a href="#nepatikimi" class="no-style">Nepatikimų tiekėjų sąrašas</a></h2>
  <div class="result-list">
    {list.map((n: any) => (
      <article class="result-card">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div><dt class="sr-only">Įvesta</dt><dd>Įvesta {n.duomenuIvedimoData}</dd></div>
            <div><dt class="sr-only">Galioja</dt><dd>{n.dataNuoKuriosSkaiciuojama || 'nežinoma'} – {n.itrauktaIki || 'nežinoma'}</dd></div>
            <div><dt class="sr-only">Matyta</dt><dd>Matyta {n.paskutiniKartaMatytaSarase}</dd></div>
          </dl>
          <h3 class="result-card-title">
            {n.pagrindimas?.itraukimoPriezastis
              ? n.pagrindimas.itraukimoPriezastis[0].toUpperCase() + n.pagrindimas.itraukimoPriezastis.slice(1)
              : <em class="text-muted">Įtraukimo priežastis nenurodyta</em>}
          </h3>
          <div class="result-card-footer">
            <span><strong>Pirkėjas:</strong> {n.pirkimoVykdytojoPavadinimas || 'nenurodytas'}</span>
            <span><strong>Pirkimo nr.:</strong> {n.pirkimoNumeris || 'nenurodytas'}</span>
            {n.teismoSprendimoLink?.length > 5 && <span><a href={n.teismoSprendimoLink} target="_blank" rel="noopener noreferrer">↗ Teismo sprendimas</a></span>}
            {n.pagrindimas?.tiekejoPaaiskinimoDokumentoNuoroda?.length > 3 && (
              <span><a href={n.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda} target="_blank" rel="noopener noreferrer">↗ Tiekėjo paaiškinimo dokumentas ({n.pagrindimas.paaiskinimoPateikimoData || 'data nenurodyta'})</a></span>
            )}
          </div>
          {n.pagrindimas?.tiekejoPaaiskinimas?.length > 3 && (
            <>
              <blockquote class="mt-3">{n.pagrindimas.tiekejoPaaiskinimas}</blockquote>
              {n.pagrindimas.paaiskinimoPateikimoData && <p class="text-muted text-xs mt-1 text-right">Pateiktas: {n.pagrindimas.paaiskinimoPateikimoData}</p>}
            </>
          )}
        </div>
      </article>
    ))}
  </div>
</div>
