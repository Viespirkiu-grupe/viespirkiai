---
import PageSection from '@design-system/components/PageSection.astro';
import DataTable from '@design-system/components/DataTable.astro';
import DateValue from '@design-system/components/DateValue.astro';
import TruncationNotice from '@design-system/components/TruncationNotice.astro';
import Button from '@design-system/components/Button.astro';

const { asmuo } = Astro.props;
if (!(asmuo.teismoNuosprendziai?.rows > 0)) return;
const { rows, nuosprendziai } = asmuo.teismoNuosprendziai;
const dokumentaiUrl = `/dokumentai?mode=phrase&type=teismoNuosprendis&jar=${encodeURIComponent(asmuo.jar.jarKodas)}`;
---

<PageSection id="teismai" title="Teismo nuosprendžiai">
  <p><Button href={dokumentaiUrl} variant="secondary" size="sm">Atverti dokumentų paieškoje</Button></p>
  <TruncationNotice count={rows} shown={nuosprendziai.length} anchor="teismai" paramName="teismoNuosprendziaiLimit" forms={['naujausias nuosprendis', 'naujausi nuosprendžiai', 'naujausių nuosprendžių', 'naujausio nuosprendžio']} />
  <DataTable
    columns={[
      { label: 'Bylos numeris' },
      { label: 'Rūšis' },
      { label: 'Data', headerClassName: 'cell-center' },
      { label: 'Rolė' },
      { label: 'Teismas' },
    ]}
  >
    {nuosprendziai.map((n: any) => (
      <tr>
        <td class="cell-nowrap">
          <a href={`/teismoNuosprendis/${encodeURIComponent(n.litekoId)}`}>{n.bylosNumeris}</a>
        </td>
        <td class="teismai-col-rusis">
          <span class="cell-truncate">{n.bylosRusis}</span>
        </td>
        <td class="cell-center cell-mono cell-nowrap"><DateValue value={n.data} mono={false} /></td>
        <td class:list={['teismai-col-role', n.bylojeKaip === 'Atsakovas' && 'font-bold']}>
          <span class="cell-truncate">{n.bylojeKaip}</span>
        </td>
        <td class="teismai-col-court">
          <span class="cell-truncate">{n.teismas}</span>
        </td>
      </tr>
    ))}
  </DataTable>
</PageSection>

<style>
  .teismai-col-rusis,
  .teismai-col-role {
    max-width: 30ch;
  }

  .teismai-col-court {
    max-width: 40ch;
  }
</style>
