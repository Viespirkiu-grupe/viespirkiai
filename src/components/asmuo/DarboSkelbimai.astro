---
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultSection from '@design-system/components/ResultSection.astro';

const { asmuo } = Astro.props;
if (!(asmuo.darboSkelbimai?.rows > 0)) return;
const { rows, skelbimai } = asmuo.darboSkelbimai;
---

<ResultSection
  id="darboSkelbimai"
  title="Darbo skelbimai"
  count={rows}
  shown={skelbimai.length}
  paramName="darboSkelbimaiLimit"
  forms={['naujausias skelbimas', 'naujausi skelbimai', 'naujausių skelbimų', 'naujausio skelbimo']}
>
  {skelbimai.map((s: any) => (
    <ResultCardShell>
      <dl slot="meta" class="result-card-meta">
        <div><dt class="sr-only">Paskelbta</dt><dd>Paskelbta {s.ikelimo_data}</dd></div>
        <div><dt class="sr-only">Galioja</dt><dd>{s.galioja_nuo || 'nežinoma'} – {s.galioja_iki || 'nežinoma'}</dd></div>
      </dl>
      <h3 slot="title" class="result-card-title">{s.profesijos_pareigybes_pav || 'Profesijos pareigybės pavadinimas nenurodytas'}</h3>
      <p class="text-sm text-muted mt-2 line-clamp-4">{s.darbo_aprasymas_lt || 'Darbo aprašymas nenurodytas'}</p>
    </ResultCardShell>
  ))}
</ResultSection>
