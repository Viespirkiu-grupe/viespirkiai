---
import Chart from '@design-system/components/charts/Chart.astro';
import ChartTile from '@design-system/components/charts/ChartTile.astro';
import Table from '@design-system/components/Table.astro';
import TableWrapper from '@design-system/components/TableWrapper.astro';
const { asmuo, finansaiLimit } = Astro.props;
const ataskaitos = asmuo.finansai?.ataskaitos ?? [];
if (ataskaitos.length === 0) return;
const lentele = asmuo.finansai?.lentele;
const metai = lentele?.metai ?? [];
const duomenys = lentele?.duomenys ?? {};
const pardavimaiKasMetus = asmuo.sutartys?.tiekimaiKasMetus ?? [];
const financeRevenueByYear = Object.fromEntries(metai.map((year: string, index: number) => [year, duomenys['Pardavimo pajamos']?.[index] ?? null]));
const procurementRevenueByYear = Object.fromEntries(pardavimaiKasMetus.map((item: any) => [String(item.year), item.total || null]));
const mergedRevenueLabels = Array.from(new Set([...Object.keys(financeRevenueByYear), ...Object.keys(procurementRevenueByYear)]))
  .map(Number)
  .sort((a, b) => a - b)
  .map(String);
const mergedRevenueSeries = [
  { name: 'Pardavimo pajamos', data: mergedRevenueLabels.map((label) => financeRevenueByYear[label] ?? null) },
  { name: 'Viešųjų pirkimų pardavimai', data: mergedRevenueLabels.map((label) => procurementRevenueByYear[label] ?? null) },
];
const pelnoSeries = (duomenys['Grynasis pelnas (nuostoliai)'] ?? duomenys['Ataskaitinių metų pelnas (nuostoliai)'] ?? []).map((value: any) => value ?? null);
const hasNegativeProfit = pelnoSeries.some((value: any) => value !== null && value < 0);
const profitChartOptions = {
  annotations: hasNegativeProfit
    ? {
        yaxis: [{
          y: 0,
          y2: -100000000,
          borderColor: 'red',
          borderWidth: 2,
          label: {
            borderColor: 'red',
            style: { color: '#fff', background: 'red' },
            text: 'Nuostoliai',
          },
        }],
      }
    : {},
};
---

<div class="page-section mb-10" id="finansai">
  <h2><a href="#finansai" class="no-style">Finansinės ataskaitos</a></h2>

  <div class="grid-2 mb-10">
    <ChartTile title="Pardavimo pajamos" hasData={metai.length > 0 && !!duomenys['Pardavimo pajamos']} minHeightClass="" wrapperClass="">
      <Chart
        id="pardavimoPajamosChart"
        type="line-datetime"
        labels={mergedRevenueLabels}
        series={mergedRevenueSeries}
        flags={['yEUR', 'yMin0']}
        wrapperClass=""
        heightClass="h-75"
      />
    </ChartTile>

    <ChartTile title="Grynasis pelnas (nuostoliai)" hasData={metai.length > 0} minHeightClass="" wrapperClass="">
      <Chart
        id="grynasisPelnas"
        type="line-datetime"
        labels={metai.map(String)}
        series={pelnoSeries}
        flags={['yEUR', 'yMinAuto']}
        customOptions={profitChartOptions}
        wrapperClass=""
        heightClass="h-75"
      />
    </ChartTile>
  </div>

  {metai.length > 0 && (
    <TableWrapper className="mb-7">
      <Table>
        <thead>
          <tr>
            <th>Eilutė</th>
            {metai.map((y: string) => <th class="cell-right">{y}</th>)}
          </tr>
        </thead>
        <tbody>
          {Object.entries(duomenys).map(([lineName, values]: [string, any]) => (
            <tr>
              <td>{lineName}</td>
              {(values as any[]).map((value: any) => (
                <td class="cell-mono cell-right">
                  {value == null
                    ? <span class="text-muted">—</span>
                    : lineName === 'Pelningumas'
                      ? `${value.toFixed(2)}%`
                      : value.toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' })
                  }
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </Table>
    </TableWrapper>
  )}

  {ataskaitos.length > finansaiLimit && (
    <p class="text-muted text-sm mb-4">
      Rodoma tik paskutinė finansinė ataskaita.
      <a href="?finansaiLimit=max#finansai">Rodyti visas ({ataskaitos.length})</a>
    </p>
  )}

  {ataskaitos.slice(0, finansaiLimit).map((laikotarpis: any) => (
    <div class="subsection">
      <h3>
        {laikotarpis.templateName}
        <span class="text-muted text-xs font-normal">({laikotarpis.templateId}, {laikotarpis.duomenuData})</span>
      </h3>
      <p class="text-muted text-sm mb-4">{laikotarpis.laikotarpisNuo} – {laikotarpis.laikotarpisIki}</p>
      <div class="grid-auto items-start">
        {laikotarpis.standards.map((std: any) => (
          <div class="card">
            <div class="card-body">
              <div class="section-title mb-3">{std.standardName} <span class="text-muted font-normal">({std.standardId})</span></div>
              <dl class="kv-list">
                {std.lines.map((line: any) => (
                  <>
                    <dt>{line.lineName} <span class="text-muted text-xs">({line.lineTypeId})</span></dt>
                    <dd><span class="cell-mono">{new Intl.NumberFormat('lt-LT', { style: 'currency', currency: 'EUR' }).format(line.reiksme)}</span></dd>
                  </>
                ))}
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>
