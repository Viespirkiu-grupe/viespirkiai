---
import KeyValueList from '@design-system/components/KeyValueList.astro';
import Badge from '@design-system/components/Badge.astro';
import { rodomasStatusas } from '../../lib/jarStatusas.ts';

interface Props {
  asmuo: any;
}

const { asmuo } = Astro.props;
const jadis = asmuo.jadis ?? {};
const dalyviai = jadis.dalyviuSkaiciai ?? {};
const hasJadis = Object.values(dalyviai).some((v: any) => Number(v) > 0);
const valstybesDalyviai = jadis.valstybesDalyviai ?? [];
const jadisSarasas = jadis.sarasas;
const dalisProcentais = (dalis: any) =>
  dalis == null ? null : (Number(dalis) * 100).toLocaleString('lt-LT', { maximumFractionDigits: 4 });

// JADIS „nejuridinio asmens“ kodas 111105555 yra Lietuvos Respublika, visi kiti
// šio rinkinio dalyviai — savivaldybės.
const LIETUVOS_RESPUBLIKA = 111105555;
const turiValstybe = valstybesDalyviai.some((d: any) => Number(d.njaKodas) === LIETUVOS_RESPUBLIKA);
const turiSavivaldybe = valstybesDalyviai.some((d: any) => Number(d.njaKodas) !== LIETUVOS_RESPUBLIKA);
const valdymoZyma = !valstybesDalyviai.length
  ? null
  : turiValstybe && turiSavivaldybe
    ? 'Valstybės ir savivaldybių valdoma'
    : turiValstybe
      ? 'Valstybės valdoma'
      : 'Savivaldybės valdoma';
// Dalys gali nesudaryti 100 % — likusi dalis priklauso privatiems dalyviams.
const bendraDalis = valstybesDalyviai.every((d: any) => d.dalis != null)
  ? valstybesDalyviai.reduce((suma: number, d: any) => suma + Number(d.dalis), 0)
  : null;
const istatinis = asmuo.istatinisKapitalas;
const isr = asmuo.isregistruotasAsmuo;

const neaktyvusStatusas = rodomasStatusas(asmuo.jar.statusoPavadinimas);

const BANKROTO_STATUSAI = new Set(['Bankrutuojantis', 'Bankrutavęs', 'Likviduojamas dėl bankroto', 'Likviduojamas']);
const statusoVariantas = neaktyvusStatusas && BANKROTO_STATUSAI.has(neaktyvusStatusas) ? 'danger' : 'warning';
---

<KeyValueList>
  <dt>JAR kodas</dt>
  <dd>
    <span class="cell-mono">{asmuo.jar.jarKodas}</span> · {asmuo.jar.formosPavadinimas}
    {isr && <Badge variant="danger" className="ml-1">Išregistruotas</Badge>}
    {neaktyvusStatusas && <Badge variant={statusoVariantas} className="ml-1">{neaktyvusStatusas}</Badge>}
    {valdymoZyma && <Badge variant="info" className="ml-1">{valdymoZyma}</Badge>}
  </dd>

  {asmuo.sodra?.kodas && <>
    <dt>SODRA kodas</dt>
    <dd><span class="cell-mono">{asmuo.sodra.kodas}</span></dd>
  </>}

  {asmuo.sodra?.ekonominesVeiklosPavadinimas && <>
    <dt>Veikla</dt>
    <dd>{asmuo.sodra.ekonominesVeiklosPavadinimas} (<span class="cell-mono">{asmuo.sodra.ekonominesVeiklosKodas}</span>)</dd>
  </>}

  <dt>Įregistruota</dt>
  <dd>{asmuo.jar.registravimoData}</dd>

  <dt>Adresas</dt>
  <dd>
    {asmuo.jar.location
      ? <a href={`https://www.openstreetmap.org/?mlat=${asmuo.jar.location[0]}&mlon=${asmuo.jar.location[1]}&zoom=16`} target="_blank" rel="noopener noreferrer">{asmuo.jar.adresas}</a>
      : asmuo.jar.adresas
        ? asmuo.jar.adresas
        : <em class="text-muted">Nenurodytas</em>
    }
  </dd>

  {neaktyvusStatusas && <>
    <dt>Statusas</dt>
    <dd>
      <Badge variant={statusoVariantas}>{neaktyvusStatusas}</Badge>
      {asmuo.jar.statusasNuo && <span class="text-muted text-xs ml-1">nuo {asmuo.jar.statusasNuo}</span>}
    </dd>
  </>}

  {isr?.isregistravimoData && <>
    <dt>Išregistruota</dt>
    <dd>{isr.isregistravimoData}</dd>
  </>}

  {istatinis?.reiksme && <>
    <dt>Įstatinis kapitalas</dt>
    <dd>
      <span class="cell-mono">{istatinis.reiksme.toLocaleString('lt-LT', { style: 'currency', currency: istatinis.valiuta })}</span>
      <span class="text-muted text-xs">({istatinis.data})</span>
    </dd>
  </>}

  {hasJadis && <>
    <dt>Dalyviai</dt>
    <dd>
      <div class="flex flex-col gap-1">
        {dalyviai.lrFiziniai > 0 && <span>{dalyviai.lrFiziniai} asmuo(-enys) — fiziniai (LT)</span>}
        {dalyviai.lrJuridiniai > 0 && <span>{dalyviai.lrJuridiniai} asmuo(-enys) — juridiniai (LT)</span>}
        {dalyviai.uzsienioFiziniai > 0 && <span>{dalyviai.uzsienioFiziniai} asmuo(-enys) — fiziniai (užsienis)</span>}
        {dalyviai.uzsienioJuridiniai > 0 && <span>{dalyviai.uzsienioJuridiniai} asmuo(-enys) — juridiniai (užsienis)</span>}
      </div>
    </dd>
  </>}

  {valstybesDalyviai.length > 0 && <>
    <dt>Valstybės / savivaldybių dalyvavimas</dt>
    <dd>
      <div class="flex flex-col gap-1">
        {valstybesDalyviai.map((dalyvis: any) => (
          <span>
            {dalyvis.administracijosJarKodas
              ? <a href={`/asmuo/${dalyvis.administracijosJarKodas}`}>{dalyvis.njaPavadinimas}</a>
              : dalyvis.njaPavadinimas}
            {dalyvis.dalis != null && <span class="ml-1">– {dalisProcentais(dalyvis.dalis)} %</span>}
          </span>
        ))}
        {bendraDalis != null && valstybesDalyviai.length > 1 && (
          <span class="text-muted text-xs">Iš viso {dalisProcentais(bendraDalis)} %</span>
        )}
      </div>
    </dd>
  </>}

  {jadisSarasas?.sarasasPateiktas && jadisSarasas.sarasoData && <>
    <dt>JADIS data</dt>
    <dd>{jadisSarasas.sarasoData}</dd>
  </>}

  {jadisSarasas && !jadisSarasas.sarasasPateiktas && <>
    <dt>JADIS dalyvių sąrašas</dt>
    <dd><Badge variant="warning">Nepateiktas</Badge></dd>
  </>}
</KeyValueList>
