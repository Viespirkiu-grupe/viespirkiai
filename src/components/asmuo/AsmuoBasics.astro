---
import KeyValueList from '@design-system/components/KeyValueList.astro';
import Badge from '@design-system/components/Badge.astro';

interface Props {
  asmuo: any;
}

const { asmuo } = Astro.props;
const jadis = asmuo.jadis ?? {};
const hasJadis = Object.values(jadis).some((v: any) => Number(v) > 0);
const istatinis = asmuo.istatinisKapitalas;
const isr = asmuo.isregistruotasAsmuo;

const AKTYVUS_STATUSAS = 'Teisinis stat neįregistruotas';
const statusas = asmuo.jar.statusoPavadinimas;
const neaktyvusStatusas = statusas && statusas !== AKTYVUS_STATUSAS ? statusas : null;

const BANKROTO_STATUSAI = new Set(['Bankrutuojantis', 'Bankrutavęs', 'Likviduojamas dėl bankroto', 'Likviduojamas']);
const statusoVariantas = neaktyvusStatusas && BANKROTO_STATUSAI.has(neaktyvusStatusas) ? 'danger' : 'warning';
---

<KeyValueList>
  <dt>JAR kodas</dt>
  <dd>
    <span class="cell-mono">{asmuo.jar.jarKodas}</span> · {asmuo.jar.formosPavadinimas}
    {isr && <Badge variant="danger" className="ml-1">Išregistruotas</Badge>}
    {neaktyvusStatusas && <Badge variant={statusoVariantas} className="ml-1">{neaktyvusStatusas}</Badge>}
  </dd>

  {asmuo.sodra?.kodas && <>
    <dt>SODRA kodas</dt>
    <dd><span class="cell-mono">{asmuo.sodra.kodas}</span></dd>
  </>}

  {asmuo.sodra?.ekonominesVeiklosPavadinimas && <>
    <dt>Veikla</dt>
    <dd>{asmuo.sodra.ekonominesVeiklosPavadinimas} (<span class="cell-mono">{asmuo.sodra.ekonominesVeiklosKodas}</span>)</dd>
  </>}

  <dt>Įregistruota</dt>
  <dd>{asmuo.jar.registravimoData}</dd>

  <dt>Adresas</dt>
  <dd>
    {asmuo.jar.location
      ? <a href={`https://www.openstreetmap.org/?mlat=${asmuo.jar.location[0]}&mlon=${asmuo.jar.location[1]}&zoom=16`} target="_blank">{asmuo.jar.adresas}</a>
      : asmuo.jar.adresas
        ? asmuo.jar.adresas
        : <em class="text-muted">Nenurodytas</em>
    }
  </dd>

  {neaktyvusStatusas && <>
    <dt>Statusas</dt>
    <dd>
      <Badge variant={statusoVariantas}>{neaktyvusStatusas}</Badge>
      {asmuo.jar.statusasNuo && <span class="text-muted text-xs ml-1">nuo {asmuo.jar.statusasNuo}</span>}
    </dd>
  </>}

  {isr?.isregistravimoData && <>
    <dt>Išregistruota</dt>
    <dd>{isr.isregistravimoData}</dd>
  </>}

  {istatinis?.reiksme && <>
    <dt>Įstatinis kapitalas</dt>
    <dd>
      <span class="cell-mono">{istatinis.reiksme.toLocaleString('lt-LT', { style: 'currency', currency: istatinis.valiuta })}</span>
      <span class="text-muted text-xs">({istatinis.data})</span>
    </dd>
  </>}

  {hasJadis && <>
    <dt>Dalyviai</dt>
    <dd>
      <div class="flex flex-col gap-1">
        {jadis.lrFiziniai > 0 && <span>{jadis.lrFiziniai} asmuo(-enys) — fiziniai (LT)</span>}
        {jadis.lrJuridiniai > 0 && <span>{jadis.lrJuridiniai} asmuo(-enys) — juridiniai (LT)</span>}
        {jadis.uzsienioFiziniai > 0 && <span>{jadis.uzsienioFiziniai} asmuo(-enys) — fiziniai (užsienis)</span>}
        {jadis.uzsienioJuridiniai > 0 && <span>{jadis.uzsienioJuridiniai} asmuo(-enys) — juridiniai (užsienis)</span>}
      </div>
    </dd>
  </>}
</KeyValueList>
