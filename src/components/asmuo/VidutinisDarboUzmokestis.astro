---
import ChartSection from '@design-system/components/charts/ChartSection.astro';
import ChartTile from '@design-system/components/charts/ChartTile.astro';
import LineDatetimeChart from '@design-system/components/charts/LineDatetimeChart.astro';

const { asmuo } = Astro.props;
const duomenys = asmuo.sodra?.duomenys ?? [];
const labels = duomenys.map((d: any) => d.data + '-01');
const series1 = duomenys.map((d: any) => d.vidutinisAtlyginimas || null);
const series2 = duomenys.map((d: any) => d.vidutinisAtlyginimas2 || null);
---

<ChartSection id="uzmokestis" title="Vidutinis darbo užmokestis" description="Neatskaičius mokesčių, €/mėn.">
    <ChartTile title="Darbo sutartys, valstybės tarnautojai" hasData={duomenys.length > 0 && asmuo.sodra?.turejoAtlyginimu} minHeightClass="min-h-87.5">
      <LineDatetimeChart
        id="vidAtlyginimoDiagrama"
        title="Darbo sutartys, valstybės tarnautojai"
        anchor="uzmokestis-darbo-sutartys"
        labels={labels}
        series={series1}
        flags={['yEURMen', 'yMin0']}
        wrapperClass=""
        titleClass="sr-only"
        heightClass="h-75"
      />
    </ChartTile>
    <ChartTile title="Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos" hasData={duomenys.length > 0 && asmuo.sodra?.turejoAtlyginimu2} minHeightClass="min-h-87.5">
      <LineDatetimeChart
        id="vidAtlyginimoIIDiagrama"
        title="Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos"
        anchor="uzmokestis-autorines"
        labels={labels}
        series={series2}
        flags={['yEURMen', 'yMin0']}
        wrapperClass=""
        titleClass="sr-only"
        heightClass="h-75"
      />
    </ChartTile>
</ChartSection>
