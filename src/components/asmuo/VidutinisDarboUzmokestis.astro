---
const { asmuo } = Astro.props;
const duomenys = asmuo.sodra?.duomenys ?? [];
const labels = JSON.stringify(duomenys.map((d: any) => d.data + '-01'));
const series1 = JSON.stringify(duomenys.map((d: any) => d.vidutinisAtlyginimas || null));
const series2 = JSON.stringify(duomenys.map((d: any) => d.vidutinisAtlyginimas2 || null));
---

<div class="page-section mb-10" id="uzmokestis">
  <h2><a href="#uzmokestis" class="no-style">Vidutinis darbo užmokestis</a></h2>
  <p class="text-muted text-sm mb-7">Neatskaičius mokesčių, €/mėn.</p>
  <div class="grid-2">
    <div class="flex flex-col min-h-87.5">
      <h3 class="text-sm font-bold mb-3">Darbo sutartys, valstybės tarnautojai</h3>
      {duomenys.length > 0 && asmuo.sodra?.turejoAtlyginimu ? (
        <div class="chart-frame">
          <div id="vidAtlyginimoDiagrama" class="chart h-75"></div>
          <script defer is:inline define:vars={{ labels1: JSON.parse(labels), s1: JSON.parse(series1) }}>
            displayChart({ element: document.querySelector('#vidAtlyginimoDiagrama'), type: 'line-datetime', labels: labels1, series: s1, flags: ['yEURMen', 'yMin0'] });
          </script>
        </div>
      ) : <div class="chart-empty">Nėra duomenų</div>}
    </div>
    <div class="flex flex-col min-h-87.5">
      <h3 class="text-sm font-bold mb-3">Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos</h3>
      {duomenys.length > 0 && asmuo.sodra?.turejoAtlyginimu2 ? (
        <div class="chart-frame">
          <div id="vidAtlyginimoIIDiagrama" class="chart h-75"></div>
          <script defer is:inline define:vars={{ labels2: JSON.parse(labels), s2: JSON.parse(series2) }}>
            displayChart({ element: document.querySelector('#vidAtlyginimoIIDiagrama'), type: 'line-datetime', labels: labels2, series: s2, flags: ['yEURMen', 'yMin0'] });
          </script>
        </div>
      ) : <div class="chart-empty">Nėra duomenų</div>}
    </div>
  </div>
</div>
