---
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultSection from '@design-system/components/ResultSection.astro';

const { asmuo } = Astro.props;
if (!(asmuo.domenai?.count > 0)) return;
const { count, rows } = asmuo.domenai;
---

<ResultSection
  id="domenai"
  title=".lt domenai"
  count={count}
  shown={rows.length}
  paramName="domenaiLimit"
  forms={['domenas', 'domenai', 'domenų', 'domeno']}
>
  <p slot="intro" class="text-muted text-sm mb-4">Pagal savininko pavadinimo panašumą.</p>
  {rows.map((d: any) => (
    <ResultCardShell clickable={true}>
      <dl slot="meta" class="result-card-meta">
        <div><dt class="sr-only">Registruota</dt><dd>{String(d.created).split(' ')[0]} – {String(d.expired).split(' ')[0]}</dd></div>
        <div><dt class="sr-only">Duomenų data</dt><dd>Duomenys {String(d.domregData).split(' ')[0]}</dd></div>
      </dl>
      <h3 slot="title" class="result-card-title">
        <a href={`https://www.domreg.lt/paslaugos/whois/?search=${d.domain}`}>{d.domain}</a>
      </h3>
      <div slot="footer" class="result-card-footer"><span><strong>Savininkas:</strong> {d.savininkas}</span></div>
    </ResultCardShell>
  ))}
</ResultSection>
