---
const { asmuo } = Astro.props;
if (!(asmuo.domenai?.count > 0)) return;
const { count, limit, rows } = asmuo.domenai;
---

<div class="page-section mb-10" id="domenai">
  <h2><a href="#domenai" class="no-style">.lt domenai</a></h2>
  <p class="text-muted text-sm mb-4">Pagal savininko pavadinimo panašumą.</p>
  {count > rows.length && (
    <p class="text-muted text-sm mb-4">
      Rodomi tik {limit} domenai.
      <a href="?domenaiLimit=max#domenai">Rodyti visus ({count})</a>
    </p>
  )}
  <div class="result-list">
    {rows.map((d: any) => (
      <article class="result-card card-clickable">
        <div class="result-card-body">
          <dl class="result-card-meta">
            <div><dt class="sr-only">Registruota</dt><dd>{String(d.created).split(' ')[0]} – {String(d.expired).split(' ')[0]}</dd></div>
            <div><dt class="sr-only">Duomenų data</dt><dd>Duomenys {String(d.domregData).split(' ')[0]}</dd></div>
          </dl>
          <h3 class="result-card-title">
            <a href={`https://www.domreg.lt/paslaugos/whois/?search=${d.domain}`}>{d.domain}</a>
          </h3>
          <div class="result-card-footer"><span><strong>Savininkas:</strong> {d.savininkas}</span></div>
        </div>
      </article>
    ))}
  </div>
</div>
