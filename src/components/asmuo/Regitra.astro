---
import PageSection from '@design-system/components/PageSection.astro';
import DataTable from '@design-system/components/DataTable.astro';
import ExternalSourceLink from '@design-system/components/ExternalSourceLink.astro';
import TruncationNotice from '@design-system/components/TruncationNotice.astro';

const { asmuo } = Astro.props;
if (!(asmuo.regitra?.rows > 0)) return;
const { rows, transportoPriemones } = asmuo.regitra;
---

<PageSection id="transportoPriemones" title="Transporto priemonės">
  <TruncationNotice count={rows} shown={transportoPriemones.length} anchor="transportoPriemones" paramName="transportoPriemonesLimit" label="transporto priemonės" gender="f" />
  <DataTable
    columns={[
      { label: 'Markė' },
      { label: 'Pavadinimas' },
      { label: 'Kategorija', headerClassName: 'cell-center' },
      { label: 'Degalai', headerClassName: 'cell-center' },
      { label: 'Galia (kW)', headerClassName: 'cell-center' },
      { label: 'Vietos', headerClassName: 'cell-center' },
      { label: 'Pirm. registracija', headerClassName: 'cell-center' },
      { label: 'Savininkas', headerClassName: 'cell-center' },
    ]}
  >
    {transportoPriemones.map((auto: any) => (
      <tr>
        <td>{auto.marke}</td>
        <td>
          {auto.komercinisPavadinimas === 'Nuasmeninta'
            ? <span class="text-muted">{auto.komercinisPavadinimas}</span>
            : <ExternalSourceLink href={`https://duckduckgo.com/?t=h_&q=${encodeURIComponent(auto.marke)}+${encodeURIComponent(auto.komercinisPavadinimas)}&ia=images&iax=images`} label={auto.komercinisPavadinimas} icon={false} />
          }
        </td>
        <td class="cell-center cell-mono">{auto.kategorijaKlase}</td>
        <td class="cell-center">{auto.degalai || '—'}</td>
        <td class="cell-center cell-mono">{auto.galia || '—'}</td>
        <td class="cell-center cell-mono">{(Number(auto.sedimuVietuSkaicius) + Number(auto.stovimuVietuSkaicius)) || '—'}</td>
        <td class="cell-center cell-mono">{auto.pirmosiosRegistracijosData || '—'}</td>
        <td class="cell-center">{auto.valdymoTeise === 'A' ? 'Taip' : 'Ne'}</td>
      </tr>
    ))}
  </DataTable>
</PageSection>
