---
const { asmuo } = Astro.props;
if (!(asmuo.regitra?.rows > 0)) return;
const { rows, limit, transportoPriemones } = asmuo.regitra;
---

<div class="page-section mb-10" id="transportoPriemones">
  <h2><a href="#transportoPriemones" class="no-style">Transporto priemonės</a></h2>
  {rows > limit && (
    <p class="text-muted text-sm mb-4">
      Rodomos tik {limit} transporto priemonės.
      <a href="?transportoPriemonesLimit=max#transportoPriemones">Rodyti visas ({rows})</a>
    </p>
  )}
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>Markė</th><th>Pavadinimas</th><th class="cell-center">Kategorija</th>
          <th class="cell-center">Degalai</th><th class="cell-center">Galia (kW)</th>
          <th class="cell-center">Vietos</th><th class="cell-center">Pirm. registracija</th>
          <th class="cell-center">Savininkas</th>
        </tr>
      </thead>
      <tbody>
        {transportoPriemones.map((auto: any) => (
          <tr>
            <td>{auto.marke}</td>
            <td>
              {auto.komercinisPavadinimas === 'Nuasmeninta'
                ? <span class="text-muted">{auto.komercinisPavadinimas}</span>
                : <a href={`https://duckduckgo.com/?t=h_&q=${encodeURIComponent(auto.marke)}+${encodeURIComponent(auto.komercinisPavadinimas)}&ia=images&iax=images`} target="_blank" rel="noopener noreferrer">{auto.komercinisPavadinimas}</a>
              }
            </td>
            <td class="cell-center cell-mono">{auto.kategorijaKlase}</td>
            <td class="cell-center">{auto.degalai || '—'}</td>
            <td class="cell-center cell-mono">{auto.galia || '—'}</td>
            <td class="cell-center cell-mono">{(Number(auto.sedimuVietuSkaicius) + Number(auto.stovimuVietuSkaicius)) || '—'}</td>
            <td class="cell-center cell-mono">{auto.pirmosiosRegistracijosData || '—'}</td>
            <td class="cell-center">{auto.valdymoTeise === 'A' ? 'Taip' : 'Ne'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
