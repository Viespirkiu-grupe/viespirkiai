---
import LeafletLoader from '@design-system/components/LeafletLoader.astro';

interface Props {
  location: [number, number] | null | undefined;
}

const { location } = Astro.props;
---

{location && (
  <>
    <div
      id="asmuo-map"
      class="map-container h-full min-h-70 col-[span_2]"
      data-x={location[1]}
      data-y={location[0]}
    />

    <LeafletLoader />

    <script is:inline>
      (function () {
        function init() {
          const el = document.getElementById('asmuo-map');
          if (!el || el.dataset.leafletInited === '1') return;
          el.dataset.leafletInited = '1';
          const lat = Number(el.dataset.y), lon = Number(el.dataset.x);
          if (!isFinite(lat) || !isFinite(lon)) return;
          const map = L.map('asmuo-map', { zoomAnimation: true, markerZoomAnimation: true }).setView([lat, lon], 16);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          }).addTo(map);
          L.marker([lat, lon]).addTo(map);
        }
        function start() {
          if (typeof window.__vpLeafletLoad === 'function') {
            window.__vpLeafletLoad().then(() => { if (window.L && window.L.map) init(); }).catch(() => {});
          } else if (window.L && window.L.map) {
            init();
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      })();
    </script>
  </>
)}
