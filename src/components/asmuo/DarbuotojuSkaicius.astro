---
import ChartSection from '@design-system/components/charts/ChartSection.astro';
import ChartTile from '@design-system/components/charts/ChartTile.astro';
import LineDatetimeChart from '@design-system/components/charts/LineDatetimeChart.astro';

const { asmuo } = Astro.props;
const duomenys = asmuo.sodra?.duomenys ?? [];
const labels = duomenys.map((d: any) => d.data + '-01');
const series1 = duomenys.map((d: any) => d.draustieji || null);
const series2 = duomenys.map((d: any) => d.draustieji2 || null);
---

<ChartSection id="darbuotojai" title="Darbuotojų skaičius">
    <ChartTile title="Darbo sutartys, valstybės tarnautojai" hasData={duomenys.length > 0 && asmuo.sodra?.turejoDraustuju}>
      <LineDatetimeChart
        id="darbuotojuSkaiciausDiagrama"
        title="Darbo sutartys, valstybės tarnautojai"
        anchor="darbuotojai-darbo-sutartys"
        labels={labels}
        series={series1}
        flags={['yMin0']}
        wrapperClass=""
        titleClass="sr-only"
        heightClass="h-[350px]"
      />
    </ChartTile>
    <ChartTile title="Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos" hasData={duomenys.length > 0 && asmuo.sodra?.turejoDraustuju2}>
      <LineDatetimeChart
        id="darbuotojuSkaiciausIIDiagrama"
        title="Autorinės, sporto ir atlikėjo veiklos sutartys, tantjemos"
        anchor="darbuotojai-autorines"
        labels={labels}
        series={series2}
        flags={['yMin0']}
        wrapperClass=""
        titleClass="sr-only"
        heightClass="h-[350px]"
      />
    </ChartTile>
</ChartSection>
