---
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultSection from '@design-system/components/ResultSection.astro';

const { asmuo } = Astro.props;
if (!(asmuo.vdiPazeidimai?.count > 0)) return;
const { count, rows } = asmuo.vdiPazeidimai;

const aggregated = Object.values(
  rows.reduce((acc: any, p: any) => {
    const key = p.straipsnis + (p.dalis ? `-${p.dalis}` : '');
    if (acc[key]) acc[key].kiekis++;
    else acc[key] = { ...p, kiekis: 1 };
    return acc;
  }, {})
) as any[];
---

<ResultSection
  id="vdiPazeidimai"
  title="Darbo teisės pažeidimai"
  count={count}
  shown={rows.length}
  paramName="vdiPazeidimaiLimit"
  label="pažeidimai"
>
  {aggregated.map((p: any) => (
    <ResultCardShell>
      <dl slot="meta" class="result-card-meta">
        <div><dt class="sr-only">Teisės aktas</dt><dd>{p.teisesAktas}</dd></div>
        <div><dt class="sr-only">Straipsnis</dt><dd>{p.straipsnis} str.{p.dalis && ` ${p.dalis} d.`}</dd></div>
        {p.pirmaKarta && <div><dd>Pirmą kartą</dd></div>}
      </dl>
      <h3 slot="title" class="result-card-title">
        {p.kiekis > 1 && <span class="font-bold mr-1">{p.kiekis}&times;</span>}
        {p.pavadinimas}
      </h3>
    </ResultCardShell>
  ))}
</ResultSection>
