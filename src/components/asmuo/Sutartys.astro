---
import ExportLinks from '@design-system/components/ExportLinks.astro';
import PageSection from '@design-system/components/PageSection.astro';
import SectionGrid from '@design-system/components/SectionGrid.astro';
import SectionToolbar from '@design-system/components/SectionToolbar.astro';
import ChartTile from '@design-system/components/charts/ChartTile.astro';
import LineDatetimeChart from '@design-system/components/charts/LineDatetimeChart.astro';
import Table from '@design-system/components/Table.astro';
import TableWrapper from '@design-system/components/TableWrapper.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';
const { asmuo } = Astro.props;
const pirkimai = asmuo.sutartys?.pirkimaiKasMetus ?? [];
const tiekimai = asmuo.sutartys?.tiekimaiKasMetus ?? [];
const topTiekejai = asmuo.sutartys?.topTiekejai ?? [];
const topPirkejai = asmuo.sutartys?.topPirkejai ?? [];
const pirkimaiLabels = pirkimai.map((d: any) => String(d.year));
const pirkimaiSeries = pirkimai.map((d: any) => d.total || null);
const tiekimaiLabels = tiekimai.map((d: any) => String(d.year));
const tiekimaiSeries = tiekimai.map((d: any) => d.total || null);
const topTiekejaiExport = [
  { href: `/asmuo/${asmuo.jar.jarKodas}/sutartys/topTiekejai.csv`, label: 'CSV' },
  { href: `/asmuo/${asmuo.jar.jarKodas}/sutartys/topTiekejai.jsonl`, label: 'JSONL' },
];
const topPirkejaiExport = [
  { href: `/asmuo/${asmuo.jar.jarKodas}/sutartys/topPirkejai.csv`, label: 'CSV' },
  { href: `/asmuo/${asmuo.jar.jarKodas}/sutartys/topPirkejai.jsonl`, label: 'JSONL' },
];
---

<PageSection id="sutartys" title="Viešųjų pirkimų sutartys">
  <SectionGrid columns={2} className="mb-10">
    <ChartTile title="Numatytos pirkimų vertės pagal metus" hasData={pirkimai.length > 0}>
      <LineDatetimeChart
        id="pirkimaiPerMetus"
        title="Numatytos pirkimų vertės pagal metus"
        anchor="pirkimaiPerMetusAnchor"
        labels={pirkimaiLabels}
        series={pirkimaiSeries}
        flags={['yEUR', 'yMin0', 'xYear']}
        wrapperClass=""
        titleClass="sr-only"
        heightClass="h-[350px]"
      />
    </ChartTile>
    <ChartTile title="Numatytos pardavimų vertės pagal metus" hasData={tiekimai.length > 0}>
      <LineDatetimeChart
        id="pardavimaiPerMetus"
        title="Numatytos pardavimų vertės pagal metus"
        anchor="pardavimaiPerMetusAnchor"
        labels={tiekimaiLabels}
        series={tiekimaiSeries}
        flags={['yEUR', 'yMin0', 'xYear']}
        wrapperClass=""
        titleClass="sr-only"
        heightClass="h-[350px]"
      />
    </ChartTile>
  </SectionGrid>

  <SectionGrid columns={2}>
    <div class="flex flex-col">
      <SectionToolbar title="TOP 10 tiekėjų">
        <Fragment slot="actions"><ExportLinks items={topTiekejaiExport} /></Fragment>
      </SectionToolbar>
      {topTiekejai.length > 0 ? (
        <TableWrapper className="flex-1">
          <Table>
            <thead><tr><th>#</th><th>Tiekėjas</th><th class="cell-right">Suma</th><th class="cell-right">Sut.</th></tr></thead>
            <tbody>
              {topTiekejai.map((t: any, i: number) => (
                <tr>
                  <td class="cell-mono text-muted">{i + 1}</td>
                  <td class="sutartys-col-party">
                    <a href={`/?perkanciosiosOrganizacijosKodas=${asmuo.jar.jarKodas}&tiekejoKodas=${t.jarKodas}`} class="cell-truncate">
                      {t.pavadinimas}
                    </a>
                  </td>
                  <td class="cell-right"><MoneyValue value={t.total} /></td>
                  <td class="cell-mono cell-right">{t.count.toLocaleString('lt-LT')}</td>
                </tr>
              ))}
            </tbody>
          </Table>
        </TableWrapper>
      ) : <div class="chart-empty flex-1">Nėra duomenų</div>}
    </div>

    <div class="flex flex-col">
      <SectionToolbar title="TOP 10 pirkėjų">
        <Fragment slot="actions"><ExportLinks items={topPirkejaiExport} /></Fragment>
      </SectionToolbar>
      {topPirkejai.length > 0 ? (
        <TableWrapper className="flex-1">
          <Table>
            <thead><tr><th>#</th><th>Pirkėjas</th><th class="cell-right">Suma</th><th class="cell-right">Sut.</th></tr></thead>
            <tbody>
              {topPirkejai.map((p: any, i: number) => (
                <tr>
                  <td class="cell-mono text-muted">{i + 1}</td>
                  <td class="sutartys-col-party">
                    <a href={`/?perkanciosiosOrganizacijosKodas=${p.jarKodas}&tiekejoKodas=${asmuo.jar.jarKodas}`} class="cell-truncate">
                      {p.pavadinimas}
                    </a>
                  </td>
                  <td class="cell-right"><MoneyValue value={p.total} /></td>
                  <td class="cell-mono cell-right">{p.count.toLocaleString('lt-LT')}</td>
                </tr>
              ))}
            </tbody>
          </Table>
        </TableWrapper>
      ) : <div class="chart-empty flex-1">Nėra duomenų</div>}
    </div>
  </SectionGrid>
</PageSection>

<style>
  .sutartys-col-party {
    max-width: 34ch;
  }
</style>
