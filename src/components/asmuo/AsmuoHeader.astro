---
import Button from '@design-system/components/Button.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import config from '../../lib/config.ts';

interface Props {
  asmuo: any;
}

const { asmuo } = Astro.props;
const jarKodas = asmuo.jar.jarKodas;
---

<PageHeader>
  {asmuo.jar.pavadinimas}
  <Fragment slot="actions">
    <Button href={`/asmuo/${jarKodas}.json`} variant="outline" size="sm">↗ JSON</Button>
    {config.enableGraph && (
      <Button href={`/rysiai/asmuo/${jarKodas}`} variant="outline" size="sm">↗ Ryšiai</Button>
    )}
    {asmuo.sodra?.kodas && (
      <Button href={`https://atvira.sodra.lt/imones/detaliai/index.html?code=${asmuo.sodra.kodas}`} variant="outline" size="sm">↗ SODRA</Button>
    )}
    <Button href={`https://liteko.teismai.lt/viesasprendimupaieska/paieska.aspx?txt=${jarKodas}`} variant="outline" size="sm">↗ Bylos</Button>
    <Button href={`/pirkejas/${jarKodas}`} variant="outline" size="sm">↗ Pirkimai</Button>
    <Button href={`/tiekejas/${jarKodas}`} variant="outline" size="sm">↗ Pardavimai</Button>
  </Fragment>
</PageHeader>
