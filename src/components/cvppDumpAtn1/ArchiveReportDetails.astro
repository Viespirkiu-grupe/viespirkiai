---
import DataTable from '@design-system/components/DataTable.astro';
import DetailsSection from '@design-system/components/DetailsSection.astro';
import KeyValueList from '@design-system/components/KeyValueList.astro';
import Surface from '@design-system/components/Surface.astro';
import type { CvppArchiveReport } from '../../lib/cvppDumpAtn1.js';
import { cvppReportTypeLabel } from '../../lib/cvppDumpAtn1Labels.js';

const { report } = Astro.props as { report: CvppArchiveReport };
const content = report.turinys ?? {};

const labels: Record<string, string> = {
