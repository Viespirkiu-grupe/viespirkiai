  igaliojimasKitaiPO: 'Įgaliojimas kitai organizacijai',
  igaliojimasKitaiSuteikiancioji: 'Įgaliojimas kitai suteikiančiajai institucijai',
  preliminariSutartis: 'Preliminarioji sutartis',
  dinamineSistema: 'Dinaminė pirkimo sistema',
  elektroninisPirkimas: 'Elektroninis pirkimas',
