---
import SiteHeaderShell from '@design-system/components/SiteHeaderShell.astro';
import config from '../lib/config.ts';
import { getInfoBanner } from '../lib/infoBanner.ts';
import logoSvg from '../assets/branding/viespirkiaiLogo.svg?raw';

interface Props {
  pathname: string;
  colorScheme: string;
}

const { pathname, colorScheme } = Astro.props;

import type { NavMenuItem } from '@design-system/components/NavigationMenu.astro';

// Pagrindiniai 3 skyriai (kairėje) su dropdown'ais, „Apie" – dešinėje.
const primaryMenu: NavMenuItem[] = [
  {
    label: 'Viešieji pirkimai',
    href: '/',
    children: [
      {
        href: '/', label: 'Sutartys', desc: 'Viešojo sektoriaus sudarytos sutartys',
        children: [
          { href: '/sutartys/redagavimai', label: 'Sutarčių redagavimai', desc: 'Sutarčių įrašų pakeitimai' },
        ],
      },
      { href: '/viesiejiPirkimai', label: 'Viešieji pirkimai',    desc: 'Naujos CVP IS viešieji pirkimai' },
      ...(config.enableAtn1
        ? [{ href: '/cvpp/ataskaitos', label: 'CVPP', desc: 'Duomenų iki 2024 gruodžio archyvas' }]
        : []),
      { href: '/planuojamiPirkimai', label: 'Planuojami pirkimai', desc: 'Perkančiųjų organizacijų pirkimų planai' },
      { href: '/neskelbiamos',     label: 'Neskelbiamos derybos', desc: 'Viešųjų pirkimų tarnybos sutikimai' },
      { href: '/nepatikimi',       label: 'Nepatikimi ir melagiai', desc: 'Juodieji sąrašai' },
      { href: '/bvpz',             label: 'BVPŽ kodai',           desc: 'Bendrasis viešųjų pirkimų žodynas' },
    ],
  },
  {
    label: 'Dokumentai',
    href: '/dokumentai',
    children: [
      { href: '/dokumentai?klase=viesiejiPirkimai', label: 'Viešųjų pirkimų dokumentai', desc: 'Sutartys, pirkimai, neskelbiamos derybos...' },
      { href: '/dokumentai?klase=teise',            label: 'Teismo nuosprendžiai',          desc: 'Senos LITEKO viešų teismo nuosprendžių paieška' },
      { href: '/teisesAktai',                       label: 'Teisės aktai',                  desc: 'e-TAR teisės aktai su suvestinėmis redakcijomis' },
      {
        href: '/failai', label: 'Failai', desc: 'Viešųjų pirkimų dokumentų archyvas',
        children: [
          { href: '/failai/galerija',      label: 'Galerija',       desc: 'Atsitiktinės nuotraukos iš viešųjų pirkimų dokumentų' },
          { href: '/failai/map',           label: 'Žemėlapis',      desc: 'Failų su GPS koordinatėmis žemėlapis' },
          { href: '/failai/topExtension',  label: 'Plėtiniai',      desc: 'Dažniausi failų tipai archyve' },
          { href: '/failai/neparsiunciami', label: 'Neparsiunčiami', desc: 'Failai, kurių nepavyko parsiųsti' },
          { href: '/failai/ocr',           label: 'OCR būsena',     desc: 'OCR statistika ir dokumentų teksto atpažinimo būsena' },
        ],
      },
    ],
  },
  { label: 'Juridiniai', href: '/juridiniai' },
];

const secondaryMenu: NavMenuItem[] = [
  {
    label: 'Apie',
    align: 'end',
    children: [
      { href: '/apie',      label: 'Apie',      desc: 'Apie projektą ir tikslus' },
      { href: '/kontaktai', label: 'Kontaktai', desc: 'Susisiekite su mumis' },
      { href: '/duomenys',  label: 'Duomenys',  desc: 'Duomenų šaltiniai ir atsisiuntimas' },
      { href: '/mcp',       label: 'MCP',       desc: 'Duomenų prieiga per MCP serverį' },
    ],
  },
  { label: 'Viešlaiškiai', href: '/vieslaiskiai' },
];

// Baneris valdomas per DB lentelę `infoBaneris` (enabled + aplinka), atnaujinamas per pg_notify.
const infoBanner = await getInfoBanner();
---

<SiteHeaderShell
  pathname={pathname}
  colorScheme={colorScheme}
  brandHref="/"
  brandLabel="Viešpirkiai"
  logoHtml={logoSvg}
  primaryMenu={primaryMenu}
  secondaryMenu={secondaryMenu}
  infoBanner={infoBanner}
  mirrorLogo={config.dev}
/>
