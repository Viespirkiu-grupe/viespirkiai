---
import TedFieldColumns from './TedFieldColumns.astro';
import TedSubgroup from './TedSubgroup.astro';
import { byParent, groupKind } from './tedFields';

const { group, idx = 0, shortUrl, parentNodeTitles, parentNodeAliases, subgroupTitles } = Astro.props;
const kind = groupKind(group);
const groupLabel = [kind, group.label || String(idx + 1)].filter(Boolean).join(' ');
const isLabeled = Boolean(group.label);

const fieldCols = byParent(group.fields, parentNodeTitles, parentNodeAliases);
const sgByType: any[] = [];
const sgTypeMap = new Map();
for (const sg of (group.subGroups || [])) {
  if (!sgTypeMap.has(sg.nodeId)) {
    const item = { nodeId: sg.nodeId, instances: [] };
    sgTypeMap.set(sg.nodeId, item);
    sgByType.push(item);
  }
  sgTypeMap.get(sg.nodeId).instances.push(sg);
}

// Vienos ar dviejų instancijų subgrupė telpa į tą pačią stulpelių eilę kaip ir
// grupės laukai; platesnės (daug instancijų) lieka atskiru bloku po jais.
const inlineSubgroups = sgByType.filter((sgType: any) => sgType.instances.length <= 2);
const wideSubgroups = sgByType.filter((sgType: any) => sgType.instances.length > 2);
const hasRow = group.fields.length > 0 || inlineSubgroups.length > 0;
---

<div>
  {isLabeled ? <h3>{groupLabel}</h3> : <p class="section-title">{groupLabel}</p>}

  {hasRow && (
    <div class="grid-auto">
      {group.fields.length > 0 && <TedFieldColumns columns={fieldCols} shortUrl={shortUrl} bare />}
      {inlineSubgroups.map((sgType: any) => (
        <div class="flex flex-col gap-2">
          <div>
            <h4>{subgroupTitles[sgType.nodeId] || sgType.nodeId}</h4>
            {sgType.instances.map((sg: any) => <TedSubgroup sg={sg} shortUrl={shortUrl} />)}
          </div>
        </div>
      ))}
    </div>
  )}

  {wideSubgroups.map((sgType: any) => (
    <>
      <h4>{subgroupTitles[sgType.nodeId] || sgType.nodeId}</h4>
      <div class={`grid-${Math.min(sgType.instances.length, 3)}`}>
        {sgType.instances.map((sg: any) => (
          <TedSubgroup sg={sg} shortUrl={shortUrl} />
        ))}
      </div>
    </>
  ))}
</div>
