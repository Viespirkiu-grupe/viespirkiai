---
import TedGroup from './TedGroup.astro';
import TedLotGroup from './TedLotGroup.astro';
import TedLotsGroupGroup from './TedLotsGroupGroup.astro';
import TedOrgGroup from './TedOrgGroup.astro';
import TedRestFields from './TedRestFields.astro';
import TedFieldColumns from './TedFieldColumns.astro';
import { byParent as byParentNode, formatTedDate } from './tedFields';

const {
  section,
  shortUrl,
  buyerOrgId,
  reviewBodyOrgIds,
  mediationBodyOrgIds,
  eSenderOrgIds,
  parentNodeTitles,
  parentNodeAliases,
  subgroupTitles,
  ltRegCode,
} = Astro.props;

const sectionId = section.nodeId.replace(/[^a-zA-Z0-9-]/g, '-').toLowerCase();

function f(id: string) {
  return (section.fields.find((x: any) => x.fieldId === id)?.values || []).join(', ');
}

function getOrgId(group: any) {
  return group.fields.find((field: any) => field.fieldId === 'OPT-200-Organization-Company')?.values?.[0] ?? null;
}

const SECTION_ROLE: Record<string, string> = {
  'ND-ContractingParty': 'Pirkėjas',
  'ND-ReviewBody': 'Peržiūros institucija',
  'ND-MediationBody': 'Tarpininkas',
  'ND-ReviewOrganization': 'Peržiūros organizacija',
};

function getRole(group: any) {
  const sectionRoleLabel = SECTION_ROLE[section.nodeId] || null;
  if (sectionRoleLabel) return sectionRoleLabel;

  const orgId = getOrgId(group);
  if (orgId && buyerOrgId && orgId === buyerOrgId) return 'Pirkėjas';
  if (orgId && reviewBodyOrgIds?.has?.(orgId)) return 'Peržiūros institucija';
  if (orgId && mediationBodyOrgIds?.has?.(orgId)) return 'Tarpininkavimo institucija';
  if (orgId && eSenderOrgIds?.has?.(orgId)) return 'TED siuntėjas';

  const hasCpFields = group.fields.some((field: any) =>
    field.fieldId.startsWith('BT-10-') || field.fieldId.startsWith('BT-11-') || field.fieldId === 'BT-508-Procedure-Buyer',
  );
  if (hasCpFields) return 'Pirkėjas';

  return null;
}

function sortOrder(group: any) {
  const role = getRole(group);
  if (role === 'Pirkėjas') return 0;
  if (role === 'TED siuntėjas') return 2;
  return 1;
}

const ORG_FIELD_PREFIXES = ['BT-500', 'BT-501', 'BT-502', 'BT-503', 'BT-505', 'BT-506', 'BT-507', 'BT-508', 'BT-510', 'BT-512', 'BT-513', 'BT-514', 'BT-610', 'BT-10-', 'BT-11-', 'BT-740'];
const orgGroups = section.groups
  .filter((group: any) => group.fields.some((field: any) => ORG_FIELD_PREFIXES.some((prefix) => field.fieldId.startsWith(prefix))))
  .sort((a: any, b: any) => sortOrder(a) - sortOrder(b));

const isProcedureSection = section.nodeId === 'ND-ProcedureTenderingProcess' || section.nodeId === 'ND-TenderingProcess';
const isTermsSection = section.nodeId === 'ND-ProcedureTerms' || section.nodeId === 'ND-TenderingTerms';
const isOrgSection = ['ND-RootExtension', 'ND-ContractingParty', 'ND-Organization', 'ND-ReviewBody', 'ND-MediationBody', 'ND-ReviewOrganization'].includes(section.nodeId);
const isMetaSection = section.nodeId === 'ND-Root';
const fieldCols = byParentNode(section.fields, parentNodeTitles, parentNodeAliases);

// ND-RootExtension sekcijoje šalia organizacijų gyvena ir sutartys, pasiūlymai bei
// dalyvių grupės – jų negalima tyliai numesti kartu su filtru.
const nonOrgGroups = isOrgSection
  ? section.groups.filter((group: any) => !orgGroups.includes(group))
  : [];

const restProps = {
  shortUrl,
  parentNodeTitles,
  parentNodeAliases,
};
---

{isProcedureSection ? (
  <>
    {(() => {
      const procType = f('BT-105-Procedure');
      const accelerated = f('BT-106-Procedure');
      const accelDesc = f('BT-1351-Procedure');
      const lotsConstr = f('BT-763-Procedure');
      const features = f('BT-88-Procedure');
      const cols = [
        features && { label: 'Procedūros ypatumai', text: features },
        accelerated.toLowerCase() === 'taip' && { label: 'Pagreitinta procedūra', text: accelDesc || 'Taip' },
        lotsConstr && { label: 'Dalių apribojimai', text: lotsConstr },
      ].filter(Boolean);
      return (
        <section id="procedura">
          <h2 class="mb-7">Procedūra</h2>
          {procType && <h3>{procType}</h3>}
          {cols.length > 0 && (
            <div class="grid-3">
              {cols.map((col) => (
                <div>
                  <p class="section-title">{col.label}</p>
                  <p class="text-sm">{col.text}</p>
                </div>
              ))}
            </div>
          )}
          <TedRestFields
            fields={section.fields}
            usedIds={['BT-105-Procedure', 'BT-106-Procedure', 'BT-1351-Procedure', 'BT-763-Procedure', 'BT-88-Procedure']}
            {...restProps}
          />
        </section>
      );
    })()}
  </>
) : isTermsSection ? (
  <>
    {(() => {
      const exclusion = f('BT-67(a)-Procedure');
      const exclusionDesc = f('BT-67(b)-Procedure');
      const exclusionSrc = f('BT-806-Procedure');
      const maxSubmit = f('BT-31-Procedure');
      const maxAwarded = f('BT-33-Procedure');
      const crossBorder = f('BT-09(a)-Procedure');
      const crossBorderDesc = f('BT-09(b)-Procedure');
      const hasContent = exclusion || exclusionDesc || maxSubmit || maxAwarded || crossBorder || crossBorderDesc;
      return section.fields.length > 0 ? (
        <section id="dalyvavimo-salygos">
          <h2 class="mb-7">Dalyvavimo sąlygos</h2>
          {hasContent && (
          <div class="grid-3">
            {(exclusion || exclusionDesc) && (
              <div>
                <p class="section-title">Pašalinimo pagrindai</p>
                {exclusion && <p>{exclusion}</p>}
                {exclusionDesc && <p class="text-sm text-muted">{exclusionDesc}</p>}
                {exclusionSrc && <p class="text-sm text-muted">Šaltinis: {exclusionSrc}</p>}
              </div>
            )}
            {(maxSubmit || maxAwarded) && (
              <div>
                <p class="section-title">Dalių paskirstymas</p>
                {maxSubmit && <><p class="section-title text-sm">Maks. pasiūlymų dalių</p><p><strong>{maxSubmit}</strong></p></>}
                {maxAwarded && <><p class="section-title text-sm">Maks. skiriamų dalių</p><p><strong>{maxAwarded}</strong></p></>}
              </div>
            )}
            {(crossBorder || crossBorderDesc) && (
              <div>
                <p class="section-title">Tarpvalstybinė teisė</p>
                <p>{crossBorderDesc || crossBorder}</p>
              </div>
            )}
          </div>
          )}
          <TedRestFields
            fields={section.fields}
            usedIds={['BT-67(a)-Procedure', 'BT-67(b)-Procedure', 'BT-806-Procedure', 'BT-31-Procedure', 'BT-33-Procedure', 'BT-09(a)-Procedure', 'BT-09(b)-Procedure']}
            divider={hasContent}
            {...restProps}
          />
        </section>
      ) : null;
    })()}
  </>
) : isOrgSection ? (
  (orgGroups.length > 0 || nonOrgGroups.length > 0 || section.fields.length > 0) && (
    <section id={sectionId}>
      <h2 class="mb-7">{section.title}</h2>
      {orgGroups.length > 0 && (
        <div class="grid-3">
          {orgGroups.map((group: any) => <TedOrgGroup group={group} roleLabel={getRole(group)} ltRegCode={ltRegCode} {...restProps} />)}
        </div>
      )}
      {nonOrgGroups.length > 0 && (
        <div class="flex flex-col gap-4 mt-7">
          {nonOrgGroups.map((group: any, idx: number) => (
            <TedGroup
              group={group}
              idx={idx}
              shortUrl={shortUrl}
              parentNodeTitles={parentNodeTitles}
              parentNodeAliases={parentNodeAliases}
              subgroupTitles={subgroupTitles}
            />
          ))}
        </div>
      )}
      <TedRestFields fields={section.fields} usedIds={[]} divider={false} {...restProps} />
    </section>
  )
) : isMetaSection ? (
  <>
    {(() => {
      const legalBasis = f('BT-01-notice');
      const noticeType = f('BT-02-notice');
      const sentTime = f('BT-05(b)-notice').replace(/[+-]\d{2}:\d{2}$/, '');
      const sentDate = [formatTedDate(f('BT-05(a)-notice')), sentTime].filter(Boolean).join(' ');
      const noticeId = f('BT-701-notice');
      const langs = f('BT-702(a)-notice');
      const version = f('BT-757-notice');
      const items = [
        sentDate && { label: 'Išsiųsta', value: sentDate },
        noticeType && { label: 'Rūšis', value: noticeType },
        legalBasis && { label: 'Pagrindas', value: legalBasis },
        langs && { label: 'Kalbos', value: langs },
        version && { label: 'Versija', value: version },
        noticeId && { label: 'ID', value: noticeId },
      ].filter(Boolean);
      return (
        <section id="skelbimo-informacija">
          <h2 class="mb-7">Skelbimo informacija</h2>
          <dl class="kv-list">
            {items.map((item) => <><dt>{item.label}</dt><dd>{item.value}</dd></>)}
          </dl>
          <TedRestFields
            fields={section.fields}
            usedIds={['BT-01-notice', 'BT-02-notice', 'BT-05(a)-notice', 'BT-05(b)-notice', 'BT-701-notice', 'BT-702(a)-notice', 'BT-757-notice']}
            {...restProps}
          />
        </section>
      );
    })()}
  </>
) : (
  <section id={sectionId}>
    <h2 class="mb-7">{section.title}</h2>
    {section.fields.length > 0 && <TedFieldColumns columns={fieldCols} shortUrl={shortUrl} heading="h3" />}
    <div class="flex flex-col gap-4">
      {section.groups.map((group: any, idx: number) => (
        (section.nodeId === 'ND-Lot' || section.nodeId === 'ND-Part')
          ? <TedLotGroup group={group} idx={idx} totalGroups={section.groups.length} shortUrl={shortUrl} subgroupTitles={subgroupTitles} formatDate={Astro.props.formatDate} parentNodeTitles={parentNodeTitles} parentNodeAliases={parentNodeAliases} />
          : section.nodeId === 'ND-LotsGroup'
            ? <TedLotsGroupGroup group={group} idx={idx} totalGroups={section.groups.length} shortUrl={shortUrl} subgroupTitles={subgroupTitles} parentNodeTitles={parentNodeTitles} parentNodeAliases={parentNodeAliases} />
            : <TedGroup group={group} idx={idx} shortUrl={shortUrl} parentNodeTitles={parentNodeTitles} parentNodeAliases={parentNodeAliases} subgroupTitles={subgroupTitles} />
      ))}
    </div>
  </section>
)}
