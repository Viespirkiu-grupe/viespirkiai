---
import KeyValueList from '@design-system/components/KeyValueList.astro';

const { fields = [], shortUrl } = Astro.props;
---

<KeyValueList>
  {fields.map((fv) => (
    <>
      <dt>{fv.name}</dt>
      <dd>
        {fv.type === 'url' ? (
          fv.values.map((v) => (
            <>
              <a href={v} target="_blank" rel="noopener">{shortUrl(v)}</a>{' '}
            </>
          ))
        ) : fv.type === 'email' ? (
          fv.values.map((v) => (
            <>
              <a href={`mailto:${v}`}>{v}</a>{' '}
            </>
          ))
        ) : (
          fv.values.map((v, i) => (
            <>
              {i > 0 && <br />}
              {v}
            </>
          ))
        )}
      </dd>
    </>
  ))}
</KeyValueList>
