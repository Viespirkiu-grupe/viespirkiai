---
import KeyValueList from '@design-system/components/KeyValueList.astro';
import { formatTedDate, isTechnical } from './tedFields';

interface FieldValue {
  fieldId: string;
  name: string;
  type: string;
  values: string[];
}

const { fields = [], shortUrl } = Astro.props;
const visible = (fields as FieldValue[]).filter((fv) => !isTechnical(fv));
---

<KeyValueList>
  {visible.map((fv: FieldValue) => (
    <>
      <dt>{fv.name}</dt>
      <dd>
        {fv.type === 'url' ? (
          fv.values.map((v: string) => (
            <>
              <a href={v} target="_blank" rel="noopener">{shortUrl(v)}</a>{' '}
            </>
          ))
        ) : fv.type === 'email' ? (
          fv.values.map((v: string) => (
            <>
              <a href={`mailto:${v}`}>{v}</a>{' '}
            </>
          ))
        ) : (
          fv.values.map((v: string, i: number) => (
            <>
              {i > 0 && <br />}
              {fv.type === 'date' ? formatTedDate(v) : v}
            </>
          ))
        )}
      </dd>
    </>
  ))}
</KeyValueList>
