---
interface Props { id: string; lat: number; lon: number; zoom?: number; height?: string; class?: string; style?: string; showLink?: boolean; linkText?: string; linkZoom?: number; }
const { id, lat, lon, zoom = 14, height = '220px', class: className = 'map-container', style: styleExtra = '', showLink = true, linkText = 'auto', linkZoom } = Astro.props;
const resolvedLinkZoom = linkZoom ?? zoom;
const computedLinkText = linkText === 'auto' ? `${lat.toFixed(5)}, ${lon.toFixed(5)}` : linkText;
const containerStyle = `height:${height};${styleExtra ? ` ${styleExtra}` : ''}`;
---
<script is:inline>
(function () {
  window.__vpLeaflet = window.__vpLeaflet || { loading: null, loaded: false };
  const state = window.__vpLeaflet;
  function ensureCssOnce() {
    if (document.querySelector('link[data-vp-leaflet-css="1"]')) return;
    const link = document.createElement('link'); link.rel = 'stylesheet'; link.href = '/dist/leaflet.css'; link.dataset.vpLeafletCss = '1'; document.head.appendChild(link);
  }
  /** @param {() => void} resolve */
  function waitForLeafletGlobal(resolve) { const check = () => { if (window.L && window.L.map) { state.loaded = true; resolve(); } else setTimeout(check, 25); }; check(); }
  function ensureJsOnce() {
    if (state.loaded) return state.loading || Promise.resolve();
    if (state.loading) return state.loading;
    state.loading = new Promise((resolve, reject) => {
      if (document.querySelector('script[data-vp-leaflet-js="1"]')) return waitForLeafletGlobal(resolve);
      const s = document.createElement('script'); s.src = '/dist/leaflet.js'; s.defer = true; s.dataset.vpLeafletJs = '1'; s.onload = () => { state.loaded = true; resolve(); }; s.onerror = () => reject(new Error('Leaflet failed to load'));
      (document.body || document.head || document.documentElement).appendChild(s);
    });
    return state.loading;
  }
  window.__vpLeafletLoad = window.__vpLeafletLoad || function () { ensureCssOnce(); return ensureJsOnce(); };
  try { window.__vpLeafletLoad(); } catch(e) {}
})();
</script>

<div id={id} class={className} style={containerStyle} data-lat={lat} data-lon={lon} data-zoom={zoom}></div>

{showLink && (
  <p class="text-muted text-xs mt-2">
    <a href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}&zoom=${resolvedLinkZoom}`} target="_blank">
      {computedLinkText}
    </a>
  </p>
)}

<script is:inline define:vars={{ id, lat, lon, zoom }}>
window.addEventListener('DOMContentLoaded', function () {
  window.__vpLeafletLoad().then(() => {
    const el = document.getElementById(id);
    if (!el || el.dataset.leafletInited === '1') return;
    el.dataset.leafletInited = '1';
    const map = L.map(id, { zoomAnimation: true, markerZoomAnimation: true }).setView([lat, lon], zoom);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);
    L.marker([lat, lon]).addTo(map);
  });
});
</script>
