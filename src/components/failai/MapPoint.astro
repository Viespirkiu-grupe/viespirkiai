---
import LeafletLoader from '@design-system/components/LeafletLoader.astro';

interface Props { id: string; lat: number; lon: number; zoom?: number; height?: string; class?: string; style?: string; showLink?: boolean; linkText?: string; linkZoom?: number; }
const { id, lat, lon, zoom = 14, height = '220px', class: className = 'map-container', style: styleExtra = '', showLink = true, linkText = 'auto', linkZoom } = Astro.props;
const resolvedLinkZoom = linkZoom ?? zoom;
const computedLinkText = linkText === 'auto' ? `${lat.toFixed(5)}, ${lon.toFixed(5)}` : linkText;
const containerStyle = `height:${height};${styleExtra ? ` ${styleExtra}` : ''}`;
---
<LeafletLoader />

<div id={id} class={className} style={containerStyle} data-lat={lat} data-lon={lon} data-zoom={zoom}></div>

{showLink && (
  <p class="text-muted text-xs mt-2">
    <a href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}&zoom=${resolvedLinkZoom}`} target="_blank">
      {computedLinkText}
    </a>
  </p>
)}

<script is:inline define:vars={{ id, lat, lon, zoom }}>
window.addEventListener('DOMContentLoaded', function () {
  window.__vpLeafletLoad().then(() => {
    const el = document.getElementById(id);
    if (!el || el.dataset.leafletInited === '1') return;
    el.dataset.leafletInited = '1';
    const map = L.map(id, { zoomAnimation: true, markerZoomAnimation: true }).setView([lat, lon], zoom);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);
    L.marker([lat, lon]).addTo(map);
  });
});
</script>
