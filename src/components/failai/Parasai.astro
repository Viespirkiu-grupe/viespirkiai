---
interface Sig {
  signer?: { name?: string; unit?: string; position?: string };
  signerCertificateCommonName?: string;
  signerCN?: string;
  signingTime?: string | number;
  level?: string;
  signingPurpose?: string;
  isValid?: boolean;
}
interface Props { signatures: Sig[]; title?: string; emptyText?: string; disclaimerText?: string; maxItems?: number; }
const { signatures = [], title = 'Parašai', emptyText = 'Nerasta', disclaimerText = 'Viešpirkiai netikrina skaitmeninių parašų galiojimo.', maxItems = 3 } = Astro.props;

const visible = signatures.slice(0, maxItems);
const hidden = signatures.slice(maxItems);

function getName(sig: Sig) {
  return sig?.signer?.name || sig?.signerCertificateCommonName || sig?.signerCN || 'Nežinomas pasirašytojas';
}
function formatTime(t?: string | number) {
  if (!t) return null;
  try {
    return new Date(t).toLocaleString('lt-LT', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
  } catch { return String(t); }
}
---
<dt>{title}</dt>
<dd class="signature-list">
  {signatures.length > 0 ? (
    <>
      <p class="text-muted text-xs mb-2"><em>{disclaimerText}</em></p>
      <div class="flex flex-col gap-2">
        {visible.filter(Boolean).map(sig => {
          const time = formatTime(sig.signingTime);
          const unit = sig?.signer?.unit;
          const pos = sig?.signer?.position;
          return (
            <div class="signature-item">
              <div class="flex flex-col">
                <div class="flex flex-wrap gap-2 items-baseline">
                  <span class="fw-bold">{getName(sig)}</span>
                  {time && <span class="text-muted text-xs">{time}</span>}
                </div>
                {(unit || pos) && (
                  <div class="text-muted text-xs">
                    {pos}{pos && unit ? ' · ' : ''}{unit}
                  </div>
                )}
                {(sig.level || sig.signingPurpose || sig.isValid !== undefined) && (
                  <div class="text-muted text-xs">
                    {sig.level && `Level: ${sig.level}`}
                    {sig.signingPurpose && ` · ${sig.signingPurpose}`}
                    {sig.isValid === true && ' · validus'}
                    {sig.isValid === false && ' · negalioja'}
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
      {hidden.length > 0 && (
        <details class="signature-list-details mt-2">
          <summary class="signature-list-summary">
            <span class="text-muted text-xs fw-bold">+ {hidden.length} daugiau</span>
          </summary>
          <div class="flex flex-col gap-2 mt-2">
            {hidden.filter(Boolean).map(sig => {
              const time = formatTime(sig.signingTime);
              const unit = sig?.signer?.unit;
              const pos = sig?.signer?.position;
              return (
                <div class="signature-item">
                  <div class="flex flex-col">
                    <div class="flex flex-wrap gap-2 items-baseline">
                      <span class="fw-bold">{getName(sig)}</span>
                      {time && <span class="text-muted text-xs">{time}</span>}
                    </div>
                    {(unit || pos) && (
                      <div class="text-muted text-xs">
                        {pos}{pos && unit ? ' · ' : ''}{unit}
                      </div>
                    )}
                    {(sig.level || sig.signingPurpose || sig.isValid !== undefined) && (
                      <div class="text-muted text-xs">
                        {sig.level && `Level: ${sig.level}`}
                        {sig.signingPurpose && ` · ${sig.signingPurpose}`}
                        {sig.isValid === true && ' · validus'}
                        {sig.isValid === false && ' · negalioja'}
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </details>
      )}
    </>
  ) : (
    <em class="text-muted">{emptyText}</em>
  )}
</dd>
