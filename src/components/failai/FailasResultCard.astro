---
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultCardFooter from '@design-system/components/ResultCardFooter.astro';
import ResultCardMeta from '@design-system/components/ResultCardMeta.astro';

interface Props {
  item: any;
  search: string;
}
const { item, search } = Astro.props;

const formatBytes = (value: unknown) => {
  const bytes = Number(value || 0);
  if (!Number.isFinite(bytes) || bytes <= 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  const index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  const amount = bytes / 1024 ** index;
  return `${amount.toLocaleString('lt-LT', { maximumFractionDigits: index === 0 ? 0 : 1 })} ${units[index]}`;
};
---

<ResultCardShell clickable={true}>
  <ResultCardMeta
    slot="meta"
    items={[
      { label: 'Formatas', value: String(item.extension || '').toUpperCase() },
      { label: 'Dydis', value: formatBytes(item.dydis) },
      item.metaduomenys && item.metaduomenys.pageCount && { label: 'Puslapiai', value: `${Number(item.metaduomenys.pageCount).toLocaleString('lt-LT')} p.` },
      { label: 'Žodžiai', value: `${Number(item.zodziuSkaicius).toLocaleString('lt-LT') || '—'} ž.` },
    ].filter(Boolean)}
  />

  <h3 slot="title" class="result-card-title">
    <a href={`/failas/${item.id}?search=${encodeURIComponent(search)}`}>
      {item.metaduomenys ? item.metaduomenys.Title || item.pavadinimas : item.pavadinimas}
    </a>
  </h3>

  {item.excerpt && <div class="text-sm text-muted mt-2 text-justify" set:html={item.excerpt} />}

  {item.dokId && <ResultCardFooter slot="footer" items={[{ value: '↗ Sutartis', href: `/sutartis/${item.dokId}` }]} />}
</ResultCardShell>
