---
import EmptyState from '@design-system/components/EmptyState.astro';
/**
 * „Dokumentas nerodomas" body fragment (buvęs „Failas pašalintas").
 *
 * Rodomas failo puslapyje, kai failas yra `files."hidden"` lentelėje.
 * Rendered inside the parent page's `<Layout>` — does not embed its own.
 * Puslapis atsakingas už `Astro.response.status` nustatymą.
 */
interface Props {
  /** Vieša priežastis, rodoma lankytojui. */
  priezastis?: string | null;
  /** HTTP statuso kodas (pvz. 451). */
  status?: number;
}
const { priezastis, status = 451 } = Astro.props;
const message = priezastis && priezastis.trim()
  ? priezastis
  : `${status} — dokumentas nerodomas.`;
---
<main class="failas-nerodomas">
  <EmptyState title="Dokumentas nerodomas" titleTag="h1" message={message} messageClass="text-muted text-sm" />
</main>

<style>
  /* Kairinis lygiavimas vietoje EmptyState numatyto centro. */
  .failas-nerodomas :global(.empty-state) {
    align-items: flex-start;
    text-align: left;
  }
</style>
