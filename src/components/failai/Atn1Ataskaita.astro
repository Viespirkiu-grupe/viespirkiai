---
import KeyValueList from '@design-system/components/KeyValueList.astro';
import Table from '@design-system/components/Table.astro';
import TableWrapper from '@design-system/components/TableWrapper.astro';
import JarKodasLink from './JarKodasLink.astro';
import type { Atn1 } from '../../lib/atn1.js';

const { atn1 } = Astro.props as { atn1: Atn1 };
const a = atn1.ataskaita;

const yesNo = (v: any) => (v === true ? 'Taip' : v === false ? 'Ne' : '—');
const val = (v: any) => (v == null || v === '' ? '—' : v);
---

<div class="flex flex-col gap-8">
  <section>
    <h3 class="mb-3 no-style">Bendra informacija</h3>
    <KeyValueList>
      <dt>Ataskaitos tipas</dt>
      <dd>{val(a.ataskaitosTipas)}</dd>
      <dt>Teisinis pagrindas</dt>
      <dd>{val(a.teisinisPageindas)}</dd>
      <dt>Pirkimo numeris</dt>
      <dd><span class="cell-mono">{val(a.pirkimoNumeris)}</span></dd>
      <dt>Pirkimo objekto pavadinimas</dt>
      <dd>{val(a.pirkimoObjektoPavadinimas)}</dd>
      <dt>Pirkimo vertė</dt>
      <dd><span class="cell-mono">{val(a.pirkimoVerte)}</span></dd>
      <dt>Pirkimo objekto rūšis</dt>
      <dd>{val(a.pirkimoObjektoRusis)}</dd>
      <dt>Pagrindinis BVPŽ kodas</dt>
      <dd><span class="cell-mono">{val(a.pagrindinisKodasBvpz)}</span></dd>
      <dt>Papildomi BVPŽ kodai</dt>
      <dd><span class="cell-mono">{val(a.papildomiKodaiBvpz)}</span></dd>
      <dt>Dalių skaičius</dt>
      <dd><span class="cell-mono">{val(a.daliuSkaicius)}</span></dd>
      <dt>Finansuojamas ES lėšomis</dt>
      <dd>{yesNo(a.finansuojamasEsLesomis)}</dd>
      <dt>Elektroninis pirkimas</dt>
      <dd>{yesNo(a.elektroninisPirkimas)}</dd>
      <dt>Preliminari sutartis</dt>
      <dd>{yesNo(a.preliminariSutartis)}</dd>
      <dt>Dinaminė pirkimų sistema</dt>
      <dd>{yesNo(a.dinamineSistema)}</dd>
      {a.kitaInformacija && (<><dt>Kita informacija</dt><dd>{a.kitaInformacija}</dd></>)}
    </KeyValueList>
  </section>

  <section>
    <h3 class="mb-3 no-style">Perkančioji organizacija</h3>
    <KeyValueList>
      <dt>Pavadinimas</dt>
      <dd>{val(a.perkanciosiosOrganizacijosPavadinimas)}</dd>
      <dt>Kodas</dt>
      <dd><JarKodasLink kodas={a.perkanciosiosOrganizacijosKodas} /></dd>
      <dt>Adresas</dt>
      <dd>{val(a.perkanciosiosOrganizacijosAdresas)}</dd>
      <dt>Tipas</dt>
      <dd>{val(a.perkanciosiosOrganizacijosTipas)}</dd>
      {a.igaliotosiosPavadinimas && (<>
        <dt>Įgaliotoji organizacija</dt>
        <dd>{a.igaliotosiosPavadinimas} {a.igaliotosiosKodas && (<>(<JarKodasLink kodas={a.igaliotosiosKodas} />)</>)}</dd>
      </>)}
    </KeyValueList>
  </section>

  <section>
    <h3 class="mb-3 no-style">Pirkimo būdas</h3>
    <KeyValueList>
      <dt>Pirkimo būdas</dt>
      <dd>{val(a.pirkimoBudas)}</dd>
      {a.pirkimoBudoPagrindimas && (<><dt>Pagrindimas</dt><dd>{a.pirkimoBudoPagrindimas}</dd></>)}
      {a.ankstesnioNumeris && (<><dt>Ankstesnio pirkimo numeris</dt><dd><span class="cell-mono">{a.ankstesnioNumeris}</span></dd></>)}
    </KeyValueList>
  </section>

  {atn1.pirkimoDalys.length > 0 && (
    <section>
      <h3 class="mb-3 no-style">Pirkimo dalys</h3>
      <TableWrapper>
        <Table size="sm">
          <thead><tr><th>Nr.</th><th>Pavadinimas</th><th>BVPŽ</th><th>Papildomi BVPŽ</th></tr></thead>
          <tbody>
            {atn1.pirkimoDalys.map((d) => (
              <tr>
                <td class="cell-mono">{val(d.daliesNumeris)}</td>
                <td>{val(d.daliesPavadinimas)}</td>
                <td class="cell-mono">{val(d.pagrindinisKodasBvpz)}</td>
                <td class="cell-mono">{val(d.papildomiKodaiBvpz)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </TableWrapper>
    </section>
  )}

  {atn1.dalyviai.length > 0 && (
    <section>
      <h3 class="mb-3 no-style">Dalyviai</h3>
      <TableWrapper>
        <Table size="sm">
          <thead><tr><th>Pavadinimas</th><th>Kodas</th><th>Adresas</th><th>Šalis</th></tr></thead>
          <tbody>
            {atn1.dalyviai.map((d) => (
              <tr>
                <td>{val(d.pavadinimas)}</td>
                <td><JarKodasLink kodas={d.kodas} link={d.fizinisAsmuo !== true} /></td>
                <td>{val(d.adresas)}</td>
                <td>{val(d.salis)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </TableWrapper>
    </section>
  )}

  {atn1.vertinimoKriterjai.length > 0 && (
    <section>
      <h3 class="mb-3 no-style">Vertinimo kriterijai</h3>
      <TableWrapper>
        <Table size="sm">
          <thead><tr><th>Dalies nr.</th><th>Kriterijus</th></tr></thead>
          <tbody>
            {atn1.vertinimoKriterjai.map((d) => (
              <tr>
                <td class="cell-mono">{val(d.daliesNumeris)}</td>
                <td>{val(d.vertinimoKriterijus)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </TableWrapper>
    </section>
  )}

  {atn1.atmestiPasiulymai.length > 0 && (
    <section>
      <h3 class="mb-3 no-style">Atmesti pasiūlymai</h3>
      <TableWrapper>
        <Table size="sm">
          <thead><tr><th>Dalies nr.</th><th>Dalyvis</th><th>Statusas</th><th>Kaina</th><th>Atmetimo priežastys</th></tr></thead>
          <tbody>
            {atn1.atmestiPasiulymai.map((d) => (
              <tr>
                <td class="cell-mono">{val(d.daliesNumeris)}</td>
                <td>{val(d.dalyvioPavadinimas)} {d.dalyvioKodas && (<>(<JarKodasLink kodas={d.dalyvioKodas} />)</>)}</td>
                <td>{val(d.statusas)}</td>
                <td class="cell-mono">{val(d.pasiulymoKaina)}</td>
                <td>{val(d.atmetimoPriezastys)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </TableWrapper>
    </section>
  )}

  {atn1.pasiulymuEile.length > 0 && (
    <section>
      <h3 class="mb-3 no-style">Pasiūlymų eilė</h3>
      <TableWrapper>
        <Table size="sm">
          <thead><tr><th>Dalies nr.</th><th>Eilė</th><th>Dalyvis</th><th>Kaina</th></tr></thead>
          <tbody>
            {atn1.pasiulymuEile.map((d) => (
              <tr>
                <td class="cell-mono">{val(d.daliesNumeris)}</td>
                <td class="cell-mono">{val(d.eileNumeris)}</td>
                <td>{val(d.dalyvioPavadinimas)} {d.dalyvioKodas && (<>(<JarKodasLink kodas={d.dalyvioKodas} />)</>)}</td>
                <td class="cell-mono">{val(d.kaina)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </TableWrapper>
    </section>
  )}

  {atn1.proceduruPabaiga.length > 0 && (
    <section>
      <h3 class="mb-3 no-style">Procedūrų pabaiga</h3>
      <TableWrapper>
        <Table size="sm">
          <thead><tr><th>Dalies nr.</th><th>Pabaiga</th><th>Sprendimo data</th><th>Priežastys</th></tr></thead>
          <tbody>
            {atn1.proceduruPabaiga.map((d) => (
              <tr>
                <td class="cell-mono">{val(d.daliesNumeris)}</td>
                <td>{val(d.proceduruPabaiga)}</td>
                <td class="cell-mono">{val(d.sprendimoPriemimoData)}</td>
                <td>{val(d.sprendimoPriezastys) !== '—' ? d.sprendimoPriezastys : val(d.nutraukimoPriezastys)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </TableWrapper>
    </section>
  )}

  {atn1.sutartys.length > 0 && (
    <section>
      <h3 class="mb-3 no-style">Sutartys</h3>
      <TableWrapper>
        <Table size="sm">
          <thead><tr><th>Dalys</th><th>Tiekėjas</th><th class="cell-right">Vertė</th><th>Sudaryta</th><th>Galiojimas</th></tr></thead>
          <tbody>
            {atn1.sutartys.map((d) => (
              <tr>
                <td class="cell-mono">{val(d.daliesNumeriai)}</td>
                <td>{val(d.teikejoPavadinimas)} {d.tiekejosKodas && (<>(<JarKodasLink kodas={d.tiekejosKodas} />)</>)}</td>
                <td class="cell-mono cell-right">{d.sutartiesVerte != null ? Number(d.sutartiesVerte).toLocaleString('lt-LT', { style: 'currency', currency: 'EUR' }) : '—'}</td>
                <td class="cell-mono">{val(d.sutartisSudarymoData)}</td>
                <td>{val(d.sutartiesGaliojimas)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </TableWrapper>
    </section>
  )}

  <section>
    <h3 class="mb-3 no-style">Skundai ir interesų konfliktai</h3>
    <KeyValueList>
      <dt>Pateikta pretenzija</dt>
      <dd>{yesNo(a.pretenzijaPateikta)}</dd>
      <dt>Pateiktas ieškinys teismui</dt>
      <dd>{yesNo(a.ieskinysTeismui)}</dd>
      <dt>Nustatytas interesų konfliktas</dt>
      <dd>{yesNo(a.interesuKonfliktasNustatytas)}</dd>
      {a.interesuKonfliktoPriemones && (<><dt>Interesų konflikto priemonės</dt><dd>{a.interesuKonfliktoPriemones}</dd></>)}
      <dt>Konkurenciją iškreipiantis asmuo</dt>
      <dd>{yesNo(a.konkurencijaIskreipiantisAsmuo)}</dd>
      {a.konkurencijosPriemones && (<><dt>Konkurencijos priemonės</dt><dd>{a.konkurencijosPriemones}</dd></>)}
    </KeyValueList>
  </section>

  <section>
    <h3 class="mb-3 no-style">Kontaktai</h3>
    <KeyValueList>
      <dt>Atsakingas asmuo</dt>
      <dd>{val(a.atsakingasAsmuo)}</dd>
      <dt>Telefonas</dt>
      <dd><span class="cell-mono">{val(a.telefonas)}</span></dd>
      <dt>El. paštas</dt>
      <dd>{val(a.elpastas)}</dd>
      {a.pasirasantisAsmuo && (<>
        <dt>Pasirašantis asmuo</dt>
        <dd>{a.pasirasantisAsmuo}{a.pasirasantisPareigos ? `, ${a.pasirasantisPareigos}` : ''}</dd>
      </>)}
    </KeyValueList>
  </section>
</div>
