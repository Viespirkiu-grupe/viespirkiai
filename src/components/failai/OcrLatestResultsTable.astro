---
import DataTable from '@design-system/components/DataTable.astro';
import NumberValue from '@design-system/components/NumberValue.astro';

interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<DataTable
  rows={items}
  emptyText="Naujausių OCR rezultatų nėra."
  size="sm"
  className="ocr-latest-table"
  wrapperClassName="ocr-latest-table-wrap"
  bodyAttributes={{ 'data-ocr-latest-results-body': true }}
  columns={[
    { label: 'Node', headerClassName: 'cell-nowrap' },
    { label: 'ID', headerClassName: 'cell-right cell-nowrap' },
    { label: 'Pateikta', headerClassName: 'cell-nowrap' },
    { label: 'Trukmė', headerClassName: 'cell-right cell-nowrap' },
    { label: 'Puslapiai', headerClassName: 'cell-right cell-nowrap' },
    { label: 'Žodžiai', headerClassName: 'cell-right cell-nowrap' },
  ]}
>
  {items.map((item) => (
    <tr>
      <td class="ocr-latest-col-node" data-label="Node">{item.nodeDisplay || item.node || '—'}</td>
      <td class="cell-right cell-nowrap" data-label="ID"><a href={`/failas/${item.failas}`}>{item.failas}</a></td>
      <td class="cell-nowrap ocr-latest-col-submitted" data-label="Pateikta">{item.submitTimestampDisplay}</td>
      <td class="cell-right cell-nowrap" data-label="Trukmė">{item.durationDisplay}</td>
      <td class="cell-right cell-nowrap" data-label="Puslapiai"><NumberValue value={item.puslapiuSkaicius} mono={false} /></td>
      <td class="cell-right cell-nowrap" data-label="Žodžiai"><NumberValue value={item.zodziuSkaicius} mono={false} /></td>
    </tr>
  ))}
</DataTable>

<style>
  :global(.ocr-latest-table) {
    width: 100%;
    table-layout: auto;
    min-width: 760px;
  }

  :global(.ocr-latest-table-wrap) {
    overflow-x: auto;
  }

  .ocr-latest-table :global(.ocr-latest-col-node),
  .ocr-latest-table :global(.ocr-latest-col-submitted) {
    white-space: normal;
    word-break: break-word;
  }

  :global(.ocr-latest-table th),
  :global(.ocr-latest-table td) {
    background-clip: padding-box;
  }

  :global(.ocr-latest-table th.cell-nowrap),
  :global(.ocr-latest-table td.cell-nowrap) {
    max-width: none;
  }

  :global(.ocr-latest-table th:first-child),
  :global(.ocr-latest-table td:first-child) {
    width: 32%;
  }

  :global(.ocr-latest-table th:nth-child(2)),
  :global(.ocr-latest-table td:nth-child(2)) {
    width: 10%;
  }

  :global(.ocr-latest-table th:nth-child(3)),
  :global(.ocr-latest-table td:nth-child(3)) {
    width: 18%;
  }
</style>
