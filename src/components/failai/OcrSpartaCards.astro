---
import { fmtNumber } from '../../lib/formatters.ts';

interface Props {
  title: string;
  anchor: string;
  results: number;
  pages: number;
  words: number;
}
const { title, anchor, results, pages, words } = Astro.props;
---

<div class="min-w-0 flex-1">
  <h2 class="mb-3">
    <a href={`#${anchor}`} id={anchor} class="no-style">{title}</a>
  </h2>
  <div class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(180px,1fr))]">
    {[
      { label: 'Dokumentai', value: results },
      { label: 'Puslapiai', value: pages },
      { label: 'Žodžiai', value: words },
    ].map(({ label, value }) => (
      <div class="card">
        <div class="card-body">
          <div class="section-title mb-2">{label}</div>
          <div class="flex items-baseline gap-1">
            <span class="cell-mono text-[1.6rem] font-semibold">{fmtNumber(value)}</span>
            <span class="text-xs text-muted font-medium">/min.</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
