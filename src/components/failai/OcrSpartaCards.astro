---
import MetricCard from '@design-system/components/MetricCard.astro';
import MetricCardGrid from '@design-system/components/MetricCardGrid.astro';
import { fmtNumber } from '../../lib/formatters.ts';

interface Props {
  title: string;
  anchor: string;
  results: number;
  pages: number;
  words: number;
}
const { title, anchor, results, pages, words } = Astro.props;
---

<div class="min-w-0 flex-1">
  <h2 class="mb-3">
    <a href={`#${anchor}`} id={anchor} class="no-style">{title}</a>
  </h2>
  <MetricCardGrid>
    {[
      { label: 'Dokumentai', value: results },
      { label: 'Puslapiai', value: pages },
      { label: 'Žodžiai', value: words },
    ].map(({ label, value }) => (
      <MetricCard label={label} value={fmtNumber(value)} unit="/min." />
    ))}
  </MetricCardGrid>
</div>
