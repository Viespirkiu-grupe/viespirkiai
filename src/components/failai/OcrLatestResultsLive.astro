---
import OcrLatestResultsTable from './OcrLatestResultsTable.astro';

interface Props {
  items: any[];
}

const { items } = Astro.props;
const initialFirstKey = JSON.stringify([
  items[0]?.failas ?? null,
  items[0]?.submitTimestampDisplay ?? null,
]);
---

<div
  class="ocr-live-results"
  data-sse-url="/failai/ocr/latestResultsSse"
  data-first-key={initialFirstKey}
>
  <OcrLatestResultsTable items={items} />
  <script type="application/json" data-ocr-initial-items set:html={JSON.stringify(items)}></script>
</div>

<script>
  const escapeHtml = (value: unknown) => String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const renderRows = (body: HTMLTableSectionElement, items: any[]) => {
    if (!Array.isArray(items) || items.length === 0) {
      body.innerHTML = '<tr><td colspan="6" class="empty-state-cell">Naujausių OCR rezultatų nėra.</td></tr>';
      return;
    }

    const rowsHtml = items.map((item) => `
      <tr data-ocr-row-key="${escapeHtml(JSON.stringify([item.failas ?? null, item.submitTimestampDisplay ?? null]))}">
        <td class="ocr-latest-col-node" data-label="Node">${escapeHtml(item.nodeDisplay || item.node || '—')}</td>
        <td class="cell-right cell-nowrap" data-label="ID"><a href="/failas/${encodeURIComponent(item.failas)}">${escapeHtml(item.failas)}</a></td>
        <td class="cell-nowrap" data-label="Pateikta">${escapeHtml(item.submitTimestampDisplay)}</td>
        <td class="cell-right cell-nowrap" data-label="Trukmė">${escapeHtml(item.durationDisplay)}</td>
        <td class="cell-right cell-nowrap" data-label="Puslapiai">${escapeHtml(Number(item.puslapiuSkaicius || 0).toLocaleString('lt-LT'))}</td>
        <td class="cell-right cell-nowrap" data-label="Žodžiai">${escapeHtml(Number(item.zodziuSkaicius || 0).toLocaleString('lt-LT'))}</td>
      </tr>
    `).join('');

    body.innerHTML = rowsHtml;
  };

  for (const root of document.querySelectorAll<HTMLElement>('.ocr-live-results')) {
    const body = root.querySelector<HTMLTableSectionElement>('[data-ocr-latest-results-body]');
    const initialItemsEl = root.querySelector<HTMLScriptElement>('[data-ocr-initial-items]');
    const sseUrl = root.dataset.sseUrl;
    if (!body || !initialItemsEl || !sseUrl) continue;

    let evtSource: EventSource | null = null;
    let lastFirstKey = root.dataset.firstKey || JSON.stringify([null, null]);
    let previousKeys = new Set<string>();
    let hasReceivedSseSnapshot = false;

    const animateNewRows = (newKeys: string[]) => {
      if (newKeys.length <= 0) return;
      newKeys.forEach((key, index) => {
        const row = body.querySelector<HTMLTableRowElement>(`tr[data-ocr-row-key="${CSS.escape(key)}"]`);
        if (!row) return;
        row.classList.remove('ocr-row-enter');
        row.style.setProperty('--ocr-row-enter-delay', `${index * 45}ms`);
        void row.getBoundingClientRect();
        row.classList.add('ocr-row-enter');
      });
    };

    const updateItems = (items: any[], source: 'initial' | 'sse') => {
      renderRows(body, items);
      const nextKeys = items.map((item) => JSON.stringify([item.failas ?? null, item.submitTimestampDisplay ?? null]));
      const nextFirstKey = JSON.stringify([items[0]?.failas ?? null, items[0]?.submitTimestampDisplay ?? null]);

      if (source === 'sse') {
        const newKeys = nextKeys.filter((key) => !previousKeys.has(key));
        if (hasReceivedSseSnapshot) {
          const newPrefixKeys: string[] = [];
          for (const key of nextKeys) {
            if (!previousKeys.has(key)) newPrefixKeys.push(key);
            else break;
          }
          animateNewRows(newPrefixKeys.length > 0 ? newPrefixKeys : newKeys);
        }
        hasReceivedSseSnapshot = true;
      }

      previousKeys = new Set(nextKeys);
      lastFirstKey = nextFirstKey;
      root.dataset.firstKey = nextFirstKey;
    };

    try {
      const initialItems = JSON.parse(initialItemsEl.textContent || '[]');
      updateItems(initialItems, 'initial');
    } catch {}

    const start = () => {
      evtSource = new EventSource(sseUrl);
      evtSource.onmessage = (event) => {
        try {
          const payload = JSON.parse(event.data);
          updateItems(payload.items, 'sse');
        } catch {}
      };
      evtSource.onerror = () => {
        evtSource?.close();
        window.setTimeout(start, 1000);
      };
    };

    start();
    window.addEventListener('beforeunload', () => evtSource?.close(), { once: true });
  }
</script>

<style>
  @keyframes ocr-row-enter {
    from {
      opacity: 0;
      transform: translateY(-8px);
      background-color: color-mix(in srgb, var(--color-success-bg) 70%, transparent);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      background-color: transparent;
    }
  }

  .ocr-live-results :global(.ocr-row-enter td) {
    animation: ocr-row-enter 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
    animation-delay: var(--ocr-row-enter-delay, 0ms);
    animation-fill-mode: both;
    will-change: transform, opacity, background-color;
  }
</style>
