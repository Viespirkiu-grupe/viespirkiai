---
import KeyValueList from '@design-system/components/KeyValueList.astro';
import MetricCard from '@design-system/components/MetricCard.astro';
import MetricCardGrid from '@design-system/components/MetricCardGrid.astro';

interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<MetricCardGrid minWidth="190px" className="pt-1">
  {items.map((nuskaitytojas) => (
    <MetricCard label={nuskaitytojas.viesasPavadinimas} href={`/failai/ocr/${nuskaitytojas.id}`} clickable>
      <KeyValueList
        items={[
          { label: 'Dokumentai', value: nuskaitytojas.results.toLocaleString('lt-LT'), valueClassName: 'cell-mono' },
          { label: 'Puslapiai', value: nuskaitytojas.pages.toLocaleString('lt-LT'), valueClassName: 'cell-mono' },
          { label: 'Žodžiai', value: nuskaitytojas.words.toLocaleString('lt-LT'), valueClassName: 'cell-mono' },
          { label: 'Rezervacijos', value: nuskaitytojas.rezervacijos.toLocaleString('lt-LT'), valueClassName: 'cell-mono' },
        ]}
      />
    </MetricCard>
  ))}
</MetricCardGrid>
