---
import ArchiveTreeNode from './ArchiveTreeNode.astro';

interface TreeNode { name?: string; path?: string; id?: string | number; extension?: string; size?: number; isDirectory?: boolean; children?: TreeNode[]; }
interface Props { filesTree: TreeNode[]; failasId: string | number; openByDefault?: boolean; rootClass?: string; }
const { filesTree = [], failasId, openByDefault = true, rootClass = '' } = Astro.props;

function compareNodes(a: TreeNode, b: TreeNode) {
  const aIsDir = !!a?.isDirectory || (Array.isArray(a?.children) && a.children.length > 0);
  const bIsDir = !!b?.isDirectory || (Array.isArray(b?.children) && b.children.length > 0);
  if (aIsDir !== bIsDir) return aIsDir ? -1 : 1;
  return (a?.name || '').localeCompare(b?.name || '', 'lt', { numeric: true, sensitivity: 'base' });
}

const sortedTree = [...filesTree].sort(compareNodes);
---
<div class={`archive-tree ${rootClass}`}>
  {filesTree.length > 0
    ? (
      <div class="archive-root">
        <ul class="archive-branch archive-branch-root">
          {sortedTree.map((node) => (
            <ArchiveTreeNode node={node} failasId={failasId} openByDefault={openByDefault} />
          ))}
        </ul>
      </div>
    )
    : <em class="text-muted">Nerasta</em>
  }
</div>

<style>
  .archive-tree {
    font-size: var(--text-sm);
    overflow: auto;
  }

  .archive-root {
    min-width: 0;
  }

  .archive-branch {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archive-branch:not(.archive-branch-root) {
    margin-left: 18px;
    padding-left: 14px;
  }

  :global(.archive-node) {
    margin: 0;
  }

  :global(.archive-row) {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 10px 0;
    min-width: 0;
    box-sizing: border-box;
  }

  :global(.archive-tree summary) {
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  :global(.archive-tree summary::-webkit-details-marker) {
    display: none;
  }

  :global(.archive-caret) {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  :global(.archive-caret)::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 1px;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--gray);
    border-bottom: 1.5px solid var(--gray);
    transform: rotate(-45deg);
    transition: transform var(--transition);
  }

  :global(.archive-tree details[open] > summary .archive-caret)::before {
    transform: rotate(45deg);
    top: 0;
  }

  :global(.archive-label) {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    line-height: 1.4;
  }

  :global(.archive-meta) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gray);
    flex-shrink: 0;
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  :global(.archive-link) {
    color: inherit;
    text-decoration: none;
  }

  :global(.archive-row:hover) {
    background: transparent;
  }

  :global(.archive-link:hover .archive-label) {
    text-decoration: underline;
  }

  .archive-tree.loading {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .archive-tree.compact :global(summary.archive-row) {
    padding: 6px 0;
    gap: 12px;
  }

  @media (max-width: 640px) {
    :global(.archive-row) {
      padding: 8px 0;
      align-items: flex-start;
      gap: 10px;
    }

    :global(.archive-meta) {
      display: none;
    }
  }
</style>
