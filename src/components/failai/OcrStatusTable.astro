---
import DataTable from '@design-system/components/DataTable.astro';
import NumberValue from '@design-system/components/NumberValue.astro';

interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<DataTable
  wrapperClassName="mt-4"
  columns={[
    { label: 'ID', headerClassName: 'cell-center' },
    { label: 'OCR būsena' },
    { label: 'Failų skaičius', headerClassName: 'cell-right' },
  ]}
>
  {items.map((status) => (
    <tr>
      <td class="cell-mono cell-center">{status.id}</td>
      <td>{status.text}</td>
      <td class="cell-mono cell-right"><NumberValue value={status.count} mono={false} /></td>
    </tr>
  ))}
</DataTable>
