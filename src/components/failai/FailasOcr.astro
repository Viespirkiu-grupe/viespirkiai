---
import KeyValueList from '@design-system/components/KeyValueList.astro';
import { formatDateTime, formatDuration } from '@/utils/time.js';
interface Props { failas: any; }
const { failas } = Astro.props;
const ocrLatest = failas.ocrLatestResult;
const items = [
  failas.ocrStateKey && failas.ocrStateKey !== '1' && { label: 'Būsena', value: failas.ocrStateText },
  ocrLatest && (ocrLatest.duration || ocrLatest.duration === 0) && { label: 'Trukmė', value: formatDuration(ocrLatest.duration), valueClassName: 'cell-mono' },
  ocrLatest && (ocrLatest.puslapiuSkaicius || ocrLatest.puslapiuSkaicius === 0) && { label: 'Puslapiai', value: Number(ocrLatest.puslapiuSkaicius).toLocaleString('lt-LT'), valueClassName: 'cell-mono' },
  ocrLatest && (ocrLatest.zodziuSkaicius || ocrLatest.zodziuSkaicius === 0) && { label: 'Žodžiai', value: Number(ocrLatest.zodziuSkaicius).toLocaleString('lt-LT'), valueClassName: 'cell-mono' },
  typeof failas.ocrBandymai === 'number' && failas.ocrBandymai > 0 && { label: 'Bandymų sk.', value: failas.ocrBandymai, valueClassName: 'cell-mono' },
  typeof failas.ocrRezultatuSkaicius === 'number' && failas.ocrRezultatuSkaicius > 1 && { label: 'Rezultatų įrašai', value: failas.ocrRezultatuSkaicius, valueClassName: 'cell-mono' },
  failas.ocrNode && { label: 'Nuskaitytojas', value: failas.ocrNode, valueClassName: 'cell-mono' },
].filter(Boolean);
---
<div>
  <h2 class="mb-1 no-style">OCR</h2>

  {ocrLatest?.submitTimestamp
    ? <p class="text-muted text-xs mb-2">{ocrLatest.submitTimestampDisplay || formatDateTime(ocrLatest.submitTimestamp)}</p>
    : failas.ocrLockTimestamp
      ? <p class="text-muted text-xs mb-2">{failas.ocrLockTimestampDisplay || formatDateTime(failas.ocrLockTimestamp)}</p>
      : null
  }

  <KeyValueList className="mb-0" items={items} />
</div>
