---
import ContactList from '@design-system/components/content/ContactList.astro';
interface Props { domains: string[]; title?: string; maxItems?: number; emptyText?: string; }
const { domains = [], title = 'Interneto puslapiai', maxItems = 3, emptyText = 'Nerasta' } = Astro.props;
---
<ContactList items={domains.filter(Boolean).map((value) => ({ value }))} title={title} type="domain" maxItems={maxItems} emptyText={emptyText} />
