---
import type { BvpzPanel } from '../../lib/searchBvpzPanel.ts';
import BvpzMiniTreeNode, { type BvpzMiniTreeNodeData } from './BvpzMiniTreeNode.astro';

interface Props {
  bvpz: BvpzPanel;
}

const { bvpz } = Astro.props;
const code = encodeURIComponent(bvpz.mask);
let treeRoot: BvpzMiniTreeNodeData = {
  mask: bvpz.mask,
  pavadinimas: bvpz.pavadinimas,
  current: true,
  children: bvpz.children.map((item) => ({
    mask: item.mask,
    pavadinimas: item.pavadinimas,
    children: [],
  })),
};
for (const ancestor of [...bvpz.ancestors].reverse()) {
  treeRoot = {
    mask: ancestor.mask,
    pavadinimas: ancestor.pavadinimas,
    children: [treeRoot],
  };
}
---

<aside class="bvpz-panel" aria-label="BVPŽ kodo informacija">
  <div class="bvpz-panel__eyebrow">
    <span>BVPŽ kodas</span>
    <span class="cell-mono">{bvpz.fullCode}</span>
  </div>
  <h2>{bvpz.pavadinimas}</h2>
  <p>
    Bendrojo viešųjų pirkimų žodyno klasifikacijos kodas.
  </p>

  <div class="bvpz-mini-tree" aria-label="BVPŽ kodo vieta klasifikatoriuje">
    <ul>
      <BvpzMiniTreeNode node={treeRoot} />
    </ul>
    {bvpz.children.length === 8 && <div class="bvpz-mini-tree__more">Rodomos pirmos subkategorijos</div>}
  </div>

  <nav class="bvpz-panel__actions" aria-label="BVPŽ kodo nuorodos">
    <a class="btn btn-primary bvpz-panel__contracts" href={`/?bvpzPrefiksasKitas=${code}`}>Sutartys</a>
    <div class="bvpz-panel__secondary-actions">
      <details class="bvpz-panel__dropdown">
        <summary class="btn btn-outline btn-sm bvpz-panel__dropdown-button">
          <span>Viešieji pirkimai</span>
          <span aria-hidden="true">▾</span>
        </summary>
        <div class="bvpz-panel__menu">
          <a href={`/viesiejiPirkimai?bvpzPrefiksai=${code}`}>
            <strong>Visi pirkimai</strong>
            <span>Skelbti ir pasibaigę pirkimai</span>
          </a>
          <a href={`/viesiejiPirkimai?statusas=teikimas&bvpzPrefiksai=${code}`}>
            <strong>Pasiūlymų teikimas</strong>
            <span>Šiuo metu aktyvūs pirkimai</span>
          </a>
        </div>
      </details>
      <a class="btn btn-outline btn-sm" href={`/bvpz?code=${code}`}>BVPŽ medis</a>
    </div>
  </nav>
</aside>

<style>
  .bvpz-panel {
    grid-area: panel;
    align-self: start;
    padding: 24px;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .bvpz-panel__eyebrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    color: var(--gray);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.3;
  }
  p {
    margin: 12px 0 18px;
    color: var(--gray);
    font-size: var(--text-sm);
  }
  .bvpz-mini-tree {
    margin-bottom: 22px;
    padding: 10px 0;
    border-block: var(--border);
    overflow: hidden;
  }
  .bvpz-mini-tree :global(ul) {
    position: relative;
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0 0 0 16px;
    list-style: none;
  }
  .bvpz-mini-tree > :global(ul) {
    padding-left: 0;
  }
  .bvpz-mini-tree :global(ul ul) {
    margin-left: 12px;
  }
  .bvpz-mini-tree :global(ul ul::before) {
    position: absolute;
    top: 0;
    bottom: 15px;
    left: 4px;
    width: 1px;
    background: var(--light-gray);
    content: '';
  }
  .bvpz-mini-tree :global(li) {
    position: relative;
    min-width: 0;
  }
  .bvpz-mini-tree :global(ul ul > li::before) {
    position: absolute;
    top: 14px;
    left: -12px;
    width: 12px;
    height: 1px;
    background: var(--light-gray);
    content: '';
  }
  .bvpz-mini-tree :global(.bvpz-mini-tree__row) {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr);
    gap: 8px;
    padding: 5px 8px;
    color: var(--dark-gray);
    font-size: var(--text-xs);
    line-height: 1.35;
    text-decoration: none;
  }
  .bvpz-mini-tree :global(.bvpz-mini-tree__row:hover) {
    background: var(--lightest-gray);
    color: var(--black);
  }
  .bvpz-mini-tree :global(.bvpz-mini-tree__row--current) {
    margin: 3px 0;
    border-radius: var(--radius-sm);
    background: var(--lightest-gray);
    color: var(--black);
    font-weight: 600;
  }
  .bvpz-mini-tree__more {
    padding: 7px 8px 0 28px;
    color: var(--gray);
    font-size: var(--text-xs);
  }
  .bvpz-panel__actions {
    display: grid;
    gap: 8px;
  }
  .bvpz-panel__contracts {
    justify-content: center;
    width: 100%;
  }
  .bvpz-panel__secondary-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .bvpz-panel__secondary-actions > .btn,
  .bvpz-panel__dropdown summary {
    justify-content: center;
    width: 100%;
    min-width: 0;
  }
  .bvpz-panel__dropdown {
    position: relative;
    min-width: 0;
  }
  .bvpz-panel__dropdown summary {
    list-style: none;
    cursor: pointer;
  }
  .bvpz-panel__dropdown summary::-webkit-details-marker {
    display: none;
  }
  .bvpz-panel__dropdown-button {
    display: flex;
    justify-content: space-between !important;
    gap: 8px;
  }
  .bvpz-panel__menu {
    position: absolute;
    z-index: var(--z-dropdown);
    top: calc(100% + 6px);
    left: 0;
    display: grid;
    width: min(280px, calc(100vw - 48px));
    padding: 6px;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--shadow-lg);
  }
  .bvpz-panel__menu a {
    display: grid;
    gap: 2px;
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    color: var(--black);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .bvpz-panel__menu a:hover,
  .bvpz-panel__menu a:focus-visible {
    background: var(--lighter-gray);
    color: var(--black);
  }
  .bvpz-panel__menu a:focus-visible {
    outline: var(--border-focus);
  }
  .bvpz-panel__menu span {
    color: var(--gray);
    font-size: var(--text-xs);
  }
</style>
