---
interface Props {
  title: string;
  isEmpty: boolean;
  emptyText?: string;
  titleSuffix?: string;
  moreLabel?: string;
}

const { title, isEmpty, emptyText = 'Nėra duomenų.', titleSuffix, moreLabel } = Astro.props;
const hasTitleSuffix = Astro.slots.has('title-suffix') || titleSuffix;
const hasMore = Astro.slots.has('more');
---

<section>
  <h2>
    {title}{titleSuffix && <> <sup>{titleSuffix}</sup></>}{!titleSuffix && hasTitleSuffix && <slot name="title-suffix" />}
  </h2>
  {isEmpty
    ? <p class="text-muted mt-4"><em>{emptyText}</em></p>
    : <>
        <div class="result-list mt-4"><slot /></div>
        {hasMore && (
          <details class="card-list-more mt-4">
            <summary class="btn btn-sm btn-secondary">{moreLabel ?? 'Rodyti daugiau'}</summary>
            <div class="result-list mt-4"><slot name="more" /></div>
          </details>
        )}
      </>
  }
</section>

<style>
  .card-list-more > summary {
    list-style: none;
    cursor: pointer;
    display: inline-block;
  }
  .card-list-more > summary::-webkit-details-marker {
    display: none;
  }
</style>
