---
import FacetModalBase from '@design-system/components/FacetModalBase.astro';
---

<FacetModalBase id="dokFacetModal" />

<script>
  // Facet "show all" modal: a full-screen list of every value for one facet
  // (fetched on demand, up to ~1k), with a client-side filter, a custom-entry
  // field and batched apply. Extensions render as `.pdf`; selection mirrors the
  // live query string. Registers itself on the shared facetModal so the sidebar
  // "Daugiau" buttons can open it.
  import { params, navigate, getList, setList, facetModal } from '../../scripts/dokumentaiNav.ts';
  import { openModal, closeModal } from '@design-system/components/modal.ts';

  const modal = document.getElementById('dokFacetModal');
  if (modal) {
    const titleEl = modal.querySelector<HTMLElement>('.ds-modal__title')!;
    const searchEl = modal.querySelector<HTMLInputElement>('.dok-facet-modal__search')!;
    const listEl = modal.querySelector<HTMLElement>('.dok-facet-modal__list')!;
    const countEl = modal.querySelector<HTMLElement>('.ds-modal__count')!;

    let field = '';
    let param = '';
    let selected = new Set<string>();      // working copy; committed on Taikyti
    let options: { value: string; count: number | null; label?: string }[] = [];
    let reqSeq = 0;
    let searchTimer = 0;

    const isExt = () => param === 'ext';
    const normalize = (v: string) => (isExt() ? v.toLowerCase().replace(/^\./, '') : v.trim());
    const display = (v: string) => (isExt() ? `.${v}` : v);

    function setOpen(open: boolean) {
      if (open) { openModal(modal!); searchEl.focus(); }
      else closeModal(modal!);
    }

    function updateCount() {
      countEl.textContent = selected.size ? `Pažymėta: ${selected.size}` : '';
    }

    function toggle(value: string, row?: HTMLElement) {
      if (selected.has(value)) selected.delete(value);
      else selected.add(value);
      const on = selected.has(value);
      row?.classList.toggle('is-selected', on);
      row?.setAttribute('aria-selected', String(on));
      updateCount();
    }

    // Add whatever is typed as a custom value (the single input both filters and
    // adds). Re-renders so it shows up selected and the "add" row disappears.
    function addTyped() {
      const value = normalize(searchEl.value);
      if (!value) return;
      selected.add(value);
      searchEl.value = '';
      updateCount();
      render();
    }

    function makeRow(o: { value: string; count: number | null; label?: string }) {
      const value = o.value;
      const on = selected.has(value);
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'dok-facet-row' + (o.label ? ' dok-facet-row--stack' : '') + (on ? ' is-selected' : '');
      row.setAttribute('role', 'option');
      row.setAttribute('aria-selected', String(on));
      // Pavadinimas apkarpomas iki 1 eilutės — pilnas tekstas pasiekiamas hover'iu.
      if (o.label) row.title = `${o.label} (${display(value)})`;
      // Su label (pvz. įstaigos pavadinimu) — dvi eilutės: pavadinimas + kodas.
      const text = document.createElement('span');
      text.className = 'dok-facet-row__text';
      const label = document.createElement('span');
      label.className = 'dok-facet-row__label';
      label.textContent = o.label || display(value);
      text.appendChild(label);
      if (o.label) {
        const sub = document.createElement('span');
        sub.className = 'dok-facet-row__sub';
        sub.textContent = display(value);
        text.appendChild(sub);
      }
      row.appendChild(text);
      if (o.count != null) {
        const cnt = document.createElement('span');
        cnt.className = 'dok-facet-row__count';
        cnt.textContent = Number(o.count).toLocaleString('lt-LT');
        row.appendChild(cnt);
      }
      row.addEventListener('click', () => toggle(value, row));
      return row;
    }

    function render() {
      const needle = searchEl.value.trim().toLowerCase();
      const typed = normalize(searchEl.value);
      // Selected-but-unlisted values (custom or filtered out) pinned on top.
      const listedValues = new Set(options.map((o) => o.value));
      const pinned: typeof options = [...selected].filter((v) => !listedValues.has(v)).map((v) => ({ value: v, count: null }));
      const rows = [...pinned, ...options].filter(
        (o) => !needle || o.value.toLowerCase().includes(needle) || display(o.value).toLowerCase().includes(needle) || (o.label?.toLowerCase().includes(needle) ?? false),
      );

      listEl.textContent = '';
      const frag = document.createDocumentFragment();

      // Offer to add the typed value when it isn't an existing/selected option.
      const canAdd = typed && !listedValues.has(typed) && !selected.has(typed);
      if (canAdd) {
        const add = document.createElement('button');
        add.type = 'button';
        add.className = 'dok-facet-row dok-facet-row--add';
        const label = document.createElement('span');
        label.className = 'dok-facet-row__label';
        label.textContent = `Pridėti „${display(typed)}“`;
        add.appendChild(label);
        add.addEventListener('click', addTyped);
        frag.appendChild(add);
      }

      for (const o of rows) frag.appendChild(makeRow(o));
      listEl.appendChild(frag);

      if (!rows.length && !canAdd) {
        const empty = document.createElement('p');
        empty.className = 'dok-facet-modal__empty';
        empty.textContent = 'Nieko nerasta.';
        listEl.appendChild(empty);
      }
    }

    async function load(optionSearch = '') {
      const mySeq = ++reqSeq;
      listEl.innerHTML = '<div class="dok-facet-modal__loading"><span class="spinner spinner-lg"></span></div>';
      // Scoped to the current query/filters (the API drops this facet's own
      // filter), so every listed value actually narrows the present results —
      // picking one never lands on 0 hits. Just uncapped vs the sidebar preview.
      const qs = new URLSearchParams(params.toString());
      qs.set('field', field);
      if (optionSearch) qs.set('optionSearch', optionSearch);
      qs.delete('page');
      try {
        const res = await fetch(`/api/dokumentaiFacet?${qs.toString()}`);
        const data = res.ok ? await res.json() : { options: [] };
        if (mySeq !== reqSeq) return;            // a newer open superseded this
        options = Array.isArray(data.options) ? data.options : [];
      } catch {
        if (mySeq !== reqSeq) return;
        options = [];
      }
      render();
    }

    facetModal.open = (opts: { field: string; param: string; title: string }) => {
      field = opts.field;
      param = opts.param;
      // Įstaigų facetas turi ilgus dvieilius (pavadinimas + kodas) įrašus —
      // kelių stulpelių grid'e jie susimaišo, todėl jį rodom vienu stulpeliu.
      listEl.classList.toggle('dok-facet-modal__list--stack', field === 'istaigaJar' || field === 'jarKodai');
      titleEl.textContent = opts.title;
      selected = new Set(getList(param));
      searchEl.value = '';
      updateCount();
      setOpen(true);
      load();
    };

    searchEl.addEventListener('input', () => {
      render();
      if (field !== 'jarKodai') return;
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => load(searchEl.value.trim()), 250);
    });
    searchEl.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const typed = normalize(searchEl.value);
      if (!typed) return;
      // Enter adds the typed value unless it's an existing option — then toggle it.
      if (options.some((o) => o.value === typed)) toggle(typed);
      else selected.add(typed);
      searchEl.value = '';
      updateCount();
      render();
    });

    modal.querySelector('[data-facet-clear]')?.addEventListener('click', () => {
      selected.clear();
      updateCount();
      render();
    });

    modal.querySelector('[data-facet-apply]')?.addEventListener('click', () => {
      setList(param, [...selected]);
      params.delete('page');
      setOpen(false);
      navigate(true);
    });
    // Backdrop / ✕ / Escape closing is handled generically by Modal.
  }
</script>
