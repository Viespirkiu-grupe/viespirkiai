---
// One /dokumentai search hit rendered as a result card. Pure markup — the list
// styles live in DokResults.astro. Derives its provenance line, target URL and
// the (de-duplicated) date/meta row from the hit.
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultCardMeta from '@design-system/components/ResultCardMeta.astro';
import type { DokumentasHit } from '../../lib/searchDokumentai.ts';
import { fmt, fmtDate, dateKey } from '../../lib/dokumentaiFormat.ts';
import { TYPE_LABEL, SOURCE_LABEL, LANG_LABEL } from '../../lib/dokumentaiLabels.ts';
import { statusasLabel, turinysLabel, variantasLabel } from '../../lib/teisesAktaiLabels.ts';
import { teisesAktoKelias } from '../../lib/teisesAktasPageData.ts';

interface Props {
  hit: DokumentasHit;
}

const { hit } = Astro.props;

const isETar = hit.source?.toLowerCase() === 'etar';
const hasInternalDetail = hit.type === 'teismoNuosprendis' || (isETar && hit.type === 'teisesAktas');
let domain = (hit.host || hit.domain || '').replace(/^www\./, '');
if (!domain && hit.url) {
  try { domain = new URL(hit.url).host.replace(/^www\./, ''); } catch { /* ignore */ }
}
// Nuosprendžių URL kelias yra ASP id — neinformatyvus, todėl jo nerodom.
const pathPart = hasInternalDetail ? '' : (hit.url ? hit.url.replace(/^https?:\/\/[^/]+/, '').replace(/^\//, '') : '');
const title = hit.title || hit.url || hit.md5 || `Dokumentas #${hit.id}`;
const externalUrl = hit.url || null;
const internalUrl = hit.type === 'teismoNuosprendis' && hit.saltinioId2
  ? `/teismoNuosprendis/${hit.saltinioId2}`
  : isETar && hit.type === 'teisesAktas' && hit.saltinioId0
    ? teisesAktoKelias(hit.saltinioId0, hit.saltinioId3 || hit.saltinioId1)
  : hit.failasId ? `/failas/${hit.failasId}` : null;
const targetUrl = internalUrl || externalUrl || '#';
const isExternal = !internalUrl && !!externalUrl;
const happened = fmtDate(hit.happenedAt);
const created = fmtDate(hit.createdAt);
const updated = fmtDate(hit.updatedAt);
const discovered = fmtDate(hit.discoveredAt);
const happenedKey = dateKey(hit.happenedAt);
const createdKey = dateKey(hit.createdAt);
const updatedKey = dateKey(hit.updatedAt);
const discoveredKey = dateKey(hit.discoveredAt);
const location = [hit.savivaldybe, hit.apskritis]
  .filter((value, index, values) => value && values.indexOf(value) === index)
  .join(', ');
const footerMetaItems: any[] = [
  hit.type && { label: 'Tipas', value: TYPE_LABEL[hit.type] || hit.type },
  hit.source && { label: 'Šaltinis', value: SOURCE_LABEL[hit.source.toLowerCase()] || hit.source, title: 'Šaltinis' },
  hit.editionType && { label: 'Redakcija', value: variantasLabel(hit.editionType) },
  hit.galiojimas && { label: 'Galiojimas', value: statusasLabel(hit.galiojimas) },
  hit.turinioBusena && { label: 'Teksto būsena', value: turinysLabel(hit.turinioBusena) },
  hit.prieme && { label: 'Priėmė', value: hit.prieme },
  hit.istaigosNr && { label: 'Įstaigos nr.', value: hit.istaigosNr },
  hit.registracijosNr && { label: 'Registracijos nr.', value: hit.registracijosNr },
  hit.extension && { label: 'Plėtinys', value: String(hit.extension).toUpperCase() },
  hit.language && { label: 'Kalba', value: LANG_LABEL[hit.language] || hit.language.toUpperCase() },
  hit.pageCount != null && hit.pageCount > 0 && { label: 'Puslapiai', value: `${fmt(hit.pageCount)} psl.` },
  hit.wordCount != null && hit.wordCount > 0 && { label: 'Žodžiai', value: `${fmt(hit.wordCount)} žodž.` },
  happened && { label: 'Data', value: happened, title: 'Dokumento data', hiddenLabel: false },
  created && createdKey !== happenedKey && { label: 'Sukurta', value: created, title: 'Sukūrimo data', hiddenLabel: false },
  updated && updatedKey !== happenedKey && updatedKey !== createdKey && { label: 'Atnaujinta', value: updated, title: 'Atnaujinimo data', hiddenLabel: false },
  discovered && discoveredKey !== happenedKey && discoveredKey !== createdKey && discoveredKey !== updatedKey && { label: 'Aptikta', value: discovered, title: 'Aptikimo data', hiddenLabel: false },
  hit.autorius && { label: 'Autorius', value: hit.autorius, title: 'Autorius' },
  location && { label: 'Vietovė', value: location, title: 'Vietovė' },
].filter(Boolean);
---

<ResultCardShell clickable={true} className="dok-card">
  <div slot="meta" class="dok-provenance">
    {domain && <span class="dok-domain">{domain}</span>}
    {pathPart && (
      <>
        <span class="dok-provenance-sep" aria-hidden="true">›</span>
        <span class="dok-path">{pathPart}</span>
      </>
    )}
  </div>
  <h3 slot="title" class="result-card-title">
    <a
      href={targetUrl}
      {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}
    >{title}</a>
  </h3>
  {hit.snippet && (
    <p class="dok-snippet text-sm text-muted mt-2" set:html={hit.snippet} />
  )}
  <ResultCardMeta slot="footer" className="dok-meta" items={footerMetaItems}>
    {hit.istaigaJar && (
      <div title={hit.istaigaPavadinimas ? `Paskelbusi įstaiga: ${hit.istaigaPavadinimas} (${hit.istaigaJar})` : `Paskelbusi įstaiga (JAR ${hit.istaigaJar})`}>
        <dt class="sr-only">Paskelbusi įstaiga</dt>
        <dd>{hit.istaigaPavadinimas || hit.istaigaJar}</dd>
      </div>
    )}
  </ResultCardMeta>
</ResultCardShell>
