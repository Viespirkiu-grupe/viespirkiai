---
import type { DokumentaiStats } from '../../lib/searchDokumentai.ts';
import {
  buildDokumentaiUrl,
  toggleValue,
  type DokumentaiUrlState,
} from '../../lib/dokumentaiUrl.ts';
import { fmt, fmtCompact } from '../../lib/dokumentaiFormat.ts';
import { SOURCE_LABEL } from '../../lib/dokumentaiLabels.ts';
import BarList from '@design-system/components/BarList.astro';
import StatChip from '@design-system/components/StatChip.astro';
import TimelineColumnChart from '@design-system/components/charts/TimelineColumnChart.astro';
import SegmentedBar from '@design-system/components/charts/SegmentedBar.astro';
import Linksnis from '@design-system/components/Linksnis.astro';
import { linksniuotiOnly } from '@/utils/linksniai.js';

interface Props {
  stats: DokumentaiStats;
  urlState: DokumentaiUrlState;
}

const { stats, urlState } = Astro.props;

// Statistikos skydelyje tipus rodom daugiskaita (skiriasi nuo bendro
// vienaskaitos TYPE_LABEL rezultatų kortelėse).
const TYPE_LABEL: Record<string, string> = {
  crawledPage: 'Tinklalapiai',
  failas: 'Failai',
  teisesAktas: 'Teisės aktai',
  teisesAktoProjektas: 'Teisės aktų projektai',
  teismoNuosprendis: 'Teismo nuosprendžiai',
};

const typeUrl = (v: string) => buildDokumentaiUrl(urlState, { type: toggleValue(urlState.type, v) });
const sourceUrl = (v: string) => buildDokumentaiUrl(urlState, { source: toggleValue(urlState.source, v) });
const istaigaUrl = (v: string) => buildDokumentaiUrl(urlState, { istaiga: toggleValue(urlState.istaiga, v) });

// ── Timeline ────────────────────────────────────────────────────────────────
// Interactive column chart over years. Each bar carries its target height as a
// CSS var (scaleY animates in, correct with JS off) and is a link that filters
// the search to that year. Hover/focus drives a live readout (wired in the
// script below); the active (filtered) year, if any, is emphasised.
const timeline = stats.timeline;
const tlFirst = timeline[0]?.year;
const tlLast = timeline[timeline.length - 1]?.year;
const tlByYear = new Map(timeline.map((t) => [t.year, t.count]));
// Piko/aktyvumo emphazę bei rodmenį apskaičiuoja pats TimelineColumnChart; čia
// tik nustatom, kurie metai aktyvūs (filtruoti), kad pažymėtume stulpelius.
const activeYears = new Set(stats.activeYears.filter((y) => tlByYear.has(y)));
const yearUrl = (year: number) => buildDokumentaiUrl(urlState, { metai: toggleValue(urlState.metai, String(year)) });

// ── Composition by type ───────────────────────────────────────────────────────
// Segmented bar + legend. Widths are shares of the shown types; the legend also
// reports each share of the whole selection.
const typeShown = stats.byType.filter((t) => (t.count ?? 0) > 0).slice(0, 6);
const total = Math.max(1, stats.total);

// ── Reach metrics ─────────────────────────────────────────────────────────────
// Compact stat cells, each shown only when it carries signal.
const span = tlFirst != null && tlLast != null
  ? (tlFirst === tlLast ? String(tlFirst) : `${tlFirst}–${tlLast}`)
  : null;
const metrics = [
  stats.uniqIstaiga > 0 && { label: 'Įstaigų', value: fmtCompact(stats.uniqIstaiga), approx: true },
  stats.uniqHost > 1 && { label: 'Svetainių', value: fmtCompact(stats.uniqHost), approx: true },
  span && { label: 'Laikotarpis', value: span, approx: false },
  stats.wordsMetric && { label: 'Žodžių (mediana)', value: fmtCompact(stats.wordsMetric.median), approx: false },
].filter(Boolean) as { label: string; value: string; approx: boolean }[];

// ── Top agencies ──────────────────────────────────────────────────────────────
const topIstaiga = stats.topIstaiga.filter((i) => (i.count ?? 0) > 0).slice(0, 6);

const hasBody = timeline.length > 0 || typeShown.length > 0 || topIstaiga.length > 0 || metrics.length > 0;

// Paruošti duomenys generiniams grafikams (TimelineColumnChart / SegmentedBar).
const timelineBars = timeline.map((t) => ({
  label: t.year,
  count: t.count,
  countText: fmtCompact(t.count),
  href: yearUrl(t.year),
  active: activeYears.has(t.year),
  ariaLabel: `${t.year}: ${fmt(t.count)} ${linksniuotiOnly(t.count, ['dokumentas', 'dokumentai', 'dokumentų', 'dokumento'])}${activeYears.has(t.year) ? ' (pasirinkta)' : ''}`,
}));
const typeSegments = typeShown.map((t) => ({
  label: TYPE_LABEL[t.value] || t.value,
  value: t.count ?? 0,
  href: typeUrl(t.value),
  title: `${TYPE_LABEL[t.value] || t.value}: ${fmt(t.count)}`,
  pctText: `${Math.round(((t.count ?? 0) / total) * 100)}%`,
  countText: fmtCompact(t.count),
}));
---

{hasBody && (
  <aside class="dok-stats" aria-label="Atrankos statistinė analizė">
    <header class="dok-stats__head">
      <div class="dok-stats__hero">
        <span class="dok-stats__hero-num">{fmtCompact(stats.total)}</span>
        <span class="dok-stats__hero-unit"><Linksnis n={stats.total} forms={['dokumentas', 'dokumentai', 'dokumentų', 'dokumento']} showNumber={false} /></span>
      </div>
      {(stats.totalPages > 0 || stats.totalWords > 0) && (
        <p class="dok-stats__hero-sub">
          {stats.totalPages > 0 && <span><strong>{fmtCompact(stats.totalPages)}</strong> psl.</span>}
          {stats.totalPages > 0 && stats.totalWords > 0 && <span class="dok-stats__dot" aria-hidden="true"></span>}
          {stats.totalWords > 0 && <span><strong>{fmtCompact(stats.totalWords)}</strong> žodž.</span>}
        </p>
      )}
    </header>

    {metrics.length > 0 && (
      <div class="dok-stats__metrics">
        {metrics.map((m) => (
          <div class="dok-stats__metric">
            <span class="dok-stats__metric-val">{m.approx && <i aria-hidden="true">~</i>}{m.value}</span>
            <span class="dok-stats__metric-lbl">{m.label}</span>
          </div>
        ))}
      </div>
    )}

    {timeline.length > 1 && (
      <section class="dok-stats__block">
        <TimelineColumnChart title="Pagal metus" bars={timelineBars} />
      </section>
    )}

    {typeShown.length > 1 && (
      <section class="dok-stats__block">
        <h3 class="dok-stats__h">Pasiskirstymas pagal tipą</h3>
        <SegmentedBar segments={typeSegments} ariaLabel="Tipų pasiskirstymas" />
      </section>
    )}

    {topIstaiga.length > 0 && (
      <section class="dok-stats__block">
        <h3 class="dok-stats__h">Aktyviausios įstaigos</h3>
        <BarList
          items={topIstaiga.map((it) => ({
            label: it.label || it.value,
            value: it.count ?? 0,
            href: istaigaUrl(it.value),
            title: it.label ? `${it.label} (${it.value})` : it.value,
          }))}
          formatValue={fmtCompact}
        />
      </section>
    )}

    {stats.bySource.length > 1 && (
      <section class="dok-stats__block">
        <h3 class="dok-stats__h">Šaltiniai</h3>
        <div class="dok-stats__chips">
          {stats.bySource.slice(0, 8).map((s) => (
            <StatChip href={sourceUrl(s.value)} label={SOURCE_LABEL[s.value.toLowerCase()] || s.value} count={fmtCompact(s.count)} />
          ))}
        </div>
      </section>
    )}
  </aside>
)}

<style>
  .dok-stats {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding: 20px;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .dok-stats__head { display: flex; flex-direction: column; gap: 8px; }
  .dok-stats__eyebrow {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--gray);
  }
  .dok-stats__hero {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .dok-stats__hero-num {
    font-size: clamp(28px, 6vw, 38px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--black);
    font-variant-numeric: tabular-nums;
  }
  .dok-stats__hero-unit { font-size: var(--text-sm); color: var(--gray); }
  .dok-stats__hero-sub {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--gray);
  }
  .dok-stats__hero-sub strong { color: var(--dark-gray); font-weight: 600; font-variant-numeric: tabular-nums; }
  .dok-stats__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--light-gray); }

  .dok-stats__h {
    margin: 0 0 12px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--gray);
  }

  /* Reach metric cells */
  .dok-stats__metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--light-gray);
    border: 1px solid var(--light-gray);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .dok-stats__metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 14px;
    background: var(--white);
  }
  .dok-stats__metric-val {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--black);
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
  }
  .dok-stats__metric-val i { color: var(--gray); font-style: normal; font-weight: 500; margin-right: 1px; }
  .dok-stats__metric-lbl {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--gray);
  }

  /* Source chips */
  .dok-stats__chips { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
