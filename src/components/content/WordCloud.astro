---
interface WordCloudItem {
  label: string;
  size: number;
  rotation: number;
}

interface Props {
  items: WordCloudItem[];
}

const { items } = Astro.props;
---

<div class="word-cloud">
  {items.map((item) => (
    <span style={`--size:${item.size}; --r:${item.rotation}`}>{item.label}</span>
  ))}
</div>
