---
import DateValue from '@design-system/components/DateValue.astro';
import EntityLink from '@design-system/components/EntityLink.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultCardFooter from '@design-system/components/ResultCardFooter.astro';
import ResultCardMeta from '@design-system/components/ResultCardMeta.astro';

interface SutartisCardItem {
  tipas: string;
  kategorija: string;
  sudarymoData?: string | null;
  galiojimoData?: string | null;
  dokumentuKiekis?: number | null;
  sutartiesUnikalusId: string | number;
  faktineIvykdimoVerte?: number | string | null;
  verte?: number | string | null;
  pavadinimas: string;
  perkanciosiosOrganizacijosKodas?: string;
  perkanciojiOrganizacija?: string | null;
  tiekejai?: string[];
  tiekejaiKodai?: string[];
  tiekejas?: string | null;
  tiekejoKodas?: string | null;
  paskutinioRedagavimoData?: string | null;
}

interface Props {
  item: SutartisCardItem;
  showRedagavimoData?: boolean;
}

const { item, showRedagavimoData = true } = Astro.props;

const tiekejai = item.tiekejai && item.tiekejai.length > 0
  ? item.tiekejai
  : (item.tiekejas != null ? [item.tiekejas] : []);
const tiekejaiKodai = item.tiekejaiKodai && item.tiekejaiKodai.length > 0
  ? item.tiekejaiKodai
  : (item.tiekejoKodas != null ? [item.tiekejoKodas] : []);

const truncate = (s: string | null | undefined, n = 80) => {
  const v = s || '';
  return v.length > n ? v.slice(0, n) + '…' : v;
};

const verte = Number(item.faktineIvykdimoVerte || item.verte);
const sudaryta = item.sudarymoData ? String(item.sudarymoData).slice(0, 10) : '';
const galioja = item.galiojimoData ? String(item.galiojimoData).slice(0, 10) : '';
const metaItems = [
  { label: 'Tipas', value: item.tipas },
  { label: 'Kategorija', value: item.kategorija },
].filter((meta) => meta.value);
---

<ResultCardShell clickable={true}>
  <ResultCardMeta slot="meta" items={metaItems}>
    <div>
      <dt class="sr-only">Sutarties galiojimas</dt>
      <dd>
        <abbr aria-hidden="true" title="Sutarties galiojimas" class="relative z-1">Sut.</abbr>
        {sudaryta && galioja
          ? <><DateValue value={item.sudarymoData} />{sudaryta !== galioja && <> – <DateValue value={item.galiojimoData} /></>}</>
          : '—'
        }
      </dd>
    </div>
    {(item.dokumentuKiekis ?? 0) > 0 && (
      <div>
        <dt class="sr-only">Dokumentai</dt>
        <dd>{item.dokumentuKiekis} <abbr aria-hidden="true" title="Dokumentai" class="relative z-1">dok.</abbr></dd>
      </div>
    )}
  </ResultCardMeta>

  <div slot="title" class="flex align-baseline gap-3">
    <h3 class="result-card-title">
      <a href={`/sutartis/${item.sutartiesUnikalusId}`}>
        <span class={`amount${verte > 10000 ? ' font-bold' : ''}`}>
          <MoneyValue value={verte} suffix={'\u00A0€'} mono={false} />
        </span>
        {item.pavadinimas.length < 1 ? <em>Nenurodyta</em> : item.pavadinimas}
      </a>
    </h3>
  </div>

  <ResultCardFooter slot="footer">
    {item.perkanciosiosOrganizacijosKodas && (
      <span>
        <strong>Pirkėjas:</strong>
        <EntityLink kodas={item.perkanciosiosOrganizacijosKodas} label={truncate(item.perkanciojiOrganizacija)} className="relative z-1" />
      </span>
    )}
    {tiekejai.length === 1
      ? <span>
          <strong>Tiekėjas:</strong>
          <EntityLink kodas={tiekejaiKodai[0]} label={truncate(tiekejai[0] || 'Nenurodytas')} className="relative z-1" />
        </span>
      : tiekejai.length > 1 && (
          <span class="flex align-start gap-2">
            <strong>Tiekėjai:</strong>
            <span class="flex flex-col gap-1">
              {tiekejai.map((t, i) => (
                <EntityLink kodas={tiekejaiKodai[i]} label={truncate(t || 'Nenurodytas')} className="relative z-1" />
              ))}
            </span>
          </span>
        )
    }
  </ResultCardFooter>

  {showRedagavimoData && (
    <div slot="after-footer" class="text-muted text-sm mt-4">
      {item.paskutinioRedagavimoData
        ? <time datetime={item.paskutinioRedagavimoData}>{item.paskutinioRedagavimoData}</time>
        : '—'
      }
    </div>
  )}
</ResultCardShell>
