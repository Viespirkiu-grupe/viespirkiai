---
import FilterGroup from '../filters/FilterGroup.astro';
import NumberRangeFilter from '../filters/NumberRangeFilter.astro';
import TextInput from '../inputs/TextInput.astro';

interface Props {
  values: Record<string, string | undefined>;
}

const { values } = Astro.props;

const saltinisOptions = [
  { value: 'sutartys', label: 'Sutartys' },
  { value: 'neskelbiamosDerybos', label: 'Neskelbiamos derybos' },
  { value: 'cvpIs', label: 'Viešieji pirkimai' },
  { value: 'cvpp', label: 'CVPP viešieji pirkimai' },
  { value: 'mvpAprasai', label: 'MVP tvarkos aprašai' },
  { value: 'archive', label: 'Failas archyvo viduje' },
];
---

<div class="search-filters-grid">
  <FilterGroup legend="Failas">
    <TextInput label="Extension" name="extension" placeholder="Visi" values={values} />
    <TextInput label="MD5" name="md5" placeholder="d41d8cd98..." values={values} />
    <div class="form-group">
      <label class="form-label" for="saltinis">Šaltinis</label>
      <select name="saltinis" id="saltinis" class="form-control">
        <option value="" selected={!values.saltinis}>Visi</option>
        {saltinisOptions.map(opt => (
          <option value={opt.value} selected={values.saltinis === opt.value}>{opt.label}</option>
        ))}
      </select>
    </div>
  </FilterGroup>

  <NumberRangeFilter
    legend="Puslapių skaičius"
    nameFrom="puslapiaiMin"
    nameTo="puslapiaiMax"
    values={values}
  />

  <FilterGroup legend="Turinys" class="col-span-2 max-sm:col-span-1 items-start justify-start">
    <div class="search-filters-grid grid-cols-3 w-fit gap-3 [&_.form-group]:mb-0 max-sm:grid-cols-2">
      <TextInput label="Tel. numeris" name="telefonas" placeholder="+37060000000" values={values} />
      <TextInput label="El. paštas" name="email" placeholder="viespirkiai@viespirkiai.org" values={values} />
      <TextInput label="Domenas" name="domain" placeholder="viespirkiai.org" values={values} />
      <TextInput label="IBAN numeris" name="iban" placeholder="LT0000000000..." values={values} />
      <TextInput label="JAR kodas" name="jarKodas" placeholder="000000000" values={values} />
    </div>
  </FilterGroup>
</div>
