---
interface Props {
  value: string;
  buttonId: string;
  buttonLabel?: string;
}

const { value, buttonId, buttonLabel = 'Kopijuoti' } = Astro.props;
---

<div class="inline-flex border rounded-lg bg-light max-w-full">
  <code class="px-4 py-3 border-none bg-transparent overflow-auto">{value}</code>
  <button
    id={buttonId}
    class="btn btn-primary rounded-0 border-0 border-l-border rounded-r-lg"
    type="button"
  >
    {buttonLabel}
  </button>
</div>
