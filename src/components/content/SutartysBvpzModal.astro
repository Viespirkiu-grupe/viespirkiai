---
// Sutarčių BVPŽ „Daugiau" dialogas — plonas apvalkalas virš bendro
// BvpzFacetTreeModal su /sutartys specifine konfigūracija. Greiti pasirinkimai
// bendri (žr. BvpzFacetTreeModal DEFAULT_PRESETS).
import BvpzFacetTreeModal from './BvpzFacetTreeModal.astro';
---

<BvpzFacetTreeModal
  modalId="sutBvpzModal"
  instanceId="sutBvpzTree"
  param="bvpzPrefiksasKitas"
  hiddenParam="bvpzPrefiksas"
  redirectBase="/"
  facetEndpoint="/api/sutartysFacet"
  facetTriggerSelector='.sut-facets [data-facet-modal="bvpzKodai"]'
/>
