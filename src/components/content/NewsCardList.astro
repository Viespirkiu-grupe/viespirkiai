---
interface NewsCardItem {
  href: string;
  title: string;
  source: string;
  date: string;
  relatedHref?: string;
  relatedLabel?: string;
}

interface Props {
  title?: string;
  items: NewsCardItem[];
  titleTag?: 'h2' | 'h3';
}

const { title, items, titleTag = 'h2' } = Astro.props;
const TitleTag = titleTag;
---

<section>
  {title && <TitleTag>{title}</TitleTag>}

  <div class="result-list">
    {items.map((item) => (
      <article class="result-card card-clickable">
        <div class="result-card-body">
          <div class="result-card-meta">
            <span>{item.source}</span>
            <span>{item.date}</span>
            {item.relatedHref ? (
              <span>
                <a href={item.relatedHref} class="relative z-1">
                  {item.relatedLabel || 'Susijęs'}
                  <span class="sr-only">(PDF)</span>
                </a>
              </span>
            ) : (
              <span>{item.relatedLabel || ''}</span>
            )}
          </div>

          <h3 class="result-card-title">
            <a href={item.href}>{item.title}</a>
          </h3>
        </div>
      </article>
    ))}
  </div>
</section>