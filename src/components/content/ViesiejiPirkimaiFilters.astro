---
import FilterGroup from '@design-system/components/filters/FilterGroup.astro';
import DateRangeFilter from '@design-system/components/filters/DateRangeFilter.astro';
import NumberRangeFilter from '@design-system/components/filters/NumberRangeFilter.astro';
import SortFilter from '@design-system/components/filters/SortFilter.astro';
import Link from '@design-system/components/Link.astro';
import SelectInput from '@design-system/components/inputs/SelectInput.astro';
import TextInput from '@design-system/components/inputs/TextInput.astro';
import { STATUSAS, PIRKIMO_BUDAS } from '@/modules/viesiejiPirkimai/viesiejiPirkimaiEnums.js';

interface Props {
  values: Record<string, string | number | undefined>;
}

const { values } = Astro.props;

const sortOptions = [
  { value: 'paskelbimoData', label: 'Paskelbimo data' },
  { value: 'pasiulymuPateikimoTerminas', label: 'Pasiūlymų terminas' },
  { value: 'numatomaBendraPirkimoVerte', label: 'Vertė' },
];
---

<div class="search-filters-grid">
  <FilterGroup legend="Pirkimas">
    <TextInput label="Vykdytojo kodas" name="pvJarKodas" placeholder="Nenurodyta" values={values} />
    <TextInput label="Pirkimo ID" name="pirkimoId" placeholder="Nenurodyta" values={values} />
  </FilterGroup>

  <DateRangeFilter
    legend="Paskelbimo data"
    nameFrom="paskelbimoDataNuo"
    nameTo="paskelbimoDataIki"
    labelFrom="Paskelbta nuo"
    labelTo="Paskelbta iki"
    values={values}
  />

  <DateRangeFilter
    legend="Pasiūlymų terminas"
    nameFrom="pasiulymuTerminasNuo"
    nameTo="pasiulymuTerminasIki"
    labelFrom="Terminas nuo"
    labelTo="Terminas iki"
    values={values}
  />

  <NumberRangeFilter
    legend="Numatoma vertė"
    nameFrom="verteNuo"
    nameTo="verteIki"
    labelFrom="Numatoma vertė nuo"
    labelTo="Numatoma vertė iki"
    placeholderFrom="0 €"
    placeholderTo="∞ €"
    values={values}
  />

  <FilterGroup legend="Klasifikacija">
    <SelectInput
      label="Pirkimo būdas"
      name="pirkimoBudas"
      options={Object.entries(PIRKIMO_BUDAS).map(([value, label]) => ({ value, label: label as string }))}
      values={values}
      placeholder="Visi"
    />
    <SelectInput
      label="Statusas"
      name="statusas"
      options={Object.entries(STATUSAS).map(([value, label]) => ({ value, label: label as string }))}
      values={values}
      placeholder="Visi"
    />
  </FilterGroup>

  <SortFilter
    options={sortOptions}
    values={values}
    defaultValue="paskelbimoData"
    includeBlank={false}
  />

  <FilterGroup legend="Kodai" class="justify-start">
    <div>
      <TextInput label="BVPŽ prefiksai" name="bvpzPrefiksai" placeholder="Visi" values={values} />
      <Link href="/bvpz" className="text-sm">Žr. BVPŽ</Link>
    </div>
  </FilterGroup>
</div>
