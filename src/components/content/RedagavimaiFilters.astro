---
// /sutartys/redagavimai šoninė juosta. Tas pats šablonas kaip /dokumentai:
// paprastas stulpelis su DokFacetSection facetų sekcijomis (jos atsineša ir
// savo stilius), o tekstiniai laukai – tos pačios `dok-input` formos.
//
// Facetai yra nuorodos, ne forma: veikia be JS, o skaičiai ateina iš
// vpmSutartys."changes" materializuotos santraukos (002 migracija).
import DokFacetSection from '../dokumentai/DokFacetSection.astro';
import type { FacetOption } from '../../lib/dokumentai/search/types.ts';
import type {
  RedagavimuFacetai,
  RedagavimuFiltras,
  Rikiavimas,
} from '../../lib/sutartisPakeitimai.ts';
import {
  filtroNuoroda,
  filtroParams,
  laukoNuoroda,
} from '../../lib/sutartisPakeitimai.ts';

interface Props {
  filtras: RedagavimuFiltras;
  rikiavimas: Rikiavimas;
  facetai: RedagavimuFacetai;
  filtruota: boolean;
}

const { filtras, rikiavimas, facetai, filtruota } = Astro.props;

const CLEAR_URL = '/sutartys/redagavimai';

// Facetų eilutėms reikia value/count poros; pavadinimą duoda formatLabel.
const opt = (reiksme: string, kiek: number | null = null): FacetOption =>
  ({ value: reiksme, count: kiek });

const laukuLabels = new Map(facetai.laukai.map((o) => [o.reiksme, o.label]));

const MATOMU_LAUKU = 8;
const visiLaukai = facetai.laukai.map((o) => opt(o.reiksme, o.kiek));
const matomi = visiLaukai.slice(0, MATOMU_LAUKU);
const paslepti = visiLaukai.slice(MATOMU_LAUKU);
// Pažymėtas laukas visada matomas – kitaip atrodytų, kad filtro nėra.
const pasirinktiPaslepti = paslepti.filter((o) => filtras.laukai.includes(o.value));

// Vienareikšmiai facetai: paspaudus tą pačią reikšmę – nuimama, „Visos" – valo.
const busenosNuoroda = (value: string) =>
  filtroNuoroda(filtras, rikiavimas, {
    busena: !value || value === filtras.busena
      ? null
      : (value as RedagavimuFiltras['busena']),
  });

const vertesNuoroda = (value: string) =>
  filtroNuoroda(filtras, rikiavimas, {
    verte: !value || value === filtras.verte
      ? null
      : (value as RedagavimuFiltras['verte']),
  });

const triuksmoNuoroda = () => filtroNuoroda(filtras, rikiavimas, { visi: !filtras.visi });

/** Formos laukams – dabartinė būsena, be to lauko, kurį forma keičia. */
const paslepti_laukai = (isskyrus: string[]): { name: string; value: string }[] =>
  [...filtroParams(filtras, rikiavimas).entries()]
    .filter(([name]) => !isskyrus.includes(name))
    .map(([name, value]) => ({ name, value }));

const aktyviuSkaicius = filtras.laukai.length
  + [filtras.busena, filtras.verte, filtras.verteMin, filtras.nuo, filtras.iki]
      .filter(Boolean).length
  + (filtras.visi ? 1 : 0);
---

<aside class="dok-sidebar redagavimai-sidebar" id="redagavimaiSidebar" aria-label="Filtrai">
  <div class="dok-sidebar-head">
    <button
      type="button"
      class="dok-sidebar-title"
      id="redagavimaiFiltruToggle"
      aria-expanded="false"
      aria-controls="redagavimaiFiltruBody"
    >
      <span class="sr-only">Filtrai</span>
      {aktyviuSkaicius > 0 && <span class="dok-filters-count">{aktyviuSkaicius}</span>}
      <span class="dok-filters-chevron" aria-hidden="true"></span>
    </button>
    {filtruota && <a href={CLEAR_URL} class="dok-sidebar-clear">Panaikinti</a>}
  </div>

  <div class="dok-filters-body" id="redagavimaiFiltruBody">
    <DokFacetSection
      label="Kas pasikeitė"
      param="laukas"
      facet={{
        filter: filtras.laukai,
        visible: [...matomi, ...pasirinktiPaslepti],
        hidden: paslepti.filter((o) => !filtras.laukai.includes(o.value)),
        toggleUrl: (value: string) => laukoNuoroda(filtras, rikiavimas, value),
      }}
      formatLabel={(value: string) => laukuLabels.get(value) ?? value}
    />

    {facetai.busenos.length > 0 && (
      <DokFacetSection
        label="Sutarties būsena"
        param="busena"
        allLabel="Visos"
        facet={{
          filter: filtras.busena ? [filtras.busena] : [],
          visible: facetai.busenos.map((o) => opt(o.reiksme, o.kiek)),
          toggleUrl: busenosNuoroda,
        }}
        formatLabel={(value: string) =>
          facetai.busenos.find((o) => o.reiksme === value)?.label ?? value}
      />
    )}

    {facetai.vertesKryptis.length > 0 && (
      <DokFacetSection
        label="Vertės pokytis"
        param="verte"
        allLabel="Bet koks"
        facet={{
          filter: filtras.verte ? [filtras.verte] : [],
          visible: facetai.vertesKryptis.map((o) => opt(o.reiksme, o.kiek)),
          toggleUrl: vertesNuoroda,
        }}
        formatLabel={(value: string) =>
          facetai.vertesKryptis.find((o) => o.reiksme === value)?.label ?? value}
      />
    )}

    {/* Riba stovi prie pačios krypties – tai to paties filtro tikslinimas. */}
    <section class="dok-filter-section redagavimai-riba">
      <form class="dok-input-form" method="get" action={CLEAR_URL} autocomplete="off">
        {paslepti_laukai(['verteMin']).map((paslepta) => (
          <input type="hidden" name={paslepta.name} value={paslepta.value} />
        ))}
        <input
          type="text"
          class="dok-input"
          name="verteMin"
          value={filtras.verteMin ? String(filtras.verteMin) : ''}
          placeholder="Pokytis bent, €"
          aria-label="Vertės pokytis bent (€)"
        />
        <button type="submit" class="dok-input-btn" aria-label="Taikyti">→</button>
      </form>
    </section>

    <DokFacetSection
      label="Triukšmas"
      param="visi"
      facet={{
        filter: filtras.visi ? ['1'] : [],
        visible: [opt('1', facetai.nereiksmingi)],
        toggleUrl: triuksmoNuoroda,
      }}
      formatLabel={() => 'Rodyti ir techninius'}
    />
    <p class="redagavimai-pastaba">
      Techniniai – tie, kuriuose pasikeitė vien šaltinio redagavimo data,
      o pati sutartis liko tokia pati.
    </p>

    <section class="dok-filter-section">
      <span class="dok-filter-section-label">Laikotarpis</span>
      <form class="dok-date-form" method="get" action={CLEAR_URL} autocomplete="off">
        {paslepti_laukai(['nuo', 'iki']).map((laukas) => (
          <input type="hidden" name={laukas.name} value={laukas.value} />
        ))}
        <label>
          <span>Nuo</span>
          <input type="date" class="dok-input" name="nuo" value={filtras.nuo ?? ''} aria-label="Pastebėta nuo" />
        </label>
        <label>
          <span>Iki</span>
          <input type="date" class="dok-input" name="iki" value={filtras.iki ?? ''} aria-label="Pastebėta iki" />
        </label>
        <button type="submit" class="dok-input-btn" aria-label="Taikyti laikotarpį">→</button>
      </form>
    </section>

    <slot />
  </div>
</aside>

<style is:global>
  /* Juostos apvalkalas – tas pats, ką turi /dokumentai (DokFilters), tik be
     ten esančių facetų katalogo dalykų. */
  .redagavimai-sidebar {
    grid-area: sidebar;
    padding: 24px 20px 24px 0;
  }
  .redagavimai-sidebar .dok-filters-body > .dok-filter-section:first-child {
    padding-top: 0;
  }

  /* Galvutė – tas pats apvalkalas kaip DokFilters: desktope tik „Panaikinti",
     mobiliajame antraštė virsta mygtuku su aktyvių filtrų skaičiumi. */
  .redagavimai-sidebar .dok-sidebar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    min-height: 0;
  }
  .redagavimai-sidebar .dok-sidebar-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--dark-gray);
    cursor: default;
  }
  .redagavimai-sidebar .dok-filters-count {
    display: none;   /* matomas tik mobiliajame, kur filtrai suskleisti */
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--radius-pill);
    background: var(--black);
    color: var(--white);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0;
  }
  .redagavimai-sidebar .dok-filters-chevron { display: none; }
  .redagavimai-sidebar .dok-filters-chevron::before {
    content: "▾";
    font-size: 11px;
  }
  .redagavimai-sidebar .dok-sidebar-clear {
    font-size: var(--text-xs);
    color: var(--dark-gray);
  }
  .redagavimai-sidebar .dok-sidebar-clear:hover { color: var(--black); }
  /* Datų forma – tos pačios taisyklės kaip DokFilters (jos gyvena ten pat, kur
     naudojamos, tad čia pakartojamos, o ne importuojamos). */
  .redagavimai-sidebar .dok-date-form {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: end;
    gap: 6px;
  }
  .redagavimai-sidebar .dok-date-form label { min-width: 0; }
  .redagavimai-sidebar .dok-date-form label span {
    display: block;
    margin-bottom: 3px;
    color: var(--gray);
    font-size: var(--text-xs);
  }
  .redagavimai-sidebar .dok-date-form .dok-input { width: 100%; min-width: 0; }

  /* Riba – ne atskira sekcija, o „Vertės pokyčio" tęsinys, tad be viršutinio
     sekcijų tarpo. */
  .redagavimai-sidebar .redagavimai-riba {
    padding-top: 8px;
  }

  .redagavimai-pastaba {
    margin: 8px 0 0;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    /* Siaurame ekrane filtrai suskleisti, kad rezultatai liktų viršuje. */
    .redagavimai-sidebar {
      padding: 0;
      margin-top: 4px;
      border-bottom: var(--border);
    }
    .redagavimai-sidebar .dok-sidebar-head {
      align-items: center;
    }
    .redagavimai-sidebar .dok-sidebar-title {
      cursor: pointer;
      padding: 12px 0;
    }
    /* Suskleistoje juostoje vien „▾" nieko nepasako – čia, kitaip nei
       /dokumentai, virš jos nėra paieškos laukelio, tad užrašas rodomas. */
    .redagavimai-sidebar .dok-sidebar-title .sr-only {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      clip-path: none;
      white-space: nowrap;
    }
    .redagavimai-sidebar .dok-filters-chevron {
      display: inline-flex;
      transition: transform var(--transition);
    }
    .redagavimai-sidebar .dok-filters-count { display: inline-flex; }
    .redagavimai-sidebar.is-open .dok-filters-chevron { transform: rotate(180deg); }
    .redagavimai-sidebar .dok-filters-body {
      box-sizing: border-box;
      height: 0;
      overflow: hidden;
      transition: height 0.4s ease;
    }
    .redagavimai-sidebar.is-open .dok-filters-body {
      height: auto;
      padding-bottom: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .redagavimai-sidebar .dok-filters-body { transition: none; }
  }
</style>

<script>
  // Elgsena – tos pačios dvi vietos, ką /dokumentai daro dokumentaiFilters.ts
  // (viso to modulio krauti negalima: jis kabinasi ant /dokumentai paieškos
  // formos, žemėlapio ir facetų modalo, kurių čia nėra).
  const sidebar = document.getElementById('redagavimaiSidebar');

  // 1. Mobilus juostos atidarymas.
  const toggle = document.getElementById('redagavimaiFiltruToggle');
  toggle?.addEventListener('click', () => {
    const open = sidebar?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // 2. „Rodyti daugiau" – atskleidžia likusius facetus (be modalo varianto).
  sidebar?.querySelectorAll<HTMLButtonElement>('.dok-more-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const more = btn.previousElementSibling as HTMLElement | null;
      if (!more?.classList.contains('dok-more-list')) return;
      more.hidden = false;
      btn.remove();
    });
  });
</script>
