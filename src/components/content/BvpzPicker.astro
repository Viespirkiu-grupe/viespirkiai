---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import '@design-system/foundation/bvpz.css';

interface Preset {
  label: string;
  codes: string;
}

interface SearchTarget {
  label: string;
  value: string;
}

interface Props {
  presets: Preset[];
  searchTargets?: SearchTarget[];
  treeUrl?: string;
  instanceId?: string;
  initialCodes?: string;
  syncInputId?: string;
  clearInputId?: string;
  syncButtonLabel?: string;
  actionBarMode?: 'fixed' | 'sticky' | 'attached';
  showPresets?: boolean;
  showManualInput?: boolean;
  /** Kai false — CPV medžio JSON (didelis) neužkraunamas iškart; užkraunama
   *  gavus `bvpz:load` įvykį ant šakninio elemento (lazy — pvz. dialoge). */
  autoLoad?: boolean;
}

const cpvJsonPath = fileURLToPath(new URL('../../../public/dist/cpv.json', import.meta.url));
const cpvJsonVersion = createHash('md5').update(readFileSync(cpvJsonPath)).digest('hex');
const defaultTreeUrl = `/bvpz/cpv.json?v=${cpvJsonVersion}`;

const {
  presets,
  searchTargets = [],
  treeUrl = defaultTreeUrl,
  instanceId = 'bvpz-picker',
  initialCodes = '',
  syncInputId,
  clearInputId,
  syncButtonLabel = 'Naudoti',
  actionBarMode = 'fixed',
  showPresets = true,
  showManualInput = true,
  autoLoad = true,
} = Astro.props;

const rootId = `${instanceId}-root`;
const treeId = `${instanceId}-tree`;
const searchInputId = `${instanceId}-search-input`;
const searchClearId = `${instanceId}-search-clear`;
const resultsInfoId = `${instanceId}-results-info`;
const selectedCodesId = `${instanceId}-selected-codes`;
const searchBtnId = `${instanceId}-search-btn`;
const searchDropdownId = `${instanceId}-search-dropdown`;
const copyBtnId = `${instanceId}-copy-btn`;
const manualInputId = `${instanceId}-manual-input`;
const applyManualBtnId = `${instanceId}-apply-manual`;
const syncBtnId = `${instanceId}-sync-btn`;
---

<div
  class:list={['bvpz-picker', actionBarMode === 'attached' && 'bvpz-picker-attached']}
  id={rootId}
  data-sync-input-id={syncInputId ?? ''}
  data-clear-input-id={clearInputId ?? ''}
>
  {showPresets && presets.length > 0 && (
    <>
      <div class="text-muted text-sm mb-2 self-center">Greiti pasirinkimai:</div>
      <div class="flex flex-wrap gap-2 mb-4">
        {presets.map((preset) => (
          <button class="btn btn-outline btn-sm" type="button" data-bvpz-preset={preset.codes}>
            {preset.label}
          </button>
        ))}
      </div>
    </>
  )}

  {showManualInput && <div class="bvpz-manual mb-4">
    <label class="form-label" for={manualInputId}>BVPŽ prefiksai</label>
    <div class="bvpz-manual-row">
      <input
        id={manualInputId}
        class="form-control"
        type="text"
        inputmode="numeric"
        placeholder="Pvz. 48 72 3360"
        value={initialCodes}
      />
      <button class="btn btn-outline" id={applyManualBtnId} type="button">Pritaikyti</button>
    </div>
  </div>}

  <div class="search-bar bvpz-search mb-3">
    <label for={searchInputId}>
      <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
      </svg>
      <span class="sr-only">Paieška</span>
    </label>
    <input
      id={searchInputId}
      class="search-bar__input"
      type="search"
      autocomplete="off"
      enterkeyhint="search"
      placeholder="Ieškoti kodo arba pavadinimo…"
    />
    <button class="bvpz-search-clear" id={searchClearId} type="button" aria-label="Išvalyti paiešką" hidden>×</button>
  </div>

  <div id={resultsInfoId} class="cpv-results-info text-muted text-sm mb-2" hidden></div>

  <div id={treeId} class="cpv-tree loading mb-4">
    <span class="spinner spinner-xl"></span>
  </div>

  {/* Dokas — vieta, kurioje juosta atsisėda pasiekus sąrašo pabaigą. Iki tol ji
      kabo ekrano apačioje (`is-floating`), o dokas laiko jos aukščio tarpą. */}
  <div class:list={[actionBarMode === 'fixed' && 'action-bar-dock']}>
  <div class:list={['action-bar', actionBarMode === 'sticky' && 'action-bar-sticky', actionBarMode === 'attached' && 'action-bar-attached']}>
    <div class="action-bar-left">
      <input
        id={selectedCodesId}
        class="action-bar-input"
        type="text"
        inputmode="numeric"
        autocomplete="off"
        placeholder="BVPŽ prefiksai (pvz. 48 72 3360)"
        value={initialCodes}
        aria-label="Pasirinkti BVPŽ prefiksai"
      />
    </div>
    <div class="action-bar-right">
      <button class="btn btn-ghost btn-sm" type="button" data-bvpz-clear>Išvalyti</button>
      <button class="btn btn-outline btn-sm" type="button" id={copyBtnId}>Kopijuoti</button>
      {syncInputId && <button class="btn btn-outline btn-sm" type="button" id={syncBtnId}>{syncButtonLabel}</button>}
      {searchTargets.length > 0 && (
        <div class="action-bar-popup-wrap">
          <button class="btn btn-primary btn-sm" type="button" id={searchBtnId}>Ieškoti ↑</button>
          <div class="action-bar-popup" id={searchDropdownId}>
            {searchTargets.map((target) => (
              <button type="button" class="action-bar-popup-item" data-bvpz-search-target={target.value}>
                {target.label}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
  </div>

  <script is:inline define:vars={{ rootId }}>
    // Veiksmų juostos „atvirkštinis" sticky: kabo ekrano apačioje, kol dokas
    // (jos vieta sąrašo gale) dar žemiau matomos srities; nuslinkus iki galo —
    // atsikabina ir atsisėda doke, virš poraštės. Grynas CSS `position: sticky`
    // čia netinka: html/body `overflow-x: hidden` (reset.css) paverčia body
    // slinkties konteineriu ir apatinis sticky nebepakimba.
    (() => {
      const root = document.getElementById(rootId);
      const dock = root?.querySelector('.action-bar-dock');
      const bar = dock?.querySelector('.action-bar');
      if (!dock || !bar) return;

      let floating = null;
      const update = () => {
        // Vieta rezervuota visada — kitaip kabanti juosta uždengtų sąrašo pabaigą.
        dock.style.height = `${bar.offsetHeight}px`;
        const shouldFloat = dock.getBoundingClientRect().bottom > window.innerHeight + 0.5;
        if (shouldFloat === floating) return;
        floating = shouldFloat;
        bar.classList.toggle('is-floating', shouldFloat);
      };

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      // Medis kraunasi asinchroniškai, juosta gali persilaužti į kelias eilutes —
      // abu keičia aukščius be jokio scroll/resize įvykio.
      new ResizeObserver(update).observe(root);
      new ResizeObserver(update).observe(bar);
    })();
  </script>

  <script is:inline define:vars={{ treeUrl, rootId, treeId, selectedCodesId, searchBtnId, searchDropdownId, copyBtnId, manualInputId, applyManualBtnId, syncBtnId, searchInputId, searchClearId, resultsInfoId, initialCodes, autoLoad }}>
    // @ts-nocheck
    const root = document.getElementById(rootId);
    const treeEl = document.getElementById(treeId);
    const codesEl = document.getElementById(selectedCodesId);
    const manualInput = document.getElementById(manualInputId);
    const applyManualBtn = document.getElementById(applyManualBtnId);
    const syncBtn = document.getElementById(syncBtnId);
    const searchBtn = document.getElementById(searchBtnId);
    const searchDropdown = document.getElementById(searchDropdownId);
    const copyBtn = document.getElementById(copyBtnId);
    const searchInput = document.getElementById(searchInputId);
    const searchClear = document.getElementById(searchClearId);
    const resultsInfoEl = document.getElementById(resultsInfoId);
    const syncInputIdValue = root?.dataset.syncInputId ?? "";
    const bvpzFlatIndex = [];
    const BVPZ_MATCH_LIMIT = 400;
    let bvpzMarkedShow = [];
    let bvpzMarkedOpen = [];
    const clearInputIdValue = root?.dataset.clearInputId ?? "";
    const copiedText = "Nukopijuota ✓";
    const copyLabel = "Kopijuoti";
    let currentCodes = bvpzNormalizeCodes(initialCodes || new URLSearchParams(window.location.search).get("code") || "");

    function bvpzNormalizeCodes(value) {
      const matches = String(value || "").match(/\d{2,9}/g) || [];
      return Array.from(new Set(matches));
    }

    function bvpzCodesToText(codes) {
      return bvpzNormalizeCodes(Array.isArray(codes) ? codes.join(" ") : codes).join(" ");
    }

    function bvpzSetCodes(codes, { syncTree = false } = {}) {
      const normalized = bvpzNormalizeCodes(Array.isArray(codes) ? codes.join(" ") : codes);
      const text = normalized.join(" ");
      currentCodes = normalized;
      if (manualInput) manualInput.value = text;
      if (codesEl) codesEl.value = text;
      if (syncTree && treeEl) bvpzApplySelection(treeEl, normalized);
      root?.dispatchEvent(new CustomEvent("bvpz:codeschange", { detail: { codes: text } }));
      return normalized;
    }

    function bvpzGetCodes() {
      const syncInput = syncInputIdValue ? document.getElementById(syncInputIdValue) : null;
      const domCodes = bvpzNormalizeCodes(manualInput?.value ?? codesEl?.value ?? syncInput?.value ?? "");
      return domCodes.length ? domCodes : currentCodes;
    }

    function bvpzFormatCode(mask) {
      const span = document.createElement("span");
      span.className = "cpv-code";
      let splitAt = 2;
      for (let i = mask.length - 1; i >= 2; i--) {
        if (mask[i] !== "0") { splitAt = i + 1; break; }
      }
      span.appendChild(document.createTextNode(mask.slice(0, splitAt)));
      if (splitAt < mask.length) {
        const dim = document.createElement("span");
        dim.className = "cpv-code-dim";
        dim.textContent = mask.slice(splitAt);
        span.appendChild(dim);
      }
      return span;
    }

    function bvpzDecodeEntities(str) {
      const el = document.createElement("textarea");
      el.innerHTML = str;
      return el.value;
    }

    function cpvSetOpen(nodeEl, open) {
      nodeEl.classList.toggle("open", open);
      const btn = nodeEl.querySelector(":scope > .cpv-row > .cpv-toggle");
      if (btn) btn.setAttribute("aria-expanded", String(open));
    }

    function bvpzBuildTree(nodes, container, ancestors = []) {
      nodes.forEach((node) => {
        const nodeEl = document.createElement("div");
        nodeEl.className = "cpv-node";
        const hasChildren = node.children?.length > 0;

        const row = document.createElement("div");
        row.className = "cpv-row";

        if (hasChildren) {
          const toggle = document.createElement("button");
          toggle.type = "button";
          toggle.className = "cpv-toggle";
          toggle.textContent = "▶";
          toggle.setAttribute("aria-expanded", "false");
          toggle.addEventListener("click", () => {
            cpvSetOpen(nodeEl, !nodeEl.classList.contains("open"));
          });
          row.appendChild(toggle);
        } else {
          nodeEl.classList.add("no-children");
        }

        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.className = "form-check-input";
        checkbox.dataset.cpv = node.attributes.cpv_mask;
        checkbox.addEventListener("change", () => {
          nodeEl.querySelectorAll(".cpv-node input[type=checkbox]").forEach((cb) => {
            cb.checked = checkbox.checked;
          });
          bvpzUpdateOutput();
        });

        const rawLabel = bvpzDecodeEntities(node.label);
        const codeMatch = rawLabel.match(/^(\d{8}):\s*(.*)/);
        const fullCode = codeMatch ? codeMatch[1] : node.attributes.cpv_mask;
        const labelText = codeMatch ? codeMatch[2] : rawLabel;

        const label = document.createElement("label");
        label.appendChild(checkbox);
        label.appendChild(bvpzFormatCode(fullCode));
        const nameEl = document.createElement("span");
        nameEl.className = "cpv-name";
        nameEl.textContent = " " + labelText;
        label.appendChild(nameEl);
        row.appendChild(label);
        nodeEl.appendChild(row);

        const path = ancestors.concat(nodeEl);
        bvpzFlatIndex.push({
          el: nodeEl,
          path,
          search: (fullCode + " " + node.attributes.cpv_mask + " " + labelText).toLowerCase(),
        });

        if (hasChildren) bvpzBuildTree(node.children, nodeEl, path);
        container.appendChild(nodeEl);
      });
    }

    function bvpzOpenSelected(node) {
      if (!node.matches(".cpv-node")) return { anyChecked: false, allChecked: false };

      const checkbox = node.querySelector(":scope > .cpv-row input[type=checkbox]");
      const children = Array.from(node.querySelectorAll(":scope > .cpv-node"));

      if (children.length === 0) {
        const checked = checkbox?.checked ?? false;
        return { anyChecked: checked, allChecked: checked };
      }

      let anyChecked = false;
      let allChecked = true;

      for (const child of children) {
        const { anyChecked: ca, allChecked: cc } = bvpzOpenSelected(child);
        if (ca) anyChecked = true;
        if (!cc) allChecked = false;
      }

      if (checkbox?.checked) anyChecked = true;
      else allChecked = false;

      if (anyChecked && !allChecked) cpvSetOpen(node, true);

      return { anyChecked, allChecked };
    }

    let bvpzLoadStarted = false;
    async function bvpzLoadData() {
      if (bvpzLoadStarted) return;
      bvpzLoadStarted = true;
      const data = await fetch(treeUrl).then((r) => r.json());
      if (!treeEl) return;
      treeEl.classList.remove("loading");
      treeEl.innerHTML = "";
      bvpzFlatIndex.length = 0;
      bvpzBuildTree(data, treeEl);
      bvpzApplyInitial();
      root?.dispatchEvent(new CustomEvent("bvpz:loaded"));
    }

    function bvpzUpdateOutput() {
      if (!treeEl) return;
      bvpzSetCodes(bvpzCollectSelected(treeEl));
    }

    function bvpzCollectSelected(rootNode) {
      return Array.from(rootNode.children).flatMap((child) => bvpzCollectMinimal(child).prefixes);
    }

    function bvpzCollectMinimal(node) {
      const checkbox = node.querySelector(":scope > .cpv-row input[type=checkbox]");
      if (!checkbox) return { selected: false, prefixes: [] };

      const children = Array.from(node.querySelectorAll(":scope > .cpv-node"));
      let allChildrenSelected = true;
      const collected = [];

      for (const child of children) {
        const { selected, prefixes } = bvpzCollectMinimal(child);
        if (!selected) allChildrenSelected = false;
        collected.push(...prefixes);
      }

      if (checkbox.checked) {
        if (children.length === 0 || allChildrenSelected) {
          return { selected: true, prefixes: [checkbox.dataset.cpv] };
        }
        return { selected: false, prefixes: [checkbox.dataset.cpv + "0", ...collected] };
      }
      return { selected: false, prefixes: collected };
    }

    function bvpzApplySelection(treeNode, prefixes) {
      if (!treeNode) return;
      const selectedPrefixes = bvpzNormalizeCodes(prefixes.join(" "));
      treeNode.querySelectorAll("input[type=checkbox]").forEach((cb) => {
        const mask = cb.dataset.cpv;
        if (!mask) return;
        cb.checked = selectedPrefixes.some((sel) =>
          sel.endsWith("0") ? sel.slice(0, -1) === mask : mask.startsWith(sel)
        );
      });
      treeNode.querySelectorAll(".cpv-node").forEach((d) => {
        cpvSetOpen(d, false);
      });
      Array.from(treeNode.querySelectorAll(":scope > .cpv-node")).forEach((node) => bvpzOpenSelected(node));
      const selected = bvpzCollectSelected(treeNode);
      bvpzSetCodes(selected.length > 0 ? selected : selectedPrefixes);
    }

    function bvpzApplyPreset(codes) {
      bvpzSetCodes(codes, { syncTree: true });
    }

    function bvpzApplyInitial() {
      bvpzSetCodes(currentCodes, { syncTree: true });
    }

    function bvpzClear() {
      bvpzSetCodes([], { syncTree: true });
    }

    function bvpzSearch(target) {
      const codes = bvpzCodesToText(bvpzGetCodes());
      if (!codes) return;
      if (target === "sutartys") {
        window.location.href = `/?bvpzPrefiksasKitas=${encodeURIComponent(codes)}`;
      } else if (target === "viesiejiPirkimai") {
        window.location.href = `/viesiejiPirkimai?bvpzPrefiksai=${encodeURIComponent(codes)}`;
      } else if (target === "viesiejiPirkimaiTeikimas") {
        window.location.href = `/viesiejiPirkimai?statusas=teikimas&bvpzPrefiksai=${encodeURIComponent(codes)}`;
      }
    }

    // Filtering marks only the matching nodes and their ancestor path with
    // `cpv-show` (and ancestors with `cpv-search-open`). In `.searching` mode CSS
    // hides everything except `.cpv-show`, so a keystroke touches a bounded set of
    // nodes — the ~9.5k-node tree is never reflowed wholesale. Selection keeps
    // using the real tree checkboxes, so nothing about that logic changes.
    function bvpzClearMarks() {
      for (const el of bvpzMarkedShow) el.classList.remove("cpv-show");
      for (const el of bvpzMarkedOpen) el.classList.remove("cpv-search-open");
      bvpzMarkedShow = [];
      bvpzMarkedOpen = [];
    }

    function bvpzApplyFilter(value) {
      if (!treeEl) return;
      const q = String(value || "").trim().toLowerCase();
      if (searchClear) searchClear.hidden = q.length === 0;
      bvpzClearMarks();

      if (!q) {
        treeEl.classList.remove("searching");
        if (resultsInfoEl) resultsInfoEl.hidden = true;
        return;
      }

      const showSet = new Set();
      const openSet = new Set();
      let total = 0;
      let shownMatches = 0;
      for (const entry of bvpzFlatIndex) {
        if (entry.search.indexOf(q) === -1) continue;
        total++;
        if (shownMatches >= BVPZ_MATCH_LIMIT) continue;
        shownMatches++;
        const path = entry.path;
        for (let i = 0; i < path.length; i++) {
          showSet.add(path[i]);
          if (i < path.length - 1) openSet.add(path[i]);
        }
      }

      showSet.forEach((el) => {
        el.classList.add("cpv-show");
        bvpzMarkedShow.push(el);
      });
      openSet.forEach((el) => {
        el.classList.add("cpv-search-open");
        bvpzMarkedOpen.push(el);
      });
      treeEl.classList.add("searching");

      if (resultsInfoEl) {
        resultsInfoEl.hidden = false;
        if (total === 0) {
          resultsInfoEl.textContent = "Nieko nerasta.";
        } else if (total > shownMatches) {
          resultsInfoEl.textContent = `Rodoma ${shownMatches} iš ${total} — patikslinkite paiešką.`;
        } else {
          resultsInfoEl.textContent = `Rasta: ${total}`;
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", () => bvpzApplyFilter(searchInput.value));
      searchInput.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && searchInput.value) {
          event.preventDefault();
          searchInput.value = "";
          bvpzApplyFilter("");
        }
      });
    }

    if (searchClear) {
      searchClear.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        bvpzApplyFilter("");
        searchInput?.focus();
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", async function () {
        const codes = bvpzCodesToText(bvpzGetCodes());
        if (!codes) return;
        await navigator.clipboard.writeText(codes);
        copyBtn.textContent = copiedText;
        copyBtn.classList.add("btn-success");
        copyBtn.classList.remove("btn-outline");
        setTimeout(() => {
          copyBtn.textContent = copyLabel;
          copyBtn.classList.remove("btn-success");
          copyBtn.classList.add("btn-outline");
        }, 2000);
      });
    }

    if (applyManualBtn) {
      applyManualBtn.addEventListener("click", () => {
        bvpzSetCodes(bvpzGetCodes(), { syncTree: true });
      });
    }

    if (manualInput) {
      manualInput.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();
        bvpzSetCodes(bvpzGetCodes(), { syncTree: true });
      });
    }

    // Action-bar prefiksų laukas: redaguojant (Enter arba palikus lauką)
    // pritaikom įvestus prefiksus medžiui. Skaitom tiesiai iš šio lauko, kad
    // neįsimaišytų viršutinis „manualInput" (jei toks yra).
    if (codesEl) {
      const applyActionCodes = () => bvpzSetCodes(codesEl.value, { syncTree: true });
      codesEl.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();
        applyActionCodes();
      });
      codesEl.addEventListener("change", applyActionCodes);
    }

    root?.querySelectorAll("[data-bvpz-preset]").forEach((button) => {
      button.addEventListener("click", () => {
        bvpzApplyPreset(button.getAttribute("data-bvpz-preset") || "");
      });
    });

    root?.querySelector("[data-bvpz-clear]")?.addEventListener("click", bvpzClear);

    root?.querySelectorAll("[data-bvpz-search-target]").forEach((button) => {
      button.addEventListener("click", () => {
        bvpzSearch(button.getAttribute("data-bvpz-search-target") || "");
      });
    });

    if (syncBtn) {
      syncBtn.addEventListener("click", () => {
        const codes = bvpzCodesToText(bvpzGetCodes());
        const syncInput = syncInputIdValue ? document.getElementById(syncInputIdValue) : null;
        const clearInput = clearInputIdValue ? document.getElementById(clearInputIdValue) : null;
        if (syncInput) {
          syncInput.value = codes;
          syncInput.dispatchEvent(new Event("input", { bubbles: true }));
          syncInput.dispatchEvent(new Event("change", { bubbles: true }));
        }
        if (clearInput) {
          clearInput.value = "";
          clearInput.dispatchEvent(new Event("input", { bubbles: true }));
          clearInput.dispatchEvent(new Event("change", { bubbles: true }));
        }
        root?.dispatchEvent(new CustomEvent("bvpz:sync", { bubbles: true, detail: { codes } }));
      });
    }

    root?.addEventListener("bvpz:setCodes", (event) => {
      const codes = event?.detail?.codes ?? "";
      bvpzSetCodes(codes, { syncTree: true });
    });

    if (searchBtn && searchDropdown) {
      searchBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        searchDropdown.classList.toggle("open");
      });
      document.addEventListener("click", () => {
        searchDropdown.classList.remove("open");
      });
    }

    if (autoLoad) bvpzLoadData();
    else root?.addEventListener("bvpz:load", () => bvpzLoadData());
  </script>

</div>
