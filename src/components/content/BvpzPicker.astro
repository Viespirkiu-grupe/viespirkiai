---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Preset {
  label: string;
  codes: string;
}

interface SearchTarget {
  label: string;
  value: string;
}

interface Props {
  presets: Preset[];
  searchTargets?: SearchTarget[];
  treeUrl?: string;
  instanceId?: string;
  initialCodes?: string;
  syncInputId?: string;
  clearInputId?: string;
  syncButtonLabel?: string;
  actionBarMode?: 'fixed' | 'sticky' | 'attached';
  showPresets?: boolean;
  showManualInput?: boolean;
}

const cpvJsonPath = fileURLToPath(new URL('../../../public/dist/cpv.json', import.meta.url));
const cpvJsonVersion = createHash('md5').update(readFileSync(cpvJsonPath)).digest('hex');
const defaultTreeUrl = `/bvpz/cpv.json?v=${cpvJsonVersion}`;

const {
  presets,
  searchTargets = [],
  treeUrl = defaultTreeUrl,
  instanceId = 'bvpz-picker',
  initialCodes = '',
  syncInputId,
  clearInputId,
  syncButtonLabel = 'Naudoti',
  actionBarMode = 'fixed',
  showPresets = true,
  showManualInput = true,
} = Astro.props;

const rootId = `${instanceId}-root`;
const treeId = `${instanceId}-tree`;
const countId = `${instanceId}-count`;
const selectedCodesId = `${instanceId}-selected-codes`;
const searchBtnId = `${instanceId}-search-btn`;
const searchDropdownId = `${instanceId}-search-dropdown`;
const copyBtnId = `${instanceId}-copy-btn`;
const manualInputId = `${instanceId}-manual-input`;
const applyManualBtnId = `${instanceId}-apply-manual`;
const syncBtnId = `${instanceId}-sync-btn`;
---

<div
  class:list={['bvpz-picker', actionBarMode === 'attached' && 'bvpz-picker-attached']}
  id={rootId}
  data-sync-input-id={syncInputId ?? ''}
  data-clear-input-id={clearInputId ?? ''}
>
  {showPresets && presets.length > 0 && (
    <>
      <div class="text-muted text-sm mb-2 self-center">Greiti pasirinkimai:</div>
      <div class="flex flex-wrap gap-2 mb-4">
        {presets.map((preset) => (
          <button class="btn btn-outline btn-sm" type="button" data-bvpz-preset={preset.codes}>
            {preset.label}
          </button>
        ))}
      </div>
    </>
  )}

  {showManualInput && <div class="bvpz-manual mb-4">
    <label class="form-label" for={manualInputId}>BVPŽ prefiksai</label>
    <div class="bvpz-manual-row">
      <input
        id={manualInputId}
        class="form-control"
        type="text"
        inputmode="numeric"
        placeholder="Pvz. 48 72 3360"
        value={initialCodes}
      />
      <button class="btn btn-outline" id={applyManualBtnId} type="button">Pritaikyti</button>
    </div>
  </div>}

  <div id={treeId} class="cpv-tree loading mb-4">
    <span class="spinner spinner-xl"></span>
  </div>

  <div class:list={['action-bar', actionBarMode === 'sticky' && 'action-bar-sticky', actionBarMode === 'attached' && 'action-bar-attached']}>
    <div class="action-bar-left">
      <span id={countId} class="text-sm font-bold text-muted">Nepasirinkta</span>
      <span id={selectedCodesId} class="action-bar-codes"></span>
    </div>
    <div class="action-bar-right">
      <button class="btn btn-ghost btn-sm" type="button" data-bvpz-clear>Išvalyti</button>
      <button class="btn btn-outline btn-sm" type="button" id={copyBtnId}>Kopijuoti</button>
      {syncInputId && <button class="btn btn-outline btn-sm" type="button" id={syncBtnId}>{syncButtonLabel}</button>}
      {searchTargets.length > 0 && (
        <div class="action-bar-popup-wrap">
          <button class="btn btn-primary btn-sm" type="button" id={searchBtnId}>Ieškoti ↑</button>
          <div class="action-bar-popup" id={searchDropdownId}>
            {searchTargets.map((target) => (
              <button type="button" class="action-bar-popup-item" data-bvpz-search-target={target.value}>
                {target.label}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <script is:inline define:vars={{ treeUrl, rootId, treeId, countId, selectedCodesId, searchBtnId, searchDropdownId, copyBtnId, manualInputId, applyManualBtnId, syncBtnId, initialCodes }}>
    // @ts-nocheck
    const root = document.getElementById(rootId);
    const treeEl = document.getElementById(treeId);
    const countEl = document.getElementById(countId);
    const codesEl = document.getElementById(selectedCodesId);
    const manualInput = document.getElementById(manualInputId);
    const applyManualBtn = document.getElementById(applyManualBtnId);
    const syncBtn = document.getElementById(syncBtnId);
    const searchBtn = document.getElementById(searchBtnId);
    const searchDropdown = document.getElementById(searchDropdownId);
    const copyBtn = document.getElementById(copyBtnId);
    const syncInputIdValue = root?.dataset.syncInputId ?? "";
    const clearInputIdValue = root?.dataset.clearInputId ?? "";
    const copiedText = "Nukopijuota ✓";
    const copyLabel = "Kopijuoti";

    function bvpzNormalizeCodes(value) {
      const matches = String(value || "").match(/\d{2,9}/g) || [];
      return Array.from(new Set(matches));
    }

    function bvpzCodesToText(codes) {
      return bvpzNormalizeCodes(Array.isArray(codes) ? codes.join(" ") : codes).join(" ");
    }

    function bvpzSetCodes(codes, { syncTree = false } = {}) {
      const normalized = bvpzNormalizeCodes(Array.isArray(codes) ? codes.join(" ") : codes);
      const text = normalized.join(" ");
      if (manualInput) manualInput.value = text;
      if (codesEl) codesEl.textContent = text;
      if (countEl) {
        countEl.textContent = normalized.length > 0 ? `${normalized.length} pasirinkti` : "Nepasirinkta";
        countEl.className = `text-sm font-bold${normalized.length > 0 ? "" : " text-muted"}`;
      }
      if (syncTree && treeEl) bvpzApplySelection(treeEl, normalized);
      return normalized;
    }

    function bvpzGetCodes() {
      const syncInput = syncInputIdValue ? document.getElementById(syncInputIdValue) : null;
      return bvpzNormalizeCodes(manualInput?.value ?? codesEl?.textContent ?? syncInput?.value ?? "");
    }

    function bvpzFormatCode(mask) {
      const span = document.createElement("span");
      span.className = "cpv-code";
      let splitAt = 2;
      for (let i = mask.length - 1; i >= 2; i--) {
        if (mask[i] !== "0") { splitAt = i + 1; break; }
      }
      span.appendChild(document.createTextNode(mask.slice(0, splitAt)));
      if (splitAt < mask.length) {
        const dim = document.createElement("span");
        dim.className = "cpv-code-dim";
        dim.textContent = mask.slice(splitAt);
        span.appendChild(dim);
      }
      return span;
    }

    function bvpzDecodeEntities(str) {
      const el = document.createElement("textarea");
      el.innerHTML = str;
      return el.value;
    }

    function cpvSetOpen(nodeEl, open) {
      nodeEl.classList.toggle("open", open);
      const btn = nodeEl.querySelector(":scope > .cpv-row > .cpv-toggle");
      if (btn) btn.setAttribute("aria-expanded", String(open));
    }

    function bvpzBuildTree(nodes, container) {
      nodes.forEach((node) => {
        const nodeEl = document.createElement("div");
        nodeEl.className = "cpv-node";
        const hasChildren = node.children?.length > 0;

        const row = document.createElement("div");
        row.className = "cpv-row";

        if (hasChildren) {
          const toggle = document.createElement("button");
          toggle.type = "button";
          toggle.className = "cpv-toggle";
          toggle.textContent = "▶";
          toggle.setAttribute("aria-expanded", "false");
          toggle.addEventListener("click", () => {
            cpvSetOpen(nodeEl, !nodeEl.classList.contains("open"));
          });
          row.appendChild(toggle);
        } else {
          nodeEl.classList.add("no-children");
        }

        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.className = "form-check-input";
        checkbox.dataset.cpv = node.attributes.cpv_mask;
        checkbox.addEventListener("change", () => {
          nodeEl.querySelectorAll(".cpv-node input[type=checkbox]").forEach((cb) => {
            cb.checked = checkbox.checked;
          });
          bvpzUpdateOutput();
        });

        const rawLabel = bvpzDecodeEntities(node.label);
        const codeMatch = rawLabel.match(/^(\d{8}):\s*(.*)/);
        const fullCode = codeMatch ? codeMatch[1] : node.attributes.cpv_mask;
        const labelText = codeMatch ? codeMatch[2] : rawLabel;

        const label = document.createElement("label");
        label.appendChild(checkbox);
        label.appendChild(bvpzFormatCode(fullCode));
        label.appendChild(document.createTextNode(" " + labelText));
        row.appendChild(label);
        nodeEl.appendChild(row);

        if (hasChildren) bvpzBuildTree(node.children, nodeEl);
        container.appendChild(nodeEl);
      });
    }

    function bvpzOpenSelected(node) {
      if (!node.matches(".cpv-node")) return { anyChecked: false, allChecked: false };

      const checkbox = node.querySelector(":scope > .cpv-row input[type=checkbox]");
      const children = Array.from(node.querySelectorAll(":scope > .cpv-node"));

      if (children.length === 0) {
        const checked = checkbox?.checked ?? false;
        return { anyChecked: checked, allChecked: checked };
      }

      let anyChecked = false;
      let allChecked = true;

      for (const child of children) {
        const { anyChecked: ca, allChecked: cc } = bvpzOpenSelected(child);
        if (ca) anyChecked = true;
        if (!cc) allChecked = false;
      }

      if (checkbox?.checked) anyChecked = true;
      else allChecked = false;

      if (anyChecked && !allChecked) cpvSetOpen(node, true);

      return { anyChecked, allChecked };
    }

    async function bvpzLoadData() {
      const data = await fetch(treeUrl).then((r) => r.json());
      if (!treeEl) return;
      treeEl.classList.remove("loading");
      treeEl.innerHTML = "";
      bvpzBuildTree(data, treeEl);
      bvpzApplyInitial();
    }

    function bvpzUpdateOutput() {
      if (!treeEl) return;
      bvpzSetCodes(bvpzCollectSelected(treeEl));
    }

    function bvpzCollectSelected(rootNode) {
      return Array.from(rootNode.children).flatMap((child) => bvpzCollectMinimal(child).prefixes);
    }

    function bvpzCollectMinimal(node) {
      const checkbox = node.querySelector(":scope > .cpv-row input[type=checkbox]");
      if (!checkbox) return { selected: false, prefixes: [] };

      const children = Array.from(node.querySelectorAll(":scope > .cpv-node"));
      let allChildrenSelected = true;
      const collected = [];

      for (const child of children) {
        const { selected, prefixes } = bvpzCollectMinimal(child);
        if (!selected) allChildrenSelected = false;
        collected.push(...prefixes);
      }

      if (checkbox.checked) {
        if (children.length === 0 || allChildrenSelected) {
          return { selected: true, prefixes: [checkbox.dataset.cpv] };
        }
        return { selected: false, prefixes: [checkbox.dataset.cpv + "0", ...collected] };
      }
      return { selected: false, prefixes: collected };
    }

    function bvpzApplySelection(treeNode, prefixes) {
      if (!treeNode) return;
      const selectedPrefixes = bvpzNormalizeCodes(prefixes.join(" "));
      treeNode.querySelectorAll("input[type=checkbox]").forEach((cb) => {
        const mask = cb.dataset.cpv;
        if (!mask) return;
        cb.checked = selectedPrefixes.some((sel) =>
          sel.endsWith("0") ? sel.slice(0, -1) === mask : mask.startsWith(sel)
        );
      });
      treeNode.querySelectorAll(".cpv-node").forEach((d) => {
        cpvSetOpen(d, false);
      });
      Array.from(treeNode.querySelectorAll(":scope > .cpv-node")).forEach((node) => bvpzOpenSelected(node));
      const selected = bvpzCollectSelected(treeNode);
      bvpzSetCodes(selected.length > 0 ? selected : selectedPrefixes);
    }

    function bvpzApplyPreset(codes) {
      bvpzSetCodes(codes, { syncTree: true });
    }

    function bvpzApplyInitial() {
      const params = new URLSearchParams(window.location.search);
      const code = initialCodes || params.get("code") || "";
      bvpzSetCodes(code, { syncTree: true });
    }

    function bvpzClear() {
      bvpzSetCodes([], { syncTree: true });
    }

    function bvpzSearch(target) {
      const codes = bvpzCodesToText(bvpzGetCodes());
      if (!codes) return;
      if (target === "sutartys") {
        window.location.href = `/?bvpzPrefiksasKitas=${encodeURIComponent(codes)}`;
      } else if (target === "viesiejiPirkimai") {
        window.location.href = `/viesiejiPirkimai?bvpzPrefiksai=${encodeURIComponent(codes)}`;
      } else if (target === "viesiejiPirkimaiTeikimas") {
        window.location.href = `/viesiejiPirkimai?statusas=teikimas&bvpzPrefiksai=${encodeURIComponent(codes)}`;
      }
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", async function () {
        const codes = bvpzCodesToText(bvpzGetCodes());
        if (!codes) return;
        await navigator.clipboard.writeText(codes);
        copyBtn.textContent = copiedText;
        copyBtn.classList.add("btn-success");
        copyBtn.classList.remove("btn-outline");
        setTimeout(() => {
          copyBtn.textContent = copyLabel;
          copyBtn.classList.remove("btn-success");
          copyBtn.classList.add("btn-outline");
        }, 2000);
      });
    }

    if (applyManualBtn) {
      applyManualBtn.addEventListener("click", () => {
        bvpzSetCodes(bvpzGetCodes(), { syncTree: true });
      });
    }

    if (manualInput) {
      manualInput.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        event.preventDefault();
        bvpzSetCodes(bvpzGetCodes(), { syncTree: true });
      });
    }

    root?.querySelectorAll("[data-bvpz-preset]").forEach((button) => {
      button.addEventListener("click", () => {
        bvpzApplyPreset(button.getAttribute("data-bvpz-preset") || "");
      });
    });

    root?.querySelector("[data-bvpz-clear]")?.addEventListener("click", bvpzClear);

    root?.querySelectorAll("[data-bvpz-search-target]").forEach((button) => {
      button.addEventListener("click", () => {
        bvpzSearch(button.getAttribute("data-bvpz-search-target") || "");
      });
    });

    if (syncBtn) {
      syncBtn.addEventListener("click", () => {
        const codes = bvpzCodesToText(bvpzGetCodes());
        const syncInput = syncInputIdValue ? document.getElementById(syncInputIdValue) : null;
        const clearInput = clearInputIdValue ? document.getElementById(clearInputIdValue) : null;
        if (syncInput) {
          syncInput.value = codes;
          syncInput.dispatchEvent(new Event("input", { bubbles: true }));
          syncInput.dispatchEvent(new Event("change", { bubbles: true }));
        }
        if (clearInput) {
          clearInput.value = "";
          clearInput.dispatchEvent(new Event("input", { bubbles: true }));
          clearInput.dispatchEvent(new Event("change", { bubbles: true }));
        }
        root?.dispatchEvent(new CustomEvent("bvpz:sync", { bubbles: true, detail: { codes } }));
      });
    }

    root?.addEventListener("bvpz:setCodes", (event) => {
      const codes = event?.detail?.codes ?? "";
      bvpzSetCodes(codes, { syncTree: true });
    });

    if (searchBtn && searchDropdown) {
      searchBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        searchDropdown.classList.toggle("open");
      });
      document.addEventListener("click", () => {
        searchDropdown.classList.remove("open");
      });
    }

    bvpzLoadData();
  </script>

  <style is:global>
    .bvpz-picker .bvpz-manual-row {
      display: flex;
      gap: 8px;
      align-items: stretch;
    }

    .bvpz-picker .bvpz-manual-row .form-control {
      flex: 1 1 auto;
      min-width: 0;
    }

    .bvpz-picker .cpv-tree {
      font-size: var(--text-sm);
    }

    .bvpz-picker .cpv-tree .cpv-node {
      margin-left: 28px;
    }

    .bvpz-picker .cpv-tree > .cpv-node {
      margin-left: 0;
    }

    .bvpz-picker .cpv-tree .cpv-node > .cpv-node {
      display: none;
    }

    .bvpz-picker .cpv-tree .cpv-node.open > .cpv-node {
      display: block;
    }

    .bvpz-picker .cpv-tree .cpv-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px;
      border-radius: var(--radius-sm);
      user-select: none;
    }

    .bvpz-picker .cpv-tree .cpv-row:hover {
      background: var(--lightest-gray);
    }

    .bvpz-picker .cpv-tree .cpv-row label {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      flex: 1;
    }

    .bvpz-picker .cpv-tree .cpv-node.no-children > .cpv-row {
      padding-left: calc(18px + 8px);
    }

    .bvpz-picker .cpv-toggle {
      font-size: 10px;
      color: var(--gray);
      width: 18px;
      flex-shrink: 0;
      text-align: center;
      transition: transform var(--transition);
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
    }

    .bvpz-picker .cpv-tree .cpv-node.open > .cpv-row .cpv-toggle {
      transform: rotate(90deg);
    }

    .bvpz-picker .cpv-code {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--dark-gray);
      flex-shrink: 0;
    }

    .bvpz-picker .cpv-code-dim {
      opacity: 0.3;
    }

    .bvpz-picker .cpv-tree.loading {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 200px;
    }

    .bvpz-picker .action-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--white);
      border-top: var(--border);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      z-index: var(--z-sticky);
    }

    .bvpz-picker .action-bar.action-bar-sticky {
      position: sticky;
      left: auto;
      right: auto;
      z-index: 1;
      margin-inline: -4px;
      border: var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }

    .bvpz-picker .action-bar.action-bar-attached {
      position: static;
      left: auto;
      right: auto;
      z-index: auto;
      margin-top: 0;
      border-top: var(--border);
      border-left: 0;
      border-right: 0;
      border-bottom: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 12px 28px 20px;
    }

    .bvpz-picker .action-bar-left {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .bvpz-picker .action-bar-codes {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--gray);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 60vw;
    }

    .bvpz-picker .action-bar-right {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-shrink: 0;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .bvpz-picker .action-bar-popup-wrap {
      position: relative;
    }

    .bvpz-picker .action-bar-popup {
      position: absolute;
      bottom: calc(100% + 4px);
      right: 0;
      background: var(--white);
      border: var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      min-width: 180px;
      display: none;
    }

    .bvpz-picker .action-bar-popup.open {
      display: block;
    }

    .bvpz-picker .action-bar-popup-item {
      display: block;
      width: 100%;
      padding: 8px 12px;
      font-size: var(--text-sm);
      color: var(--black);
      text-decoration: none;
      text-align: left;
      background: transparent;
      border: 0;
      cursor: pointer;
      outline-offset: 0;
    }

    .bvpz-picker .action-bar-popup-item:hover {
      background: var(--lightest-gray);
    }

    .bvpz-picker.bvpz-picker-attached .cpv-tree {
      border: 0;
      border-radius: 0;
      padding: 0;
      margin-bottom: 0;
    }

    @media (max-width: 768px) {
      .bvpz-picker .bvpz-manual-row {
        flex-direction: column;
      }

      .bvpz-picker .action-bar {
        padding: 12px 16px;
      }

      .bvpz-picker .action-bar-codes {
        max-width: 100%;
        white-space: normal;
      }
    }
  </style>
</div>
