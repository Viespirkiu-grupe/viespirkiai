---
import FilterGroup from '@design-system/components/filters/FilterGroup.astro';
import FilterPanel from '@design-system/components/filters/FilterPanel.astro';
import DateRangeFilter from '@design-system/components/filters/DateRangeFilter.astro';
import TextInput from '@design-system/components/inputs/TextInput.astro';
import NumberInput from '@design-system/components/inputs/NumberInput.astro';
import CheckboxInput from '@design-system/components/inputs/CheckboxInput.astro';

interface Props {
  values: Record<string, string | number | undefined>;
  /** Paslepia „Dalyviai" (pirkėjo/tiekėjo kodas) grupę — kai jie rodomi kaip
   *  facetai su įterptu kodo įvedimu (Quickwit režimas). */
  hideParticipants?: boolean;
}

const { values, hideParticipants = false } = Astro.props;
---

<FilterPanel variant="rail" className="sut-filters-rail">
  {!hideParticipants && (
    <FilterGroup legend="Dalyviai">
      <TextInput label="Pirkėjo kodas" name="perkanciosiosOrganizacijosKodas" placeholder="Nenurodyta" values={values} />
      <TextInput label="Tiekėjo kodas" name="tiekejoKodas" placeholder="Nenurodyta" values={values} />
    </FilterGroup>
  )}

  {!hideParticipants && (
    <DateRangeFilter
      legend="Laikotarpis"
      nameFrom="sudarymoDataNuo"
      nameTo="sudarymoDataIki"
      labelFrom="Sudaryta nuo"
      labelTo="Sudaryta iki"
      values={values}
    />
  )}

  <FilterGroup legend="Identifikatoriai">
    <NumberInput label="Sutarties unikalus ID" name="sutartiesUnikalusID" placeholder="Nenurodyta" values={values} />
    <TextInput label="Sutarties numeris" name="sutartiesNumeris" placeholder="Nenurodyta" values={values} />
    <TextInput label="Pirkimo numeris" name="pirkimoNumeris" placeholder="Nenurodyta" values={values} />
  </FilterGroup>

  <FilterGroup legend="Filtrai" class="justify-start">
    <CheckboxInput name="tikSuDokumentais" label="Tik su dokumentais" values={values} />
  </FilterGroup>
</FilterPanel>

<style is:global>
  /* Suderinam su facetų sekcijų antraštėmis viršuje (`.dok-filter-section-label`:
     10px / 600 / letter-spacing), kad „Identifikatoriai"/„Filtrai" nebūtų
     stambesni ir nedertų su likusia šonine juosta. */
  .sut-filters-rail .filter-group-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .1em;
    color: var(--gray);
    margin-bottom: 6px;
  }
  /* Įvesties laukų ir žymimojo langelio tekstas — kompaktiškas, kaip likusi
     juosta. Didesnis specifiškumas (2 klasės), kad nugalėtų komponentų pačių
     scope'intus stilius (`.ds-field__control` text-sm, `.ds-checkbox__label`
     text-base). */
  .sut-filters-rail .filter-group .ds-field__control {
    font-size: 13px;
  }

  /* „Tik su dokumentais" gyvena toje pačioje šoninėje juostoje kaip facetai, tad
     turi atrodyti kaip faceto eilutė (`.dok-filter-opt`), o ne kaip stambesnis
     dizaino sistemos žymimasis langelis. Perrašom eilutės metriką ir dėžutės
     išvaizdą (15px / 1.5px / SVG varnelė), kad sutaptų su facetų checkbox'ais. */
  .sut-filters-rail .ds-checkbox {
    gap: 9px;
    min-height: 28px;
    padding-block: 0;
    padding-inline: 6px;
    margin-inline: -6px;
    border-radius: var(--radius-md);
    transition: background var(--transition);
  }
  .sut-filters-rail .ds-checkbox:hover {
    background: var(--lighter-gray);
  }
  .sut-filters-rail .ds-checkbox .ds-checkbox__label {
    font-size: var(--text-sm);
    color: var(--dark-gray);
  }
  .sut-filters-rail .ds-checkbox:hover .ds-checkbox__label {
    color: var(--black);
  }
  /* Dėžutės dydis suvienodinamas su facetų checkbox'ais (15px / 1.5px rėmelis);
     SVG varnelė ir juodas užpildas ateina iš paties komponento. */
  .sut-filters-rail .ds-checkbox__input {
    width: 15px;
    min-width: 15px;
    height: 15px;
    border-width: 1.5px;
  }
  .sut-filters-rail .ds-checkbox__input:checked {
    background-size: 11px;
  }
  .sut-filters-rail .ds-checkbox:hover .ds-checkbox__input {
    border-color: var(--dark-gray);
  }
</style>
