---
interface Props {
  item: any;
  maxSaskaitos?: number;
}

const { item, maxSaskaitos = 3 } = Astro.props;

const fmt = (v: any) => Number(v).toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const d1 = item.sutartiesPasirasymoData ? String(item.sutartiesPasirasymoData).slice(0, 10) : '';
const d2 = item.sutartiesGaliojimoData ? String(item.sutartiesGaliojimoData).slice(0, 10) : '';
const sumaBold = Number(item.suma) > 10000;

const saskaitos = item.saskaitos ?? [];
const saskaitosVisible = saskaitos.slice(0, maxSaskaitos);
const saskaitosHidden = saskaitos.slice(maxSaskaitos);

const renderSaskaita = (sk: any) => {
  const valiuta = sk.valiuta === 'Euras' || sk.valiuta === 'EUR' ? '€' : sk.valiuta;
  return { ...sk, valiuta };
};
---

<article class="result-card">
  <div class="result-card-body">
    <div class="result-card-meta">
      <span>{item.tipas}</span>
      <span>{item.sutartiesNumeris}</span>
      <span>{d1 ? `Sut. ${d1}${d1 !== d2 ? ' — ' + d2 : ''}` : '—'}</span>
    </div>

    <h3 class="result-card-title">
      <span class={`amount${sumaBold ? ' font-bold' : ''}`}>{fmt(item.suma)} €</span>
      &nbsp;{item.pavadinimas.length < 1 ? <em>Nenurodyta</em> : item.pavadinimas}
    </h3>

    {saskaitos.length > 0 && (
      <div class="mt-3">
        <p class="section-title mb-2">Sąskaitos <span class="text-muted text-sm font-normal">({saskaitos.length})</span></p>
        {saskaitosVisible.map((raw: any) => {
          const sk = renderSaskaita(raw);
          return (
            <div class="kv-list mb-2">
              <dt>{sk.sfTipas} Nr. {sk.sfNumeris}</dt>
              <dd>
                <span class="cell-mono">{fmt(sk.bendraSfSuma)} {sk.valiuta}</span>
                {sk.pvm && <span class="text-muted text-sm"> (su {sk.pvm} PVM)</span>}<br />
                <span class="subtext">{sk.sfBusena} ({sk.sfBusenoData})</span>
              </dd>
            </div>
          );
        })}
        {saskaitosHidden.length > 0 && (
          <details>
            <summary class="text-sm text-muted px-2 py-2 cursor-pointer select-none hover:text-current">
              Rodyti dar {saskaitosHidden.length}
            </summary>
            <div>
              {saskaitosHidden.map((raw: any) => {
                const sk = renderSaskaita(raw);
                return (
                  <div class="kv-list mb-2">
                    <dt>{sk.sfTipas} Nr. {sk.sfNumeris}</dt>
                    <dd>
                      <span class="cell-mono">{fmt(sk.bendraSfSuma)} {sk.valiuta}</span>
                      {sk.pvm && <span class="text-muted text-sm"> (su {sk.pvm} PVM)</span>}<br />
                      <span class="subtext">{sk.sfBusena} ({sk.sfBusenoData})</span>
                    </dd>
                  </div>
                );
              })}
            </div>
          </details>
        )}
      </div>
    )}
  </div>
</article>
