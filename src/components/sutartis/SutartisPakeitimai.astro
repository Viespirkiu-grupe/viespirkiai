---
import Timeline from '@design-system/components/Timeline.astro';
import SutartisPakeitimasItem from './SutartisPakeitimasItem.astro';
import type { SutartiesPakeitimas } from '../../lib/sutartisPakeitimai.ts';
import { linksniuoti } from '@/utils/linksniai.js';

interface Props {
  pakeitimai: SutartiesPakeitimas[];
  pastaba?: boolean;
  /** Kiek naujausių pakeitimų rodoma iš karto; likusieji slepiami po „details“. */
  rodomiIsKarto?: number;
}

const { pakeitimai, pastaba = true, rodomiIsKarto = 3 } = Astro.props;

if (!pakeitimai || pakeitimai.length === 0) return null;

const matomi = pakeitimai.slice(0, rodomiIsKarto);
const paslepti = pakeitimai.slice(rodomiIsKarto);
const paslėptųTekstas = linksniuoti(paslepti.length, [
  'pakeitimą',
  'pakeitimus',
  'pakeitimų',
  'pakeitimo',
]);
---

{pastaba && (
  <p class="pakeitimai-pastaba">
    Nurodytas laikas – kada pakeitimą pastebėjo mūsų sistema, o ne pakeitimo momentas.
  </p>
)}

<Timeline>
  {matomi.map((p, i) => (
    <SutartisPakeitimasItem
      pakeitimas={p}
      lineActive={i + 1 < matomi.length || paslepti.length > 0}
    />
  ))}
</Timeline>

{paslepti.length > 0 && (
  <details class="pakeitimai-daugiau">
    <summary>Rodyti dar {paslėptųTekstas}</summary>
    <Timeline>
      {paslepti.map((p, i) => (
        <SutartisPakeitimasItem pakeitimas={p} lineActive={i + 1 < paslepti.length} />
      ))}
    </Timeline>
  </details>
)}

<style>
  .pakeitimai-pastaba {
    margin: 0 0 16px;
    font-size: var(--text-sm);
    color: var(--gray);
  }

  .pakeitimai-daugiau > summary {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-info);
  }

  .pakeitimai-daugiau > summary:hover {
    text-decoration: underline;
  }

  .pakeitimai-daugiau[open] > summary {
    margin-bottom: 12px;
  }
</style>
