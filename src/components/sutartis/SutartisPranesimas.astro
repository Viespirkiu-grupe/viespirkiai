---
import DetailsSection from '@design-system/components/DetailsSection.astro';
import DateValue from '@design-system/components/DateValue.astro';
import ExternalSourceLink from '@design-system/components/ExternalSourceLink.astro';
import KeyValueList from '@design-system/components/KeyValueList.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';

interface Props {
  sutartis: any;
}

const { sutartis } = Astro.props;
const cvpisUrl = `https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=${sutartis.sutartiesUnikalusId}`;
const cvpis = sutartis.cvpisPirkimas;
const cvpp = sutartis.cvppPirkimas;
---

<DetailsSection title="Pranešimas">
  <div class="flex items-center gap-2 mb-4">
    <span class="text-muted">{sutartis.sutartiesUnikalusId}</span>
    <ExternalSourceLink href={cvpisUrl} source="cvpis" className="text-sm" />
  </div>

  <KeyValueList className="mb-4">
    <dt>Paskelbta</dt><dd>{sutartis.paskelbimoData}</dd>
    <dt>Redaguota</dt><dd>{sutartis.paskutinioRedagavimoData}</dd>
    <dt>Pirkimo numeris</dt>
    <dd>
      {cvpis
        ? <a href={`/viesiejiPirkimai/${cvpis.pirkimoId}`}>{sutartis.pirkimoNumeris}</a>
        : cvpp
          ? <a href={cvpp.link}>{sutartis.pirkimoNumeris}</a>
          : sutartis.pirkimoNumeris || 'Nenurodytas'
      }
    </dd>
  </KeyValueList>

  {cvpis && (
    <DetailsSection title="Viešasis pirkimas">
      <div class="flex items-center gap-2 mb-4">
        <a href={`/viesiejiPirkimai/${cvpis.pirkimoId}`}><span>{cvpis.pavadinimas}</span></a>
      </div>
      <KeyValueList>
        {cvpis.pasiulymuPateikimoTerminas && <>
          <dt>Pasiūlymų pateikimo terminas</dt>
          <dd><DateValue value={cvpis.pasiulymuPateikimoTerminas} /></dd>
        </>}
        {cvpis.numatomaVerteEUR && Number(cvpis.numatomaVerteEUR) > 0 && <>
          <dt>Numatoma vertė</dt>
          <dd><MoneyValue value={cvpis.numatomaVerteEUR} /></dd>
        </>}
      </KeyValueList>
      {cvpis.informacija && <p class="text-muted text-sm">{cvpis.informacija}</p>}
    </DetailsSection>
  )}
</DetailsSection>
