---
import DetailsSection from '@design-system/components/DetailsSection.astro';
import ExternalSourceLink from '@design-system/components/ExternalSourceLink.astro';
import KeyValueList from '@design-system/components/KeyValueList.astro';
import SutartisPirkimoAtitikmenys from './SutartisPirkimoAtitikmenys.astro';

interface Props {
  sutartis: any;
}

const { sutartis } = Astro.props;
const cvpisUrl = `https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=${sutartis.sutartiesUnikalusId}`;
const atitikmenys = sutartis.pirkimoAtitikmenys || [];
---

<DetailsSection title="Pranešimas">
  <div class="flex items-center gap-2 mb-4">
    <span class="text-muted">{sutartis.sutartiesUnikalusId}</span>
    <ExternalSourceLink href={cvpisUrl} source="cvpis" className="text-sm" />
  </div>

  <KeyValueList className="mb-4">
    <dt>Paskelbta</dt><dd>{sutartis.paskelbimoData}</dd>
    <dt>Redaguota</dt><dd>{sutartis.paskutinioRedagavimoData}</dd>
    <dt>Pirkimo numeris</dt>
    <dd>{sutartis.pirkimoNumeris || 'Nenurodytas'}</dd>
  </KeyValueList>

  <SutartisPirkimoAtitikmenys atitikmenys={atitikmenys} />
</DetailsSection>
