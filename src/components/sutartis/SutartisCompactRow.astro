---
import DateValue from '@design-system/components/DateValue.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';
import LinkAmountDateRow from '@design-system/components/content/LinkAmountDateRow.astro';

interface Props {
  item: any;
}

const { item } = Astro.props;
const verte = Number(item.faktineIvykdimoVerte || item.verte || 0);
---

<LinkAmountDateRow
  href={`/sutartis/${item.sutartiesUnikalusId}`}
  leadingText={item.tipas || ''}
  title={item.pavadinimas || ''}
>
  <Fragment slot="amount"><MoneyValue value={verte} suffix={'\u00A0€'} /></Fragment>
  <Fragment slot="date"><DateValue value={item.sudarymoData} fallback="" /></Fragment>
</LinkAmountDateRow>
