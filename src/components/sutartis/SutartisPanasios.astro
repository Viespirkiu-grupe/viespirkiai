---
import SutartisCompactRow from './SutartisCompactRow.astro';

interface Props {
  sutartys: any[] | null | undefined;
  maxVisible?: number;
}

const { sutartys, maxVisible = 5 } = Astro.props;
const list = sutartys ?? [];
const visible = list.slice(0, maxVisible);
const hidden = list.slice(maxVisible);
---

<section>
  <h2>
    Panašios sutartys
    {list.length > 0 && <span class="text-muted text-base font-normal">({list.length})</span>}
  </h2>
  {list.length === 0
    ? <p class="text-muted mt-4"><em>Panašių sutarčių nerasta.</em></p>
    : <div class="flex flex-col mt-4">
        {visible.map((item: any) => <SutartisCompactRow item={item} />)}
        {hidden.length > 0 && (
          <details>
            <summary class="text-sm text-muted px-2 py-2 cursor-pointer select-none hover:text-current">
              Rodyti dar {hidden.length}
            </summary>
            <div class="flex flex-col">
              {hidden.map((item: any) => <SutartisCompactRow item={item} />)}
            </div>
          </details>
        )}
      </div>
  }
</section>
