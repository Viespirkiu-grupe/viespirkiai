---
import EntityLink from '@design-system/components/EntityLink.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';
import ResultCardShell from '@design-system/components/ResultCardShell.astro';

interface Props {
  item: any;
}

const { item } = Astro.props;
const proj = item.projektas;
// Šaltinis projekto veiklų pradžios datos neteikia, todėl laikotarpis
// skaičiuojamas nuo sutarties įsigaliojimo iki veiklų pabaigos.
const pradzia = proj?.sutartiesData || '';
const pabaiga = proj?.projektoVeikluPabaigosData || '';
const laikotarpis = pradzia && pabaiga
  ? `${pradzia} — ${pabaiga}`
  : pradzia || pabaiga;
---

<ResultCardShell clickable={true}>
  <div slot="meta" class="result-card-meta">
    <span>{item.projektoNr || ''}</span>
    {laikotarpis && <span>{laikotarpis}</span>}
  </div>

  <h3 slot="title" class="result-card-title">
    <a href={`https://2021.esinvesticijos.lt/projektu-sritis/projektu-sarasas?query=${item.projektoNr}`}>
      {proj?.projektoPavadinimas || item.pirkimoObjektas || ''}
    </a>
  </h3>

  {proj && (
    <div slot="sidebar" class="result-card-sidebar">
      {proj.projektoVykdytojas && (
        <span class="text-sm">
          <EntityLink kodas={proj.projektoVykdytojoKodas} label={proj.projektoVykdytojas} />
        </span>
      )}
      {proj.isViso && (
        <span class="amount amount-sm">
          <MoneyValue value={proj.isViso} mono={false} />
        </span>
      )}
    </div>
  )}
</ResultCardShell>
