---
import { fmtEur, fmtNumber } from '../../lib/formatters.ts';
import type { SutartisPanel } from '../../lib/searchSutartisPanel.ts';

interface Props {
  sutartis: SutartisPanel;
}

const { sutartis } = Astro.props;
const verte = sutartis.faktineVerte ?? sutartis.verte;
---

<aside class="sutartis-panel" aria-label="Sutarties informacija">
  <div class="sutartis-panel__eyebrow">
    <span>{sutartis.tipoPavadinimas || sutartis.tipas || 'Sutartis'}</span>
    <span class="cell-mono">{sutartis.id}</span>
  </div>
  <h2>{sutartis.pavadinimas || 'Pavadinimas nenurodytas'}</h2>
  {verte != null && <div class="sutartis-panel__amount">{fmtEur(verte)} €</div>}

  <dl>
    {sutartis.pirkejas && <div class="sutartis-panel__wide"><dt>Pirkėjas</dt><dd>{sutartis.pirkejoKodas ? <a href={`/asmuo/${sutartis.pirkejoKodas}`}>{sutartis.pirkejas}</a> : sutartis.pirkejas}</dd></div>}
    {sutartis.tiekejas && <div class="sutartis-panel__wide"><dt>Tiekėjas</dt><dd>{sutartis.tiekejoKodas ? <a href={`/asmuo/${sutartis.tiekejoKodas}`}>{sutartis.tiekejas}</a> : sutartis.tiekejas}</dd></div>}
    {sutartis.sudarymoData && <div><dt>Sudaryta</dt><dd>{sutartis.sudarymoData}</dd></div>}
    {sutartis.galiojimoData && <div><dt>Galioja iki</dt><dd>{sutartis.galiojimoData}</dd></div>}
    {sutartis.sutartiesNumeris && <div><dt>Sutarties numeris</dt><dd class="cell-mono">{sutartis.sutartiesNumeris}</dd></div>}
    {sutartis.bvpzPavadinimas && <div class="sutartis-panel__wide"><dt>BVPŽ</dt><dd>{sutartis.bvpzKodas ? <a href={`/dokumentai?search=${encodeURIComponent(sutartis.bvpzKodas)}&mode=phrase`}>{sutartis.bvpzPavadinimas}</a> : sutartis.bvpzPavadinimas}{sutartis.bvpzKodas && <> <span class="cell-mono text-muted">({sutartis.bvpzKodas})</span></>}</dd></div>}
    {sutartis.dokumentuKiekis != null && sutartis.dokumentuKiekis > 0 && <div><dt>Dokumentai</dt><dd>{fmtNumber(sutartis.dokumentuKiekis)}</dd></div>}
  </dl>

  <nav class="sutartis-panel__actions" aria-label="Sutarties nuorodos">
    <a class="btn btn-primary" href={`/sutartis/${sutartis.id}`}>Peržiūrėti sutartį</a>
    {sutartis.pirkimoNumeris && <a class="btn btn-outline btn-sm" href={`/?pirkimoNumeris=${encodeURIComponent(sutartis.pirkimoNumeris)}`}>Susijusios sutartys</a>}
  </nav>
</aside>

<style>
  .sutartis-panel {
    grid-area: panel;
    align-self: start;
    padding: 24px;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .sutartis-panel__eyebrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    color: var(--gray);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.3;
  }
  .sutartis-panel__amount {
    margin: 14px 0 20px;
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0 0 22px;
  }
  dl div { display: grid; gap: 2px; }
  .sutartis-panel__wide { grid-column: 1 / -1; }
  dt {
    color: var(--gray);
    font-size: var(--text-xs);
  }
  dd {
    margin: 0;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  .sutartis-panel__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .sutartis-panel__actions .btn {
    justify-content: center;
    min-width: 0;
    width: 100%;
  }
</style>
