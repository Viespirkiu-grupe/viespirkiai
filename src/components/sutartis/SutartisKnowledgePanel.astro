---
import KnowledgePanelShell from '@design-system/components/KnowledgePanelShell.astro';
import EntityLink from '@design-system/components/EntityLink.astro';
import { fmtEur, fmtNumber } from '../../lib/formatters.ts';
import type { SutartisPanel } from '../../lib/searchSutartisPanel.ts';

interface Props {
  sutartis: SutartisPanel;
}

const { sutartis } = Astro.props;
const verte = sutartis.faktineVerte ?? sutartis.verte;
---

<KnowledgePanelShell
  ariaLabel="Sutarties informacija"
  eyebrowLabel={sutartis.tipoPavadinimas || sutartis.tipas || 'Sutartis'}
  eyebrowValue={sutartis.id}
  title={sutartis.pavadinimas || 'Pavadinimas nenurodytas'}
  amount={verte != null ? `${fmtEur(verte)} €` : null}
  className="sutartis-panel"
  detailsColumns={2}
  actionsColumns={2}
>
  <Fragment slot="details">
    {sutartis.pirkejas && <div class="ds-knowledge-panel__wide"><dt>Pirkėjas</dt><dd><EntityLink kodas={sutartis.pirkejoKodas} label={sutartis.pirkejas} /></dd></div>}
    {sutartis.tiekejas && <div class="ds-knowledge-panel__wide"><dt>Tiekėjas</dt><dd><EntityLink kodas={sutartis.tiekejoKodas} label={sutartis.tiekejas} /></dd></div>}
    {sutartis.sudarymoData && <div><dt>Sudaryta</dt><dd>{sutartis.sudarymoData}</dd></div>}
    {sutartis.galiojimoData && <div><dt>Galioja iki</dt><dd>{sutartis.galiojimoData}</dd></div>}
    {sutartis.sutartiesNumeris && <div><dt>Sutarties numeris</dt><dd class="cell-mono">{sutartis.sutartiesNumeris}</dd></div>}
    {sutartis.bvpzPavadinimas && <div class="ds-knowledge-panel__wide"><dt>BVPŽ</dt><dd>{sutartis.bvpzKodas ? <a href={`/dokumentai?search=${encodeURIComponent(sutartis.bvpzKodas)}&mode=phrase`}>{sutartis.bvpzPavadinimas}</a> : sutartis.bvpzPavadinimas}{sutartis.bvpzKodas && <> <span class="cell-mono text-muted">({sutartis.bvpzKodas})</span></>}</dd></div>}
    {sutartis.dokumentuKiekis != null && sutartis.dokumentuKiekis > 0 && <div><dt>Dokumentai</dt><dd>{fmtNumber(sutartis.dokumentuKiekis)}</dd></div>}
  </Fragment>

  <Fragment slot="actions">
    <a class="btn btn-primary" href={`/sutartis/${sutartis.id}`}>Peržiūrėti sutartį</a>
    {sutartis.pirkimoNumeris && <a class="btn btn-outline btn-sm" href={`/?pirkimoNumeris=${encodeURIComponent(sutartis.pirkimoNumeris)}`}>Susijusios sutartys</a>}
  </Fragment>
</KnowledgePanelShell>
