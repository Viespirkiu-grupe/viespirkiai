---
import SutartisPakeitimai from './SutartisPakeitimai.astro';
import type { SutartiesRedagavimai } from '../../lib/sutartisPakeitimai.ts';
import { linksniuoti } from '@/utils/linksniai.js';

interface Props {
  redagavimai: SutartiesRedagavimai;
}

const { redagavimai } = Astro.props;
const { unikalusId, pavadinimas, perkancioKodas, perkancioPavadinimas, praleista, pakeitimai } = redagavimai;

const antraste = pavadinimas && pavadinimas.length > 0 ? pavadinimas : `Sutartis #${unikalusId}`;
const praleistaTekstas = linksniuoti(praleista, ['ankstesnis redagavimas', 'ankstesni redagavimai', 'ankstesnių redagavimų', 'ankstesnio redagavimo']);
---

<article class="redagavimu-kortele">
  <header class="redagavimu-kortele__head">
    <h2 class="redagavimu-kortele__title">
      <a href={`/sutartis/${unikalusId}`}>{antraste}</a>
    </h2>
    <a class="redagavimu-kortele__id" href={`/sutartis/${unikalusId}`}>{unikalusId}</a>
  </header>

  {perkancioPavadinimas && (
    <div class="redagavimu-kortele__meta">
      {perkancioKodas ? (
        <a href={`/asmuo/${perkancioKodas}`}>{perkancioPavadinimas}</a>
      ) : (
        perkancioPavadinimas
      )}
    </div>
  )}

  <SutartisPakeitimai pakeitimai={pakeitimai} />

  {praleista > 0 && (
    <a class="redagavimu-kortele__daugiau" href={`/sutartis/${unikalusId}`}>
      … ir dar {praleistaTekstas} →
    </a>
  )}
</article>

<style>
  .redagavimu-kortele {
    padding: 20px 24px;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .redagavimu-kortele__id {
    flex: none;
    margin-left: auto;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .redagavimu-kortele__id:hover {
    color: var(--gray);
  }

  .redagavimu-kortele__head {
    display: flex;
    align-items: baseline;
    gap: 8px 16px;
    margin-bottom: 12px;
  }

  .redagavimu-kortele__meta {
    margin-bottom: 14px;
    font-size: var(--text-sm);
    color: var(--gray);
  }

  .redagavimu-kortele__title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.3;
    min-width: 0;
    word-break: break-word;
  }

  .redagavimu-kortele__daugiau {
    display: inline-block;
    margin-top: 12px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--gray);
  }

  .redagavimu-kortele__daugiau:hover {
    color: var(--black);
  }
</style>
