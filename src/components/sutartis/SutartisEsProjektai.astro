---
import DetailsSection from '@design-system/components/DetailsSection.astro';
import CpvaProjektasCard from './CpvaProjektasCard.astro';

interface Props {
  sutartys: any[] | null | undefined;
  showAll?: boolean;
}

const { sutartys, showAll = false } = Astro.props;
const list = sutartys ?? [];
const truncated = list.length > 3 && !showAll;
---

{list.length > 0 && (
  <DetailsSection title="Europos sąjungos projektai">
    {truncated ? (
      <>
        <p class="text-muted mt-4">
          Yra daug (<strong>{list.length}</strong>) CPVA projektų su šiuo pirkimo numeriu — tikėtina, kad ryšys netiesioginis (DPS / CPO katalogas).
        </p>
        <div class="mt-2"><a href="?cpvaAll=true" class="btn btn-sm btn-secondary">Rodyti</a></div>
      </>
    ) : (
      <div class="result-list mt-4">
        {list.map((ps: any) => <CpvaProjektasCard item={ps} />)}
      </div>
    )}
  </DetailsSection>
)}
