---
import DetailsSection from '@design-system/components/DetailsSection.astro';
import KeyValueList from '@design-system/components/KeyValueList.astro';
import DateValue from '@design-system/components/DateValue.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';

interface Props {
  sutartis: any;
}

const { sutartis } = Astro.props;
---

<DetailsSection title="Sutartis">
  <span class="text-muted mb-4 block">{sutartis.sutartiesNumeris}</span>

  <h3 class="mb-2">Vertė</h3>
  <KeyValueList className="mb-4">
    <dt>Numatyta</dt>
    <dd><MoneyValue value={sutartis.verte} /></dd>
    <dt>Faktinė</dt>
    <dd><MoneyValue value={sutartis.faktineIvykdimoVerte} fallback="Nenurodyta" /></dd>
  </KeyValueList>

  <h3 class="mb-2">Terminai</h3>
  <KeyValueList>
    <dt>Sudaryta</dt><dd><DateValue value={sutartis.sudarymoData} /></dd>
    <dt>Galioja iki</dt><dd><DateValue value={sutartis.galiojimoData} /></dd>
    <dt>Faktinė įvykdymo data</dt><dd>{sutartis.faktineIvykdimoData || 'Nenurodyta'}</dd>
  </KeyValueList>
</DetailsSection>
