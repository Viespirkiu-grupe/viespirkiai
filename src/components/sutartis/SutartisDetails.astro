---
interface Props {
  sutartis: any;
}

const { sutartis } = Astro.props;
const fmtEur = (v: any) => Number(v).toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<section>
  <h2>Sutartis</h2>
  <span class="text-muted mb-4 block">{sutartis.sutartiesNumeris}</span>

  <h3 class="mb-2">Vertė</h3>
  <dl class="kv-list mb-4">
    <dt>Numatyta</dt>
    <dd class="cell-mono">{fmtEur(sutartis.verte)} €</dd>
    <dt>Faktinė</dt>
    <dd class="cell-mono">{sutartis.faktineIvykdimoVerte ? fmtEur(sutartis.faktineIvykdimoVerte) + ' €' : 'Nenurodyta'}</dd>
  </dl>

  <h3 class="mb-2">Terminai</h3>
  <dl class="kv-list">
    <dt>Sudaryta</dt><dd>{String(sutartis.sudarymoData).slice(0, 10)}</dd>
    <dt>Galioja iki</dt><dd>{String(sutartis.galiojimoData).slice(0, 10)}</dd>
    <dt>Faktinė įvykdymo data</dt><dd>{sutartis.faktineIvykdimoData || 'Nenurodyta'}</dd>
  </dl>
</section>
