---
import FileCardList from '@design-system/components/FileCardList.astro';

interface Props {
  dokumentai: any[] | null | undefined;
}

const { dokumentai } = Astro.props;

function buildDocLinks(doc: any): { href: string; fileHref: string } {
  if (doc.id && doc.parsiustas && doc.nuskaitytas) {
    return { href: `/failas/${doc.id}`, fileHref: `https://failai.viespirkiai.org/${doc.id}` };
  }
  if (doc.parsiustas && doc.nuskaitytas) {
    return {
      href: `/failas/${doc.dok_id}/${doc.file_id}`,
      fileHref: `https://failai.viespirkiai.org/${doc.dok_id}/${doc.file_id}`,
    };
  }
  return { href: doc.proxyUrl, fileHref: doc.proxyUrl };
}

const items = (dokumentai ?? []).map((doc: any) => {
  const title = doc.pavadinimas || '—';
  const ext = (doc.extension || (title.includes('.') ? title.split('.').pop() : '') || '').toLowerCase();
  const { href, fileHref } = buildDocLinks(doc);
  return {
    title,
    href,
    ext,
    actions: [
      { href: fileHref, text: '↗ Failas', target: '_blank', rel: 'noopener noreferrer' },
      { href: doc.url, text: '↗ CVP IS', target: '_blank', rel: 'noopener noreferrer' },
    ],
  };
});
---

<FileCardList
  title="Dokumentai"
  items={items}
  emptyText="Pateiktų dokumentų nėra."
  sectionClass="span-full"
  listClass="flex flex-col gap-2"
  hideWhenEmpty={false}
/>
