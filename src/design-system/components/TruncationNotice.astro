---
/**
 * "Showing only N of M …" notice with a "Show all" link.
 *
 * Used by every section on the asmuo (entity) detail page that supports
 * a per-section row limit.  Clicking the link sets the `<paramName>=max`
 * query param and jumps to the section anchor, expanding the section to
 * its full row count.
 *
 * Lithuanian declines both the noun and the participle by the shown count
 * ("Rodomas tik 1 domenas" / "Rodomi tik 3 domenai" / "Rodoma tik 11 domenų"),
 * so `forms` carries all four forms of the noun phrase and `gender` selects
 * the participle set plus the "Rodyti visus/visas" verb.
 */
import { linksniuotiOnly } from '@/utils/linksniai.js';

interface Props {
  /** Total row count available. */
  count: number;
  /** Number of rows currently shown — notice hides itself when count <= shown. */
  shown: number;
  /** Section anchor id (without `#`). */
  anchor: string;
  /**
   * Query-parameter name controlling this section's limit.
   * Convention: `<sectionLimit>` (e.g. `kotisLimit`, `domenaiLimit`).
   */
  paramName: string;
  /**
   * Noun phrase describing the rows, all four forms:
   * [vienas, keli (2–9), daug (0, 10–20, …), trupmena].
   * E.g. `['domenas', 'domenai', 'domenų', 'domeno']`.
   */
  forms: [string, string, string, string];
  /** Grammatical gender of the noun in `forms` — defaults to masculine. */
  gender?: 'm' | 'f';
}

const { count, shown, anchor, paramName, forms, gender = 'm' } = Astro.props;

// Su kilmininku (0, 10–20, …) tarinys eina beasmenis: „Rodoma tik 11 domenų".
const showingForms: [string, string, string, string] = gender === 'f'
  ? ['Rodoma', 'Rodomos', 'Rodoma', 'Rodoma']
  : ['Rodomas', 'Rodomi', 'Rodoma', 'Rodoma'];
const showingPrefix = linksniuotiOnly(shown, showingForms);
const noun = linksniuotiOnly(shown, forms);
const showAllVerb = gender === 'f' ? 'Rodyti visas' : 'Rodyti visus';
---

{count > shown && (
  <p class="text-muted text-sm mb-4">
    {showingPrefix}{' '}tik{' '}{shown}{' '}{noun}.{' '}
    <a href={`?${paramName}=max#${anchor}`}>{showAllVerb} ({count})</a>
  </p>
)}
