---
interface Props {
  failasId: string | number;
  search?: string;
  page?: number | string;
  height?: string;
  rounded?: boolean;
  border?: string;
  class?: string;
}

const {
  failasId,
  search = '',
  page,
  height = '70vh',
  rounded = true,
  border = 'none',
  class: className = '',
} = Astro.props;

const fileUrl = `/failas/${failasId}/preview`;
const hashParts = [`search=${encodeURIComponent(search)}`];
if (page) hashParts.unshift(`page=${encodeURIComponent(String(page))}`);
const viewerSrc = `/dist/pdfjs/web/viewer.html?file=${encodeURIComponent(fileUrl)}#${hashParts.join('&')}`;
const style = `border:${border}; width:100%; height:${height}; display:block;${rounded ? ' border-radius:var(--radius-md);' : ''}`;
---

<iframe class={className} src={viewerSrc} style={style}></iframe>
