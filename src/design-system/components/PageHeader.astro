---
interface Props {
  className?: string;
}

const hasSubtext = Astro.slots.has('subtext');
// `Astro.slots.has` grąžina true ir tada, kai slot'o turinys sąlyginis ir
// neišrenderinamas, todėl tikriname patį rezultatą — kitaip liktų tuščia <p>.
const titleNote = Astro.slots.has('titleNote')
  ? (await Astro.slots.render('titleNote')).trim()
  : '';
const hasActions = Astro.slots.has('actions');
const { className = '' } = Astro.props;
const classes = ['page-header', className].filter(Boolean).join(' ');
---

<div class={classes}>
  <div class="page-header-copy">
    {hasSubtext && <p class="subtext"><slot name="subtext" /></p>}
    <h1 class:list={['mt-0', titleNote && 'mb-0']}><slot /></h1>
    {titleNote && <p class="title-note" set:html={titleNote} />}
  </div>
  {hasActions && (
    <div class="page-header-actions">
      <slot name="actions" />
    </div>
  )}
</div>

<style>
  :global(.page-header) {
    flex-wrap: nowrap;
  }

  .title-note {
    margin: 2px 0 0;
    color: var(--gray);
    font-size: var(--text-sm);
  }

  .page-header-copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .page-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 0 0 auto;
    margin-left: auto;
    width: max-content;
    max-width: none;
    white-space: nowrap;
    justify-content: flex-end;
  }

  @media (max-width: 720px) {
    :global(.page-header) {
      flex-wrap: wrap;
    }

    .page-header-actions {
      width: 100%;
      flex-basis: 100%;
      margin-left: 0;
      max-width: 100%;
      gap: 12px;
      white-space: normal;
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }
</style>
