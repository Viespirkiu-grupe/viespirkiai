---
/**
 * Puslapio poraštės karkasas: viršuje ženklas + nuorodų stulpeliai
 * (`FooterColumn`), apačioje – atsakomybės tekstas ir versijos eilutė.
 */
---
<footer class="site-footer-shell">
  <div class="footer-inner">
    <div class="footer-brand">
      <slot name="brand" />
    </div>

    <nav class="footer-columns" aria-label="Poraštė">
      <slot />
    </nav>
  </div>

  <div class="footer-bottom">
    <slot name="disclaimer" />
    <slot name="meta" />
  </div>
</footer>
