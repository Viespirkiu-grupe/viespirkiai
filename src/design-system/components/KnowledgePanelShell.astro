---
interface Props {
  ariaLabel: string;
  eyebrowLabel: string;
  eyebrowValue?: string | number | null;
  title: string;
  href?: string;
  description?: string | null;
  amount?: string | null;
  className?: string;
  contentClassName?: string;
  detailsColumns?: 1 | 2;
  actionsColumns?: 1 | 2 | 3;
  titleSize?: 'md' | 'lg';
  hasMedia?: boolean;
}

const {
  ariaLabel,
  eyebrowLabel,
  eyebrowValue,
  title,
  href,
  description,
  amount,
  className = '',
  contentClassName = '',
  detailsColumns = 1,
  actionsColumns = 1,
  titleSize = 'md',
  hasMedia = false,
} = Astro.props as Props;

const panelClasses = ['ds-knowledge-panel', hasMedia ? 'ds-knowledge-panel--has-media' : '', className].filter(Boolean).join(' ');
const contentClasses = ['ds-knowledge-panel__content', contentClassName].filter(Boolean).join(' ');
const titleClasses = ['ds-knowledge-panel__title', titleSize !== 'md' ? `ds-knowledge-panel__title--${titleSize}` : ''].filter(Boolean).join(' ');
const detailsClasses = ['ds-knowledge-panel__details', detailsColumns === 2 ? 'ds-knowledge-panel__details--cols-2' : ''].filter(Boolean).join(' ');
const actionsClasses = ['ds-knowledge-panel__actions', actionsColumns > 1 ? `ds-knowledge-panel__actions--cols-${actionsColumns}` : ''].filter(Boolean).join(' ');
---

<aside class={panelClasses} aria-label={ariaLabel}>
  <div class={contentClasses}>
    <div class="ds-knowledge-panel__eyebrow">
      <span>{eyebrowLabel}</span>
      {eyebrowValue != null && eyebrowValue !== '' && <span class="cell-mono">{eyebrowValue}</span>}
    </div>

    <h2 class={titleClasses}>
      {href ? <a href={href}>{title}</a> : title}
    </h2>

    {description && <p class="ds-knowledge-panel__description">{description}</p>}
    {amount && <div class="ds-knowledge-panel__amount">{amount}</div>}

    {Astro.slots.has('stats') && <slot name="stats" />}
    <slot />
    {Astro.slots.has('details') && (
      <dl class={detailsClasses}>
        <slot name="details" />
      </dl>
    )}
    {Astro.slots.has('actions') && (
      <nav class={actionsClasses} aria-label={`${eyebrowLabel} nuorodos`}>
        <slot name="actions" />
      </nav>
    )}
  </div>

  {Astro.slots.has('media') && <slot name="media" />}
</aside>

<style>
  .ds-knowledge-panel {
    grid-area: panel;
    align-self: start;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
    overflow: hidden;
  }

  .ds-knowledge-panel__content {
    padding: 24px;
  }

  .ds-knowledge-panel__eyebrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    color: var(--gray);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .ds-knowledge-panel__title {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  .ds-knowledge-panel__title--lg {
    font-size: var(--text-2xl);
    line-height: 1.25;
  }

  .ds-knowledge-panel__title a {
    color: var(--black);
    text-decoration: none;
  }

  .ds-knowledge-panel__title a:hover {
    text-decoration: underline;
  }

  .ds-knowledge-panel__description {
    margin: 12px 0 18px;
    color: var(--gray);
    font-size: var(--text-sm);
  }

  .ds-knowledge-panel__amount {
    margin: 14px 0 20px;
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .ds-knowledge-panel__details {
    display: grid;
    gap: 12px;
    margin: 0 0 22px;
  }

  .ds-knowledge-panel__details--cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ds-knowledge-panel__details :global(div) {
    display: grid;
    gap: 2px;
  }

  .ds-knowledge-panel__details :global(dt) {
    color: var(--gray);
    font-size: var(--text-xs);
  }

  .ds-knowledge-panel__details :global(dd) {
    margin: 0;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .ds-knowledge-panel__details :global(.ds-knowledge-panel__wide) {
    grid-column: 1 / -1;
  }

  .ds-knowledge-panel__actions {
    display: grid;
    gap: 8px;
    margin-top: 20px;
  }

  .ds-knowledge-panel__actions--cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ds-knowledge-panel__actions--cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ds-knowledge-panel__actions :global(.btn) {
    justify-content: center;
    min-width: 0;
    width: 100%;
  }
</style>
