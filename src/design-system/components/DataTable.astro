---
import Table from './Table.astro';
import TableWrapper from './TableWrapper.astro';
import TableEmptyRow from './TableEmptyRow.astro';

interface DataTableColumn {
  key?: string;
  label: string;
  className?: string;
  headerClassName?: string;
  cellClassName?: string;
  /** Ar stulpelis rikiuojamas paspaudus antraštę (kai lentelė `sortable`). */
  sortable?: boolean;
  /** Reikšmių tipas rikiavimui; `auto` atpažįsta skaičius, dydžius ir datas. */
  sortType?: 'auto' | 'number' | 'text' | 'date';
}

interface Props {
  columns: DataTableColumn[];
  /** Įjungia rikiavimą paspaudus ant stulpelių antraščių. */
  sortable?: boolean;
  rows?: any[];
  emptyText?: string;
  emptyClassName?: string;
  size?: 'md' | 'sm' | 'lg';
  className?: string;
  wrapperClassName?: string;
  bodyAttributes?: Record<string, any>;
  striped?: boolean;
  fixed?: boolean;
}

const {
  columns,
  sortable = false,
  rows,
  emptyText,
  emptyClassName,
  size = 'md',
  className = '',
  wrapperClassName = '',
  bodyAttributes = {},
  striped = false,
  fixed = false,
} = Astro.props as Props;

const hasSlotRows = Astro.slots.has('default');
const showEmpty = Array.isArray(rows) && rows.length === 0 && !!emptyText;
---

<TableWrapper className={wrapperClassName}>
  <Table size={size} className={className} striped={striped} fixed={fixed} sortable={sortable}>
    <thead>
      <tr>
        {columns.map((column) => {
          const isSortable = sortable && column.sortable !== false;
          return (
            <th
              class={[column.headerClassName ?? column.className, isSortable ? 'sortable' : '']
                .filter(Boolean).join(' ') || undefined}
              data-sort-type={isSortable && column.sortType && column.sortType !== 'auto' ? column.sortType : undefined}
              title={isSortable ? 'Rikiuoti pagal šį stulpelį' : undefined}
            >{column.label}</th>
          );
        })}
      </tr>
    </thead>
    <tbody {...bodyAttributes}>
      {showEmpty ? (
        <TableEmptyRow colspan={columns.length} message={emptyText} className={emptyClassName} />
      ) : hasSlotRows ? (
        <slot />
      ) : (
        rows?.map((row) => (
          <tr>
            {columns.map((column) => (
              <td class={column.cellClassName ?? column.className}>
                {column.key ? row[column.key] : ''}
              </td>
            ))}
          </tr>
        ))
      )}
    </tbody>
  </Table>
</TableWrapper>
