---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'link';
  size?: 'xs' | 'sm' | 'md' | 'lg';
  iconOnly?: boolean;
  disabled?: boolean;
  className?: string;
  ariaLabel?: string;
  title?: string;
  target?: string;
  rel?: string;
  id?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  iconOnly = false,
  disabled = false,
  className = '',
  ariaLabel,
  title,
  target,
  rel,
  id,
} = Astro.props;

const classes = [
  'btn',
  `btn-${variant}`,
  size !== 'md' ? `btn-${size}` : '',
  iconOnly ? 'btn-icon' : '',
  disabled ? 'disabled' : '',
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    title={title}
    target={target}
    rel={rel}
    id={id}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={disabled}
    aria-label={ariaLabel}
    title={title}
    id={id}
  >
    <slot />
  </button>
)}
