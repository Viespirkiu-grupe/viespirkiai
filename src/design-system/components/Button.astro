---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'link';
  size?: 'xs' | 'sm' | 'md' | 'lg';
  iconOnly?: boolean;
  disabled?: boolean;
  className?: string;
  ariaLabel?: string;
  title?: string;
  target?: string;
  rel?: string;
  id?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  iconOnly = false,
  disabled = false,
  className = '',
  ariaLabel,
  title,
  target,
  rel,
  id,
} = Astro.props;

const classes = [
  'ds-button',
  `ds-button--${variant}`,
  size !== 'md' ? `ds-button--${size}` : '',
  iconOnly ? 'ds-button--icon' : '',
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    title={title}
    target={target}
    rel={rel}
    id={id}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={disabled}
    aria-label={ariaLabel}
    title={title}
    id={id}
  >
    <slot />
  </button>
)}

<style>
  .ds-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition),
      opacity var(--transition);
  }

  .ds-button:disabled,
  .ds-button[aria-disabled='true'] {
    opacity: 0.45;
    pointer-events: none;
  }

  .ds-button--primary {
    background: var(--black);
    color: var(--white);
    border-color: var(--black);
  }

  .ds-button--primary:hover {
    background: var(--dark-gray);
    border-color: var(--dark-gray);
  }

  .ds-button--secondary {
    background: var(--lighter-gray);
    color: var(--black);
    border-color: var(--light-gray);
  }

  .ds-button--secondary:hover {
    background: var(--light-gray);
  }

  .ds-button--outline {
    background: transparent;
    color: var(--black);
    border-color: var(--black);
  }

  .ds-button--outline:hover {
    background: var(--black);
    color: var(--white);
  }

  .ds-button--ghost {
    background: transparent;
    color: var(--black);
    border-color: transparent;
  }

  .ds-button--ghost:hover {
    background: var(--lighter-gray);
  }

  .ds-button--link {
    padding-inline: 0;
    background: transparent;
    color: var(--link);
    border-color: transparent;
    text-decoration: underline;
  }

  .ds-button--link:hover {
    text-decoration-color: transparent;
  }

  .ds-button--xs {
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }

  .ds-button--sm {
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .ds-button--lg {
    padding: 12px 28px;
    border-radius: var(--radius-lg);
    font-size: var(--text-md);
  }

  .ds-button--icon {
    aspect-ratio: 1;
    padding: 8px;
  }

  .ds-button--icon.ds-button--sm {
    padding: 5px;
  }
</style>
