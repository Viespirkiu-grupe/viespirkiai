---
interface NavLink {
  href: string;
  label: string;
  mobileLabel?: string;
}

interface InfoBanner {
  type: 'text' | 'html';
  content: string;
  important: boolean;
}

interface Props {
  pathname: string;
  colorScheme: string;
  brandHref: string;
  brandLabel: string;
  logoHtml: string;
  primaryLinks: NavLink[];
  secondaryLinks: NavLink[];
  infoBanner?: InfoBanner | null;
  mirrorLogo?: boolean;
}

const {
  pathname,
  colorScheme,
  brandHref,
  brandLabel,
  logoHtml,
  primaryLinks,
  secondaryLinks,
  infoBanner = null,
  mirrorLogo = false,
} = Astro.props;

function isActive(path: string) {
  return pathname === path || (path !== '/' && pathname.startsWith(path)) ? 'active' : '';
}
---

<header class="site-header-shell">
  {infoBanner && (
    <section
      class={`navbar-info-banner${infoBanner.important ? ' navbar-info-banner-important' : ''}`}
      role="status"
      aria-live="polite"
      data-important={infoBanner.important ? 'true' : 'false'}
    >
      {infoBanner.type === 'html'
        ? <div class="navbar-info-banner-content" set:html={infoBanner.content} />
        : <div class="navbar-info-banner-marquee" data-marquee="idle">
            <div class="navbar-info-banner-track">
              <span class="navbar-info-banner-text" data-copy="primary">{infoBanner.content}</span>
              <span class="navbar-info-banner-text" aria-hidden="true">{infoBanner.content}</span>
            </div>
          </div>
      }
    </section>
  )}

  <nav class="navbar">
    <a href={brandHref} class="navbar-brand no-style flex">
      <span class="sr-only">{brandLabel}</span>
      {mirrorLogo
        ? <div class="rotate-180"><Fragment set:html={logoHtml} /></div>
        : <Fragment set:html={logoHtml} />
      }
    </a>

    <ul class="navbar-nav navbar-main mr-2">
      {primaryLinks.map((l) => (
        <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>

    <div class="navbar-actions">
      <ul class="navbar-nav">
        {secondaryLinks.map((l) => (
          <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>

      <slot name="actions" />

      <button class="navbar-scheme-toggle" id="schemeToggle" aria-label="Perjungti temą">
        <svg id="schemeIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {colorScheme === 'dark'
            ? <Fragment set:html={`<circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>`} />
            : <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          }
        </svg>
      </button>

      <script>
        const schemeWindow = window as Window & { updateSchemeIcon?: (scheme: string) => void };
        const schemeToggle = document.getElementById('schemeToggle') as HTMLButtonElement | null;

        schemeWindow.updateSchemeIcon = function updateSchemeIcon(scheme: string) {
          const svg = document.getElementById('schemeIcon') as HTMLElement | null;
          if (!svg) return;
          const sun  = `<circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>`;
          const moon = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>`;
          svg.innerHTML = scheme === 'dark' ? sun : moon;
        };
        function syncScheme() {
          const cookie = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith('colorScheme='));
          const scheme = cookie ? cookie.split('=')[1] : 'auto';
          const isDark = scheme === 'dark' || (scheme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', isDark);
          schemeWindow.updateSchemeIcon?.(isDark ? 'dark' : 'light');
        }

        schemeToggle?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark');
          const next = isDark ? 'light' : 'dark';
          document.documentElement.classList.toggle('dark', next === 'dark');
          document.cookie = 'colorScheme=' + next + ';path=/;max-age=31536000';
          schemeWindow.updateSchemeIcon?.(next);
        });

        syncScheme();
        window.addEventListener('pageshow', (e) => { if (e.persisted) syncScheme(); });
      </script>

      <button class="navbar-hamburger" id="navHamburger" aria-label="Atidaryti meniu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="navbar-mobile" id="navMobile" aria-hidden="true">
    <ul class="navbar-mobile-nav">
      {primaryLinks.map((l) => (
        <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.mobileLabel ?? l.label}</a></li>
      ))}
      <li class="navbar-mobile-divider"></li>
      {secondaryLinks.map((l) => (
        <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.mobileLabel ?? l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  (function() {
    var navbar = document.querySelector('.navbar');
    var infoBannerEl = document.querySelector('.navbar-info-banner');
    if (!navbar) return;
    var total = (infoBannerEl ? infoBannerEl.offsetHeight : 0) + navbar.offsetHeight;
    document.documentElement.style.setProperty('--site-header-offset', total + 'px');
  })();
</script>

<style is:global>
  .site-header-shell .navbar-info-banner {
    display: block;
    min-height: 36px;
    width: 100%;
    overflow: hidden;
    border-bottom: var(--border);
    background: var(--color-warning-bg);
    color: var(--black);
  }

  .site-header-shell .navbar-info-banner-content {
    width: 100%;
    padding: 8px 16px;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .site-header-shell .navbar-info-banner-marquee {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 8px 0;
    mask-image: linear-gradient(to right, transparent 0, black 16px, black calc(100% - 16px), transparent 100%);
  }

  .site-header-shell .navbar-info-banner-track {
    display: inline-flex;
    align-items: center;
    gap: var(--banner-gap, 128px);
    width: max-content;
    padding: 0 16px;
    white-space: nowrap;
    transform: translateX(0);
    will-change: transform;
  }

  .site-header-shell .navbar-info-banner-text {
    display: inline-block;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .site-header-shell .navbar-info-banner-marquee[data-marquee='running'] .navbar-info-banner-track {
    animation: site-header-info-banner-marquee var(--banner-duration, 24s) linear infinite;
    animation-delay: 2s;
    animation-fill-mode: both;
  }

  .site-header-shell .navbar-info-banner-marquee[data-marquee='idle'] .navbar-info-banner-text[aria-hidden='true'] {
    display: none;
  }

  .site-header-shell .navbar-info-banner-marquee[data-marquee='idle'] .navbar-info-banner-track {
    gap: 0;
  }

  .site-header-shell .navbar-info-banner-important {
    background: var(--black);
    color: var(--white);
  }

  .dark .site-header-shell .navbar-info-banner-important {
    background: var(--white);
    color: var(--black);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header-shell .navbar-info-banner-marquee[data-marquee='running'] .navbar-info-banner-track {
      animation: none;
      transform: translateX(0);
    }
  }

  @keyframes site-header-info-banner-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-1 * var(--banner-step, 320px)));
    }
  }

  .site-header-shell .navbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 12px 16px;
    border-bottom: var(--border);
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }

  .site-header-shell .navbar-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header-shell .navbar-brand {
    justify-self: start;
    color: var(--black);
    font-size: var(--text-lg);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header-shell .navbar-main {
    justify-self: center;
  }

  .site-header-shell .navbar-actions {
    display: flex;
    align-items: center;
    justify-self: end;
  }

  .site-header-shell .navbar-nav a {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    border-radius: var(--radius-md);
    color: var(--dark-gray);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background-color var(--transition), color var(--transition);
  }

  .site-header-shell .navbar-nav a:hover,
  .site-header-shell .navbar-nav a.active {
    background: var(--lighter-gray);
    color: var(--black);
  }

  .site-header-shell .navbar-scheme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-inline: 8px;
    padding: 8px;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--black);
    cursor: pointer;
    transition: background var(--transition);
  }

  .site-header-shell .navbar-scheme-toggle:hover {
    background: var(--lighter-gray);
  }

  .site-header-shell .navbar-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 8px;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    cursor: pointer;
    transition: background var(--transition);
  }

  .site-header-shell .navbar-hamburger:hover {
    background: var(--lighter-gray);
  }

  .site-header-shell .navbar-hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--black);
    transform-origin: center;
    transition: transform var(--transition), opacity var(--transition);
  }

  .site-header-shell .navbar-hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header-shell .navbar-hamburger.open span:nth-child(2) {
    opacity: 0;
  }

  .site-header-shell .navbar-hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-header-shell .navbar-mobile {
    display: none;
    overflow: hidden;
    max-height: 0;
    margin-top: -1px;
    padding-top: 1px;
    border-bottom: var(--border);
    background: var(--white);
    transition: max-height var(--transition-slow);
  }

  .site-header-shell .navbar-mobile.open {
    max-height: 100dvh;
    height: 100dvh;
  }

  .site-header-shell .navbar-mobile::before {
    content: "";
    position: absolute;
    top: -500px;
    left: 0;
    right: 0;
    height: 500px;
    background: var(--white);
  }

  body.nav-open {
    overflow: hidden;
  }

  html:has(body.nav-open) {
    overflow: hidden;
    background: var(--white);
  }

  .site-header-shell .navbar-mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 12px 16px;
    list-style: none;
  }

  .site-header-shell .navbar-mobile-nav a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    color: var(--gray);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }

  .site-header-shell .navbar-mobile-nav a:hover,
  .site-header-shell .navbar-mobile-nav a.active {
    background: var(--lighter-gray);
    color: var(--black);
  }

  .site-header-shell .navbar-mobile-divider {
    height: 1px;
    margin: 8px 0;
    background: var(--light-gray);
  }

  body > .site-header-shell {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-sticky);
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  body:has(.site-header-shell .navbar) {
    padding-top: var(--site-header-offset, 49px);
  }

  @media (max-width: 1200px) {
    body > .site-header-shell {
      transition: transform var(--transition-slow);
    }

    body > .site-header-shell.nav-hidden {
      transform: translateY(-100%);
    }

    .site-header-shell .navbar {
      grid-template-columns: 1fr auto;
    }

    .site-header-shell .navbar-main {
      display: none;
    }

    .site-header-shell .navbar-hamburger {
      display: flex;
      margin-left: auto;
    }

    .site-header-shell .navbar-actions .navbar-nav {
      display: none;
    }

    .site-header-shell .navbar-mobile {
      display: block;
      position: sticky;
      top: 49px;
      z-index: var(--z-sticky);
    }

    .site-header-shell .navbar-scheme-toggle {
      margin-left: 0;
      margin-right: 8px;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('navHamburger') as HTMLElement;
  const mobileNav = document.getElementById('navMobile') as HTMLElement;
  const header = document.querySelector('header') as HTMLElement;
  const navbar = document.querySelector('.navbar') as HTMLElement;
  const infoBannerNode = document.querySelector('.navbar-info-banner') as HTMLElement;
  const infoBannerMarquee = document.querySelector('.navbar-info-banner-marquee') as HTMLElement;
  const infoBannerTrack = document.querySelector('.navbar-info-banner-track') as HTMLElement;
  const infoBannerTextPrimary = document.querySelector('.navbar-info-banner-text[data-copy="primary"]') as HTMLElement;

  function syncInfoBannerMarquee() {
    if (!infoBannerMarquee || !infoBannerTrack || !infoBannerTextPrimary) return;
    infoBannerMarquee.dataset.marquee = 'idle';
    infoBannerTrack.style.removeProperty('--banner-step');
    infoBannerTrack.style.removeProperty('--banner-gap');
    infoBannerTrack.style.removeProperty('--banner-duration');
    const containerWidth = infoBannerMarquee.clientWidth;
    const textWidth = infoBannerTextPrimary.scrollWidth;
    if (!containerWidth || !textWidth) return;
    const availableWidth = Math.max(containerWidth - 32, 0);
    if (textWidth <= availableWidth) { infoBannerMarquee.dataset.marquee = 'idle'; return; }
    const gap = Math.max(128, containerWidth - textWidth + 24);
    const step = textWidth + gap;
    const duration = Math.max(10, step / 52);
    infoBannerTrack.style.setProperty('--banner-gap', `${gap}px`);
    infoBannerTrack.style.setProperty('--banner-step', `${step}px`);
    infoBannerTrack.style.setProperty('--banner-duration', `${duration.toFixed(2)}s`);
    infoBannerMarquee.dataset.marquee = 'running';
  }

  function syncHeaderOffset() {
    if (!navbar) return;
    const bannerHeight = infoBannerNode ? infoBannerNode.offsetHeight : 0;
    const total = bannerHeight + navbar.offsetHeight;
    document.documentElement.style.setProperty('--site-header-offset', `${total}px`);
  }

  syncHeaderOffset();
  syncInfoBannerMarquee();
  window.addEventListener('resize', syncHeaderOffset, { passive: true });
  window.addEventListener('resize', syncInfoBannerMarquee, { passive: true });
  if (document.fonts?.ready) document.fonts.ready.then(() => { syncHeaderOffset(); syncInfoBannerMarquee(); }).catch(() => {});

  hamburger.addEventListener('click', () => {
    const open = mobileNav.classList.toggle('open');
    hamburger.classList.toggle('open', open);
    hamburger.setAttribute('aria-expanded', String(open));
    mobileNav.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('nav-open', open);
  });

  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > lastY && y > 60) header.classList.add('nav-hidden');
    else header.classList.remove('nav-hidden');
    lastY = y;
  }, { passive: true });

  window.addEventListener('pageshow', (e) => {
    if (e.persisted) { syncHeaderOffset(); syncInfoBannerMarquee(); }
  });
</script>
