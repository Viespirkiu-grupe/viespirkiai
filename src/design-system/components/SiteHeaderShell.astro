---
import '@design-system/foundation/site-header-shell.css';
import { SUN_SVG, MOON_SVG } from '@/src/lib/siteHeader.ts';
import NavigationMenu from './NavigationMenu.astro';
import type { NavMenuItem } from './NavigationMenu.astro';

interface InfoBanner {
  type: 'text' | 'html';
  content: string;
  important: boolean;
}

interface Props {
  pathname: string;
  colorScheme: string;
  brandHref: string;
  brandLabel: string;
  logoHtml: string;
  primaryMenu: NavMenuItem[];
  secondaryMenu: NavMenuItem[];
  infoBanner?: InfoBanner | null;
  mirrorLogo?: boolean;
}

const {
  pathname,
  colorScheme,
  brandHref,
  brandLabel,
  logoHtml,
  primaryMenu,
  secondaryMenu,
  infoBanner = null,
  mirrorLogo = false,
} = Astro.props;

function isActive(path: string) {
  return pathname === path || (path !== '/' && pathname.startsWith(path)) ? 'active' : '';
}

// Mobiliame meniu grupės išskleidžiamos į plokščią sąrašą su antraštėmis.
const mobileGroups = [...primaryMenu, ...secondaryMenu];
---

<header class="site-header-shell">
  {infoBanner && (
    <section
      class={`navbar-info-banner${infoBanner.important ? ' navbar-info-banner-important' : ''}`}
      role="status"
      aria-live="polite"
      data-important={infoBanner.important ? 'true' : 'false'}
    >
      {infoBanner.type === 'html'
        ? <div class="navbar-info-banner-content" set:html={infoBanner.content} />
        : <div class="navbar-info-banner-marquee" data-marquee="idle">
            <div class="navbar-info-banner-track">
              <span class="navbar-info-banner-text" data-copy="primary">{infoBanner.content}</span>
              <span class="navbar-info-banner-text" aria-hidden="true">{infoBanner.content}</span>
            </div>
          </div>
      }
    </section>
  )}

  <nav class="navbar">
    <a href={brandHref} class="navbar-brand no-style flex">
      <span class="sr-only">{brandLabel}</span>
      {mirrorLogo
        ? <div class="rotate-180"><Fragment set:html={logoHtml} /></div>
        : <Fragment set:html={logoHtml} />
      }
    </a>

    <NavigationMenu
      items={primaryMenu}
      pathname={pathname}
      ariaLabel="Pagrindinė navigacija"
      className="navbar-main"
    />

    <div class="navbar-actions">
      <NavigationMenu
        items={secondaryMenu}
        pathname={pathname}
        ariaLabel="Papildoma navigacija"
      />

      <slot name="actions" />

      <button class="navbar-scheme-toggle" id="schemeToggle" aria-label="Perjungti temą">
        <svg id="schemeIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {colorScheme === 'dark'
            ? <Fragment set:html={SUN_SVG} />
            : <Fragment set:html={MOON_SVG} />
          }
        </svg>
      </button>

      <button class="navbar-hamburger" id="navHamburger" aria-label="Atidaryti meniu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="navbar-mobile" id="navMobile" aria-hidden="true">
    <ul class="navbar-mobile-nav">
      {mobileGroups.map((item) => (
        item.children ? (
          <li class="navbar-mobile-group">
            <span class="navbar-mobile-group-title">{item.label}</span>
            <ul>
              {item.children.map((c) => (
                <>
                  <li><a href={c.href} class={isActive(c.href)} aria-current={isActive(c.href) === 'active' ? 'page' : undefined}>{c.label}</a></li>
                  {c.children?.map((sc) => (
                    <li class="navbar-mobile-subitem"><a href={sc.href} class={isActive(sc.href)} aria-current={isActive(sc.href) === 'active' ? 'page' : undefined}>{sc.label}</a></li>
                  ))}
                </>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} class={isActive(item.href!)} aria-current={isActive(item.href!) === 'active' ? 'page' : undefined}>{item.label}</a></li>
        )
      ))}
    </ul>
  </div>
</header>

<style>
  .navbar-mobile-group {
    margin-top: 4px;
  }

  .navbar-mobile-group-title {
    display: block;
    padding: 8px 8px 4px;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .navbar-mobile-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navbar-mobile-group ul a {
    padding-left: 16px;
  }

  .navbar-mobile-subitem a {
    padding-left: 28px;
    font-size: var(--text-sm);
    color: var(--gray);
  }
</style>

<script is:inline>
  (function() {
    var navbar = document.querySelector('.navbar');
    var infoBannerEl = document.querySelector('.navbar-info-banner');
    if (!navbar) return;
    var total = (infoBannerEl ? infoBannerEl.offsetHeight : 0) + navbar.offsetHeight;
    document.documentElement.style.setProperty('--site-header-offset', total + 'px');
  })();
</script>
