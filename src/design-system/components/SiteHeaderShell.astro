---
import '@design-system/foundation/site-header-shell.css';
import { SUN_SVG, MOON_SVG } from '@/src/lib/siteHeader.ts';
interface NavLink {
  href: string;
  label: string;
  mobileLabel?: string;
}

interface InfoBanner {
  type: 'text' | 'html';
  content: string;
  important: boolean;
}

interface Props {
  pathname: string;
  colorScheme: string;
  brandHref: string;
  brandLabel: string;
  logoHtml: string;
  primaryLinks: NavLink[];
  secondaryLinks: NavLink[];
  infoBanner?: InfoBanner | null;
  mirrorLogo?: boolean;
}

const {
  pathname,
  colorScheme,
  brandHref,
  brandLabel,
  logoHtml,
  primaryLinks,
  secondaryLinks,
  infoBanner = null,
  mirrorLogo = false,
} = Astro.props;

function isActive(path: string) {
  return pathname === path || (path !== '/' && pathname.startsWith(path)) ? 'active' : '';
}
---

<header class="site-header-shell">
  {infoBanner && (
    <section
      class={`navbar-info-banner${infoBanner.important ? ' navbar-info-banner-important' : ''}`}
      role="status"
      aria-live="polite"
      data-important={infoBanner.important ? 'true' : 'false'}
    >
      {infoBanner.type === 'html'
        ? <div class="navbar-info-banner-content" set:html={infoBanner.content} />
        : <div class="navbar-info-banner-marquee" data-marquee="idle">
            <div class="navbar-info-banner-track">
              <span class="navbar-info-banner-text" data-copy="primary">{infoBanner.content}</span>
              <span class="navbar-info-banner-text" aria-hidden="true">{infoBanner.content}</span>
            </div>
          </div>
      }
    </section>
  )}

  <nav class="navbar">
    <a href={brandHref} class="navbar-brand no-style flex">
      <span class="sr-only">{brandLabel}</span>
      {mirrorLogo
        ? <div class="rotate-180"><Fragment set:html={logoHtml} /></div>
        : <Fragment set:html={logoHtml} />
      }
    </a>

    <ul class="navbar-nav navbar-main mr-2">
      {primaryLinks.map((l) => (
        <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>

    <div class="navbar-actions">
      <ul class="navbar-nav">
        {secondaryLinks.map((l) => (
          <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>

      <slot name="actions" />

      <button class="navbar-scheme-toggle" id="schemeToggle" aria-label="Perjungti temą">
        <svg id="schemeIcon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {colorScheme === 'dark'
            ? <Fragment set:html={SUN_SVG} />
            : <Fragment set:html={MOON_SVG} />
          }
        </svg>
      </button>

      <button class="navbar-hamburger" id="navHamburger" aria-label="Atidaryti meniu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="navbar-mobile" id="navMobile" aria-hidden="true">
    <ul class="navbar-mobile-nav">
      {primaryLinks.map((l) => (
        <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.mobileLabel ?? l.label}</a></li>
      ))}
      <li class="navbar-mobile-divider"></li>
      {secondaryLinks.map((l) => (
        <li><a href={l.href} class={isActive(l.href)} aria-current={isActive(l.href) === 'active' ? 'page' : undefined}>{l.mobileLabel ?? l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script is:inline>
  (function() {
    var navbar = document.querySelector('.navbar');
    var infoBannerEl = document.querySelector('.navbar-info-banner');
    if (!navbar) return;
    var total = (infoBannerEl ? infoBannerEl.offsetHeight : 0) + navbar.offsetHeight;
    document.documentElement.style.setProperty('--site-header-offset', total + 'px');
  })();
</script>
