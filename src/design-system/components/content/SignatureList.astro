---
import SignatureItem from '@design-system/components/content/SignatureItem.astro';

interface Sig {
  signer?: { name?: string; unit?: string; position?: string };
  signerCertificateCommonName?: string;
  signerCN?: string;
  signingTime?: string | number;
  level?: string;
  signingPurpose?: string;
  isValid?: boolean;
}

interface Props {
  signatures: Sig[];
  title?: string;
  emptyText?: string;
  disclaimerText?: string;
  maxItems?: number;
}

const {
  signatures = [],
  title = 'Parašai',
  emptyText = 'Nerasta',
  disclaimerText = 'Viešpirkiai netikrina skaitmeninių parašų galiojimo.',
  maxItems = 3,
} = Astro.props;

const visible = signatures.slice(0, maxItems).filter(Boolean);
const hidden = signatures.slice(maxItems).filter(Boolean);
---

<dt>{title}</dt>
<dd class="signature-list">
  {signatures.length > 0 ? (
    <>
      <p class="text-muted text-xs mb-2"><em>{disclaimerText}</em></p>
      <div class="stack stack-sm">
        {visible.map((sig) => <SignatureItem sig={sig} />)}
      </div>
      {hidden.length > 0 && (
        <details class="signature-list-details mt-2">
          <summary class="signature-list-summary">
            <span class="text-muted text-xs fw-bold">+ {hidden.length} daugiau</span>
          </summary>
          <div class="stack stack-sm mt-2">
            {hidden.map((sig) => <SignatureItem sig={sig} />)}
          </div>
        </details>
      )}
    </>
  ) : (
    <em class="text-muted">{emptyText}</em>
  )}
</dd>
