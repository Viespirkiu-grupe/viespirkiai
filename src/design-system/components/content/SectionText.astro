---
import ContentSection from '@design-system/components/ContentSection.astro';

interface Props {
  title: string;
  paragraphs: string[];
  titleTag?: 'h2' | 'h3';
}

const { title, paragraphs, titleTag = 'h2' } = Astro.props;
---

<ContentSection title={title} titleTag={titleTag}>
  {paragraphs.map((paragraph) => <p set:html={paragraph} />)}

  <slot />
</ContentSection>
