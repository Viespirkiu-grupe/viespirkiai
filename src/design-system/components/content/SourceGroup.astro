---
import Badge from '@design-system/components/Badge.astro';
import ContentSection from '@design-system/components/ContentSection.astro';
import Link from '@design-system/components/Link.astro';

interface SourceLink {
  href: string;
  label: string;
  badge?: string;
  suffixHtml?: string;
}

interface SourceItem {
  title: string;
  links: SourceLink[];
}

interface Props {
  title: string;
  items: SourceItem[];
  titleTag?: 'h2' | 'h3';
}

const { title, items, titleTag = 'h3' } = Astro.props;
---

<ContentSection title={title} titleTag={titleTag} className="stack stack-md">
  {items.map((item) => (
    <div class="stack stack-xs">
      <h4>{item.title}</h4>
      <div class="stack stack-xs">
        {item.links.map((link) => (
          <div>
            <Link href={link.href}>{link.label}</Link>
          {link.badge && <Badge variant="muted" className="ml-2">{link.badge}</Badge>}
          {link.suffixHtml && <Fragment set:html={` ${link.suffixHtml}`} />}
          </div>
        ))}
      </div>
    </div>
  ))}
</ContentSection>
