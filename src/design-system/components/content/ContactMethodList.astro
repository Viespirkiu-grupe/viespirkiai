---
import ContentSection from '@design-system/components/ContentSection.astro';

interface ContactMethodItem {
  title: string;
  description?: string;
  valueHtml: string;
}

interface Props {
  items: ContactMethodItem[];
  titleTag?: 'h2' | 'h3' | 'h4';
  spaced?: boolean;
}

const { items, titleTag = 'h2', spaced = true } = Astro.props;
---

{items.map((item, index) => (
  <ContentSection
    title={item.title}
    titleTag={titleTag}
    className={spaced && index > 0 ? 'mt-7' : ''}
  >
    {item.description && <p class="text-muted text-sm">{item.description}</p>}
    <p set:html={item.valueHtml} />
  </ContentSection>
))}
