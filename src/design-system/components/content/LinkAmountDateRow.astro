---
import Link from '@design-system/components/Link.astro';

interface Props {
  href: string;
  title: string;
  leadingText?: string;
  amount?: string;
  date?: string;
}

const {
  href,
  title,
  leadingText = '',
  amount = '',
  date = '',
} = Astro.props;

const hasAmountSlot = Astro.slots.has('amount');
const hasDateSlot = Astro.slots.has('date');
---

<Link href={href} variant="reset" className="flex items-baseline gap-3 px-2 py-1 rounded-md text-sm hover:bg-shade-2">
  {leadingText && <span class="text-muted shrink-0 tabular-nums">{leadingText}</span>}
  <span class="flex-1 truncate min-w-0">
    {title ? title : <em>Nenurodyta</em>}
  </span>
  <span class="tabular-nums whitespace-nowrap shrink-0 text-black">
    {hasAmountSlot ? <slot name="amount" /> : amount}
  </span>
  <span class="text-muted tabular-nums whitespace-nowrap shrink-0">
    {hasDateSlot ? <slot name="date" /> : <time datetime={date}>{date || '—'}</time>}
  </span>
</Link>
