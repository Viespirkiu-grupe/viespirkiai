---
/**
 * Single signature row used inside signatures lists.
 */
interface Sig {
  signer?: { name?: string; unit?: string; position?: string };
  signerCertificateCommonName?: string;
  signerCN?: string;
  signingTime?: string | number;
  level?: string;
  signingPurpose?: string;
  isValid?: boolean;
}

interface Props {
  sig: Sig;
}

const { sig } = Astro.props;

const name = sig?.signer?.name || sig?.signerCertificateCommonName || sig?.signerCN || 'Nežinomas pasirašytojas';
const unit = sig?.signer?.unit;
const pos = sig?.signer?.position;
let time: string | null = null;

if (sig.signingTime) {
  try {
    time = new Date(sig.signingTime).toLocaleString('lt-LT', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    time = String(sig.signingTime);
  }
}
---

<div class="signature-item">
  <div class="flex flex-col">
    <div class="flex flex-wrap gap-2 items-baseline">
      <span class="fw-bold">{name}</span>
      {time && <span class="text-muted text-xs">{time}</span>}
    </div>
    {(unit || pos) && (
      <div class="text-muted text-xs">
        {pos}{pos && unit ? ' · ' : ''}{unit}
      </div>
    )}
    {(sig.level || sig.signingPurpose || sig.isValid !== undefined) && (
      <div class="text-muted text-xs">
        {sig.level && `Level: ${sig.level}`}
        {sig.signingPurpose && ` · ${sig.signingPurpose}`}
        {sig.isValid === true && ' · validus'}
        {sig.isValid === false && ' · negalioja'}
      </div>
    )}
  </div>
</div>
