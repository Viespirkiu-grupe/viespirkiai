---
// Paieškos pasiūlymų (autocomplete) papildinys bendram <SearchForm> langeliui.
// Prisikabina prie #searchForm / #search / .search-bar (žr. SearchForm.astro) ir
// po langeliu parodo gyvą, diakritiniam ženklui nejautrų pasiūlymų sąrašą,
// maitinamą /api/searchSuggestion (-> Typesense "searchSuggestion" kolekcija).
//   ↑/↓ naršo · Enter pasirenka aktyvų (arba pateikia įvestą) · Esc užveria.
//   Pasirinkus – įrašoma į langelį ir pateikiama forma (requestSubmit), todėl
//   aktyvūs filtrai išsaugomi.
// Elgesys – searchSuggest.ts, stiliai – foundation/search-suggest.css.
//
// saltinis – jei nurodytas, pasiūlymai ribojami tik tuo šaltiniu (pvz.
// "sutartysPavadinimai" sutarčių paieškai). Tuščias = universali paieška.
import '@design-system/foundation/search-suggest.css';
interface Props {
  saltinis?: string;
}

const { saltinis = '' } = Astro.props;
---

<span class="search-suggest-config" data-saltinis={saltinis} hidden></span>

<script>
  import { initSearchSuggest } from './searchSuggest.ts';
  initSearchSuggest();
</script>
