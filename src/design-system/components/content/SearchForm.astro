---
import Button from '@design-system/components/Button.astro';

interface Props {
  title: string;
  searchValue?: string | number | undefined;
  searchPlaceholder?: string;
  usedHiddenFields?: boolean;
  /** Hide the visible <h1> (kept as an accessible label only). */
  hideTitle?: boolean;
  /** Rodyti paieškos režimo perjungiklį (Žodžiai / Tiksli frazė). */
  searchModes?: boolean;
  /** Pasirinktas režimas: 'phrase' = tiksli frazė, kitaip – žodžiai. */
  searchMode?: string;
}

const {
  title,
  searchValue = '',
  searchPlaceholder = 'Tekstinė paieška',
  usedHiddenFields = false,
  hideTitle = false,
  searchModes = false,
  searchMode = 'words',
} = Astro.props;
const isPhrase = searchMode === 'phrase';

const hasFilters = Astro.slots.has('filters');
const hasTitleSuffix = Astro.slots.has('title-suffix');
---

<form method="get" role="search" id="searchForm" class="my-10">
  {hideTitle ? (
    <h1 class="sr-only">{title}</h1>
  ) : (
    <h1>
      {title}{hasTitleSuffix && <slot name="title-suffix" />}
    </h1>
  )}

  <div class="search-bar">
    <label for="search">
      <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
      </svg>
      <span class="sr-only">Paieška</span>
    </label>

    <input
      type="search"
      name="search"
      id="search"
      class="search-bar__input"
      value={searchValue}
      placeholder={searchPlaceholder}
      enterkeyhint="search"
    />

    {hasFilters && (
      <label
        class="search-filters-toggle"
        title="Filtrai"
        aria-label={usedHiddenFields ? 'Slėpti filtrus' : 'Rodyti filtrus'}
        aria-expanded={usedHiddenFields ? 'true' : 'false'}
        aria-controls="searchNustatymai"
      >
        <input
          type="checkbox"
          id="searchNustatymaiToggle"
          class="sr-only"
          checked={usedHiddenFields}
          data-initial-checked={usedHiddenFields ? 'true' : 'false'}
        />
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M11.9999 3C11.4476 3 10.9999 3.44772 10.9999 4V6.17072C9.83476 6.58259 9 7.6938 9 8.99998C9 10.3062 9.83476 11.4174 10.9999 11.8292L10.9999 20C10.9999 20.5523 11.4476 21 11.9999 21C12.5522 21 12.9999 20.5523 12.9999 20V11.8293C14.1651 11.4175 15 10.3062 15 8.99998C15 7.69373 14.1651 6.58246 12.9999 6.17066V4C12.9999 3.44772 12.5522 3 11.9999 3ZM12 7.99998C11.4477 7.99998 11 8.4477 11 8.99998C11 9.55227 11.4477 9.99998 12 9.99998C12.5523 9.99998 13 9.55227 13 8.99998C13 8.4477 12.5523 7.99998 12 7.99998Z" fill="currentColor"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M17.9999 20C17.9999 20.5523 18.4476 21 18.9999 21C19.5522 21 19.9999 20.5523 19.9999 20V17.8293C21.1651 17.4175 22 16.3062 22 15C22 13.6937 21.1651 12.5825 19.9999 12.1707V4C19.9999 3.44772 19.5522 3 18.9999 3C18.4476 3 17.9999 3.44772 17.9999 4V12.1707C16.8348 12.5826 16 13.6938 16 15C16 16.3062 16.8348 17.4174 17.9999 17.8292V20ZM19 14C18.4477 14 18 14.4477 18 15C18 15.5523 18.4477 16 19 16C19.5523 16 20 15.5523 20 15C20 14.4477 19.5523 14 19 14Z" fill="currentColor"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M3.9999 20C3.9999 20.5523 4.44762 21 4.9999 21C5.55219 21 5.9999 20.5523 5.9999 20V17.8293C7.16515 17.4175 8 16.3062 8 15C8 13.6937 7.16515 12.5825 5.9999 12.1707L5.9999 4C5.9999 3.44772 5.55219 3 4.9999 3C4.44762 3 3.9999 3.44772 3.9999 4L3.9999 12.1707C2.83476 12.5826 2 13.6938 2 15C2 16.3062 2.83476 17.4174 3.9999 17.8292L3.9999 20ZM5 14C4.44772 14 4 14.4477 4 15C4 15.5523 4.44772 16 5 16C5.55229 16 6 15.5523 6 15C6 14.4477 5.55229 14 5 14Z" fill="currentColor"/>
        </svg>
      </label>
    )}

    {searchModes && (
      <div class="search-mode" role="radiogroup" aria-label="Paieškos režimas">
        <label class="search-mode-opt" data-tip="Žodžiai minimi bet kur dokumente">
          <input type="radio" name="mode" value="words" class="sr-only" checked={!isPhrase} />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h7M4 12h12M4 17h9" />
          </svg>
          <span class="sr-only">Žodžiai</span>
        </label>
        <label class="search-mode-opt" data-tip="Minima tiksliai tokia frazė">
          <input type="radio" name="mode" value="phrase" class="sr-only" checked={isPhrase} />
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7.5 7C5.57 7 4 8.57 4 10.5S5.57 14 7.5 14c0 1.38-1.12 2.5-2.5 2.5V18c2.21 0 4-1.79 4-4v-3.5C9 8.57 7.93 7 7.5 7zm9 0C14.57 7 13 8.57 13 10.5s1.57 3.5 3.5 3.5c0 1.38-1.12 2.5-2.5 2.5V18c2.21 0 4-1.79 4-4v-3.5C18 8.57 16.93 7 16.5 7z" />
          </svg>
          <span class="sr-only">Tiksli frazė</span>
        </label>
      </div>
    )}

    <Button type="submit">Ieškoti</Button>
  </div>


  {hasFilters && (
    <div
      id="searchNustatymai"
      class="search-filters"
      aria-hidden={usedHiddenFields ? 'false' : 'true'}
    >
      <div class="search-filters-inner">
        <slot name="filters" />
      </div>
    </div>
  )}
</form>

{hasFilters && (
  <script>
    const searchToggle = document.querySelector<HTMLElement>('label[aria-controls="searchNustatymai"]');
    const filterBox = document.getElementById('searchNustatymai');
    const checkbox = document.querySelector<HTMLInputElement>('#searchNustatymaiToggle');

    if (searchToggle && filterBox && checkbox) {
      const _searchToggle = searchToggle;
      const _filterBox = filterBox;
      const _checkbox = checkbox;
      const initialChecked = _checkbox.dataset.initialChecked === 'true';

      function applyFilterState(isChecked: boolean) {
        _searchToggle.setAttribute('aria-expanded', String(isChecked));
        _searchToggle.setAttribute('aria-label', isChecked ? 'Slėpti filtrus' : 'Rodyti filtrus');
        if (isChecked) {
          _filterBox.removeAttribute('inert');
          _filterBox.setAttribute('aria-hidden', 'false');
        } else {
          _filterBox.setAttribute('inert', '');
          _filterBox.setAttribute('aria-hidden', 'true');
        }
      }

      _checkbox.checked = initialChecked;
      applyFilterState(initialChecked);

      _checkbox.addEventListener('change', () => {
        const isChecked = _checkbox.checked;
        applyFilterState(isChecked);
        if (isChecked) {
          const firstInput = _filterBox.querySelector<HTMLElement>('input, select');
          if (firstInput) firstInput.focus();
        }
      });
    }

  </script>
)}

<style>
  .search-filters-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    padding: 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--black);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition);
  }

  /* ── Paieškos režimo perjungiklis (Žodžiai / Tiksli frazė) ──────────────────
     Du ikonų mygtukai segmentuotame valdiklyje; pasirinktas – juodas užpildas
     (tas pats idiomas kaip aktyvus filtras). Paaiškinimą neša iškart pasirodantis
     stilizuotas patarimas (žr. .search-mode-opt::after). */
  .search-mode {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    padding: 2px;
    border: 1px solid var(--light-gray);
    border-radius: var(--radius-pill);
    background: var(--lightest-gray);
  }
  .search-mode-opt {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-pill);
    color: var(--gray);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition);
  }
  .search-mode-opt svg { width: 18px; height: 18px; }
  .search-mode-opt:hover { color: var(--black); }
  .search-mode-opt:has(input:checked) {
    background: var(--black);
    color: var(--white);
  }
  .search-mode-opt:has(input:focus-visible) {
    outline: var(--border-focus);
    outline-offset: 1px;
  }

  /* Iškart pasirodantis stilizuotas patarimas (ne native „title"): trumpai ir
     aiškiai, kaip režimas veiks. Pasirodo po ikona ant hover / fokuso. */
  .search-mode-opt::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: var(--z-tooltip);
    transform: translateX(-50%) translateY(-2px);
    padding: 6px 9px;
    border-radius: var(--radius-md);
    background: var(--black);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition), transform var(--transition);
  }
  .search-mode-opt:hover::after,
  .search-mode-opt:focus-within::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .search-filters-toggle {
    &:hover {
      background: var(--lighter-gray);
    }

    &:focus-within {
      outline: var(--border-focus);
      border-radius: var(--radius-sm);
    }
  }
</style>
