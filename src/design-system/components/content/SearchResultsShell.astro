---
import EmptyState from '@design-system/components/EmptyState.astro';
import Pagination from '@design-system/components/Pagination.astro';
import ResultList from '@design-system/components/ResultList.astro';
import FlatResultList from '@design-system/components/content/FlatResultList.astro';
import ResultsSummary from '@design-system/components/ResultsSummary.astro';

interface Props {
  numberOfResults: string;
  resultCount: number;
  page: number;
  pageCount: number;
  queryParams: string;
  emptyText?: string;
  containerClass?: string;
  /** Borderless dokumentai-style list instead of the bordered card list. */
  flat?: boolean;
}

const {
  numberOfResults,
  resultCount,
  page,
  pageCount,
  queryParams,
  emptyText = 'Rezultatų nerasta.',
  containerClass = 'mt-10 max-w-lg center mx-auto',
  flat = false,
} = Astro.props;

const hasActions = Astro.slots.has('actions');
const hasSort = Astro.slots.has('sort');
---

<div class={containerClass}>
  <div class="stack stack-md">
    <div class="search-results-toolbar">
      <ResultsSummary html={numberOfResults} />
      <div class="search-results-tools">
        {hasSort && <div class="search-results-sort"><slot name="sort" /></div>}
        {hasActions && <div class="search-results-actions"><slot name="actions" /></div>}
      </div>
    </div>

    {resultCount === 0
      ? <EmptyState message={emptyText} />
      : <>
          {flat
            ? <FlatResultList><slot /></FlatResultList>
            : <ResultList><slot /></ResultList>
          }
          <div class="search-pagination">
            <Pagination currentPage={page} pageCount={pageCount} queryParams={queryParams} />
          </div>
        </>
    }
  </div>
</div>

<style>
  /* Puslapiavimas centruotas su papildomu tarpu virš jo. */
  .search-pagination {
    margin-top: 32px;
  }
  .search-pagination :global(ul.pagination) {
    justify-content: center;
    gap: 8px;
  }
  /* Didesnis tarpas atskiriant rodykles (←, →) nuo skaičių grupės. */
  .search-pagination :global(ul.pagination li:first-child) {
    margin-right: 12px;
  }
  .search-pagination :global(ul.pagination li:last-child) {
    margin-left: 12px;
  }

  .search-results-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .search-results-tools {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }

  .search-results-sort :global(select) {
    min-width: 170px;
    padding: 7px 10px;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--black);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .search-results-sort :global(select:focus-visible) {
    outline: var(--border-focus);
  }

  .search-results-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  /* Be eksporto mygtukų blokas lieka tuščias — tada `.search-results-tools` gap
     paliktų tarpą dešinėje nuo rikiavimo dropdown'o. Išimam jį iš flex srauto. */
  .search-results-actions:empty {
    display: none;
  }

  @media (max-width: 720px) {
    .search-results-toolbar {
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .search-results-tools {
      width: 100%;
      margin-left: 0;
      flex-wrap: wrap;
    }

    .search-results-actions {
      flex-wrap: wrap;
      white-space: normal;
      justify-content: flex-start;
    }
  }
</style>
