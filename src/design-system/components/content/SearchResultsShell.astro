---
import EmptyState from '@design-system/components/EmptyState.astro';
import Pagination from '@design-system/components/Pagination.astro';
import ResultList from '@design-system/components/ResultList.astro';
import ResultsSummary from '@design-system/components/ResultsSummary.astro';

interface Props {
  numberOfResults: string;
  resultCount: number;
  page: number;
  pageCount: number;
  queryParams: string;
  emptyText?: string;
  containerClass?: string;
}

const {
  numberOfResults,
  resultCount,
  page,
  pageCount,
  queryParams,
  emptyText = 'Rezultatų nerasta.',
  containerClass = 'mt-10 max-w-lg center mx-auto',
} = Astro.props;

const hasActions = Astro.slots.has('actions');
---

<div class={containerClass}>
  <div class="stack stack-md">
    <div class="search-results-toolbar">
      <ResultsSummary html={numberOfResults} />
      {hasActions && <div class="search-results-actions"><slot name="actions" /></div>}
    </div>

    {resultCount === 0
      ? <EmptyState message={emptyText} />
      : <>
          <ResultList>
            <slot />
          </ResultList>
          <Pagination currentPage={page} pageCount={pageCount} queryParams={queryParams} />
        </>
    }
  </div>
</div>

<style>
  .search-results-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .search-results-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .search-results-toolbar {
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .search-results-actions {
      width: 100%;
      margin-left: 0;
      flex-wrap: wrap;
      white-space: normal;
      justify-content: flex-start;
    }
  }
</style>
