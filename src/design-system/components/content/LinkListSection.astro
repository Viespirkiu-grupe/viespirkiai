---
interface LinkItem {
  href: string;
  label: string;
  suffixHtml?: string;
}

interface Props {
  title: string;
  items: LinkItem[];
  titleTag?: 'h2' | 'h3' | 'h4';
}

const { title, items, titleTag = 'h3' } = Astro.props;
const TitleTag = titleTag;
---

<section>
  <TitleTag>{title}</TitleTag>

  <ul class="file-list">
    {items.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
        {item.suffixHtml && <Fragment set:html={` ${item.suffixHtml}`} />}
      </li>
    ))}
  </ul>
</section>

<style>
  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .file-list li + li {
    margin-top: 0.5rem;
  }
</style>
