---
import Badge from '@design-system/components/Badge.astro';
import ContentSection from '@design-system/components/ContentSection.astro';

interface LinkItem {
  href: string;
  label: string;
  badge?: string;
  suffixHtml?: string;
}

interface Props {
  title: string;
  items: LinkItem[];
  titleTag?: 'h2' | 'h3' | 'h4';
}

const { title, items, titleTag = 'h3' } = Astro.props;
---

<ContentSection title={title} titleTag={titleTag}>
  <ul class="stack stack-sm list-none m-0 p-0">
    {items.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
        {item.badge && <Badge variant="muted" className="ml-2">{item.badge}</Badge>}
        {item.suffixHtml && <Fragment set:html={` ${item.suffixHtml}`} />}
      </li>
    ))}
  </ul>
</ContentSection>
