---
import Link from '@design-system/components/Link.astro';

interface Item {
  value: string;
  pages?: number[];
  fullValue?: string;
}

interface Props {
  items: Item[];
  title: string;
  type: 'email' | 'phone' | 'link' | 'iban' | 'domain' | 'plain';
  maxItems?: number;
  emptyText?: string;
  titleTagMode?: 'dt' | 'heading';
}

const { items = [], title, type, maxItems = 3, emptyText = 'Nerasta', titleTagMode = 'dt' } = Astro.props;

const visible = items.slice(0, maxItems);
const hidden = items.slice(maxItems);
const isMono = type === 'iban';
const isExternal = type === 'link' || type === 'domain';
const TitleTag = titleTagMode === 'heading' ? 'h3' : 'dt';
const BodyTag = titleTagMode === 'heading' ? 'div' : 'dd';

function getHref(item: Item) {
  if (type === 'email') return `mailto:${item.value}`;
  if (type === 'phone') return `tel:${item.value}`;
  if (type === 'link') return item.fullValue || item.value;
  if (type === 'domain') return `https://${item.fullValue || item.value}`;
  return '#';
}

function pageLabel(item: Item) {
  if (!Array.isArray(item.pages) || item.pages.length === 0) return null;
  return `${item.pages.slice(0, 3).join(', ')}${item.pages.length > 3 ? '...' : ''} psl.`;
}
---

<TitleTag>{title}</TitleTag>
<BodyTag class={`contact-list contact-list--${type}`}>
  {items.length > 0 ? (
    <>
      <div class="stack stack-xs">
        {visible.map((item) => item?.value && (
          <div class="inline inline-xs contact-item">
            {type === 'plain'
              ? <span>{item.value}</span>
              : isMono
              ? <span class="cell-mono">{item.value}</span>
              : isExternal
                ? <Link href={getHref(item)} target="_blank" className="cell-truncate">{item.value}</Link>
                : <Link href={getHref(item)}>{item.value}</Link>
            }
            {pageLabel(item) && (
              <sup class="text-muted text-xs contact-pages shrink-0">{pageLabel(item)}</sup>
            )}
          </div>
        ))}
      </div>
      {hidden.length > 0 && (
        <details class="contact-list-details mt-2">
          <summary class="contact-list-summary">
            <span class="text-muted text-xs font-bold">+ {hidden.length} daugiau</span>
          </summary>
          <div class="stack stack-xs mt-2">
            {hidden.map((item) => item?.value && (
              <div class="inline inline-xs contact-item">
                {type === 'plain'
                  ? <span>{item.value}</span>
                  : isMono
                  ? <span class="cell-mono">{item.value}</span>
                  : isExternal
                    ? <Link href={getHref(item)} target="_blank" className="cell-truncate">{item.value}</Link>
                    : <Link href={getHref(item)}>{item.value}</Link>
                }
                {pageLabel(item) && (
                  <sup class="text-muted text-xs contact-pages shrink-0">{pageLabel(item)}</sup>
                )}
              </div>
            ))}
          </div>
        </details>
      )}
    </>
  ) : (
    <em class="text-muted">{emptyText}</em>
  )}
</BodyTag>
