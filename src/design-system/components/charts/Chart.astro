---
interface Props {
  id: string;
  type: string;
  labels: any[];
  series: any[];
  flags?: string[];
  customOptions?: Record<string, any>;
  title?: string;
  anchor?: string;
  wrapperClass?: string;
  titleClass?: string;
  frameClass?: string;
  chartClass?: string;
  heightClass?: string;
  framed?: boolean;
  titleTag?: 'h2' | 'h3';
}

const {
  id,
  type,
  labels,
  series,
  flags = [],
  customOptions,
  title,
  anchor,
  wrapperClass = 'min-w-0 flex flex-col min-h-87.5',
  titleClass = 'mb-3',
  frameClass = '',
  chartClass = '',
  heightClass = 'h-87.5',
  framed = true,
  titleTag = 'h2',
} = Astro.props;

const TitleTag = titleTag;
const chartConfig = JSON.stringify({ type, labels, series, flags, customOptions });
---

<div class={wrapperClass}>
  {title && (
    <TitleTag class={titleClass}>
      {anchor ? <a href={`#${anchor}`} id={anchor} class="no-style">{title}</a> : title}
    </TitleTag>
  )}

  {framed ? (
    <div class:list={['chart-frame', frameClass]}>
      <div id={id} class:list={['chart', heightClass, chartClass]} data-chart-config={chartConfig}></div>
    </div>
  ) : (
    <div id={id} class:list={['chart', heightClass, chartClass]} data-chart-config={chartConfig}></div>
  )}

  <script>
    import { ensureChartRuntime } from './chartRuntime';

    await ensureChartRuntime();
    for (const element of document.querySelectorAll('.chart[data-chart-config]:not([data-chart-initialized])')) {
      const rawConfig = element.getAttribute('data-chart-config');
      if (!rawConfig) continue;
      element.setAttribute('data-chart-initialized', 'true');
      window.displayChart?.({
        element,
        ...JSON.parse(rawConfig),
      });
    }
  </script>
</div>
