---
import ResultList from '@design-system/components/ResultList.astro';
import SectionHeading from '@design-system/components/SectionHeading.astro';
import TruncationNotice from '@design-system/components/TruncationNotice.astro';

interface Props {
  id: string;
  title: string;
  className?: string;
  bordered?: boolean;
  count?: number;
  shown?: number;
  paramName?: string;
  forms?: [string, string, string, string];
  gender?: 'm' | 'f';
}

const {
  id,
  title,
  className = 'page-section mb-10',
  bordered = true,
  count,
  shown,
  paramName,
  forms,
  gender = 'm',
} = Astro.props as Props;

const hasNotice = typeof count === 'number'
  && typeof shown === 'number'
  && Boolean(paramName)
  && Boolean(forms);
---

<div class={className} id={id}>
  <SectionHeading id={id} title={title} />
  {Astro.slots.has('intro') && <slot name="intro" />}
  {hasNotice && (
    <TruncationNotice
      count={count}
      shown={shown}
      anchor={id}
      paramName={paramName!}
      forms={forms!}
      gender={gender}
    />
  )}
  <ResultList bordered={bordered}>
    <slot />
  </ResultList>
</div>
