---
interface Props {
  title?: string;
  titleTag?: 'h2' | 'h3' | 'h4';
  className?: string;
  bodyClass?: string;
}

const {
  title,
  titleTag = 'h2',
  className = '',
  bodyClass = '',
} = Astro.props as Props;

const TitleTag = titleTag;
const classes = ['stack', 'stack-sm', className].filter(Boolean).join(' ');
const contentClasses = [bodyClass].filter(Boolean).join(' ');
---

<section class={classes}>
  {title && <TitleTag>{title}</TitleTag>}
  <div class={contentClasses}>
    <slot />
  </div>
</section>
