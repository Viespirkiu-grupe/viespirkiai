---
/**
 * Drop-in component that emits the Leaflet loader IIFE.
 *
 * Use this from any component or page fragment that needs Leaflet but is not
 * rendered through `customHead`.  The loader is idempotent: rendering it
 * multiple times on the same page does not refetch the bundle.
 */
import { LEAFLET_LOADER_SCRIPT } from '@design-system/lib/leaflet.ts';
---

<script is:inline set:html={LEAFLET_LOADER_SCRIPT}></script>
