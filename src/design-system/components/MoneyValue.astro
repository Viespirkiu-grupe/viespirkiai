---
interface Props {
  value?: unknown;
  currency?: string;
  fallback?: string;
  suffix?: string;
  bold?: boolean;
  mono?: boolean;
  className?: string;
}

const {
  value,
  currency = 'EUR',
  fallback = '—',
  suffix,
  bold = false,
  mono = true,
  className = '',
} = Astro.props as Props;

const amount = Number(value);
const hasValue = value != null && value !== '' && !Number.isNaN(amount);
const formatted = hasValue
  ? amount.toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  : fallback;
// Nedalomas tarpas – suma ir valiuta niekada neišsiskiria per eilutės lūžį.
const unit = suffix ?? (currency === 'EUR' ? '\u00a0€' : `\u00a0${currency}`);
const classes = [mono ? 'cell-mono' : '', bold ? 'font-bold' : '', className].filter(Boolean).join(' ');
---

<span class={classes || undefined}>{hasValue ? `${formatted}${unit}` : formatted}</span>
