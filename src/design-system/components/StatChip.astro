---
// A small linked chip showing a label and an optional count — e.g. a facet
// value that links into a filtered view. Generic: the caller supplies the
// href, label and (pre-formatted) count.
interface Props {
  href: string;
  label: string;
  /** Pre-formatted count shown after the label. */
  count?: string | number;
  /** outline = bordered pill; solid = filled pill. */
  variant?: 'outline' | 'solid';
  className?: string;
  /** Passthrough inline style (e.g. a --i animation index). */
  style?: string;
}

const { href, label, count, variant = 'outline', className = '', style } = Astro.props;
const classes = ['ds-stat-chip', `ds-stat-chip--${variant}`, className].filter(Boolean).join(' ');
---

<a class={classes} href={href} style={style}>
  <span class="ds-stat-chip__label">{label}</span>
  {count != null && count !== '' && <span class="ds-stat-chip__count">{count}</span>}
</a>

<style>
  .ds-stat-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    color: inherit;
    text-decoration: none;
    transition: border-color .15s, background .15s;
  }
  .ds-stat-chip__label { color: var(--black); }
  .ds-stat-chip__count {
    color: var(--gray);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  /* Outline: bordered, subtle hover wash. */
  .ds-stat-chip--outline {
    padding: 6px 13px;
    border: var(--border);
  }
  .ds-stat-chip--outline:hover {
    border-color: var(--gray);
    background: var(--lighter-gray);
  }

  /* Solid: filled pill (slightly heavier label). */
  .ds-stat-chip--solid {
    align-items: center;
    padding: 8px 16px;
    background: var(--lighter-gray);
    font-weight: 500;
  }
  .ds-stat-chip--solid:hover { background: var(--light-gray); }
</style>
