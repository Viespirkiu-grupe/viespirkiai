---
import TimingWaterfall from './TimingWaterfall.astro';

interface Props {
  html: string;
}

const { html } = Astro.props;
---

<span class="text-muted text-sm numberOfResults" set:html={html} />
<TimingWaterfall />

<style>
  .numberOfResults {
    font-style: italic;
  }

  .numberOfResults :global(.rezultatai-nezinomas-total) {
    display: inline-block;
    padding-inline: 8px;
  }

  .numberOfResults :global(.rezultatai-nezinomas-total.spin) {
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
