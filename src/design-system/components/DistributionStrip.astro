---
// A percentile distribution strip: a log-scaled track (p-min → p-max), a
// highlighted interquartile band (p25–p75) and a median tick, with labelled
// percentile ticks below. When given several metrics it renders a segmented
// toggle that flips which strip is shown (all are pre-rendered). Generic: works
// for any set of percentile metrics.
interface Percentile {
  p: number;
  value: number;
}
interface Metric {
  key: string;
  label: string;
  unit: string;
  median: number;
  percentiles: Percentile[];
}
interface Props {
  metrics: Metric[];
  title?: string;
  /** Format a numeric value for display. */
  formatValue?: (value: number) => string;
  /** Optional caption text under each strip. */
  caption?: (info: { p25: number; p75: number; p90: number; median: number; unit: string }) => string;
  className?: string;
}

const {
  metrics,
  title,
  formatValue = (v: number) => v.toLocaleString(),
  caption,
  className = '',
} = Astro.props;

const fmt = formatValue;

// Counts span orders of magnitude, so positions sit on a log scale
// (first→last percentile maps to 0→100%).
function distModel(m: Metric) {
  const lo = Math.max(1, m.percentiles[0].value);
  const hi = Math.max(lo + 1, m.percentiles[m.percentiles.length - 1].value);
  const logLo = Math.log(lo);
  const span = Math.log(hi) - logLo || 1;
  const pos = (v: number) => Math.max(0, Math.min(100, ((Math.log(Math.max(1, v)) - logLo) / span) * 100));
  const find = (p: number) => m.percentiles.find((x) => x.p === p)?.value ?? 0;
  return {
    ticks: m.percentiles.map((t, i, a) => ({
      ...t, pos: pos(t.value), edge: i === 0 ? 'start' : i === a.length - 1 ? 'end' : 'mid',
    })),
    iqrFrom: pos(find(25)),
    iqrTo: pos(find(75)),
    medianPos: pos(m.median),
    p25: find(25), p75: find(75), p90: find(90),
  };
}
---

<div class={['ds-dist', className].filter(Boolean).join(' ')}>
  {(title || metrics.length > 1) && (
    <div class="ds-dist__head">
      {title && <h3 class="ds-dist__title">{title}</h3>}
      {metrics.length > 1 && (
        <div class="ds-dist__toggle" role="tablist" aria-label={title}>
          {metrics.map((m, i) => (
            <button type="button" class={`ds-dist__tab${i === 0 ? ' is-active' : ''}`} data-metric={m.key} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>
              {m.label}
            </button>
          ))}
        </div>
      )}
    </div>
  )}
  {metrics.map((m, i) => {
    const d = distModel(m);
    return (
      <div class="ds-dist__strip" data-metric={m.key} hidden={i !== 0}>
        <div class="ds-dist__track" role="img" aria-label={`${m.label} (${m.unit}): mediana ${fmt(m.median)}`}>
          <span class="ds-dist__iqr" style={`--from:${d.iqrFrom}%;--w:${d.iqrTo - d.iqrFrom}%`} aria-hidden="true"></span>
          <span class="ds-dist__median" style={`--pos:${d.medianPos}%`} aria-hidden="true"></span>
        </div>
        <div class="ds-dist__axis">
          {d.ticks.map((t) => (
            <span class={`ds-dist__tick is-${t.edge}${t.p === 50 ? ' is-median' : ''}`} style={`--pos:${t.pos}%`}>
              <small>{t.p}%</small>
              <b>{fmt(t.value)}</b>
            </span>
          ))}
        </div>
        {caption && (
          <p class="ds-dist__cap text-muted text-sm">
            {caption({ p25: d.p25, p75: d.p75, p90: d.p90, median: m.median, unit: m.unit })}
          </p>
        )}
      </div>
    );
  })}
</div>

<script>
  // Metric toggle: flip which pre-rendered strip is visible. Scoped per instance
  // so multiple strips on one page don't interfere.
  document.querySelectorAll<HTMLElement>('.ds-dist').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.ds-dist__tab')];
    if (!tabs.length) return;
    const strips = [...root.querySelectorAll<HTMLElement>('.ds-dist__strip[data-metric]')];
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const key = tab.dataset.metric;
        for (const t of tabs) {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        }
        for (const s of strips) s.hidden = s.dataset.metric !== key;
      });
    }
  });
</script>

<style>
  .ds-dist__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }
  .ds-dist__title {
    margin: 0;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--gray);
  }
  .ds-dist__toggle {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border-radius: var(--radius-pill);
    background: var(--lighter-gray);
  }
  .ds-dist__tab {
    appearance: none;
    border: none;
    background: none;
    cursor: pointer;
    padding: 4px 13px;
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--gray);
    transition: background .15s, color .15s;
  }
  .ds-dist__tab:hover { color: var(--dark-gray); }
  .ds-dist__tab.is-active {
    background: var(--white);
    color: var(--black);
    box-shadow: var(--shadow-xs);
  }
  .ds-dist__strip { padding-top: 2px; }
  .ds-dist__track {
    position: relative;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--lighter-gray);
    transform-origin: left;
    animation: ds-dist-grow .7s cubic-bezier(.2, .7, .2, 1) both;
    animation-delay: .15s;
  }
  .ds-dist__iqr {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--from, 0);
    width: var(--w, 0);
    background: color-mix(in srgb, var(--link) 70%, transparent);
    border-radius: var(--radius-pill);
  }
  .ds-dist__median {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: var(--pos, 50%);
    width: 3px;
    transform: translateX(-50%);
    border-radius: var(--radius-pill);
    background: var(--black);
  }
  .ds-dist__axis {
    position: relative;
    height: 30px;
    margin-top: 12px;
  }
  .ds-dist__tick {
    position: absolute;
    left: var(--pos, 0);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    white-space: nowrap;
  }
  .ds-dist__tick.is-start { transform: none; align-items: flex-start; }
  .ds-dist__tick.is-end { transform: translateX(-100%); align-items: flex-end; }
  .ds-dist__tick small { font-size: 10px; color: var(--gray); }
  .ds-dist__tick b {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--dark-gray);
    font-variant-numeric: tabular-nums;
  }
  .ds-dist__tick.is-median b { color: var(--black); }
  .ds-dist__cap { margin-top: 14px; }

  @keyframes ds-dist-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (max-width: 640px) {
    /* Edge labels collide on a narrow strip; band + median + inner ticks carry it. */
    .ds-dist__tick.is-start, .ds-dist__tick.is-end { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds-dist__track { animation: none !important; transform: none !important; }
  }
</style>
