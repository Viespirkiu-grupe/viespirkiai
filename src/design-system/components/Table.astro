---
interface Props {
  className?: string;
  striped?: boolean;
  fixed?: boolean;
  size?: 'md' | 'sm' | 'lg';
}

const {
  className = '',
  striped = false,
  fixed = false,
  size = 'md',
} = Astro.props;

const classes = [
  'ds-table',
  striped ? 'ds-table--striped' : '',
  fixed ? 'ds-table--fixed' : '',
  size !== 'md' ? `ds-table--${size}` : '',
  className,
].filter(Boolean).join(' ');
---

<table class={classes}>
  <slot />
</table>

<style>
  .ds-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .ds-table :global(th),
  .ds-table :global(td) {
    padding: 8px 12px;
    border: var(--border);
    text-align: left;
    vertical-align: middle;
  }

  .ds-table :global(thead th) {
    background: var(--lighter-gray);
    color: var(--dark-gray);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ds-table :global(tbody tr:hover) {
    background: var(--shade-2);
  }

  .ds-table--striped :global(tbody tr:nth-child(even)) {
    background: var(--shade-2);
  }

  .ds-table--fixed {
    table-layout: fixed;
  }

  .ds-table--sm :global(th),
  .ds-table--sm :global(td) {
    padding: 4px 8px;
  }

  .ds-table--lg :global(th),
  .ds-table--lg :global(td) {
    padding: 12px 16px;
  }

  .ds-table :global(td.cell-mono) {
    font-family: var(--font-mono);
  }

  .ds-table :global(th.cell-center),
  .ds-table :global(td.cell-center) {
    text-align: center;
  }

  .ds-table :global(th.cell-right),
  .ds-table :global(td.cell-right) {
    text-align: right;
  }

  .ds-table :global(th.cell-nowrap),
  .ds-table :global(td.cell-nowrap) {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ds-table :global(td.cell-truncate) {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ds-table :global(td .cell-clamp) {
    display: -webkit-box;
    max-height: 4ch;
    overflow: hidden;
    word-break: break-word;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .ds-table :global(td .cell-truncate) {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .ds-table :global(th.sortable) {
    cursor: pointer;
    user-select: none;
  }

  .ds-table :global(th.sortable)::after {
    content: " ↕";
    color: var(--gray);
    font-size: var(--text-xs);
  }

  .ds-table :global(th.sortable.asc)::after {
    content: " ↑";
    color: var(--black);
  }

  .ds-table :global(th.sortable.desc)::after {
    content: " ↓";
    color: var(--black);
  }

  .ds-table :global(tr.row-success td) {
    background: var(--color-success-bg);
  }

  .ds-table :global(tr.row-warning td) {
    background: var(--color-warning-bg);
  }

  .ds-table :global(tr.row-danger td) {
    background: var(--color-danger-bg);
  }
</style>
