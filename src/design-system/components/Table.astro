---
interface Props {
  className?: string;
  striped?: boolean;
  fixed?: boolean;
  size?: 'md' | 'sm' | 'lg';
}

const {
  className = '',
  striped = false,
  fixed = false,
  size = 'md',
} = Astro.props;

const classes = [
  'ds-table',
  striped ? 'ds-table--striped' : '',
  fixed ? 'ds-table--fixed' : '',
  size !== 'md' ? `ds-table--${size}` : '',
  className,
].filter(Boolean).join(' ');
---

<table class={classes}>
  <slot />
</table>
