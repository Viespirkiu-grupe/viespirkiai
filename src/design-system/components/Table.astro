---
interface Props {
  className?: string;
  striped?: boolean;
  fixed?: boolean;
  size?: 'md' | 'sm' | 'lg';
  /** Įjungia rikiavimą paspaudus ant `th.sortable` antraščių. */
  sortable?: boolean;
}

const {
  className = '',
  striped = false,
  fixed = false,
  size = 'md',
  sortable = false,
} = Astro.props;

const classes = [
  'ds-table',
  striped ? 'ds-table--striped' : '',
  fixed ? 'ds-table--fixed' : '',
  size !== 'md' ? `ds-table--${size}` : '',
  className,
].filter(Boolean).join(' ');
---

<table class={classes} data-sortable={sortable ? '' : undefined}>
  <slot />
</table>

<!-- Skriptas hoistinamas visam puslapiui; be `data-sortable` lentelių jis nieko nedaro. -->
<script>
  import { initSortableTables } from '@design-system/lib/sortableTable.ts';
  initSortableTables();
</script>
