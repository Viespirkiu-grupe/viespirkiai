---
import Field from './Field.astro';

interface Props { label: string; name: string; values: Record<string, any>; }
const { label, name, values } = Astro.props as Props;
---
<Field label={label} name={name}>
  <input type="date" class="ds-field__control" name={name} id={name} value={values[name] || ''}>
</Field>
