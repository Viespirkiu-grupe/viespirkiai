---
import Field from './Field.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  label: string;
  name: string;
  options: Option[];
  values: Record<string, any>;
  placeholder?: string;
  className?: string;
  controlClassName?: string;
}

const {
  label,
  name,
  options,
  values,
  placeholder = '—',
  className = '',
  controlClassName = '',
} = Astro.props as Props;

const current = values[name] ?? '';
---

<Field label={label} name={name} className={className}>
  <select name={name} id={name} class:list={['ds-field__control', 'ds-field__control--select', controlClassName]}>
    <option value="" selected={!current}>{placeholder}</option>
    {options.map((option) => (
      <option value={option.value} selected={current === option.value}>{option.label}</option>
    ))}
  </select>
</Field>
