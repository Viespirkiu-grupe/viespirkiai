---
import Field from './Field.astro';

interface Props { label: string; name: string; placeholder?: string; values: Record<string, any>; }
const { label, name, placeholder = '', values } = Astro.props as Props;
---
<Field label={label} name={name}>
  <input type="text" class="ds-field__control" name={name} id={name} value={values[name] || ''} placeholder={placeholder}>
</Field>
