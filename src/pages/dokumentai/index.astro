---
import Layout from '../../layouts/Layout.astro';
import SearchForm from '@design-system/components/content/SearchForm.astro';
import SearchSuggest from '@design-system/components/content/SearchSuggest.astro';
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import TimingWaterfall from '@design-system/components/TimingWaterfall.astro';
import EmptyState from '@design-system/components/EmptyState.astro';
import Linksnis from '@design-system/components/Linksnis.astro';
import BvpzKnowledgePanel from '../../components/bvpz/BvpzKnowledgePanel.astro';
import JuridinisKnowledgePanel from '../../components/juridiniai/JuridinisKnowledgePanel.astro';
import SutartisKnowledgePanel from '../../components/sutartis/SutartisKnowledgePanel.astro';
import config from '../../lib/config.ts';
import { getColorScheme, getFont } from '../../lib/failai.js';
import { findSingleBvpzPanel } from '../../lib/searchBvpzPanel.ts';
import { findSingleJuridinisPanel } from '../../lib/searchJuridinisPanel.ts';
import { findSutartisPanel } from '../../lib/searchSutartisPanel.ts';
import {
  buildDokumentaiUrl,
  splitFacetOptions,
  toggleValue,
  type DokumentaiUrlOverrides,
  type DokumentaiUrlState,
} from '../../lib/dokumentaiUrl.ts';
import {
  DOKUMENTAI_SORT_OPTIONS,
  searchDokumentai,
  dokumentaiHomeOverview,
  extractInlineTokens,
  type DokumentasHit,
  type FacetOption,
  type DokumentaiSort,
} from '../../lib/searchDokumentai.ts';

if (!config.enableDokumentaiSearch) return Astro.redirect('/');

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const url = Astro.url;
const params = url.searchParams;
const q = (params.get('search') ?? params.get('q') ?? '').trim();
const page = Math.max(1, parseInt(params.get('page') ?? params.get('p') ?? '1', 10) || 1);
const mode = params.get('mode') === 'words' ? 'words' : 'phrase';
const requestedSort = params.get('sort') ?? undefined;

const rawClassFilter = params.getAll('klase').flatMap((v) => v.split(','));
const rawTypeFilter = params.getAll('type').flatMap((v) => v.split(','));
const rawHostFilter = params.getAll('host').flatMap((v) => v.split(','));
const rawJarFilter = params.getAll('jar').flatMap((v) => v.split(','));
const rawIstaigaFilter = params.getAll('istaiga').flatMap((v) => v.split(','));
const rawExtFilter = params.getAll('ext').flatMap((v) => v.split(','));
const rawAuthorFilter = params.getAll('author').filter(Boolean);
const rawCreatorFilter = params.getAll('creator').filter(Boolean);
const rawProducerFilter = params.getAll('producer').filter(Boolean);
const rawLangFilter = params.getAll('lang').flatMap((v) => v.split(','));
const rawSavFilter = params.getAll('sav').flatMap((v) => v.split(','));
const rawApskritisFilter = params.getAll('apskritis').flatMap((v) => v.split(','));
const rawSourceFilter = params.getAll('source').flatMap((v) => v.split(','));
// Nuosprendžių metadata filtrai — reikšmės gali turėti kablelių, todėl NEskaidom.
const rawCourtFilter = params.getAll('teismas').filter(Boolean);
const rawCaseTypeFilter = params.getAll('bylosRusis').filter(Boolean);
const rawCategoryFilter = params.getAll('kategorija').filter(Boolean);
const rawJudgeFilter = params.getAll('teisejas').filter(Boolean);

// Geografinė sritis (stačiakampis) — filtruojama per Quickwit lat/lon range.
const rawArea = {
  minLat: params.get('minLat') ?? undefined,
  maxLat: params.get('maxLat') ?? undefined,
  minLon: params.get('minLon') ?? undefined,
  maxLon: params.get('maxLon') ?? undefined,
};
const hasArea = Boolean(rawArea.minLat && rawArea.maxLat && rawArea.minLon && rawArea.maxLon);

// Promote inline `class:`/`type:`/`host:`/`jar:`/`ext:` tokens out of the search box.
{
  const { textQuery, classes, types, hosts, jars, exts } = extractInlineTokens(q);
  if (classes.length || types.length || hosts.length || jars.length || exts.length) {
    const sp = new URLSearchParams();
    if (textQuery) sp.set('search', textQuery);
    const merge = (existing: string[], incoming: string[]) =>
      [...new Set([...existing.map((v) => v.trim()).filter(Boolean), ...incoming])];
    const c = merge(rawClassFilter, classes);
    const t = merge(rawTypeFilter, types);
    const h = merge(rawHostFilter, hosts);
    const j = merge(rawJarFilter, jars);
    const e = merge(rawExtFilter, exts.map((x) => x.toLowerCase()));
    if (c.length) sp.set('klase', c.join(','));
    if (t.length) sp.set('type', t.join(','));
    if (h.length) sp.set('host', h.join(','));
    if (j.length) sp.set('jar', j.join(','));
    if (e.length) sp.set('ext', e.join(','));
    rawAuthorFilter.forEach((value) => sp.append('author', value));
    rawCreatorFilter.forEach((value) => sp.append('creator', value));
    rawProducerFilter.forEach((value) => sp.append('producer', value));
    rawCourtFilter.forEach((value) => sp.append('teismas', value));
    rawCaseTypeFilter.forEach((value) => sp.append('bylosRusis', value));
    rawCategoryFilter.forEach((value) => sp.append('kategorija', value));
    rawJudgeFilter.forEach((value) => sp.append('teisejas', value));
    sp.set('mode', mode);
    if (requestedSort && requestedSort !== 'relevance') sp.set('sort', requestedSort);
    if (page > 1) sp.set('page', String(page));
    return Astro.redirect(`/dokumentai?${sp.toString()}`);
  }
}

const hasFilters = Boolean(
  rawClassFilter.length || rawTypeFilter.length || rawHostFilter.length || rawJarFilter.length || rawIstaigaFilter.length || rawExtFilter.length
  || rawAuthorFilter.length || rawCreatorFilter.length || rawProducerFilter.length
  || rawLangFilter.length || rawSavFilter.length || rawApskritisFilter.length || rawSourceFilter.length
  || rawCourtFilter.length || rawCaseTypeFilter.length || rawCategoryFilter.length || rawJudgeFilter.length
  || hasArea,
);
const showHome = !q && !hasFilters;

let result: Awaited<ReturnType<typeof searchDokumentai>> | null = null;
let juridinisPanel: Awaited<ReturnType<typeof findSingleJuridinisPanel>> = null;
let bvpzPanel: Awaited<ReturnType<typeof findSingleBvpzPanel>> = null;
let sutartisPanel: Awaited<ReturnType<typeof findSutartisPanel>> = null;
let errorMessage = '';
if (!showHome) {
  try {
    const panelsStart = performance.now();
    let juridinisDuration = 0;
    let bvpzDuration = 0;
    let sutartisDuration = 0;
    const timedJuridinis = async () => {
      const start = performance.now();
      const panel = await findSingleJuridinisPanel(q);
      juridinisDuration = performance.now() - start;
      return panel;
    };
    const timedBvpz = async () => {
      const start = performance.now();
      const panel = await findSingleBvpzPanel(q);
      bvpzDuration = performance.now() - start;
      return panel;
    };
    const timedSutartis = async () => {
      const start = performance.now();
      const panel = await findSutartisPanel(q);
      sutartisDuration = performance.now() - start;
      return panel;
    };
    [result, juridinisPanel, bvpzPanel, sutartisPanel] = await Promise.all([
      searchDokumentai({
        q,
        page,
        klase: rawClassFilter,
        type: rawTypeFilter,
        host: rawHostFilter,
        jar: rawJarFilter,
        istaiga: rawIstaigaFilter,
        ext: rawExtFilter,
        author: rawAuthorFilter,
        creator: rawCreatorFilter,
        producer: rawProducerFilter,
        lang: rawLangFilter,
        sav: rawSavFilter,
        apskritis: rawApskritisFilter,
        source: rawSourceFilter,
        teismas: rawCourtFilter,
        bylosRusis: rawCaseTypeFilter,
        kategorija: rawCategoryFilter,
        teisejas: rawJudgeFilter,
        minLat: rawArea.minLat,
        maxLat: rawArea.maxLat,
        minLon: rawArea.minLon,
        maxLon: rawArea.maxLon,
        sort: requestedSort,
        mode,
      }),
      timedJuridinis(),
      timedBvpz(),
      timedSutartis(),
    ]);
    result.timings.push(
      { label: 'Juridinis asmuo', phase: 'pg', start: 0, duration: Math.round(juridinisDuration) },
      { label: 'BVPŽ kodas', phase: 'pg', start: 0, duration: Math.round(bvpzDuration) },
      { label: 'Sutartis', phase: 'pg', start: 0, duration: Math.round(sutartisDuration) },
    );
    const totalElapsed = performance.now() - panelsStart;
    result.elapsed = (totalElapsed / 1000).toFixed(2);
  } catch (err) {
    errorMessage = err instanceof Error ? err.message : 'Paieška nepavyko.';
  }
}

// Empty-search home: a Quickwit-aggregated portrait of the whole corpus.
const homeOverview = showHome ? await dokumentaiHomeOverview() : null;

const classFilter = result?.classFilter ?? [];
const typeFilter = result?.typeFilter ?? [];
const hostFilter = result?.hostFilter ?? [];
const jarFilter = result?.jarFilter ?? [];
const istaigaJarFilter = result?.istaigaJarFilter ?? [];
const extFilter = result?.extFilter ?? [];
const authorFilter = result?.authorFilter ?? [];
const creatorFilter = result?.creatorFilter ?? [];
const producerFilter = result?.producerFilter ?? [];
const langFilter = result?.langFilter ?? [];
const savFilter = result?.savFilter ?? [];
const apskritisFilter = result?.apskritisFilter ?? [];
const sourceFilter = result?.sourceFilter ?? [];
const courtFilter = result?.courtFilter ?? [];
const caseTypeFilter = result?.caseTypeFilter ?? [];
const categoryFilter = result?.categoryFilter ?? [];
const judgeFilter = result?.judgeFilter ?? [];
const typeCountMap = result?.typeCountMap ?? {};
const classCountMap = result?.classCountMap ?? {};
const hostOptions: FacetOption[] = result?.hostOptions ?? [];
const istaigaJarOptions: FacetOption[] = result?.istaigaJarOptions ?? [];
const extOptions: FacetOption[] = result?.extOptions ?? [];
const authorOptions: FacetOption[] = result?.authorOptions ?? [];
const creatorOptions: FacetOption[] = result?.creatorOptions ?? [];
const producerOptions: FacetOption[] = result?.producerOptions ?? [];
const langOptions: FacetOption[] = result?.langOptions ?? [];
const savOptions: FacetOption[] = result?.savOptions ?? [];
const apskritisOptions: FacetOption[] = result?.apskritisOptions ?? [];
const sourceOptions: FacetOption[] = result?.sourceOptions ?? [];
const courtOptions: FacetOption[] = result?.courtOptions ?? [];
const caseTypeOptions: FacetOption[] = result?.caseTypeOptions ?? [];
const categoryOptions: FacetOption[] = result?.categoryOptions ?? [];
const judgeOptions: FacetOption[] = result?.judgeOptions ?? [];
const bbox = result?.bbox ?? null;
const hits: DokumentasHit[] = result?.hits ?? [];
const sort: DokumentaiSort = result?.sort ?? 'relevance';

const TIPAS_OPTS = [
  { value: 'crawledPage', label: 'Tinklalapis' },
  { value: 'failas', label: 'Failas' },
  { value: 'teisesAktas', label: 'Teisės aktas' },
  { value: 'teismoNuosprendis', label: 'Teismo nuosprendis' },
];
const TYPE_LABEL: Record<string, string> = Object.fromEntries(TIPAS_OPTS.map((o) => [o.value, o.label]));

function fmt(n: number | null | undefined) {
  return n != null ? Number(n).toLocaleString('lt-LT') : '';
}
function fmtDate(value: Date | string | null | undefined) {
  return value ? new Date(value).toLocaleDateString('lt-LT') : null;
}
function dateKey(value: Date | string | null | undefined) {
  return value ? new Date(value).toISOString().slice(0, 10) : null;
}
const urlState: DokumentaiUrlState = {
  q,
  mode,
  sort,
  klase: classFilter,
  type: typeFilter,
  host: hostFilter,
  jar: jarFilter,
  istaiga: istaigaJarFilter,
  ext: extFilter,
  author: authorFilter,
  creator: creatorFilter,
  producer: producerFilter,
  lang: langFilter,
  sav: savFilter,
  apskritis: apskritisFilter,
  source: sourceFilter,
  teismas: courtFilter,
  bylosRusis: caseTypeFilter,
  kategorija: categoryFilter,
  teisejas: judgeFilter,
  area: bbox,
};
const buildUrl = (overrides: DokumentaiUrlOverrides = {}) => buildDokumentaiUrl(urlState, overrides);
const areaClearUrl = buildUrl({ area: null });
const classToggleUrl = (v: string) => buildUrl({ klase: v ? toggleValue(classFilter, v) : [] });
const typeToggleUrl = (v: string) => buildUrl({ type: v ? toggleValue(typeFilter, v) : [] });
const hostToggleUrl = (v: string) => buildUrl({ host: v ? toggleValue(hostFilter, v) : [] });
const jarToggleUrl = (v: string) => buildUrl({ jar: v ? toggleValue(jarFilter, v) : [] });
const istaigaToggleUrl = (v: string) => buildUrl({ istaiga: v ? toggleValue(istaigaJarFilter, v) : [] });
const extToggleUrl = (v: string) => buildUrl({ ext: v ? toggleValue(extFilter, v) : [] });
const authorToggleUrl = (v: string) => buildUrl({ author: v ? toggleValue(authorFilter, v) : [] });
const creatorToggleUrl = (v: string) => buildUrl({ creator: v ? toggleValue(creatorFilter, v) : [] });
const producerToggleUrl = (v: string) => buildUrl({ producer: v ? toggleValue(producerFilter, v) : [] });
const langToggleUrl = (v: string) => buildUrl({ lang: v ? toggleValue(langFilter, v) : [] });
const savToggleUrl = (v: string) => buildUrl({ sav: v ? toggleValue(savFilter, v) : [] });
const apskritisToggleUrl = (v: string) => buildUrl({ apskritis: v ? toggleValue(apskritisFilter, v) : [] });
const sourceToggleUrl = (v: string) => buildUrl({ source: v ? toggleValue(sourceFilter, v) : [] });
const courtToggleUrl = (v: string) => buildUrl({ teismas: v ? toggleValue(courtFilter, v) : [] });
const caseTypeToggleUrl = (v: string) => buildUrl({ bylosRusis: v ? toggleValue(caseTypeFilter, v) : [] });
const categoryToggleUrl = (v: string) => buildUrl({ kategorija: v ? toggleValue(categoryFilter, v) : [] });
const judgeToggleUrl = (v: string) => buildUrl({ teisejas: v ? toggleValue(judgeFilter, v) : [] });
const buildPageUrl = (page: number) => buildUrl({ page });
const clearUrl = (() => {
  const sp = new URLSearchParams();
  if (q) sp.set('search', q);
  sp.set('mode', mode);
  if (sort !== 'relevance') sp.set('sort', sort);
  const qs = sp.toString();
  return qs ? `/dokumentai?${qs}` : '/dokumentai';
})();

const HOST_LIMIT = 6;
const EXT_LIMIT = 6;
const { visible: hostVisible, hidden: hostHidden } = splitFacetOptions(hostOptions, hostFilter, HOST_LIMIT);
const { visible: istaigaVisible, hidden: istaigaHidden } = splitFacetOptions(istaigaJarOptions, istaigaJarFilter, HOST_LIMIT);
const { visible: extVisible, hidden: extHidden } = splitFacetOptions(extOptions, extFilter, EXT_LIMIT);
const { visible: authorVisible, hidden: authorHidden } = splitFacetOptions(authorOptions, authorFilter, EXT_LIMIT);
const { visible: creatorVisible, hidden: creatorHidden } = splitFacetOptions(creatorOptions, creatorFilter, EXT_LIMIT);
const { visible: producerVisible, hidden: producerHidden } = splitFacetOptions(producerOptions, producerFilter, EXT_LIMIT);

const LANG_LABEL: Record<string, string> = {
  lt: 'Lietuvių', en: 'Anglų', ru: 'Rusų', de: 'Vokiečių', fr: 'Prancūzų',
  pl: 'Lenkų', lv: 'Latvių', et: 'Estų', uk: 'Ukrainiečių',
};
const SOURCE_LABEL: Record<string, string> = {
  sutartys: 'Sutartys',
  archive: 'Archyvas',
  cvpp: 'CVPP',
  cvpis: 'CVP IS',
  mvpaprasai: 'MVP tvarkos',
  neskelbiamosderybos: 'Neskelbiamos derybos',
  liteko: 'LITEKO',
};
// Klasė = plati dokumento sritis (viešieji pirkimai vs teisė).
const CLASS_LABEL: Record<string, string> = {
  viesiejiPirkimai: 'Viešieji pirkimai',
  teise: 'Teisė',
};
const CLASS_OPTS = [
  { value: 'viesiejiPirkimai', label: 'Viešieji pirkimai' },
  { value: 'teise', label: 'Teisė' },
];
// Nuosprendžių (teisė) facetai rodomi tik kai pasirinkta „teise" klasė arba aktyvus
// kuris nors nuosprendžių filtras.
const showVerdictFacets = classFilter.includes('teise')
  || courtFilter.length > 0 || caseTypeFilter.length > 0
  || categoryFilter.length > 0 || judgeFilter.length > 0;
const { visible: sourceVisible, hidden: sourceHidden } = splitFacetOptions(sourceOptions, sourceFilter, 8);
const { visible: langVisible, hidden: langHidden } = splitFacetOptions(langOptions, langFilter, 8);
const { visible: savVisible, hidden: savHidden } = splitFacetOptions(savOptions, savFilter, 6);
const { visible: apskritisVisible, hidden: apskritisHidden } = splitFacetOptions(apskritisOptions, apskritisFilter, 6);
const { visible: courtVisible, hidden: courtHidden } = splitFacetOptions(courtOptions, courtFilter, 8);
const { visible: caseTypeVisible, hidden: caseTypeHidden } = splitFacetOptions(caseTypeOptions, caseTypeFilter, 8);
const { visible: categoryVisible, hidden: categoryHidden } = splitFacetOptions(categoryOptions, categoryFilter, 8);
const { visible: judgeVisible, hidden: judgeHidden } = splitFacetOptions(judgeOptions, judgeFilter, 8);

const activeFilterCount = classFilter.length + typeFilter.length + hostFilter.length + jarFilter.length + istaigaJarFilter.length + extFilter.length
  + authorFilter.length + creatorFilter.length + producerFilter.length
  + langFilter.length + savFilter.length + apskritisFilter.length + sourceFilter.length
  + courtFilter.length + caseTypeFilter.length + categoryFilter.length + judgeFilter.length + (bbox ? 1 : 0);

const totalPages = result?.totalPages ?? 0;
const pageNums = result?.pageNums ?? [];

// Results meta: count + a hoverable duration that reveals the per-phase timing
// waterfall (which engine/index, how long each step took). Mirrors the sutarčių
// paieškos `(0.25s, quickwit)` source on the home page.
const resultsMetaHtml = (() => {
  const prefix = result?.approximate ? 'Apie ' : '';
  const count = (result?.total ?? 0).toLocaleString('lt-LT');
  const elapsed = result?.elapsed ?? '';
  const engine = result?.engine ?? '';
  const timings = result?.timings ?? [];
  const timingsAttr = timings.length
    ? ` data-timings='${JSON.stringify(timings).replace(/'/g, '&#39;')}'`
    : '';
  const source = `<span class="timing-source"${timingsAttr}>(${elapsed} s · ${engine})</span>`;
  return `${prefix}${count} rezultatų ${source}`;
})();

// Torn-edge zigzag for the mobile knowledge panel. A whole number of teeth
// spanning the full viewBox width, stretched edge-to-edge with
// preserveAspectRatio="none" so peaks always land exactly on both corners (the
// tear meets the side borders cleanly). `tearLine` is the stroked seam;
// `tearFill` closes it off below to erase the straight cut underneath.
const TEAR_TEETH = 16;
const TEAR_UNIT = 20;                       // viewBox units per tooth
const TEAR_W = TEAR_TEETH * TEAR_UNIT;      // total viewBox width
const TEAR_H = 10;                          // viewBox height (px-ish)
const TEAR_PEAK = 1;                        // y of peaks (leave room for stroke)
const TEAR_VALLEY = 8;                      // y of valleys
let tearZig = `M0 ${TEAR_PEAK}`;
for (let i = 0; i < TEAR_TEETH; i++) {
  const mid = i * TEAR_UNIT + TEAR_UNIT / 2;
  const end = (i + 1) * TEAR_UNIT;
  tearZig += ` L${mid} ${TEAR_VALLEY} L${end} ${TEAR_PEAK}`;
}
const tearLine = tearZig;
const tearFill = `${tearZig} L${TEAR_W} ${TEAR_H} L0 ${TEAR_H} Z`;

// ── Home overview view-model ─────────────────────────────────────────────────
// Compact Lithuanian number for the dense facet counts (6,9 mln. / 77 tūkst.).
function fmtCompact(n: number | null | undefined): string {
  const v = Number(n ?? 0);
  if (!Number.isFinite(v)) return '0';
  if (v >= 1e9) return (v / 1e9).toFixed(1).replace('.', ',') + ' mlrd.';
  if (v >= 1e6) return (v / 1e6).toFixed(1).replace('.', ',') + ' mln.';
  if (v >= 1e4) return Math.round(v / 1e3).toLocaleString('lt-LT') + ' tūkst.';
  return v.toLocaleString('lt-LT');
}
const ov = homeOverview;
const homeReady = !!ov && ov.total > 0;
const istaigaMax = Math.max(1, ...(ov?.topIstaiga.map((i) => i.count ?? 0) ?? [0]));
const pct = (n: number | null | undefined, max: number) => Math.round(((n ?? 0) / max) * 100);

// Document-size distributions (pages / words / characters percentiles). Counts
// span a few orders of magnitude, so positions are placed on a log scale
// (p10→p99 maps to 0→100%); the interquartile band and median are highlighted.
const sizeMetrics = ov?.sizeMetrics ?? [];
function distModel(m: typeof sizeMetrics[number]) {
  const lo = Math.max(1, m.percentiles[0].value);
  const hi = Math.max(lo + 1, m.percentiles[m.percentiles.length - 1].value);
  const logLo = Math.log(lo);
  const span = Math.log(hi) - logLo || 1;
  const pos = (v: number) => Math.max(0, Math.min(100, ((Math.log(Math.max(1, v)) - logLo) / span) * 100));
  const find = (p: number) => m.percentiles.find((x) => x.p === p)?.value ?? 0;
  return {
    ticks: m.percentiles.map((t, i, a) => ({
      ...t, pos: pos(t.value), edge: i === 0 ? 'start' : i === a.length - 1 ? 'end' : 'mid',
    })),
    iqrFrom: pos(find(25)),
    iqrTo: pos(find(75)),
    medianPos: pos(m.median),
    p25: find(25), p75: find(75), p90: find(90),
  };
}
---

<Layout
  pageTitle="Dokumentų paieška"
  pageDescription="Viešųjų pirkimų ir su jais susijusių dokumentų paieška pagal pavadinimą, autorių ir turinį."
  colorScheme={colorScheme}
  font={font}
>
  <main class={showHome ? '' : 'sidebar-main'}>
    {showHome ? (
      <>
        <div class="dok-hero-search">
          <SearchForm
            title="Dokumentų paieška"
            searchValue={q}
            searchPlaceholder="Ieškoti dokumentų…"
            searchModes={true}
            searchMode={mode}
          />
        </div>
        {homeReady && ov ? (
          <div class="dok-home" id="dokHome">
            <h2 class="dok-home-title">Statistika</h2>

            <section class="dok-home-hero">
              <div class="dok-home-hero-main">
                <span class="dok-home-hero-approx">apie</span>
                <span class="dok-home-hero-num">{ov.total.toLocaleString('lt-LT')}</span>
                <Linksnis class="dok-home-hero-unit" n={ov.total} forms={['dokumentas', 'dokumentai', 'dokumentų', 'dokumento']} showNumber={false} />
              </div>
              <div class="dok-home-hero-sub">
                <span><strong>{fmtCompact(ov.totalPages)}</strong> puslapių</span>
                <span class="dok-home-hero-dot" aria-hidden="true"></span>
                <span><strong>{fmtCompact(ov.totalWords)}</strong> žodžių</span>
              </div>
            </section>

            {ov.byClass.length > 0 && (
              <section class="dok-home-classes">
                {ov.byClass.map((c) => (
                  <a class="dok-home-class-pill" href={`/dokumentai?klase=${encodeURIComponent(c.value)}`}>
                    {CLASS_LABEL[c.value] || c.value}
                    <span class="dok-home-class-count">{fmtCompact(c.count)}</span>
                  </a>
                ))}
              </section>
            )}

            {sizeMetrics.length > 0 && (
              <section class="dok-home-block">
                <div class="dok-home-dist-head">
                  <h2 class="dok-home-h">Dokumentų apimtis</h2>
                  {sizeMetrics.length > 1 && (
                    <div class="dok-home-dist-toggle" role="tablist" aria-label="Matas">
                      {sizeMetrics.map((m, i) => (
                        <button type="button" class={`dok-home-dist-tab${i === 0 ? ' is-active' : ''}`} data-metric={m.key} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>
                          {m.label}
                        </button>
                      ))}
                    </div>
                  )}
                </div>
                {sizeMetrics.map((m, i) => {
                  const d = distModel(m);
                  return (
                    <div class="dok-home-dist" data-metric={m.key} hidden={i !== 0}>
                      <div class="dok-home-dist-track" role="img" aria-label={`Dokumentų apimtis (${m.unit}): mediana ${fmt(m.median)}`}>
                        <span class="dok-home-dist-iqr" style={`--from:${d.iqrFrom}%;--w:${d.iqrTo - d.iqrFrom}%`} aria-hidden="true"></span>
                        <span class="dok-home-dist-median" style={`--pos:${d.medianPos}%`} aria-hidden="true"></span>
                      </div>
