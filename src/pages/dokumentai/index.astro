---
import Layout from '../../layouts/Layout.astro';
import SearchForm from '@design-system/components/content/SearchForm.astro';
import SearchSuggest from '@design-system/components/content/SearchSuggest.astro';
import TimingWaterfall from '@design-system/components/TimingWaterfall.astro';
import EmptyState from '@design-system/components/EmptyState.astro';
import DokumentaiStatsPanel from '../../components/dokumentai/DokumentaiStatsPanel.astro';
import DokFilters from '../../components/dokumentai/DokFilters.astro';
import DokResults from '../../components/dokumentai/DokResults.astro';
import DokHomeOverview from '../../components/dokumentai/DokHomeOverview.astro';
import DokKnowledgePanel from '../../components/dokumentai/DokKnowledgePanel.astro';
import DokFacetModal from '../../components/dokumentai/DokFacetModal.astro';
import DokAreaModal from '../../components/dokumentai/DokAreaModal.astro';
import config from '../../lib/config.ts';
import { getColorScheme, getFont } from '../../lib/failai.js';
import { loadDokumentaiPage } from '../../lib/dokumentaiPageData.ts';

if (!config.enableDokumentaiSearch) return Astro.redirect('/');

const data = await loadDokumentaiPage(Astro.url);
if (data.redirect) return Astro.redirect(data.redirect);

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const {
  showHome, errorMessage, q, mode, homeOverview, urlState,
  sutartisPanel, juridinisPanel, bvpzPanel, filterStats,
  filtersProps, resultsProps,
} = data;
---

<Layout
  pageTitle="Dokumentų paieška"
  pageDescription="Viešųjų pirkimų ir su jais susijusių dokumentų paieška pagal pavadinimą, autorių ir turinį."
  colorScheme={colorScheme}
  font={font}
>
  <main class={showHome ? '' : 'sidebar-main'}>
    {showHome ? (
      <>
        <div class="dok-hero-search">
          <SearchForm
            title="Dokumentų paieška"
            searchValue={q}
            searchPlaceholder="Ieškoti dokumentų…"
            searchModes={true}
            searchMode={mode}
          >
            <sup slot="title-badge" class="dok-beta">BETA</sup>
          </SearchForm>
        </div>
        <DokHomeOverview overview={homeOverview} />
      </>
    ) : errorMessage ? (
      <div class="dok-error">
        <SearchForm
          title="Dokumentų paieška"
          searchValue={q}
          searchPlaceholder="Ieškoti dokumentų…"
          searchModes={true}
          searchMode={mode}
        >
          <sup slot="title-badge" class="dok-beta">BETA</sup>
        </SearchForm>
        <EmptyState message={errorMessage} />
      </div>
    ) : (
      <div class="dok-shell">
        <DokFilters {...filtersProps} />

        <div class="dok-search">
          <SearchForm
            title="Dokumentų paieška"
            searchValue={q}
            searchPlaceholder="Ieškoti dokumentų…"
            hideTitle={true}
            searchModes={true}
            searchMode={mode}
          />
        </div>

        <div class="dok-content" id="dokContent">
          <div class="dok-loading" aria-hidden="true"><span class="spinner spinner-lg"></span></div>
          <DokResults {...resultsProps} />
        </div>
        {(sutartisPanel || juridinisPanel || bvpzPanel || filterStats) && (
          <div class="dok-panel" id="dokPanel">
            <DokKnowledgePanel
              sutartisPanel={sutartisPanel}
              juridinisPanel={juridinisPanel}
              bvpzPanel={bvpzPanel}
            />
            {filterStats && <DokumentaiStatsPanel stats={filterStats} urlState={urlState} />}
          </div>
        )}

        <DokFacetModal />
        <DokAreaModal />
      </div>
    )}
    <SearchSuggest />
    <TimingWaterfall />
  </main>
</Layout>

<style is:global>
  /* Belt-and-braces against any horizontal overflow from the full-bleed
     two-column layout (e.g. the filter hover pills that bleed a few px). */
  html:has(main.sidebar-main),
  html:has(main.sidebar-main) body {
    overflow-x: clip;
  }

  /* Opt in to animating to/from intrinsic sizes (height: auto). Lets the
     mobile knowledge-panel "Rodyti daugiau" reveal transition its height
     from the collapsed peek to auto. Ignored gracefully where unsupported
     (the reveal just snaps open). */
  :root {
    interpolate-size: allow-keywords;
  }

  /* The search form sits in its own row above the results/panel (no big
     centred title). Drop its hero margins/centring so the bar fills the
     column, left-aligned with the results, and its top sits level with the
     "Filtrai" rail. Scoped by .dok-search, which only exists on this page. */
  .dok-search #searchForm {
    margin: 0 0 24px;
    align-items: stretch;
  }
  .dok-search #searchForm .search-bar {
    max-width: none;
  }

  /* Perjungus režimą kraunasi rezultatai: režimo perjungiklį padarom inertišką
     ir paslepiam jo tooltip'ą, kad nekabėtų virš krovimo. */
  .dok-shell:has(.dok-content.is-loading) .search-mode {
    pointer-events: none;
  }
  .dok-shell:has(.dok-content.is-loading) .search-mode-opt::after {
    opacity: 0 !important;
  }
</style>

<style>
  /* BETA žymė greta antraštės (superscript'u, bet ne <h1> viduje). */
  .dok-beta {
    align-self: flex-start;
    margin-top: 0.15em;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: var(--lightest-gray);
    color: var(--gray);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  /* Spacing scale (matches Tailwind's 4-based steps used elsewhere)
     2px • 4 • 8 • 12 • 16 • 24 • 32 • 48 • 64                       */

  .dok-error { margin-top: 32px; }

  /* Empty-search home: a touch more breathing room above the title + search box.
     Plain block (full width preserved) — only this page; the shared SearchForm
     keeps its own defaults. */
  .dok-hero-search { padding-top: 6vh; }


  /* Left-anchored two-column block: a quiet rail of filters, then a capped
     results column (Google-style — results hug the left, the right stays
     open). The inline padding matches the site's normal page gutter so the
     rail lines up with where every other page's content begins.           */
  .dok-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 760px) minmax(360px, 460px);
    /* The search bar gets its own row so the knowledge panel can start level
       with the results below it, not next to the search bar. The cell to the
       right of the search bar (row 1, col 3) stays empty. */
    grid-template-areas:
      "sidebar search  ."
      "sidebar content panel";
    /* Keep the tall, row-spanning filter rail from stretching the search row.
       105px = 24px top padding + 57px search bar + 24px bottom margin. */
    grid-template-rows: 105px auto;
    column-gap: 32px;
    justify-content: start;
    /* stretch: the filter rail matches the results' height and its divider
       runs the full length of the page. */
    align-items: stretch;
    /* Match the navbar's 16px gutter so the filter rail lines up exactly
       under the logo — the whole left edge reads as one vertical line.
       No vertical padding here: the breath below the navbar lives INSIDE
       each column, so the divider runs from the very top to the bottom.  */
    padding-inline: 16px;
  }

  /* The search bar lives in its own grid row above the results, so the panel
     beside the results can start level with the top of the results. Its top
     padding matches the sidebar's so the bar and "Filtrai" start on the same
     line, both breathing below the navbar. */
  .dok-search {
    grid-area: search;
    padding-top: 24px;
  }

  /* ── Result list: flat, no outer container. Width and side air come
     from the grid column + gap, so the column itself carries no padding. */
  .dok-content {
    grid-area: content;
    min-width: 0;
    position: relative;
  }
  /* Loading veil: each filter / page click triggers a full server round-trip,
     so dim the current results and float a spinner while the next page loads.
     Reassurance beats a frozen screen. */
  .dok-loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 80px;
    background: color-mix(in oklab, var(--white) 70%, transparent);
    backdrop-filter: blur(1px);
    /* Purely a visual veil — never swallow clicks, so filters stay usable
       while the next page loads. */
    pointer-events: none;
  }
  .dok-content.is-loading .dok-loading { display: flex; }
  @media (prefers-reduced-motion: reduce) {
    .dok-loading .spinner { animation-duration: 1.4s; }
  }

  /* ── Knowledge panel wrapper ─────────────────────────────────────
     On desktop/tablet it's a transparent passthrough — the card shows in
     full. The collapse-to-a-peek + torn edge + "Rodyti daugiau" reveal only
     kicks in on phones (see the ≤900px block). */
  .dok-panel {
    grid-area: panel;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* ── Responsive ──────────────────────────────────────────────── */
  @media (max-width: 1400px) {
    .dok-shell {
      grid-template-columns: 240px minmax(0, 760px);
      grid-template-areas:
        "sidebar search"
        "sidebar content"
        "sidebar panel";
      grid-template-rows: 105px auto auto;
    }
    .dok-panel {
      margin: 24px 0 48px;
    }
  }

  @media (max-width: 900px) {
    .dok-shell {
      /* minmax(0, 1fr), not 1fr: a bare 1fr track is minmax(auto, 1fr), whose
         auto minimum grows to the widest child's min-content (the sidebar
         filter options), forcing the single column — and the whole page —
         wider than the viewport. minmax(0,…) lets the column shrink. */
      grid-template-columns: minmax(0, 1fr);
      /* The knowledge card sits above the results on phones — its peek is the
         answer; the result list is the long tail below it. */
      grid-template-areas:
        "sidebar"
        "search"
        "panel"
        "content";
      grid-template-rows: auto;
      column-gap: 0;
    }
    .dok-search { padding-top: 16px; }

    .dok-panel {
      margin: 16px 0 24px;
    }
  }
</style>
