---
import Layout from '../../layouts/Layout.astro';
import SearchForm from '@design-system/components/content/SearchForm.astro';
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import EmptyState from '@design-system/components/EmptyState.astro';
import config from '../../lib/config.ts';
import { getColorScheme, getFont } from '../../lib/failai.js';
import { searchDokumentai, extractInlineTokens, type DokumentasHit, type FacetOption } from '../../lib/searchDokumentai.ts';

if (!config.enableDokumentaiSearch) return Astro.redirect('/');

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const url = Astro.url;
const params = url.searchParams;
const q = (params.get('search') ?? params.get('q') ?? '').trim();
const page = Math.max(1, parseInt(params.get('page') ?? params.get('p') ?? '1', 10) || 1);

const rawTypeFilter = params.getAll('type').flatMap((v) => v.split(','));
const rawHostFilter = params.getAll('host').flatMap((v) => v.split(','));
const rawJarFilter = params.getAll('jar').flatMap((v) => v.split(','));
const rawExtFilter = params.getAll('ext').flatMap((v) => v.split(','));

// Promote inline `type:`/`host:`/`jar:`/`ext:` tokens out of the search box.
{
  const { textQuery, types, hosts, jars, exts } = extractInlineTokens(q);
  if (types.length || hosts.length || jars.length || exts.length) {
    const sp = new URLSearchParams();
    if (textQuery) sp.set('search', textQuery);
    const merge = (existing: string[], incoming: string[]) =>
      [...new Set([...existing.map((v) => v.trim()).filter(Boolean), ...incoming])];
    const t = merge(rawTypeFilter, types);
    const h = merge(rawHostFilter, hosts);
    const j = merge(rawJarFilter, jars);
    const e = merge(rawExtFilter, exts.map((x) => x.toLowerCase()));
    if (t.length) sp.set('type', t.join(','));
    if (h.length) sp.set('host', h.join(','));
    if (j.length) sp.set('jar', j.join(','));
    if (e.length) sp.set('ext', e.join(','));
    if (page > 1) sp.set('page', String(page));
    return Astro.redirect(`/dokumentai?${sp.toString()}`);
  }
}

const hasFilters = rawTypeFilter.length || rawHostFilter.length || rawJarFilter.length || rawExtFilter.length;
const showHome = !q && !hasFilters;

let result: Awaited<ReturnType<typeof searchDokumentai>> | null = null;
let errorMessage = '';
if (!showHome) {
  try {
    result = await searchDokumentai({
      q,
      page,
      type: rawTypeFilter,
      host: rawHostFilter,
      jar: rawJarFilter,
      ext: rawExtFilter,
    });
  } catch (err) {
    errorMessage = err instanceof Error ? err.message : 'Paieška nepavyko.';
  }
}

const typeFilter = result?.typeFilter ?? [];
const hostFilter = result?.hostFilter ?? [];
const jarFilter = result?.jarFilter ?? [];
const extFilter = result?.extFilter ?? [];
const typeCountMap = result?.typeCountMap ?? {};
const hostOptions: FacetOption[] = result?.hostOptions ?? [];
const extOptions: FacetOption[] = result?.extOptions ?? [];
const hits: DokumentasHit[] = result?.hits ?? [];

const TIPAS_OPTS = [
  { value: 'crawledPage', label: 'Tinklalapis' },
  { value: 'failas', label: 'Failas' },
  { value: 'teisesAktas', label: 'Teisės aktas' },
  { value: 'teismoNuosprendis', label: 'Teismo nuosprendis' },
];
const TYPE_LABEL: Record<string, string> = Object.fromEntries(TIPAS_OPTS.map((o) => [o.value, o.label]));

function fmt(n: number | null | undefined) {
  return n != null ? Number(n).toLocaleString('lt-LT') : '';
}
function buildUrl(overrides: { type?: string[]; host?: string[]; jar?: string[]; ext?: string[]; p?: number | null }) {
  const t = overrides.type ?? typeFilter;
  const h = overrides.host ?? hostFilter;
  const j = overrides.jar ?? jarFilter;
  const e = overrides.ext ?? extFilter;
  const p = overrides.p ?? null;
  const sp = new URLSearchParams();
  if (q) sp.set('search', q);
  if (t.length) sp.set('type', t.join(','));
  if (h.length) sp.set('host', h.join(','));
  if (j.length) sp.set('jar', j.join(','));
  if (e.length) sp.set('ext', e.join(','));
  if (p) sp.set('page', String(p));
  return `/dokumentai?${sp.toString()}`;
}
function toggle(list: string[], val: string) {
  return list.includes(val) ? list.filter((v) => v !== val) : [...list, val];
}
const typeToggleUrl = (v: string) => buildUrl({ type: v ? toggle(typeFilter, v) : [] });
const hostToggleUrl = (v: string) => buildUrl({ host: v ? toggle(hostFilter, v) : [] });
const jarToggleUrl = (v: string) => buildUrl({ jar: v ? toggle(jarFilter, v) : [] });
const extToggleUrl = (v: string) => buildUrl({ ext: v ? toggle(extFilter, v) : [] });
const buildPageUrl = (p: number) => buildUrl({ p });
const clearUrl = q ? `/dokumentai?search=${encodeURIComponent(q)}` : '/dokumentai';

const shownHosts: FacetOption[] = [...hostOptions];
for (const sel of hostFilter) {
  if (!shownHosts.find((o) => o.value === sel)) shownHosts.unshift({ value: sel, count: null });
}
const HOST_LIMIT = 6;
const hostVisible = shownHosts.slice(0, HOST_LIMIT);
const hostHidden = shownHosts.slice(HOST_LIMIT);

const shownExts: FacetOption[] = [...extOptions];
for (const sel of extFilter) {
  if (!shownExts.find((o) => o.value === sel)) shownExts.unshift({ value: sel, count: null });
}
const EXT_LIMIT = 6;
const extVisible = shownExts.slice(0, EXT_LIMIT);
const extHidden = shownExts.slice(EXT_LIMIT);

const PAGINATION_LETTERS = ['D', 'o', 'k', 'u', 'm', 'e', 'n', 't', 'a', 'i'];
const totalPages = result?.totalPages ?? 0;
const pageNums = result?.pageNums ?? [];
const showLetters = pageNums.length >= PAGINATION_LETTERS.length;
---

<Layout
  pageTitle="Dokumentų paieška"
  pageDescription="Viešųjų pirkimų ir su jais susijusių dokumentų paieška pagal pavadinimą, autorių ir turinį."
  colorScheme={colorScheme}
  font={font}
>
  <main class={showHome ? '' : 'sidebar-main'}>
    {showHome ? (
      <>
        <SearchForm
          title="Dokumentų paieška"
          searchValue={q}
          searchPlaceholder="Ieškoti dokumentų…"
        />
        <section class="dok-intro">
          <p class="text-muted text-sm">
            Tinklalapiai, failai, teisės aktai, teismo nuosprendžiai – paieška pagal pavadinimą, autorių ar turinį.
          </p>
        </section>
      </>
    ) : errorMessage ? (
      <div class="dok-error">
        <SearchForm
          title="Dokumentų paieška"
          searchValue={q}
          searchPlaceholder="Ieškoti dokumentų…"
        />
        <EmptyState message={errorMessage} />
      </div>
    ) : (
      <div class="dok-shell">
        <aside class="dok-sidebar" id="dokSidebar" aria-label="Filtrai">
          <div class="dok-sidebar-head">
            <span class="dok-sidebar-title">Filtrai</span>
            {hasFilters && <a href={clearUrl} class="dok-sidebar-clear">Panaikinti</a>}
          </div>

          <section class="dok-filter-section">
            <span class="dok-filter-section-label">Tipas</span>
            <a href={typeToggleUrl('')} class={`dok-filter-opt${typeFilter.length === 0 ? ' is-selected' : ''}`}>
              <span class="dok-filter-opt-label">Visi</span>
            </a>
            {TIPAS_OPTS.map((opt) => {
              const cnt = typeCountMap[opt.value];
              if (cnt == null && !typeFilter.includes(opt.value)) return null;
              return (
                <a href={typeToggleUrl(opt.value)} class={`dok-filter-opt${typeFilter.includes(opt.value) ? ' is-selected' : ''}`}>
                  <span class="dok-filter-opt-label">{opt.label}</span>
                  {cnt != null && <span class="dok-filter-opt-count">{fmt(cnt)}</span>}
                </a>
              );
            })}
          </section>

          <section class="dok-filter-section">
            <span class="dok-filter-section-label">Puslapis</span>
            {(hostVisible.length > 0 || hostFilter.length > 0) && (
              <a href={hostToggleUrl('')} class={`dok-filter-opt${hostFilter.length === 0 ? ' is-selected' : ''}`}>
                <span class="dok-filter-opt-label">Visi</span>
              </a>
            )}
            {hostVisible.map((opt) => (
              <a href={hostToggleUrl(opt.value)} class={`dok-filter-opt${hostFilter.includes(opt.value) ? ' is-selected' : ''}`}>
                <span class="dok-filter-opt-label">{opt.value.replace(/^www\./, '')}</span>
                {opt.count != null && <span class="dok-filter-opt-count">{fmt(opt.count)}</span>}
              </a>
            ))}
            {hostHidden.length > 0 && (
              <>
                <div class="dok-more-list" hidden>
                  {hostHidden.map((opt) => (
                    <a href={hostToggleUrl(opt.value)} class={`dok-filter-opt${hostFilter.includes(opt.value) ? ' is-selected' : ''}`}>
                      <span class="dok-filter-opt-label">{opt.value.replace(/^www\./, '')}</span>
                      {opt.count != null && <span class="dok-filter-opt-count">{fmt(opt.count)}</span>}
                    </a>
                  ))}
                </div>
                <button class="dok-more-btn" type="button">Rodyti daugiau</button>
              </>
            )}
            <form class="dok-input-form" id="dok-host-form" autocomplete="off">
              <input id="dok-host-input" type="text" class="dok-input" placeholder="pvz. vpt.lrv.lt" aria-label="Įvesti puslapį" />
              <button type="submit" class="dok-input-btn" aria-label="Pridėti">+</button>
            </form>
          </section>

          <section class="dok-filter-section">
            <span class="dok-filter-section-label">Įmonė (JAR)</span>
            {jarFilter.length > 0 && (
              <a href={jarToggleUrl('')} class="dok-filter-opt is-selected">
                <span class="dok-filter-opt-label">Visi</span>
              </a>
            )}
            {jarFilter.map((code) => (
              <a href={jarToggleUrl(code)} class="dok-filter-opt is-selected">
                <span class="dok-filter-opt-label">{code}</span>
              </a>
            ))}
            <form class="dok-input-form" id="dok-jar-form" autocomplete="off">
              <input id="dok-jar-input" type="text" class="dok-input" placeholder="pvz. 123456789" aria-label="Įvesti JAR kodą" />
              <button type="submit" class="dok-input-btn" aria-label="Pridėti">+</button>
            </form>
          </section>

          <section class="dok-filter-section">
            <span class="dok-filter-section-label">Plėtinys</span>
            {(extVisible.length > 0 || extFilter.length > 0) && (
              <a href={extToggleUrl('')} class={`dok-filter-opt${extFilter.length === 0 ? ' is-selected' : ''}`}>
                <span class="dok-filter-opt-label">Visi</span>
              </a>
            )}
            {extVisible.map((opt) => (
              <a href={extToggleUrl(opt.value)} class={`dok-filter-opt${extFilter.includes(opt.value) ? ' is-selected' : ''}`}>
                <span class="dok-filter-opt-label">.{opt.value}</span>
                {opt.count != null && <span class="dok-filter-opt-count">{fmt(opt.count)}</span>}
              </a>
            ))}
            {extHidden.length > 0 && (
              <>
                <div class="dok-more-list" hidden>
                  {extHidden.map((opt) => (
                    <a href={extToggleUrl(opt.value)} class={`dok-filter-opt${extFilter.includes(opt.value) ? ' is-selected' : ''}`}>
                      <span class="dok-filter-opt-label">.{opt.value}</span>
                      {opt.count != null && <span class="dok-filter-opt-count">{fmt(opt.count)}</span>}
                    </a>
                  ))}
                </div>
                <button class="dok-more-btn" type="button">Rodyti daugiau</button>
              </>
            )}
            <form class="dok-input-form" id="dok-ext-form" autocomplete="off">
              <input id="dok-ext-input" type="text" class="dok-input" placeholder="pvz. pdf" aria-label="Įvesti plėtinį" />
              <button type="submit" class="dok-input-btn" aria-label="Pridėti">+</button>
            </form>
          </section>
        </aside>

        <div class="dok-content">
          <SearchForm
            title="Dokumentų paieška"
            searchValue={q}
            searchPlaceholder="Ieškoti dokumentų…"
          />
          {hits.length > 0 && (
            <p class="dok-results-meta text-xs text-muted">
              {result?.approximate ? 'Apie ' : ''}{(result?.total ?? 0).toLocaleString('lt-LT')} rezultatų ({result?.elapsed} sek.)
            </p>
          )}

          {hits.length === 0 ? (
            <EmptyState message={q ? `Jokių rezultatų pagal „${q}".` : 'Jokių rezultatų.'} />
          ) : (
            <div class="dok-result-list">
              {hits.map((hit) => {
                const domain = (hit.host || hit.domain || '').replace(/^www\./, '');
                const pathPart = hit.url ? hit.url.replace(/^https?:\/\/[^/]+/, '').replace(/^\//, '') : '';
                const title = hit.title || hit.url || hit.md5 || `Dokumentas #${hit.id}`;
                const externalUrl = hit.url || null;
                const internalUrl = hit.failasId ? `/failas/${hit.failasId}` : null;
                const targetUrl = internalUrl || externalUrl || '#';
                const isExternal = !internalUrl && !!externalUrl;
                const happened = hit.happenedAt ? new Date(hit.happenedAt).toLocaleDateString('lt-LT') : null;
                return (
                  <ResultCardShell clickable={true} className="dok-card">
                    <div slot="meta" class="dok-provenance">
                      {domain && <span class="dok-domain">{domain}</span>}
                      {pathPart && (
                        <>
                          <span class="dok-provenance-sep" aria-hidden="true">›</span>
                          <span class="dok-path">{pathPart}</span>
                        </>
                      )}
                    </div>
                    <h3 slot="title" class="result-card-title">
                      <a
                        href={targetUrl}
                        {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}
                      >{title}</a>
                    </h3>
                    {hit.snippet && (
                      <p class="dok-snippet text-sm text-muted mt-2" set:html={hit.snippet} />
                    )}
                    <dl slot="footer" class="result-card-meta dok-meta">
                      {hit.type && <div><dt class="sr-only">Tipas</dt><dd>{TYPE_LABEL[hit.type] || hit.type}</dd></div>}
                      {hit.extension && <div><dt class="sr-only">Plėtinys</dt><dd>{String(hit.extension).toUpperCase()}</dd></div>}
                      {hit.wordCount != null && <div><dt class="sr-only">Žodžiai</dt><dd>{Number(hit.wordCount).toLocaleString('lt-LT')} ž.</dd></div>}
                      {hit.pageCount != null && <div><dt class="sr-only">Puslapiai</dt><dd>{Number(hit.pageCount).toLocaleString('lt-LT')} p.</dd></div>}
                      {hit.language && <div><dt class="sr-only">Kalba</dt><dd>{hit.language}</dd></div>}
                      {happened && <div><dt class="sr-only">Data</dt><dd>{happened}</dd></div>}
                      {hit.istaigaJar && <div><dt class="sr-only">Įstaiga</dt><dd>JAR {hit.istaigaJar}</dd></div>}
                    </dl>
                  </ResultCardShell>
                );
              })}
            </div>
          )}

          {pageNums.length > 0 && (
            <nav class="dok-pagination" aria-label="Puslapiai">
              <div class="dok-pagination-row">
                <div class="dok-page-cell">
                  {showLetters && <span class="dok-page-letter" aria-hidden="true"></span>}
                  {page > 1 ? (
                    <a href={buildPageUrl(page - 1)} class="dok-page-btn dok-page-nav" aria-label="Ankstesnis puslapis">‹</a>
                  ) : (
                    <span class="dok-page-btn dok-page-nav is-disabled" aria-disabled="true">‹</span>
                  )}
                </div>
                {pageNums.map((pn, idx) => {
                  const letter = PAGINATION_LETTERS[idx];
                  return (
                    <div class="dok-page-cell">
                      {showLetters && (
                        letter
                          ? <span class={`dok-page-letter dok-letter-${idx % 2 === 0 ? 'a' : 'b'}`} aria-hidden="true">{letter}</span>
                          : <span class="dok-page-letter" aria-hidden="true"></span>
                      )}
                      {pn === page ? (
                        <span class="dok-page-btn is-current" aria-current="page">{pn}</span>
                      ) : (
                        <a href={buildPageUrl(pn)} class="dok-page-btn">{pn}</a>
                      )}
                    </div>
                  );
                })}
                <div class="dok-page-cell">
                  {showLetters && <span class="dok-page-letter" aria-hidden="true"></span>}
                  {page < totalPages ? (
                    <a href={buildPageUrl(page + 1)} class="dok-page-btn dok-page-nav" aria-label="Kitas puslapis">›</a>
                  ) : (
                    <span class="dok-page-btn dok-page-nav is-disabled" aria-disabled="true">›</span>
                  )}
                </div>
              </div>
            </nav>
          )}
        </div>
      </div>
    )}
  </main>
</Layout>

<script>
  function wireAddForm(formId: string, inputId: string, param: string, transform = (s: string) => s) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById(inputId) as HTMLInputElement | null;
      const val = transform((input?.value ?? '').trim());
      if (!val) return;
      const p = new URLSearchParams(window.location.search);
      const existing = (p.get(param) || '').split(',').map((s) => s.trim()).filter(Boolean);
      if (!existing.includes(val)) existing.push(val);
      p.set(param, existing.join(','));
      p.delete('page');
      window.location.href = '/dokumentai?' + p.toString();
    });
  }
  wireAddForm('dok-host-form', 'dok-host-input', 'host', (s) => s.toLowerCase());
  wireAddForm('dok-jar-form', 'dok-jar-input', 'jar');
  wireAddForm('dok-ext-form', 'dok-ext-input', 'ext', (s) => s.toLowerCase().replace(/^\./, ''));

  document.querySelectorAll<HTMLButtonElement>('.dok-more-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const more = btn.previousElementSibling as HTMLElement | null;
      if (!more || !more.classList.contains('dok-more-list')) return;
      more.hidden = false;
      btn.remove();
    });
  });
</script>

<style is:global>
  /* Override reset.css's `overflow-x: hidden` on html/body which makes
     body a scroll container and breaks `position: sticky` inside.
     `clip` clips without creating a scroll container — sticky works. */
  html:has(main.sidebar-main),
  html:has(main.sidebar-main) body {
    overflow-x: clip;
  }
</style>

<style>
  /* Spacing scale (matches Tailwind's 4-based steps used elsewhere)
     2px • 4 • 8 • 12 • 16 • 24 • 32 • 48 • 64                       */

  .dok-intro {
    margin: 24px auto 0;
    max-width: 480px;
    text-align: center;
  }
  .dok-error { margin-top: 32px; }

  /* Asymmetric two-column rail: narrow quiet sidebar, generous content.
     The column gap is intentionally large so the rail reads as separate
     air, not a panel pressed against the results.                       */
  .dok-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: start;
  }

  /* ── Sidebar: full-height rail that sticks while you scroll ─── */
  .dok-sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    background: var(--lighter-gray);
    border-right: var(--border);
    padding: 16px 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--light-gray) transparent;
  }
  .dok-sidebar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 10px;
    margin-bottom: 2px;
    border-bottom: 1px solid var(--light-gray);
  }
  .dok-sidebar-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--dark-gray);
  }
  .dok-sidebar-clear {
    font-size: var(--text-xs);
    color: var(--dark-gray);
  }
  .dok-sidebar-clear:hover { color: var(--black); }

  /* Generous space between sections, no divider needed inside the
     surface — the surface itself carries the grouping. */
  .dok-filter-section { padding-top: 16px; }
  .dok-filter-section-label {
    display: block;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--gray);
    padding-bottom: 6px;
  }

  /* Filter rows: full-bleed within the surface via negative margins so
     hover/selection wash to the edges. Selection = weight + a 2px rail. */
  .dok-filter-opt {
    display: flex;
    align-items: baseline;
    padding: 4px 12px;
    margin-inline: -12px;
    font-size: var(--text-sm);
    color: var(--dark-gray);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background var(--transition), color var(--transition);
  }
  .dok-filter-opt:hover {
    background: color-mix(in oklab, var(--black) 4%, transparent);
    color: var(--black);
  }
  .dok-filter-opt.is-selected {
    color: var(--black);
    font-weight: 500;
    border-left-color: var(--black);
    background: color-mix(in oklab, var(--black) 5%, transparent);
  }
  .dok-filter-opt-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dok-filter-opt-count {
    font-size: var(--text-xs);
    color: var(--gray);
    font-variant-numeric: tabular-nums;
    margin-left: 12px;
  }

  /* Add-by-text input: visually a different action from the option list. */
  .dok-input-form {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 10px;
  }
  .dok-input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--black);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--light-gray);
    padding: 2px 0;
    outline: none;
  }
  .dok-input:focus { border-bottom-color: var(--black); }
  .dok-input::placeholder { color: var(--gray); }
  .dok-input-btn {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    background: none;
    border: none;
    color: var(--dark-gray);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }
  .dok-input-btn:hover { color: var(--black); }

  .dok-more-btn {
    display: block;
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--dark-gray);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .dok-more-btn:hover { color: var(--black); text-decoration: underline; }

  /* ── Result list: flat, no outer container ───────────────────── */
  .dok-content {
    min-width: 0;
    padding: 8px 24px 0;
    max-width: 760px;
  }
  .dok-results-meta { margin: 0 0 24px; }

  /* Borderless list. A whisper-thin divider lives on each row (except
