---
import Layout from '../../layouts/Layout.astro';
import { getColorScheme, getFont, buildNumberOfResults, processSearchResults } from '../../lib/failai.js';
import { postgres } from '../../../postgres/postgres.js';
import { countFailai, searchFailai } from '../../../modules/failai/searchFailai.js';

const cookies = Astro.cookies;
const colorScheme = getColorScheme(cookies);
const font = getFont(cookies);
const requestUrl = String(Astro.request?.url || '/failai');
const [, requestQuery = ''] = requestUrl.split('?');
const searchParams = new URLSearchParams(requestQuery);
const cleanSearchParams = new URLSearchParams(searchParams);
for (const [key, value] of cleanSearchParams) {
  if (value === '') cleanSearchParams.delete(key);
}
const cleanQueryString = cleanSearchParams.toString();
if (cleanQueryString !== searchParams.toString()) {
  return Astro.redirect(`${new URL(requestUrl).pathname}${cleanQueryString ? `?${cleanQueryString}` : ''}`);
}
const query = Object.fromEntries(searchParams) as Record<string, string>;
const showStatistics = Object.keys(query).length === 0;

let values: Record<string, string> = {};
let results: any[] = [];
let numberOfResults = '';
let currentPage = 1;
let pageCount = 1;
let search = '';
let statistika: any = null;

const formatBytes = (value: unknown) => {
  const bytes = Number(value || 0);
  if (!Number.isFinite(bytes) || bytes <= 0) return '0 B';

  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  const index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  const amount = bytes / 1024 ** index;

  return `${amount.toLocaleString('lt-LT', { maximumFractionDigits: index === 0 ? 0 : 1 })} ${units[index]}`;
};

const formatPluralOnly = (number: number, forms: [string, string, string, string]) => {
  const n = Math.abs(Number(number));
  const stringValue = number.toString();
  const hasFraction = stringValue.includes('.') || stringValue.includes(',');

  if (hasFraction && n !== 0) return forms[3];
  if (n % 10 === 1 && !(n % 100 >= 11 && n % 100 <= 19)) return forms[0];
  if (n % 10 >= 2 && n % 10 <= 9 && !(n % 100 >= 11 && n % 100 <= 19)) return forms[1];
  return forms[2];
};

const formatLtDateTime = (value: unknown) => {
  if (!value) return '';
  const date = new Date(String(value));
  if (Number.isNaN(date.getTime())) return '';

  const datePart = date.toLocaleDateString('lt-LT', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
  const timePart = date.toLocaleTimeString('lt-LT', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  });

  return `${datePart} ${timePart}`;
};

if (!showStatistics) {
  const startedAt = Date.now();
  const limit = query.limit === 'max' ? 250 : Math.min(Math.max(parseInt(query.limit || '25', 10) || 25, 1), 250);
  currentPage = parseInt(query.page) || 1;
  const searchResult = await searchFailai(query, { limit, page: currentPage });
  const approximate = 'approximate' in searchResult ? Boolean((searchResult as any).approximate) : false;
  values = searchResult.values as Record<string, string>;
  results = processSearchResults(searchResult.results, query.search || '');
  const total = searchResult.total ?? await countFailai(query);
  pageCount = Math.min(100, Math.ceil(total / limit));
  const elapsed = Date.now() - startedAt;
  numberOfResults = buildNumberOfResults({ rows: results, total, elapsed, engine: searchResult.engine, approximate });
  search = query.search || '';
} else {
  const { rows } = await postgres.query(`SELECT metrika, eilute, verte FROM "failaiCounts";`);
  const counts = rows.reduce((acc: any, row: any) => {
    const { metrika, eilute, verte } = row;
    if (!acc[metrika]) acc[metrika] = eilute === 'ALL' ? verte : {};
    if (eilute === 'ALL') acc[metrika] = verte;
    else acc[metrika][eilute] = verte;
    return acc;
  }, {});

  statistika = {
    atnaujinta: new Date().toISOString(),
    failai: {
      kiekiai: {
        visi: counts.visi,
        klaida: counts.klaida,
        parsiusti: counts.parsiusti,
        neparsiusti: counts.visi - counts.parsiusti - counts.klaida - counts.extracted,
      },
      dydziai: {
        visi: (counts.dydis / counts.parsiusti) * counts.visi,
        klaida: (counts.dydis / counts.parsiusti) * counts.klaida,
        parsiusti: counts.dydis,
        neparsiusti: (counts.dydis / counts.parsiusti) * (counts.visi - counts.parsiusti - counts.klaida - counts.extracted),
      },
    },
    nuskaitymas: {
      zodziai: {
        total: counts.zodziuSuma,
        failaiSuZodziais: counts.zodziuKiekisNeNulis,
      },
    },
  };
}
const buildStatistika = (stat: any) => {
  if (!stat) return null;
  const totalWords = Number(stat.nuskaitymas.zodziai.total);
  const failaiSuZodziais = Number(stat.nuskaitymas.zodziai.failaiSuZodziais);
  const visiFailai = Number(stat.failai.kiekiai.visi);
  const visiDydziai = Number(stat.failai.dydziai.visi);
  const duomenuBaitai = visiDydziai * (visiFailai > 0 ? failaiSuZodziais / visiFailai : 0);
  const atnaujinta = formatLtDateTime(stat.atnaujinta);

  return {
    atnaujinta,
    totalWordsNumber: totalWords.toLocaleString('lt-LT'),
    totalWordsLabel: `${formatPluralOnly(totalWords, ['žodis', 'žodžiai', 'žodžių', 'žodžio'])} teksto`,
    dataSize: `${(duomenuBaitai / 1024 / 1024 / 1024).toFixed(2)} GB`,
    filesWithWordsNumber: failaiSuZodziais.toLocaleString('lt-LT'),
    filesWithWordsLabel: formatPluralOnly(failaiSuZodziais, ['failas', 'failai', 'failų', 'failo']),
  };
};

const statistikaPayload = buildStatistika(statistika);
---
<Layout pageTitle="Failų paieška" pageDescription="Parsisiųstų viešųjų pirkimų dokumentų paieška pagal pavadinimą, plėtinį ir turinį" pageImage="https://viespirkiai.org/failai.png" colorScheme={colorScheme} font={font}>
  <style>
    .failai-statistika {
      display: flex;
      flex-direction: column;
      gap: 40px;
      margin-block: 28px;
      align-items: center;
      width: 100%;
    }

    .failai-statistika .stat-row {
      display: flex;
      flex-direction: column;
    }

    .failai-statistika .stat-number {
      font-size: 5em;
      font-weight: 700;
      line-height: 1;
    }

    .failai-statistika .stat-text {
      font-size: var(--text-lg);
      color: var(--gray);
    }

    .failai-statistika .stat-row:nth-child(1) { transform: translateX(0); }
    .failai-statistika .stat-row:nth-child(2) { transform: translateX(15vw); }
    .failai-statistika .stat-row:nth-child(3) { transform: translateX(-10vw); }

    @media (max-width: 600px) {
      .failai-statistika .stat-number { font-size: 3em; }
      .failai-statistika .stat-row:nth-child(2),
      .failai-statistika .stat-row:nth-child(3) { transform: none; }
    }
  </style>
  <main>
    <form method="get" role="search" id="searchForm">
      <h1 class="mt-7">Failų paieška</h1>

      <div class="search-bar">
        <label for="search">
          <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
          </svg>
          <span class="sr-only">Paieška</span>
        </label>

        <input type="search" name="search" id="search" class="search-bar__input" value={values.search || ''} placeholder="Tekstinė paieška" enterkeyhint="search" />

        <label class="btn btn-ghost btn-icon" title="Filtrai" aria-label="Rodyti filtrus" aria-expanded="false" aria-controls="searchNustatymai">
          <input type="checkbox" id="searchNustatymaiToggle" class="sr-only">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.9999 3C11.4476 3 10.9999 3.44772 10.9999 4V6.17072C9.83476 6.58259 9 7.6938 9 8.99998C9 10.3062 9.83476 11.4174 10.9999 11.8292L10.9999 20C10.9999 20.5523 11.4476 21 11.9999 21C12.5522 21 12.9999 20.5523 12.9999 20V11.8293C14.1651 11.4175 15 10.3062 15 8.99998C15 7.69373 14.1651 6.58246 12.9999 6.17066V4C12.9999 3.44772 12.5522 3 11.9999 3ZM12 7.99998C11.4477 7.99998 11 8.4477 11 8.99998C11 9.55227 11.4477 9.99998 12 9.99998C12.5523 9.99998 13 9.55227 13 8.99998C13 8.4477 12.5523 7.99998 12 7.99998Z" fill="currentColor"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M17.9999 20C17.9999 20.5523 18.4476 21 18.9999 21C19.5522 21 19.9999 20.5523 19.9999 20V17.8293C21.1651 17.4175 22 16.3062 22 15C22 13.6937 21.1651 12.5825 19.9999 12.1707V4C19.9999 3.44772 19.5522 3 18.9999 3C18.4476 3 17.9999 3.44772 17.9999 4V12.1707C16.8348 12.5826 16 13.6938 16 15C16 16.3062 16.8348 17.4174 17.9999 17.8292V20ZM19 14C18.4477 14 18 14.4477 18 15C18 15.5523 18.4477 16 19 16C19.5523 16 20 15.5523 20 15C20 14.4477 19.5523 14 19 14Z" fill="currentColor"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3.9999 20C3.9999 20.5523 4.44762 21 4.9999 21C5.55219 21 5.9999 20.5523 5.9999 20V17.8293C7.16515 17.4175 8 16.3062 8 15C8 13.6937 7.16515 12.5825 5.9999 12.1707L5.9999 4C5.9999 3.44772 5.55219 3 4.9999 3C4.44762 3 3.9999 3.44772 3.9999 4L3.9999 12.1707C2.83476 12.5826 2 13.6938 2 15C2 16.3062 2.83476 17.4174 3.9999 17.8292L3.9999 20ZM5 14C4.44772 14 4 14.4477 4 15C4 15.5523 4.44772 16 5 16C5.55229 16 6 15.5523 6 15C6 14.4477 5.55229 14 5 14Z" fill="currentColor"/>
          </svg>
        </label>

        <button type="submit" class="btn btn-primary">Ieškoti</button>
      </div>

      <div id="searchNustatymai" class="search-filters" aria-hidden="true" inert>
        <div class="search-filters-inner">
          <div class="search-filters-grid">
            <fieldset class="filter-group">
              <legend class="filter-group-label">Failas</legend>
              <div class="form-group"><label class="form-label" for="extension">Extension</label><input type="text" class="form-control" name="extension" id="extension" value={values.extension || ''} placeholder="Visi" /></div>
              <div class="form-group"><label class="form-label" for="md5">MD5</label><input type="text" class="form-control" name="md5" id="md5" value={values.md5 || ''} placeholder="d41d8cd98..." /></div>
              <div class="form-group">
                <label class="form-label" for="saltinis">Šaltinis</label>
                <select name="saltinis" id="saltinis" class="form-control">
                  <option value="" selected={!values.saltinis}>Visi</option>
                  <option value="sutartys" selected={values.saltinis == 'sutartys'}>Sutartys</option>
                  <option value="neskelbiamosDerybos" selected={values.saltinis == 'neskelbiamosDerybos'}>Neskelbiamos derybos</option>
                  <option value="cvpIs" selected={values.saltinis == 'cvpIs'}>Viešieji pirkimai</option>
                  <option value="cvpp" selected={values.saltinis == 'cvpp'}>CVPP viešieji pirkimai</option>
                  <option value="mvpAprasai" selected={values.saltinis == 'mvpAprasai'}>MVP tvarkos aprašai</option>
                  <option value="archive" selected={values.saltinis == 'archive'}>Failas archyvo viduje</option>
                </select>
              </div>
            </fieldset>

            <fieldset class="filter-group justify-start">
              <legend class="filter-group-label">Puslapių skaičius</legend>
              <div class="form-group"><label class="form-label" for="puslapiaiMin">Nuo</label><input type="text" class="form-control" name="puslapiaiMin" id="puslapiaiMin" value={values.puslapiaiMin || ''} placeholder="0" /></div>
              <div class="form-group"><label class="form-label" for="puslapiaiMax">Iki</label><input type="text" class="form-control" name="puslapiaiMax" id="puslapiaiMax" value={values.puslapiaiMax || ''} placeholder="∞" /></div>
            </fieldset>

            <fieldset class="filter-group col-span-2 max-sm:col-span-1 items-start justify-start">
              <legend class="filter-group-label">Turinys</legend>
              <div class="search-filters-grid grid-cols-3 w-fit gap-3 [&_.form-group]:mb-0 max-sm:grid-cols-2">
                <div class="form-group"><label class="form-label" for="telefonas">Tel. numeris</label><input type="text" class="form-control" name="telefonas" id="telefonas" value={values.telefonas || ''} placeholder="+37060000000" /></div>
                <div class="form-group"><label class="form-label" for="email">El. paštas</label><input type="text" class="form-control" name="email" id="email" value={values.email || ''} placeholder="viespirkiai@viespirkiai.org" /></div>
                <div class="form-group"><label class="form-label" for="domain">Domenas</label><input type="text" class="form-control" name="domain" id="domain" value={values.domain || ''} placeholder="viespirkiai.org" /></div>
                <div class="form-group"><label class="form-label" for="iban">IBAN numeris</label><input type="text" class="form-control" name="iban" id="iban" value={values.iban || ''} placeholder="LT0000000000..." /></div>
                <div class="form-group"><label class="form-label" for="jarKodas">JAR kodas</label><input type="text" class="form-control" name="jarKodas" id="jarKodas" value={values.jarKodas || ''} placeholder="000000000" /></div>
              </div>
            </fieldset>
          </div>
        </div>
      </div>

      <script is:inline set:html={`const searchToggle = document.querySelector('label[aria-controls="searchNustatymai"]');
const filterBox = document.getElementById('searchNustatymai');
const checkbox = document.getElementById('searchNustatymaiToggle');

checkbox.addEventListener('change', function() {
  const isChecked = this.checked;
  searchToggle.setAttribute('aria-expanded', isChecked);
  searchToggle.setAttribute('aria-label', isChecked ? 'Slėpti filtrus' : 'Rodyti filtrus');
  if (isChecked) {
    filterBox.removeAttribute('inert');
    filterBox.setAttribute('aria-hidden', 'false');
    const firstInput = filterBox.querySelector('input, select');
    if (firstInput) firstInput.focus();
  } else {
    filterBox.setAttribute('inert', '');
    filterBox.setAttribute('aria-hidden', 'true');
  }
});

document.getElementById('search').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    this.form.submit();
  }
});`} />
    </form>

    <section id="failaiRezultatai" class="results">
      {showStatistics ? (
        <div id="failaiStatistika" class="mt-10">
          <p class="text-muted text-sm text-center">Statistika atnaujinta: <span data-stat="atnaujinta">{statistikaPayload?.atnaujinta}</span></p>
          <div class="failai-statistika">
            <div class="stat-row">
              <div class="stat-number" data-stat="totalWordsNumber">{statistikaPayload?.totalWordsNumber}</div>
              <div class="stat-text" data-stat="totalWordsLabel">{statistikaPayload?.totalWordsLabel}</div>
            </div>
            <div class="stat-row">
              <div class="stat-number" data-stat="dataSize">{statistikaPayload?.dataSize}</div>
              <div class="stat-text">duomenų</div>
            </div>
            <div class="stat-row">
              <div class="stat-number" data-stat="filesWithWordsNumber">{statistikaPayload?.filesWithWordsNumber}</div>
              <div class="stat-text" data-stat="filesWithWordsLabel">{statistikaPayload?.filesWithWordsLabel}</div>
            </div>
          </div>
          <p class="text-muted text-sm mb-10 text-center max-w-120 mx-auto">Taip, statistikos duomenys ir jų pokyčiai – tikri.</p>
          <div class="flex gap-2 justify-center mb-10 flex-wrap">
            <a href="/failai/topExtension" class="btn btn-outline btn-sm">↗ Dažniausi plėtiniai</a>
            <a href="/failai/ocr" class="btn btn-outline btn-sm">↗ OCR būsena</a>
            <a href="/failai/map" class="btn btn-outline btn-sm">↗ Failų žemėlapis</a>
            <a href="/failai/neparsiunciami" class="btn btn-outline btn-sm">↗ Neparsiunčiami failai</a>
            <a href="/failai/galerija" class="btn btn-outline btn-sm">↗ Nuotraukų galerija</a>
          </div>
          <script is:inline set:html={`window.addEventListener('DOMContentLoaded', () => {
  const search = document.getElementById('search');
  if (search) search.focus();
});

let evtSource;
const setText = (key, value) => {
  const el = document.querySelector('[data-stat="' + key + '"]');
  if (el && value !== undefined) el.textContent = value;
};

const updateStatistika = (payload) => {
  setText('atnaujinta', payload.atnaujinta);
  setText('totalWordsNumber', payload.totalWordsNumber);
  setText('totalWordsLabel', payload.totalWordsLabel);
  setText('dataSize', payload.dataSize);
  setText('filesWithWordsNumber', payload.filesWithWordsNumber);
  setText('filesWithWordsLabel', payload.filesWithWordsLabel);
};

const connect = () => {
  evtSource = new EventSource('/failai/statistika/sse');
  evtSource.onmessage = (e) => updateStatistika(JSON.parse(e.data));
  evtSource.onerror = () => {
    evtSource.close();
    setTimeout(connect, 1000);
  };
};

connect();`} />
        </div>
      ) : (
        <div class="mt-10 max-w-lg center mx-auto">
          <div class="flex justify-between items-center mb-4">
            <span class="text-muted text-sm numberOfResults" set:html={numberOfResults}></span>
          </div>
          {results.length === 0 ? (
            <div class="empty-state"><p class="text-muted">Rezultatų nerasta.</p></div>
          ) : (
            <div class="result-list">
              {results.map((item: any) => (
                <article class="result-card card-clickable">
                  <div class="result-card-body">
                    <dl class="result-card-meta">
                      <div><dt class="sr-only">Formatas</dt><dd>{String(item.extension || '').toUpperCase()}</dd></div>
                      <div><dt class="sr-only">Dydis</dt><dd>{formatBytes(item.dydis)}</dd></div>
                      {item.metaduomenys && item.metaduomenys.pageCount && <div><dt class="sr-only">Puslapiai</dt><dd>{Number(item.metaduomenys.pageCount).toLocaleString('lt-LT')} p.</dd></div>}
                      <div><dt class="sr-only">Žodžiai</dt><dd>{Number(item.zodziuSkaicius).toLocaleString('lt-LT') || '—'} ž.</dd></div>
                    </dl>

                    <h3 class="result-card-title">
                      <a href={`/failas/${item.id}?search=${encodeURIComponent(search)}`}>
                        {item.metaduomenys ? item.metaduomenys.Title || item.pavadinimas : item.pavadinimas}
                      </a>
                    </h3>

                    {item.excerpt && <div class="text-sm text-muted mt-2 text-justify" set:html={item.excerpt} />}

                    {item.dokId && <div class="result-card-footer"><span><a href={`/sutartis/${item.dokId}`} class="relative z-1">↗ Sutartis</a></span></div>}
                  </div>
                </article>
              ))}
            </div>
          )}

          <script is:inline set:html={`const span = document.querySelector('.rezultatai-nezinomas-total');
if (span && !span.classList.contains('spin')) {
  span.classList.add('spin');
  const url = new URL(window.location.href);
  url.searchParams.set('rezultatuSkaiciausPatikslinimas', 'true');
  const trukme = document.querySelector('.numberOfResults span')?.getAttribute('data-duration');
  if (trukme) url.searchParams.set('trukme', trukme);
  fetch(url)
    .then(res => res.json())
    .then(data => {
      if (data.zinomasRezultatuSkaicius) {
        span.className = '';
        document.querySelector('.numberOfResults').innerHTML = data.numberOfResults;
        document.querySelector('nav.pagination').innerHTML = data.pagination;
      } else {
        span.classList.remove('spin');
      }
    })
    .catch(() => span.classList.remove('spin'));
}`} />

          <nav class="pagination">
            <ul class="pagination">
              <li class={currentPage === 1 ? 'disabled' : ''}><span>←</span></li>
              <li class="active"><span>{currentPage}</span></li>
              <li class={currentPage >= pageCount ? 'disabled' : ''}><span>→</span></li>
            </ul>
          </nav>
        </div>
      )}
    </section>
  </main>
</Layout>
