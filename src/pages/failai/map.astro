---
import Layout from '../../layouts/Layout.astro';
import Map from '@design-system/components/maps/Map.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import { postgres, getColorScheme, getFont } from '../../lib/failai.js';
import config from '../../lib/config.ts';
import '@/utils/linksniai.js';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);
const { rows } = await postgres.query('SELECT ST_Y(location::geometry) AS lat, ST_X(location::geometry) AS lon FROM public."filesLocations"');
const locations = (rows as any[]).map((r) => [Number(r.lat), Number(r.lon)]);
const mapConfig = {
  mode: 'points',
  center: [55.1694, 23.8813],
  zoom: 7,
  points: locations,
  debug: true,
  pointStyle: {
    radius: 4,
    color: '#000000',
    fillColor: '#000000',
    fillOpacity: 0.9,
    weight: 1,
  },
  clickUrlTemplate: '/dokumentai?minLat={minLat}&maxLat={maxLat}&minLon={minLon}&maxLon={maxLon}',
};
---
<Layout pageTitle="Failų žemėlapis" pageDescription="Viešųjų pirkimų dokumentų geografinis pasiskirstymas žemėlapyje" pageImage="https://viespirkiai.org/failai.png" colorScheme={colorScheme} font={font} customHead={config.customHead}>
  <main>
    <PageHeader>Failų žemėlapis</PageHeader>
    <p class="text-muted text-sm mb-4">
      Dalis paviešintų failų turi geografinę informaciją apie jų sukūrimo vietą.
      Norėdami peržiūrėti failus tam tikroje vietovėje, spustelėkite žemėlapyje esančius taškus.
    </p>
    <Map id="map" class="map-lg" height="min(70vh, 720px)" config={mapConfig} />
  </main>
</Layout>
