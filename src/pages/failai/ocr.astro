---
import Layout from '../../layouts/Layout.astro';
import Chart from '@design-system/components/charts/Chart.astro';
import OcrSpartaCards from '../../components/failai/OcrSpartaCards.astro';
import OcrNuskaitytojaiGrid from '../../components/failai/OcrNuskaitytojaiGrid.astro';
import OcrStatusTable from '../../components/failai/OcrStatusTable.astro';
import OcrLatestResultsLive from '../../components/failai/OcrLatestResultsLive.astro';
import LineDatetimeChart from '@design-system/components/charts/LineDatetimeChart.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import { postgres, OCR_STATES, getColorScheme, getFont } from '../../lib/failai.js';
import { fmtNumber } from '../../lib/formatters.ts';
import { loadLatestOcrResults } from '../../lib/ocrLatestResults.ts';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const OCR_STATE_COLORS: Record<string, string> = {
  baigta: '#22c55e',
  rekomenduojama: '#f59e0b',
  nepavyko: '#ef4444',
  rezervuota: '#3b82f6',
  virsijoBandymus: '#f97316',
  galima: '#06b6d4',
  neparuosta: '#94a3b8',
  nepalaikoma: '#a855f7',
};

// Ne būsenos, o išvados — savo pavadinimų OCR_STATES neturi.
const OCR_PSEUDO_STATES: Record<string, string> = {
  neparuosta: 'Neparuošta',
};

// Būsenų kiekiai imami iš files."stats" (ji per plėtinį). „Nepalaikoma" — išvada iš
// plėtinio, „galima" — iš OCR eilės dydžio (žr. žemiau); jie nėra būsenos.
const [ocrStatsPerExtRes, ocrStatsDayRes, ocrNuskaitytojaiRes, ocrLast60Res, ocrEilesDydisRes, ocrLatestResults] = await Promise.all([
  postgres.query(`
    SELECT e.extension, s.files, s."ocrDone", s."ocrFailed",
           s."ocrPending", s."ocrReserved", s."ocrExceeded"
    FROM files."stats" s
    JOIN files."extensions" e ON e.id = s."extensionId"
  `),
  postgres.query(`
    SELECT date, SUM(results)::int AS results, SUM(pages)::bigint AS pages, SUM(words)::bigint AS words
    FROM files."ocrStatsDay"
    GROUP BY date
    ORDER BY date DESC
  `),
  postgres.query(`
    SELECT n.id, n."nuskaitytiDokumentai", n."viesasPavadinimas", n."pavadinimas",
      COALESCE(r.rezervacijos, 0) AS "rezervacijos",
      COALESCE(SUM(s.results), 0) AS "results",
      COALESCE(SUM(s.pages), 0) AS "pages",
      COALESCE(SUM(s.words), 0) AS "words"
    FROM infra."ocrNuskaitytojai" n
    -- Dabartinės rezervacijos, o ne kaupiamas skaitiklis: status = -3 pjūvis mažas,
    -- o daliniam indeksui (filesOcrStatus_rezervuoti_idx) tai index-only scan.
    LEFT JOIN LATERAL (
      SELECT COUNT(*)::int AS rezervacijos
      FROM files."ocrStatus" o
      WHERE o."nodeId" = n.id AND o.status = -3
    ) r ON TRUE
    LEFT JOIN files."ocrStatsDay" s ON s."nodeId" = n.id
    GROUP BY n.id, n."nuskaitytiDokumentai", n."viesasPavadinimas", n."pavadinimas", r.rezervacijos
    ORDER BY n."nuskaitytiDokumentai" DESC
    LIMIT 100
  `),
  // „Paskutinė 1h" – slankiojantis 60 minučių langas (ne valandos bucket'as).
  // Puslapiai/žodžiai — iš po OCR atlikto nuskaitymo.
  postgres.query(`
    SELECT
      COUNT(*)::int AS results,
      COALESCE(SUM(d."pageCount"), 0)::bigint AS pages,
      COALESCE(SUM(d."wordCount"), 0)::bigint AS words
    FROM files."ocrStatus" o
    LEFT JOIN files."dataExtraction" d ON d.id = o.id
    WHERE o."ocrTimestamp" >= NOW() - INTERVAL '60 minutes'
  `),
  // „Galima" imama iš eilės, o ne iš plėtinių: eilėje lieka ir nepavykę bei bandymus
  // viršiję failai (jie ištrinami tik po sėkmingo OCR), tad skaičiuojame tik tuos,
  // kurie dar neturi jokios būsenos. Eilė maža, tad užklausa pigi.
  postgres.query(`
    SELECT COUNT(*)::bigint AS galima
    FROM files."ocrQueue" q
    LEFT JOIN files."ocrStatus" o ON o.id = q.id
    WHERE o.status IS NULL
  `),
  loadLatestOcrResults(15),
]);

// OCR galimi plėtiniai — tas pats sąrašas, kurį naudoja eilė (ocr.js).
const { OCR_IMAGE_EXTS, OCR_DOC_EXTS } = await import('@/modules/failai/ocr.js');
const ocrGalimi = new Set([...OCR_IMAGE_EXTS, ...OCR_DOC_EXTS]);

const ocrSuma = { baigta: 0, rekomenduojama: 0, nepavyko: 0, rezervuota: 0, virsijoBandymus: 0, galima: 0, neparuosta: 0, nepalaikoma: 0 };
let visoFailu = 0;
for (const r of ocrStatsPerExtRes.rows as any[]) {
  visoFailu += Number(r.files);
  ocrSuma.baigta += Number(r.ocrDone);
  ocrSuma.rekomenduojama += Number(r.ocrPending);
  ocrSuma.nepavyko += Number(r.ocrFailed);
  ocrSuma.rezervuota += Number(r.ocrReserved);
  ocrSuma.virsijoBandymus += Number(r.ocrExceeded);
  if (!ocrGalimi.has(String(r.extension).toLowerCase())) {
    ocrSuma.nepalaikoma += Number(r.files);
  }
}

ocrSuma.galima = Number(ocrEilesDydisRes.rows[0]?.galima || 0);

// Likutis: tinkamo plėtinio failai be OCR būsenos ir dar ne eilėje — jiems tik
// neištrauktas tekstas (files."dataExtraction"), tad į OCR eilę dar nepateko.
const ocrTaikoma = visoFailu - ocrSuma.nepalaikoma;
ocrSuma.neparuosta = Math.max(0, ocrTaikoma
  - ocrSuma.baigta - ocrSuma.rekomenduojama - ocrSuma.nepavyko
  - ocrSuma.rezervuota - ocrSuma.virsijoBandymus - ocrSuma.galima);
const ocrStatsRes = {
  rows: Object.entries(ocrSuma).map(([tipas, count]) => ({ tipas, count })).sort((a, b) => b.count - a.count),
};

const formatLtDate = (value: unknown) =>
  new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/Vilnius',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(new Date(String(value)));

const formatNowLtParts = () => {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/Vilnius',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(new Date());

  const get = (type: string) => parts.find((part) => part.type === type)?.value || '00';

  return {
    today: `${get('year')}-${get('month')}-${get('day')}`,
    hour: Number(get('hour')),
    minute: Number(get('minute')),
  };
};

const ocrStats: any[] = ocrStatsRes.rows.map((stat: any) => {
  const state = OCR_STATES.find((s: any) => s.camel === stat.tipas || s.text === stat.tipas);
  return {
    ...stat,
    ...state,
    count: Number(stat.count || 0),
    // „galima"/„nepalaikoma" nėra būsenos, tad status kodo neturi.
    camel: state?.camel ?? stat.tipas,
    id: state?.id ?? '-',
    text: state?.text || OCR_PSEUDO_STATES[stat.tipas] || stat.tipas || 'Nežinoma',
  };
});

const ocrStatsDay = ocrStatsDayRes.rows.map((row: any) => ({
  ...row,
  date: formatLtDate(row.date),
  results: Number(row.results || 0),
  pages: Number(row.pages || 0),
  words: Number(row.words || 0),
}));

const ocrNuskaitytojai: any[] = ocrNuskaitytojaiRes.rows.map((row: any) => ({
  ...row,
  nuskaitytiDokumentai: Number(row.nuskaitytiDokumentai || 0),
  rezervacijos: Number(row.rezervacijos || 0),
  results: Number(row.results || 0),
  pages: Number(row.pages || 0),
  words: Number(row.words || 0),
}));

const latestDay = ocrStatsDay[0];
const nowLt = formatNowLtParts();
const ocrPerMinute = latestDay
  ? (() => {
      const isToday = latestDay.date === nowLt.today;
      const minutes = isToday ? Math.max(1, nowLt.hour * 60 + nowLt.minute) : 1440;

      return {
        date: latestDay.date,
        results: Number((latestDay.results / minutes).toFixed(2)),
        pages: Number((latestDay.pages / minutes).toFixed(2)),
        words: Number((latestDay.words / minutes).toFixed(2)),
      };
    })()
  : null;

// „Paskutinė 1h" – vidurkis per minutę iš paskutinių 60 minučių (slankiojantis langas).
const last60 = ocrLast60Res.rows[0];
const ocrLastHour = last60
  ? {
      results: Number((Number(last60.results || 0) / 60).toFixed(2)),
      pages: Number((Number(last60.pages || 0) / 60).toFixed(2)),
      words: Number((Number(last60.words || 0) / 60).toFixed(2)),
    }
  : null;

const ocrNuskaitytojaiTreemapColors = ['#0ea5e9', '#22c55e', '#f59e0b', '#a855f7', '#ef4444', '#06b6d4', '#f97316'];

const ocrNuskaitytojaiChartData = {
  labels: ocrNuskaitytojai.map((item: any) => item.viesasPavadinimas),
  series: [
    {
      data: ocrNuskaitytojai.map((item: any) => ({
        x: item.viesasPavadinimas,
        y: item.nuskaitytiDokumentai,
      })),
    },
  ],
};

const ocrNuskaitytojaiChartOptions = {
  colors: ocrNuskaitytojaiTreemapColors,
  // Diagrama tempiasi iki stulpelio apačios, kad abu stulpeliai baigtųsi vienodai.
  chart: { height: '100%' },
  legend: {
    show: false,
  },
  stroke: {
    width: 1.25,
    colors: ['var(--gray)'],
  },
  dataLabels: {
    enabled: true,
    style: {
      colors: ['var(--black)'],
      fontSize: '13px',
      fontWeight: 600,
    },
    dropShadow: {
      enabled: false,
    },
  },
};

const ocrStatsDayChartData = {
  labels: ocrStatsDay.map((item: any) => item.date),
  results: ocrStatsDay.map((item: any) => item.results),
  pages: ocrStatsDay.map((item: any) => item.pages),
  words: ocrStatsDay.map((item: any) => item.words),
};

// Juostos ir lentelės dalys — procentai nuo viso archyvo.
const fmtProc = (dalis: number, baze: number) => {
  if (!baze) return '—';
  const p = (dalis / baze) * 100;
  return `${p.toLocaleString('lt-LT', { maximumFractionDigits: 1 })} %`;
};

// Būsenų pasiskirstymo juosta — tas pats pjūvis kaip diagramoje, tik kompaktiškiau.
const busenuJuosta = ocrStats
  .filter((item: any) => item.count > 0)
  .map((item: any) => ({
    ...item,
    dalis: (item.count / (visoFailu || 1)) * 100,
    spalva: OCR_STATE_COLORS[item.camel] || '#78716c',
  }));

---
<Layout
  pageTitle="OCR būsena"
  pageDescription="OCR statistika ir dokumentų teksto atpažinimo būsena"
  pageImage="https://viespirkiai.org/failai.png"
  colorScheme={colorScheme}
  font={font}
>
  <main>
    <PageHeader>
      OCR būsena
    </PageHeader>

    {(ocrPerMinute || ocrLastHour) && (
      <section class="mb-16">
        <div class="flex flex-col gap-6 xl:flex-row">
          {ocrPerMinute && (
            <OcrSpartaCards
              title={`Sparta (${ocrPerMinute.date})`}
              anchor="perMinute"
              results={ocrPerMinute.results}
              pages={ocrPerMinute.pages}
              words={ocrPerMinute.words}
            />
          )}
          {ocrLastHour && (
            <OcrSpartaCards
              title="Paskutinė 1h"
              anchor="lastHour"
              results={ocrLastHour.results}
              pages={ocrLastHour.pages}
              words={ocrLastHour.words}
            />
          )}
        </div>
      </section>
    )}

    <section class="mb-16">
      <div class="grid-2 ocr-grid">
        <div>
          <h2 class="mb-4"><a href="#nuskaitytojai" id="nuskaitytojai" class="no-style">OCR nuskaitytojai</a></h2>
          <OcrNuskaitytojaiGrid items={ocrNuskaitytojai} />
        </div>

        <div class="ocr-grid__col">
          <h2 class="mb-3"><a href="#busena" id="busena" class="no-style">Failai pagal būseną</a></h2>
          <div
            class="ocr-juosta"
            role="img"
            aria-label={busenuJuosta.map((s: any) => `${s.text}: ${fmtNumber(s.count)}`).join(', ')}
          >
            {busenuJuosta.map((s: any) => (
              <span
                class="ocr-juosta__seg"
                style={`width:${s.dalis}%;background:${s.spalva}`}
                title={`${s.text}: ${fmtNumber(s.count)} (${fmtProc(s.count, visoFailu)})`}
              />
            ))}
          </div>
          <OcrStatusTable items={ocrStats} colors={OCR_STATE_COLORS} />

          <h2 class="mb-3 mt-10"><a href="#pagalNuskaitytoją" id="pagalNuskaitytoją" class="no-style">Failų dalis pagal nuskaitytoją</a></h2>
          <div class="ocr-treemap">
            <Chart
              id="ocrNuskaitytojaiDiagrama"
              type="treemap"
              labels={ocrNuskaitytojaiChartData.labels}
              series={ocrNuskaitytojaiChartData.series}
              customOptions={ocrNuskaitytojaiChartOptions}
              wrapperClass="min-w-0 flex flex-col flex-1"
              heightClass=""
            />
          </div>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="mb-3"><a href="#naujausi-rezultatai" id="naujausi-rezultatai" class="no-style">Naujausi rezultatai</a></h2>
      <OcrLatestResultsLive items={ocrLatestResults} />
    </section>

    <section class="grid-2 mb-16">
      <LineDatetimeChart id="ocrStatsDayDiagrama" title="Rezultatų skaičius" anchor="rezultatai" labels={ocrStatsDayChartData.labels} series={ocrStatsDayChartData.results} />
      <LineDatetimeChart id="ocrStatsDayPagesDiagrama" title="Puslapių skaičius" anchor="puslapiai" labels={ocrStatsDayChartData.labels} series={ocrStatsDayChartData.pages} />
      <LineDatetimeChart id="ocrStatsDayWordsDiagrama" title="Žodžių skaičius" anchor="zodziai" labels={ocrStatsDayChartData.labels} series={ocrStatsDayChartData.words} />
    </section>
  </main>
</Layout>

<style>
  /* Abu stulpeliai baigiasi vienodai: aukštį diktuoja nuskaitytojų kortelės,
     o būsenų diagrama tempiasi iki likusios vietos apačioje. */
  .ocr-grid {
    align-items: stretch;
  }

  .ocr-grid__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ocr-treemap {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 280px;
  }

  .ocr-treemap :global(.chart-frame) {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .ocr-treemap :global(.chart) {
    flex: 1 1 auto;
    min-height: 240px;
  }

  .ocr-juosta {
    display: flex;
    width: 100%;
    height: 14px;
    margin-top: 4px;
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--light-gray);
  }

  .ocr-juosta__seg {
    min-width: 2px;
    transition: opacity var(--transition);
  }

  .ocr-juosta:hover .ocr-juosta__seg {
    opacity: 0.65;
  }

  .ocr-juosta__seg:hover {
    opacity: 1;
  }
</style>
