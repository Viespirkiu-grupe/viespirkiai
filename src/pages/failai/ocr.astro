---
import Layout from '../../layouts/Layout.astro';
import { postgres, OCR_STATES, getColorScheme, getFont } from '../../lib/failai.js';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const [ocrStatsRes, ocrStatsDayRes, ocrNuskaitytojaiRes] = await Promise.all([
  postgres.query(`SELECT * FROM "failaiOcrStats" ORDER BY count DESC`),
  postgres.query(`SELECT * FROM "failaiOcrRezultataiStatsDay" ORDER BY date DESC`),
  postgres.query(`
    SELECT n.id, n."nuskaitytiDokumentai", n."viesasPavadinimas", n."pavadinimas", n."rezervacijos",
      COALESCE(SUM(s.results), 0) AS "results",
      COALESCE(SUM(s.pages), 0) AS "pages",
      COALESCE(SUM(s.words), 0) AS "words"
    FROM "ocrNuskaitytojai" n
    LEFT JOIN "failaiOcrRezultataiStatsDayNode" s ON s.node = n.pavadinimas
    GROUP BY n.id, n."nuskaitytiDokumentai", n."viesasPavadinimas", n."pavadinimas", n."rezervacijos"
    ORDER BY n."nuskaitytiDokumentai" DESC
    LIMIT 100
  `),
]);

const formatLtDate = (value: unknown) =>
  new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/Vilnius',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(new Date(String(value)));

const formatNowLtParts = () => {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/Vilnius',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(new Date());

  const get = (type: string) => parts.find((part) => part.type === type)?.value || '00';

  return {
    today: `${get('year')}-${get('month')}-${get('day')}`,
    hour: Number(get('hour')),
    minute: Number(get('minute')),
  };
};

const ocrStats = ocrStatsRes.rows.map((stat: any) => {
  const state = OCR_STATES.find((s: any) => s.camel === stat.tipas || s.text === stat.tipas);
  return {
    ...stat,
    ...state,
    count: Number(stat.count || 0),
    id: stat.id ?? '-',
    text: state?.text || stat.tipas || 'Nežinoma',
  };
});

const ocrStatsDay = ocrStatsDayRes.rows.map((row: any) => ({
  ...row,
  date: formatLtDate(row.date),
  results: Number(row.results || 0),
  pages: Number(row.pages || 0),
  words: Number(row.words || 0),
}));

const ocrNuskaitytojai = ocrNuskaitytojaiRes.rows.map((row: any) => ({
  ...row,
  nuskaitytiDokumentai: Number(row.nuskaitytiDokumentai || 0),
  rezervacijos: Number(row.rezervacijos || 0),
  results: Number(row.results || 0),
  pages: Number(row.pages || 0),
  words: Number(row.words || 0),
}));

const latestDay = ocrStatsDay[0];
const nowLt = formatNowLtParts();
const ocrPerMinute = latestDay
  ? (() => {
      const isToday = latestDay.date === nowLt.today;
      const minutes = isToday ? Math.max(1, nowLt.hour * 60 + nowLt.minute) : 1440;

      return {
        date: latestDay.date,
        results: Number((latestDay.results / minutes).toFixed(2)),
        pages: Number((latestDay.pages / minutes).toFixed(2)),
        words: Number((latestDay.words / minutes).toFixed(2)),
      };
    })()
  : null;

const chartsHead = `<script defer>
  let apexPromise;
  const renderedCharts = [];
  function loadApexCharts() {
    if (window.ApexCharts) return Promise.resolve(window.ApexCharts);
    if (apexPromise) return apexPromise;
    apexPromise = new Promise((resolve, reject) => {
      function startLoading() {
        const s = document.createElement('script'); s.src = '/dist/apexcharts.js'; s.defer = true;
        s.onload = () => resolve(window.ApexCharts); s.onerror = reject;
        document.body.appendChild(s);
      }
      document.readyState === 'loading' ? window.addEventListener('DOMContentLoaded', startLoading) : startLoading();
    });
    return apexPromise;
  }
  function deepMerge(t,s){for(const k in s){if(s[k]&&typeof s[k]==='object'&&!Array.isArray(s[k])){if(!t[k])t[k]={};deepMerge(t[k],s[k]);}else{t[k]=s[k];}}return t;}
  function getIsDark(){return document.documentElement.classList.contains('dark');}
  function getThemeTokens(d){return{foreground:d?'#f5f4f4':'#0c0a09',labelColor:d?'#a8a29e':'#292524',gridColor:d?'#292524':'#e7e5e4',tooltipBg:d?'#1c1917':'#fafaf9',tooltipText:d?'#f5f4f4':'#0c0a09',tooltipBorder:d?'#292524':'#d6d3d1'};}
  const CATEGORICAL_COLORS={light:['#0c0a09','#79716b','#e7e5e4'],dark:['#f5f4f4','#79716b','#292524']};
  function getCategoricalColors(d){return d?CATEGORICAL_COLORS.dark:CATEGORICAL_COLORS.light;}
  const eurFormatter=v=>typeof v==='number'?v.toLocaleString('lt-LT',{style:'currency',currency:'EUR'}):'Nėra duomenų';
  function buildGlobalDefaults(d){const t=getThemeTokens(d);return{chart:{toolbar:{show:false},zoom:{enabled:false},fontFamily:'Ubuntu, system-ui, sans-serif',background:'transparent',height:350,foreColor:t.labelColor},tooltip:{enabled:true,theme:d?'dark':'light',style:{fontFamily:'Ubuntu, system-ui, sans-serif'}},xaxis:{labels:{style:{colors:t.labelColor}}},yaxis:{labels:{style:{colors:t.labelColor}}},stroke:{curve:'smooth',width:2},markers:{size:4},colors:getCategoricalColors(d),grid:{borderColor:t.gridColor},theme:{mode:d?'dark':'light'},legend:{labels:{colors:t.labelColor}}};}
  const typeChartDefaults={'line-datetime':{chart:{type:'line'},xaxis:{type:'datetime',tickAmount:6,labels:{format:'yyyy-MM'}},tooltip:{x:{format:'yyyy-MM'}}},'pie':{chart:{type:'pie'},legend:{position:'bottom'},dataLabels:{enabled:true}},'scatter':{chart:{type:'scatter'}},'treemap':{chart:{type:'treemap'}}};
  const chartFlagDefaults={'yEUR':{yaxis:{labels:{formatter:eurFormatter}}},'yEURMen':{yaxis:{labels:{formatter:v=>typeof v==='number'?eurFormatter(v)+' / mėn.':'Nėra duomenų'}}},'yMin0':{yaxis:{min:0}},'yMinAuto':{yaxis:{min:undefined}},'xYear':{xaxis:{labels:{format:'yyyy'}},tooltip:{x:{format:'yyyy'}}},'xAxisYearMonth':{xaxis:{type:'datetime',tickAmount:6,labels:{format:'yyyy-MM'}},tooltip:{x:{format:'yyyy-MM'}}},'xAxisDay':{xaxis:{type:'datetime',tickAmount:6,labels:{format:'yyyy-MM-dd'}},tooltip:{x:{format:'yyyy-MM-dd'}}},'numbersWithSpaces':{yaxis:{labels:{formatter:v=>typeof v==='number'?v.toLocaleString('lt-LT'):'Nėra duomenų'}}}};
  function buildOptions(data,isDark){let o=structuredClone(buildGlobalDefaults(isDark));if(data.type&&typeChartDefaults[data.type])o=deepMerge(o,structuredClone(typeChartDefaults[data.type]));for(const f of(data.flags||[])){if(f in chartFlagDefaults)o=deepMerge(o,chartFlagDefaults[f]);}if(data.type!=='pie'){o.xaxis=o.xaxis||{};o.xaxis.categories=data.labels;if(Array.isArray(data.series)&&(data.series.length===0||!data.series[0]?.data)){o.series=[{name:data.customOptions?.seriesName||'',data:data.series}];}else{o.series=data.series;}}else{o.labels=data.labels;o.series=data.series;}if(data.customOptions)o=deepMerge(o,data.customOptions);return o;}
  async function displayChart(data){if(!data?.element||!data?.labels||!data?.series){return;}await loadApexCharts();const chart=new ApexCharts(data.element,buildOptions(data,getIsDark()));chart.render();renderedCharts.push({chart,data});}
  function updateAllCharts(){const d=getIsDark();const t=getThemeTokens(d);for(const{chart}of renderedCharts){chart.updateOptions({chart:{foreColor:t.labelColor},tooltip:{theme:d?'dark':'light'},xaxis:{labels:{style:{colors:t.labelColor}}},yaxis:{labels:{style:{colors:t.labelColor}}},grid:{borderColor:t.gridColor},theme:{mode:d?'dark':'light'},legend:{labels:{colors:t.labelColor}},colors:getCategoricalColors(d)},false,true);}}
  new MutationObserver(updateAllCharts).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{if(!document.documentElement.classList.contains('dark'))updateAllCharts();});
</script>
<style>.chart{background-color:transparent;}.dark .apexcharts-tooltip,.dark .apexcharts-tooltip-title{background:#1c1917!important;color:#f5f4f4!important;border-color:#292524!important;}</style>`;

const ocrStatsChartData = {
  labels: ocrStats.map((item: any) => item.text),
  series: ocrStats.map((item: any) => item.count),
};

const ocrNuskaitytojaiChartData = {
  labels: ocrNuskaitytojai.map((item: any) => item.viesasPavadinimas),
  series: [
    {
      data: ocrNuskaitytojai.map((item: any) => ({
        x: item.viesasPavadinimas,
        y: item.nuskaitytiDokumentai,
      })),
    },
  ],
};

const ocrStatsDayChartData = {
  labels: ocrStatsDay.map((item: any) => item.date),
  results: ocrStatsDay.map((item: any) => item.results),
  pages: ocrStatsDay.map((item: any) => item.pages),
  words: ocrStatsDay.map((item: any) => item.words),
};
---
<Layout
  pageTitle="OCR būsena"
  pageDescription="OCR statistika ir dokumentų teksto atpažinimo būsena"
  pageImage="https://viespirkiai.org/failai.png"
  colorScheme={colorScheme}
  font={font}
  customHead={chartsHead}
>
  <main>
    <div class="page-header">
      <h1 class="mb-0">OCR būsena</h1>
    </div>

    {ocrPerMinute && (
      <section class="mb-16">
        <h2 class="mb-3">
          <a href="#perMinute" id="perMinute" class="no-style">Sparta ({ocrPerMinute.date})</a>
        </h2>
        <div class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(180px,1fr))]">
          <div class="card">
            <div class="card-body">
              <div class="section-title mb-2">Dokumentai</div>
              <div class="flex items-baseline gap-1">
                <span class="cell-mono text-[1.6rem] font-semibold">{ocrPerMinute.results.toLocaleString('lt-LT')}</span>
                <span class="text-xs text-muted font-medium">/min.</span>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-body">
              <div class="section-title mb-2">Puslapiai</div>
              <div class="flex items-baseline gap-1">
                <span class="cell-mono text-[1.6rem] font-semibold">{ocrPerMinute.pages.toLocaleString('lt-LT')}</span>
                <span class="text-xs text-muted font-medium">/min.</span>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-body">
              <div class="section-title mb-2">Žodžiai</div>
              <div class="flex items-baseline gap-1">
                <span class="cell-mono text-[1.6rem] font-semibold">{ocrPerMinute.words.toLocaleString('lt-LT')}</span>
                <span class="text-xs text-muted font-medium">/min.</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="mb-16">
      <div class="grid-2 items-start">
        <div>
          <h2 class="mb-4"><a href="#nuskaitytojai" id="nuskaitytojai" class="no-style">OCR nuskaitytojai</a></h2>
          <div class="grid gap-3 pt-1 grid-cols-[repeat(auto-fill,minmax(190px,1fr))]">
            {ocrNuskaitytojai.map((nuskaitytojas: any) => (
              <div class="card">
                <div class="card-body">
                  <div class="section-title mb-2">
                    <a href={`/failai/ocr/${nuskaitytojas.id}`}>{nuskaitytojas.viesasPavadinimas}</a>
                  </div>
                  <dl class="kv-list">
                    <dt>Dokumentai</dt>
                    <dd><span class="cell-mono">{nuskaitytojas.results.toLocaleString('lt-LT')}</span></dd>
                    <dt>Puslapiai</dt>
                    <dd><span class="cell-mono">{nuskaitytojas.pages.toLocaleString('lt-LT')}</span></dd>
                    <dt>Žodžiai</dt>
                    <dd><span class="cell-mono">{nuskaitytojas.words.toLocaleString('lt-LT')}</span></dd>
                    <dt>Rezervacijos</dt>
                    <dd><span class="cell-mono">{nuskaitytojas.rezervacijos.toLocaleString('lt-LT')}</span></dd>
                  </dl>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="mb-3"><a href="#busena" id="busena" class="no-style">Failai pagal būseną</a></h2>
          <div class="flex flex-col min-h-87.5">
            <div class="chart-frame">
              <div id="ocrStatsDiagrama" class="chart h-87.5"></div>
            </div>
          </div>
          <script defer is:inline define:vars={{ ocrStatsChartData }}>
            displayChart({
              element: document.querySelector('#ocrStatsDiagrama'),
              type: 'pie',
              labels: ocrStatsChartData.labels,
              series: ocrStatsChartData.series,
              flags: ['colors'],
            });
          </script>
          <div class="table-wrapper mt-4">
            <table class="table">
              <thead>
                <tr>
                  <th class="cell-center">ID</th>
                  <th>OCR būsena</th>
                  <th class="cell-right">Failų skaičius</th>
                </tr>
              </thead>
              <tbody>
                {ocrStats.map((status: any) => (
                  <tr>
                    <td class="cell-mono cell-center">{status.id}</td>
                    <td>{status.text}</td>
                    <td class="cell-mono cell-right">{status.count.toLocaleString('lt-LT')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="mb-3"><a href="#pagalNuskaitytoją" id="pagalNuskaitytoją" class="no-style">Failų dalis pagal nuskaitytoją</a></h2>
      <div class="flex flex-col min-h-87.5">
        <div class="chart-frame">
          <div id="ocrNuskaitytojaiDiagrama" class="chart h-87.5"></div>
        </div>
      </div>
      <script defer is:inline define:vars={{ ocrNuskaitytojaiChartData }}>
        displayChart({
          element: document.querySelector('#ocrNuskaitytojaiDiagrama'),
          type: 'treemap',
          labels: ocrNuskaitytojaiChartData.labels,
          series: ocrNuskaitytojaiChartData.series,
          flags: ['colors'],
        });
      </script>
    </section>

    <section class="grid-2">
      <div class="min-w-0 flex flex-col min-h-87.5">
        <h2 class="mb-3"><a href="#rezultatai" id="rezultatai" class="no-style">Rezultatų skaičius</a></h2>
        <div class="chart-frame">
          <div id="ocrStatsDayDiagrama" class="chart h-87.5"></div>
        </div>
        <script defer is:inline define:vars={{ ocrStatsDayChartData }}>
          displayChart({
            element: document.querySelector('#ocrStatsDayDiagrama'),
            type: 'line-datetime',
            labels: ocrStatsDayChartData.labels,
            series: ocrStatsDayChartData.results,
            flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
          });
        </script>
      </div>

      <div class="min-w-0 flex flex-col min-h-87.5">
        <h2 class="mb-3"><a href="#puslapiai" id="puslapiai" class="no-style">Puslapių skaičius</a></h2>
        <div class="chart-frame">
          <div id="ocrStatsDayPagesDiagrama" class="chart h-87.5"></div>
        </div>
        <script defer is:inline define:vars={{ ocrStatsDayChartData }}>
          displayChart({
            element: document.querySelector('#ocrStatsDayPagesDiagrama'),
            type: 'line-datetime',
            labels: ocrStatsDayChartData.labels,
            series: ocrStatsDayChartData.pages,
            flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
          });
        </script>
      </div>

      <div class="min-w-0 flex flex-col min-h-87.5">
        <h2 class="mb-3"><a href="#zodziai" id="zodziai" class="no-style">Žodžių skaičius</a></h2>
        <div class="chart-frame">
          <div id="ocrStatsDayWordsDiagrama" class="chart h-87.5"></div>
        </div>
        <script defer is:inline define:vars={{ ocrStatsDayChartData }}>
          displayChart({
            element: document.querySelector('#ocrStatsDayWordsDiagrama'),
            type: 'line-datetime',
            labels: ocrStatsDayChartData.labels,
            series: ocrStatsDayChartData.words,
            flags: ['yMin0', 'xAxisDay', 'numbersWithSpaces'],
          });
        </script>
      </div>
    </section>
  </main>
</Layout>
