---
import '../styles/global.css';
import logoSvg from '../assets/branding/viespirkiaiLogo.svg?raw';

const { tipas, pavadinimas, aprasymas, id } = Object.fromEntries(Astro.url.searchParams);

const { default: createDOMPurify } = await import('dompurify');
// @ts-ignore — jsdom ships no .d.ts in this project setup
const { JSDOM } = await import('jsdom');
const DOMPurify = createDOMPurify(new JSDOM('').window);

const safePavadinimas = DOMPurify.sanitize(pavadinimas || '');
const safeAprasymas = DOMPurify.sanitize(aprasymas || '', {
  ALLOWED_TAGS: ['b', 'i', 'u', 'br'],
});
---

<!DOCTYPE html>
<html lang="lt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: repeating-conic-gradient(#e0e0e0 0 25%, transparent 0 50%) 50% / 20px 20px;
      margin: 0;
    }

    .og-card {
      width: 1200px;
      height: 630px;
      background: var(--white);
      padding: 64px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 8px 48px rgba(0,0,0,0.12);
    }

    .og-type {
      font-size: 28px;
      color: var(--gray);
      margin-bottom: 16px;
      font-family: var(--font-sans);
    }

    .og-title {
      font-size: 64px;
      font-weight: 700;
      line-height: 1.1;
      color: var(--black);
      margin-bottom: 24px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-family: var(--font-sans);
    }

    .og-description {
      font-size: 32px;
      line-height: 1.4;
      color: var(--dark-gray);
      font-family: var(--font-sans);
    }

    .og-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .og-id {
      font-size: 28px;
      font-family: var(--font-mono);
      color: var(--gray);
    }

    .og-logo svg {
      width: 30ch !important;
      display: block;
    }
  </style>
</head>
<body>
  <div class="og-card">
    <div class="og-top">
      <div class="og-type">{tipas || ''}</div>
      <div class="og-title" set:html={safePavadinimas}></div>
      <div class="og-description" set:html={safeAprasymas}></div>
    </div>
    <div class="og-bottom">
      <div class="og-id">{id || ''}</div>
      <div class="og-logo" set:html={logoSvg}></div>
    </div>
  </div>
</body>
</html>
