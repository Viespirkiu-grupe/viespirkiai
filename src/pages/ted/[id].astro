---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import Timeline from '@design-system/components/Timeline.astro';
import TimelineItem from '@design-system/components/TimelineItem.astro';
import TedAddressFields from '../../components/ted/TedAddressFields.astro';
import TedSection from '../../components/ted/TedSection.astro';
import { getColorScheme, getFont } from '../../lib/failai.js';
import { loadTedNoticePageData } from '../../lib/ted.ts';

const { id } = Astro.params;
if (!id) return new Response(null, { status: 404 });

const noticeData = await loadTedNoticePageData(id);
if (!noticeData) return new Response(null, { status: 404 });

const { noticeId, view } = noticeData;
const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const pageTitle = view.pageTitle + (noticeId ? ` – ${noticeId}` : '');
const pageDescription = view.documentTypeLabel + (view.issueDateText ? ` · ${view.issueDateText}` : '');
---

<Layout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageImage="https://viespirkiai.org/ted.png"
  colorScheme={colorScheme}
  font={font}
>
  <style>
    .ted-page {
      max-width: 1760px;
      padding-inline: 24px;
    }

    .ted-preline {
      white-space: pre-line;
    }

    .ted-page .page-header,
    .ted-page .grid-3,
    .ted-page .grid-4 {
      align-items: start;
    }

    @media (max-width: 768px) {
      .ted-page {
        padding-inline: 16px;
      }
    }
  </style>

  <main>
    <div class="container container-fluid ted-page">
      <PageHeader>
        <Fragment slot="subtext">
          {view.documentTypeLabel}{view.subTypeDescription && <> · {view.subTypeDescription}</>}
        </Fragment>
        {view.pageTitle}
        {view.procScope?.value && <> <span class="amount">{view.procScope.value.values[0]}</span></>}
        <Fragment slot="actions">
          <div class="text-muted text-sm text-right">
            {noticeId && <>ID: {noticeId}<br /></>}
            {view.issueDateText && <>Išleista: {view.issueDateText}</>}
          </div>
          <a href={`/ted/${noticeId}.xml`} class="btn btn-outline btn-sm">↗ XML</a>
        </Fragment>
      </PageHeader>

      <div class={view.hasLocation ? 'grid-4 mt-7' : 'grid-3 mt-7'}>
        <section>
          <h2>Perkančioji organizacija</h2>
          {view.primaryOrg && (
            <>
              <h3 class="mb-1">{view.primaryOrg.reg ? <a href={`/asmuo/${view.primaryOrg.reg}`}>{view.primaryOrg.label}</a> : view.primaryOrg.label}</h3>
              {view.primaryOrg.reg && <p class="text-muted text-sm mb-1">{view.primaryOrg.reg}</p>}
              {view.primaryOrg.city && <p class="text-sm text-muted mb-0">{view.primaryOrg.city}</p>}
              {view.primaryOrg.email && <p class="text-sm mb-1"><a href={`mailto:${view.primaryOrg.email}`}>{view.primaryOrg.email}</a></p>}
              {view.primaryOrg.url && <p class="text-sm mb-0"><a href={view.primaryOrg.url} target="_blank" rel="noopener">{view.primaryOrg.url}</a></p>}
            </>
          )}
        </section>

        <section>
          <h2>Pirkimo objektas</h2>
          {view.procScope.description && <p class="text-sm ted-preline">{view.procScope.description}</p>}
          {(view.procScope.internalId || view.procScope.contractType || view.procScope.otherObj) && <p class="text-sm text-muted">{[view.procScope.internalId, view.procScope.contractType, view.procScope.otherObj].filter(Boolean).join(' · ')}</p>}
          {view.procScope.addInfo && <p class="text-sm text-muted ted-preline">{view.procScope.addInfo}</p>}
          {view.procScope.bvpzKodas && (
            <>
              <h3 class="mb-2">BVPŽ</h3>
              <div class="flex flex-col gap-2">
                <div>
                  <div class="font-medium">{view.procScope.bvpzPavadinimas}{view.procScope.bvpzKodas && <span class="text-muted font-normal text-xs"> {view.procScope.bvpzKodas}</span>}</div>
                </div>
                {view.procScope.papildomiBvpzKodai?.map((code, i) => (
                  <div>
                    <div class="font-medium">{view.procScope.papildomiBvpzPavadinimai[i]}{code && <span class="text-muted font-normal text-xs"> {code}</span>}</div>
                  </div>
                ))}
              </div>
            </>
          )}
        </section>

        {view.hasLocation && (
          <section>
            <h2>Vykdymo vieta</h2>
            <TedAddressFields addrFields={view.procScope.addrFields} />
          </section>
        )}

        <section>
          <h2>Terminai</h2>
          <Timeline>
            {view.timelineItems.map((item, i) => {
              const past = item.date && new Date(`${item.date}T00:00:00`).getTime() < Date.now();
              const nextItem = view.timelineItems[i + 1];
              const nextPast = nextItem?.date && new Date(`${nextItem.date}T00:00:00`).getTime() < Date.now();
              return (
                <TimelineItem active={Boolean(past)} lineActive={Boolean(nextPast)}>
                  <div class="text-xs text-muted">{item.text}</div>
                  <strong>{item.label}</strong>
                </TimelineItem>
              );
            })}
          </Timeline>
        </section>
      </div>

      <div>
        {view.visibleSections.map((section, i) => (
          <div class={
            ['ND-Lot', 'ND-Part', 'ND-LotsGroup'].includes(section.nodeId)
              ? 'mt-10 pt-2'
              : i === 0
                ? ''
                : 'mt-8'
          }>
            <TedSection
              section={section}
              shortUrl={view.shortUrl}
              formatDate={view.formatDate}
              buyerOrgId={view.buyerOrgId}
              reviewBodyOrgIds={view.reviewBodyOrgIds}
              mediationBodyOrgIds={view.mediationBodyOrgIds}
              eSenderOrgIds={view.eSenderOrgIds}
              parentNodeTitles={view.PARENT_NODE_TITLES}
              parentNodeAliases={view.PARENT_NODE_ALIASES}
              subgroupTitles={view.SUBGROUP_TITLES}
            />
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>
