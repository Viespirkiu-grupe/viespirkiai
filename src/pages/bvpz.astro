---
import Layout from '../layouts/Layout.astro';
import BvpzPicker from '../components/content/BvpzPicker.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import { getColorScheme, getFont } from '../lib/failai.ts';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const presets = [
  { label: 'Informacinės technologijos', codes: '48 72' },
  { label: 'Vaistai', codes: '3360 3361 3362 3363 3364 3365 3366 3367 33690 33691' },
];

const searchTargets = [
  { label: 'Viešieji pirkimai (pasiūlymų teikimas)', value: 'viesiejiPirkimaiTeikimas' },
  { label: 'Viešieji pirkimai', value: 'viesiejiPirkimai' },
  { label: 'Sutartys', value: 'sutartys' },
];

Astro.response.headers.set('Cache-Control', 'private, max-age=10');
---

<Layout
  pageTitle="BVPŽ kodų paieška"
  pageDescription="Bendrųjų viešųjų pirkimų žodyno kodų paieškos įrankis"
  pageImage="https://viespirkiai.org/bvpz.png"
  colorScheme={colorScheme}
  font={font}
>
  <main>
    <PageHeader>BVPŽ kodai</PageHeader>

    <p class="text-muted text-sm mb-4">
      Įveskite kodą arba pavadinimą paieškos langelyje, kad surastumėte reikiamą BVPŽ kodą.
    </p>

    <BvpzPicker presets={presets} searchTargets={searchTargets} showManualInput={false} />

  </main>
</Layout>
