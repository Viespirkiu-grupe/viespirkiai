---
import { postgres } from '@/postgres/postgres.js';

function stripJsonSuffix(raw: string): { value: string; requestsJson: boolean } {
  if (raw.endsWith('.json')) return { value: raw.slice(0, -5), requestsJson: true };
  return { value: raw, requestsJson: false };
}

const { id: rawDokId, fileId: rawFileId } = Astro.params;
const { value: dokId } = stripJsonSuffix(rawDokId ?? '');
const { value: fileId } = stripJsonSuffix(rawFileId ?? '');

if (isNaN(Number(dokId)) || isNaN(Number(fileId))) return new Response(null, { status: 404 });

// Nerodomo failo patikra atliekama nukreipimo tiksle (/failas/{id}), kuris
// naudoja `files."hidden"` pagal failo id.
const result = await postgres.query(
  `SELECT f.id FROM files.files f
   JOIN files."sourceTitles" st ON st.id = f."sourceTitleId"
   WHERE st.title = 'sutartys' AND f."sourceId0" = $1::text AND f."sourceId1" = $2::text
   LIMIT 1`,
  [String(dokId), String(fileId)],
);
if (!result.rows.length) return new Response(null, { status: 404 });

return Astro.redirect(`/failas/${result.rows[0].id}`, 301);
---
