---
import Layout from '../../layouts/Layout.astro';
import { getColorScheme, getFont } from '../../lib/failai.js';
import { postgres } from '@/postgres/postgres.js';
import { checkDokFileRemoved } from '@/modules/failai/queries.js';
import FailasPreview from '../../components/failai/FailasPreview.astro';
import FailasOcr from '../../components/failai/FailasOcr.astro';
import MapPoint from '../../components/failai/MapPoint.astro';
import Domenai from '../../components/failai/Domenai.astro';
import Nuorodos from '../../components/failai/Nuorodos.astro';
import Emails from '../../components/failai/Emails.astro';
import Telefonai from '../../components/failai/Telefonai.astro';
import IbanNumeriai from '../../components/failai/IbanNumeriai.astro';
import Parasai from '../../components/failai/Parasai.astro';
import { convertUnit } from '@/utils/units.js';

function parseSuffix(raw: string) {
  if (raw.endsWith('.json')) return { value: raw.slice(0, -5), format: 'json' };
  if (raw.endsWith('.png'))  return { value: raw.slice(0, -4),  format: 'png'  };
  return { value: raw, format: 'html' };
}

const { id: rawId } = Astro.params;
const { value: id, format } = parseSuffix(rawId!);

if (isNaN(Number(id))) return Astro.redirect('/404');

const result = await postgres.query(`SELECT * FROM failai WHERE "id" = $1 LIMIT 1`, [id]);
if (!result.rows.length) return Astro.redirect('/404');
let failas = result.rows[0];

if (format === 'png') {
  return new Response(new Uint8Array(await (await import('@/utils/openGraphImage.js')).getOpenGraphImage((failas.extension || '').toUpperCase() || 'Failas', failas.pavadinimas || 'Failas', failas.dydis ? convertUnit(failas.dydis, 'B') : '', `viespirkiai.org/failas/${failas.id}`)), {
    headers: { 'Content-Type': 'image/png', 'Cache-Control': 'public, max-age=7200, s-maxage=7200' },
  });
}

if (await checkDokFileRemoved(failas.dokId, failas.fileId)) {
  return new Response(await (await import('../../components/failai/FailasPasalintas.astro')).default.toString(), { status: 451 });
}

if (format === 'json') {
  return new Response(JSON.stringify({ ...failas, ...(await (await import('@/modules/failai/aptarnavimas.js')).fetchFailasMetadata(failas.id)) }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

// HTML — enrich failas using aptarnautiFailą logic
failas = { ...failas, ...(await (await import('@/modules/failai/aptarnavimas.js')).fetchFailasMetadata(failas.id)) };

// Apply all the same transformations from aptarnautiFailą
const { Buffer } = await import('buffer');
function decodeQPAttachmentName(name: string) {
  if (!/=\?UTF-8\?Q\?.+\?=/i.test(name)) return name;
  return name.replace(/=\?UTF-8\?Q\?(.+?)\?=/i, (_: string, encoded: string) => {
    const qp = encoded.replace(/_/g, ' ');
    const bytes = qp.replace(/=([0-9A-Fa-f]{2})/g, (_: string, hex: string) => String.fromCharCode(parseInt(hex, 16)));
    return Buffer.from(bytes, 'binary').toString('utf8');
  });
}

failas.metaduomenys?.signatures?.forEach((sig: any) => {
  if (sig.signerFullDistinguishedName)
    sig.signerFullDistinguishedName = sig.signerFullDistinguishedName.replace(/\d{4,}/g, '');
});
failas.metaduomenys?.attachments?.forEach((a: any) => { a.name = decodeQPAttachmentName(a.name); });

if (failas.location) {
  const { parseWKBPoint } = await import('@/modules/geografija/utils.js');
  failas.location = parseWKBPoint(failas.location);
}

// Resolve related archive files
if (failas?.metaduomenys?.files) {
  const paths = failas.metaduomenys.files.map((f: any) => f.path).filter(Boolean);
  if (paths.length) {
    const related = await postgres.query(`SELECT * FROM failai WHERE parent = $1 AND "saltinioId" = ANY($2)`, [failas.id, paths]);
    const relatedFiles = related.rows;
    failas.metaduomenys.files = failas.metaduomenys.files.map((file: any) => {
      if (file.path) { const m = relatedFiles.find((f: any) => f.saltinioId === file.path); if (m) { file.id = m.id; if (m.extension) file.extension = m.extension; } }
      return file;
    });
    function enrichNode(node: any) {
      if (node.path) { const m = failas.metaduomenys.files.find((f: any) => f.path === node.path); if (m) { node.id = m.id; if (m.extension) node.extension = m.extension; } }
      node.children?.forEach(enrichNode);
    }
    failas.metaduomenys.filesTree?.forEach(enrichNode);
  }
}

failas.extension = (failas.extension || '').toLowerCase();

function computeOriginalusLinkas(f: any) {
  if (f.saltinis === 'sutartys' || !f.saltinis) return { linkas: `https://eviesiejipirkimai.lt/download.php?dok_id=${f.dokId}&file_id=${f.fileId}`, pavadinimas: 'CVP IS' };
  if (f.saltinis === 'neskelbiamosDerybos') return { linkas: `https://eviesiejipirkimai.lt/${f.saltinioId}`, pavadinimas: 'CVP IS' };
  if (f.saltinis === 'archive') return { linkas: `/failas/${f.parent}`, pavadinimas: 'Archyvas' };
  if (f.saltinis === 'mvpAprasai') return { linkas: `https://mw.eviesiejipirkimai.lt/vpm/SVPTS/svpts_paieska.asp?&Itemid=112`, pavadinimas: 'VPM IS' };
  if (f.saltinis === 'cvpIs') { const parts = f.saltinioId.split('/'); return { linkas: `https://viesiejipirkimai.lt/epps/cft/downloadDocumentVersion.do?versionId=${parts[2]}&documentId=${parts[1]}`, pavadinimas: 'CVP IS' }; }
  if (f.saltinis === 'cvpp') { const parts = String(f.saltinioId || '').split('/').filter(Boolean); const pid = parts.length >= 3 ? parts[0] : null; return { linkas: pid ? `https://pirkimai.eviesiejipirkimai.lt/app/rfq/rwlentrance_s.asp?PID=${encodeURIComponent(pid)}&B=PPO` : `https://cvpp.eviesiejipirkimai.lt`, pavadinimas: 'CVPP' }; }
  return { linkas: null, pavadinimas: null };
}
function computeSaltinioLinkas(f: any) {
  if (f.saltinis === 'sutartys' || !f.saltinis) return `/sutartis/${f.dokId}`;
  if (f.saltinis === 'neskelbiamosDerybos') return `/neskelbiamos`;
  if (f.saltinis === 'archive') return `/failas/${f.parent}`;
  if (f.saltinis === 'mvpAprasai') return `https://mw.eviesiejipirkimai.lt/vpm/SVPTS/svpts_paieska.asp?&Itemid=112`;
  if (f.saltinis === 'cvpIs') return `/viesiejiPirkimai/${f.saltinioId?.split('/')[0]}`;
  if (f.saltinis === 'cvpp') return f.originalusLinkas;
  return null;
}
function computeSaltinioLinkoPavadinimas(f: any) {
  if (f.saltinis === 'sutartys' || !f.saltinis) return `Sutartis ${f.dokId}`;
  if (f.saltinis === 'neskelbiamosDerybos') return `Neskelbiamos derybos`;
  if (f.saltinis === 'archive') return `Archyvas ${f.parent}`;
  if (f.saltinis === 'mvpAprasai') return `MVP tvarkos aprašai`;
  if (f.saltinis === 'cvpIs') return `Viešasis pirkimas ${f.saltinioId?.split('/')[0]}`;
  if (f.saltinis === 'cvpp') return `CVPP viešasis pirkimas`;
  return null;
}
const libreFormats = new Set(['doc','docx','odt','rtf','xls','xlsx','xlsb','ods','ppt','pptx','ppsx','odp','odg','pub','pages','xlt','dot','docm','dotx']);
const imageFormats = new Set(['jpg','jpeg','png','bmp','gif','tif','tiff','jfif','heic','webp']);
const archiveFormats = new Set(['zip','7z','rar','adoc']);
function computePreviewType(f: any) {
  const ext = f.extension;
  if (ext === 'pdf' || ext === 'prn' || libreFormats.has(ext)) return 'pdf';
  if (archiveFormats.has(ext) && f.metaduomenys?.filesTree) return 'archive';
  if (ext === 'mp4') return 'mp4';
  if (ext === 'mp3') return 'mp3';
  if (imageFormats.has(ext)) return 'image';
  if (ext === 'url') return 'url';
  if (ext === 'txt') return 'txt';
  if (ext === 'fax' && f.md5 === 'e083b15bc91cd24583955d3493347f7a') return 'fax-special';
  if (['html','htm','svg'].includes(ext)) return 'html';
  if ((ext === 'eml' || ext === 'msg') && f.metaduomenys) return 'email';
  return 'none';
}

const { linkas, pavadinimas } = computeOriginalusLinkas(failas);
failas.originalusLinkas = linkas;
failas.originalusLinkasPavadinimas = pavadinimas;
failas.saltinioLinkas = computeSaltinioLinkas(failas);
failas.saltinioLinkoPavadinimas = computeSaltinioLinkoPavadinimas(failas);

const ocrStateTextMap: Record<string, string> = { '1': 'Baigta', '0': 'Rekomenduojama', '-1': 'Nepavyko', '-3': 'Rezervuota', '-6': 'Viršijo bandymus' };
const ocrStateKey = failas.ocrState === null || failas.ocrState === undefined ? null : String(failas.ocrState);
failas.ocrStateKey = ocrStateKey;
failas.ocrStateText = ocrStateKey && ocrStateTextMap[ocrStateKey] ? ocrStateTextMap[ocrStateKey] : 'Nežinoma';
failas.hasOcrSection = ocrStateKey !== null || !!failas.ocrLatestResult;
failas.previewType = computePreviewType(failas);
failas.isLibreFormat = libreFormats.has(failas.extension);

if (failas.previewType === 'txt') {
  let t = failas.tekstas;
  if (Array.isArray(t)) t = t.map((p: any) => String(p ?? '')).join('');
  else if (typeof t === 'string') { try { const pages = JSON.parse(t); if (Array.isArray(pages)) t = pages.map((p: any) => String(p ?? '')).join(''); } catch {} }
  else if (t != null) t = String(t);
  failas.tekstasPerziurai = (t || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n');
}

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);
const ogTitle = failas.metaduomenys?.Title || failas.pavadinimas || 'Failas';
const ogParts = [failas.extension?.toUpperCase(), failas.dydis ? convertUnit(failas.dydis, 'B') : null].filter(Boolean);
const search = Astro.url.searchParams.get('search') || '';
---
<Layout
  pageTitle={ogTitle}
  pageDescription={ogParts.join(' · ')}
  pageImage={`https://viespirkiai.org/failas/${failas.id}.png`}
  colorScheme={colorScheme}
  font={font}
>
  {failas.location && (
    <script>
    {`(function(){window.__vpLeaflet=window.__vpLeaflet||{loading:null,loaded:false};const s=window.__vpLeaflet;window.__vpLeafletLoad=window.__vpLeafletLoad||function(){if(!document.querySelector('link[data-vp-leaflet-css="1"]')){const l=document.createElement('link');l.rel='stylesheet';l.href='/dist/leaflet.css';l.dataset.vpLeafletCss='1';document.head.appendChild(l);}if(s.loaded)return s.loading||Promise.resolve();if(s.loading)return s.loading;s.loading=new Promise((r,j)=>{const sc=document.createElement('script');sc.src='/dist/leaflet.js';sc.defer=true;sc.dataset.vpLeafletJs='1';sc.onload=()=>{s.loaded=true;r();};sc.onerror=j;(document.body||document.head).appendChild(sc);});return s.loading;};try{window.__vpLeafletLoad();}catch(e){}})();`}
    </script>
  )}

  <style>
    .failas-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 28px; align-items: start; }
    @media (max-width: 900px) {
      .failas-grid { grid-template-columns: 1fr; }
      .failas-grid > div:last-child { order: -1; }
      .failas-grid iframe { height: 50vh; }
    }
  </style>

  <main>
    <div class="page-header">
      <div>
        {failas.metaduomenys?.Title ? (
          <>
            <p class="text-muted text-sm mb-1">{failas.pavadinimas}</p>
            <h1 class="mb-0">{failas.metaduomenys.Title}</h1>
          </>
        ) : (
          <h1 class="mb-0">{failas.pavadinimas}</h1>
        )}
      </div>

      <div class="flex flex-wrap gap-2 items-center">
        <a href={`/failas/${failas.id}.json`} class="btn btn-outline btn-sm" aria-label="Atsisiųsti failo metaduomenis JSON formatu">
          <span aria-hidden="true">↗</span> JSON
        </a>
        <a href={`https://failai.viespirkiai.org/${failas.id}`} class="btn btn-outline btn-sm" aria-label="Atsisiųsti failą">
          <span aria-hidden="true">↗</span> Failas
        </a>
        {failas.previewType === 'pdf' && (
          <a href={`/dist/pdfjs/web/viewer.html?file=${encodeURIComponent(`/failas/${failas.id}/preview`)}#search=${encodeURIComponent(search)}`} class="btn btn-outline btn-sm" aria-label="Atidaryti PDF peržiūrą">
            <span aria-hidden="true">↗</span> Padidinti
          </a>
        )}
        {failas.originalusLinkas && (
          <a href={failas.originalusLinkas} class="btn btn-outline btn-sm" aria-label={`Atidaryti ${failas.originalusLinkasPavadinimas}`}>
            <span aria-hidden="true">↗</span> {failas.originalusLinkasPavadinimas}
          </a>
        )}
      </div>
    </div>

    <div class="failas-grid mb-10">
      <div class="flex flex-col gap-4">

        <div>
          <h2 class="mb-3 no-style">Failas</h2>
          <dl class="kv-list">
            <dt>Formatas</dt>
            <dd><span class="cell-mono">{failas.extension || '—'}</span></dd>
            <dt>Dydis</dt>
            <dd>
              {(failas.dydis || failas.dydis === 0)
                ? <span class="cell-mono">{convertUnit(failas.dydis, 'B')}</span>
                : '—'
              }
            </dd>
            <dt>MD5</dt>
            <dd><span class="cell-mono wrap-anywhere">{failas.md5 || '—'}</span></dd>
            <dt>Šaltinis</dt>
            <dd><a href={failas.saltinioLinkas}>{failas.saltinioLinkoPavadinimas}</a></dd>
          </dl>
        </div>

        {failas.location && (
          <div>
            <h2 class="mb-3 no-style">Vieta</h2>
            <MapPoint id="failas-map" lat={failas.location.lat} lon={failas.location.lon} zoom={14} height="220px" class="map-container" style="border-radius:var(--radius-md);" showLink={true} linkText="auto" />
          </div>
        )}

        {failas.metaduomenys ? (
          <>
            <div>
              <h2 class="mb-3 no-style">Dokumentas</h2>
              <dl class="kv-list">
                <dt>Puslapių skaičius</dt>
                <dd><span class="cell-mono">{failas.metaduomenys.pageCount || failas.puslapiuSkaicius || '—'}</span></dd>
                <dt>Žodžių skaičius</dt>
                <dd><span class="cell-mono">{failas.metaduomenys.wordCount || failas.zodziuSkaicius || '—'}</span></dd>
                <dt>Programa</dt>
                <dd>{failas.metaduomenys.Producer || failas.metaduomenys.producer || '—'}</dd>
                <dt>Autorius</dt>
                <dd>{failas.autorius || failas.metaduomenys.Author || '—'}</dd>
              </dl>
            </div>

            <div>
              <h2 class="mb-3 no-style">Turinys</h2>
              <dl class="kv-list">
                <Domenai domains={failas.domains} />
                <Nuorodos links={(failas.links || []).filter((l: any) => !l.link.startsWith('mailto:'))} />
                <Emails emails={failas.emails} />
                <Telefonai telefonai={failas.telefonai} />
                <IbanNumeriai ibanNumeriai={failas.metaduomenys.ibanNumeriai} />
                <Parasai signatures={failas.metaduomenys.signatures} />
              </dl>
            </div>
          </>
        ) : (
          <p class="text-muted text-sm text-center mb-10"><em>Dokumento metaduomenų nėra</em></p>
        )}

        {failas.hasOcrSection && <FailasOcr failas={failas} />}
      </div>

      <div>
        <FailasPreview failas={failas} search={search} />
      </div>
    </div>
  </main>
</Layout>
