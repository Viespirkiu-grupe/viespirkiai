---
import Layout from '../../layouts/Layout.astro';
import Map from '@design-system/components/maps/Map.astro';
import KeyValueList from '@design-system/components/KeyValueList.astro';
import Alert from '@design-system/components/Alert.astro';
import { getColorScheme, getFont } from '../../lib/failai.js';
import { loadFailasById, enrichFailas, parseSuffix, turiPerziurosSkydeli, failoPerziurosKelias } from '../../lib/failas.js';
import { getFailasNerodymas } from '@/modules/failai/queries.js';
import FailasPreview from '../../components/failai/FailasPreview.astro';
import FailoPerziurosSkydelis from '../../components/failai/FailoPerziurosSkydelis.astro';
import FailasOcr from '../../components/failai/FailasOcr.astro';
import Domenai from '../../components/failai/Domenai.astro';
import Nuorodos from '../../components/failai/Nuorodos.astro';
import Emails from '../../components/failai/Emails.astro';
import Telefonai from '../../components/failai/Telefonai.astro';
import IbanNumeriai from '../../components/failai/IbanNumeriai.astro';
import Parasai from '@design-system/components/content/SignatureList.astro';
import FailasPasalintas from '../../components/failai/FailasPasalintas.astro';
import FailoAntraste from '../../components/failai/FailoAntraste.astro';
import PpaAtaskaita from '../../components/failai/PpaAtaskaita.astro';
import { loadPpaByFailasId } from '../../lib/ppa.js';
import { convertUnit } from '@/utils/units.js';

const { id: rawId } = Astro.params;
const { value: id, format } = parseSuffix(rawId!);

if (isNaN(Number(id))) return Astro.redirect('/404');

let failas = await loadFailasById(id);
if (!failas) return Astro.redirect('/404');

if (format === 'png') {
  return new Response(new Uint8Array(await (await import('@/utils/openGraphImage.js')).getOpenGraphImage((failas.extension || '').toUpperCase() || 'Failas', failas.pavadinimas || 'Failas', failas.dydis ? convertUnit(failas.dydis, 'B') : '', `viespirkiai.org/failas/${failas.id}`)), {
    headers: { 'Content-Type': 'image/png', 'Cache-Control': 'public, max-age=7200, s-maxage=7200' },
  });
}

// Ar failas paslėptas (filesHidden) — jei taip, rodom skirtą puslapį su
// vieša priežastimi ir lentelėje nurodytu HTTP statusu (numatyta 451).
const nerodymas = await getFailasNerodymas(failas.id);
const isPasalintas = !!nerodymas;
if (isPasalintas) {
  Astro.response.status = nerodymas!.status ?? 451;
}

if (format === 'json') {
  return new Response(JSON.stringify({ ...failas, ...(await (await import('@/modules/failai/aptarnavimas.js')).fetchFailasMetadata(failas.id)) }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

let ppa = null;
if (!isPasalintas) {
  failas = await enrichFailas(failas);
  if (failas.specialTypes?.includes('PPA') || failas.tipas === 'PPA') {
    ppa = await loadPpaByFailasId(failas.id);
  }
}

Astro.response.headers.set('Cache-Control', 'private, max-age=10');

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);
const ogTitle = isPasalintas ? 'Dokumentas nerodomas' : (failas.metaduomenys?.Title || failas.pavadinimas || 'Failas');
const ogParts = [failas.extension?.toUpperCase(), failas.dydis ? convertUnit(failas.dydis, 'B') : null].filter(Boolean);
const search = Astro.url.searchParams.get('search') || '';
const pageParam = Astro.url.searchParams.get('puslapis') || Astro.url.searchParams.get('page') || '';
const page = /^\d+$/.test(pageParam) ? pageParam : '';

// Peržiūra rodoma kabančiame rėme (kaip teisės akto tekstas) tik tada, kai jį
// yra kuo užpildyti. PPA ataskaita turi savo korteles su skirtukais — ten
// maketas lieka paprastas.
const skydelis = !isPasalintas && !ppa && turiPerziurosSkydeli(failas);
const perziurosHref = failoPerziurosKelias(failas.id, { search, puslapis: page });
---
<Layout
  pageTitle={ogTitle}
  pageDescription={ogParts.join(' · ')}
  pageImage={`https://viespirkiai.org/failas/${failas.id}.png`}
  colorScheme={colorScheme}
  font={font}
>
  <style>
    .failas-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 28px; align-items: start; }
    .failas-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--color-border); margin-bottom: 24px; }
    .failas-tab {
      appearance: none; background: none; border: none; cursor: pointer;
      padding: 10px 16px; font: inherit; font-weight: 600; color: var(--color-muted);
      border-bottom: 2px solid transparent; margin-bottom: -1px;
    }
    .failas-tab:hover { color: inherit; }
    .failas-tab.is-active { color: inherit; border-bottom-color: var(--color-primary); }
    @media (max-width: 900px) {
      .failas-grid { grid-template-columns: 1fr; }
      .failas-grid > div:last-child { order: -1; }
      .failas-grid iframe { height: 50vh; }
    }

    /* ── Perskeltas maketas: kairėje viskas apie failą, dešinėje — pats failas.
       Dešinė skiltis „prilipusi", tad skaitant ilgą dokumentą kairė kolona
       nenuslenka iš akių, o pasibaigus turiniui abi kartu pasitraukia prieš
       poraštę (tas pats sprendimas kaip teisės akto puslapyje). */
    /* `align-items` čia numatytas (`stretch`), o ne `start` kaip įprastame
       makete: peržiūros stulpelis turi driektis per visas groteles, kitaip
       prilipusiam rėmui nebūtų kur keliauti. */
    .failas-grid.is-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 20px;
      margin-bottom: 0;
      align-items: stretch;
    }
    .failas-grid.is-split .failas-info { padding-bottom: 40px; }
    /* Poraštė prasideda iškart po rėmu — bendras tarpas paliktų tuščią juostą
       po per visą ekraną nusidriekusia peržiūra. Taisyklė galioja tik tada, kai
       puslapyje tikrai yra kabantis rėmas. */
    :global(body:has(.failas-grid.is-split) .site-footer-shell) { margin-block-start: 0; }
    /* Rėmas prilimpa po antrašte ir ribojasi savo langeliu — pasibaigus kairės
       kolonos turiniui jis savaime atsisėda ir neužlipa ant poraštės. Dešinėje
       eina iki lango krašto: `main` šoninė paraštė ten tik paliktų tuščią
       juostelę, todėl ją atitraukiam neigiama parašte. */
    .failas-preview-col {
      --failas-top: var(--site-header-offset, 58px);
      min-width: 0;
      display: flex;
      flex-direction: column;
      margin-right: -56px;
    }
    /* Kabėjimas ir jo apvadai galioja tik perskeltame makete — siaurame ekrane
       rėmas eina paprastu srautu ir lieka toks, kokį jį aprašo pats komponentas. */
    @media (min-width: 1101px) {
      .failas-preview-col :global(.failas-panel) {
        position: sticky;
        top: var(--failas-top);
        /* Be `flex: none` stulpelio flex patemptų rėmą per visą grotelių aukštį
           ir užgožtų čia nurodytą lango aukštį. */
        flex: none;
        height: calc(100dvh - var(--failas-top));
        /* Lieka tik kairė linija: viršuje jau yra antraštės apvadas, apačioje ir
           dešinėje — lango kraštas, tad kiti kraštai dvigubintų liniją. */
        border-block: 0;
        border-right: 0;
        border-radius: 0;
      }
    }
    @media (min-width: 1101px) and (max-width: 1200px) {
      .failas-preview-col { margin-right: -28px; }
    }
    @media (max-width: 1100px) {
      .failas-grid.is-split { grid-template-columns: minmax(0, 1fr); }
      /* Telefone svarbesnis pats dokumentas — keliam jį virš metaduomenų.
         Vietą rezervuoja pats grotelių langelis dar iki peržiūros užsikrovimo:
         18rem turiniui + 17px nuplėšimo mygtukui. */
      .failas-preview-col {
        order: -1;
        height: calc(18rem + 17px);
        flex: none;
        margin-top: 12px;
        margin-right: 0;
        margin-bottom: 28px;
      }
    }
  </style>

  {isPasalintas ? (
    <FailasPasalintas priezastis={nerodymas!.priezastis} status={nerodymas!.status ?? 451} />
  ) : (
  <main>
    {!skydelis && <FailoAntraste failas={failas} meta={ogParts.join(' · ')} />}

    <div class:list={['failas-grid', skydelis ? 'is-split' : 'mb-10']}>
      <div class="failas-info flex flex-col gap-4">
        {skydelis && (
          <FailoAntraste failas={failas} meta={ogParts.join(' · ')} skydelis={true} perziurosHref={perziurosHref} />
        )}

        {failas.password && (
          <Alert variant="warning" icon="!" title="Failas apsaugotas slaptažodžiu" className="w-fit max-w-full mb-0">
            Slaptažodis: <strong class="cell-mono wrap-anywhere">{failas.password}</strong>
          </Alert>
        )}

        <div>
          <h2 class="mb-3 no-style">Failas</h2>
          <KeyValueList>
            <dt>Formatas</dt>
            <dd><span class="cell-mono">{failas.extension || '—'}</span></dd>
            <dt>Dydis</dt>
            <dd>
              {(failas.dydis || failas.dydis === 0)
                ? <span class="cell-mono">{convertUnit(failas.dydis, 'B')}</span>
                : '—'
              }
            </dd>
            <dt>MD5</dt>
            <dd><span class="cell-mono wrap-anywhere">{failas.md5 || '—'}</span></dd>
            <dt>Šaltinis</dt>
            <dd><a href={failas.saltinioLinkas}>{failas.saltinioLinkoPavadinimas}</a></dd>
          </KeyValueList>
          {skydelis && failas.isLibreFormat && (
            <p class="text-muted text-xs mt-3 mb-0"><em>Dokumentas konvertuotas į PDF naudojant LibreOffice, gali būti atvaizduojamas iškraipytas.</em></p>
          )}
        </div>

        {failas.location && (
          <div>
            <h2 class="mb-3 no-style">Vieta</h2>
            <Map
              id="failas-map"
              lat={failas.location.lat}
              lon={failas.location.lon}
              zoom={14}
              height="220px"
              style="border-radius:var(--radius-md);"
              showLink={true}
              linkText="auto"
            />
          </div>
        )}

        {failas.metaduomenys ? (
          <>
            <div>
              <h2 class="mb-3 no-style">Dokumentas</h2>
              <KeyValueList>
                <dt>Puslapių skaičius</dt>
                <dd><span class="cell-mono">{failas.metaduomenys.pageCount || failas.puslapiuSkaicius || '—'}</span></dd>
                <dt>Žodžių skaičius</dt>
                <dd><span class="cell-mono">{failas.metaduomenys.wordCount || failas.zodziuSkaicius || '—'}</span></dd>
                <dt>Programa</dt>
                <dd>{failas.metaduomenys.Producer || failas.metaduomenys.producer || '—'}</dd>
                <dt>Autorius</dt>
                <dd>{failas.autorius || failas.metaduomenys.Author || '—'}</dd>
              </KeyValueList>
            </div>

            <div>
              <h2 class="mb-3 no-style">Turinys</h2>
              <KeyValueList>
                <Domenai domains={failas.domains} />
                <Nuorodos links={(failas.links || []).filter((l: any) => !l.link.startsWith('mailto:'))} />
                <Emails emails={failas.emails} />
                <Telefonai telefonai={failas.telefonai} />
                <IbanNumeriai ibanNumeriai={failas.metaduomenys.ibanNumeriai} />
                <Parasai signatures={failas.metaduomenys.signatures} />
              </KeyValueList>
            </div>
          </>
        ) : (
          <p class="text-muted text-sm text-center mb-10"><em>Dokumento metaduomenų nėra</em></p>
        )}

        {failas.hasOcrSection && <FailasOcr failas={failas} />}
      </div>

      <div class:list={[skydelis && 'failas-preview-col']}>
        {skydelis ? (
          <FailoPerziurosSkydelis failas={failas} search={search} page={page} perziurosHref={perziurosHref} />
        ) : ppa ? (
          <>
            <div class="failas-tabs" role="tablist" aria-label="Failo turinys">
              <button type="button" class="failas-tab is-active" role="tab" aria-selected="true" aria-controls="panel-ataskaita" data-tab="ataskaita">Ataskaita (PPA)</button>
              <button type="button" class="failas-tab" role="tab" aria-selected="false" aria-controls="panel-failas" data-tab="failas">Failas</button>
            </div>
            <div id="panel-ataskaita" role="tabpanel">
              <PpaAtaskaita ppa={ppa} />
            </div>
            <div id="panel-failas" role="tabpanel" hidden>
              <FailasPreview failas={failas} search={search} page={page} />
            </div>
          </>
        ) : (
          <FailasPreview failas={failas} search={search} page={page} />
        )}
      </div>
    </div>
  </main>
  )}

  {ppa && (
    <script is:inline>
      (() => {
        const tabs = document.querySelectorAll('.failas-tab');
        const panels = {
          failas: document.getElementById('panel-failas'),
          ataskaita: document.getElementById('panel-ataskaita'),
        };
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const key = tab.getAttribute('data-tab');
            tabs.forEach((t) => {
              const on = t === tab;
              t.classList.toggle('is-active', on);
              t.setAttribute('aria-selected', String(on));
            });
            for (const [k, el] of Object.entries(panels)) {
              if (el) el.hidden = k !== key;
            }
          });
        });
      })();
    </script>
  )}
</Layout>
