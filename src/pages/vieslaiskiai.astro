---
import Layout from '../layouts/Layout.astro';
import { getColorScheme, getFont } from '../lib/failai.js';
import { postgres } from '@/postgres/postgres.js';
import ImageTileGrid from '@design-system/components/content/ImageTileGrid.astro';
import NewsCardList from '@design-system/components/content/NewsCardList.astro';
import PageHeader from '@design-system/components/PageHeader.astro';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const vieslaiskiaiRes = await postgres.query('SELECT * FROM vieslaiskiai ORDER BY id DESC;');
const vieslaiskiai = vieslaiskiaiRes.rows;

const vieslaiskiuTiles = vieslaiskiai.map((vieslaiskis: any) => ({
  href: vieslaiskis.nuoroda,
  src: vieslaiskis.nuotrauka,
  alt: `${vieslaiskis.pavadinimas} (PDF)`,
}));

const ziniasklaidojeRes = await postgres.query('SELECT * FROM "vieslaiskiaiZiniasklaidoje" ORDER BY date DESC, id DESC;');
const vieslaiskiaiZiniasklaidoje = ziniasklaidojeRes.rows;
---
<Layout
  pageTitle="Viešlaiškiai"
  pageDescription="Viešpirkių iniciatyvos viešlaiškiai"
  pageImage="https://viespirkiai.org/vieslaiskiai/vieslaiskiai.png"
  colorScheme={colorScheme}
  font={font}
>
  <main>
    <PageHeader>Viešlaiškiai</PageHeader>

    <p class="text-muted mb-10">Mūsų iniciatyvos subjektyvios vertinančiosios nuomonės apie kai kuriuos viešuosius pirkimus arba su jais susijusias problemas.</p>

    <ImageTileGrid items={vieslaiskiuTiles} />

    <NewsCardList
      title="Žiniasklaidoje"
      items={vieslaiskiaiZiniasklaidoje.map((rezultatas: any) => ({
        href: rezultatas.link,
        title: rezultatas.pavadinimas,
        source: rezultatas.saltinis,
        date: rezultatas.date,
        relatedHref: rezultatas.vieslaiskisLink,
        relatedLabel: rezultatas.vieslaiskis,
      }))}
    />
  </main>
</Layout>
