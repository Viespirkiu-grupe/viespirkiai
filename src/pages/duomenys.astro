const softwareSections = [
  {
    title: 'Operacinė sistema',
    items: [{ href: 'https://ubuntu.com/download/server', label: 'Ubuntu Server 24.04 LTS' }],
  },
  {
    title: 'Duomenų bazės',
    items: [
      { href: 'https://www.postgresql.org/', label: 'PostgreSQL' },
      { href: 'https://typesense.org/', label: 'Typesense' },
    ],
  },
  {
    title: 'Programavimo kalbos',
    items: [{ href: 'https://nodejs.org/en', label: 'JavaScript / NodeJS' }],
  },
  {
    title: 'Failų sistema',
    items: [{ href: 'https://en.wikipedia.org/wiki/ZFS', label: 'ZFS' }],
  },
  {
    title: 'Komunikavimo priemonės',
    items: [
      { href: 'https://www.postfix.org/', label: 'Postfix' },
      { href: 'https://signal.org/', label: 'Signal' },
      { href: 'https://matrix.org/', label: 'Matrix' },
      { href: 'https://joinmastodon.org', label: 'Mastodon' },
    ],
  },
  {
    title: 'Komandoje naudojami įrankiai',
    items: [
      { href: 'https://nextcloud.com/', label: 'Nextcloud' },
      { href: 'https://libreoffice.org/', label: 'Libreoffice' },
    ],
  },
