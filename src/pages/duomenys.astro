Astro.response.headers.set('Cache-Control', 'private, max-age=10');
---
<Layout
  pageTitle="Duomenys"
  pageDescription="Viešai prieinami pirkimų, juridinių asmenų duomenys bei jų šaltiniai"
  pageImage="https://viespirkiai.org/duomenys.png"
  colorScheme={colorScheme}
  font={font}
>
  <main>
    <div class="page-header">
      <h1>Duomenys</h1>
    </div>

    <Alert variant="muted" icon="—" className="mb-7">
      Jokiems šioje svetainėje pateiktiems duomenims nėra taikomas jokios rūšies garantijos. Jie yra bendrinami siekiant padidinti viešųjų pirkimų skaidrumą ir padidinti valstybinių duomenų prieinamumą.
    </Alert>

    <section class="page-section" id="duomenu-eksportas">
      <h2>Duomenų eksportai</h2>
      <p>Mūsų surinkti duomenys mašininiu formatu prieinami adresu <a href="https://data.viespirkiai.org/">data.viespirkiai.org</a>.</p>
      <p>Dėl kitokių eksportų <a href="/kontaktai">susisiekite</a>.</p>
    </section>

    <hr class="my-7" />

    <section class="page-section" id="duomenu-saltiniai">
      <h2>Duomenų šaltiniai</h2>
      <p class="text-muted text-sm mb-7">Šioje svetainėje pateikiami duomenys yra surenkami iš viešai prieinamų šaltinių. Informaciją mes vizualizuojame ir pateikiame patogesne forma.</p>

      <div class="grid-2">
        <SourceGroup title="Juridinių asmenų informacija" items={legalEntitySources} />

        <div class="flex flex-col gap-5">
          {sourceLists.map((section) => (
            <LinkListSection title={section.title} items={section.items} />
          ))}
        </div>
      </div>
    </section>

    <hr class="my-7" />

    <section class="page-section" id="programineIranga">
      <h2>Naudojama programinė įranga</h2>
      <p class="text-muted text-sm mb-7">Visas mūsų projektas pastatytas naudojant atviro kodo programinę įrangą.</p>

      <div class="grid-3">
        {softwareSections.map((section) => (
          <LinkListSection title={section.title} items={section.items} />
        ))}
      </div>

      <p class="text-muted text-sm mt-7">Dėkojame visiems, kurie prisideda duomenimis, resursais, patobulinimais ar kitais būdais.</p>
    </section>
  </main>
</Layout>
