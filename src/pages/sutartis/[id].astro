---
import Layout from '../../layouts/Layout.astro';
import Alert from '@design-system/components/Alert.astro';
import ExternalSourceLink from '@design-system/components/ExternalSourceLink.astro';
import MoneyValue from '@design-system/components/MoneyValue.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import SutartisSalys from '../../components/sutartis/SutartisSalys.astro';
import SutartisDetails from '../../components/sutartis/SutartisDetails.astro';
import SutartisPranesimas from '../../components/sutartis/SutartisPranesimas.astro';
import SutartisKlasifikacija from '../../components/sutartis/SutartisKlasifikacija.astro';
import SutartisDokumentai from '../../components/sutartis/SutartisDokumentai.astro';
import SutartisEsProjektai from '../../components/sutartis/SutartisEsProjektai.astro';
import SutartisSabis from '../../components/sutartis/SutartisSabis.astro';
import SutartisPanasios from '../../components/sutartis/SutartisPanasios.astro';
import SutartisPakeitimai from '../../components/sutartis/SutartisPakeitimai.astro';
import DetailsSection from '@design-system/components/DetailsSection.astro';
import { loadSutartis, SABIS_SASKAITU_LIMIT } from '../../lib/sutartis.js';
import { countSutartisPakeitimai, loadSutartisPakeitimai } from '../../lib/sutartisPakeitimai.ts';
import { fmtEur } from '../../lib/formatters.ts';
import { getColorScheme, getFont } from '../../lib/failai.ts';
import config from '../../lib/config.ts';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const { id } = Astro.params;
if (!id || isNaN(parseInt(id))) return Astro.redirect('/404');

const saskaituPuslapis = Math.max(1, Math.floor(Number(Astro.url.searchParams.get('saskaituPuslapis')) || 1));
const sutartis = await loadSutartis(parseInt(id), {
  sabisSaskaitos: {
    limit: SABIS_SASKAITU_LIMIT,
    offset: (saskaituPuslapis - 1) * SABIS_SASKAITU_LIMIT,
    sort: Astro.url.searchParams.get('saskaituSort') ?? undefined,
    kryptis: Astro.url.searchParams.get('saskaituKryptis') ?? undefined,
  },
});
if (!sutartis) return Astro.redirect('/404');

if (Astro.url.pathname.endsWith('.json') || (Astro.request?.headers.get('accept') || '').includes('application/json')) {
  return new Response(JSON.stringify(sutartis, null, 2), { headers: { 'Content-Type': 'application/json' } });
}

const rodytiVisusPakeitimus = Astro.url.searchParams.get('pakeitimaiLimit') === 'max';
const pakeitimuLimitas = rodytiVisusPakeitimus ? null : 10;
const [pakeitimai, pakeitimuCount] = await Promise.all([
  loadSutartisPakeitimai(sutartis.sutartiesUnikalusId, pakeitimuLimitas),
  countSutartisPakeitimai(sutartis.sutartiesUnikalusId),
]);

Astro.response.headers.set('Cache-Control', 'private, max-age=10');

const sutartiesUnikalusID = sutartis.sutartiesUnikalusId;
const verte = sutartis.faktineIvykdimoVerte || sutartis.verte;
const cvpisUrl = `https://eviesiejipirkimai.lt/index.php?option=com_vptpublic&task=sutartys&Itemid=109&filter_dok_id=${sutartiesUnikalusID}`;

const pageTitle = `${fmtEur(verte)} € ${sutartis.pavadinimas}`;
const pageDescription = `Sutartis nr. ${sutartis.sutartiesNumeris}\nSudaryta: ${String(sutartis.sudarymoData).slice(0, 10)}\nGalioja iki: ${String(sutartis.galiojimoData).slice(0, 10)}`;
---

<Layout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageImage={`https://viespirkiai.org/sutartis/${sutartiesUnikalusID}.png`}
  pageAuthor={sutartis.perkanciojiOrganizacija}
  colorScheme={colorScheme}
  font={font}
  customHead={config.customHead}
>
  <main>

    <PageHeader>
      <Fragment slot="subtext">{sutartis.tipoPavadinimas}</Fragment>
      {sutartis.pavadinimas.length < 1 ? <em>Nenurodyta</em> : sutartis.pavadinimas}
      {' '}už <span class="amount"><MoneyValue value={verte} suffix={'\u00A0€'} mono={false} /></span>
      <Fragment slot="actions">
        <a href={`/sutartis/${sutartiesUnikalusID}.json`} class="btn btn-outline btn-sm" aria-label="Peržiūrėti sutarties JSON duomenis">↗ JSON</a>
        <ExternalSourceLink href={cvpisUrl} source="cvpis" variant="button" ariaLabel="Peržiūrėti sutarties CVP IS duomenis" />
        {config.enableGraph && (
          <a href={`/rysiai/asmuo/${sutartis.perkanciosiosOrganizacijosKodas}#o_2=${sutartis.tiekejoKodas}&f_2=DSLMGPABC&c_3=${sutartiesUnikalusID}&f_3=DSLMGPABC`} class="btn btn-outline btn-sm" aria-label="Peržiūrėti ryšių grafą">↗ Ryšiai</a>
        )}
        <a href={`mailto:pranesti@viespirkiai.org?subject=Dėl sutarties%20nr.%20${sutartiesUnikalusID}&body=Čia paaiškinkite, kodėl norėjote informuoti apie sutartį%0D%0A%0D%0Ahttps://viespirkiai.org/pirkimas/${sutartiesUnikalusID}`} class="btn btn-outline btn-sm" aria-label="Pranešti apie sutartį">↗ Pranešti</a>
      </Fragment>
    </PageHeader>

    {sutartis.istrinta && (
      <div class="sutartis-istrinta-alert">
        <Alert variant="danger" icon="🗑" title="Ištrinta">
          Sutartis buvo pašalinta iš CVP IS. Žemiau pateikiami
          paskutiniai mūsų užfiksuoti duomenys.
        </Alert>
      </div>
    )}

    <SutartisSalys sutartis={sutartis} />

    <div class="grid-3 mb-7">
      <SutartisDetails sutartis={sutartis} />
      <SutartisPranesimas sutartis={sutartis} />
      <SutartisKlasifikacija sutartis={sutartis} />
      <SutartisDokumentai dokumentai={sutartis.dokumentai} />
    </div>

    {pakeitimai.length > 0 && (
      <DetailsSection title="Pakeitimai" className="mb-7">
        <SutartisPakeitimai pakeitimai={pakeitimai} rodomiIsKarto={pakeitimai.length} />
        {!rodytiVisusPakeitimus && pakeitimuCount > 10 && (
          <p class="pakeitimai-daugiau">
            <a href="?pakeitimaiLimit=max">Rodyti visus pakeitimus ({pakeitimuCount})</a>
          </p>
        )}
      </DetailsSection>
    )}

    <SutartisEsProjektai sutartys={sutartis.cpvaProjektuSutartys} className="mb-7" />

    <SutartisSabis
      sutartys={sutartis.sabisSutartys}
      saskaitos={sutartis.sabisSaskaitos}
      className="mb-7"
    />

    <SutartisPanasios sutartys={sutartis.panasiosSutartys} />

  </main>
</Layout>

<style>
  .sutartis-istrinta-alert {
    margin-top: 24px;
  }

  .pakeitimai-daugiau {
    margin: 12px 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
