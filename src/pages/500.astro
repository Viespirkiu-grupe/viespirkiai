---
import Layout from '../layouts/Layout.astro';
const colorScheme = Astro.cookies.get('colorScheme')?.value || 'auto';
const font = Astro.cookies.get('font')?.value || 'ubuntu';
---
<Layout pageTitle="Vidinė serverio klaida" pageDescription="" pageImage="" colorScheme={colorScheme} font={font}>
  <main>
    <div class="empty-state">
      <div class="empty-state-icon">500</div>
      <h2>Vidinė serverio klaida</h2>
      <p class="text-muted">
        Jeigu bandėte atlikti paiešką, ji tikriausiai užtruko per ilgai.
        <br />
        Bandykite naudoti tikslesnius paieškos kriterijus.
      </p>
    </div>
  </main>
</Layout>
