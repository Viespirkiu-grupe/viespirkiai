---
import Layout from '../layouts/Layout.astro';
import Pagination from '../components/Pagination.astro';
import { postgres, getColorScheme, getFont, cleanQuery, parseLimit, buildNumberOfResults } from '../lib/failai.js';
import '@/utils/linksniai.js';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const cleaned = cleanQuery(Astro.url);
if ('redirectTo' in cleaned) return Astro.redirect(cleaned.redirectTo);
const query = cleaned.query;

const parsedLimit = parseLimit(query, 50, 250);
if ('error' in parsedLimit) return new Response(parsedLimit.error, { status: 400 });
const limit = parsedLimit.limit;

const currentPage = Math.max(1, parseInt(query.page) || 1);
const skip = (currentPage - 1) * limit;
const rawSearch = query.search || '';

const parseSearch = (searchTerm: string) => {
  const quoteMatch = searchTerm.match(/^"(.*)"$/);
  return {
    tsQueryFunc: quoteMatch ? 'phraseto_tsquery' : 'plainto_tsquery',
    cleanSearch: quoteMatch ? quoteMatch[1] : searchTerm,
  };
};

const NEPATIKIMAS_COLS = `
  nd."atvejoNr",
  nd."duomenuIvedimoData",
  nd."pirkimoVykdytojoPavadinimas",
  nd."tiekejoPavadinimas",
  nd."tiekejoJarKodas",
  nd."pirkimoNumeris",
  nd."sutartiesNutraukimoData"::date,
  nd."dataNuoKuriosSkaiciuojama"::date,
  nd."itrauktaIki"::date AS "itrauktasIki",
  nd."teismoData"::date,
  nd."teismoSprendimoData"::date,
  nd."teismoSprendimoLink",
  nd.metai,
  nd."paskutiniKartaMatytaSarase"`;

const MELAGINGAS_COLS = `
  nd."atvejoNr",
  nd."duomenuIvedimoData",
  nd."pirkimoVykdytojoPavadinimas",
  nd."tiekejoPavadinimas",
  nd."tiekejoJarKodas",
  nd."pirkimoNumeris",
  NULL::date AS "sutartiesNutraukimoData",
  nd."dataNuoKuriosSkaiciuojamasTerminas"::date AS "dataNuoKuriosSkaiciuojama",
  nd."itrauktasIki"::date,
  nd."teismoData"::date,
  NULL::date AS "teismoSprendimoData",
  nd."teismoSprendimoLink",
  nd.metai,
  nd."paskutiniKartaMatytaSarase"`;

const searchResultsQuery = (tsQueryFunc: string, limitParam: number, offsetParam: number) => `
  SELECT * FROM (
    SELECT ${NEPATIKIMAS_COLS}, NULL::text AS "irasymoPagrindas", 'Nepatikimas' AS "saltinis"
    FROM public."nepatikimiTiekejai" nd
    LEFT JOIN public."nepatikimiTiekejaiPagrindimai" p
      ON p."tiekejoJarKodas" = nd."tiekejoJarKodas" AND p."pirkimoNumeris" = nd."pirkimoNumeris"
    WHERE nd."search_index" @@ ${tsQueryFunc}('simple', $1)

    UNION ALL

    SELECT ${MELAGINGAS_COLS}, nd."irasymoPagrindas", 'Melagingas' AS "saltinis"
    FROM public."melagingiTiekejai" nd
    LEFT JOIN public."melagingiTiekejaiPagrindimai" p
      ON p."tiekejoJarKodas" = nd."tiekejoJarKodas" AND p."pirkimoNumeris" = nd."pirkimoNumeris"
    WHERE nd."search_index" @@ ${tsQueryFunc}('simple', $1)
  ) t
  ORDER BY "duomenuIvedimoData" DESC NULLS LAST
  LIMIT $${limitParam} OFFSET $${offsetParam}`;

const defaultResultsQuery = () => `
  SELECT * FROM (
    SELECT ${NEPATIKIMAS_COLS}, NULL::text AS "irasymoPagrindas", 'Nepatikimas' AS "saltinis"
    FROM public."nepatikimiTiekejai" nd
    LEFT JOIN public."nepatikimiTiekejaiPagrindimai" p
      ON p."tiekejoJarKodas" = nd."tiekejoJarKodas" AND p."pirkimoNumeris" = nd."pirkimoNumeris"

    UNION ALL

    SELECT ${MELAGINGAS_COLS}, nd."irasymoPagrindas", 'Melagingas' AS "saltinis"
    FROM public."melagingiTiekejai" nd
    LEFT JOIN public."melagingiTiekejaiPagrindimai" p
      ON p."tiekejoJarKodas" = nd."tiekejoJarKodas" AND p."pirkimoNumeris" = nd."pirkimoNumeris"
  ) t
  ORDER BY "duomenuIvedimoData" DESC NULLS LAST
  LIMIT $1 OFFSET $2`;

const queryNepatikimi = async ({ cleanSearch, tsQueryFunc, limit, skip }: { cleanSearch: string; tsQueryFunc: string; limit: number; skip: number; }) => {
  if (cleanSearch) {
    const [resultsRes, totalRes] = await Promise.all([
      postgres.query(searchResultsQuery(tsQueryFunc, 2, 3), [cleanSearch, limit, skip]),
      postgres.query(
        `SELECT COUNT(*) FROM (
          SELECT 1 FROM public."nepatikimiTiekejai" WHERE "search_index" @@ ${tsQueryFunc}('simple', $1)
          UNION ALL
          SELECT 1 FROM public."melagingiTiekejai" WHERE "search_index" @@ ${tsQueryFunc}('simple', $1)
        ) t`,
        [cleanSearch]
      ),
    ]);

    return {
      rows: resultsRes.rows,
      total: parseInt(totalRes.rows[0].count, 10),
    };
  }

  const [resultsRes, totalRes] = await Promise.all([
    postgres.query(defaultResultsQuery(), [limit, skip]),
    postgres.query(`
      SELECT (
        SELECT COUNT(*) FROM public."nepatikimiTiekejai" nd
        INNER JOIN public."nepatikimiTiekejaiPagrindimai" p
          ON p."tiekejoJarKodas" = nd."tiekejoJarKodas" AND p."pirkimoNumeris" = nd."pirkimoNumeris"
      ) + (
        SELECT COUNT(*) FROM public."melagingiTiekejai" nd
        INNER JOIN public."melagingiTiekejaiPagrindimai" p
          ON p."tiekejoJarKodas" = nd."tiekejoJarKodas" AND p."pirkimoNumeris" = nd."pirkimoNumeris"
      ) AS count`
    ),
  ]);

  return {
    rows: resultsRes.rows,
    total: parseInt(totalRes.rows[0].count, 10),
  };
};

const startedAt = Date.now();
const { tsQueryFunc, cleanSearch } = rawSearch ? parseSearch(rawSearch) : { tsQueryFunc: '', cleanSearch: '' };
const { rows, total } = await queryNepatikimi({ cleanSearch, tsQueryFunc, limit, skip });
const pageCount = Math.ceil(total / limit);

if (typeof query.json !== 'undefined') {
  return new Response(JSON.stringify({
    data: rows,
    currentPage,
    pageCount,
    total,
    limit,
  }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

const numberOfResults = buildNumberOfResults({
  rows,
  total,
  elapsed: Date.now() - startedAt,
  engine: 'PostgreSQL',
});

const queryParams = rawSearch ? `&search=${encodeURIComponent(rawSearch)}` : '';
---
<Layout
  pageTitle="Nepatikimų ir melagingą informaciją pateikusių tiekėjų paieška"
  pageDescription=""
  pageImage="https://viespirkiai.org/nepatikimi.png"
  colorScheme={colorScheme}
  font={font}
>
  <main>
    <form method="get" role="search" id="searchForm">
      <h1 class="mt-7">Nepatikimų ir melagingą informaciją pateikusių tiekėjų paieška</h1>

      <div class="search-bar">
        <label for="search">
          <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
          </svg>
          <span class="sr-only">Paieška</span>
        </label>

        <input
          type="search"
          name="search"
          id="search"
          class="search-bar__input"
          value={rawSearch}
          placeholder="Tekstinė paieška"
          enterkeyhint="search"
        />

        <button type="submit" class="btn btn-primary">Ieškoti</button>
      </div>
    </form>

    <div class="mt-10 max-w-lg center mx-auto">
      <div class="flex justify-between items-center mb-4">
        <span class="text-muted text-sm numberOfResults" set:html={numberOfResults}></span>
      </div>

      {rows.length === 0 ? (
        <div class="empty-state">
          <p class="text-muted">Rezultatų nerasta.</p>
        </div>
      ) : (
        <>
          <div class="result-list">
            {rows.map((item: any) => {
              let asmuoLink = `/asmuo/${item.tiekejoJarKodas}`;
              if (item.saltinis === 'Nepatikimas') asmuoLink += '#nepatikimi';
              else if (item.saltinis === 'Melagingas') asmuoLink += '#melagiai';

              return (
                <article class="result-card card-clickable">
                  <div class="result-card-body">
                    <dl class="result-card-meta">
                      <div>
                        <dt class="sr-only">Šaltinis</dt>
                        <dd>{item.saltinis}</dd>
                      </div>

                      <div>
                        <dt class="sr-only">Galiojimas</dt>
                        <dd>{item.dataNuoKuriosSkaiciuojama || 'nežinoma'} – {item.itrauktasIki || 'nežinoma'}</dd>
                      </div>

                      <div>
                        <dt class="sr-only">Pirmą kartą įvesta</dt>
                        <dd>Įvesta: {item.duomenuIvedimoData || 'nežinoma'}</dd>
                      </div>

                      <div>
                        <dt class="sr-only">Paskutinį kartą matyta</dt>
                        <dd>Matyta: {item.paskutiniKartaMatytaSarase}</dd>
                      </div>
                    </dl>

                    <h3 class="result-card-title">
                      <a href={asmuoLink}>{item.tiekejoPavadinimas}</a>
                    </h3>

                    {item.irasymoPagrindas && item.irasymoPagrindas.length > 3 ? (
                      <p class="text-sm mt-2 text-justify">{item.irasymoPagrindas}</p>
                    ) : item.itraukimoPriezastis && item.itraukimoPriezastis.length > 3 ? (
                      <p class="text-sm mt-2 text-justify">
                        {item.itraukimoPriezastis.charAt(0).toUpperCase() + item.itraukimoPriezastis.slice(1)}
                      </p>
                    ) : null}

                    {item.pagrindimas?.tiekejoPaaiskinimas?.length > 3 && (
                      <>
                        <blockquote class="mt-3">{item.pagrindimas.tiekejoPaaiskinimas}</blockquote>
                        {item.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda?.length > 3 && (
                          <a
                            href={item.pagrindimas.tiekejoPaaiskinimoDokumentoNuoroda}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm relative z-1"
                          >
                            ↗ Peržiūrėti dokumentą ({item.pagrindimas.paaiskinimoPateikimoData || 'Data nenurodyta'})
                          </a>
                        )}
                      </>
                    )}

                    <div class="result-card-footer">
                      <span><strong>Pirkėjas:</strong> {item.pirkimoVykdytojoPavadinimas || 'nenurodytas'}</span>
                      <span><strong>Pirkimo nr.:</strong> {item.pirkimoNumeris || 'nenurodytas'}</span>
                      {item.teismoSprendimoLink?.length > 5 && (
                        <span>
                          <a href={item.teismoSprendimoLink} target="_blank" rel="noopener noreferrer" class="relative z-1">↗ Teismo sprendimas</a>
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <Pagination currentPage={currentPage} pageCount={pageCount} queryParams={queryParams} />
        </>
      )}
    </div>
  </main>
</Layout>
