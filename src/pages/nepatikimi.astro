---
// Nepatikimų ir melagingą informaciją pateikusių tiekėjų paieška. Maketas — tas
// pats šoninės juostos idiomas kaip /sutartys ir /cvpp/ataskaitos. Variklis —
// vien Postgres: abiejose lentelėse kartu ~1 tūkst. eilučių, tad ir rezultatai,
// ir facetų `GROUP BY` skaičiuojami tiesiogiai.
import Layout from '../layouts/Layout.astro';
import Button from '@design-system/components/Button.astro';
import ResultCardShell from '@design-system/components/ResultCardShell.astro';
import ResultPageShell from '@design-system/components/content/ResultPageShell.astro';
import FilterGroup from '@design-system/components/filters/FilterGroup.astro';
import FilterPanel from '@design-system/components/filters/FilterPanel.astro';
import HistogramRangeFilter from '@design-system/components/filters/HistogramRangeFilter.astro';
import TextInput from '@design-system/components/inputs/TextInput.astro';
import DokFacetSection from '../components/dokumentai/DokFacetSection.astro';
import PgFacetModal from '../components/content/PgFacetModal.astro';
import { postgres, getColorScheme, getFont, parseLimit, buildNumberOfResults } from '../lib/failai.js';
import {
  SqlParams, buildMonthHistogram, makeFacet, makeFacetToggleUrl,
  parseMultiParam, stripEmptyParams, toFacetOptions,
} from '../lib/pgFacets.ts';
import '@/utils/linksniai.js';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

// Tuščius laukus (GET forma pateikia ir tuščius) nusukam iš URL. Savo valymas, o
// ne bendras `cleanQuery` — tas suplotų kartojamus facetų parametrus į vieną.
const redirectTo = stripEmptyParams(Astro.url);
if (redirectTo) return Astro.redirect(redirectTo);
const query = Object.fromEntries(Astro.url.searchParams) as Record<string, string>;

const parsedLimit = parseLimit(query, 50, 250);
if ('error' in parsedLimit) return new Response(parsedLimit.error, { status: 400 });
const limit = parsedLimit.limit;

const currentPage = Math.max(1, parseInt(query.page) || 1);
const skip = (currentPage - 1) * limit;
const rawSearch = query.search || '';

const datePattern = /^\d{4}-\d{2}-\d{2}$/;
const ivestaNuo = (query.ivestaNuo || '').trim();
const ivestaIki = (query.ivestaIki || '').trim();
if ((ivestaNuo && !datePattern.test(ivestaNuo)) || (ivestaIki && !datePattern.test(ivestaIki))) {
  return new Response('Datos turi būti YYYY-MM-DD formato.', { status: 400 });
}
const pirkimoNumeris = (query.pirkimoNumeris || '').trim();

const FACET_PARAMS = ['saltinis', 'busena', 'pirkejas', 'tiekejoKodas'] as const;
const selected: Record<string, string[]> = Object.fromEntries(
  FACET_PARAMS.map((param) => [param, parseMultiParam(Astro.url, param)]),
);
const toggleUrl = makeFacetToggleUrl(Astro.url, '/nepatikimi');

const activeFilterCount = FACET_PARAMS.reduce((sum, param) => sum + selected[param].length, 0)
  + (pirkimoNumeris ? 1 : 0) + (ivestaNuo ? 1 : 0) + (ivestaIki ? 1 : 0);

const quoteMatch = rawSearch.match(/^"(.*)"$/);
const tsQueryFunc = quoteMatch ? 'phraseto_tsquery' : 'plainto_tsquery';
const cleanSearch = quoteMatch ? quoteMatch[1] : rawSearch;

// Abu sąrašai suvienodinami į vieną `nd` CTE: bendri stulpeliai, sąrašo
// pavadinimas (`saltinis`) ir išvestinė įtraukimo būsena (`busena`).
const BASE_CTE = `
  WITH raw AS (
    SELECT
      "atvejoNr", "duomenuIvedimoData", "pirkimoVykdytojoPavadinimas", "tiekejoPavadinimas",
      "tiekejoJarKodas", "pirkimoNumeris", "sutartiesNutraukimoData"::date,
      "dataNuoKuriosSkaiciuojama"::date, "itrauktaIki"::date AS "itrauktasIki",
      "teismoData"::date, "teismoSprendimoData"::date, "teismoSprendimoLink", metai,
      "paskutiniKartaMatytaSarase", NULL::text AS "irasymoPagrindas",
      "search_index", 'Nepatikimas' AS saltinis
    FROM public."nepatikimiTiekejai"

    UNION ALL

    SELECT
      "atvejoNr", "duomenuIvedimoData", "pirkimoVykdytojoPavadinimas", "tiekejoPavadinimas",
      "tiekejoJarKodas", "pirkimoNumeris", NULL::date AS "sutartiesNutraukimoData",
      "dataNuoKuriosSkaiciuojamasTerminas"::date AS "dataNuoKuriosSkaiciuojama",
      "itrauktasIki"::date, "teismoData"::date, NULL::date AS "teismoSprendimoData",
      "teismoSprendimoLink", metai, "paskutiniKartaMatytaSarase", "irasymoPagrindas",
      "search_index", 'Melagingas' AS saltinis
    FROM public."melagingiTiekejai"
  ), seen AS (
    SELECT raw.*,
      MAX(raw."paskutiniKartaMatytaSarase") OVER (PARTITION BY raw.saltinis) AS "sarasoData"
    FROM raw
  ), nd AS (
    SELECT seen.*, CASE
      -- Įrašas laikomas galiojančiu tik jei jis dar buvo paskutiniame sąrašo
      -- nuskaityme (per 48 val. nuo naujausio to sąrašo matymo). Dingęs iš
      -- sąrašo tiekėjas yra išbrauktas, nesvarbu ką rodo itrauktasIki data.
      WHEN seen."paskutiniKartaMatytaSarase" IS NULL
        OR seen."paskutiniKartaMatytaSarase" < seen."sarasoData" - INTERVAL '48 hours'
        THEN 'pasalintas'
      WHEN seen."itrauktasIki" IS NULL THEN 'nezinoma'
      WHEN seen."itrauktasIki" >= CURRENT_DATE THEN 'galioja'
      ELSE 'pasibaiges'
    END AS busena
    FROM seen
  )`;

/**
 * WHERE sąlygos iš paieškos + filtrų. `skipFacet` praleidžia vieną filtrą — jo
 * paties skaičiavimams (facet-exclude), kad daugiareikšmė atranka nenumuštų
 * likusių to paties faceto variantų iki nulio, o datos histograma rodytų visą
 * rėžį, o ne tik pasirinktą jo gabalą.
 */
function buildWhere(params: SqlParams, skipFacet?: string) {
  const conditions: string[] = [];
  if (cleanSearch) {
    conditions.push(`nd."search_index" @@ ${tsQueryFunc}('simple', ${params.add(cleanSearch)})`);
  }
  if (skipFacet !== 'saltinis' && selected.saltinis.length) {
    conditions.push(`nd.saltinis = ANY(${params.add(selected.saltinis)}::text[])`);
  }
  if (skipFacet !== 'busena' && selected.busena.length) {
    conditions.push(`nd.busena = ANY(${params.add(selected.busena)}::text[])`);
  }
  if (skipFacet !== 'pirkejas' && selected.pirkejas.length) {
    conditions.push(`nd."pirkimoVykdytojoPavadinimas" = ANY(${params.add(selected.pirkejas)}::text[])`);
  }
  if (skipFacet !== 'tiekejoKodas' && selected.tiekejoKodas.length) {
    conditions.push(`nd."tiekejoJarKodas" = ANY(${params.add(selected.tiekejoKodas)}::text[])`);
  }
  if (pirkimoNumeris) {
    conditions.push(`nd."pirkimoNumeris" ILIKE ${params.add(`%${pirkimoNumeris}%`)}`);
  }
  if (skipFacet !== 'ivesta') {
    if (ivestaNuo) conditions.push(`nd."duomenuIvedimoData" >= ${params.add(ivestaNuo)}::date`);
    if (ivestaIki) conditions.push(`nd."duomenuIvedimoData" <= ${params.add(ivestaIki)}::date`);
  }
  return conditions.length ? `WHERE ${conditions.join(' AND ')}` : '';
}

const SORTS: Record<string, string> = {
  '': 'nd."duomenuIvedimoData" DESC NULLS LAST',
  ivestaAsc: 'nd."duomenuIvedimoData" ASC NULLS LAST',
  itrauktasIki: 'nd."itrauktasIki" DESC NULLS LAST',
  tiekejas: 'nd."tiekejoPavadinimas" ASC NULLS LAST',
};
const sort = SORTS[query.sort ?? ''] ? (query.sort ?? '') : '';

const timed = async <T,>(promise: Promise<T>): Promise<{ value: T; ms: number }> => {
  const t0 = Date.now();
  const value = await promise;
  return { value, ms: Date.now() - t0 };
};

/**
 * Vieno faceto skaičiai — su visais kitais filtrais, bet be paties faceto.
 * Pažymėtos reikšmės rikiuojamos į patį viršų: kitaip retesnė (už `max` ribos)
 * atranka iškristų iš atsakymo ir juostoje liktų be pavadinimo bei skaičiaus.
 */
function facetQuery(param: string, valueExpr: string, labelExpr: string | null = null, max = 500) {
  const params = new SqlParams();
  const where = buildWhere(params, param);
  const label = labelExpr ? `, MIN(${labelExpr}) AS label` : '';
  const pinned = selected[param]?.length
    ? `(${valueExpr} = ANY(${params.add(selected[param])}::text[])) DESC, `
    : '';
  return postgres.query(
    `${BASE_CTE}
     SELECT ${valueExpr} AS value, COUNT(*)::int AS count${label}
     FROM nd
     ${where}
     GROUP BY 1
     HAVING ${valueExpr} IS NOT NULL AND ${valueExpr}::text <> ''
     ORDER BY ${pinned}count DESC, 1
     LIMIT ${max}`,
    params.values,
  );
}

const startedAt = Date.now();

const resultParams = new SqlParams();
const resultWhere = buildWhere(resultParams);
const limitPh = resultParams.add(limit);
const offsetPh = resultParams.add(skip);

const countParams = new SqlParams();
const countWhere = buildWhere(countParams);

const histParams = new SqlParams();
const histWhere = buildWhere(histParams, 'ivesta');

const [resultsRes, totalRes, saltinisRes, busenaRes, pirkejasRes, tiekejasRes, histRes] = await Promise.all([
  timed(postgres.query(
    `${BASE_CTE}
     SELECT nd.* FROM nd
     ${resultWhere}
     ORDER BY ${SORTS[sort]}
     LIMIT ${limitPh} OFFSET ${offsetPh}`,
    resultParams.values,
  )),
  timed(postgres.query(
    `${BASE_CTE} SELECT COUNT(*)::int AS count FROM nd ${countWhere}`,
    countParams.values,
  )),
  timed(facetQuery('saltinis', 'nd.saltinis')),
  timed(facetQuery('busena', 'nd.busena')),
  timed(facetQuery('pirkejas', 'nd."pirkimoVykdytojoPavadinimas"')),
  timed(facetQuery('tiekejoKodas', 'nd."tiekejoJarKodas"', 'nd."tiekejoPavadinimas"')),
  timed(postgres.query(
    `${BASE_CTE}
     SELECT date_trunc('month', nd."duomenuIvedimoData")::date AS bucket, COUNT(*)::int AS count
     FROM nd
     ${histWhere}${histWhere ? ' AND' : 'WHERE'} nd."duomenuIvedimoData" IS NOT NULL
     GROUP BY 1 ORDER BY 1`,
    histParams.values,
  )),
]);

const rows = resultsRes.value.rows;
const total = totalRes.value.rows[0].count;
const pageCount = Math.ceil(total / limit);

if (typeof query.json !== 'undefined') {
  return new Response(JSON.stringify({
    data: rows,
    currentPage,
    pageCount,
    total,
    limit,
  }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

const BUSENA_LABELS: Record<string, string> = {
  galioja: 'Galiojantys',
  pasibaiges: 'Pasibaigę',
  pasalintas: 'Išbraukti iš sąrašo',
  nezinoma: 'Terminas nenurodytas',
};

const saltinisOptions = toFacetOptions(saltinisRes.value.rows);
const busenaOptions = toFacetOptions(busenaRes.value.rows);
const pirkejasOptions = toFacetOptions(pirkejasRes.value.rows);
const tiekejasOptions = toFacetOptions(tiekejasRes.value.rows);

const facets = {
  saltinis: makeFacet('saltinis', saltinisOptions, selected.saltinis, toggleUrl, 4),
  busena: makeFacet('busena', busenaOptions, selected.busena, toggleUrl, 4),
  pirkejas: makeFacet('pirkejas', pirkejasOptions, selected.pirkejas, toggleUrl, 5),
  tiekejoKodas: makeFacet('tiekejoKodas', tiekejasOptions, selected.tiekejoKodas, toggleUrl, 5),
};
const hist = buildMonthHistogram(histRes.value.rows);

const numberOfResults = buildNumberOfResults({
  rows,
  total,
  elapsed: Date.now() - startedAt,
  engine: 'PostgreSQL',
  timings: [
    { label: 'Rezultatai', phase: 'search', start: 0, duration: resultsRes.ms },
    { label: 'Skaičius', phase: 'count', start: 0, duration: totalRes.ms },
    { label: 'Facetai', phase: 'facets', start: 0, duration: Math.max(saltinisRes.ms, busenaRes.ms, pirkejasRes.ms, tiekejasRes.ms, histRes.ms) },
  ],
});

const preserved = new URLSearchParams(Astro.url.search);
preserved.delete('page');
const serialized = preserved.toString();
const queryParams = serialized ? `&${serialized}` : '';

const sortOptions = [
  { value: '', label: 'Naujausiai įvesti' },
  { value: 'ivestaAsc', label: 'Seniausiai įvesti' },
  { value: 'itrauktasIki', label: 'Vėliausiai baigiasi' },
  { value: 'tiekejas', label: 'Pagal tiekėją' },
];

const values: Record<string, string> = { pirkimoNumeris };

Astro.response.headers.set('Cache-Control', 'private, max-age=10');
---
<Layout
  pageTitle="Nepatikimų ir melagingą informaciją pateikusių tiekėjų paieška"
  pageDescription="Nepatikimų tiekėjų ir melagingą informaciją pateikusių tiekėjų sąrašai vienoje paieškoje."
  pageImage="https://viespirkiai.org/nepatikimi.png"
  colorScheme={colorScheme}
  font={font}
>
  <main class="sidebar-main">
    <form method="get" role="search" id="searchForm" class="searchform-sidebar">
      <h1 class="sr-only">Nepatikimų ir melagingą informaciją pateikusių tiekėjų paieška</h1>

      {/* Facetų atranka gyvena tik URL'e — kad rikiavimas ar „Ieškoti" jos
          neprarastų, perduodam paslėptais laukais (po vieną kiekvienai reikšmei). */}
      {FACET_PARAMS.flatMap((param) =>
        selected[param].map((value) => <input type="hidden" name={param} value={value} />),
      )}

      <aside class="sf-rail" aria-label="Filtrai">
        <div class="sf-rail-head">
          <button type="button" class="sf-rail-toggle" id="sfFiltersToggle" aria-expanded="false" aria-controls="sfRailBody">
            <span class="sf-rail-toggle-label">Filtrai</span>
            {activeFilterCount > 0 && <span class="sf-filters-count">{activeFilterCount}</span>}
            <span class="sf-filters-chevron" aria-hidden="true"></span>
          </button>
        </div>

        <div class="sf-rail-body" id="sfRailBody">
          {activeFilterCount > 0 && (
            <div class="npt-rail-head">
              <a href="/nepatikimi" class="npt-rail-clear">Panaikinti</a>
            </div>
          )}

          <div class="npt-facets">
            <DokFacetSection label="Sąrašas" param="saltinis" facet={facets.saltinis} allLabel="Abu" alwaysAll />
            <DokFacetSection
              label="Įtraukimo būsena"
              param="busena"
              facet={facets.busena}
              allLabel="Visos"
              formatLabel={(value: string) => BUSENA_LABELS[value] ?? value}
            />
            <DokFacetSection
              label="Tiekėjas"
              param="tiekejoKodas"
              facet={facets.tiekejoKodas}
              allLabel="Visi"
              stacked
              modal={{ field: 'tiekejoKodas', title: 'Tiekėjas', always: true }}
            />
            <DokFacetSection
              label="Pirkėjas"
              param="pirkejas"
              facet={facets.pirkejas}
              allLabel="Visi"
              modal={{ field: 'pirkejas', title: 'Pirkėjas', always: true }}
            />
            <HistogramRangeFilter
              mode="date"
              legend="Įvedimo data"
              nameFrom="ivestaNuo"
              nameTo="ivestaIki"
              redirectBase="/nepatikimi"
              hist={hist}
              valueFrom={ivestaNuo}
              valueTo={ivestaIki}
              ariaFrom="Įvesta nuo"
              ariaTo="Įvesta iki"
            />
          </div>

          <FilterPanel variant="rail" className="npt-filters-rail">
            <FilterGroup legend="Pirkimas">
              <TextInput label="Pirkimo numeris" name="pirkimoNumeris" placeholder="Nenurodyta" values={values} />
            </FilterGroup>
          </FilterPanel>

          <button type="submit" class="sf-rail-search">Ieškoti</button>
        </div>
      </aside>

      <div class="sf-search">
        <div class="search-bar">
          <label for="search">
            <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
            </svg>
            <span class="sr-only">Paieška</span>
          </label>
          <input
            type="search"
            name="search"
            id="search"
            class="search-bar__input"
            value={rawSearch}
            placeholder="Tiekėjas, pirkėjas arba pirkimo numeris"
            enterkeyhint="search"
          />
          <Button type="submit">Ieškoti</Button>
        </div>
      </div>

      <div class="sf-results">
        <ResultPageShell
          numberOfResults={numberOfResults}
          resultCount={rows.length}
          page={currentPage}
          pageCount={pageCount}
          queryParams={queryParams}
          emptyText="Rezultatų nerasta."
          containerClass="mt-0"
          flat={true}
        >
          <Fragment slot="sort">
            <label class="sr-only" for="nptSort">Rikiuoti pagal</label>
            <select id="nptSort" name="sort" data-autosubmit aria-label="Rikiuoti pagal">
              {sortOptions.map((option) => (
                <option value={option.value} selected={sort === option.value}>{option.label}</option>
              ))}
            </select>
          </Fragment>

          {rows.map((item: any) => {
            const asmuoLink = `/asmuo/${item.tiekejoJarKodas}${item.saltinis === 'Nepatikimas' ? '#nepatikimi' : '#melagiai'}`;

            return (
              <ResultCardShell clickable={true}>
                <dl slot="meta" class="result-card-meta">
                  <div>
                    <dt class="sr-only">Sąrašas</dt>
                    <dd>{item.saltinis}</dd>
                  </div>

                  <div>
                    <dt class="sr-only">Galiojimas</dt>
                    <dd>{item.dataNuoKuriosSkaiciuojama || 'nežinoma'} – {item.itrauktasIki || 'nežinoma'}</dd>
                  </div>

                  <div>
                    <dt class="sr-only">Pirmą kartą įvesta</dt>
                    <dd>Įvesta: {item.duomenuIvedimoData || 'nežinoma'}</dd>
                  </div>

                  <div>
                    <dt class="sr-only">Paskutinį kartą matyta</dt>
                    <dd>Matyta: {item.paskutiniKartaMatytaSarase}</dd>
                  </div>
                </dl>

                <h3 slot="title" class="result-card-title">
                  <a href={asmuoLink}>{item.tiekejoPavadinimas}</a>
                </h3>

                {item.irasymoPagrindas && item.irasymoPagrindas.length > 3 && (
                  <p class="text-sm mt-2 text-justify">{item.irasymoPagrindas}</p>
                )}

                <div slot="footer" class="result-card-footer">
                  <span><strong>Pirkėjas:</strong> {item.pirkimoVykdytojoPavadinimas || 'nenurodytas'}</span>
                  <span><strong>Pirkimo nr.:</strong> {item.pirkimoNumeris || 'nenurodytas'}</span>
                  {item.teismoSprendimoLink?.length > 5 && (
                    <span>
                      <a href={item.teismoSprendimoLink} target="_blank" rel="noopener noreferrer" class="relative z-1">↗ Teismo sprendimas</a>
                    </span>
                  )}
                </div>
              </ResultCardShell>
            );
          })}
        </ResultPageShell>
      </div>
    </form>

    <PgFacetModal
      basePath="/nepatikimi"
      facetsSelector=".npt-facets"
      options={{ pirkejas: pirkejasOptions, tiekejoKodas: tiekejasOptions }}
    />
  </main>
</Layout>

<style>
  /* Pirmoji facetų sekcija be viršutinio tarpo — DokFacetSection kiekvienai
     prideda padding-top:20px, bet viršuje jis palieka tuščią plyšį. */
  .npt-facets :global(.dok-filter-section:first-child) {
    padding-top: 0;
  }

  /* Tarpas tarp facetų ir tikslių įvesties filtrų apačioje (be linijos). */
  .npt-facets + :global(.ds-filter-panel--rail) {
    margin-top: 24px;
  }

  .npt-rail-head {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 16px;
  }
  .npt-rail-clear {
    font-size: var(--text-xs);
    color: var(--dark-gray);
  }
  .npt-rail-clear:hover { color: var(--black); }

  @media (max-width: 900px) {
    /* Telefone antraštę neša .sf-rail-head perjungiklis. */
    .npt-rail-head { display: none; }
  }
</style>

<script is:inline>
  // Mobilus filtrų perjungiklis: antraštė suskleidžia/atskleidžia juostą (≤900px).
  const sfToggle = document.getElementById('sfFiltersToggle');
  const sfRail = document.querySelector('.sf-rail');
  sfToggle?.addEventListener('click', () => {
    const open = sfRail?.classList.toggle('is-open') ?? false;
    sfToggle.setAttribute('aria-expanded', String(open));
  });

  // „Rodyti daugiau" inline atskleidimas facetams be dialogo.
  document.querySelectorAll('.npt-facets .dok-more-btn').forEach((btn) => {
    if (btn.dataset.facetModal) return; // šiuos tvarko dialogas
    btn.addEventListener('click', () => {
      const more = btn.previousElementSibling;
      if (more && more.classList.contains('dok-more-list')) {
        more.hidden = false;
        btn.remove();
      }
    });
  });

  // Rikiavimo select priklauso #searchForm — keitimas paleidžia paiešką iš naujo.
  document.querySelectorAll('select[data-autosubmit]').forEach((select) => {
    select.addEventListener('change', () => {
      const form = select.form;
      if (!form) return;
      form.querySelector('input[name="page"]')?.remove();
      form.requestSubmit();
    });
  });
</script>

<script>
  import { initStickyRail } from '@/src/lib/stickyRail';
  import { initHistogramRangeFilters } from '@design-system/components/filters/histogramRangeFilter';
  initStickyRail();
  initHistogramRangeFilters();
</script>
