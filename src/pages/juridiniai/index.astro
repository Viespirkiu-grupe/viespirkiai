---
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import { searchJar } from '@/modules/juridiniai/search.js';
import { linksniuoti, linksniuotiK } from '@/utils/linksniai.js';
import config from '@/config.js';
import { objectsToJsonlStream } from '@/utils/jsonl.js';
import { objectsToCsvStream } from '@/utils/csv.js';
import { Readable as NodeReadable, PassThrough } from 'node:stream';

const colorScheme = Astro.cookies.get('colorScheme')?.value || 'auto';
const font = Astro.cookies.get('font')?.value || 'ubuntu';

const url = Astro.url;
const rawQuery = Object.fromEntries(url.searchParams);
const cleaned: Record<string, string> = {};
let hasEmpty = false;
for (const [key, value] of Object.entries(rawQuery)) {
  if (value !== '') cleaned[key] = value;
  else hasEmpty = true;
}
if (hasEmpty) {
  return Astro.redirect(url.pathname + (new URLSearchParams(cleaned).toString() ? `?${new URLSearchParams(cleaned).toString()}` : ''));
}

const query = cleaned;
const DEFAULT_LIMIT = 50;
const MAX_LIMIT = 250;
const limit = query.limit === 'max' ? MAX_LIMIT : (parseInt(query.limit) || DEFAULT_LIMIT);
const page = parseInt(query.page) || 1;

const hasSearch = query.search || (query.location && query.locationRadius) || query.adresas;

function buildQueryParams(q: Record<string, string>) {
  if (q.search) return `&search=${encodeURIComponent(q.search)}`;
  if (q.location && q.locationRadius) return `&location=${q.location}&locationRadius=${q.locationRadius}`;
  if (q.adresas) return `&adresas=${encodeURIComponent(q.adresas)}`;
  return '&';
}

function buildNumberOfResults({ results, total, elapsed, searchEngine }: { results: unknown[]; total: number; elapsed: number; searchEngine: string }) {
  const trukme = (elapsed / 1000).toFixed(2) + 's';
  const source = `<span class="inline">(${trukme}, ${searchEngine})</span>`;
  if (results.length < total) return `Rodomi ${results.length} iš ${linksniuotiK(total, ['rezultato', 'rezultatų'])} ${source}`;
  return `${linksniuoti(total, ['rezultatas', 'rezultatai', 'rezultatų'])} ${source}`;
}

let results: any[] = [];
let total = 0;
let searchEngine = '';
let numberOfResults = '';
let queryParams = '&';
let galimaEksportuoti = false;
let pageCount = 1;

if (hasSearch) {
  if (query.jsonl || query.json || query.csv) {
    const { results: allResults } = await searchJar(query, { page, limit: MAX_LIMIT });

    if (query.json) {
      return new Response(JSON.stringify(allResults), {
        headers: { 'Content-Type': 'application/json' },
      });
    }

    const pass = new PassThrough();
    const readable = NodeReadable.from(allResults);

    if (query.jsonl) {
      readable.pipe(objectsToJsonlStream()).pipe(pass);
      return new Response(NodeReadable.toWeb(pass) as unknown as BodyInit, {
        headers: {
          'Content-Type': 'application/x-ndjson',
          'Content-Disposition': `attachment; filename=viespirkiai-${new Date().toISOString()}.jsonl`,
        },
      });
    }

    if (query.csv) {
      readable.pipe(objectsToCsvStream()).pipe(pass);
      return new Response(NodeReadable.toWeb(pass) as unknown as BodyInit, {
        headers: {
          'Content-Type': 'text/csv',
          'Content-Disposition': `attachment; filename=viespirkiai-${new Date().toISOString()}.csv`,
        },
      });
    }
  }

  const startas = performance.now();
  ({ results, total, searchEngine } = await searchJar(query, { page, limit }));
  const elapsed = performance.now() - startas;

  numberOfResults = buildNumberOfResults({ results, total, elapsed, searchEngine });
  queryParams = buildQueryParams(query);
  galimaEksportuoti = total > 0 && total <= MAX_LIMIT;
  pageCount = Math.ceil(total / limit);
}

const tikRezultatai = !!query.tikRezultatai;

const leafletHead = `<script defer>
(function () {
  window.__vpLeaflet = window.__vpLeaflet || { loading: null, loaded: false };
  const state = window.__vpLeaflet;
  function ensureCssOnce() {
    if (document.querySelector('link[data-vp-leaflet-css="1"]')) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet'; link.href = '/dist/leaflet.css'; link.dataset.vpLeafletCss = '1';
    document.head.appendChild(link);
  }
  function waitForLeafletGlobal(resolve) {
    const check = () => { if (window.L && window.L.map) { state.loaded = true; resolve(); } else { setTimeout(check, 25); } };
    check();
  }
  function appendScriptWhenBodyReady(scriptEl) {
    const mount = () => { const t = document.body || document.head || document.documentElement; if (!t) return false; t.appendChild(scriptEl); return true; };
    if (mount()) return;
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', () => { mount(); }, { once: true }); } else { setTimeout(() => { mount(); }, 0); }
  }
  function ensureJsOnce() {
    if (state.loaded) { state.loading = state.loading || Promise.resolve(); return state.loading; }
    if (state.loading) return state.loading;
    state.loading = new Promise((resolve, reject) => {
      if (document.querySelector('script[data-vp-leaflet-js="1"]')) { return waitForLeafletGlobal(resolve); }
      const script = document.createElement('script');
      script.src = '/dist/leaflet.js'; script.defer = true; script.dataset.vpLeafletJs = '1';
      script.onload = () => { state.loaded = true; resolve(); }; script.onerror = reject;
      appendScriptWhenBodyReady(script);
    });
    return state.loading;
  }
  window.__vpLeafletLoad = window.__vpLeafletLoad || function () { ensureCssOnce(); return ensureJsOnce(); };
  try { window.__vpLeafletLoad(); } catch (e) {}
})();
<\/script>`;
---

{tikRezultatai ? (
  <div class="mt-10 max-w-lg center mx-auto">
    <div>
      <div class="flex justify-between items-center mb-4">
        <span class="text-muted text-sm numberOfResults" set:html={numberOfResults} />
        {galimaEksportuoti && (
          <div class="flex gap-3">
            <a href={`/juridiniai/?${queryParams}&json=true&limit=max`} class="btn btn-outline btn-sm">↗ JSON</a>
            <a href={`/juridiniai/?${queryParams}&jsonl=true&limit=max`} class="btn btn-outline btn-sm">↗ JSONL</a>
            <a href={`/juridiniai/?${queryParams}&csv=true&limit=max`} class="btn btn-outline btn-sm">↗ CSV</a>
          </div>
        )}
      </div>
      {results.length === 0
        ? <div class="empty-state"><p class="text-muted">Rezultatų nerasta.</p></div>
        : <>
            <div class="result-list">
              {results.map((item: any) => (
                <article class="result-card card-clickable">
                  <div class="result-card-body">
                    <dl class="result-card-meta">
                      <div><dt class="sr-only">Tipas</dt><dd>{item.formosPavadinimas}</dd></div>
                    </dl>
                    <h3 class="result-card-title">
                      {!item.pavadinimas || item.pavadinimas.length === 0
                        ? <em>Nenurodyta</em>
                        : <a href={`/asmuo/${item.jarKodas}`}>{item.pavadinimas}</a>
                      }
                    </h3>
                    <div class="result-card-footer">
                      <span><strong>Adresas:</strong> {item.adresas}</span>
                      <span><strong>Registruota:</strong> {item.registravimoData}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
            <Pagination currentPage={page} pageCount={pageCount} queryParams={queryParams} />
          </>
      }
    </div>
  </div>
) : (
  <Layout
    pageTitle="Juridinių asmenų paieška"
    pageImage="https://viespirkiai.org/juridiniai.png"
    colorScheme={colorScheme}
    font={font}
    customHead={((config as any).customHead || '') + leafletHead}
  >
    <main>
      <form method="get" role="search" id="searchForm">
        <h1 class="mt-7">Juridinių asmenų paieška</h1>

        <div class="search-bar">
          <label for="search">
            <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
            </svg>
            <span class="sr-only">Paieška</span>
          </label>
          <input type="search" name="search" id="search" class="search-bar__input"
            value={query.search || ''}
            placeholder="Tekstinė paieška"
            enterkeyhint="search"
          />
          <button type="submit" class="btn btn-primary">Ieškoti</button>
        </div>
      </form>

      <section class="results" id="juridiniaiRezultatai">
        {hasSearch ? (
          <div class="mt-10 max-w-lg center mx-auto">
            <div>
              <div class="flex justify-between items-center mb-4">
                <span class="text-muted text-sm numberOfResults" set:html={numberOfResults} />
                {galimaEksportuoti && (
                  <div class="flex gap-3">
                    <a href={`/juridiniai/?${queryParams}&json=true&limit=max`} class="btn btn-outline btn-sm">↗ JSON</a>
                    <a href={`/juridiniai/?${queryParams}&jsonl=true&limit=max`} class="btn btn-outline btn-sm">↗ JSONL</a>
                    <a href={`/juridiniai/?${queryParams}&csv=true&limit=max`} class="btn btn-outline btn-sm">↗ CSV</a>
                  </div>
                )}
              </div>
              {results.length === 0
                ? <div class="empty-state"><p class="text-muted">Rezultatų nerasta.</p></div>
                : <>
                    <div class="result-list">
                      {results.map((item: any) => (
                        <article class="result-card card-clickable">
                          <div class="result-card-body">
                            <dl class="result-card-meta">
                              <div><dt class="sr-only">Tipas</dt><dd>{item.formosPavadinimas}</dd></div>
                            </dl>
                            <h3 class="result-card-title">
                              {!item.pavadinimas || item.pavadinimas.length === 0
                                ? <em>Nenurodyta</em>
                                : <a href={`/asmuo/${item.jarKodas}`}>{item.pavadinimas}</a>
                              }
                            </h3>
                            <div class="result-card-footer">
                              <span><strong>Adresas:</strong> {item.adresas}</span>
                              <span><strong>Registruota:</strong> {item.registravimoData}</span>
                            </div>
                          </div>
                        </article>
                      ))}
                    </div>
                    <Pagination currentPage={page} pageCount={pageCount} queryParams={queryParams} />
                  </>
              }
            </div>
          </div>
        ) : (
          <>
            <script>
              window.addEventListener('DOMContentLoaded', () => {
                const search = document.getElementById('search');
                if (search) search.focus();
              });
            </script>
            <br />
            <div id="map" class="h-[60vh] rounded-lg"></div>
            <script>
            window.addEventListener('DOMContentLoaded', () => {
              const leafletWindow = window as Window & {
                L?: any;
                juridiniaiLayer?: any;
                __vpLeafletLoad?: () => Promise<void>;
              };
              const start = () => {
                if (!leafletWindow.L || !leafletWindow.L.map) return;
                const map = leafletWindow.L.map('map', { zoomAnimation: true, markerZoomAnimation: true }).setView([55.1694, 23.8813], 7);
                leafletWindow.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                  attribution: '&copy; OpenStreetMap contributors',
                }).addTo(map);
                const juridiniaiTiles = leafletWindow.L.tileLayer('/juridiniai/map/tiles/{z}/{x}/{y}.png', {
                  tileSize: 256, opacity: 0.6, maxNativeZoom: 16, maxZoom: 16,
                }).addTo(map);
                juridiniaiTiles.getContainer().style.filter = 'blur(5px)';
                map.on('moveend zoomend', async () => {
                  const zoom = map.getZoom();
                  if (zoom < 17) {
                    if (leafletWindow.juridiniaiLayer) map.removeLayer(leafletWindow.juridiniaiLayer);
                    return;
                  }
                  const bounds = map.getBounds();
                  const url = `/juridiniai/map/viewport?minLat=${bounds.getSouth()}&minLon=${bounds.getWest()}&maxLat=${bounds.getNorth()}&maxLon=${bounds.getEast()}`;
                  const res = await fetch(url);
                  const data = await res.json();
                  if (leafletWindow.juridiniaiLayer) map.removeLayer(leafletWindow.juridiniaiLayer);
                  const layerGroup = leafletWindow.L.layerGroup();
                  data.locations.forEach(([lat, lon]: [number, number]) => {
                    const circle = leafletWindow.L.circleMarker([lat, lon], {
                      radius: 6, color: 'black', fillColor: 'black', fillOpacity: 1, weight: 1, interactive: true,
                    }).addTo(layerGroup);
                    circle.on('click', () => { leafletWindow.location.href = `/juridiniai?location=${lat},${lon}&locationRadius=10`; });
                  });
                  leafletWindow.juridiniaiLayer = layerGroup;
                  map.addLayer(layerGroup);
                });
              };
              if (typeof leafletWindow.__vpLeafletLoad === 'function') {
                leafletWindow.__vpLeafletLoad().then(start).catch(() => {});
              } else {
                start();
              }
            });
            </script>
          </>
        )}
        <br />
        <div class="flex gap-2 justify-center mb-2">
          <a href="/juridiniai/topAdresai" class="btn btn-outline btn-sm">↗ Top adresai</a>
        </div>
      </section>

      <script>
      document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('searchForm');
        const inputElement = document.getElementById('search');
        const results = document.getElementById('juridiniaiRezultatai');
        if (!form || !inputElement || !results || !(inputElement instanceof HTMLInputElement)) return;
        const input = inputElement;
        let debounceTimer: ReturnType<typeof setTimeout> | undefined;
        let issuedRequestId = 0;
        let latestRenderedRequestId = 0;
        const inFlightControllers = new Map<number, AbortController>();

        const renderResponseIfNewest = (requestId: number, html: string) => {
          if (requestId > latestRenderedRequestId) {
            results.innerHTML = html;
            latestRenderedRequestId = requestId;
            return true;
          }
          return false;
        };

        const abortOlderInFlight = (requestId: number) => {
          for (const [olderRequestId, controller] of inFlightControllers.entries()) {
            if (olderRequestId < requestId) {
              controller.abort();
              inFlightControllers.delete(olderRequestId);
            }
          }
        };

        input.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(async () => {
            const requestId = ++issuedRequestId;
            const query = input.value.trim();
            if (!query) {
              const rendered = renderResponseIfNewest(requestId, '');
              if (rendered) {
                abortOlderInFlight(requestId);
                history.replaceState(null, '', window.location.pathname);
              }
              return;
            }
            const controller = new AbortController();
            inFlightControllers.set(requestId, controller);
            try {
              const base = form.getAttribute('action') || window.location.pathname;
              const url = new URL(base, window.location.origin);
              url.searchParams.set('search', query);
              url.searchParams.set('tikRezultatai', 'true');
              const res = await fetch(url, { signal: controller.signal });
              if (!res.ok) throw new Error('Network error');
              const html = await res.text();
              const rendered = renderResponseIfNewest(requestId, html);
              url.searchParams.delete('tikRezultatai');
              if (rendered) {
                abortOlderInFlight(requestId);
                history.replaceState(null, '', url);
              }
            } catch (err: unknown) {
              if (err instanceof DOMException && err.name === 'AbortError') return;
              const rendered = renderResponseIfNewest(requestId, '<p>Klaida gaunant duomenis.</p>');
              if (rendered) abortOlderInFlight(requestId);
            } finally {
              inFlightControllers.delete(requestId);
            }
          }, 100);
        });
      });
      </script>
    </main>
  </Layout>
)}
