---
import Layout from '../../layouts/Layout.astro';
import Pagination from '@design-system/components/Pagination.astro';
import ResultsSummary from '@design-system/components/ResultsSummary.astro';
import { postgres } from '@/postgres/postgres.js';
import { linksniuoti, linksniuotiK } from '@/utils/linksniai.js';
import { getColorScheme, getFont } from '../../lib/failai.ts';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const DEFAULT_LIMIT = 50;
const page = parseInt(Astro.url.searchParams.get('page') || '1') || 1;
const offset = (page - 1) * DEFAULT_LIMIT;

const startas = performance.now();
const [adresaiRes, countRes] = await Promise.all([
  postgres.query(
    `SELECT * FROM "jarCsvTopAdresai" ORDER BY count DESC LIMIT $1 OFFSET $2`,
    [DEFAULT_LIMIT, offset],
  ),
  postgres.query(`SELECT COUNT(*) AS total FROM "jarCsvTopAdresai"`),
]);

const total = parseInt(countRes.rows[0].total, 10);
const elapsed = performance.now() - startas;
const trukme = (elapsed / 1000).toFixed(2) + 's';
const source = `<span class="inline">(${trukme}, PostgreSQL)</span>`;
const numberOfResults = adresaiRes.rowCount < total
  ? `Rodomi ${adresaiRes.rowCount} iš ${linksniuotiK(total, ['rezultato', 'rezultatų'])} ${source}`
  : `${linksniuoti(total, ['rezultatas', 'rezultatai', 'rezultatų'])} ${source}`;

const pageCount = Math.ceil(total / DEFAULT_LIMIT);
const adresai = adresaiRes.rows;
---

<Layout
  pageTitle="Top adresai pagal įmonių skaičių"
  pageImage="https://viespirkiai.org/juridiniai.png"
  colorScheme={colorScheme}
  font={font}
>
  <main>
    <div class="page-header">
      <h1 class="mb-0">Top adresai pagal įmonių skaičių</h1>
    </div>

    <p class="text-muted mb-7 max-w-content">
      Žemiau pateikiami adresai, kuriuose registruota daugiausiai įmonių.
      Įprastai užsiregistruoti juose galima susimokėjus mokestį — tokie adresai leidžia
      formaliai registruoti įmonę, neskelbiant tikros veiklos vietos.
    </p>

    <div class="flex justify-between items-center mb-4">
      <ResultsSummary html={numberOfResults} />
    </div>

    <div class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(260px,1fr))]">
      {adresai.map((item: any) => (
        <article class="card card-clickable">
          <div class="card-body">
            <h3 class="text-sm mb-2">
              <a href={`/juridiniai?adresas=${encodeURIComponent(item.adresas)}`}>
                {item.adresas}
              </a>
            </h3>
            <p class="text-muted text-sm mb-0"><span class="cell-mono">{item.count}</span> įmonės</p>
          </div>
        </article>
      ))}
    </div>

    <Pagination currentPage={page} pageCount={pageCount} queryParams="" />
  </main>
</Layout>
