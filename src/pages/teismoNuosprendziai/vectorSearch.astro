---
import Layout from '../../layouts/Layout.astro';
import SearchForm from '@design-system/components/content/SearchForm.astro';
import SearchResultsShell from '@design-system/components/content/SearchResultsShell.astro';
import { buildNumberOfResults, cleanQuery, getColorScheme, getFont } from '../../lib/failai.js';
import config from '../../lib/config.ts';
import { fetchTeismoNuosprendziaiVectorSearchResults } from '../../lib/teismoNuosprendziaiVectorSearch.ts';
import TeismoNuosprendisVectorResultCard from '../../components/teismoNuosprendziai/TeismoNuosprendisVectorResultCard.astro';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);
const cleaned = cleanQuery(Astro.url);
if (cleaned.redirectTo) return Astro.redirect(cleaned.redirectTo);

if (!config.teismoNuosprendziaiVectorSearchUrl) {
  return Astro.redirect('/');
}

const query = cleaned.query;
const search = query.search || '';
const showInitialState = !search;

let results: Awaited<ReturnType<typeof fetchTeismoNuosprendziaiVectorSearchResults>> = [];
let numberOfResults = '';
let errorMessage = '';

if (!showInitialState) {
  const startedAt = Date.now();
  try {
    results = await fetchTeismoNuosprendziaiVectorSearchResults(search);
    numberOfResults = buildNumberOfResults({
      rows: results,
      total: results.length,
      elapsed: Date.now() - startedAt,
      engine: 'Vector',
      approximate: false,
    });
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : 'Paieška nepavyko.';
  }
}
---
<Layout
  pageTitle="Vektorinė teismo nuosprendžių paieška"
  pageDescription="Bandomasis tekstinės vektorinės teismo nuosprendžių paieškos puslapis"
  colorScheme={colorScheme}
  font={font}
  customHead={config.customHead}
>
  <main>
    <SearchForm
      title="Vektorinė teismo nuosprendžių paieška"
      searchValue={search}
      searchPlaceholder="Pvz. plėšimas naktį"
    >
      <span slot="title-suffix" class="text-muted text-sm ml-2">Bandomoji tekstinė semantinė paieška</span>
    </SearchForm>

    <section class="mt-10 max-w-lg center mx-auto">
      <p class="text-muted text-sm mb-4">
        Užklausa siunčiama į atskirą vektorinės paieškos servisą (portas 12346), o rezultatai rodomi kaip teismo nuosprendžių sąrašas su panašumo įverčiu.
      </p>
    </section>

    {showInitialState ? (
      <div class="mt-10 max-w-lg center mx-auto">
        <p class="text-muted text-sm">Įveskite tekstinę užklausą.</p>
      </div>
    ) : errorMessage ? (
      <div class="mt-10 max-w-lg center mx-auto">
        <div class="result-list">
          <article class="result-card">
            <div class="result-card-body">
              <p class="text-sm">{errorMessage}</p>
            </div>
          </article>
        </div>
      </div>
    ) : (
      <SearchResultsShell
        numberOfResults={numberOfResults}
        resultCount={results.length}
        page={1}
        pageCount={1}
        queryParams={`search=${encodeURIComponent(search)}`}
      >
        {results.map((item) => <TeismoNuosprendisVectorResultCard item={item} />)}
      </SearchResultsShell>
    )}
  </main>
</Layout>
