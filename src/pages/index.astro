---
// @ts-nocheck
import Layout from '../layouts/Layout.astro';
import Pagination from '../components/Pagination.astro';
import TextInput from '../components/inputs/TextInput.astro';
import DateInput from '../components/inputs/DateInput.astro';
import NumberInput from '../components/inputs/NumberInput.astro';
import CheckboxInput from '../components/inputs/CheckboxInput.astro';
import SortToggle from '../components/inputs/SortToggle.astro';
import { searchSutartys, countSutartys } from '@/modules/sutartys/searchSutartys.js';
import { linksniuoti, linksniuotiK } from '@/utils/linksniai.js';
import config from '@/config.js';
import { objectsToJsonlStream } from '@/utils/jsonl.js';
import { objectsToCsvStream } from '@/utils/csv.js';
import { Readable as NodeReadable, PassThrough } from 'node:stream';

type SearchValues = Record<string, string | number | undefined>;

type SearchResultItem = {
  tipas: string;
  kategorija: string;
  sudarymoData?: string | null;
  galiojimoData?: string | null;
  dokumentuKiekis?: number | null;
  sutartiesUnikalusId: string | number;
  faktineIvykdimoVerte?: number | string | null;
  verte?: number | string | null;
  pavadinimas: string;
  perkanciosiosOrganizacijosKodas: string;
  perkanciojiOrganizacija?: string | null;
  tiekejai: string[];
  tiekejaiKodai: string[];
  paskutinioRedagavimoData?: string | null;
};

const colorScheme = Astro.cookies.get('colorScheme')?.value || 'auto';
const font = Astro.cookies.get('font')?.value || 'ubuntu';

// Clean empty query params redirect
const url = Astro.url;
const rawQuery = Object.fromEntries(url.searchParams);
const cleaned: Record<string, string> = {};
let hasEmpty = false;
for (const [key, value] of Object.entries(rawQuery)) {
  if (value !== '') cleaned[key] = value;
  else hasEmpty = true;
}
if (hasEmpty) {
  const qs = new URLSearchParams(cleaned).toString();
  return Astro.redirect(url.pathname + (qs ? `?${qs}` : ''));
}

const query: Record<string, string> = cleaned;
const DEFAULT_LIMIT = 50;
const limit = parseInt(query.limit) || DEFAULT_LIMIT;
const page = parseInt(query.page) || 1;
const engine = query.search && (config as any).typesenseUp ? 'typesense' : 'postgres';

function buildNumberOfResults({ shown, total, elapsed, engine, page = 1 }: { shown: number; total: number | null; elapsed: number; engine: string; page?: number }) {
  const durationMs = Math.round(elapsed);
  const trukme = (elapsed / 1000).toFixed(2);
  const source = `<span class="inline" data-duration="${durationMs}">(${trukme}s, ${engine})</span>`;
  if (total == null) {
    if (page === 1 && shown === 0) {
      return `${linksniuoti(0, ['rezultatas', 'rezultatai', 'rezultatų'])} ${source}`;
    }
    return `Rodomi ${shown} iš <span class="rezultatai-nezinomas-total"> ? </span> rezultatų <span class="inline" data-duration="${durationMs}"> (${trukme}s, ${engine})</span>`;
  }
  if (shown < total) {
    return `Rodomi ${shown} iš ${linksniuotiK(total, ['rezultato', 'rezultatų'])} ${source}`;
  }
  return `${linksniuoti(total, ['rezultatas', 'rezultatai', 'rezultatų'])} ${source}`;
}

// Stream exports (JSONL / CSV) short-circuit
if (query.jsonl || query.csv) {
  const { stream, client } = await searchSutartys(query, { limit: null, page, stream: true, sort: false, engine }) as {
    stream: import('node:stream').Readable | null;
    client: { release(): void } | null;
  };

  if (!stream) {
    return new Response(null, { status: 500 });
  }

  const pass = new PassThrough();
  // Ensure client is released when stream ends/errors
  if (client) {
    stream.on('end', () => client.release());
    stream.on('error', () => client.release());
  }

  if (query.jsonl) {
    stream.pipe(objectsToJsonlStream()).pipe(pass);
    const web = NodeReadable.toWeb(pass) as unknown as BodyInit;
    return new Response(web, {
      headers: {
        'Content-Type': 'application/x-ndjson',
        'Content-Disposition': `attachment; filename=viespirkiai-${new Date().toISOString()}.jsonl`,
      },
    });
  }

  if (query.csv) {
    // Basic CSV fallback: map raw rows to CSV using generic object keys
    stream.pipe(objectsToCsvStream()).pipe(pass);
    const web = NodeReadable.toWeb(pass) as unknown as BodyInit;
    return new Response(web, {
      headers: {
        'Content-Type': 'text/csv',
        'Content-Disposition': `attachment; filename=viespirkiai-${new Date().toISOString()}.csv`,
      },
    });
  }
}

// Result count update (AJAX)
if (query.rezultatuSkaiciausPatikslinimas) {
  const startas = performance.now();
  const [total, { values, queryParams }] = await Promise.all([
    countSutartys(query),
    searchSutartys(query, { limit: 1, page, engine }),
  ]) as [number, { values: SearchValues; queryParams: string }];
  const pageCount = Math.ceil(total / limit);
  const elapsed = performance.now() - startas + Number(query.trukme || 0);
  const numberOfResults = buildNumberOfResults({ shown: limit, total, elapsed, engine, page });
  return new Response(JSON.stringify({ total, pageCount, queryParams, numberOfResults, zinomasRezultatuSkaicius: true }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

const startas = performance.now();
const { results, total, values, queryParams } = await searchSutartys(query, { limit, page, engine }) as {
  results: SearchResultItem[];
  total: number | null;
  values: SearchValues;
  queryParams: string;
};
const elapsed = performance.now() - startas;
const numberOfResults = buildNumberOfResults({ shown: results.length, total, elapsed, engine, page });

const pageCount = Math.ceil((total || 100_000) / limit);
const usedHiddenFields = Object.keys(values).some(k => k !== 'search' && k !== 'limit' && values[k] !== '' && values[k] !== undefined);

let galimaEksportuoti = Object.keys(values).length > 0;
values.limit = limit;

const sortOptions = [
  { value: 'paskutinioRedagavimoData', label: 'Red. data' },
  { value: 'sudarymoData', label: 'Sut. data' },
  { value: 'suma', label: 'Suma' },
  { value: 'paskelbimoData', label: 'Paskelb. data' },
];
---

<Layout
  pageTitle="Sutarčių paieška"
  pageDescription="Pilietinė viešųjų pirkimų analizės iniciatyva. Prieinamai patiekiamos viešųjų pirkimų sutartys bei kita susijusi informacija."
  pageImage="https://viespirkiai.org/sutartys.png"
  colorScheme={colorScheme}
  font={font}
  customHead={(config as any).customHead}
>
  <main>

    <form method="get" role="search" id="searchForm">
      <h1 class="mt-7">Sutarčių paieška</h1>

      <div class="search-bar">
        <label for="search">
          <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
          </svg>
          <span class="sr-only">Paieška</span>
        </label>
        <input type="search" name="search" id="search" class="search-bar__input"
          value={values.search || ''}
          placeholder="Tekstinė paieška"
          enterkeyhint="search"
        />
        <label class="btn btn-ghost btn-icon" title="Filtrai"
          aria-label={usedHiddenFields ? 'Slėpti filtrus' : 'Rodyti filtrus'}
          aria-expanded={usedHiddenFields ? 'true' : 'false'}
          aria-controls="searchNustatymai">
          <input type="checkbox" id="searchNustatymaiToggle" class="sr-only" checked={usedHiddenFields}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.9999 3C11.4476 3 10.9999 3.44772 10.9999 4V6.17072C9.83476 6.58259 9 7.6938 9 8.99998C9 10.3062 9.83476 11.4174 10.9999 11.8292L10.9999 20C10.9999 20.5523 11.4476 21 11.9999 21C12.5522 21 12.9999 20.5523 12.9999 20V11.8293C14.1651 11.4175 15 10.3062 15 8.99998C15 7.69373 14.1651 6.58246 12.9999 6.17066V4C12.9999 3.44772 12.5522 3 11.9999 3ZM12 7.99998C11.4477 7.99998 11 8.4477 11 8.99998C11 9.55227 11.4477 9.99998 12 9.99998C12.5523 9.99998 13 9.55227 13 8.99998C13 8.4477 12.5523 7.99998 12 7.99998Z" fill="currentColor"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M17.9999 20C17.9999 20.5523 18.4476 21 18.9999 21C19.5522 21 19.9999 20.5523 19.9999 20V17.8293C21.1651 17.4175 22 16.3062 22 15C22 13.6937 21.1651 12.5825 19.9999 12.1707V4C19.9999 3.44772 19.5522 3 18.9999 3C18.4476 3 17.9999 3.44772 17.9999 4V12.1707C16.8348 12.5826 16 13.6938 16 15C16 16.3062 16.8348 17.4174 17.9999 17.8292V20ZM19 14C18.4477 14 18 14.4477 18 15C18 15.5523 18.4477 16 19 16C19.5523 16 20 15.5523 20 15C20 14.4477 19.5523 14 19 14Z" fill="currentColor"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3.9999 20C3.9999 20.5523 4.44762 21 4.9999 21C5.55219 21 5.9999 20.5523 5.9999 20V17.8293C7.16515 17.4175 8 16.3062 8 15C8 13.6937 7.16515 12.5825 5.9999 12.1707L5.9999 4C5.9999 3.44772 5.55219 3 4.9999 3C4.44762 3 3.9999 3.44772 3.9999 4L3.9999 12.1707C2.83476 12.5826 2 13.6938 2 15C2 16.3062 2.83476 17.4174 3.9999 17.8292L3.9999 20ZM5 14C4.44772 14 4 14.4477 4 15C4 15.5523 4.44772 16 5 16C5.55229 16 6 15.5523 6 15C6 14.4477 5.55229 14 5 14Z" fill="currentColor"/>
          </svg>
        </label>
        <button type="submit" class="btn btn-primary">Ieškoti</button>
      </div>

      <div id="searchNustatymai" class="search-filters" aria-hidden={!usedHiddenFields ? 'true' : 'false'} inert={!usedHiddenFields ? true : undefined}>
        <div class="search-filters-inner">
          <div class="search-filters-grid">

            <fieldset class="filter-group">
              <legend class="filter-group-label">Dalyviai</legend>
              <TextInput label="Pirkėjo kodas" name="perkanciosiosOrganizacijosKodas" placeholder="Nenurodyta" values={values} />
              <TextInput label="Tiekėjo kodas" name="tiekejoKodas" placeholder="Nenurodyta" values={values} />
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Laikotarpis</legend>
              <DateInput label="Sudaryta nuo" name="sudarymoDataNuo" values={values} />
              <DateInput label="Sudaryta iki" name="sudarymoDataIki" values={values} />
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Vertė</legend>
              <NumberInput label="Vertė nuo" name="verteNuo" placeholder="0 €" values={values} />
              <NumberInput label="Vertė iki" name="verteIki" placeholder="∞ €" values={values} />
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Klasifikacija</legend>
              <div class="form-group">
                <label class="form-label flex justify-between" for="bvpzPrefiksas">
                  <span>BVPŽ prefiksas <sup>1</sup></span>
                  <a href="/bvpz" class="text-sm">Žr. BVPŽ</a>
                </label>
                <select name="bvpzPrefiksas" id="bvpzPrefiksas" class="form-control">
                  <option value="" selected={!values['bvpzPrefiksas'] || values['bvpzPrefiksas'] === 'kitas'}>Visi / nurodytas žemiau</option>
                  <option value="48 72" selected={values['bvpzPrefiksas'] === '48 72'}>Informacinės technologijos</option>
                  <option value="3360 3361 3362 3363 3364 3365 3366 3367 33690 33691" selected={values['bvpzPrefiksas'] === '3360 3361 3362 3363 3364 3365 3366 3367 33690 33691'}>Vaistai</option>
                </select>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-muted text-xs"><em>arba</em></span>
              </div>
              <div class="form-group">
                <input type="text" class="form-control" name="bvpzPrefiksasKitas" id="bvpzPrefiksasKitas" value={values['bvpzPrefiksasKatas'] || ''} placeholder="Nenurodyta" />
              </div>
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Identifikatoriai</legend>
              <NumberInput label="Unikalus ID" name="sutartiesUnikalusID" placeholder="Nenurodyta" values={values} />
              <TextInput label="Sut. numeris" name="sutartiesNumeris" placeholder="Nenurodyta" values={values} />
              <TextInput label="Pirkimo numeris" name="pirkimoNumeris" placeholder="Nenurodyta" values={values} />
            </fieldset>

            <fieldset class="filter-group justify-start">
              <legend class="filter-group-label">Rikiavimas</legend>
              <div class="form-group">
                <label class="form-label" for="sort">Rikiuoti pagal</label>
                <div class="input-group">
                  <select name="sort" id="sort" class="form-control">
                    <option value="" selected={!values['sort']}>—</option>
                    {sortOptions.map(opt => (
                      <option value={opt.value} selected={values['sort'] === opt.value}>{opt.label}</option>
                    ))}
                  </select>
                  <SortToggle name="sortDir" values={values} />
                </div>
              </div>
            </fieldset>

            <fieldset class="filter-group justify-start">
              <legend class="filter-group-label">Filtrai</legend>
              <CheckboxInput name="tikSuDokumentais" label="Tik su dokumentais" values={values} />
              <CheckboxInput name="ignoruotiSp" label="Nerodyti pakeitimų (SP)" values={values} />
            </fieldset>

          </div>
          <p class="text-muted text-xs mt-7"><sup>1</sup> Veikia tik ne tekstinėse paieškose</p>
        </div>
      </div>

      <script>
        const searchToggle = document.querySelector<HTMLElement>('label[aria-controls="searchNustatymai"]');
        const filterBox = document.getElementById('searchNustatymai');
        const checkbox = document.querySelector<HTMLInputElement>('#searchNustatymaiToggle');
        const searchInput = document.querySelector<HTMLInputElement>('#search');

        if (searchToggle && filterBox && checkbox) {
          checkbox.addEventListener('change', () => {
            const isChecked = checkbox.checked;
            searchToggle.setAttribute('aria-expanded', String(isChecked));
            searchToggle.setAttribute('aria-label', isChecked ? 'Slėpti filtrus' : 'Rodyti filtrus');
            if (isChecked) {
              filterBox.removeAttribute('inert');
              filterBox.setAttribute('aria-hidden', 'false');
              const firstInput = filterBox.querySelector<HTMLElement>('input, select');
              if (firstInput) firstInput.focus();
            } else {
              filterBox.setAttribute('inert', '');
              filterBox.setAttribute('aria-hidden', 'true');
            }
          });
        }

        if (searchInput) {
          searchInput.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              searchInput.form?.submit();
            }
          });
        }
      </script>
    </form>

    <div class="mt-10 max-w-lg center mx-auto">
      <div>
        <div class="flex justify-between items-center mb-4">
          <span class="text-muted text-sm numberOfResults" set:html={numberOfResults} />
          {galimaEksportuoti && (
            <div class="flex gap-3">
              <a href={`/?${queryParams}&jsonl=true&limit=max`} class="btn btn-outline btn-sm" aria-label="Eksportuoti kaip JSONL">
                <span aria-hidden="true">↗</span> JSONL
              </a>
              <a href={`/?${queryParams}&csv=true&limit=max`} class="btn btn-outline btn-sm" aria-label="Eksportuoti kaip CSV">
                <span aria-hidden="true">↗</span> CSV
              </a>
            </div>
          )}
        </div>

        {results.length === 0
          ? <div class="empty-state"><p class="text-muted">Rezultatų nerasta.</p></div>
          : <>
              <div class="result-list">
                {results.map(item => (
                  <article class="result-card card-clickable">
                    <div class="result-card-body">
                      <dl class="result-card-meta">
                        <div><dt class="sr-only">Tipas</dt><dd>{item.tipas}</dd></div>
                        <div><dt class="sr-only">Kategorija</dt><dd>{item.kategorija}</dd></div>
                        <div>
                          <dt class="sr-only">Sutarties galiojimas</dt>
                          <dd>
                            <abbr aria-hidden="true" title="Sutarties galiojimas" class="relative z-1">Sut.</abbr>
                            {item.sudarymoData && item.galiojimoData
                              ? (() => {
                                  const d1 = String(item.sudarymoData).slice(0, 10);
                                  const d2 = String(item.galiojimoData).slice(0, 10);
                                  return <><time datetime={d1}>{d1}</time>{d1 !== d2 && <> – <time datetime={d2}>{d2}</time></>}</>;
                                })()
                              : '—'
                            }
                          </dd>
                        </div>
                        {(item.dokumentuKiekis ?? 0) > 0 && (
                          <div>
                            <dt class="sr-only">Dokumentai</dt>
                            <dd>{item.dokumentuKiekis} <abbr aria-hidden="true" title="Dokumentai" class="relative z-1">dok.</abbr></dd>
                          </div>
                        )}
                      </dl>

                      <div class="flex align-baseline gap-3">
                        <h3 class="result-card-title">
                          <a href={`/sutartis/${item.sutartiesUnikalusId}`}>
                            <span class={`amount${Number(item.faktineIvykdimoVerte || item.verte) > 10000 ? ' font-bold' : ''}`}>
                              {Number(item.faktineIvykdimoVerte || item.verte).toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}&nbsp;€
                            </span>
                            {item.pavadinimas.length < 1 ? <em>Nenurodyta</em> : item.pavadinimas}
                          </a>
                        </h3>
                      </div>

                      <div class="result-card-footer">
                        <span>
                          <strong>Pirkėjas:</strong>
                          <a href={`/asmuo/${item.perkanciosiosOrganizacijosKodas}`} class="relative z-1">
                            {item.perkanciojiOrganizacija?.slice(0, 80)}{(item.perkanciojiOrganizacija ?? '').length > 80 ? '…' : ''}
                          </a>
                        </span>
                        {item.tiekejai.length === 1
                          ? <span>
                              <strong>Tiekėjas:</strong>
                              <a href={`/asmuo/${item.tiekejaiKodai[0]}`} class="relative z-1">
                                {(item.tiekejai[0] || 'Nenurodytas').slice(0, 80)}{(item.tiekejai[0] || '').length > 80 ? '…' : ''}
                              </a>
                            </span>
                          : <span class="flex align-start gap-2">
                              <strong>Tiekėjai:</strong>
                              <span class="flex flex-col gap-1">
                                {item.tiekejai.map((t: string, i: number) => (
                                  <a href={`/asmuo/${item.tiekejaiKodai[i]}`} class="relative z-1">
                                    {(t || 'Nenurodytas').slice(0, 80)}{(t || '').length > 80 ? '…' : ''}
                                  </a>
                                ))}
                              </span>
                            </span>
                        }
                      </div>

                      <div class="text-muted text-sm mt-4">
                        {item.paskutinioRedagavimoData
                          ? <time datetime={item.paskutinioRedagavimoData}>{item.paskutinioRedagavimoData}</time>
                          : '—'
                        }
                      </div>
                    </div>
                  </article>
                ))}
              </div>
              <Pagination currentPage={page} pageCount={pageCount} queryParams={queryParams} />
            </>
        }
      </div>
    </div>

    <script>
      const span = document.querySelector('.rezultatai-nezinomas-total');
      if (span && !span.classList.contains('spin')) {
        span.classList.add('spin');
        const url = new URL(window.location.href);
        url.searchParams.set('rezultatuSkaiciausPatikslinimas', 'true');
        const durationSpan = document.querySelector('.numberOfResults [data-duration]');
        const trukme = durationSpan?.getAttribute('data-duration');
        if (trukme) url.searchParams.set('trukme', trukme);
        fetch(url)
          .then(res => res.json())
          .then(data => {
            if (data.zinomasRezultatuSkaicius) {
              span.className = '';
              const numberOfResultsElement = document.querySelector('.numberOfResults');
              if (numberOfResultsElement) numberOfResultsElement.innerHTML = data.numberOfResults;
            } else {
              span.classList.remove('spin');
            }
          })
          .catch(() => span.classList.remove('spin'));
      }
    </script>

  </main>
</Layout>
