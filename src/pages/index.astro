---
import Layout from '../layouts/Layout.astro';
import Button from '@design-system/components/Button.astro';
import SearchSuggest from '@design-system/components/content/SearchSuggest.astro';
import SutartysFilters from '../components/content/SutartysFilters.astro';
import DokFacetSection from '../components/dokumentai/DokFacetSection.astro';
import SutartysFacetModal from '../components/content/SutartysFacetModal.astro';
import SutartysBvpzModal from '../components/content/SutartysBvpzModal.astro';
import HistogramRangeFilter from '@design-system/components/filters/HistogramRangeFilter.astro';
import { splitFacetOptions } from '../lib/dokumentaiUrl.ts';
import SearchResults from '../components/content/SearchResults.astro';
import Reklama from '../components/reklamos/Reklama.astro';
import { pickReklama } from '@/modules/reklamos/pickReklama.js';
import { searchSutartys, countSutartys, countSutartysQuickwit, getSutartysQueryMetadata } from '@/modules/sutartys/searchSutartys.js';
import { linksniuoti, linksniuotiK } from '@/utils/linksniai.js';
import config from '../lib/config.ts';
import { objectsToJsonlStream } from '@/utils/jsonl.js';
import { objectsToCsvStream } from '@/utils/csv.js';
import { buildAnalizeXlsx, canExportAnalizeXlsx, XLSX_EXPORT_LIMIT } from '@/modules/sutartys/analize.js';
import { Readable as NodeReadable, PassThrough, Transform } from 'node:stream';
import { cleanQuery, getColorScheme, getFont } from '../lib/failai.ts';

void NodeReadable;

type SearchValues = Record<string, string | number | undefined>;

type SearchResultItem = {
  tipas: string;
  kategorija: string;
  sudarymoData?: string | null;
  galiojimoData?: string | null;
  dokumentuKiekis?: number | null;
  sutartiesUnikalusId: string | number;
  faktineIvykdimoVerte?: number | string | null;
  verte?: number | string | null;
  pavadinimas: string;
  perkanciosiosOrganizacijosKodas: string;
  perkanciojiOrganizacija?: string | null;
  tiekejai: string[];
  tiekejaiKodai: string[];
  paskutinioRedagavimoData?: string | null;
};

type SortOption = {
  value: string;
  label: string;
};

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

// Reklama paieškos apačioje. Jei vartotojas paspaudė „Neberodyti niekada",
// cookie `reklamosPaslepta=1` ir SSR jos visai nekuria.
const reklama = Astro.cookies.get('reklamosPaslepta')?.value === '1'
  ? null
  : await pickReklama('sutartys');

const cleaned = cleanQuery(Astro.url);
if (cleaned.redirectTo) return Astro.redirect(cleaned.redirectTo);
const query: Record<string, string> = cleaned.query;
// Rikiavimo <select> koduoja lauką ir kryptį viename `sort` parametre
// (`laukas:kryptis`, pvz. `sudarymoData:asc`), kad vienas dropdown valdytų abu.
// Išskaidom į `sort` + `sortDir`, kaip tikisi paieška/filtrai žemiau.
if (query.sort?.includes(':')) {
  const [field, dir] = query.sort.split(':');
  query.sort = field;
  if (dir) query.sortDir = dir;
}
const DEFAULT_LIMIT = 50;
const limit = parseInt(query.limit) || DEFAULT_LIMIT;
const page = parseInt(query.page) || 1;
// Quickwit naudojamas visada, kai įjungtas — įsk. tuščią pradinį puslapį
// (be filtrų), kad ir ten rodytųsi facetai. Kitaip krentam į Postgres.
const engine = config.quickwitUp
  ? 'quickwit'
  : 'postgres';

type Timing = { label: string; start: number; duration: number; phase?: string };

function buildNumberOfResults({ shown, total, elapsed, engine, timings }: { shown: number; total: number | null; elapsed: number; engine: string; timings?: Timing[] | null }) {
  const durationMs = Math.round(elapsed);
  const trukme = (elapsed / 1000).toFixed(2);
  const timingsAttr = timings && timings.length ? ` data-timings='${JSON.stringify(timings).replace(/'/g, '&#39;')}'` : '';
  const source = `<span class="inline timing-source" data-duration="${durationMs}"${timingsAttr}>(${trukme}s, ${engine})</span>`;
  if (total == null) {
    return `Rodomi ${shown} iš apie <span class="rezultatai-nezinomas-total"> ? </span> rezultatų ${source}`;
  }
  if (shown < total) {
    const approximate = engine === 'quickwit' ? 'apie ' : '';
    return `Rodomi ${shown} iš ${approximate}${linksniuotiK(total, ['rezultato', 'rezultatų'])} ${source}`;
  }
  if (engine === 'quickwit') {
    return `Rodomi ${shown} iš apie ${linksniuotiK(total, ['rezultato', 'rezultatų'])} ${source}`;
  }
  return `${linksniuoti(total, ['rezultatas', 'rezultatai', 'rezultatų'])} ${source}`;
}

async function timed<T>(promise: Promise<T>): Promise<{ value: T; ms: number }> {
  const t0 = performance.now();
  const value = await promise;
  return { value, ms: Math.round(performance.now() - t0) };
}

function buildPaginationHtml({ currentPage, pageCount, queryParams }: { currentPage: number; pageCount: number; queryParams: string }) {
  const totalPages = Number(pageCount);
  const current = Number(currentPage);
  const maxVisible = 6;
  const half = Math.floor(maxVisible / 2);
  let start = Math.max(1, current - half);
  let end = Math.min(totalPages, current + half);

  if (current <= half) {
    end = Math.min(totalPages, maxVisible);
  }
  if (current + half > totalPages) {
    start = Math.max(1, totalPages - maxVisible + 1);
  }

  const pageLink = (page: number) => `?page=${page}`;
  const pages = Array.from({ length: end - start + 1 }, (_, i) => start + i);

  // Return only list items, because client-side update replaces innerHTML of the existing ul.pagination element.
  return `${current > 1 ? `<li><a href="${pageLink(current - 1) + queryParams}" aria-label="Ankstesnis puslapis"><span aria-hidden="true">←</span></a></li>` : '<li class="disabled"><span aria-hidden="true">←</span></li>'}${pages.map(i => `<li${i === current ? ' class="active"' : ''}><a href="${pageLink(i) + queryParams}" aria-label="Puslapis ${i}"${i === current ? ' aria-current="page"' : ''}>${i}</a></li>`).join('')}${current < totalPages ? `<li><a href="${pageLink(current + 1) + queryParams}" aria-label="Kitas puslapis"><span aria-hidden="true">→</span></a></li>` : '<li class="disabled"><span aria-hidden="true">→</span></li>'}`;
}

void buildPaginationHtml;

// Stream exports (JSONL / CSV / XLSX) short-circuit
if (query.jsonl || query.csv || query.xlsx) {
  // Eksportai (xlsx/csv/jsonl) ribojami iki XLSX_EXPORT_LIMIT: XLSX visada
  // (kaupiamas atmintyje), o Quickwit varikliu — ir CSV/JSONL, nes Quickwit gali
  // pasiekti nebent tiek įrašų (žr. searchAll). Postgres CSV/JSONL lieka be ribos
  // (srautinamas tiesiai). Riba tikrinama pagal eksporto variklį, kad Quickwit
  // rezultatai (prefiksai/wildcard'ai) neatitiktų Postgres tikslaus skaičiaus.
  const capped = Boolean(query.xlsx) || engine === 'quickwit';
  if (capped) {
    const total = engine === 'quickwit' ? await countSutartysQuickwit(query) : await countSutartys(query);
    if (!canExportAnalizeXlsx(total)) {
      return new Response(
        `Eksportas galimas iki ${XLSX_EXPORT_LIMIT.toLocaleString('lt-LT')} sutarčių. Pagal pasirinktus filtrus rasta ${total.toLocaleString('lt-LT')}.`,
        {
          status: 413,
          headers: { 'Content-Type': 'text/plain; charset=utf-8' },
        },
      );
    }
  }

  const { stream, client } = await searchSutartys(query, {
    limit: capped ? XLSX_EXPORT_LIMIT : null,
    page: 1,
    stream: true,
    sort: false,
    engine,
  }) as {
    stream: import('node:stream').Readable | null;
    client: { release(): void } | null;
  };

  if (!stream) {
    return new Response(null, { status: 500 });
  }

  if (query.xlsx) {
    const rows: Record<string, unknown>[] = [];
    try {
      for await (const row of stream) rows.push(row as Record<string, unknown>);
    } finally {
      client?.release();
    }
    const viewUrl = new URL(Astro.url);
    viewUrl.protocol = 'https:';
    ['xlsx', 'csv', 'jsonl', 'limit', 'page'].forEach(key => viewUrl.searchParams.delete(key));
    const filterLabels: Record<string, string> = {
      search: 'Paieška',
      perkanciosiosOrganizacijosKodas: 'Pirkėjo kodas',
      tiekejoKodas: 'Tiekėjo kodas',
      sutartiesNumeris: 'Sutarties numeris',
      pirkimoNumeris: 'Pirkimo numeris',
      sutartiesUnikalusID: 'Sutarties ID',
      tipas: 'Sutarties tipas',
      sudarymoDataNuo: 'Sudaryta nuo',
      sudarymoDataIki: 'Sudaryta iki',
      verteNuo: 'Vertė nuo',
      verteIki: 'Vertė iki',
      bvpzPrefiksas: 'BVPŽ kodas',
      tikSuDokumentais: 'Tik su dokumentais',
      ignoruotiSp: 'Be pakeitimų',
      sort: 'Rikiavimas',
      dir: 'Rikiavimo kryptis',
    };
    const filters = [...viewUrl.searchParams.entries()]
      .map(([key, value]) => `${filterLabels[key] ?? key}: ${value}`)
      .join('; ');
    const metadata = {
      exportedAt: new Date(),
      viewUrl: viewUrl.toString(),
      filters,
    };
    const body = buildAnalizeXlsx(rows, metadata);
    void body;
    return new Response(body as unknown as BodyInit, {
      headers: {
        'Content-Type': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'Content-Disposition': `attachment; filename=viespirkiai-analize-${new Date().toISOString()}.xlsx`,
      },
    });
  }

  const pass = new PassThrough();
  // Ensure client is released when stream ends/errors
  if (client) {
    stream.on('end', () => client.release());
    stream.on('error', () => client.release());
  }

  if (query.jsonl) {
    stream.pipe(objectsToJsonlStream()).pipe(pass);
    return new Response(NodeReadable.toWeb(pass) as unknown as BodyInit, {
      headers: {
        'Content-Type': 'application/x-ndjson',
        'Content-Disposition': `attachment; filename=viespirkiai-${new Date().toISOString()}.jsonl`,
      },
    });
  }

  if (query.csv) {
    const formatDate = (value: unknown): string => {
      if (!value) return '';
      const date = new Date(value as string | number | Date);
      return isNaN(date.getTime()) ? '' : date.toISOString().split('T')[0];
    };

    const toCsvRow = new Transform({
      objectMode: true,
      transform(row: Record<string, unknown>, _enc, cb) {
        cb(null, {
          'Tipas': row.tipas ?? '',
          'Kategorija': row.kategorija ?? '',
          'Pavadinimas': row.pavadinimas ?? '',
          'Numatyta vertė': row.verte ?? '',
          'Faktinė vertė': row.faktineVerte ?? '',
          'Pirkėjo pavadinimas': row.perkanciojiOrganizacija ?? '',
          'Pirkėjo kodas': row.perkanciosiosOrganizacijosKodas ?? '',
          'Tiekėjų pavadinimai': Array.isArray(row.tiekejai) ? (row.tiekejai as unknown[]).join('; ') : '',
          'Tiekėjų kodai': Array.isArray(row.tiekejaiKodai) ? (row.tiekejaiKodai as unknown[]).join('; ') : '',
          'Sudarymo data': formatDate(row.sudarymoData),
          'Faktinė įvykdymo data': formatDate(row.faktineIvykdymoData),
          'Redagavimo data': formatDate(row.paskutinioRedagavimoData),
          'BVPZ kodai': Array.isArray(row.bvpzKodai) ? (row.bvpzKodai as unknown[]).filter(Boolean).join('; ') : '',
          'Sutarties numeris': row.sutartiesNumeris ?? '',
          'Unikalus ID': row.sutartiesUnikalusId ?? '',
        });
      },
    });

    stream.pipe(toCsvRow).pipe(objectsToCsvStream()).pipe(pass);
    return new Response(NodeReadable.toWeb(pass) as unknown as BodyInit, {
      headers: {
        'Content-Type': 'text/csv',
        'Content-Disposition': `attachment; filename=viespirkiai-${new Date().toISOString()}.csv`,
      },
    });
  }
}

// Result count update (AJAX)
if (query.rezultatuSkaiciausPatikslinimas) {
  const startas = performance.now();
  const countRes = await timed(countSutartys(query));
  const total = countRes.value as number;
  const { queryParams } = getSutartysQueryMetadata(query);
  const pageCount = Math.ceil(total / limit);
  const elapsed = performance.now() - startas + Number(query.trukme || 0);
  const timings: Timing[] = [
    { label: 'Skaičius', phase: 'count', start: 0, duration: countRes.ms },
  ];
  void timings;
  void [queryParams, pageCount, elapsed];
  return new Response(JSON.stringify({
    total,
    pageCount,
    queryParams,
    numberOfResults: buildNumberOfResults({ shown: limit, total, elapsed, engine, timings }),
    pagination: buildPaginationHtml({ currentPage: page, pageCount, queryParams }),
    zinomasRezultatuSkaicius: true,
  }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

type FacetOption = import('../lib/searchDokumentai').FacetOption;
type SutartysFacetData = {
  tipas: FacetOption[];
  kategorija: FacetOption[];
  buyers: FacetOption[];
  suppliers: FacetOption[];
  bvpz: FacetOption[];
  suma: { buckets: { from: number; to: number | null; count: number }[]; domainMin: number; domainMax: number };
  laikotarpis: { buckets: { from: number; to: number | null; count: number }[]; domainMin: number; domainMax: number };
};

const startas = performance.now();
const searchTimed = await timed(searchSutartys(query, { limit, page, engine, includeFacets: engine === 'quickwit' }));
const { results, total: searchedTotal, values, queryParams, timings: searchTimings, facets } = searchTimed.value as {
  results: SearchResultItem[];
  total: number | null;
  values: SearchValues;
  queryParams: string;
  timings?: Timing[];
  facets?: SutartysFacetData | null;
};

// Facetų parametrų dabartinės reikšmės (iš URL) sąrašais + daugiareikšmės
// (multi-select) atrankos nuoroda: perjungiam reikšmę parametro sąraše, atstatom
// puslapį. BVPŽ dalijasi tarpais atskirtu lauku su parinkikliu; kiti — kableliu.
const FACET_PARAMS = ['tipas', 'kategorija', 'perkanciosiosOrganizacijosKodas', 'tiekejoKodas', 'bvpzPrefiksasKitas'];
const facetSep = (param: string) => (param === 'bvpzPrefiksasKitas' ? ' ' : ',');
const splitFacet = (param: string, raw: string) =>
  raw.split(facetSep(param)).map((s) => s.trim()).filter(Boolean);
const facetSelected: Record<string, string[]> = Object.fromEntries(
  FACET_PARAMS.map((k) => [k, splitFacet(k, Astro.url.searchParams.get(k) ?? '')]),
);

// Aktyvių filtrų skaičius mobilaus „Filtrai" mygtuko ženkliukui (kaip /dokumentai).
const FILTER_KEYS = [
  'perkanciosiosOrganizacijosKodas', 'tiekejoKodas', 'tipas', 'kategorija',
  'bvpzPrefiksasKitas', 'sumaNuo', 'sumaIki', 'sudarymoDataNuo', 'sudarymoDataIki',
  'sutartiesUnikalusID', 'sutartiesNumeris', 'pirkimoNumeris', 'tikSuDokumentais',
];
const activeFilterCount = FILTER_KEYS.filter((k) => (Astro.url.searchParams.get(k) ?? '').trim() !== '').length;
function facetToggleUrl(param: string, value: string): string {
  const p = new URLSearchParams(Astro.url.search);
  const sep = facetSep(param);
  const cur = splitFacet(param, p.get(param) ?? '');
  let next: string[];
  if (value === '') next = [];
  else if (cur.includes(value)) next = cur.filter((v) => v !== value);
  else next = [...cur, value];
  if (next.length) p.set(param, next.join(sep));
  else p.delete(param);
  // BVPŽ facetas ir paslėptas laukas dalijasi reikšme — išvalom nesutampantį.
  if (param === 'bvpzPrefiksasKitas') p.delete('bvpzPrefiksas');
  p.delete('page');
  const s = p.toString();
  return s ? `/?${s}` : '/';
}

// Pastato DokFacet objektą (kaip /dokumentai) DokFacetSection komponentui:
// dabartinė atranka, matomi + perpildos variantai, ir reikšmės perjungimo URL.
function mkFacet(param: string, options: FacetOption[], limit = 8) {
  const sel = facetSelected[param] ?? [];
  const { visible, hidden } = splitFacetOptions(options, sel, limit);
  return { filter: sel, visible, hidden, toggleUrl: (v: string) => facetToggleUrl(param, v) };
}
const elapsed = performance.now() - startas;
const total = searchedTotal;
const initialTimings: Timing[] = searchTimings?.length
  ? searchTimings
  : [{ label: 'Paieška', phase: 'search', start: 0, duration: searchTimed.ms }];
const numberOfResults = buildNumberOfResults({ shown: results.length, total, elapsed, engine, timings: initialTimings });

const pageCount = Math.ceil((total || 100_000) / limit);

let galimaEksportuoti = Object.keys(values).length > 0;
// Eksportas įmanomas tik iki XLSX_EXPORT_LIMIT (Quickwit pasiekiama riba). Kai
// rezultatų daugiau, mygtukai vestų į 413 — vietoj jų parodom paaiškinimą.
// Quickwit `total` yra tas pats įvertis, kurį naudoja serverio riba, tad sutampa.
const eksportasPerDaug = engine === 'quickwit' && total != null && total > XLSX_EXPORT_LIMIT;
values.limit = limit;

// Kiekviena parinktis koduoja lauką ir kryptį (`laukas:kryptis`); numatytoji
// (naujausiai redaguotos) turi tuščią reikšmę — sistemos numatytasis rikiavimas.
const sortOptions = [
  { value: '', label: 'Naujausiai redaguotos' },
  { value: 'paskutinioRedagavimoData:asc', label: 'Seniausiai redaguotos' },
  { value: 'sudarymoData:desc', label: 'Naujausiai sudarytos' },
  { value: 'sudarymoData:asc', label: 'Seniausiai sudarytos' },
  { value: 'suma:desc', label: 'Didžiausia suma' },
  { value: 'suma:asc', label: 'Mažiausia suma' },
  { value: 'paskelbimoData:desc', label: 'Naujausiai paskelbtos' },
  { value: 'paskelbimoData:asc', label: 'Seniausiai paskelbtos' },
 ] satisfies SortOption[];

// Dabartinės atrankos reikšmė dropdown'ui: sujungiam lauką ir kryptį atgal į
// `laukas:kryptis`. Numatytasis (paskutinioRedagavimoData desc) atitinka tuščią
// reikšmę, kad URL liktų švarus.
const sortValue = values.sort
  ? (values.sort === 'paskutinioRedagavimoData' && (values.sortDir ?? 'desc') === 'desc'
      ? ''
      : `${values.sort}:${values.sortDir ?? 'desc'}`)
  : '';

Astro.response.headers.set('Cache-Control', 'private, max-age=10');
---

<Layout
  pageTitle="Sutarčių paieška"
  pageDescription="Pilietinė viešųjų pirkimų analizės iniciatyva. Prieinamai patiekiamos viešųjų pirkimų sutartys bei kita susijusi informacija."
  pageImage="https://viespirkiai.org/sutartys.png"
  colorScheme={colorScheme}
  font={font}
  customHead={config.customHead}
>
  <main class="sut-main sidebar-main">
    <form method="get" role="search" id="searchForm" class="searchform-sidebar">
      <h1 class="sr-only">Sutarčių paieška</h1>

      {/* Facetų atranka gyvena tik URL'e (ne formos laukuose). Kad rikiavimo
          keitimas ar „Ieškoti" (formos pateikimas) jos neprarastų, perduodam
          paslėptais laukais. `bvpzPrefiksasKitas` jau yra formos laukas
          (SutartysFilters), tad jo čia nekartojam. */}
      {facets && ['tipas', 'kategorija', 'perkanciosiosOrganizacijosKodas', 'tiekejoKodas'].map((k) => {
        const v = Astro.url.searchParams.get(k);
        return v ? <input type="hidden" name={k} value={v} /> : null;
      })}

      <aside class="sf-rail" aria-label="Filtrai">
        <div class="sf-rail-head">
          <button type="button" class="sf-rail-toggle" id="sfFiltersToggle" aria-expanded="false" aria-controls="sfRailBody">
            <span class="sf-rail-toggle-label">Filtrai</span>
            {activeFilterCount > 0 && <span class="sf-filters-count">{activeFilterCount}</span>}
            <span class="sf-filters-chevron" aria-hidden="true"></span>
          </button>
        </div>
        <div class="sf-rail-body" id="sfRailBody">
          {facets && (
            <div class="sut-facets">
              <DokFacetSection
                label="Pirkėjas"
                param="perkanciosiosOrganizacijosKodas"
                facet={mkFacet('perkanciosiosOrganizacijosKodas', facets.buyers, 5)}
                allLabel="Visi"
                stacked
                modal={{ field: 'perkanciosiosOrganizacijosKodas', title: 'Pirkėjas', always: true }}
              />
              <DokFacetSection
                label="Tiekėjas"
                param="tiekejoKodas"
                facet={mkFacet('tiekejoKodas', facets.suppliers, 5)}
                allLabel="Visi"
                stacked
                modal={{ field: 'tiekejaiKodai', title: 'Tiekėjas', always: true }}
              />
              <HistogramRangeFilter mode="number" legend="Suma" unit="€" nameFrom="sumaNuo" nameTo="sumaIki" redirectBase="/" hist={facets.suma} valueFrom={values.sumaNuo as string | undefined} valueTo={values.sumaIki as string | undefined} ariaFrom="Suma nuo" ariaTo="Suma iki" />
              <HistogramRangeFilter mode="date" legend="Laikotarpis" nameFrom="sudarymoDataNuo" nameTo="sudarymoDataIki" redirectBase="/" hist={facets.laikotarpis} valueFrom={values.sudarymoDataNuo as string | undefined} valueTo={values.sudarymoDataIki as string | undefined} ariaFrom="Sudaryta nuo" ariaTo="Sudaryta iki" />
              <DokFacetSection label="BVPŽ" param="bvpzPrefiksasKitas" facet={mkFacet('bvpzPrefiksasKitas', facets.bvpz, 8)} allLabel="Visi" stacked modal={{ field: 'bvpzKodai', title: 'BVPŽ klasifikacija', always: true }} />
              <DokFacetSection label="Tipas" param="tipas" facet={mkFacet('tipas', facets.tipas, 5)} allLabel="Visi" alwaysAll />
              <DokFacetSection label="Kategorija" param="kategorija" facet={mkFacet('kategorija', facets.kategorija, 6)} allLabel="Visos" />
              <p class="dok-facet-note">Rodomi apytiksliai skaičiai.</p>
            </div>
          )}
          <SutartysFilters values={values} hideParticipants={!!facets} />
          <button type="submit" class="sf-rail-search">Ieškoti</button>
        </div>
      </aside>

      <div class="sf-search">
        <div class="search-bar">
          <label for="search">
            <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
            </svg>
            <span class="sr-only">Paieška</span>
          </label>
          <input
            type="search"
            name="search"
            id="search"
            class="search-bar__input"
            value={values.search as string | undefined}
            placeholder="Tekstinė paieška"
            enterkeyhint="search"
          />
          <Button type="submit">Ieškoti</Button>
        </div>
      </div>

      <div class="sf-results">
        <SearchResults
          numberOfResults={numberOfResults}
          results={results}
          page={page}
          pageCount={pageCount}
          queryParams={queryParams}
          galimaEksportuoti={galimaEksportuoti}
          eksportasPerDaug={eksportasPerDaug}
          eksportoRiba={XLSX_EXPORT_LIMIT}
          containerClass="mt-0"
          flat={true}
          sortOptions={sortOptions}
          sortValue={sortValue}
        />
        {reklama && <Reklama reklama={reklama} />}
      </div>
    </form>
    <SearchSuggest saltinis="sutartysPavadinimai" />
    {facets && <SutartysFacetModal />}
    {facets && <SutartysBvpzModal />}
  </main>
</Layout>

<style>
  /* Pirmoji facetų sekcija be viršutinio tarpo — DokFacetSection prideda
     padding-top:20px kiekvienai sekcijai, bet viršuje jis palieka tuščią plyšį. */
  .sut-facets :global(.dok-filter-section:first-child) {
    padding-top: 0;
  }

  /* Tarpas tarp Quickwit facetų ir tikslių įvesties filtrų apačioje (be linijos). */
  .sut-facets + :global(.ds-filter-panel--rail) {
    margin-top: 24px;
  }
</style>

<script is:inline>
  // DokFacetSection elgsena sutarčių puslapyje (be dokumentai AJAX runtime):
  // toggle nuorodos veikia natūraliai per href. Čia tik: (1) „Rodyti daugiau"
  // inline atskleidimas ir (2) pirkėjo/tiekėjo kodo įvedimo laukai.
  // „Rodyti daugiau" inline atskleidimas facetams be dialogo (tipas/kategorija/
  // BVPŽ). Pirkėjo/tiekėjo „Daugiau" atidaro dialogą (žr. SutartysFacetModal).
  document.querySelectorAll('.sut-facets .dok-more-btn').forEach((btn) => {
    if (btn.dataset.facetModal) return; // šiuos tvarko dialogas
    btn.addEventListener('click', () => {
      const more = btn.previousElementSibling;
      if (more && more.classList.contains('dok-more-list')) {
        more.hidden = false;
        btn.remove();
      }
    });
  });

  // Mobilus filtrų perjungiklis: antraštė suskleidžia/atskleidžia juostą (≤900px).
  const sfToggle = document.getElementById('sfFiltersToggle');
  const sfRail = document.querySelector('.sf-rail');
  sfToggle?.addEventListener('click', () => {
    const open = sfRail?.classList.toggle('is-open') ?? false;
    sfToggle.setAttribute('aria-expanded', String(open));
  });
</script>

<script>
  // Telefone (≤900px) šoninės juostos facetai kaupiami formoje, o pritaikomi per
  // „Ieškoti" (žr. mobileFilterBatch). Darbastalyje nuorodos veikia įprastai.
  import { initRailFacetBatch } from '@/src/lib/mobileFilterBatch';
  import { initStickyRail } from '@/src/lib/stickyRail';
  import { initHistogramRangeFilters } from '@design-system/components/filters/histogramRangeFilter';
  initRailFacetBatch('.sut-facets', (p) => (p === 'bvpzPrefiksasKitas' ? ' ' : ','));
  initStickyRail();
  initHistogramRangeFilters();
</script>
