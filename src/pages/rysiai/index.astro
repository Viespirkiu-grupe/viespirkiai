---
import Button from '@design-system/components/Button.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { getColorScheme, getFont } from '../../lib/failai.ts';
const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);
---
<Layout pageTitle="Ryšiai" pageDescription="Išekokite ryšių tarp juridinių ir sutarčių duomenų" pageImage="" colorScheme={colorScheme} font={font}>
  <main>
    <PageHeader className="justify-center text-center">Išekokite ryšių tarp juridinių ir sutarčių duomenų</PageHeader>
    <div class="flex gap-6 justify-center mt-8">
      <Button href="/" variant="outline">↗ Sutartys</Button>
      <Button href="/juridiniai" variant="outline">↗ Juridiniai</Button>
    </div>
  </main>
</Layout>
