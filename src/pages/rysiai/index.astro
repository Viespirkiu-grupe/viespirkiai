---
import Layout from '../../layouts/Layout.astro';
const colorScheme = Astro.cookies.get('colorScheme')?.value || 'auto';
const font = Astro.cookies.get('font')?.value || 'ubuntu';
---
<Layout pageTitle="Ryšiai" pageDescription="Išekokite ryšių tarp juridinių ir sutarčių duomenų" pageImage="" colorScheme={colorScheme} font={font}>
  <main>
    <div class="page-header" style="justify-content: center; text-align: center;">
      <h1>Išekokite ryšių tarp juridinių ir sutarčių duomenų</h1>
    </div>
    <div class="flex gap-6 justify-center mt-8">
      <a href="/" class="btn btn-outline">↗ Sutartys</a>
      <a href="/juridiniai" class="btn btn-outline">↗ Juridiniai</a>
    </div>
  </main>
</Layout>
