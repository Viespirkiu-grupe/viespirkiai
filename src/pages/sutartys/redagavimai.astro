---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '@design-system/components/PageHeader.astro';
import Pagination from '@design-system/components/Pagination.astro';
import EmptyState from '@design-system/components/EmptyState.astro';
import SutartisRedagavimuKortele from '../../components/sutartis/SutartisRedagavimuKortele.astro';
import { loadRedagavimuSarasas } from '../../lib/sutartisPakeitimai.ts';
import { getColorScheme, getFont } from '../../lib/failai.ts';
import config from '../../lib/config.ts';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const PAGE_SIZE = 20;
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1') || 1);
const skip = (currentPage - 1) * PAGE_SIZE;

const { items, visoSutarciu, visoRedagavimu } = await loadRedagavimuSarasas({
  limit: PAGE_SIZE,
  skip,
});
const pageCount = Math.max(1, Math.ceil(visoSutarciu / PAGE_SIZE));

if (Astro.url.searchParams.has('json')) {
  return new Response(
    JSON.stringify({ data: items, currentPage, pageCount, visoSutarciu, visoRedagavimu }, null, 2),
    { headers: { 'Content-Type': 'application/json' } },
  );
}

Astro.response.headers.set('Cache-Control', 'private, max-age=10');
---

<Layout
  pageTitle="Sutarčių redagavimai"
  pageDescription="Naujausiai redaguotos viešųjų pirkimų sutartys ir jų pakeitimai CVP IS duomenyse"
  colorScheme={colorScheme}
  font={font}
  customHead={config.customHead}
>
  <main class="sidebar-main">
    <div class="redagavimai-shell">
      <aside class="redagavimai-rail" aria-label="Apie redagavimus">
        <div class="rail-card">
          <h2 class="rail-card__title">Sutarčių redagavimai</h2>
          <p class="rail-card__text">
            Kai perkančioji organizacija pataiso jau paskelbtą sutartį, mes užfiksuojame
            pokytį. Čia – naujausiai redaguotos sutartys su paskutiniais pakeitimais.
          </p>

          <dl class="rail-stats">
            <div>
              <dt>Redaguota sutarčių</dt>
              <dd>{visoSutarciu.toLocaleString('lt-LT')}</dd>
            </div>
            <div>
              <dt>Iš viso redagavimų</dt>
              <dd>{visoRedagavimu.toLocaleString('lt-LT')}</dd>
            </div>
          </dl>

          <div class="rail-legenda">
            <span class="rail-legenda__title">Žymėjimai</span>
            <ul>
              <li><span class="zenklas zenklas--pridėta">+</span> pridėta reikšmė</li>
              <li><span class="zenklas zenklas--pašalinta">−</span> pašalinta reikšmė</li>
              <li><span class="zenklas zenklas--pakeista">↝</span> pakeista reikšmė</li>
            </ul>
          </div>

          <p class="rail-card__note">
            Redagavimai pilnai sekami nuo <br><time datetime="2026-07-17">2026-07-17</time>
          </p>

          <p class="rail-card__note">
            Nurodomas redagavimo pastebėjimo laikas. Daugelį redagavimų pastebime
            per 5 minutes.
          </p>
        </div>
      </aside>

      <div class="redagavimai-content">
        <PageHeader>
          Sutarčių redagavimai
        </PageHeader>

        {items.length === 0 ? (
          <EmptyState message="Redagavimų nerasta." />
        ) : (
          <>
            <div class="redagavimai-sarasas">
              {items.map((redagavimai) => (
                <SutartisRedagavimuKortele redagavimai={redagavimai} />
              ))}
            </div>
            <Pagination currentPage={currentPage} pageCount={pageCount} queryParams="" />
          </>
        )}
      </div>
    </div>
  </main>
</Layout>

<script>
  // Juosta telpa ekrane – užtenka paprasto sticky, prilipdyto po sticky navbar
  // su tarpu. (Bendras initStickyRail prilipdo flush, be tarpo.)
  const nav = document.querySelector<HTMLElement>('.site-header-shell .navbar');
  const rail = document.querySelector<HTMLElement>('.redagavimai-rail');
  const setTop = () => {
    if (rail) rail.style.top = `${(nav?.offsetHeight ?? 0) + 16}px`;
  };
  setTop();
  window.addEventListener('resize', setTop);
</script>

<style>
  .redagavimai-shell {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    /* sidebar-main nuima numatytą main paraštę – atkuriame ją čia. */
    padding-inline: 56px;
    padding-top: 28px;
  }

  @media (max-width: 1200px) {
    .redagavimai-shell {
      padding-inline: 28px;
    }
  }

  .redagavimai-rail {
    position: sticky;
    top: 24px;
    align-self: start;
  }

  .rail-card {
    padding: 20px;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .rail-card__title {
    margin: 0 0 8px;
    font-size: var(--text-md);
  }

  .rail-card__text {
    margin: 0 0 16px;
    font-size: var(--text-sm);
    color: var(--gray);
    line-height: 1.5;
  }

  .rail-stats {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0 0 16px;
    padding: 16px 0;
    border-top: var(--border);
    border-bottom: var(--border);
  }

  .rail-stats div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .rail-stats dt {
    font-size: var(--text-sm);
    color: var(--gray);
  }

  .rail-stats dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .rail-legenda__title {
    display: block;
    margin-bottom: 8px;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .rail-legenda ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--text-sm);
    color: var(--gray);
  }

  .zenklas {
    display: inline-block;
    width: 1.2em;
    text-align: center;
    font-weight: 700;
  }

  .rail-card__note {
    margin: 16px 0 0;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    background: var(--lighter-gray);
    font-size: var(--text-xs);
    color: var(--gray);
    line-height: 1.5;
  }

  .rail-card__note time {
    font-weight: 600;
    color: var(--black);
    white-space: nowrap;
  }

  .zenklas--pridėta { color: var(--color-success); }
  .zenklas--pašalinta { color: var(--color-danger); }
  .zenklas--pakeista { color: var(--color-info); }

  .redagavimai-sarasas {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 32px;
  }

  @media (max-width: 900px) {
    .redagavimai-shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .redagavimai-rail {
      position: static;
      order: 2;
    }

    .redagavimai-content {
      order: 1;
    }
  }
</style>
