---
import Layout from '../../layouts/Layout.astro';
import { getJuridinisInfo } from '@/modules/juridiniai/getJuridinisInfo.js';
import config from '@/config.js';
import '@/utils/time.js';
import '@/utils/linksniai.js';
import VidutinisDarboUzmokestis from '../../components/asmuo/VidutinisDarboUzmokestis.astro';
import DarbuotojuSkaicius from '../../components/asmuo/DarbuotojuSkaicius.astro';
import Imokos from '../../components/asmuo/Imokos.astro';
import Sutartys from '../../components/asmuo/Sutartys.astro';
import MvpAprasai from '../../components/asmuo/MvpAprasai.astro';
import Melagiai from '../../components/asmuo/Melagiai.astro';
import Nepatikimi from '../../components/asmuo/Nepatikimi.astro';
import FinansinesAtaskaitos from '../../components/asmuo/FinansinesAtaskaitos.astro';
import DarboSkelbimai from '../../components/asmuo/DarboSkelbimai.astro';
import RcPranesimai from '../../components/asmuo/RcPranesimai.astro';
import Domenai from '../../components/asmuo/Domenai.astro';
import Kotis from '../../components/asmuo/Kotis.astro';
import EsInvesticijos from '../../components/asmuo/EsInvesticijos.astro';
import VdiPazeidimai from '../../components/asmuo/VdiPazeidimai.astro';
import Regitra from '../../components/asmuo/Regitra.astro';
import TeismoNuosprendziai from '../../components/asmuo/TeismoNuosprendziai.astro';
import PinregDeklaracijos from '../../components/asmuo/PinregDeklaracijos.astro';

const colorScheme = Astro.cookies.get('colorScheme')?.value || 'auto';
const font = Astro.cookies.get('font')?.value || 'ubuntu';

const raw = Astro.params.jarKodas!;
if (!/^\d{1,9}(\.json|\.png)?$/.test(raw)) return Astro.redirect('/404');

const format = raw.endsWith('.json') ? 'json' : raw.endsWith('.png') ? 'png' : 'html';
const jarKodas = raw.replace(/\.(json|png)$/, '');

const query = Object.fromEntries(Astro.url.searchParams);

function parseLimitai(q: Record<string, string>) {
  if (q.limitai === 'false') return {};
  const defaults: Record<string, number> = {
    regitra: 5, teismoNuosprendziai: 10, sutartys: 10, darboSkelbimai: 5,
    rcPranesimai: 3, domenai: 3, pinreg: 3, kotis: 3, esInvesticijos: 5,
    mvpAprasai: 1, vdiPazeidimai: 3,
  };
  const map: Record<string, string> = {
    transportoPriemonesLimit: 'regitra', teismoNuosprendziaiLimit: 'teismoNuosprendziai',
    sutartysLimit: 'sutartys', darboSkelbimaiLimit: 'darboSkelbimai',
    rcPranesimaiLimit: 'rcPranesimai', domenaiLimit: 'domenai',
    pinregLimit: 'pinreg', kotisLimit: 'kotis',
    esInvesticijosLimit: 'esInvesticijos', mvpAprasaiLimit: 'mvpAprasai',
    vdiPazeidimaiLimit: 'vdiPazeidimai',
  };
  return Object.fromEntries(
    Object.entries(map).map(([qk, k]) => {
      const val = q[qk];
      if (val === 'max') return [k, { limit: null }];
      if (val !== undefined) return [k, { limit: isNaN(Number(val)) ? defaults[k] : Number(val) }];
      return [k, { limit: defaults[k] }];
    })
  );
}

const juridinioInfo = await getJuridinisInfo(jarKodas, parseLimitai(query));

if (juridinioInfo.error === 404) return Astro.redirect('/404');

if (juridinioInfo.special) {
  return Astro.rewrite(`/asmuo/special?${new URLSearchParams({
    id: jarKodas,
    pavadinimas: juridinioInfo.pavadinimas,
    aprasymas: juridinioInfo.aprasymas,
  })}`);
}

const asmuo: any = 'asmuo' in juridinioInfo ? juridinioInfo.asmuo : undefined;

if (format === 'json' && asmuo) {
  return new Response(JSON.stringify(asmuo, null, 2), {
    headers: { 'Content-Type': 'application/json' },
  });
}

if (format === 'png' && asmuo) {
  return new Response(new Uint8Array(await (await import('@/utils/openGraphImage.js')).getOpenGraphImage(
    asmuo.jar.formosPavadinimas || 'Juridinis asmuo',
    asmuo.jar.pavadinimas.replace(asmuo.jar.formosPavadinimas || '', '').replaceAll('"', ''),
    `Registruotas: ${asmuo.jar.registravimoData}\nAdresas: ${asmuo.jar.adresas}\nVid. atlyginimas ${asmuo.sodra?.vidutinisAtlyginimas || 'nežinomas'} (€/mėn)\nDirba ${asmuo.sodra?.draustieji || 'nežinomas skaičius'} darb.`,
    `viespirkiai.org/asmuo/${asmuo.jar.jarKodas}`,
  )), {
    headers: { 'Content-Type': 'image/png', 'Cache-Control': 'public, max-age=7200, s-maxage=7200' },
  });
}

const chartsHead = `<script defer>
  let apexPromise;
  const renderedCharts = [];
  function loadApexCharts() {
    if (window.ApexCharts) return Promise.resolve(window.ApexCharts);
    if (apexPromise) return apexPromise;
    apexPromise = new Promise((resolve, reject) => {
      function startLoading() {
        const s = document.createElement('script'); s.src = '/dist/apexcharts.js'; s.defer = true;
        s.onload = () => resolve(window.ApexCharts); s.onerror = reject;
        document.body.appendChild(s);
      }
      document.readyState === 'loading' ? window.addEventListener('DOMContentLoaded', startLoading) : startLoading();
    });
    return apexPromise;
  }
  function deepMerge(t,s){for(const k in s){if(s[k]&&typeof s[k]==='object'&&!Array.isArray(s[k])){if(!t[k])t[k]={};deepMerge(t[k],s[k]);}else{t[k]=s[k];}}return t;}
  function getIsDark(){return document.documentElement.classList.contains('dark');}
  function getThemeTokens(d){return{foreground:d?'#f5f4f4':'#0c0a09',labelColor:d?'#a8a29e':'#292524',gridColor:d?'#292524':'#e7e5e4',tooltipBg:d?'#1c1917':'#fafaf9',tooltipText:d?'#f5f4f4':'#0c0a09',tooltipBorder:d?'#292524':'#d6d3d1'};}
  const CATEGORICAL_COLORS={light:['#0c0a09','#79716b','#e7e5e4'],dark:['#f5f4f4','#79716b','#292524']};
  function getCategoricalColors(d){return d?CATEGORICAL_COLORS.dark:CATEGORICAL_COLORS.light;}
  function getShadesOfGray(d){return d?['#f5f4f4','#d6d3d1','#a8a29e','#79716b','#57534e','#44403c','#292524']:['#0c0a09','#1c1917','#292524','#44403c','#57534e','#79716b','#a8a29e'];}
  const eurFormatter=v=>typeof v==='number'?v.toLocaleString('lt-LT',{style:'currency',currency:'EUR'}):'Nėra duomenų';
  function buildGlobalDefaults(d){const t=getThemeTokens(d);return{chart:{toolbar:{show:false},zoom:{enabled:false},fontFamily:'Ubuntu, system-ui, sans-serif',background:'transparent',height:350,foreColor:t.labelColor},tooltip:{enabled:true,theme:d?'dark':'light',style:{fontFamily:'Ubuntu, system-ui, sans-serif'}},xaxis:{labels:{style:{colors:t.labelColor}}},yaxis:{labels:{style:{colors:t.labelColor}}},stroke:{curve:'smooth',width:2},markers:{size:4},colors:getCategoricalColors(d),grid:{borderColor:t.gridColor},theme:{mode:d?'dark':'light'},legend:{labels:{colors:t.labelColor}}};}
  const typeChartDefaults={'line-datetime':{chart:{type:'line'},xaxis:{type:'datetime',tickAmount:6,labels:{format:'yyyy-MM'}},tooltip:{x:{format:'yyyy-MM'}}},'pie':{chart:{type:'pie'},legend:{position:'bottom'},dataLabels:{enabled:true}},'scatter':{chart:{type:'scatter'}},'treemap':{chart:{type:'treemap'}}};
  const chartFlagDefaults={'yEUR':{yaxis:{labels:{formatter:eurFormatter}}},'yEURMen':{yaxis:{labels:{formatter:v=>typeof v==='number'?eurFormatter(v)+' / mėn.':'Nėra duomenų'}}},'yMin0':{yaxis:{min:0}},'yMinAuto':{yaxis:{min:undefined}},'xYear':{xaxis:{labels:{format:'yyyy'}},tooltip:{x:{format:'yyyy'}}},'xAxisYearMonth':{xaxis:{type:'datetime',tickAmount:6,labels:{format:'yyyy-MM'}},tooltip:{x:{format:'yyyy-MM'}}},'xAxisDay':{xaxis:{type:'datetime',tickAmount:6,labels:{format:'yyyy-MM-dd'}},tooltip:{x:{format:'yyyy-MM-dd'}}},'numbersWithSpaces':{yaxis:{labels:{formatter:v=>typeof v==='number'?v.toLocaleString('lt-LT'):'Nėra duomenų'}}}};
  function buildOptions(data,isDark){let o=structuredClone(buildGlobalDefaults(isDark));if(data.type&&typeChartDefaults[data.type])o=deepMerge(o,structuredClone(typeChartDefaults[data.type]));for(const f of(data.flags||[])){if(f==='50shadesOfGray')o=deepMerge(o,{colors:getShadesOfGray(isDark)});else if(f in chartFlagDefaults)o=deepMerge(o,chartFlagDefaults[f]);}if(data.type!=='pie'){o.xaxis=o.xaxis||{};o.xaxis.categories=data.labels;if(Array.isArray(data.series)&&(data.series.length===0||!data.series[0]?.data)){o.series=[{name:data.customOptions?.seriesName||'',data:data.series}];}else{o.series=data.series;}}else{o.labels=data.labels;o.series=data.series;}if(data.customOptions)o=deepMerge(o,data.customOptions);return o;}
  async function displayChart(data){if(!data?.element||!data?.labels||!data?.series){return;}await loadApexCharts();const chart=new ApexCharts(data.element,buildOptions(data,getIsDark()));chart.render();renderedCharts.push({chart,data});}
  function updateAllCharts(){const d=getIsDark();const t=getThemeTokens(d);for(const{chart,data}of renderedCharts){const flags=data.flags||[];const colors=flags.includes('50shadesOfGray')?getShadesOfGray(d):getCategoricalColors(d);chart.updateOptions({chart:{foreColor:t.labelColor},tooltip:{theme:d?'dark':'light'},xaxis:{labels:{style:{colors:t.labelColor}}},yaxis:{labels:{style:{colors:t.labelColor}}},grid:{borderColor:t.gridColor},theme:{mode:d?'dark':'light'},legend:{labels:{colors:t.labelColor}},colors},false,true);}}
  new MutationObserver(updateAllCharts).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{if(!document.documentElement.classList.contains('dark'))updateAllCharts();});
<\/script>
<style>.chart{background-color:transparent;}.dark .apexcharts-tooltip,.dark .apexcharts-tooltip-title{background:#1c1917!important;color:#f5f4f4!important;border-color:#292524!important;}<\/style>`;

const leafletHead = asmuo?.jar?.location ? `<script defer>
(function(){
  window.__vpLeaflet=window.__vpLeaflet||{loading:null,loaded:false};
  const state=window.__vpLeaflet;
  function ensureCssOnce(){if(document.querySelector('link[data-vp-leaflet-css="1"]'))return;const l=document.createElement('link');l.rel='stylesheet';l.href='/dist/leaflet.css';l.dataset.vpLeafletCss='1';document.head.appendChild(l);}
  function waitForLeafletGlobal(r){const c=()=>{if(window.L&&window.L.map){state.loaded=true;r();}else{setTimeout(c,25);}};c();}
  function appendScriptWhenBodyReady(s){const m=()=>{const t=document.body||document.head||document.documentElement;if(!t)return false;t.appendChild(s);return true;};if(m())return;if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',()=>{m();},{once:true});}else{setTimeout(()=>{m();},0);}}
  function ensureJsOnce(){if(state.loaded){state.loading=state.loading||Promise.resolve();return state.loading;}if(state.loading)return state.loading;state.loading=new Promise((r,j)=>{if(document.querySelector('script[data-vp-leaflet-js="1"]'))return waitForLeafletGlobal(r);const s=document.createElement('script');s.src='/dist/leaflet.js';s.defer=true;s.dataset.vpLeafletJs='1';s.onload=()=>{state.loaded=true;r();};s.onerror=j;appendScriptWhenBodyReady(s);});return state.loading;}
  window.__vpLeafletLoad=window.__vpLeafletLoad||function(){ensureCssOnce();return ensureJsOnce();};
  try{window.__vpLeafletLoad();}catch(e){}
})();
<\/script>
<script defer>
(function(){
  function init(){
    const el=document.getElementById('asmuo-map');
    if(!el||el.dataset.leafletInited==='1')return;
    el.dataset.leafletInited='1';
    const lat=Number(el.dataset.y),lon=Number(el.dataset.x);
    if(!isFinite(lat)||!isFinite(lon))return;
    const map=L.map('asmuo-map',{zoomAnimation:true,markerZoomAnimation:true}).setView([lat,lon],16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);
    L.marker([lat,lon]).addTo(map);
  }
  function start(){if(typeof window.__vpLeafletLoad==='function'){window.__vpLeafletLoad().then(()=>{if(window.L&&window.L.map)init();}).catch(()=>{});}else{if(window.L&&window.L.map)init();}}
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',start,{once:true});}else{start();}
})();
<\/script>` : '';

const sodraLabels = (asmuo.sodra?.duomenys?.length > 0)
  ? JSON.stringify(asmuo.sodra.duomenys.map((d: any) => d.data + '-01'))
  : '[]';

const finansaiLimit = query.finansaiLimit === 'max' ? 9999999 : Number(query.finansaiLimit) || 1;
const mvpAprasaiLimit = query.mvpAprasaiLimit === 'max' ? 9999999 : Number(query.mvpAprasaiLimit) || 1;
---

{asmuo ? (
  <Layout
    pageTitle={asmuo.jar.pavadinimas}
    pageDescription="Juridinio asmens informacija"
    pageImage={`https://viespirkiai.org/asmuo/${asmuo.jar.jarKodas}.png`}
    colorScheme={colorScheme}
    font={font}
    customHead={((config as any).customHead || '') + chartsHead + leafletHead}
  >
    <main>
      <div class="page-header">
        <div>
          <h1>{asmuo.jar.pavadinimas}</h1>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <a href={`/asmuo/${asmuo.jar.jarKodas}.json`} class="btn btn-outline btn-sm">↗ JSON</a>
          {asmuo.sodra?.kodas && (
            <a href={`https://atvira.sodra.lt/imones/detaliai/index.html?code=${asmuo.sodra.kodas}`} class="btn btn-outline btn-sm">↗ SODRA</a>
          )}
          <a href={`https://liteko.teismai.lt/viesasprendimupaieska/paieska.aspx?txt=${asmuo.jar.jarKodas}`} class="btn btn-outline btn-sm">↗ Bylos</a>
          <a href={`/pirkejas/${asmuo.jar.jarKodas}`} class="btn btn-outline btn-sm">↗ Pirkimai</a>
          <a href={`/tiekejas/${asmuo.jar.jarKodas}`} class="btn btn-outline btn-sm">↗ Pardavimai</a>
          {(config as any).enableGraph && (
            <a href={`/rysiai/asmuo/${asmuo.jar.jarKodas}`} class="btn btn-outline btn-sm">↗ Ryšiai</a>
          )}
        </div>
      </div>

      <div class="grid-3 mb-7 items-start">
        <div>
          <div class="text-muted text-xs mb-4">Duomenys gali būti pasenę</div>
          <dl class="kv-list">
            <dt>JAR kodas</dt>
            <dd><span class="cell-mono">{asmuo.jar.jarKodas}</span> · {asmuo.jar.formosPavadinimas}</dd>

            {asmuo.sodra?.kodas && <>
              <dt>SODRA kodas</dt>
              <dd><span class="cell-mono">{asmuo.sodra.kodas}</span></dd>
            </>}

            {asmuo.sodra?.ekonominesVeiklosPavadinimas && <>
              <dt>Veikla</dt>
              <dd>{asmuo.sodra.ekonominesVeiklosPavadinimas} (<span class="cell-mono">{asmuo.sodra.ekonominesVeiklosKodas}</span>)</dd>
            </>}

            <dt>Įregistruota</dt>
            <dd>{asmuo.jar.registravimoData}</dd>

            <dt>Adresas</dt>
            <dd>
              {asmuo.jar.location
                ? <a href={`https://www.openstreetmap.org/?mlat=${asmuo.jar.location[0]}&mlon=${asmuo.jar.location[1]}&zoom=16`} target="_blank">{asmuo.jar.adresas}</a>
                : asmuo.jar.adresas
                  ? asmuo.jar.adresas
                  : <em class="text-muted">Nenurodytas</em>
              }
            </dd>

            {asmuo.istatinisKapitalas?.reiksme && <>
              <dt>Įstatinis kapitalas</dt>
              <dd>
                <span class="cell-mono">{asmuo.istatinisKapitalas.reiksme.toLocaleString('lt-LT', { style: 'currency', currency: asmuo.istatinisKapitalas.valiuta })}</span>
                <span class="text-muted text-xs">({asmuo.istatinisKapitalas.data})</span>
              </dd>
            </>}

            {asmuo.jadis && Object.keys(asmuo.jadis).length > 0 && (() => {
              const j = asmuo.jadis;
              return <>
                <dt>Dalyviai</dt>
                <dd>
                  <div class="flex flex-col gap-1">
                    {j.lrFiziniai > 0 && <span>{j.lrFiziniai} asmuo(-enys) — fiziniai (LT)</span>}
                    {j.lrJuridiniai > 0 && <span>{j.lrJuridiniai} asmuo(-enys) — juridiniai (LT)</span>}
                    {j.uzsienioFiziniai > 0 && <span>{j.uzsienioFiziniai} asmuo(-enys) — fiziniai (užsienis)</span>}
                    {j.uzsienioJuridiniai > 0 && <span>{j.uzsienioJuridiniai} asmuo(-enys) — juridiniai (užsienis)</span>}
                  </div>
                </dd>
              </>;
            })()}
          </dl>
        </div>

        {asmuo.jar.location && (
          <div id="asmuo-map" class="map-container h-full min-h-70 col-[span_2]"
            data-x={asmuo.jar.location[1]} data-y={asmuo.jar.location[0]}>
          </div>
        )}
      </div>

      <div class="grid-3 mb-10">
        <div class="card">
          <div class="card-body">
            <div class="section-title mb-3">Darbuotojai</div>
            {asmuo.sodra?.draustieji != null ? (
              <dl class="kv-list">
                <dt>Darbo sutartys</dt><dd><span class="cell-mono">{asmuo.sodra.draustieji}</span></dd>
                <dt>Autorinės ir kitos</dt><dd><span class="cell-mono">{asmuo.sodra.draustieji2 || 0}</span></dd>
                <dt>Viso</dt><dd><span class="cell-mono font-bold">{asmuo.sodra.draustieji + (asmuo.sodra.draustieji2 || 0)}</span></dd>
              </dl>
            ) : <em class="text-muted">Nėra duomenų</em>}
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="section-title mb-3">Vid. atlyginimai</div>
            {asmuo.sodra?.vidutinisAtlyginimas ? (
              <dl class="kv-list">
                <dt>Darbo sutartys</dt><dd><span class="cell-mono">{asmuo.sodra.vidutinisAtlyginimas.toLocaleString('lt-LT', {minimumFractionDigits:2,maximumFractionDigits:2})} €/mėn.</span></dd>
                <dt>Autorinės ir kitos</dt>
                <dd>{asmuo.sodra.vidutinisAtlyginimas2
                  ? <span class="cell-mono">{asmuo.sodra.vidutinisAtlyginimas2.toLocaleString('lt-LT', {minimumFractionDigits:2,maximumFractionDigits:2})} €/mėn.</span>
                  : <em class="text-muted">Nėra duomenų</em>}
                </dd>
                <dt>Bendrai</dt><dd><span class="cell-mono font-bold">{asmuo.sodra.bendrasVidutinisAtlyginimas.toLocaleString('lt-LT', {minimumFractionDigits:2,maximumFractionDigits:2})} €/mėn.</span></dd>
              </dl>
            ) : <em class="text-muted">Nėra duomenų</em>}
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="section-title mb-3">Mokėjimai</div>
            <dl class="kv-list">
              <dt>Mokesčiai (VMI)</dt>
              <dd>{asmuo.mokesciai?.suma
                ? <><span class="cell-mono">{asmuo.mokesciai.suma.toLocaleString('lt-LT', {minimumFractionDigits:2,maximumFractionDigits:2})} €</span> <span class="text-muted text-xs">({asmuo.mokesciai.data})</span></>
                : <em class="text-muted">Nėra duomenų</em>}
              </dd>
              <dt>Atlyginimai</dt>
              <dd>{asmuo.sodra?.atlyginimuIslaidos
                ? <span class="cell-mono">{asmuo.sodra.atlyginimuIslaidos.toLocaleString('lt-LT', {minimumFractionDigits:2,maximumFractionDigits:2})} €/mėn.</span>
                : <em class="text-muted">Nėra duomenų</em>}
              </dd>
              <dt>SODRA įmokos</dt>
              <dd>{asmuo.sodra?.imokuSuma
                ? <span class="cell-mono">{asmuo.sodra.imokuSuma.toLocaleString('lt-LT', {minimumFractionDigits:2,maximumFractionDigits:2})} €</span>
                : <em class="text-muted">Nėra duomenų</em>}
              </dd>
            </dl>
          </div>
        </div>
      </div>

      {asmuo.sodra?.duomenys?.length > 0 && (
        <script is:inline define:vars={{ sodraLabels: JSON.parse(sodraLabels) }}>
          window._sodraLabels = sodraLabels;
        </script>
      )}

      <VidutinisDarboUzmokestis asmuo={asmuo} />
      <DarbuotojuSkaicius asmuo={asmuo} />
      <Imokos asmuo={asmuo} />
      <Sutartys asmuo={asmuo} />
      <MvpAprasai asmuo={asmuo} mvpAprasaiLimit={mvpAprasaiLimit} />

      <div class="grid-2 mb-10">
        <Melagiai asmuo={asmuo} />
        <Nepatikimi asmuo={asmuo} />
      </div>

      <FinansinesAtaskaitos asmuo={asmuo} finansaiLimit={finansaiLimit} />

      <div class="grid-2 mb-10">
        <DarboSkelbimai asmuo={asmuo} />
        <RcPranesimai asmuo={asmuo} />
        <Domenai asmuo={asmuo} />
        <Kotis asmuo={asmuo} />
        <EsInvesticijos asmuo={asmuo} />
        <VdiPazeidimai asmuo={asmuo} />
      </div>

      <Regitra asmuo={asmuo} />
      <TeismoNuosprendziai asmuo={asmuo} />
      <PinregDeklaracijos asmuo={asmuo} />
    </main>
  </Layout>
  ) : (
  <Layout
    pageTitle="CVP IS netikras asmuo"
    colorScheme={colorScheme}
    font={font}
    customHead={(config as any).customHead}
  >
    <main>
      <div class="page-header">
        <h1 class="mb-0">{juridinioInfo.pavadinimas} <code>{jarKodas}</code></h1>
      </div>
      <div class="flex gap-2 mb-4">
        <a href={`/pirkejas/${jarKodas}`} class="btn btn-outline btn-sm">↗ Pirkimai</a>
        <a href={`/tiekejas/${jarKodas}`} class="btn btn-outline btn-sm">↗ Pardavimai</a>
      </div>
      <p class="text-muted">{juridinioInfo.aprasymas}</p>
    </main>
  </Layout>
)}
