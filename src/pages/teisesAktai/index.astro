---
import Layout from '../../layouts/Layout.astro';
import SearchForm from '@design-system/components/content/SearchForm.astro';
import SearchSuggest from '@design-system/components/content/SearchSuggest.astro';
import TimingWaterfall from '@design-system/components/TimingWaterfall.astro';
import EmptyState from '@design-system/components/EmptyState.astro';
import TaFilters from '../../components/teisesAktai/TaFilters.astro';
import TaResults from '../../components/teisesAktai/TaResults.astro';
import TaFacetModal from '../../components/teisesAktai/TaFacetModal.astro';
import { getColorScheme, getFont } from '../../lib/failai.js';
import { loadTeisesAktaiPage } from '../../lib/teisesAktaiPageData.ts';

const data = await loadTeisesAktaiPage(Astro.url);

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

const { errorMessage, q, mode, filtersProps, resultsProps } = data;
---

<Layout
  pageTitle="Teisės aktų paieška"
  pageDescription="Lietuvos teisės aktų (e-TAR) paieška pagal pavadinimą, turinį, rūšį, priėmusią instituciją ir EUROVOC terminus."
  colorScheme={colorScheme}
  font={font}
>
  <main class="sidebar-main">
    {errorMessage ? (
      <div class="ta-error">
        <SearchForm
          title="Teisės aktų paieška"
          searchValue={q}
          searchPlaceholder="Ieškoti teisės aktų…"
          searchModes={true}
          searchMode={mode}
        />
        <EmptyState message={errorMessage} />
      </div>
    ) : (
      <div class="ta-shell">
        <TaFilters {...filtersProps} />

        <div class="ta-search">
          <SearchForm
            title="Teisės aktų paieška"
            searchValue={q}
            searchPlaceholder="Ieškoti teisės aktų…"
            hideTitle={true}
            searchModes={true}
            searchMode={mode}
          />
        </div>

        <div class="ta-content" id="taContent">
          <div class="ta-loading" aria-hidden="true"><span class="spinner spinner-lg"></span></div>
          <TaResults {...resultsProps} />
        </div>

        <TaFacetModal />
      </div>
    )}
    <SearchSuggest />
    <TimingWaterfall />
  </main>
</Layout>

<style is:global>
  /* Apsauga nuo horizontalaus persiliejimo iš dviejų stulpelių išdėstymo. */
  html:has(main.sidebar-main),
  html:has(main.sidebar-main) body {
    overflow-x: clip;
  }

  /* Paieškos forma turi savo eilutę virš rezultatų (be didelės centruotos
     antraštės) — nuimam hero paraštes, kad juosta užpildytų stulpelį ir
     lygiuotųsi su „Filtrai" juosta. */
  .ta-search #searchForm {
    margin: 0 0 24px;
    align-items: stretch;
  }
  .ta-search #searchForm .search-bar {
    max-width: none;
  }

  /* Kraunantis rezultatams režimo perjungiklis tampa inertiškas. */
  .ta-shell:has(.ta-content.is-loading) .search-mode {
    pointer-events: none;
  }
  .ta-shell:has(.ta-content.is-loading) .search-mode-opt::after {
    opacity: 0 !important;
  }
</style>

<style>
  .ta-error { margin-top: 32px; }

  /* Dviejų stulpelių blokas, prisegtas prie kairės: tyli filtrų juosta, tada
     apribotas rezultatų stulpelis. Vidinis padding'as sutampa su įprastu
     puslapio tarpu, kad juosta atsistotų ten, kur prasideda kitų puslapių
     turinys. */
  .ta-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 860px);
    grid-template-areas:
      "sidebar search"
      "sidebar content";
    /* 105px = 24px viršutinis padding'as + 57px paieškos juosta + 24px paraštė. */
    grid-template-rows: 105px auto;
    column-gap: 32px;
    justify-content: start;
    align-items: stretch;
    padding-inline: 16px;
  }

  .ta-search {
    grid-area: search;
    padding-top: 24px;
  }

  .ta-content {
    grid-area: content;
    min-width: 0;
    position: relative;
  }

  /* Krovimo šydas: kiekvienas filtro / puslapio paspaudimas yra pilna kelionė į
     serverį, tad prigesinam esamus rezultatus ir parodom suktuką. */
  .ta-loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 80px;
    background: color-mix(in oklab, var(--white) 70%, transparent);
    backdrop-filter: blur(1px);
    /* Tik vizualus šydas — paspaudimų neryja, kad filtrai liktų naudojami. */
    pointer-events: none;
  }
  .ta-content.is-loading .ta-loading { display: flex; }
  @media (prefers-reduced-motion: reduce) {
    .ta-loading .spinner { animation-duration: 1.4s; }
  }

  @media (max-width: 900px) {
    .ta-shell {
      /* minmax(0, 1fr), ne 1fr: plikas 1fr yra minmax(auto, 1fr), o jo auto
         minimumas išaugtų iki plačiausio vaiko ir išstumtų puslapį už ekrano. */
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "sidebar"
        "search"
        "content";
      grid-template-rows: auto;
      column-gap: 0;
    }
    .ta-search { padding-top: 16px; }
  }
</style>
