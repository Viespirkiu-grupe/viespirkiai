---
// @ts-nocheck — page mixes streamed exports, dynamic search-param maps, and
// nullable totals; gradual typing can be done once the search modules expose
// proper type definitions.
import Layout from '../../layouts/Layout.astro';
import Button from '@design-system/components/Button.astro';
import ResultPageShell from '@design-system/components/content/ResultPageShell.astro';
import ViesiejiPirkimaiFilters from '../../components/content/ViesiejiPirkimaiFilters.astro';
import ViesiejiPirkimaiCard from '../../components/viesiejiPirkimai/ViesiejiPirkimaiCard.astro';
import DokFacetSection from '../../components/dokumentai/DokFacetSection.astro';
import ViesiejiPirkimaiFacetModal from '../../components/viesiejiPirkimai/ViesiejiPirkimaiFacetModal.astro';
import ViesiejiPirkimaiBvpzModal from '../../components/viesiejiPirkimai/ViesiejiPirkimaiBvpzModal.astro';
import PirkimasVerteFilter from '../../components/viesiejiPirkimai/PirkimasVerteFilter.astro';
import PirkimasLaikotarpisFilter from '../../components/viesiejiPirkimai/PirkimasLaikotarpisFilter.astro';
import { splitFacetOptions } from '../../lib/dokumentaiUrl.ts';
import { searchViesiejiPirkimai, countViesiejiPirkimai } from '@/modules/viesiejiPirkimai/searchViesiejiPirkimai.js';
import { STATUSAS, PIRKIMO_BUDAS } from '@/modules/viesiejiPirkimai/viesiejiPirkimaiEnums.js';
import { linksniuoti, linksniuotiK } from '@/utils/linksniai.js';
import config from '../../lib/config.ts';
import { objectsToCsvStream } from '@/utils/csv.js';
import { objectsToJsonlStream } from '@/utils/jsonl.js';
import { Transform } from 'node:stream';
import { Readable } from 'node:stream';
import { cleanQuery, getColorScheme, getFont } from '../../lib/failai.js';

const DEFAULT_LIMIT = 50;
const MAX_POSTGRES_LIMIT = 1_000_000;

const cleaned = cleanQuery(Astro.url);
if (cleaned.redirectTo) return Astro.redirect(cleaned.redirectTo);
const query = cleaned.query;
// Rikiavimo <select> koduoja lauką ir kryptį viename `sort` parametre
// (`laukas:kryptis`, pvz. `numatomaBendraPirkimoVerte:asc`). Išskaidom.
if (query.sort?.includes(':')) {
  const [field, dir] = query.sort.split(':');
  query.sort = field;
  if (dir) query.sortDir = dir;
}

// Quickwit variklis naudojamas visada, kai pakelta (kaip anksčiau). Facetai
// grąžinami tik tada, kai Quickwit šaka aktyvi.
const engine = 'quickwit';
const withFacets = !!config.quickwitUp;

function parseLimit(q: Record<string, string>) {
  if (q.limit === 'max') return { limit: MAX_POSTGRES_LIMIT };
  const n = parseInt(q.limit);
  if (n > MAX_POSTGRES_LIMIT) return { error: `Limitas per didelis. Maksimalus limitas yra ${MAX_POSTGRES_LIMIT} rezultatų puslapyje.` };
  if (n > 0) return { limit: n };
  return { limit: DEFAULT_LIMIT };
}

const parsedLimit = parseLimit(query);
if ('error' in parsedLimit) {
  return new Response(parsedLimit.error, { status: 400 });
}
const { limit } = parsedLimit;
const page = parseInt(query.page) || 1;

type Timing = { label: string; start: number; duration: number; phase?: string };

function buildNumberOfResults({ shown, total, elapsed, timings }: { shown: number; total: number | null; elapsed: number; timings?: Timing[] | null }) {
  const trukme = (elapsed / 1000).toFixed(2) + 's';
  const timingsAttr = timings && timings.length ? ` data-timings='${JSON.stringify(timings).replace(/'/g, '&#39;')}'` : '';
  const source = `<span class="inline timing-source"${timingsAttr}>(${trukme}, ${engine})</span>`;
  if (total == null) {
    return {
      numberOfResults: `Rodomi ${shown} iš <span class="rezultatai-nezinomas-total"> ? </span> rezultatų <span class="inline timing-source"${timingsAttr}> (${trukme}, ${engine})</span>`,
      total: 10_000,
    };
  }
  if (shown < total)
    return {
      numberOfResults: `Rodomi ${shown} iš ${linksniuotiK(total, ['rezultato', 'rezultatų'])} ${source}`,
      total,
    };
  return {
    numberOfResults: `${linksniuoti(total, ['rezultatas', 'rezultatai', 'rezultatų'])} ${source}`,
    total,
  };
}

async function timed<T>(promise: Promise<T>): Promise<{ value: T; ms: number }> {
  const t0 = performance.now();
  const value = await promise;
  return { value, ms: Math.round(performance.now() - t0) };
}

const CSV_HEADERS = ['Pirkimo ID','Pavadinimas','Vykdytojas','Paskelbimo data','Pasiūlymų terminas','Pirkimo būdas','Statusas','Žingsnis','Numatoma vertė','Tipas'];
void CSV_HEADERS;

function resultToCsvObject(r: any) {
  const fmt = (v: any) => (v ? String(v).slice(0, 10) : '');
  return {
    'Pirkimo ID': r.pirkimoId,
    'Pavadinimas': r.pavadinimas,
    'Vykdytojas': r.pirkimoVykdytojas,
    'Paskelbimo data': fmt(r.paskelbimoData),
    'Pasiūlymų terminas': r.pasiulymuPateikimoTerminas ? String(r.pasiulymuPateikimoTerminas).slice(0, 16).replace('T', ' ') : '',
    'Pirkimo būdas': r.pirkimoBudas,
    'Statusas': r.statusas,
    'Žingsnis': r.zingsnis,
    'Numatoma vertė': r.numatomaBendraPirkimoVerte ?? '',
    'Tipas': r.type,
  };
}

if (query.csv || query.jsonl) {
  const { stream, client } = await searchViesiejiPirkimai(query, { limit: null, page, stream: true, sort: false });

  if (query.jsonl) {
    const web = Readable.toWeb(stream.pipe(objectsToJsonlStream())) as unknown as BodyInit;
    client?.release();
    return new Response(web, {
      headers: {
        'Content-Type': 'application/x-ndjson',
        'Content-Disposition': `attachment; filename=viesieji-pirkimai-${new Date().toISOString()}.jsonl`,
      },
    });
  }

  if (query.csv) {
    const csvStream = stream
      .pipe(new Transform({ objectMode: true, transform(row, _enc, cb) { cb(null, resultToCsvObject(row)); } }))
      .pipe(objectsToCsvStream());
    const web = Readable.toWeb(csvStream) as unknown as BodyInit;
    client?.release();
    return new Response(web, {
      headers: {
        'Content-Type': 'text/csv',
        'Content-Disposition': `attachment; filename=viesieji-pirkimai-${new Date().toISOString()}.csv`,
      },
    });
  }
}

if (query.rezultatuSkaiciausPatikslinimas) {
  const startas = performance.now();
  const [countRes, searchRes] = await Promise.all([
    timed(countViesiejiPirkimai(query)),
    timed(searchViesiejiPirkimai(query, { limit: 1, page, engine })),
  ]);
  const total = countRes.value;
  const elapsed = performance.now() - startas + Number(query.trukme || 0);
  const timings: Timing[] = [
    { label: 'Paieška', phase: 'search', start: 0, duration: searchRes.ms },
    { label: 'Skaičius', phase: 'count', start: 0, duration: countRes.ms },
  ];
  const { numberOfResults } = buildNumberOfResults({ shown: limit, total, elapsed, timings });
  return new Response(JSON.stringify({ total, numberOfResults }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

if (query.json) {
  const { results } = await searchViesiejiPirkimai(query, { limit, page, engine });
  return new Response(JSON.stringify({ results }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

const startas = performance.now();
const searchTimed = await timed(searchViesiejiPirkimai(query, { limit, page, engine, includeFacets: withFacets }));
const { results, total, values, queryParams, facets } = searchTimed.value;
const elapsed = performance.now() - startas + Number(query.trukme || 0);
const initialTimings: Timing[] = searchTimed.value.timings?.length
  ? searchTimed.value.timings
  : [{ label: 'Paieška', phase: 'search', start: 0, duration: searchTimed.ms }];
const { numberOfResults } = buildNumberOfResults({ shown: results.length, total, elapsed, timings: initialTimings });

const galimaEksportuoti = Object.keys(values).length > 0 && (total ?? 0) <= MAX_POSTGRES_LIMIT;
const pageCount = Math.ceil((total || 100_000) / limit);

// ── Facetų atrankos parametrai (gyvena tik URL'e) ────────────────────────────
const FACET_PARAMS = ['pvJarKodas', 'pirkimoBudas', 'statusas', 'bvpzPrefiksai'];
const facetSep = (param: string) => (param === 'bvpzPrefiksai' ? ' ' : ',');
const splitFacet = (param: string, raw: string) =>
  raw.split(facetSep(param)).map((s) => s.trim()).filter(Boolean);
const facetSelected: Record<string, string[]> = Object.fromEntries(
  FACET_PARAMS.map((k) => [k, splitFacet(k, Astro.url.searchParams.get(k) ?? '')]),
);

const FILTER_KEYS = [
  'pvJarKodas', 'pirkimoBudas', 'statusas', 'bvpzPrefiksai',
  'verteNuo', 'verteIki', 'paskelbimoDataNuo', 'paskelbimoDataIki',
  'pirkimoId',
];
const activeFilterCount = FILTER_KEYS.filter((k) => (Astro.url.searchParams.get(k) ?? '').trim() !== '').length;

function facetToggleUrl(param: string, value: string): string {
  const p = new URLSearchParams(Astro.url.search);
  const sep = facetSep(param);
  const cur = splitFacet(param, p.get(param) ?? '');
  let next: string[];
  if (value === '') next = [];
  else if (cur.includes(value)) next = cur.filter((v) => v !== value);
  else next = [...cur, value];
  if (next.length) p.set(param, next.join(sep));
  else p.delete(param);
  p.delete('page');
  const s = p.toString();
  return s ? `/viesiejiPirkimai/?${s}` : '/viesiejiPirkimai/';
}

function mkFacet(param: string, options: any[], limit = 8) {
  const sel = facetSelected[param] ?? [];
  const { visible, hidden } = splitFacetOptions(options, sel, limit);
  return { filter: sel, visible, hidden, toggleUrl: (v: string) => facetToggleUrl(param, v) };
}

// Rikiavimas: kiekviena parinktis koduoja lauką ir kryptį (`laukas:kryptis`).
// Numatytoji (naujausiai paskelbti) — tuščia reikšmė.
const sortOptions = [
  { value: '', label: 'Naujausiai paskelbti' },
  { value: 'paskelbimoData:asc', label: 'Seniausiai paskelbti' },
  { value: 'pasiulymuPateikimoTerminas:desc', label: 'Vėliausias terminas' },
  { value: 'pasiulymuPateikimoTerminas:asc', label: 'Anksčiausias terminas' },
  { value: 'numatomaBendraPirkimoVerte:desc', label: 'Didžiausia vertė' },
  { value: 'numatomaBendraPirkimoVerte:asc', label: 'Mažiausia vertė' },
];
const sortValue = values.sort
  ? (values.sort === 'paskelbimoData' && (values.sortDir ?? 'desc') === 'desc'
      ? ''
      : `${values.sort}:${values.sortDir ?? 'desc'}`)
  : '';

const colorScheme = getColorScheme(Astro.cookies);
const font = getFont(Astro.cookies);

Astro.response.headers.set('Cache-Control', 'private, max-age=10');
---

<Layout
  pageTitle="Viešųjų pirkimų paieška"
  pageDescription="Pilietinė viešųjų pirkimų analizės iniciatyva. Prieinamai patiekiami viešieji pirkimai bei kita susijusi informacija."
  pageImage="https://viespirkiai.org/viesiejiPirkimai.png"
  colorScheme={colorScheme}
  font={font}
>
  <main class="sut-main sidebar-main">
    <form method="get" role="search" id="searchForm" class="searchform-sidebar">
      <h1 class="sr-only">Viešųjų pirkimų paieška</h1>

      {/* Facetų atranka gyvena tik URL'e (ne formos laukuose). Kad rikiavimo
          keitimas ar „Ieškoti" jos neprarastų, perduodam paslėptais laukais. */}
      {facets && FACET_PARAMS.map((k) => {
        const v = Astro.url.searchParams.get(k);
        return v ? <input type="hidden" name={k} value={v} /> : null;
      })}

      <aside class="sf-rail" aria-label="Filtrai">
        <div class="sf-rail-head">
          <button type="button" class="sf-rail-toggle" id="sfFiltersToggle" aria-expanded="false" aria-controls="sfRailBody">
            <span class="sf-rail-toggle-label">Filtrai</span>
            {activeFilterCount > 0 && <span class="sf-filters-count">{activeFilterCount}</span>}
            <span class="sf-filters-chevron" aria-hidden="true"></span>
          </button>
        </div>
        <div class="sf-rail-body" id="sfRailBody">
          {facets && (
            <div class="vp-facets">
              <DokFacetSection
                label="Vykdytojas"
                param="pvJarKodas"
                facet={mkFacet('pvJarKodas', facets.vykdytojai, 5)}
                allLabel="Visi"
                stacked
                modal={{ field: 'jarKodas', title: 'Vykdytojas', always: true }}
              />
              <DokFacetSection label="Statusas" param="statusas" facet={mkFacet('statusas', facets.statusas, 6)} allLabel="Visi" formatLabel={(v) => STATUSAS[v] ?? v} />
              <DokFacetSection label="Pirkimo būdas" param="pirkimoBudas" facet={mkFacet('pirkimoBudas', facets.pirkimoBudas, 6)} allLabel="Visi" formatLabel={(v) => PIRKIMO_BUDAS[v] ?? v} />
              <PirkimasLaikotarpisFilter hist={facets.laikotarpis} dataNuo={values.paskelbimoDataNuo as string | undefined} dataIki={values.paskelbimoDataIki as string | undefined} />
              <PirkimasVerteFilter hist={facets.verte} verteNuo={values.verteNuo as string | undefined} verteIki={values.verteIki as string | undefined} />
              <DokFacetSection label="BVPŽ" param="bvpzPrefiksai" facet={mkFacet('bvpzPrefiksai', facets.bvpz, 8)} allLabel="Visi" stacked modal={{ field: 'bvpzKodai', title: 'BVPŽ klasifikacija', always: true }} />
            </div>
          )}
          <ViesiejiPirkimaiFilters values={values} rail={true} hideParticipants={!!facets} />
          <button type="submit" class="sf-rail-search">Ieškoti</button>
        </div>
      </aside>

      <div class="sf-search">
        <div class="search-bar">
          <label for="search">
            <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
            </svg>
            <span class="sr-only">Paieška</span>
          </label>
          <input
            type="search"
            name="search"
            id="search"
            class="search-bar__input"
            value={values.search as string | undefined}
            placeholder="Tekstinė paieška"
            enterkeyhint="search"
          />
          <Button type="submit">Ieškoti</Button>
        </div>
      </div>

      <div class="sf-results">
        <ResultPageShell
          numberOfResults={numberOfResults}
          resultCount={results.length}
          page={page}
          pageCount={pageCount}
          queryParams={queryParams}
          containerClass="mt-0"
          flat={true}
        >
          {sortOptions.length > 0 && (
            <Fragment slot="sort">
              <label class="sr-only" for="vpSort">Rikiuoti pagal</label>
              <select id="vpSort" name="sort" data-autosubmit aria-label="Rikiuoti pagal">
                {sortOptions.map((option) => (
                  <option value={option.value} selected={sortValue === option.value}>{option.label}</option>
                ))}
              </select>
            </Fragment>
          )}

          {galimaEksportuoti && (
            <Fragment slot="actions">
              <a href={`/viesiejiPirkimai/?${queryParams}&jsonl=true&limit=max`} class="btn btn-outline btn-sm" aria-label="Eksportuoti kaip JSONL">
                <span aria-hidden="true">↗</span> JSONL
              </a>
              <a href={`/viesiejiPirkimai/?${queryParams}&csv=true&limit=max`} class="btn btn-outline btn-sm" aria-label="Eksportuoti kaip CSV">
                <span aria-hidden="true">↗</span> CSV
              </a>
            </Fragment>
          )}

          {results.map((item: any) => <ViesiejiPirkimaiCard item={item} />)}
        </ResultPageShell>
      </div>
    </form>
    {facets && <ViesiejiPirkimaiFacetModal />}
    {facets && <ViesiejiPirkimaiBvpzModal />}
  </main>
</Layout>

<style>
  /* Pirmoji facetų sekcija be viršutinio tarpo. */
  .vp-facets :global(.dok-filter-section:first-child) {
    padding-top: 0;
  }
  /* Tarpas tarp Quickwit facetų ir tikslių įvesties filtrų apačioje. */
  .vp-facets + :global(.ds-filter-panel--rail) {
    margin-top: 24px;
  }
</style>

<script is:inline>
  // „Rodyti daugiau" inline atskleidimas facetams be dialogo (pirkimo būdas/
  // statusas/tipas). Vykdytojo/BVPŽ „Daugiau" atidaro dialogą (žr. modalus).
  document.querySelectorAll('.vp-facets .dok-more-btn').forEach((btn) => {
    if (btn.dataset.facetModal) return; // šiuos tvarko dialogas
    btn.addEventListener('click', () => {
      const more = btn.previousElementSibling;
      if (more && more.classList.contains('dok-more-list')) {
        more.hidden = false;
        btn.remove();
      }
    });
  });

  // Mobilus filtrų perjungiklis.
  const sfToggle = document.getElementById('sfFiltersToggle');
  const sfRail = document.querySelector('.sf-rail');
  sfToggle?.addEventListener('click', () => {
    const open = sfRail?.classList.toggle('is-open') ?? false;
    sfToggle.setAttribute('aria-expanded', String(open));
  });

  // Rikiavimo select priklauso #searchForm — keitimas iš naujo paleidžia paiešką
  // (nunulinam puslapį).
  document.querySelectorAll('select[data-autosubmit]').forEach((select) => {
    select.addEventListener('change', () => {
      const form = select.form;
      if (!form) return;
      form.querySelector('input[name="page"]')?.remove();
      form.requestSubmit();
    });
  });

  // Nežinomo bendro skaičiaus patikslinimas (kaip anksčiau).
  const span = document.querySelector('.rezultatai-nezinomas-total');
  if (span && !span.classList.contains('spin')) {
    span.classList.add('spin');
    const url = new URL(window.location.href);
    url.searchParams.set('rezultatuSkaiciausPatikslinimas', 'true');
    fetch(url.toString())
      .then((res) => res.json())
      .then((data) => {
        if (data.total !== undefined) {
          span.className = '';
          const el = document.querySelector('.numberOfResults');
          if (el) el.innerHTML = data.numberOfResults;
        } else {
          span.classList.remove('spin');
        }
      })
      .catch(() => span.classList.remove('spin'));
  }
</script>

<script>
  // Telefone (≤900px) šoninės juostos facetai kaupiami formoje, o pritaikomi per
  // „Ieškoti" (žr. mobileFilterBatch). Darbastalyje nuorodos veikia įprastai.
  import { initRailFacetBatch } from '@/src/lib/mobileFilterBatch';
  initRailFacetBatch('.vp-facets', (p) => (p === 'bvpzPrefiksai' ? ' ' : ','));
</script>
