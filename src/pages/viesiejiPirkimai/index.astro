---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import TextInput from '../../components/inputs/TextInput.astro';
import DateInput from '../../components/inputs/DateInput.astro';
import NumberInput from '../../components/inputs/NumberInput.astro';
import SortToggle from '../../components/inputs/SortToggle.astro';
import { searchViesiejiPirkimai, countViesiejiPirkimai } from '@/modules/viesiejiPirkimai/searchViesiejiPirkimai.js';
import { STATUSAS, PIRKIMO_BUDAS } from '@/modules/viesiejiPirkimai/viesiejiPirkimaiEnums.js';
import { linksniuoti, linksniuotiK } from '@/utils/linksniai.js';
import { objectsToCsvStream } from '@/utils/csv.js';
import { objectsToJsonlStream } from '@/utils/jsonl.js';
import { Transform } from 'node:stream';
import { Readable } from 'node:stream';

const DEFAULT_LIMIT = 50;
const MAX_POSTGRES_LIMIT = 1_000_000;

const url = Astro.url;
const rawQuery = Object.fromEntries(url.searchParams);
const cleaned: Record<string, string> = {};
let hasEmpty = false;
for (const [key, value] of Object.entries(rawQuery)) {
  if (value !== '') cleaned[key] = value;
  else hasEmpty = true;
}
if (hasEmpty) {
  const qs = new URLSearchParams(cleaned).toString();
  return Astro.redirect(url.pathname + (qs ? `?${qs}` : ''));
}

const query = cleaned;

function parseLimit(q: Record<string, string>) {
  if (q.limit === 'max') return { limit: MAX_POSTGRES_LIMIT };
  const n = parseInt(q.limit);
  if (n > MAX_POSTGRES_LIMIT) return { error: `Limitas per didelis. Maksimalus limitas yra ${MAX_POSTGRES_LIMIT} rezultatų puslapyje.` };
  if (n > 0) return { limit: n };
  return { limit: DEFAULT_LIMIT };
}

const parsedLimit = parseLimit(query);
if ('error' in parsedLimit) {
  return new Response(parsedLimit.error, { status: 400 });
}
const { limit } = parsedLimit;
const page = parseInt(query.page) || 1;

function buildNumberOfResults({ shown, total, elapsed }: { shown: number; total: number | null; elapsed: number }) {
  const trukme = (elapsed / 1000).toFixed(2) + 's';
  const source = `<span class="inline">(${trukme}, postgres)</span>`;
  if (total == null) {
    return {
      numberOfResults: `Rodomi ${shown} iš <span class="rezultatai-nezinomas-total"> ? </span> rezultatų <span class="inline"> (${trukme}, postgres)</span>`,
      total: 10_000,
    };
  }
  if (shown < total)
    return {
      numberOfResults: `Rodomi ${shown} iš ${linksniuotiK(total, ['rezultato', 'rezultatų'])} ${source}`,
      total,
    };
  return {
    numberOfResults: `${linksniuoti(total, ['rezultatas', 'rezultatai', 'rezultatų'])} ${source}`,
    total,
  };
}

const CSV_HEADERS = ['Pirkimo ID','Pavadinimas','Vykdytojas','Paskelbimo data','Pasiūlymų terminas','Pirkimo būdas','Statusas','Žingsnis','Numatoma vertė','Tipas'];

function resultToCsvObject(r: any) {
  const fmt = (v: any) => (v ? String(v).slice(0, 10) : '');
  return {
    'Pirkimo ID': r.pirkimoId,
    'Pavadinimas': r.pavadinimas,
    'Vykdytojas': r.pirkimoVykdytojas,
    'Paskelbimo data': fmt(r.paskelbimoData),
    'Pasiūlymų terminas': r.pasiulymuPateikimoTerminas ? String(r.pasiulymuPateikimoTerminas).slice(0, 16).replace('T', ' ') : '',
    'Pirkimo būdas': r.pirkimoBudas,
    'Statusas': r.statusas,
    'Žingsnis': r.zingsnis,
    'Numatoma vertė': r.numatomaBendraPirkimoVerte ?? '',
    'Tipas': r.type,
  };
}

if (query.csv || query.jsonl) {
  const { stream, client } = await searchViesiejiPirkimai(query, { limit: null, page, stream: true, sort: false });

  if (query.jsonl) {
    const web = Readable.toWeb(stream.pipe(objectsToJsonlStream())) as unknown as BodyInit;
    client?.release();
    return new Response(web, {
      headers: {
        'Content-Type': 'application/x-ndjson',
        'Content-Disposition': `attachment; filename=viesieji-pirkimai-${new Date().toISOString()}.jsonl`,
      },
    });
  }

  if (query.csv) {
    const csvStream = stream
      .pipe(new Transform({ objectMode: true, transform(row, _enc, cb) { cb(null, resultToCsvObject(row)); } }))
      .pipe(objectsToCsvStream());
    const web = Readable.toWeb(csvStream) as unknown as BodyInit;
    client?.release();
    return new Response(web, {
      headers: {
        'Content-Type': 'text/csv',
        'Content-Disposition': `attachment; filename=viesieji-pirkimai-${new Date().toISOString()}.csv`,
      },
    });
  }
}

if (query.rezultatuSkaiciausPatikslinimas) {
  const startas = performance.now();
  const [total, { values, queryParams }] = await Promise.all([
    countViesiejiPirkimai(query),
    searchViesiejiPirkimai(query, { limit: 1, page }),
  ]);
  const elapsed = performance.now() - startas + Number(query.trukme || 0);
  const { numberOfResults } = buildNumberOfResults({ shown: limit, total, elapsed });
  return new Response(JSON.stringify({ total, numberOfResults }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

if (query.json) {
  const { results } = await searchViesiejiPirkimai(query, { limit, page });
  return new Response(JSON.stringify({ results }), {
    headers: { 'Content-Type': 'application/json' },
  });
}

const startas = performance.now();
const { results, total, values, queryParams } = await searchViesiejiPirkimai(query, { limit, page });
const elapsed = performance.now() - startas + Number(query.trukme || 0);
const { numberOfResults } = buildNumberOfResults({ shown: results.length, total, elapsed });

const galimaEksportuoti = Object.keys(values).length > 0 && (total ?? 0) <= MAX_POSTGRES_LIMIT;
const usedHiddenFields = Object.keys(values).some(k => k !== 'search' && values[k] !== '' && values[k] !== undefined);
const pageCount = Math.ceil((total || 100_000) / limit);

const colorScheme = Astro.cookies.get('colorScheme')?.value || 'auto';
const font = Astro.cookies.get('font')?.value || 'ubuntu';
---

<Layout
  pageTitle="Viešųjų pirkimų paieška"
  pageDescription="Pilietinė viešųjų pirkimų analizės iniciatyva. Prieinamai patiekiami viešieji pirkimai bei kita susijusi informacija."
  pageImage="https://viespirkiai.org/viesiejiPirkimai.png"
  colorScheme={colorScheme}
  font={font}
>
  <main>
    <form method="get" role="search" id="searchForm">
      <h1 class="mt-7">Viešųjų pirkimų paieška <sup class="top-[-0.75em]">BETA</sup></h1>

      <div class="search-bar">
        <label for="search">
          <svg class="search-icon" aria-hidden="true" width="20" height="20" viewBox="0 1 24 23" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.502 2C5.80753 2 2.00195 5.80558 2.00195 10.5C2.00195 15.1944 5.80753 19 10.502 19C12.4884 19 14.3169 18.3176 15.7637 17.176L20.5877 22C20.9783 22.3905 21.6114 22.3905 22.002 22C22.3925 21.6095 22.3925 20.9763 22.002 20.5858L17.1779 15.7618C18.3196 14.3149 19.002 12.4865 19.002 10.5C19.002 5.80558 15.1964 2 10.502 2ZM4.00195 10.5C4.00195 6.91015 6.9121 4 10.502 4C14.0918 4 17.002 6.91015 17.002 10.5C17.002 12.2952 16.2755 13.9188 15.0981 15.0962C13.9208 16.2736 12.2972 17 10.502 17C6.9121 17 4.00195 14.0899 4.00195 10.5Z" fill="currentColor"/>
          </svg>
          <span class="sr-only">Paieška</span>
        </label>

        <input type="search" name="search" id="search" class="search-bar__input"
          value={values.search || ''}
          placeholder="Tekstinė paieška"
          enterkeyhint="search"
        />

        <label class="btn btn-ghost btn-icon" title="Filtrai" aria-label={usedHiddenFields ? 'Slėpti filtrus' : 'Rodyti filtrus'} aria-expanded={usedHiddenFields ? 'true' : 'false'} aria-controls="searchNustatymai">
          <input type="checkbox" id="searchNustatymaiToggle" class="sr-only" checked={usedHiddenFields} />
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M11.9999 3C11.4476 3 10.9999 3.44772 10.9999 4V6.17072C9.83476 6.58259 9 7.6938 9 8.99998C9 10.3062 9.83476 11.4174 10.9999 11.8292L10.9999 20C10.9999 20.5523 11.4476 21 11.9999 21C12.5522 21 12.9999 20.5523 12.9999 20V11.8293C14.1651 11.4175 15 10.3062 15 8.99998C15 7.69373 14.1651 6.58246 12.9999 6.17066V4C12.9999 3.44772 12.5522 3 11.9999 3ZM12 7.99998C11.4477 7.99998 11 8.4477 11 8.99998C11 9.55227 11.4477 9.99998 12 9.99998C12.5523 9.99998 13 9.55227 13 8.99998C13 8.4477 12.5523 7.99998 12 7.99998Z" fill="currentColor"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M17.9999 20C17.9999 20.5523 18.4476 21 18.9999 21C19.5522 21 19.9999 20.5523 19.9999 20V17.8293C21.1651 17.4175 22 16.3062 22 15C22 13.6937 21.1651 12.5825 19.9999 12.1707V4C19.9999 3.44772 19.5522 3 18.9999 3C18.4476 3 17.9999 3.44772 17.9999 4V12.1707C16.8348 12.5826 16 13.6938 16 15C16 16.3062 16.8348 17.4174 17.9999 17.8292V20ZM19 14C18.4477 14 18 14.4477 18 15C18 15.5523 18.4477 16 19 16C19.5523 16 20 15.5523 20 15C20 14.4477 19.5523 14 19 14Z" fill="currentColor"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M3.9999 20C3.9999 20.5523 4.44762 21 4.9999 21C5.55219 21 5.9999 20.5523 5.9999 20V17.8293C7.16515 17.4175 8 16.3062 8 15C8 13.6937 7.16515 12.5825 5.9999 12.1707L5.9999 4C5.9999 3.44772 5.55219 3 4.9999 3C4.44762 3 3.9999 3.44772 3.9999 4L3.9999 12.1707C2.83476 12.5826 2 13.6938 2 15C2 16.3062 2.83476 17.4174 3.9999 17.8292L3.9999 20ZM5 14C4.44772 14 4 14.4477 4 15C4 15.5523 4.44772 16 5 16C5.55229 16 6 15.5523 6 15C6 14.4477 5.55229 14 5 14Z" fill="currentColor"/>
          </svg>
        </label>

        <button type="submit" class="btn btn-primary">Ieškoti</button>
      </div>

      <div id="searchNustatymai" class="search-filters" aria-hidden={!usedHiddenFields ? 'true' : 'false'} inert={!usedHiddenFields ? true : undefined}>
        <div class="search-filters-inner">
          <div class="search-filters-grid">

            <fieldset class="filter-group">
              <legend class="filter-group-label">Pirkimas</legend>
              <TextInput label="Vykdytojo kodas" name="pvJarKodas" placeholder="Nenurodyta" values={values} />
              <TextInput label="Pirkimo ID" name="pirkimoId" placeholder="Nenurodyta" values={values} />
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Paskelbimo data</legend>
              <DateInput label="Paskelbta nuo" name="paskelbimoDataNuo" values={values} />
              <DateInput label="Paskelbta iki" name="paskelbimoDataIki" values={values} />
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Pasiūlymų terminas</legend>
              <DateInput label="Terminas nuo" name="pasiulymuTerminasNuo" values={values} />
              <DateInput label="Terminas iki" name="pasiulymuTerminasIki" values={values} />
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Numatoma vertė</legend>
              <NumberInput label="Numatoma vertė nuo" name="verteNuo" placeholder="0 €" values={values} />
              <NumberInput label="Numatoma vertė iki" name="verteIki" placeholder="∞ €" values={values} />
            </fieldset>

            <fieldset class="filter-group">
              <legend class="filter-group-label">Klasifikacija</legend>
              <div class="form-group">
                <label class="form-label" for="pirkimoBudas">Pirkimo būdas</label>
                <select name="pirkimoBudas" id="pirkimoBudas" class="form-control">
                  <option value="" selected={!values['pirkimoBudas']}>Visi</option>
                  {Object.entries(PIRKIMO_BUDAS).map(([key, label]) => (
                    <option value={key} selected={values['pirkimoBudas'] === key}>{label as string}</option>
                  ))}
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="statusas">Statusas</label>
                <select name="statusas" id="statusas" class="form-control">
                  <option value="" selected={!values['statusas']}>Visi</option>
                  {Object.entries(STATUSAS).map(([key, label]) => (
                    <option value={key} selected={values['statusas'] === key}>{label as string}</option>
                  ))}
                </select>
              </div>
            </fieldset>

            <fieldset class="filter-group justify-start">
              <legend class="filter-group-label">Rikiavimas</legend>
              <div class="form-group">
                <label class="form-label" for="sort">Rikiuoti pagal</label>
                <div class="input-group">
                  <select name="sort" id="sort" class="form-control">
                    {[
                      { value: 'paskelbimoData', label: 'Paskelbimo data' },
                      { value: 'pasiulymuPateikimoTerminas', label: 'Pasiūlymų terminas' },
                      { value: 'numatomaBendraPirkimoVerte', label: 'Vertė' },
                    ].map(opt => (
                      <option value={opt.value} selected={(values['sort'] ?? 'paskelbimoData') === opt.value}>{opt.label}</option>
                    ))}
                  </select>
                  <SortToggle fieldName="sortDir" values={values} />
                </div>
              </div>
            </fieldset>

            <fieldset class="filter-group justify-start">
              <legend class="filter-group-label">Kodai</legend>
              <div>
                <TextInput label="BVPŽ prefiksai" name="bvpzPrefiksai" placeholder="Visi" values={values} />
                <a href="/bvpz" class="text-sm">Žr. BVPŽ</a>
              </div>
            </fieldset>

          </div>
        </div>
      </div>

      <script>
        const searchToggle = document.querySelector('label[aria-controls="searchNustatymai"]');
        const filterBox = document.getElementById('searchNustatymai');
        const checkbox = document.getElementById('searchNustatymaiToggle') as HTMLInputElement;

        checkbox.addEventListener('change', function() {
          const isChecked = this.checked;
          searchToggle!.setAttribute('aria-expanded', String(isChecked));
          searchToggle!.setAttribute('aria-label', isChecked ? 'Slėpti filtrus' : 'Rodyti filtrus');
          if (isChecked) {
            filterBox!.removeAttribute('inert');
            filterBox!.setAttribute('aria-hidden', 'false');
            const firstInput = filterBox!.querySelector('input, select') as HTMLElement;
            if (firstInput) firstInput.focus();
          } else {
            filterBox!.setAttribute('inert', '');
            filterBox!.setAttribute('aria-hidden', 'true');
          }
        });

        document.getElementById('search')!.addEventListener('keydown', function(e) {
          if ((e as KeyboardEvent).key === 'Enter') {
            e.preventDefault();
            (this as HTMLInputElement).form!.submit();
          }
        });
      </script>
    </form>

    <div class="mt-10 max-w-lg center mx-auto">
      <div>
        <div class="flex justify-between items-center mb-4">
          <span class="text-muted text-sm numberOfResults" set:html={numberOfResults} />
          {galimaEksportuoti && (
            <div class="flex gap-3">
              <a href={`/viesiejiPirkimai/?${queryParams}&jsonl=true&limit=max`} class="btn btn-outline btn-sm" aria-label="Eksportuoti kaip JSONL">
                <span aria-hidden="true">↗</span> JSONL
              </a>
              <a href={`/viesiejiPirkimai/?${queryParams}&csv=true&limit=max`} class="btn btn-outline btn-sm" aria-label="Eksportuoti kaip CSV">
                <span aria-hidden="true">↗</span> CSV
              </a>
            </div>
          )}
        </div>

        {results.length === 0 ? (
          <div class="empty-state">
            <p class="text-muted">Rezultatų nerasta.</p>
          </div>
        ) : (
          <>
            <div class="result-list">
              {results.map((item: any) => (
                <article class="result-card card-clickable">
                  <div class="result-card-body">
                    <dl class="result-card-meta">
                      {item.statusas && (
                        <div>
                          <dt class="sr-only">Statusas</dt>
                          <dd class={item.statusas === 'Vykdomas' ? 'badge-active' : ''}>{item.statusas}</dd>
                        </div>
                      )}
                      {item.pirkimoBudas && (
                        <div>
                          <dt class="sr-only">Pirkimo būdas</dt>
                          <dd>{item.pirkimoBudas}</dd>
                        </div>
                      )}
                      {item.paskelbimoData && (
                        <div>
                          <dt class="sr-only">Paskelbimo data</dt>
                          <dd>
                            <abbr aria-hidden="true" title="Paskelbimo data" class="relative z-1">Paskelb.</abbr>
                            <time datetime={String(item.paskelbimoData).slice(0, 10)}>{String(item.paskelbimoData).slice(0, 10)}</time>
                          </dd>
                        </div>
                      )}
                    </dl>

                    <div class="flex align-baseline gap-3">
                      <h3 class="result-card-title">
                        {(!item.pavadinimas || item.pavadinimas.length < 1) ? (
                          <em>Nenurodyta</em>
                        ) : (
                          <a href={`/viesiejiPirkimai/${item.pirkimoId}`}>{item.pavadinimas}</a>
                        )}
                      </h3>
                    </div>

                    <div class="result-card-footer">
                      {item.pirkimoVykdytojas && (
                        <span>
                          <strong>Vykdytojas:</strong>
                          {item.pirkimoVykdytojas.slice(0, 80)}{item.pirkimoVykdytojas.length > 80 ? '…' : ''}
                        </span>
                      )}
                      {item.pasiulymuPateikimoTerminas && (
                        <span>
                          <strong>Pasiūlymų terminas:</strong>
                          <time datetime={String(item.pasiulymuPateikimoTerminas).slice(0, 10)}>
                            {String(item.pasiulymuPateikimoTerminas).slice(0, 16).replace('T', ' ')}
                          </time>
                        </span>
                      )}
                      {item.numatomaBendraPirkimoVerte && (
                        <span>
                          <strong>Numatoma vertė:</strong>
                          <span>{Number(item.numatomaBendraPirkimoVerte).toLocaleString('lt-LT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}&nbsp;€</span>
                        </span>
                      )}
                      {item.informacija && item.informacija !== item.pavadinimas && item.informacija}
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <Pagination currentPage={page} pageCount={pageCount} queryParams={queryParams} />
          </>
        )}
      </div>
    </div>

    <script>
      const span = document.querySelector('.rezultatai-nezinomas-total');
      if (span && !span.classList.contains('spin')) {
        span.classList.add('spin');
        const url = new URL(window.location.href);
        url.searchParams.set('rezultatuSkaiciausPatikslinimas', 'true');
        fetch(url.toString())
          .then(res => res.json())
          .then(data => {
            if (data.total) {
              span.className = '';
              document.querySelector('.numberOfResults')!.innerHTML = data.numberOfResults;
            } else {
              span.classList.remove('spin');
            }
          })
          .catch(() => span.classList.remove('spin'));
      }
    </script>
  </main>
</Layout>
