# =====================================================================
# modules/s3backup/.env — nusikopijuokite į `.env` ir užpildykite.
# Tikri aplinkos kintamieji nugali šį failą.
# =====================================================================

# ---- S3 mazgai ----
# Kableliais atskirti aliasai. Kiekvienam mazgui raktai: S3_<ALIAS_DIDZIOSIOMIS>_*
# CLI: `--mazgas hetzner`; be jo imamas S3_DEFAULT_NODE.
S3_NODES=hetzner,wasabi
S3_DEFAULT_NODE=hetzner

S3_HETZNER_ENDPOINT=https://fsn1.your-objectstorage.com
S3_HETZNER_REGION=fsn1
S3_HETZNER_BUCKET=viespirkiai-backup
S3_HETZNER_ACCESS_KEY_ID=CHANGE_ME
S3_HETZNER_SECRET_ACCESS_KEY=CHANGE_ME
# Prefiksas bakete (gali būti tuščias). Raktas: <prefix>ab/cd/ef/<md5>
S3_HETZNER_PREFIX=failai/
S3_HETZNER_FORCE_PATH_STYLE=true
# Neprivaloma: STANDARD, GLACIER, DEEP_ARCHIVE… (palikus tuščią – mazgo default)
S3_HETZNER_STORAGE_CLASS=

S3_WASABI_ENDPOINT=https://s3.eu-central-1.wasabisys.com
S3_WASABI_REGION=eu-central-1
S3_WASABI_BUCKET=viespirkiai-backup
S3_WASABI_ACCESS_KEY_ID=CHANGE_ME
S3_WASABI_SECRET_ACCESS_KEY=CHANGE_ME
S3_WASABI_PREFIX=
S3_WASABI_FORCE_PATH_STYLE=true

# ---- Parsisiuntimo mazgas (failo baitai pagal md5) ----
# GET <DOWNLOAD_BASE>/<md5>
DOWNLOAD_BASE=http://10.1.10.1:4000
DOWNLOAD_TIMEOUT_MS=600000

# ---- Našumas ----
CONCURRENCY=16
# Iki tiek baitų failas laikomas RAM'e; didesnis – persiliejamas į TEMP_DIR.
INLINE_MAX_BYTES=26214400
TEMP_DIR=/flashas/viespirkiai/s3backupTmp
MULTIPART_PART_SIZE=16777216
MULTIPART_QUEUE_SIZE=4
# Po tiek nesėkmių md5 nebekartojamas (atrakinama su --valyti-klaidas).
MAX_RETRIES=5
BATCH_SIZE=500

# ---- Būsenos bazė ----
SQLITE_PATH=/flashas/viespirkiai/s3backup/s3backup.sqlite
