# =====================================================================
# FRONTEND (Astro web app). Backend taskrunneris šias irgi naudoja.
# =====================================================================

# ---- Serveris ----
PORT=1010
#LOG_REQUESTS=false
#ENABLE_ATN1=false
#ENABLE_BOT_CHALLENGE=false

# ---- DB prisijungimas ----
PG_HOST=localhost
PG_PORT=9118
PG_USER=admin
PG_PASSWORD=CHANGE_ME
PG_DATABASE=viespirkiai
PG_MAX_CONNECTIONS=16

# ---- MCP execute_query + analitiko (read-only) DB rolė ----
# Analitikas privalo būti ATSKIRAS read-only vartotojas (jokio fallback'o į PG_*).
ENABLE_EXECUTE_QUERY_MCP=true
#ENABLE_EXECUTE_QUERY_MCP_ONLY=false
#ENABLE_EXECUTE_QUERY_MCP_TRACE=false
MCP_QUERY_TIMEOUT=20
#PG_ANALYST_USER=analyst
#PG_ANALYST_PASSWORD=CHANGE_ME
#PG_ANALYST_PORT=9118
#PG_ANALYST_MAX_CONNECTIONS=16

# ---- NATS (TaskRunner pažadinimai, SSE, cache invalidacija) ----
NATS_URL=nats://127.0.0.1:4222
NATS_TOKEN=CHANGE_ME

# ---- Typesense (paieškos pasiūlymai, juridinių asmenų paieška) ----
TYPESENSE_UP=true
TYPESENSE_API_KEY=CHANGE_ME
# JSON masyvas mazgų:
TYPESENSE_NODES=[{"host":"localhost","port":8108,"protocol":"http"}]

# ---- Quickwit (pilnatekstė paieška, facetavimas) ----
QUICKWIT_UP=true
QUICKWIT_URL=http://localhost:7280
SUTARTYS_QUICKWIT=true
VIESIEJI_PIRKIMAI_QUICKWIT=true

# ---- Failų / dokumentų SQLite vietos (pilni failų keliai) ----
INTERNAL_FILE_BASE=https://failai.viespirkiai.org
OCR_REZULTATAI_SQLITE_LOCATION=/flashas/viespirkiai/ocrRezultatai/ocrRezultatai.sqlite
DOKUMENTAI_SQLITE_LOCATION=/flashas/viespirkiai/dokumentai/dokumentai.sqlite
FAILAIINFO_SQLITE_LOCATION=/flashas/viespirkiai/failaiInfo/failaiInfo.sqlite
# Pasirenkami tik HTTP(S) read fallback endpoint'ai kitame mazge:
#OCR_REZULTATAI_LOCATION=https://host/api/ocr/rezultataiFiles
#DOKUMENTAI_LOCATION=https://host/api/dokumentai/dokumentaiFiles
#FAILAI_LOCATION=https://host/api/failai/failaiInfoFiles

# ---- OCR ----
#OCR_BANDYMAI=5

# ---- Grafas ----
#ENABLE_GRAPH=false

# ---- Onion / analitika / customHead ----
#ONION_ADDRESS=
#ANALITIKA_URL=https://plausible.viespirkiai.org/viespirkiai.org
#CUSTOM_HEAD=


# =====================================================================
# BACKEND (taskrunneris) — tik čia naudojami kintamieji.
# =====================================================================

# ---- Tor / proxy scrapinimui ----
TOR_ADDRESS=socks5h://127.0.0.1:9050
TOR_PASSWORD=CHANGE_ME

# ---- Išorinių šaltinių URL (mirror/proxy perrašymui) ----
#DATA_GOV_URL=https://get.data.gov.lt
#VIESIEJI_PIRKIMAI_URL=https://viesiejipirkimai.lt
#2021_ESINVESTICIJOS=https://2021.esinvesticijos.lt

# ---- e-TAR TaskRunner ----
# Prieš įjungiant pritaikyti modules/eTar/taskRunnerQueue.sql.
#ETAR_API_URL=http://10.1.10.24:8080
#ETAR_API_KEY=
#ETAR_SIDECAR_DIR=/flashas/viespirkiai/eTar
#ETAR_RECENT_DAYS=180
#ETAR_REFRESH_HOURS=3
#ETAR_MAX_INFLIGHT=6

# ---- Spinta (eksportui) ----
#SPINTA_SERVER=
#SPINTA_API_KEY=
#SPINTA_CLIENT=
#SPINTA_SECRET=
#SPINTA_NAMESPACE=
#SPINTA_SCOPES=[]
